@ARTICLE{11654361,
  author={Lee, Junhyuck and Kim, Yemin and Kim, Dongrim and Kil, Jaejun and Hyung, Woobin and Lee, Byunghun},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 13.56-MHz Wireless Power and Synchronized Full-Duplex Data Transceiver IC Using a Single Inductive Link for Wearable Biomedical Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-13},
  abstract={This article proposes a 13.56-MHz wireless power and synchronized full-duplex data transceiver (WPSFDT) IC using a single inductive link for compact wearable and biomedical systems. Conventional full-duplex (FD) data telemetry systems are limited by their use of additional antennas or external LC networks to create data channels in separate frequency bands, which increases system complexity and power consumption. On the contrary, the proposed WPSFDT system implements synchronized FD data telemetry without additional components by utilizing transmitter (TX) and receiver (RX) synchronization (TRXS), which keeps the TX and RX always synchronized at the same frequency. The proposed WPSFDT significantly reduces system size and complexity by integrating both TX and RX functions into a single chip using a reconfigurable transceiver architecture. For the downlink, this system employs off-duration shift keying (ODSK), which ensures stable power delivery with a predetermined off-duration time regardless of data rate. For the uplink, it utilizes short-pulse load shift keying (SP-LSK) to minimize power delivery losses using SP-LSK signals. In addition, an envelope hold scheme effectively mitigates self-interference (SI) caused by uplink data transmission, which enables robust FD data telemetry. The proposed WPSFDT IC is fabricated using an 180-nm BCD process and has a chip size of  $2.4\times 1.9$  mm2. This system achieves a high bidirectional data rate of up to 400 kb/s. This novel WPSFDT system is expected to contribute to progress in wearable and biomedical applications, which require robust and high-speed bidirectional data telemetry, by enabling synchronized FD data telemetry over a single inductive link without additional components.},
  keywords={Uplink;Downlink;Telemetry;Joining processes;Timing;Data communication;Transceivers;Integrated circuits;Voltage;Clocks;Full-duplex (FD) data telemetry;off-duration shift keying (ODSK);reconfigurable transceiver;short-pulse load shift keying (SP-LSK);synchronized data recovery (SynDR);transmitter and receiver synchronization (TRXS);wearable and biomedical applications;wireless power and data transfer (WPDT)},
  doi={10.1109/JSSC.2026.3720707},
  ISSN={1558-173X},
  month={},}

@ARTICLE{11649852,
  author={Zhang, Bojun and Wang, Jinkai and Wang, Zekun and Zhu, Xianan and Gu, Zhengkun and Guo, Ziyuan and Zhang, Zhizhong and Zhang, Kun and Zhao, Weisheng and Zhang, Yue},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={APM-CIM: An Array Partition Multi-Macro CIM System With Dynamic Sparse Approximation for Neural Network Edge Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-16},
  abstract={Computing-in-memory (CIM) has been widely investigated as a solution to the von Neumann bottleneck to reduce data transfer between memory and processor. However, existing CIM macros for neural network (NN) edge applications still suffer from high latency and energy consumption due to the correlation between data precision and the number of multiplication and accumulation (MAC) cycles. Moreover, modern convolutional NN (CNN) models contain massive parameters that are distributed across multiple CIM macros. While multi-macro architectures enable large-scale deployment, they incur inefficient bandwidth utilization during input loading and frequent inter-module communication, both of which cause significant performance degradation. To address these issues, this article presents an array partition multi-macro CIM (APM-CIM) system with dynamic sparse approximation. First, a novel CIM macro incorporating double-input and sparse approximation mechanism is proposed to halve the number of computation cycles and skip insignificant operands during MAC. Second, an array partition mapping scheme for weights is proposed to reduce the bandwidth requirement of a CIM macro, thereby maximizing cache bandwidth utilization to implement high-parallelism computation. Finally, data and task managers are designed to minimize the performance degradation of the CIM macro at the system level. Through cross-level co-design of circuit, architecture, and system, the fabricated 40-nm CMOS chip achieves a system energy efficiency of 67.63 TOPS/W, which reduces the performance loss ratio by  $3.7\times $  and is  $10.4\times $  higher than state-of-the-art CIM-based systems. Using the VGG model on the CIFAR-10 dataset, the system delivers an accuracy of 89.95% at a power consumption of 34.0 mW.},
  keywords={In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Arrays;Modeling;Media Access Control;Sparse approximation;Energy efficiency;Design methodology;Computing-in-memory (CIM);high-parallelism;multi-macro;neural network (NN);sparse approximation},
  doi={10.1109/JSSC.2026.3720241},
  ISSN={1558-173X},
  month={},}

