@ARTICLE{11646441,
  author={Dodangeh, Maryam and Oude Alink, Mark S. and Prummel, Jan and Nauta, Bram},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 300-μW BLE-Compliant Packet-Based Data-Agnostic Clock-Harvesting RX Achieving −85/−70 dBm Sensitivity for ±40/±15 ppm Accuracy}, 
  year={2026},
  volume={},
  number={},
  pages={1-15},
  abstract={An ultralow-power Bluetooth low energy (BLE)-compliant crystal-less clock-harvesting receiver is presented that uses the BLE advertising packets (APs) to calibrate an on-chip frequency reference with ±400 ppm initial frequency offset. The proposed front-end, fabricated in 22 nm FDSOI, is capable of pushing the frequency accuracy of the reference further to below ±40/±15 ppm ( $3\sigma $ ) at −85/−70 dBm input power, while consuming  $300~\mu $ W when active. Both system and circuit implementations are specifically tailored for BLE requirements to minimize power consumption. Various system and design innovations are employed to create a calibration system that remains independent of data and resilient to interference in the crowded ISM band. Specifically, a custom frequency synthesizer in combination with injection-locking is proposed to replace the conventional PLL structure, resulting in low power consumption and nanosecond-order settling time due to the near-instantaneous nature of injection-locking. The proposed structure is capable of enhancing the accuracy of a fully-integrated oscillator to satisfy the ±60 ppm BLE frequency accuracy requirements with significant margin, without requiring changes to the standard. This enables crystal-less IoT sensor nodes in multiple applications, requiring only a single XTAL-based central node in the network. The presented prototype serves as a proof-of-concept demonstration of the proposed architecture, and the fully integrated, standalone operation remains for future work.},
