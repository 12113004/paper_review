  year={2026},
  volume={},
  number={},
  pages={1-15},
  abstract={This article presents a power-dense and energy-efficient power amplifier (PA) for portable radar and integrated sensing and communication (ISAC) nodes, addressing the concurrent requirements of high output power and stringent spectral compliance, all within tight thermal and silicon-area budgets. A 6:1 dual-mode-optimized interleaved transformer (DMO-IT) is introduced to co-integrate efficient six-way power combining and embedded  $2f_{0}$  suppression within a single magnetic structure, mitigating the area and insertion-loss overhead of discrete harmonic-filtering networks. A physics-based odd-/even-mode analytical framework establishes closed-form efficiency-optimal and  $2f_{0}$ -compliant inductance bounds, enabling disciplined co-design under practical layout constraints. Centrosymmetric, path-matched interleaving ensures port-to-port uniformity, resulting in < 0.13-dB amplitude mismatch and < 8.9° phase deviation, along with closely matched single-ended input impedance across 6–10 GHz. A reliability-enhanced shared-gate triple-cascode (SGTC) output stage further improves power handling and wideband large-signal robustness while enabling compact integration with the 6:1 DMO-IT. Fabricated in a 0.13- $\mu $ m CMOS silicon-on-insulator (SOI) process, the PA achieves a 6.0–10.1-GHz 3-dB bandwidth, 27.9-dBm saturated output power ( $P_{\mathrm {SAT}}$ ), 40.3% peak power-added efficiency (PAE), and 1.31-W/mm2 power density (PD). The PA exhibits AM–PM distortion below 3.4° up to the output 1-dB compression point (OP  ${}_{\mathrm {1{\,}dB}}$ ) and  $\lt -32$ -dBc 2nd-/3rd-harmonic suppression across the band. Under 64-QAM 100-MSym/s modulation, it delivers up to 21.3-dBm average output power with an error vector magnitude (EVM)  $\lt -25.5$  dB and an adjacent channel leakage ratio (ACLR)  $\lt -32$  dBc. The PA demonstrates a competitive PD–efficiency–linearity tradeoff among reported  $C$ -/ $X$ -band silicon PAs, providing a compact, energy-efficient, and spectrally compliant solution for distributed radar and ISAC front ends.},
  keywords={Solids;Power amplifiers;Design methodology;Silicon-on-insulator;Loading;Transformers;Educational institutions;Layout;Inductance;Radar;C/ $X$  band;CMOS silicon-on-insulator (SOI);dual-mode-optimized interleaved transformer (DMO-IT);integrated sensing and communication (ISAC);multi-way power combining;portable radar;power amplifier (PA);second-harmonic ( $2f_{0}$ ) suppression;shared-gate triple cascode (SGTC)},
  doi={10.1109/JSSC.2026.3719376},
  ISSN={1558-173X},
  month={},}

@ARTICLE{11654359,
  author={Zhang, Miao and Zhang, Huajun and Lombardo, Domenico Maria and Fan, Qinwen},
  journal={IEEE Journal of Solid-State Circuits}, 
