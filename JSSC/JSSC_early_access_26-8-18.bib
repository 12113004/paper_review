@ARTICLE{11655899,
  author={Salim, Ahmet Yusuf and Seçkiner, Soner and Elmitwalli, Eslam and Ignjatovic, Zeljko and Köse, Selçuk},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Mixed-Signal SAT Solver for Exploring Nonideal Effects and Scalability in Analog Computation}, 
  year={2026},
  volume={},
  number={},
  pages={1-19},
  abstract={Recent years have seen growing interest in custom and nature-inspired computing methods for solving computationally challenging combinatorial optimization problems. The Boolean satisfiability (SAT), a canonical nondeterministic polynomial (NP)-complete problem, has remained a focal point due to its wide applicability in artificial intelligence, cryptography, and formal verification. This article presents a custom mixed-signal hardware SAT solver that maps the cost function of three-SAT instances onto an array of current-coupled computational nodes. The system progressively minimizes the cost function while employing an integrated perturbation mechanism to escape local minima. The proposed architecture is implemented in a standard 65-nm CMOS technology and experimentally evaluated. A central open question in the analog computation domain is the scalability of analog and mixed-signal architectures under inherent nonidealities. Beyond demonstrating functional correctness, this work systematically characterizes the impact of deviations inherent to analog computation, including coupling strength mismatch and nodal threshold variations. Measurement results reveal that solver performance is highly sensitive to random mismatch and largely insensitive to threshold variation. These effects are further elucidated through controlled experiments, such as random clause shuffling, selective sample pruning, and autozeroing, offering design guidance for scalable analog and mixed-signal optimization accelerators. Experimental results show that the fabricated integrated circuit achieves a median solution time of  $9.75~\mu $ s per instance with a median energy consumption of 118nJ across the uniform random 50-variable SATLIB benchmark instances.},
  keywords={Current;Timing;Hardware;Joining processes;Couplings;Optimization;Costing;Costs;Arrays;Architecture;Analog computation;Boolean satisfiability;CMOS;combinatorial optimization problems;Ising machine;nature-based computing;SAT},
  doi={10.1109/JSSC.2026.3721413},
  ISSN={1558-173X},
  month={},}

@ARTICLE{11655872,
  author={Qu, Tianxiang and Wang, Nan and Zhang, Zuo and Xiang, Longxi and Yi, Ting and Hong, Zhiliang and Zeng, Xiaoyang and Xu, Jiawei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Stress- and Temperature-Compensated TMR Current Sensor With ±0.13% Sensitivity Variation}, 
  year={2026},
  volume={},
  number={},
  pages={1-12},
  abstract={This article presents a high-precision tunnel magnetoresistance (TMR)-based non-contact current sensor with enhanced immunity to sensitivity drift. A background sensitivity stabilization loop (SSL) continuously regulates the TMR bias voltage to compensate intrinsic sensitivity variations. Through this closed-loop regulation, sensitivity drift of the TMR sensor induced by temperature, mechanical stress, and arbitrary environmental perturbations can be significantly suppressed, with the residual sensitivity variation determined primarily by an on-chip reference current. This reference current incorporates segmented curvature correction to minimize its temperature dependence, while an on-chip stress sensor further mitigates package-induced sensitivity drift via digital compensation. Together, these techniques enable strong robustness of the TMR sensor against thermal and package-stress variations. Evaluated with an external TMR bridge, the prototype achieves ±0.13% sensitivity variation from  ${-} 40~{^{\circ }}$ C to  $120~{^{\circ }}$ C. In addition, stress-induced drift is suppressed from 2.3% to below 0.1%. A  $\Delta \Sigma $ -based offset-trimming DAC in a high-input-impedance instrumentation amplifier (IA) reduces the TMR bridge DC offset from 48 mV to  $6~{\mu }$ V, while maintaining an overall dynamic range (DR) of 82 dB with an input-referred noise (IRN) of  $4.7~{\mu }$ Vrms (BW  ${=}~20$  kHz).},
  keywords={Current;Human factors;Image sensors;Sensitivity;Stress;Tunneling magnetoresistance;Voltage;Temperature;Educational institutions;Solids;Current sensor;magnetic field;offset calibration;packaging stress;sensitivity stabilization loop (SSL);temperature variations;tunnel magnetoresistance (TMR)},
  doi={10.1109/JSSC.2026.3719689},
  ISSN={1558-173X},
  month={},}

@ARTICLE{11655557,
  author={Zhou, Jiaqi and Jing, Yiqi and Sun, Yiyang and He, Siyuan and Ye, Le and Jia, Tianyu},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={MTDiff: A Multi-Task Diffusion Accelerator With Bandwidth-Aware Memory Partition and Efficient Digital Compute-in-Memory}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={Initially applied to image synthesis, diffusion models have rapidly expanded into various content generation tasks, such as 3-D scene reconstruction and video generation, due to the superior generative quality. Based on our observations, the imbalanced operational intensities across diffusion model layers lead to suboptimal hardware utilization due to inadequate bandwidth optimization. Additionally, emerging 3-D and video generation tasks require computationally intensive multi-view consistency operations to ensure smooth transitions between perspectives and frames. In this work, we present MTDiff, a multi-task diffusion accelerator featuring three key innovations: 1) a dynamic bandwidth-aware memory partitioning scheme optimizing hardware utilization and reducing external memory accesses; 2) an efficient bitline (BL)-segmented compute-in-memory (CIM) macro together with a reuse-aware weight update scheduler; and 3) a hierarchical multi-frame consistency management (MFCM) skips redundant operations at frame and pixel levels to improve computational efficiency. Implemented using a 22-nm process, the MTDiff accelerator achieves a 49.74–60.81 TFLOPS/W system efficiency across various generative tasks. It delivers a  $1.4\times $  performance improvement and a  $1.52\times $  system energy efficiency enhancement compared to prior state-of-the-art (SOTA) diffusion accelerators.},
  keywords={Modeling;In-memory computing;Bandwidth;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Memory;Diffusion models;Noise reduction;Videos;Diffusion model;digital compute-in-memory (CIM);memory partition;multi-task generation;visual consistency management},
  doi={10.1109/JSSC.2026.3718715},
  ISSN={1558-173X},
  month={},}

@ARTICLE{11655900,
  author={Kang, Minyoung and Kim, Sunghoon and Park, Youngmin and Jeong, Sangsu and Jeon, Dongsuk},
