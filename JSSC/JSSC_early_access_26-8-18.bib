  abstract={Emerging edge applications processing weak signals in noisy environments demand sensor readout frontends with low noise, low power, high dynamic range (DR), and high input impedance. This article presents a zoom sensor readout frontend design that can track signals with rapid changes over a wide DR with high energy efficiency. It employs a fast tracking technique that tracks input signals continuously by monitoring fine stage outputs. Relying on the fine stage result from a single conversion cycle, this technique greatly improves the tracking rate. To boost the energy efficiency of the fine stage, this work proposes a floating-Gm-CCO-based loop filter that allows an ultralow CCO operating voltage with a current-reused transconductance amplifier design. A prototype in a 28-nm CMOS achieves a 90.2-dB SNDR over a 10-kHz bandwidth with 4.91- $\mu \text {V}_{\text {rms}}$  input-referred noise and 4.82- $\mu $ W power consumption, yielding a Schreier FoM of 183.4dB, the highest reported among low-noise sensor readout frontends.},
  keywords={Feeds;Antennas;Circuits;Capacitors;Feedback;Filtering;Filters;Integrated circuits;Voltage-controlled oscillators;Very large scale integration;Analog front-end (AFE);continuous-time delta-sigma modulator (CT- $\Delta \Sigma $ M);current reuse;range tracking;zoom analog-to-digital converter (ADC)},
  doi={10.1109/JSSC.2026.3677053},
  ISSN={1558-173X},
  month={},}

@ARTICLE{11479688,
  author={Xie, Wenao and Sang, Haoyang and Kalzhan, Zhamaliddin and Lee, Jingu and Yoo, Jerald and Lee, Kangho and Yoo, Hoi-Jun},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Falcon: Event-Driven Hybrid Object Tracking SoC With Bit-Column-Similarity-Based MRAM PIM and Heterogeneous Read-Only-Once Attention Flow}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={Hybrid frame-event cameras offer high spatial fidelity and  $\mu $ s-level temporal response, making them well suited for low-power, low-latency object tracking under motion blur and sparse activity. This work presents an event-driven vision SoC that integrates heterogeneous MRAM-based processing-in-memory (PIM), near-memory-computing (NMC), lookup table (LUT), and single-instruction multiple-data (SIMD) compute units for end-to-end real-time hybrid tracking. First, the CNN feature encoder is mapped onto a bit-column-similarity-optimized MRAM PIM with activation skipping and weight compression, achieving  $2.44\times $  energy efficiency and 61.9% latency reduction. Second, attention-based tracking is executed using a read-once  $Q$ / $K$ / $V$  dataflow combining column-priority NMC generation, mixed-product SIMD execution, and LUT-accelerated SoftMax, reducing buffer reads by 46% and attention latency by 30%. Third, a two-stage event-driven activation pipeline selectively enables computation only upon motion, cutting system power by 63.5% and overall latency by 68.8%. Fabricated in 28-nm FDSOI (12.96 mm2), the SoC delivers macro-level 750.18 TOPS/W for 1b–1b–3b MAC operations at 0.7 V, 50MHz, and system-level 16.34 TOPS/W for INT8 CNN + FP8 attention at 1.15 V, 200MHz, enabling real-time 50 frames/p tracking at 196.5-mW power consumption.},
  keywords={Feeds;Antennas;Broadcasting;Broadcast technology;System-on-chip;Circuits;Circuits and systems;Application specific integrated circuits;Very large scale integration;Integrated circuits;Attention computation;event-driven;heterogeneous system;hybrid object tracking;MRAM processing-in-memory (PIM);system-on-chip (SoC)},
  doi={10.1109/JSSC.2026.3680504},
  ISSN={1558-173X},
  month={},}

