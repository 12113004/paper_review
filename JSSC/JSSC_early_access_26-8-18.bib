@ARTICLE{11649863,
  author={Dong, Jingshang and Qin, Pei and Zhu, Haoshen and Yi, Xiang and Yang, Nan and Leung, Kwok Wa and Xue, Quan},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={An Ultra-Compact K-Band Wideband Linearized Power Amplifier Supporting 4096-QAM for mm-Wave Communication Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-16},
  abstract={This article presents an ultra-compact wideband linearized power amplifier (PA) for millimeter-wave (mm-Wave) wireless communication systems. An adaptive-varactor-linearizer (AVL) and an embedded tunable-inductor-linearizer (TIL) are proposed to mitigate amplitude-to-phase (AM–PM) distortion. Unlike conventional capacitive linearizers, the proposed AVL employs a non-complementary capacitive compensation technique that introduces a compensating capacitance at low power while preserving the original capacitance at high power, thereby alleviating insertion loss and maintaining high power gain. The TIL generates an adjustable predistortion phase to compensate for AM–PM distortion induced by the power stage. In addition, a resistor and an external control voltage are introduced in the TIL to fine-tune and flatten the predistortion phase, thereby enabling wideband linearization of the PA. Prototyped in 65-nm bulk CMOS, the proposed PA achieves a maximum power added efficiency  $\text {PAE}_{\max }$  and a saturated output power  $P_{\text {sat}}$  of 38.0% and 19.1 dBm at 26 GHz, an AM–PM distortion less than  ${0.99}{^{\circ } }$  over 21–29 GHz, with the minimum value of  ${0.24}{^{\circ } }$  at 28 GHz. With 2000-MSym/s fifth-generation (5G) new radio (NR) FR2 1-component carrier (CC) signals at 28 GHz, the best measured average output power  $P_{\text {avg}}$  and average power added efficiency  $\text {PAE}_{\text {avg}}$  are 11.2 dBm and 8.9% for 64-QAM, and 9.0 dBm and 5.5% for 256-QAM, respectively. For 400-MSym/s single carrier (SC) 1024-QAM and 100-MSym/s SC 4096-QAM signals, the PA achieves a  $P_{\text {avg}}$ / $\text {PAE}_{\text {avg}}$  of 10.3 dBm/7.2% and 6.8 dBm/3.3% at 28 GHz, respectively.},
