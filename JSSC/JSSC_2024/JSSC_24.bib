@ARTICLE{10233212,
  author={X. Ming and J. -J. Kuang and X. -C. Gong and J. Zhang and Z. Wang and B. Zhang},
  journal={IEEE Journal of Solid-State Circuits},
  title={An NMOS LDO With TM-MOS and Dynamic Clamp Technique Handling Up To Sub-10-μs Short-Period Load Transient},
