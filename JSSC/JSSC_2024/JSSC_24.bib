}

@ARTICLE{10536115,
  author={S. Kim and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 0.458-pJ/bit 24-Gb/s/pin Capacitively Driven PAM-4 Transceiver With PAM-Based Crosstalk Cancellation for High-Density Die-to-Die Interfaces},
  year={2024},
  volume={59},
