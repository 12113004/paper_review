@ARTICLE{10679735,
  author={Y. Ji and J. Jin and L. Cheng},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 12-to-1–1.8-V Hybrid DC-DC Converter With a Charge Converging Phase for Inductor Current Reduction},
