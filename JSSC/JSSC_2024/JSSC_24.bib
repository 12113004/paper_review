@ARTICLE{10500487,
  author={X. Zhang and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 24-V-Input Highly Integrated Interleaved-Inductor Multiple Step-Down Hybrid DC–DC Converter With Inherent Current Equalization Characteristics},
