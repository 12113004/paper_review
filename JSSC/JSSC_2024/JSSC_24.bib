  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=10265269&isnumber=10375801},
}

@ARTICLE{10278171,
  author={Q. Wu and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 9-Mb HZO-Based Embedded FeRAM With 10-Cycle Endurance and 5/7-ns Read/Write Using ECC-Assisted Data Refresh and Offset-Canceled Sense Amplifier},
  year={2024},
  volume={59},
  number={1},
  pages={208-218},
  abstract={Hf0.5Zr0.5O2 (HZO)-based ferroelectric random access memory (FeRAM) is a good candidate for the embedded nonvolatile memory (eNVM) applications because of its high reliability, high speed, good scalability, and process compatibility with logic large-scale integrated circuits (LSIs). However, challenges still exist in designing robust read/write circuits for high reliability and sufficient read yield. This work presents a 9-Mb (8 + 1-Mb error correcting code (ECC)) HZO-based nonvolatile FeRAM chip with high-performance read and write peripheral circuits. A TiN/HZO/TiN ferroelectric capacitor (FeCAP) is integrated in the back-end-of-line of a 130-nm CMOS process with a 700-nm-diameter capacitor and a mega-level capacity. A temperature-aware ECC-assisted write driver (ECC-WD) is designed to improve the reliability and power efficiency of FeRAM. The offset-canceled sense amplifier (SA) and a dummy-based reference generator are designed to tolerate a small bitline (BL) signal margin and to reduce the read bit-error rate (BER). Measurement results show 2 $\times $  remnant polarization ( $P_{r}$ )  $>$  30  $\mu \text{C}$ /cm2,  $>$ 1012-cycle endurance, 7-ns write and 5-ns read time, sub-3-V operating voltage, and 10-year data retention at 85 °C.},
  keywords={Random access memory;Nonvolatile memory;Ferroelectric films;Reliability;Switches;Capacitors;Zirconium;Ferroelectric capacitor (FeCAP);ferroelectric random access memory (FeRAM);embedded nonvolatile memory (eNVM);refresh;sense amplifier (SA);write driver},
  doi={10.1109/JSSC.2023.3320659},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=10278171&isnumber=10375801},
}

@ARTICLE{10292992,
  author={D. -Q. You and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={An 8b-Precision 8-Mb STT-MRAM Near-Memory-Compute Macro Using Weight-Feature and Input-Sparsity Aware Schemes for Energy-Efficient Edge AI Devices},
  year={2024},
  volume={59},
  number={1},
  pages={219-230},
  abstract={Nonvolatile near-memory-compute (nvNMC) macros are promising candidates for edge artificial intelligence (AI) devices requiring high energy efficiency, short wakeup-to-compute latency, and robust inference accuracy with high precision of inputs (IN), weights ( $W$ ), and outputs (OUT). Nonetheless, the practical application of nvNMC macros is hindered by inherent design challenges: 1) high energy consumption in reading repetitious weight data, 2) low energy efficiency due to high bitstream toggling rate in digital multiply-and-accumulate (MAC) circuits, 3) narrow signal margin and high memory readout latency, and 4) redundant MAC computation in digital MAC circuits under input-stationary flow. In addressing these challenges, we developed a number of schemes based on the concept of system-circuit co-design, including 1) a weight-feature aware read (WFAR) scheme; 2) a toggling-aware weight-tuning (TAWT) scheme; 3) a differential charge-accumulating margin-enhanced voltage-sensing amplifier (DCME-VSA); and 4) an input-sparsity aware pre-computing unit (ISAPU). An 8-Mb spin-transfer torque magnetic random access memory (STT-MRAM) nvNMC macro fabricated using foundry-provided 22 nm STT-MRAM achieved read bandwidth of 436 GB/s, MAC computing latency of 20 ns, and energy efficiency of 53.6–190.2 TOPS/W when performing eight-bit input and eight-bit weight MAC operations with 26-bit output and 576 accumulations.},
  keywords={Neural networks;Energy efficiency;Artificial intelligence;Feature extraction;Energy consumption;In-memory computing;Random access memory;Edge AI;Artificial intelligence (AI);compute-in-memory (CIM);multiply-and-accumulate (MAC);near-memory-compute (NMC);spin-transfer torque magnetic random access memory (STT-MRAM)},
  doi={10.1109/JSSC.2023.3324335},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=10292992&isnumber=10375801},
}

