}

@ARTICLE{10490108,
  author={L. Meng and J. Chen and M. Zhao and Z. Tan},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Partially Feedback NSSAR Embedded Third-Order Delta–Sigma Modulator With Gain-Boosted Two-Stage FIAs},
