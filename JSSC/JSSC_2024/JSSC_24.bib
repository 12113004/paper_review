@ARTICLE{10473738,
  author={M. Lee and M. M. Elbadry and K. Moez},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 300-μW 2.4-GHz PVT-Insensitive Subthreshold Reference-Based LNA},
  year={2024},
  volume={59},
