  author={H. Li and T. Xu and X. Meng and J. Yin and R. P. Martins and P. -I. Mak},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 23.2-to-26-GHz Low-Jitter Fast-Locking Sub-Sampling PLL Based on a Function-Reused VCO-Buffer and a Type-I FLL With Rapid Phase Alignment},
  year={2024},
  volume={59},
