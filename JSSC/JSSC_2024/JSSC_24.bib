@ARTICLE{10681594,
  author={X. Meng and X. Li and C. -Y. Tsui and W. -H. Ki and W. Liu},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 13.56-MHz Primary Driver With Fractional Capacitance Auto-Tuning Loop for Wireless-Powered Implantable Medical Devices},
