@ARTICLE{10426744,
  author={M. Essawy and K. Rashed and A. Aghighi and A. S. Natarajan},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Low-Noise Dual-Path Self-Interference Cancellation Architecture for Watt-Level TX Power Handling in Simultaneous Transmit and Receive},
  year={2024},
  volume={59},
  number={5},
