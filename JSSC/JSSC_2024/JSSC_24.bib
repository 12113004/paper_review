@ARTICLE{10423725,
  author={J. Hwang and D. Yoo and B. -W. Min},
  journal={IEEE Journal of Solid-State Circuits},
  title={Compact mm-Wave Ultra-Wideband and Low-Noise Phase Alternately Distributed Quasi-Circulators},
  year={2024},
  volume={59},
  number={5},
  pages={1351-1360},
  abstract={This article presents ultra-wideband and low-noise distributed active quasi-circulators (QCs) fabricated using a 28-nm CMOS process. The proposed active QCs use a differential two-stage distributed amplifier (DA) design, where the electrical length of the input and output transmission lines is 90° at 28 GHz. For the ultra-wideband distributed active QC (UWQC), the differential outputs of the amplifier in the second stage are cross-connected to the differential outputs of the amplifier in the first stage, resulting in ultra-wideband isolation regardless of the frequency. In addition, an interstage inductor is inserted in the amplifiers to maintain the frequency response of the input and output transmission lines identically. For the low-noise distributed active QC (LNQC), the resistive termination at the input transmission line of DA is eliminated by using input-matched amplifiers, resulting in a low antenna (ANT) -to-receiver (RX) noise figure (NF). In addition, the LNQC with the input-matched amplifiers allows a 3-dB higher transmitter (TX)-to-ANT gain compared to conventional distributed QC. Moreover, the transistor size and bias condition of the input-matched amplifiers can be selected to achieve low noise and high power handling capability of the QC within a given tradeoff. The measured results demonstrate that the UWQC achieves 20.5−35.5-GHz wideband operating bandwidth with TX-to-ANT gain of 4.5 dB, ANT-to-RX insertion loss of 3.6 dB, and >21-dB TX-to-RX isolation, only occupying a die area of 0.07 mm2. The LNQC achieves ANT-to-RX NF of 8.9−11.1 dB, which is around 10 dB lower than the conventional distributed QC. The measured TX-to-ANT output power 1-dB compression point is 14.3 dBm with a dc power consumption of 28.6 mW, occupying a die area of 0.25 mm2.},
