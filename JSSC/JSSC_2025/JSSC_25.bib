@ARTICLE{10741957,
  author={A. Ayling and A. Hajimiri},
  journal={IEEE Journal of Solid-State Circuits},
  title={Flip-Chip Aperture Coupled D-Band Active Radiator Tiles in 22-nm CMOS FDSOI},
