@ARTICLE{10815053,
  author={S. Park and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 52-Gb/s Low-Power PAM-4 Baud-Rate CDR Using Pattern-Based Phase Detector for Short-Reach Applications},
