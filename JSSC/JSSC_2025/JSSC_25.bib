}

@ARTICLE{10568908,
  author={H. Zhang and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 90.7-nW Vibration-Based Condition Monitoring Chip Featuring a Digital Compute-in-Memory- Based DNN Accelerator Using an Ultra-Low-Power 13T-SRAM Cell},
  year={2025},
  volume={60},
