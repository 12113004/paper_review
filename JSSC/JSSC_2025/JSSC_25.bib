  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=10642974&isnumber=10857664},
}

@ARTICLE{10608106,
  author={W. -C. Chen and S. -H. Chen and M. -C. Huang and S. -W. Chang and G. Hellings and G. Groeseneken},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 1.8-V GPIO With Design-Technology-Reliability Co-Optimization in Sub-3-nm GAA-NS Technology},
