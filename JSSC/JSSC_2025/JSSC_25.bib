@ARTICLE{10777035,
  author={J. Hao and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={An Intrinsically PVT Robust 10-bit 2.6-GS/s Dynamic Pipelined ADC With Dual-Path Time-Assisted Residue Generation Scheme},
