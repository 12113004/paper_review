  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=10614635&isnumber=10857664},
}

@ARTICLE{10649583,
  author={K. -Y. Chen and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={DAP: A 507-GMACs/J 256-Core Domain Adaptive Processor for Wireless Communication and Linear Algebra Kernels in 12-nm FINFET},
