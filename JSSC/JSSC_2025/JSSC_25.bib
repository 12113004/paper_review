@ARTICLE{10807165,
  author={X. Feng and X. Lin and H. Yang and Y. Liu and W. Sun},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Scalable BEV Perception Processor for Image/Point Cloud Fusion Applications Using CAM-Based Universal Mapping Unit},
