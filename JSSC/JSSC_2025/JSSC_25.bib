  author={J. Kim and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 4 × 32 Gb/s 1.8 pJ/bit Collaborative Baud-Rate CDR With Background Eye-Climbing Algorithm and Low-Power Global Clock Distribution},
