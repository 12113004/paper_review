  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11008588&isnumber=11071629},
}

@ARTICLE{10955714,
  author={H. Xu and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 112-Gb/s PAM-4 Retimer Transceiver With Jitter-Filtering Clocking Scheme and BER Optimization Technique in 28-nm CMOS},
