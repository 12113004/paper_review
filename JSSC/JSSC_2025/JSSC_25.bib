@ARTICLE{10856900,
  author={C. Ding and M. Gao and A. K. Skrivervik and M. Shoaran},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 49.8-mm² IR-UWB Transmitter With Co-Designed Power Amplifier and Antenna for Neural Implants With Extended Transmission Range},
