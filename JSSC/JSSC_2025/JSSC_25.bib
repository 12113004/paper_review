@ARTICLE{10804627,
  author={K. Edrian Lozada and Y. -D. Kim and H. -J. Kim and Y. Cho and M. Choi and S. -T. Ryu},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 0.38-mW 200-kHz-BW Digital-Intensive Single-Opamp Fourth-Order Continuous-Time Delta-Sigma Modulator With Third-Order Digital Noise Coupling in 28-nm CMOS},
  year={2025},
