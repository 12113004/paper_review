@ARTICLE{10817558,
  author={K. Li and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 160-MHz BW 68-dB SNDR 36.2 mW Continuous-Time Pipelined ΔΣ ADC With DAC Image Prefiltering},
