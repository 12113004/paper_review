@ARTICLE{11164176,
  author={J. Jiang and L. Zhao and J. Tang and C. Huang},
  journal={IEEE Journal of Solid-State Circuits},
  title={SLiMDO: A Single-Link Multi-Domain-Output Isolated DC–DC Converter With Passive Magnetic Flux Sharing for Local Energy Distribution and Rx Behavior Sensing-Based Global Power Modulation},
