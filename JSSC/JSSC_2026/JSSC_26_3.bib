}

@ARTICLE{11230332,
  author={Y. Wang and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Hybrid SCVR With 4 × CF Continuously Scalable-Conversion Ratio SC Stage},
  year={2026},
  volume={61},
  number={3},
  pages={951-962},
  abstract={This work presents a hybrid switched-capacitor (SC) voltage regulator (VR) with a continuously scalable-conversion (CSC)-ratio stage implemented with off-chip flying capacitors ( $\boldsymbol {C}_{ F}$ s). By eliminating the need for high-density on-chip capacitors, this approach offers broader accessibility to designers. The use of off-chip  $\boldsymbol {C}_{ F}$ s mandates minimizing the  $\boldsymbol {C}_{ F}$ s count to reduce I/O complexity, layout congestion, and routing overhead. However, this conflicts with the conventional CSC design philosophy for high efficiency, which implies many  $\boldsymbol {C}_{ F}$ s. To resolve this tradeoff, we first propose clamping the  $\boldsymbol {C}_{ F}$  voltage ( $\boldsymbol {V}_{ \text {CF}}$ ) swing to 1/4 of its original range, achieving comparable efficiency and output power in the designs with full swing. The clamp is achieved via preceding SC stages, forming an SC-first configuration that improves the efficiency of the SC stages. Next, we propose a half-outphasing control that reduces the  $\boldsymbol {C}_{ F}$ s count to 4, while reconfiguring  $\boldsymbol {V}_{ \text {CF}}$  steps to maintain high efficiency across a wide voltage conversion ratio (VCR) range. Moreover, we employ an SC2-CSC stage outphasing for more  $\boldsymbol {V}_{ \text {CF}}$  steps, further improving efficiency. Fabricated in a 65-nm CMOS process, the prototype SCVR achieves a measured peak efficiency of 92.5% and a maximum output power of 1.52 W. With further advancements in process and packaging, this approach holds potential for higher output power and density.},
  keywords={Switches;Chatbots;Video recording;Power generation;Voltage control;Silicon;Routing;Clamps;System-on-chip;Regulators;Continuously scalable-conversion-ratio;reconfigurable VCF step;SC converter voltage regulator (VR);stage outphasing;switched-capacitor (SC) converter},
