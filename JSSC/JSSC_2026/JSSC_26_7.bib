@ARTICLE{11459452,
  author={Xu, Siyuan and Wei, Yingrui and He, Yuechen and Kinget, Peter R.},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 6.5-pJ/Step Reconfigurable Readout IC With Duty-Cycled Resistor and Switched Capacitor for High Linearity RC-to-Digital Converter}, 
  year={2026},
  volume={61},
  number={7},
  pages={3283-3295},
  abstract={The time-domain, reconfigurable resistance (R) and capacitance (C)-to-digital converter (RCDC) combines a Wheatstone bridge (WhB), a duty-cycled resistor (DCR), and a switched capacitor to realize a pulsewidth-locked loop (PWLL) and a frequency-locked loop (FLL) for highly linear and energy-efficient R&C sensor readout. A low-frequency, relaxation voltage-controlled oscillator (VCO) performs voltage-to-time conversion so a compact, low-power, counter-based time-to-digital converter (TDC) can be used, which further enhances energy efficiency. The feedback loop maintains high system linearity. All key circuits operate rail-to-rail to support the large R&C sensing range needed for multi-type sensing applications. The 65-nm CMOS prototype consumes 5.7–6.2  $\mu $ W from a 0.9-V supply. It achieves a very high linearity with R ${}^{2} \gt 0.99993$  (ten channels measured), along with a wide R&C sensing range of 50–400 k $\Omega $  and 35–260 pF. The sensing resolution is 262  $\Omega $  for Rsen and 21 fF for Csen with a conversion time of 0.5 ms and improves to 23  $\Omega $  and 3.3 fF when the conversion time is increased to 32 ms; the corresponding figure of merit (FoM) is 6.5 pJ/step in R-mode and 0.75 pJ/step in C-mode.},
