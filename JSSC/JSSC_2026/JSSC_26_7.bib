  volume={61},
  number={7},
  pages={3154-3168},
  abstract={A 12-bit 1-GS/s three-stage pipelined analog-to-digital converter (ADC) employing an analog compensation technique to enhance residue amplifier (RA) gain linearity is presented. The proposed residue-dependent integration time compensation (RITC) technique mitigates the compressing nonlinearity in an RA by scaling the integration time for large RA input signals. This technique leverages the time residue generated by the time-domain (TD) sub-ADC to track the variation of the voltage residue. Corresponding mathematical analyses are incorporated to elaborate on its effectiveness. Benefitting from the RITC technique, the prototype ADC achieves high linearity while consuming 5.1 mW from a 1-V power supply and operating at 1 GS/s. The signal-to-noise-and-distortion ratio (SNDR) and spurious-free dynamic range (SFDR) are 61.3 and 75.7 dB with a Nyquist input, respectively, leading to a 171.2-dB Schreier figure-of-merit (FoM) and 5.4-fJ/conversion-step Walden FoM.},
  keywords={Feeds;Antennas;Circuits;Capacitors;Integrated circuits;Very large scale integration;Voltage multipliers;Circuits and systems;Feedback;Adders;Analog-to-digital converter (ADC);floating inverter amplifier (FIA);linearity compensation;pipelined ADC;residue amplifier (RA);time-domain (TD) ADC},
  doi={10.1109/JSSC.2026.3671779},
  ISSN={1558-173X},
  month={July},}

@ARTICLE{11494639,
  author={Mou, Jixuan and Harpe, Pieter and Saccon, Alessandro and Cantatore, Eugenio and Fattori, Marco},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 10.1-ENOB 8kHz Bandwidth 95--250nW PVT-Robust DT Level-Crossing ADC for Sparse and Generic Signals}, 
  year={2026},
  volume={61},
  number={7},
  pages={3169-3180},
  abstract={This article presents an event-driven discrete-time level crossing analog-to-digital converter (DT-LCADC) that is energy-efficient in converting both sparse and generic signals and is robust against process voltage and temperature (PVT) variations. The proposed DT-LCADC uses the comparator delay to classify each level-crossing event as slow (produced by a small input change in time) or fast (consequence of a large input increment). The converter can adaptively select the most suitable search scheme, between linear and binary, depending on the detected type of event. To reduce the power needed to transmit the output data, by leveraging the signal sparsity, the ADC output is efficiently encoded according to the type of event and transmitted using a variable payload using a serial data protocol. The proposed DT-LCADC, manufactured in a 65-nm CMOS technology, achieves 10.1 ENOB and a signal bandwidth of 8 kHz, while consuming between 95 and 250 nW from a supply voltage of 0.8 V, depending on the input signal. The corresponding Walden figure of merit (FoM ${}_{W}$ ) ranges from 5.3 to 14.2 fJ/c.s, achieving more than 5X improvement in power efficiency compared to state-of-the-art DT-LCADCs. To convert time-sparse neural signals, the proposed ADC requires only 120 nW, while reducing the output data rate to 5.1 kb/s. Together with the data output encoding driven by the type of event, this ADC leads to a data transmission energy saving of up to 96.4%, compared to a Nyquist ADC with the same accuracy and bandwidth.},
  keywords={Payloads;Military aircraft;Space technology;Feeds;Antennas;Circuits;Circuits and systems;Integrated circuits;System-on-chip;Capacitors;Data compression;event-based sensor interface;level-crossing ADC;process voltage and temperature (PVT)-robust;time-sparse signal},
  doi={10.1109/JSSC.2026.3683078},
  ISSN={1558-173X},
  month={July},}

@ARTICLE{11475651,
  author={Liu, Yuyan and Zhang, Huajun and Becermis, Mustafa and Liao, Jieyu and Dandekar, Mohit and Makinwa, Kofi A. A. and Fan, Qinwen},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Wide-Dynamic-Range Photovoltaic Energy Harvester With Adaptive Power-Scalable MPPT Control and Direct Power-to-Digital Converter}, 
