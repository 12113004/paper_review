@ARTICLE{11297815,
  author={Cai, Xueke and Zhang, Tong and Li, Deyong and Zhao, Yang and Li, Yongfu and Jiang, Honglan and Mercier, Patrick P. and Wang, Hui},
  journal={IEEE Journal of Solid-State Circuits}, 
