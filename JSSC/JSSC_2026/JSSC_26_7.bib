@ARTICLE{11471301,
  author={Zhou, Kaiwen and Zhang, Runhao and Zhang, Shiqi and Ye, Shen and Hong, Zhiliang and Xu, Jiawei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 60-V High-Side / In-Line Instrumentation Amplifier With 54-V/μs CM Transient Tolerance and 115-dB Dynamic Range}, 
  year={2026},
  volume={61},
  number={7},
  pages={3296-3306},
  abstract={A high-voltage instrumentation amplifier (HV-IA) is proposed for high-side/in-line current sensing. To achieve low noise and high common-mode (CM) transient tolerance, the IA uses an HV transient-tailored (HV-TT) PMOS input pair with a bidirectional transient shifter (BTS) in the input chopper, achieving 54-V/ $\mu $ s CM transient tolerance (17–37-V CM step) and a wide static input CM voltage range of 0.7–56.3 V. The CM-dependent gain error, caused by the input CM voltage variations, is minimized to 0.4% through a segmented gain adjustment (SGA) technique. Moreover, an automatic gain control (AGC) loop extends the current sensing range, achieving a 115-dB cross-scale dynamic range (DR). Implemented in a 0.18- $\mu $ m BCD process, the HV-IA exhibits 19-nV/ $\surd $ Hz input-referred noise, 140-dB CM rejection ratio (CMRR), and 10- $\mu $ V input offset, while consuming  $305~\mu $ A from a 60/4.2-V dual supply.},
