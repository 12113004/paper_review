  abstract={A 200-Gb/s 4-level pulse amplitude modulation (PAM-4) heterogeneous transceiver (TRX) for retimed pluggable optics is presented, which enables 200G transmission on the optical side and 100G transmission on the electrical side, without suffering from the exacerbated insertion loss (IL) of the electrical channel due to the doubled data rate from 100 to 200 Gb/s, and allows a much lower latency at similar power efficiency compared with the optical digital signal processor (ODSP) solution. The transceiver consists of 200-GS/s 2:1 analog multiplexer (AMUX) and demultiplexer (ADEMUX) designed in a 130-nm SiGe BiCMOS process and 100-Gb/s mixed-signal transmitter (TX) and receiver (RX) designed in a 28-nm CMOS process. A quasi-voltage-mode (QVM) driver with a 3-tap fractional-spaced feed-forward equalizer (FFE) in the 100-Gb/s TX as well as a 2-tap FFE in the AMUX are introduced to enhance the 200-Gb/s PAM-4 eye opening. In the 200-GS/s 1:2 ADEMUX, a novel track-and-hold amplifier (THA) with cross feedthrough cancellation (CFC) technique is proposed to alleviate the half-rate eye degradation at 100-Gb/s output. A quarter-rate 100-Gb/s mixed-signal RX architecture is adopted for low-power short-reach link, by introducing a novel quarter-rate multistage slicer with eight-phase clocking and rapid reset in the phase detectors (PDs). The 200G TX eye with 2-tap FFE was measured to be 340 mVppd with RLM of 99.2%. On the RX side, the measured 12.5-Gb/s demultiplexed data achieves BER of 1E-12 with PRBS7 at 200 Gb/s. The 200G transceiver consumes a total power of 1350 mW (TX: 664 mW, RX: 686 mW) with a 0.9-V supply in 28-nm CMOS and 3.3-V supply in 130-nm SiGe BiCMOS.},
  keywords={Delays;Optical transmitters;Clocks;Transceivers;Silicon germanium;Optical losses;Artificial intelligence;Optical receivers;Optical pulses;Energy efficiency;4-level pulse amplitude modulation (PAM-4);heterogeneous transceiver;retimed pluggable optics;SerDes},
  doi={10.1109/JSSC.2026.3650801},
  ISSN={1558-173X},
  month={July},}

@ARTICLE{11264512,
  author={Chen, Fuzhan and Pan, Quan and Yue, C. Patrick},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 56-Gbaud 7.3-Vppd Linear Modulator Transmitter With AMUX-Based Inherent FFE and Breakdown Voltage Tripler in 130-nm SiGe BiCMOS}, 
  year={2026},
  volume={61},
  number={7},
  pages={3512-3523},
  abstract={This article presents a half-rate linear transmitter monolithically integrating a 2-to-1 analog multiplexer (AMUX) and a linear driver for optical modulators. Using the timing relationship between the clock signal and half-rate data streams, the AMUX achieves an inherent feed-forward equalizer (FFE), which can be re-configured into two-tap or three-tap mode by adjusting the clock delay. Additionally, to improve the output voltage swing and linearity, a topology named breakdown voltage (BV) tripler is proposed for the linear driver. By stacking three heterogeneous bipolar transistors (HBTs) and biasing the bases of the top two HBTs using amplified input signals, the driver achieves an output swing three times larger than that of conventional cascode topology while maintaining good reliability. Fabricated in 130-nm SiGe BiCMOS, the proposed linear driver achieves a dc gain of 17.1 dB, a 6-dB bandwidth of 39.1 GHz and a total harmonic distortion (THD) of 1.6% at 6- ${V_{\mathrm {ppd}}}~1$ -GHz sinusoidal output. The complete transmitter (AMUX + driver) achieves a maximum output swing of  $7.3~{V_{\mathrm {ppd}}}$  at 56-Gb/s non-return-to-zero (NRZ), as well as a maximum data rate of 112-Gb/s PAM-4 with a swing of  $4.2~{V_{\mathrm {ppd}}}$  when the inherent FFE is enabled.},
  keywords={Modulation;Bandwidth;Optical transmitters;Clocks;Silicon germanium;Optical signal processing;Mixers;Optical modulation;Optical interconnections;BiCMOS integrated circuits;Analog multiplexer (AMUX);driver;dynamic biasing;feed-forward equalizer (FFE);linear transmitter;optical modulator},
