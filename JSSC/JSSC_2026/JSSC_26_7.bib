@ARTICLE{11301753,
  author={Tang, Minzhe and Zhang, Yi and Pang, Jian and Li, Zheng and Xu, Dongfan and Xu, Dingxin and Zhang, Yuncheng and Kunihiro, Kazuaki and Sakai, Hiroyuki and Shirane, Atsushi and Okada, Kenichi},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Time-Division MIMO Phased-Array Receiver Utilizing Nyquist-Rate Fast Beam Switching With Minimized Hardware for 5G and Beyond}, 
