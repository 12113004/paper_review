  journal={IEEE Journal of Solid-State Circuits}, 
  title={CSUM: A 28-nm Vertical-Feature-Shift and Horizontal-Weight-Shift-Based Separate-WL 6T-SRAM Computing-in-Memory Unit Macro for Edge Depthwise Neural-Networks}, 
