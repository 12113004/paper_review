  volume={61},
  number={7},
  pages={3363-3377},
  abstract={This work proposes an area-efficient 28-GHz time-division multiple input–multiple output (MIMO) (TD-MIMO) phased-array receiver without additional hardware cost. The design enables RF signal paths to be reused for multiple MIMO beams from different directions simultaneously through a time-division beam-switching operation. This is achieved using a Nyquist-rate oversampled, fast-switching phase shifter, along with clock-based synchronization between the RF elements. The beamformed signals, combining multiple beams in the time domain on a single-wire interface, are then sequentially separated by a time-division de-multiplexing switch, synchronized with the beam-switching operation. The proposed TD-MIMO receiver can be reconfigured to support various communication scenarios, allowing for a flexible balance between data rate and sensitivity requirements. A prototype fabricated using 65-nm CMOS technology demonstrated a maximum data rate of 9.6 Gb/s with 64-QAM modulation and  $4 \times 4$  MIMO reception in over-the-air (OTA) measurements, utilizing four 5G NR spatial data streams with a 400-MHz channel bandwidth. The proposed TD-MIMO receiver, integrating eight RF elements, occupies only  $3\times 2$  mm of chip area.},
  keywords={Receivers;Switches;Signal to noise ratio;5G mobile communication;Radio frequency;Array signal processing;Synchronization;Millimeter wave technology;Hardware;Time-domain analysis;5G new radio FR2;CMOS;fast beam switching;multiple input–multiple output (MIMO);noise-canceling;phased-array},
  doi={10.1109/JSSC.2025.3641547},
  ISSN={1558-173X},
  month={July},}

@ARTICLE{11260443,
  author={Ding, Cong and Gao, Mingxiang and Skrivervik, Anja K. and Shoaran, Mahsa},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 3-mm2, Multi-Data-Rate, Low-Power IR-UWB Transmitter With On-Chip Antenna for Distributed, Free-Floating Neural Implants}, 
  year={2026},
  volume={61},
  number={7},
  pages={3378-3392},
  abstract={Distributed, high-density neural implants enable multi-region, high-fidelity neural recording and targeted stimulation, advancing both the treatment of neurological disorders and the development of brain–machine interfaces. While recent uplink transmitters (TXs) have achieved high data rates, high energy efficiency, and mm-scale footprints suitable for distributed systems, they struggle to maintain a balanced performance across these metrics. This article introduces a mm-scale wireless TX to overcome this limitation. To support high-density neural recording with flexible channel counts and various signal modalities, the TX offers energy-efficient data transmission from 50 Mb/s to 1.2 Gb/s, enabled by a novel dual-modulation technique. At high data rates, the TX employs a hybrid modulation scheme combining 4-PPM and 2-PSK, while at low data rates, it switches to simple on-off keying (OOK) modulation. To enable this modulation strategy, we introduce a twin-oscillator-based wideband phase-locked loop (PLL) for RF carrier generation within the ultra-wideband (UWB) range. At high data rates, the PLL directly generates a low-jitter UWB carrier. At low data rates, leveraging OOK modulation’s relaxed phase noise requirements, a duty-cycled  $5{\times }$  frequency multiplier upconverts the PLL’s low output frequency to the UWB band. This approach bypasses the power-hungry RF oscillators and dividers, facilitating energy-efficient, duty-cycled carrier generation and supporting frequency-division multiple access (FDMA). In addition, we employ a hybrid strategy combining time-division multiple access (TDMA) and FDMA to enhance scalability for untethered, distributed neural implants. A custom on-chip antenna replaces the conventional printed circuit board (PCB) antenna, establishing a wireless link between the implant and the external system. The proposed TX, fabricated in 65-nm CMOS, occupies a compact footprint of only 3 mm2 and consumes 1.49–7.26 mW across all supported data rates (50–1200 Mb/s). In in vitro wireless testing, it achieved a record transcutaneous transmission range of 60 cm through 15-mm thick pork tissue, without the need for a subcranial repeater.},
  keywords={Wireless communication;Neural implants;Energy efficiency;Transmitting antennas;Throughput;System-on-chip;Frequency modulation;Antennas;Uplink;Signal to noise ratio;Distributed neural implants;duty-cycling;impulse-radio ultra-wideband transmitter (IR-UWB TX);multi-data-rate;on-chip antenna;time/frequency-division multiple access (T/FDMA)},
  doi={10.1109/JSSC.2025.3631653},
  ISSN={1558-173X},
  month={July},}

