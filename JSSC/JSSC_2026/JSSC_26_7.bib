@ARTICLE{11535726,
  author={Mack, Jacob and Zhang, Qirui and Wang, He and Shen, Yi and Chang, Jeongtaek and Yang, Heejin and Agrawal, Anjali and Fan, Zichen and Desman, Braden and Lewis, Zane and Farrell, Thomas and Blaauw, David and Farrell, Will and Owens, Jim and Calhoun, Benton H. and Sylvester, Dennis},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={TexCAC: A Direct-Textile-Attachable Microcontroller Integrating 2-MB MRAM for the Command and Control of Advanced Smart Textiles}, 
  year={2026},
  volume={61},
  number={7},
  pages={3307-3316},
  abstract={Advanced smart textiles (ASTs) are textile-integrated electronic systems that enable many applications, including healthcare, robotics, and IoT. ASTs contain a variety of electronic components to enable whole system functionality (batteries, sensors, SoCs, etc.), which all require orchestration from a central command-and-control (CAC) module. The primary functions of the CAC module include data retrieval, system boot, firmware storage, and system timing synchronization. The critical nature of the CAC module underscores the need for an MCU suitable for ASTs. This work presents two versions of TexCAC: a direct-textile-attachable non-volatile memory (NVM)-based MCU for the command and control of ASTs. The first version of TexCAC (TexCACV1) is fabricated in 22 nm and occupies 4.8 mm2 while integrating 2 MB of MRAM. TexCACV1 is optimized for the ASTs in the following three ways: I/O streamlining to reduce bondpad count and die area by 60%, a bootloader that supports a novel program context switching, boosting program size by  $16\times $ , and combining dynamic frequency scaling (DFS) and MRAM power gating to reduce data exfiltration energy by 40%. The second version of TexCAC (TexCACV2) improves upon the first version by including an on-chip low-dropout regulator (LDO) for self-regulation of core voltage, a more stable power-on-reset (POR) sequence, and chip bypassing to improve data exfiltration speed. TexCACV1 can achieve an optimal active energy of 18 pJ/cycle at 0.52 V, and TexCACV2 can achieve an optimal active energy of 154 pJ/cycle at 0.7 V, which both rival SOTA MCUs.},
  keywords={Energy;Textiles;Educational institutions;Booting;Solids;Design methodology;System-on-chip;Circuits;Computers;Energy efficiency;Advanced smart textiles (ASTs);command and control;direct textile attachment;microcontroller;MRAM},
  doi={10.1109/JSSC.2026.3695482},
  ISSN={1558-173X},
  month={July},}

@ARTICLE{11311713,
  author={Ameri, Ali and Chien, Jun-Chau and Niknejad, Ali M.},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Design and Implementation of a 200-GHz 200-Pixel 2-D Near-Field Imager}, 
  year={2026},
  volume={61},
  number={7},
  pages={3317-3332},
  abstract={This article introduces a new technique for integrating a dense 2-D array of resonator-based pixels, enabling sub-wavelength-resolution near-field imaging. The imaging pixels consist of active split-ring resonators (ASRRs) operating at 200 GHz. The active component allows for tuning and boosting the quality factor ( $Q$ ) of the resonator to values that are not otherwise achievable on-chip. ASRRs exhibit an amplified sensitivity equal to the square of the  $Q$ -boosting factor. Additionally, these resonators enable the selection and readout of pixels individually and in isolation from the neighboring pixels. The overall footprint of a pixel is  $54 {\times } 46~{\mu \text {m} ^{2}}$  while achieving −27-dB pixel-to-pixel isolation. The imager, as a fully integrated system, is comprised of compact and efficient 200-GHz signal sources and distribution networks, 200 imaging pixels configured in 20 rows and ten columns, detectors, and baseband signal processing. Phase detection and correlated double sampling (CDS) are employed to suppress the close-in phase noise of the sub-THz voltage-controlled oscillator (VCO) in addition to the flicker noise of the detection chain, collectively resulting in a 58.5 dB of dynamic range (DR). The imager was implemented in a 28-nm bulk CMOS process and consumes a total of 79 mW of power during image acquisition. The platform, after biocompatible packaging, was demonstrated in near-field imaging of multiple biological and synthetic tissues, resulting in high-contrast delineation of various sections of the sample. The imaging pixels respond to the real and imaginary parts of the sample permittivity differently, allowing for decoupled measurements and image reconstruction based on these quantities.},
  keywords={Imaging;Detectors;Resonators;Resonant frequency;Image resolution;Baseband;Radio frequency;Voltage-controlled oscillators;Tuning;Circuits;Active split-ring resonator (ASRR);correlated double sampling (CDS);diagnostics;imaging;mm-wave;near field;permittivity;sensing;sub-THz},
  doi={10.1109/JSSC.2025.3644751},
  ISSN={1558-173X},
  month={July},}

@ARTICLE{11285786,
