@ARTICLE{11320312,
  author={Abdelaal, Ahmed and Kauffman, John G. and Dalla Longa, Matteo and Conzatti, Francesco and Ortmanns, Maurits},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={An 80 MHz CT DSM With SMASH DAC Achieving 106.2 dB SFDR Without Linearity Calibration}, 
