  number={10},
  pages={5553-5567},
  abstract={In this article, a four-element digital-modulated phased-array transmitter based on quadrature switched/floated-capacitor power amplifiers (SFCPAs) and reconfigurable switched-capacitor tuning lines (RSCTLs) is proposed. Phase shifting in each element is achieved by hybrid coarse and fine phase-tuning approaches. The SFCPAs with the quadrature-rotation technique are presented for coarse phase tuning. The baseband signals for the quadrature SFCPAs are preset based on the phase-shifting codes. Meanwhile, the RSCTLs are used for fine phase tuning. Capacitors with various capacitances are switched on under different phase-shifting states. To improve the efficiency at deep power back-off (PBO) peaks, hybrid Doherty and impedance boosting techniques are utilized. A 4-to-1 reconfigurable transformer is introduced in the SFCPAs for flexible impedance tuning. To improve isolation among four elements, active power dividers are utilized. The proposed phased-array transmitter is implemented and fabricated in conventional 40-nm-CMOS technology with a chip size of 8.32 mm2. The fabricated phased-array transmitter features a 28.4 dBm peak output power and 37.9% peak system efficiency. Meanwhile, 37.9%/33.7%/28.7%/23.5%/17.6%/12.9% system efficiency is achieved under 0/3/6/9/12/15-dB PBOs at 2.4 GHz. In addition, it supports 15-bit phase-tuning resolution with rms phase/power error of  $0.12\boldsymbol {^{\circ } }$ /0.15 dB. For 25 MHz 256-QAM/40 MHz 64-QAM modulation signals, it exhibits EVM of 2.22%/4.69%,  $\boldsymbol {P_{avg}}$  of 21.5 dBm/22.7 dBm, and average system efficiency of 23.2%/26.1% at 2.4 GHz. Utilizing a monopole antenna with a gain of 4.21 dBi, peak EIRP of 43.5 dBm is obtained. Meanwhile, the radiation patterns with  $0\boldsymbol {^{\circ } }$ ,  $15\boldsymbol {^{\circ } }$ ,  $30\boldsymbol {^{\circ } }$ , and  $45\boldsymbol {^{\circ } }$  beam steering are measured based on the monopole antenna array.},
  keywords={Arrays;Transmitters;Phased arrays;Solids;Tuning;Capacitors;Switches;Codes;Baseband;Cells (biology);Efficiency enhancement;phase tuning line;phased-array transmitter;quadrature rotation;switched/floated-capacitor power amplifier (SFCPA)},
  doi={10.1109/JSSC.2026.3702007},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11559091,
  author={Wang, Xuan and Ma, Xujun and Lu, Lin and Fan, Xuewei and Chen, Qin and Liu, Zhiqiang and Xia, Haiyang and Liu, Ziqi and Ye, Shutao and Liu, Ruibiao and Yang, Yuqing and Zhang, Jingwei and Feng, Jing and Fu, Yupeng and Wu, Xu and Wang, Dongming and Li, Lianming and You, Xiaohu},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Waveform-Sharing Joint Radar-Communication Transceiver With PLL-Based Chirp Spread Spectrum Modulator}, 
  year={2026},
  volume={61},
  number={10},
  pages={5568-5588},
  abstract={A 60-GHz waveform-sharing joint radar-communication (JRC) transceiver with phase-locked loop (PLL)-based chirp spread spectrum (CSS) modulator is presented for seamless integrated sensing and communication (ISAC). Unlike existing communication-centric JRC transceivers that prioritize high throughput, the proposed sensing-centric transceiver employs unified CSS waveforms to perform uncompromised sensing performance while enabling robust long-range communication. To this end, a PLL-based CSS modulator is implemented, simplifying the transceiver architecture while generating wideband CSS signals with high chirp slope, superior linearity, and low phase noise. Within this modulator, a multi-bank capacitor array is integrated into a two-point modulation (TPM)-based sub-sampling (SS) PLL, enabling fast wideband chirp generation and rapid frequency hopping while achieving excellent phase noise. Moreover, an adaptive binary-search (BS) overlap compensation scheme is proposed to mitigate the discontinuity issues in the multi-bank capacitor array while ensuring robust and orderly convergence. Furthermore, building on the TPM-based sub-sampling PLL (SSPLL), a digital CSS modulation engine is developed to enable wideband CSS signal generation without compromising the chirp linearity. Fabricated in a 65-nm CMOS process, the CSS transceiver core occupies 6.11 mm2 and consumes 568 mW. For the over-the-air (OTA) test, broadband high-gain horn antennas with a gap waveguide (GW)-based transition are integrated with the chip through a low-loss wire-bonding matching scheme, achieving a low-cost, compact, and reliable assembly. OTA measurements demonstrate that the measured range resolution is approximately 5.5 cm, while achieving a communication range exceeding 500 m at a 4.138 Mbps data rate with a bit error rate (BER) below  $10^{-5}$ .},
  keywords={Phase locked loops;Chirp;Frequency;Transceivers;Distance measurement;Modulation;Symbols;Arrays;Gain;Bandwidth;Chirp spread spectrum (CSS) modulation;frequency-modulated continuous-wave (FMCW);integrated sensing and communication (ISAC);joint radar-communication (JRC);overlap compensation;phase-locked loop (PLL)},
