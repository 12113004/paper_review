@ARTICLE{11570998,
  author={Qiu, Siyuan and Song, Xiaoyi and Song, Xiangjie and Zhou, Changchun and Song, Xiaoyan and Yang, Jie and Wang, Wenjin and Yang, Yuchao and Jiao, Hailong},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={PANDA: A Reconfigurable Seizure Prediction and Detection Neural Network Accelerator for Epilepsy Monitoring}, 
  year={2026},
  volume={61},
  number={10},
  pages={5909-5923},
  abstract={For effective healthcare management of epilepsy patients in a non-hospital environment, continuous monitoring of EEG signals is crucial, where wearable intelligent devices are essential. The existing seizure monitoring devices, however, cannot achieve high sensitivity, a short detection latency, a low false alarm rate (FAR), as well as ultra-low-power computing simultaneously. These devices also struggle to keep pace with the rapid iteration of seizure monitoring algorithms. In this article, PANDA, a reconfigurable seizure Prediction ANd Detection neural network Accelerator, is proposed. A lightweight, two-stage seizure monitoring framework with temporal neural network splitting (TNNS) is deployed on PANDA, which significantly reduces the amount of computations while maintaining high classification performance. An input channel first-output stationary (IFOS) dataflow, a zero activation skipping (ZAS) scheme, and orthogonal data reuse technique are employed to enhance the computation efficiency. A weight cache with statistical information (WCSI) is also proposed to minimize weight memory access. Furthermore, PANDA employs a custom instruction set, enabling the flexible deployment of various neural networks. PANDA is fabricated using a 65-nm CMOS technology and evaluated on two open-source datasets. For the CHB-MIT scalp EEG dataset, PANDA achieves 99.0% sensitivity, 0.47/h FAR, and 3.49 s detection latency. For the SWEC-ETHZ iEEG dataset, PANDA achieves a 98.2% sensitivity, 0.60/h FAR, and 4.61 s detection latency. Compared with the state-of-the-art designs, PANDA enhances energy efficiency by up to  $5.49\times $  while maintaining competitive classification performance, providing a reconfigurable and energy-efficient solution for wearable epilepsy healthcare systems.},
  keywords={Signal detection;Modeling;Electroencephalography;Detectors;Educational institutions;Neural networks;Epilepsy;Monitoring;Sensitivity;Convolution;EEG;epilepsy;neural network accelerator;reconfigurable;seizure detection;seizure prediction},
