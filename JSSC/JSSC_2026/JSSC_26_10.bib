  number={10},
  pages={5924-5936},
  abstract={Cryogenic ternary logic-in-memory (LIM) is a promising solution to improve storage density and computation efficiency for data-intensive applications by performing ternary operations directly within memory. However, most previous ternary logic implementations rely on binary-encoded processing at room temperature, making it difficult to achieve the density benefits of true ternary operation for both compute and memory at cryogenic temperatures. To address this issue, this work presents a 28 nm  $128\times 128$  cryogenic true ternary LIM (CTLIM) macro. First, we propose a compact four-transistor one-capacitor (4T1C) cryogenic ternary cell (CTC) capable of storing a trit, featuring a full-swing write path for stable ternary data storage and a decoupled dual-transistor readout for reliable sensing and efficient LIM operations. Second, we develop a true ternary write–read scheme comprising a ternary write driver (TWD), a charge-sharing-based bitline reference voltage configuration (BRVC), and a voltage-latched ternary sense amplifier (TSA). Third, we implement true ternary LIM operations, including one-operand [standard ternary inverter (STI), negative ternary inverter (NTI)] and two-operand [MIN, MAX, consensus (CONS), accept-anything (ANY)] ternary operations, enabled by the TSA and BRVC. Measurement results of our test chip in a 28-nm bulk CMOS process demonstrate that the CTLIM macro achieves a macro density of 1.92 Mb/mm2 and ternary LIM energy consumption of 23.63–31.27 fJ/bit at 77 K. Moreover, it also achieves a retention time of 18 ms, demonstrating area-efficient true ternary storage and LIM operations at cryogenic temperatures.},
  keywords={Voltage;Writing;Circuits;Multivalued logic;Timing;Memory;Design methodology;Cells (biology);In-memory computing;Educational institutions;Cryo-CMOS;embedded dynamic random access memory (eDRAM);logic-in-memory (LIM);multi-valued logic;ternary logic},
  doi={10.1109/JSSC.2026.3701950},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11585805,
  author={You, De-Qi and Khwa, Win-San and Zhang, Bo and Wu, Jui-Jen and Jhang, Chuan-Jia and Lin, Guan-Yi and Chen, Po-Jung and Chiu, Ting-Chien and Chen, Fang-Yi and Lee, Andrew and Hung, Yu-Cheng and Lo, Chung-Chuan and Liu, Ren-Shuo and Hsieh, Chih-Cheng and Tang, Kea-Tiong and Chih, Yu-Der and Jonathan Chang, Tsung-Yung and Chang, Meng-Fan},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Nonvolatile AI-Edge Processor With Lossless-Compressed-Computing STT-MRAM Near-Memory-Compute Macro Using Dynamic Floating-/Fixed-Point Accumulation}, 
  year={2026},
  volume={61},
  number={10},
  pages={5937-5949},
  abstract={Nonvolatile AI-edge processors based on near-memory-compute (nvNMC) enable energy-efficient multiply-and-accumulate (MAC) operations with short wakeup latency for edge inference operations. Lossless compression is required for floating-point (FP) neural network (NN) models under on-chip memory capacity constraints; however, this imposes several challenges: 1) data decompression overhead due to lossless FP weight encoding; 2) a read-yield–energy tradeoff due to near-far effects in large nonvolatile memory arrays; 3) a MAC-accuracy–energy tradeoff in FP accumulation within the multi-level adder tree; and 4) inefficient layer fusion due to feature-map (FM)–weight mapping in nvNMC. This article addresses these challenges by presenting a nonvolatile AI-edge processor featuring four system–circuit co-design schemes: 1) delta-exponent lossless compression computation (DELC ${}^{2}$ ); 2) near-far-aware bias-and-mapping (NFABM); 3) dynamic floating-/fixed-point (FXP) accumulation (DF2PA); and 4) nvNMC-friendly hybrid-layer-fusion weight-mapping (CIM-HLF-WM). A test chip fabricated using foundry-provided 22-nm spin-transfer-torque magnetic random access memory (STT-MRAM) achieved an energy efficiency of 24.6 TFLOPS/W and a wakeup-to-response latency of 428.58  $\mu $ s under BF16 input and weight, verifying its effectiveness for capacity- and energy-constrained AI-edge applications.},
  keywords={In-memory computing;Program processors;Arrays;Media Access Control;Memory;Solids;Educational institutions;Calcium;Electrical engineering;Storage area networks;Artificial intelligence (AI);floating-point (FP);multiply-and-accumulate (MAC);near-memory-compute (NMC);spin-transfer-torque magnetic random access memory (STT-MRAM)},
  doi={10.1109/JSSC.2026.3705432},
  ISSN={1558-173X},
  month={Oct},}

