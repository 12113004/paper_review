@ARTICLE{11610875,
  author={Ibrahim, Yahia and Niknejad, Ali M.},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Performance Comparison Between W-Band Sequential and Doherty Power Amplifiers for Power Back-Off Efficiency Improvement}, 
  year={2026},
  volume={61},
  number={10},
  pages={5589-5600},
  abstract={This work presents a W-band sequential power amplifier (PA) featuring a compact and low-loss output combiner that enhances power back-off (PBO) efficiency by combining a main PA and an auxiliary PA through an isolated combining output network. The proposed architecture is analyzed and experimentally compared to the conventional Doherty PA (DPA). The analysis identifies the limiting factors for achieving 6 dB PBO efficiency improvement in DPAs and demonstrates how sequential PAs can overcome these limitations, particularly for high-frequency implementations such as the W-band. Both the sequential and DPA chips are implemented in a 16 nm FinFET technology. The sequential PA exhibits a small-signal gain of 13 dB over a 13 GHz bandwidth (BW) from 75–88 GHz, while the DPA achieves a similar 13 dB gain over an 11 GHz BW from 78–89 GHz. The sequential PA demonstrates better power performance, achieving a saturated output power ( $P_{\mathrm {sat}}$ ) of 13.6 dBm and an output-referred 1 dB compression point (OP1dB) of 13 dBm at 80 GHz, compared to the DPA  $P_{\mathrm {sat}}$  of 12.2 dBm and OP1dB of 11 dBm at 83 GHz. Furthermore, sequential PA achieves 20% peak power-added efficiency (PAE) and 14% PAE at 6 dB PBO, corresponding to approximately  $1.4\times $  efficiency improvement over an ideal class B PA at 80 GHz. In comparison, the DPA achieves 16.3% peak PAE and 10% PAE at 6 dB PBO, corresponding to  $1.25\times $  improvement at 83 GHz. The sequential PA maintains this high power and efficiency across a wide 76–88 GHz frequency range, whereas the DPA exhibits a narrower operational BW of 79–87 GHz. The sequential PA occupies a compact chip area of 0.096 mm2, compared to 0.112 mm2 for the DPA. To the authors’ knowledge, this sequential PA achieves the highest efficiency at 6 dB PBO among CMOS PAs operating in this frequency band while achieving the highest efficiency improvement compared to class B PAs.},
