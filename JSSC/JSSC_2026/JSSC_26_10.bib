  month={Oct},}

@ARTICLE{11495123,
  author={Ma, Zongle and Chen, Yicheng and Li, Qing and Li, Kai and Ma, Kaixue and Wang, Keping},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 415 μW 2.4 GHz Receiver With Third-Harmonic Time-Interleaved Passive Mixer and Reconfigurable AFIR Filter for IoT Applications}, 
