@ARTICLE{11589279,
  author={Tay, Sun-Yang and Adrian, Victor and Chang, Joseph S.},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Subminiature Light-Load Efficient Integrated DC--DC Converter Featuring High Inductance Density Bond-Wire Inductor and Low Quiescent Current PFM Controller}, 
