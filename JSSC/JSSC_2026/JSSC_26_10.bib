@ARTICLE{11575068,
  author={Park, Seonghyun and Cheon, Song-I and Choi, Haidam and Oh, Sein and Ha, Sohmyung and Je, Minkyu},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Bio-Impedance Readout IC With Phase-Locked Sampling for Real-Time Electrical Impedance Spectroscopy}, 
  year={2026},
  volume={61},
  number={10},
  pages={5229-5242},
  abstract={This article presents an electrical bio-impedance (bioZ) spectroscopy integrated circuit (IC) that achieves both high-throughput and high-accuracy. The proposed phase-locked sampling (PLS) scheme, which employs a sampling phase-locked loop (SPLL) and a reference resistor ( $R_{\textit {REF}}$ ), enables fast and precise impedance demodulation. By extracting the impedance components through sampling rather than relying on DC settling, the proposed approach overcomes the inherent settling-time limitations of prior demodulation-based bioZ systems, thereby enabling high-throughput operation. In addition, the use of a reference resistor with the identical signal path of the target impedance allows effective cancellation of errors originating from the current generator (CG) as well as chip-to-chip variations in the amplifier and low-pass filter (LPF), significantly improving measurement accuracy. To further support wideband operation with low power consumption, the input signal is pre-demodulated to an intermediate frequency. This technique relaxes the operating frequency requirement of the readout IC, enabling a simple and efficient implementation of the sampling-based architecture. Measurement results demonstrate magnitude and phase errors of less than 1.78% and 1.8°, respectively, over a wide frequency range from 4 kHz to 2 MHz. Furthermore, the proposed IC achieves an input-referred impedance noise of 34.9 m $\Omega $ / $\sqrt {}$ Hz while supporting an output data rate (ODR) of 4–40 kS/s.},
  keywords={Integrated circuits;Impedance;Timing;Solids;Measurement;Frequency;Virtual machines;Gain;Phase locked loops;Current;Bio-impedance (bioZ);electrical impedance spectroscopy (EIS);high-accuracy;high-throughput;phase-locked sampling (PLS);readout front-end (RFE);reference resistor ( $R_{\textit {REF}}$  );sampling phase-locked loop (SPLL)},
  doi={10.1109/JSSC.2026.3704052},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11609548,
  author={Liang, Mingchao and An, Yu and Cao, Peng and Xu, Jiawei and Hong, Zhiliang},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A High-Efficiency Multilevel Class-G Supply Modulator Using a Configurable Capacitor Array for Wideband Power Amplifier}, 
  year={2026},
  volume={61},
  number={10},
  pages={5243-5255},
  abstract={This article presents a multilevel class-G supply modulator (SM) for high-efficiency wideband radio frequency (RF) power amplifiers (PAs). As the envelope bandwidth of modern 5G new radio (NR) signals extends to 200 MHz, conventional analog envelope tracking (ET) suffers from limited bandwidth, while switched discrete SMs face challenges associated with high system cost. To support wideband ET, a systematic design framework is developed to capture the fundamental tradeoff between multilevel voltage allocation and tracking rate. Based on this framework, a hybrid single-inductor adaptive-output (SIAO) architecture is proposed, enabling selective regulation of multiple output paths within each switching cycle and unified buck-boost operation. Multilevel output generation is realized using a configurable capacitor array (CCA) providing six voltage levels with three off-chip capacitors to reduce supply voltage overhead and the number of external components. A skip-charging constant-off-time (COFT) control scheme is employed to efficiently regulate the multilevel outputs under wideband operation. Fabricated in a 180-nm BCD process with an active area of 6  $\text {mm}^{{2}}$ , the proposed SM achieves a peak efficiency of 88.9% at 0.54 W and maintains over 80% efficiency from 0.3 to 1.6 W when tracking a 200-MHz NR envelope. When evaluated with a commercial PA, the SM improves the system power-added efficiency (PAE) from 6.2% using average power tracking (APT) to 7.1% at 19-dBm average output power.},
  keywords={Modulation;Tracking;Capacitors;Voltage;Switches;Solids;Timing;Power amplifiers;Bandwidth;5G mobile communication;5G new radio (NR);capacitor array;Class-G;constant-off-time (COFT);hybrid converter;multilevel;power amplifier (PA);single-inductor multiple-output (SIMO) converter;supply modulator (SM)},
  doi={10.1109/JSSC.2026.3711586},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11589298,
  author={Mu, Xuchu and Jiang, Yang and Ming, Xin and Zhang, Bo and Martins, Rui P. and Mak, Pui-In},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Nesting-Connected Reconfigurable SC Converter With Fine-Grained Conversion Ratios and Increased Output Conduction Paths for On-Chip Surround Power Delivery}, 
  year={2026},
  volume={61},
  number={10},
  pages={5256-5268},
  abstract={This article presents a reconfigurable switched-capacitor (SC) DC–DC converter that achieves improved overall efficiency over a fine-grained conversion-ratio range, applicable to on-chip surround power delivery (SPD) in compact and lightweight devices. We propose a nesting-connected reconfigurable SC topology generation method, attaining fine-grained subdivision of reconfigurable voltage conversion ratios (VCRs) using a limited number of flying capacitors ( $C_{\mathrm {FLY}}$ s). We also propose a normalized modeling method to evaluate the steady-state conduction-loss property for the nesting-connected arithmetic progression (NAP) topology implemented in this work. Modeling results demonstrate that the NAP topology enables fine-grained VCR generation and improved fast-switching-limited conduction loss characteristics, compared with the conventional series-connection method. In addition, due to its inherent property of multiple output charge-delivery paths, the proposed NAP converter is suitable for on-chip SPD to achieve a more uniform conduction charge distribution. Fabricated in a 180-nm CMOS process using standard 5-V devices, the proposed SC converter occupies an active area of 3.432 mm2. It utilizes eight  $C_{\mathrm {FLY}}$ s in 01005 packages, totaling a volume of only 0.128 mm3, to achieve 25 inherent step-down VCRs of this NAP topology, ranging from 0.11 to 0.67. Thus, the converter can convert a 5-V input to a wide-range output of 0.35–3.3 V. Measurement results demonstrate a peak efficiency of 92.34% at 50-mA output current and a maximum capable load current of 500 mA.},
  keywords={Switches;Topology;Video recording;Converters;Modeling;Joining processes;Voltage;Capacitors;Measurement units;Solids;DC–DC converter;nesting-connected;reconfigurable topology;surround power delivery (SPD);switched capacitor},
  doi={10.1109/JSSC.2026.3702012},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11576048,
  author={Huang, Yu-Ting and Wu, Xiao-Quan and Chen, Chi-Yu and Chiu, Po-Jui and Cho, Chien-Wei and Wang, Tz-Wun and Chen, Ke-Horng and Lin, Ying-Hsi and Lin, Shian-Ru and Tsai, Tsung-Yen and Hung, Sheng-Hsi and Huang, Chih-Fang and Fan, Philex Ming-Yan and Liang, Tsorng-Juu and Tsai, Hann-Huei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Capacitor-Free Hybrid-Process Low Dropout Regulator With Ultrahigh-Gain Amplifier and Super Source Follower for 0.297 mV/A Load Regulation and 0.024 mV/V Line Regulation}, 
  year={2026},
  volume={61},
  number={10},
  pages={5269-5281},
  abstract={The proposed capacitor-free hybrid-process low-dropout regulator (LDO) achieves 900-mA maximum current capacity and 99.99% peak current efficiency with 90  $\mu $ A quiescent current. By combining GaN and silicon processes, the proposed Ultrahigh gain amplifier (UHGA) enables a high loop gain to achieve 0.297-mV/A load regulation and 0.024-mV/V line regulation. Furthermore, UHGA provides a larger slew rate compared to a conventional monolithic design. The super source follower (SSF) serves as a buffer to provide dynamic source and sink current at the gate of the pass element to realize low quiescent current in the steady state and recovery times of 90 and 54 ns when the loading goes to heavy and light, respectively.},
  keywords={Gain;Current;Regulation;Generative adversarial networks;Loading;Educational institutions;Solids;Conferences;Awards;Integrated circuits;Capacitor-free low-dropout regulator (LDO);fast transient response;hybrid-process LDO;line regulation;load regulation},
  doi={10.1109/JSSC.2026.3702962},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11594069,
  author={Choi, Edward Jongyoon and Choi, Byeongseon and Chun, Jiho and Je, Minkyu and Kim, Bongjin},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Verifica: Near-Memory Symbolic Interval Computing Formal Neural Network Verification Accelerator}, 
  year={2026},
  volume={61},
  number={10},
  pages={5282-5295},
  abstract={Formal robustness verification of neural networks is essential for deploying machine learning (ML) systems in safety-critical applications. However, existing verification frameworks are predominantly software-based, incurring prohibitive computational costs and long runtimes, severely limiting scalability and practical deployment. Although symbolic interval analysis enables scalable over-approximate verification, its effectiveness is limited by excessive over-estimation introduced by non-linear activation functions, such as ReLU, and by inefficient data movement on conventional computing platforms. This article presents the first ASIC-based neural network verification accelerator that implements symbolic interval-based robustness verification through an algorithm–hardware co-design approach. The proposed method represents network outputs as a symbolic linear combination of input variables, enabling tight-bound evaluation via coefficient propagation. To mitigate ReLU-induced over-approximation, a linear relaxation (LR) with a tunable parameter is employed, along with an iterative ReLU state refinement mechanism that enables efficient adversarial example search when robustness cannot be directly certified. The proposed accelerator is implemented in a 65-nm CMOS technology using a transposable 10T SRAM-based near-memory computing architecture, allowing efficient interval arithmetic and symbolic coefficient propagation with minimal data movement. Measurement results demonstrate scalable and energy-efficient robustness verification, providing over 97% verifiability with verification latency ranging from 0.05 to 1.22 ms and energy consumption of 0.09– $2.14~\mu \mathrm {J}$  per verification. These results demonstrate that dedicated hardware acceleration enables practical, fast, and scalable formal neural network verification.},
  keywords={Robustness;Neural networks;Memory;Modeling;Hardware;Neurons;Conferences;Upper bound;Distance measurement;Solids;Deep neural networks (DNNs);domain-specific accelerator;hardware attacks;hardware security;near-memory computing (NMC);neural network verification},
  doi={10.1109/JSSC.2026.3707324},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11631843,
  author={Lee, Hongseok and Burd, Jack and Ling, Tim and Yang, Yao-Kai and Chang, Nian-Shyang and Chen, Wen-Ching and Chen, Chi-Shi and Chiueh, Tzi-Dar and Lee, Michael Kuan-Tse and Yang, Chia-Hsiang and Marković, Dejan},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Runtime Reconfigurable Array (RTRA) for Multiprogram ML and DSP Acceleration With Hierarchical Partitioning and On-Chip Multilevel Scheduling}, 
  year={2026},
  volume={61},
  number={10},
  pages={5296-5312},
  abstract={Emerging applications with highly dynamic digital signal processing (DSP) and machine-learning (ML) workloads demand a hardware platforms that simultaneously deliver high performance, high energy efficiency, and low-latency reconfiguration. Such systems must adapt to evolving algorithms, variable data rates, and multiprogram tenancy without incurring prohibitive switching overhead. The conventional reconfigurable architectures and their associated scheduling frameworks typically rely on off-chip, software-based scheduling and mapping, introducing substantial latency and limited scalability. In addition, their dependence on the complex 2-D placement methods across processing-element (PE) arrays constrains responsiveness and resource utilization, making them unsuitable for real-time and multiprogram operation. To address these limitations, we present a runtime reconfigurable array (RTRA), a coarse-grained hardware fabric that integrates on-chip scheduling and is architected around modular, hierarchically partitioned compute blocks. This organization enables fast scheduling and mapping, sustains high utilization across diverse workloads, supports fine-grained multiprogram tenancy, and achieves high energy and area efficiency.},
  keywords={Arrays;Schedules;Scheduling;System-on-chip;Hardware;Tiles;Runtime;Architecture;Computer architecture;Programming;Coarse-grained reconfigurable architecture (CGRA);network-on-chip (NoC);on-chip hardware scheduling;runtime reconfiguration;system-on-chip (SoC)},
  doi={10.1109/JSSC.2026.3715500},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11520220,
  author={Zhao, Yuanzhe and Wang, Yuheng and Xie, Heng and Wang, Zijian and Martins, Rui P. and Chan, Chi-Hang and Zhang, Minglei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 28-nm PVT Inner-Tracking Time-Domain Compute-In-Memory Macro for Edge-AI Devices}, 
  year={2026},
  volume={61},
  number={10},
  pages={5313-5325},
  abstract={This article presents an energy-efficient and process-, voltage-, and temperature (PVT)-robust time-domain (TD) compute-in-memory (CIM) macro for edge artificial intelligence (AI) devices. It features: 1) a PVT inner-tracking (PIT) technique that aligns the PVT responses of TD computation and TD quantization, delivering inherent robustness without incurring extra power or circuit overhead; 2) a scalable global timer (SGT) that eliminates standard quantization within the CIM array, enabling scalable precision for varying accumulation sizes while alleviating energy and area bottlenecks; and 3) a reconfigurable pipelined cascading (RPC) mechanism that allows for flexible accumulation sizes without sacrificing utilization and speed, thus narrowing the gap between peak and average energy efficiency. Fabricated in a 28-nm CMOS process, the prototype TD-CIM macro achieves an energy efficiency of 82.2–236.5 TOPS/W in 4-bit mode and 20.4–58.7 TOPS/W in 8-bit mode. Furthermore, the 8-bit mode demonstrates an accuracy loss of less than 1.12% across various networks on ImageNet, even with wide variations in supply voltage and temperature.},
  keywords={Solids;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;In-memory computing;Media Access Control;Quantization (signal);Timing;Voltage;Delays;Compute-in-memory (CIM);energy efficiency;flexible accumulation sizes;inner-tracking;macro;robustness;scalable precision;time-domain (TD)},
  doi={10.1109/JSSC.2026.3691189},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11517521,
  author={Yune, Sungwoong and Yoon, Jieon and Lee, Hangyeol and Putra, Adiwena and Heo, Jaehoon and Kim, Joo-Young},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 11.0-TOPS/W Diffusion Accelerator With Temporal Data Reuse for Real-Time Text-to-Motion Generation}, 
  year={2026},
  volume={61},
  number={10},
  pages={5326-5338},
  abstract={Text-to-motion models are AI systems that generate human motion sequences directly from natural language descriptions, serving as key enablers for immersive virtual avatars and interactive digital humans in AR/VR ecosystems. However, state-of-the-art text-to-motion diffusion models suffer from substantial computational costs due to their iterative nature, making them ill-suited for deployment on resource-constrained edge devices. To address these challenges, we propose MoDiff, a hardware–software codesigned processor that exploits temporal redundancy across denoising steps. MoDiff introduces a sparse feed-forward network (FFN) computation strategy that selectively recomputes only critical GELU activation outputs, effectively bypassing redundant operations without sacrificing generation quality. To efficiently support this irregular sparsity, MoDiff integrates a dynamic sparsity matmul engine (DSME) and a reconfigurable vector-processing engine (RVPE). Furthermore, MoDiff incorporates a difference-based softmax approximation (DSA) and a unified quantization flow to significantly lower power consumption and area overhead. MoDiff is fabricated in 14-nm CMOS technology with a die area of 7.16 mm2 and achieves a peak energy efficiency of 11.0 TOPS/W. Despite aggressive quantization, MoDiff maintains motion generation quality comparable to floating-point inference, establishing a compelling solution for real-time generative AI on edge platforms.},
  keywords={Modeling;Noise reduction;Hardware;Memory;Table lookup;Diffusion models;Quantization (signal);Field programmable gate arrays;Timing;Costing;Computer architecture;diffusion models;hardware–software codesign;human motion generation;machine learning accelerators;sparse representations},
  doi={10.1109/JSSC.2026.3689546},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11615114,
  author={Wang, Huanyu and Wang, Yang and Yang, Jiaxin and Hu, Yang and Yin, Shouyi},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={PDAcc: A Prefill-Decode Disaggregated MCM-Based Accelerator for Multi-Task Large Language Model Applications}, 
  year={2026},
  volume={61},
  number={10},
  pages={5339-5356},
  abstract={Prefill-decode (PD) disaggregation has emerged as a promising serving paradigm for large language models (LLMs), as it decouples prompt processing (prefill) from autoregressive token generation (decode) to reduce inter-task interference and improve quality of service (QoS). However, disaggregation also amplifies stage imbalance: the prefill cluster (P-C) can become compute-limited, the decode cluster (D-C) is often bandwidth-limited, and the required cross-device KV cache transfer introduces additional communication overhead. This work presents PDAcc, a four-chiplet multi-chip-module (MCM) accelerator optimized for PD-disaggregated LLM inference. PDAcc employs reconfigurable chiplets that can be dynamically assigned to prefill or decode according to workload ratios. It further introduces three techniques: copy-less float hybrid-LUT multiply (CFHM) to repurpose idle on-chip SRAM for prefill acceleration, hybrid compressed weight gather (HCWG) to utilize prefill-side bandwidth and improve inter-chip weight delivery for decode, and cross-cluster attention dataflow (CCAD) to reduce dependency traffic by shifting part of attention computation across clusters. Implemented in 22-nm technology as a four-chiplet MCM, PDAcc sustains 541–4727 effective tokens/s on GPT-2, OPT, and Llama 3.2, achieving  $5.76\times $  higher prefill throughput and  $12.42\times $  higher decode throughput than a single chiplet, and further delivering an additional 1.50– $3.24\times $  improvement over a four-chiplet PD-aggregated baseline with the same MCM scaling.},
  keywords={Decoding;Modeling;Head;Personal digital devices;Bandwidth;SRAM chips;Large language models;Information rates;Throughput;Banking;Accelerator;chiplet;inference;large language model (LLM);multi-chip-module (MCM);prefill-decode (PD) disaggregation},
  doi={10.1109/JSSC.2026.3708458},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11534256,
  author={Choi, Jiwon and Hong, Seongyon and Jo, Wooyoung and Park, Wonhoon and Whang, Sunjoo and Kim, Seryeong and Kim, Sangjin and Yoo, Hoi-Jun},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={MIDAS: An Energy-Efficient Microscaling Quantization-Based Digital CIM Accelerator With Spatio-Temporal Cyclic Alignment for Generative AI}, 
  year={2026},
  volume={61},
  number={10},
  pages={5357-5369},
  abstract={Digital compute-in-memory (DCIM) and the microscaling (MX) data format have emerged as promising hardware and algorithmic solutions, respectively, for energy-efficient generative AI (GenAI) processing. However, their combination introduces challenges, including redundant computation from mantissa alignment, excessive exponent handling overhead, and accuracy loss from static approximation schemes that fail to accommodate block-wise dynamic bit-significance. In this article, we present MIDAS, an MX-optimized DCIM-based GenAI accelerator with three key features: 1) spatio-temporal cyclic alignment (STCA) with sign-magnitude-based assembled column addition (SACA) enables compact weight mapping, high input reusability, and low-latency computation, achieving  $1.72\times $  higher macro energy efficiency; 2) MX-aware minimum exponent post-detection (MEPD) eliminates redundant maximum exponent detection by exploiting the inherent characteristics of MX quantization, reducing exponent handling power, area, and latency by 68.8%, 63.2%, and 22.5%, respectively; and 3) sense amplifier-based dynamic bit (SADB)-significance handling with shared scale-aware channel regrouping (SSCR) dynamically adjusts approximation bit-positions according to each block’s shared scale, improving energy efficiency by 27.3% while minimizing accuracy loss. MIDAS is fabricated in Samsung 28-nm CMOS technology and occupies a 7.56 mm2 die area. MIDAS achieves macro energy and area efficiencies of 96.3 TFLOPS/W and 0.69 TFLOPS/mm2, respectively, under MXFP4. Compared to state-of-the-art DCIMs, MIDAS demonstrates  $1.58\times $  higher system energy efficiency and  $3.32\times $  higher macro energy efficiency, validating its effectiveness as an MX-optimized AI accelerator for next-generation GenAI applications.},
  keywords={In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Life cycle assessment;Energy efficiency;Quantization (signal);Signal detection;Accuracy;Solids;Compute-in-memory (CIM);energy-efficient;generative artificial intelligence (GenAI);microscaling (MX) format},
  doi={10.1109/JSSC.2026.3692361},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11626529,
  author={Ji, Xuansheng and Feng, Liqun and Liao, Qianxian and Rhee, Woogeun and Wang, Zhihua},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Coherent Polar Phase-Tracking Receiver With High ACR and Relaxed I/Q Generation}, 
  year={2026},
  volume={61},
  number={10},
  pages={5370-5382},
  abstract={This article presents a coherent polar phase-tracking receiver (PT-RX) for low-power Internet-of-Things(IoT) applications that supports Gaussian frequency-shift keying (GFSK), quadrature amplitude modulation (QAM), and amplitude phase shift keying (APSK). Existing single-path closed-loop receivers achieve low power but suffer from a fundamental tradeoff between loop stability and adjacent channel rejection (ACR), and are generally limited to constant-envelope modulation. In addition, prior polar receivers rely on noncoherent amplitude demodulation, which limits their sensitivity and blocker tolerance. To address these issues, a delay- and phase-locked loop (D/PLL)-inspired feedforward phase path is introduced to create an additional loop zero, thereby improving loop stability and enabling stronger ACR in closed-loop demodulation. A coherent polar demodulation scheme is also adopted to improve the sensitivity and ACR of the amplitude path. Compared with conventional Cartesian I/Q receivers, the proposed architecture additionally shows improved immunity to I/Q mismatch. The proposed 2.4-GHz receiver is implemented in 65-nm CMOS and supports GFSK at 1 Mb/s, 16-QAM at 2 Mb/s, and 32-APSK at 2.5 Mb/s, achieving sensitivities of −86, −73, and −71 dBm, respectively.},
  keywords={Solids;Educational institutions;Demodulation;Receivers;Tracking;Phase locked loops;Gain;Frequency;Interference;Poles and zeros;Amplitude phase shift keying (APSK);coherent receiver;Internet-of-Things (IoT);phase-tracking;polar receiver;quadrature amplitude modulation (QAM)},
  doi={10.1109/JSSC.2026.3712802},
  ISSN={1558-173X},
  month={Oct},}

@ARTICLE{11548608,
  author={Xu, Dongfan and Tang, Minzhe and Gu, Haiyun and Liu, Yuxuan and Chen, Yilun and Ren, Ziyuan and Fan, Minghao and Zhang, Daxu and Zhang, Yi and Li, Duo and Li, Zheng and Liu, Zezheng and Wang, Chun and Yamazaki, Yudai and Zhang, Yuncheng and Kunihiro, Kazuaki and Sakai, Hiroyuki and Shirane, Atsushi and Okada, Kenichi},
  journal={IEEE Journal of Solid-State Circuits}, 
