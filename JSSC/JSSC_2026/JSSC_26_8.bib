@ARTICLE{11367639,
  author={Ray, Yudhajit and Ghosh, Archisman and Antal, Sarthak and Sen, Shreyas},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 54- $\mu$ W Design-Agnostic Clock, Voltage, and EM-Pulse Fault-Injection Attack Detection Using Time-to-Voltage Conversion}, 
  year={2026},
  volume={61},
  number={8},
  pages={4372-4384},
  abstract={This article presents a state-of-the-art design-agnostic clock, voltage, and electromagnetic pulse (EMP)-based fault-injection attack (FIA) detector. The efficient conversion of time-to-voltage information by integrating amplifiers transforms the time anomaly into the voltage domain, enabling its detection at a lower power consumption. The clock-glitch detector design consumes only  $53~\mu $ W of power, providing a  $33\times $  to  $16\times $  improvement over prior art designs. In addition, the application-specific integrated circuit (ASIC) implementation of a dedicated voltage-based glitch detector consumes only  $1.27~\mu $ W. Variable threshold selection mechanisms are also deployed to address the changes for different process corners, supply voltages, temperature, and frequency of operation, ensuring comprehensive coverage under varying circumstances. Furthermore, this detector has demonstrated its capability to detect EMP-based glitch attacks on integrated circuits (ICs), marking a first-of-its-kind demonstration.},
  keywords={Clocks;Detectors;Cryptography;Circuit faults;Voltage;Power demand;Program processors;Integrated circuits;Engines;Sensitivity;Clock-glitch detector;EM-pulse glitch detector;fault-injection attack (FIA);low area;low power;voltage glitch detector},
  doi={10.1109/JSSC.2026.3655593},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11420975,
  author={Liu, Kunyang and Fu, Zihan and Li, Gen and Pu, Hongliang and Guan, Zhibo and Wang, Xingyu and Xu, Shufan and Niitsu, Kiichi and Shinohara, Hirofumi},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Physically Unclonable Function With Less Than 4.16E--7 BER Featuring Secure In-Cell HCI Burn-In and nMOS-Dominant PUF Data Generation}, 
  year={2026},
  volume={61},
  number={8},
  pages={4385-4398},
  abstract={Physically unclonable functions (PUFs) are a fundamental component of hardware security, enabling secure and low-cost on-chip secret key generation. However, achieving near-zero bit error rates (BERs) across wide supply voltage and temperature (VT) variations often requires access to secret PUF data during stabilization, which poses security risks. This work presents an eight-transistor (8T) SRAM-based PUF that employs a secure in-cell hot-carrier injection (HCI) burn-in technique to stabilize the PUF without requiring access to PUF data and without incurring redundancy, bitcell loss, or on-chip mask data storage. An nMOS-dominant PUF data generation technique is introduced to enhance HCI effectiveness and suppress long-term aging effects, achieving near-zero BER across VT corners even after long-term operation. Fabricated in a standard 130-nm CMOS process, the proposed design achieves a BER of less than 4.16E–7 across a temperature range from –20 °C to 120 °C and a supply voltage range of 1.17–1.43 V. Long-term reliability is validated through a 320-h accelerated aging test. In addition, the design attains a compact bitcell area of 434 F2 and low energy consumption of 8.52 fJ/bit.},
  keywords={Random access memory;Stress;Transistors;System-on-chip;Data collection;Bit error rate;Circuit stability;Thermal variables control;Temperature distribution;Negative bias temperature instability;Confined physically unclonable function (PUF);cryptography;hardware security;hot-carrier injection (HCI);Internet-of-Things (IoT);SRAM;weak PUF},
  doi={10.1109/JSSC.2026.3663657},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11366232,
  author={Wang, Jin and Lou, Moxiao and Yang, Zhengke and Li, Zhixiong and Li, Jiamin and Li, Yida and Yoo, Jerald and Lin, Longyang},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={AdaPIM: A CIM-Based General-Purpose Vision Accelerator With Adaptive Inter-Macro Parallelism and Multi-Level Feature Reuse}, 
  year={2026},
  volume={61},
  number={8},
  pages={4399-4413},
  abstract={Recent advances in computer vision (CV) have introduced a variety of neural network (NN) architectures, including convolutional neural networks (CNNs), vision Transformers, and hybrid CNN-Transformer models. These models involve operators with widely varying computation and memory access patterns, demanding highly flexible and adaptive hardware for efficient execution. However, prior vision accelerators typically adopt fixed, one-size-fits-all designs, leading to inefficient hardware utilization under such diversity. In this work, we propose AdaPIM, an adaptive compute-in-memory (CIM) accelerator that dynamically reconfigures hardware resources to match the varying computation and memory characteristics of diverse CV workloads. AdaPIM incorporates: 1) a reconfigurable 4D-CIM processor that enables adaptive inter-macro parallelism along four architectural dimensions to improve spatial utilization under diverse computation patterns; 2) a flexible on-chip memory system that supports adaptive feature reuse at both register and global buffer levels to reduce on-/off-chip memory traffic under varying access patterns; and 3) a high-throughput vector core optimized for Softmax and layer normalization (LN) through algorithm-architecture co-design. Fabricated in 22 nm, AdaPIM achieves chip-level energy efficiency of 22.7–63.9 TOPS/W and system-level latency [including external memory access (EMA)] of 1.87–17.16 ms/frame with hardware utilization up to 83.12%, delivering improvements of 1.09– $13.96\times $  in frame rate and 1.76– $3.41\times $  in utilization, respectively, over state-of-the-art accelerators across diverse vision workloads.},
  keywords={Computer architecture;Common Information Model (computing);Computational modeling;Hardware;In-memory computing;Adaptive systems;Transformers;Throughput;Adaptation models;System-on-chip;Adaptive architecture;compute-in-memory (CIM);computer vision (CV);hardware utilization;hybrid convolutional neural network (CNN)-Transformer;neural network (NN) accelerator},
  doi={10.1109/JSSC.2026.3654682},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11389164,
  author={Liu, Che-Kai and Wan, Zishen and Noh, Young-Seok and Ibrahim, Mohamed and Spetalnick, Samuel D. and Krishna, Tushar and Khwa, Win-San and Sanjay Lele, Ashwin and Chih, Yu-Der and Chang, Meng-Fan and Raychowdhury, Arijit},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 40-nm Programmable Heterogeneous SoC With 5.625/0.85 MB RRAM/SRAM for Accelerating Neuro-Symbolic AI Models}, 
  year={2026},
  volume={61},
  number={8},
  pages={4414-4429},
  abstract={Neuro-symbolic (NeSy) artificial intelligence (AI) integrates neural learning with symbolic reasoning to enable data-efficient, interpretable, and generalizable intelligence, making it a promising paradigm for human-like cognition. However, the heterogeneous and dynamic execution patterns of NeSy models pose fundamental challenges to conventional AI hardware, which is typically optimized for dense matrix operations. This article presents a fully programmable heterogeneous system-on-chip (SoC) fabricated in 40-nm CMOS, specifically designed to accelerate a wide range of NeSy workloads. The architecture features: 1) integrated resistive RAM (RRAM) and static random access memory (SRAM) neural-symbolic data paths; 2) ultra-dense (4.80 Mb/mm2), energy-efficient (0.247 pJ/b) RRAM macros with edge-triggered and prolonged sensing; 3) scheduler-informed power management; and 4) programming support for variable resolution, vector lengths, and batching. The SoC supports multiple NeSy paradigms and achieves up to 10.8 TOPS/W energy efficiency and  $6.47\times $  power reduction across reasoning benchmarks. This work demonstrates the first end-to-end silicon system for generalizable and efficient NeSy inference.},
  keywords={Artificial intelligence;Cognition;Computational modeling;Kernel;Neural networks;Resistive RAM;Adaptation models;Vectors;System-on-chip;Sensors;Compute-near-memory (CNM);embedded nonvolatile memory (eNVM);neuro-symbolic (NeSy) artificial intelligence (AI);resistive RAM (RRAM);system-on-chip (SoC)},
  doi={10.1109/JSSC.2026.3658288},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11364534,
  author={Lim, Do-Yoon and Ko, Donghan and Kim, Sekeon and Park, Sunjong and Lee, Wangyu and Min, Taegeon and Moon, Jihoo and Jung, Seong-Ook},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Dual-Mode Inverter-Based Write Termination Scheme for Energy- and Area-Efficient Write Operation in 28-nm 1T1MTJ STT-MRAM}, 
  year={2026},
  volume={61},
  number={8},
  pages={4430-4441},
  abstract={Spin-transfer torque magnetic random access memory (STT-MRAM) is a promising non-volatile memory, but its write operation requires a large static current, leading to high write power. Resistance-monitoring write termination (RM-WT) schemes were introduced to reduce write power, but they suffer from several limitations: 1) the sensing circuit (SC) used in previous schemes has limited effective input voltage, degrading the robustness of WT; 2) the prior schemes cause severe area overhead due to the additional WT circuits besides sense amplifier (SA); and 3) the previous schemes cannot support write 0 termination, limiting write power reduction. This article proposes a dual-mode inverter-based write-termination (DMI-WT) circuit that resolves these limitations. In the proposed scheme, a single-ended inverter-based SC (INV-SC) is used, which doubles the effective input voltage without area overhead. In addition, self-referenced offset cancel (OC) is used, which enables robust WT and SA operation. DMI-WT enables WT operation for both write 0 and write 1 operation while simultaneously serving as an SA, thereby reducing the write power and removing the area overhead caused by WT circuits. A prototype chip fabricated in 28-nm CMOS technology with a 256-kb STT-MRAM array shows that DMI-WT achieves up to  $6.39{\times }$  area overhead reduction,  $7.5{\times }$  lower write power per bit at a 20-ns write access time,  $1.27{\times }$  faster read access time, and  $1.41{\times }$  lower read power compared with previous WT circuits using STT-MRAM.},
  keywords={Voltage;Magnetic tunneling;Transistors;Switches;Sensors;Random access memory;Nonvolatile memory;Inverters;Noise;Couplings;1T1 magnetic tunnel junction (MTJ);magnetic random access memory (MRAM);offset cancel (OC);sense amplifier (SA);spin-transfer-torque (STT);write power;write termination (WT)},
  doi={10.1109/JSSC.2026.3654895},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11427357,
  author={Watanabe, Ryota and Nii, Koji and Kojima, Hidemitsu and Uno, Kazumasa and Otsubo, Hiromasa and Chu, Ted and Cheng, Hong-Chen and Wang, Yih and Chang, Tsung-Yung Jonathan},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 13.8% Speed-Enhanced 1 T Mask ROM by Algorithmically Signed Program Data on 3-nm Fin-FET Logic CMOS}, 
  year={2026},
  volume={61},
  number={8},
  pages={4442-4449},
  abstract={As emerging applications increasingly demand higher computational power from embedded memories, achieving sufficient performance and timing margins has become a significant challenge. This article introduces an algorithmically signed mask ROM, which incorporates a sign column into the original read-only memory (ROM) bitcell array to address the tradeoff between access speed and read margin. By generating optimized sign bits for the given data, the proportion of “1”-bits programmed in each column is constrained within a certain narrow range, effectively mitigating the tradeoff. SPICE simulations and silicon measurements of a 1.8-Mbit signed ROM implemented on 3-nm Fin-FET logic CMOS demonstrate read access time improvements of 12.7% and 13.8%, respectively. The proposed signed ROM, which is compatible with compiler implementation, has the potential to significantly enhance the performance of embedded memories, particularly for emerging high-performance applications.},
  keywords={Read only memory;Codes;Vectors;Leakage currents;Arrays;Circuits;Artificial intelligence;Timing;Table lookup;Signal processing algorithms;1 T read-only memory (ROM);3 nm;Fin-FET;high speed;mask ROM},
  doi={10.1109/JSSC.2026.3669626},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11418916,
  author={Yuan, Yiyang and Sun, Zhongyi and Yang, Yiming and Wang, Xinghua and Li, Xiaoran and Ma, Cailian and Chen, Qirui and Tang, Meini and Wei, Xi and Wu, Hao and Wang, Haitao and Liu, Qihao and Chen, Chengying and Yue, Jinshan and Mak, Pui-In and Zhang, Feng},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 28-nm Hybrid-Domain Outer Product-Based Floating-Point SRAM Computing-in-Memory Macro With Logarithm Bit-Width Residual ADC for Edge AI}, 
  year={2026},
  volume={61},
  number={8},
  pages={4450-4462},
  abstract={With increasingly sophisticated artificial intelligence (AI) applications, there is an escalating need for computing-in-memory (CIM) schemes to facilitate high-precision floating-point (FP) multiply accumulate (MAC) computing, while existing digital or analog CIM implementations exhibit inherent limitations when confronted with high-bit precision situations. Therefore, this work presents a hybrid-domain CIM macro to enhance the energy efficiency of FP CIM computation. This work employs: 1) a hybrid-domain CIM macro structure that fully utilizes the advantages of digital and analog CIM paradigms; 2) a logarithm bit-width zero-canceling residual analog-digital convertor (ADC) to minimize the ADC overhead and improve throughput; and 3) an outer product-based FP/INT CIM architecture to eliminate the need for a large fan-in multi-level adder tree and reduce the transmission delay. A fabricated 28-nm 192-Kb INT/FP CIM macro achieves maximum peak energy efficiency of 72.12 TFLOPS/W and maximum area efficiency of 2.21 TFLOPS/mm2. The accuracy loss of running ResNet-18 on the CIFAR-100 dataset with BF16IN-BF16W-BF16OUT is 0.05%.},
  keywords={In-memory computing;Circuits;Adders;Throughput;Artificial intelligence;Logic gates;Energy efficiency;Common Information Model (computing);Trees (botanical);Computer architecture;Artificial intelligence (AI);computing-in-memory (CIM);floating-point (FP);hybrid-domain;SRAM},
  doi={10.1109/JSSC.2026.3668132},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11398769,
  author={Zhang, Zuo and Yang, Xuecheng and Ye, Shen and Wang, Jiahao and Shi, Yu and Qu, Tianxiang and Hong, Zhiliang and Xu, Jiawei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={An Energy-Efficient and High-Accuracy Dual-Mode ECG AI Processor via Deep-Fold and Zero-Free Fine-Grained Quantization}, 
  year={2026},
  volume={61},
  number={8},
  pages={4463-4474},
  abstract={Smart wearable electrocardiography (ECG) devices require classification processors that combine high accuracy, low power dissipation, and real-time operation under stringent energy constraints. Conventional neural network approaches improve accuracy but are limited by high computational and memory costs, restricting on-chip deployment. This work presents an energy-efficient ECG AI processor enabled by algorithm-hardware co-design. Key contributions include: 1) a unified lightweight convolutional neural network (CNN) with a shared convolutional backbone and dual task-specific heads for binary and five-class classification; 2) a hardware-oriented deep-fold technique using weight symmetry to reduce parameters and multiplications by 39.1% and 40.1%, respectively; and 3) a zero-free fine-grained (ZFFG) quantization scheme that preserves accuracy at low bit-widths while enabling multiplier-less inference. Fabricated in 65-nm CMOS, the processor achieves 98.70% (binary) and 98.72% (five-class) classification accuracy with an ultra-compact 2.37 KB on-chip SRAM and only  $0.09~{\mu }$ J per inference, representing a state-of-the-art, energy-efficient solution for real-time wearable ECG monitoring.},
  keywords={Electrocardiography;Accuracy;Artificial intelligence;System-on-chip;Magnetic heads;Hardware;Convolutional neural networks;Quantization (signal);Heart beat;Feature extraction;Convolutional neural network (CNN);deep-fold technique;electrocardiography (ECG) AI processor;fine-grained quantization;lightweight network;low-power},
  doi={10.1109/JSSC.2026.3661990},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11434978,
  author={Zhang, Qirui and Fan, Zichen and Abillama, Pierre and Shoouri, Sara and Lee, Jungho and Tseng, Chien-Wei and Lee, Changwoo and Meng, Wei and Kim, Hun-Seok and Blaauw, David and Sylvester, Dennis},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={MITTA: A Multi-Task Transformer Accelerator With Mixed Precision Structured Sparsity and Hierarchical Task-Adaptive Power Management}, 
  year={2026},
  volume={61},
  number={8},
  pages={4475-4488},
  abstract={This article presents MITTA, the first silicon-proven transformer accelerator optimized for multi-task inference across both natural language processing (NLP) and image processing domains. MITTA accelerates a task-sharing algorithm that minimizes sub-task computation by reusing both activations and weights from a shared base task, requiring only sparse delta computation for sub-tasks. To enhance efficiency, MITTA adopts block-wise structured sparsity (BSS) and INT8/INT4 mixed precision arithmetic, alongside a custom INT32 Softmax unit that avoids floating-point (FP) overhead while maintaining numerical accuracy and reducing power by 28%. To further optimize energy, MITTA implements a novel two-stage, task-adaptive dynamic voltage and frequency scaling (DVFS) scheme using a hierarchical power management architecture—combining off-chip DC–DC converters with on-chip power multiplexers (MUXes)—to dynamically select energy-optimal voltage–frequency operating points. Fabricated in 22-nm CMOS with a compact 5.8-mm2 area, MITTA achieves 4.46TOPS/W (INT8) in its dense engine (DE) and up to 12.52TOPS/W (INT8) and 25.08TOPS/W (INT4) in its sparse engine (SE) at 0.55 V. Combined, task-sharing, DVFS, and INT4 arithmetic enable up to 77.8% energy savings and 90.1% latency reduction for sub-tasks such as human parsing (HP). Finally, quantitative results demonstrate that the proposed DVFS scheme significantly outperforms alternatives based on low-dropout regulators (LDOs), even when accounting for realistic DC–DC converter efficiency.},
  keywords={Transformers;Sparse matrices;Multitasking;Energy efficiency;Accuracy;Computer architecture;Engines;System-on-chip;Power system management;Encoding;Adaptive design;hardware accelerator;multi-task;sparsity;transformer neural network},
  doi={10.1109/JSSC.2026.3669815},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11456066,
  author={Hu, Xiaofeng and Mun, HanGyeol and He, Yifan and Meng, Jian and Liao, Yuan and Seo, Jae-sun},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={OS-CIM: A 28-nm Output-Stationary SRAM Compute-in-Memory Macro Featuring Dynamic Look-Ahead Zero Weight Skipping and Runtime Partial Sum Quantization}, 
  year={2026},
  volume={61},
  number={8},
  pages={4489-4502},
  abstract={Static random access memory (SRAM)-based compute-in-memory (CIM) designs have shown impressive energy efficiency for vector–matrix multiplications of artificial intelligence (AI) workloads. Conventional SRAM CIM macros naturally adopt the weight-stationary (WS) dataflow. While the WS-CIM maximizes the on-chip weight reuse, the expensive global partial sum (Psum) read/write operations largely degrade the WS-CIM system energy efficiency. In addition, the activation sharing and static weight mapping in WS-CIM make zero-weight skipping infeasible. To address these challenges, this work introduces OS-CIM, an output stationary SRAM-based CIM macro and system. The OS-CIM features an OS-CIM structure with a custom single-cycle read-and-write 8T SRAM cell to store the Psum in the CIM macro and perform the accumulation locally, eliminating the expensive Psum access to SRAM buffers, a dynamic look-ahead weight skipping (DLS) scheme, well aligned with OS dataflow, which achieves high latency reduction across various weight sparsity patterns and significantly improves workload imbalance, and a runtime Psum quantization (RPQ) method to mitigate the hardware cost of high-precision accumulation. The fabricated 28-nm OS-CIM macro shows 20.9–137.2 TOPS/W peak energy efficiency at 0.45 V across dense to 2:16 weight sparsity and INT8 precision for inference of ViT-Base model. Compared to state-of-the-art DCIM works, OS-CIM achieves  $1.29\times $  improvement on macro-level energy efficiency,  $1.39\times $  on system-level energy efficiency.},
  keywords={In-memory computing;Energy efficiency;Artificial intelligence;SRAM cells;Computer architecture;Quantization (signal);Adders;Runtime;Logic;Indexes;Artificial intelligence (AI);compute-in-memory (CIM);output stationary;partial sum (Psum) quantization;weight skipping},
  doi={10.1109/JSSC.2026.3675444},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11458049,
  author={Jain, Vikram and Grubb, Daniel and Zhao, Jerry and Anderson, Kevin and Ho, Ken and Nikiforov, Dima and Dong, Shengjun Kris and Chi, Yufeng and Schwarz, Ella and Asanović, Krste and Shao, Yakun Sophia and Nikolić, Borivoje},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Cygnus: A Heterogeneous Octa-Core RISC-V Vector Processor for Digital Signal Processing Applications}, 
  year={2026},
  volume={61},
  number={8},
  pages={4503-4517},
  abstract={We introduce Cygnus, an energy-efficient octa-core RISC-V vector processor, compliant with the RISC-V vector extension (RVV) 1.0 specification, specifically designed for digital signal processing (DSP) and robotics applications. This system-on-chip (SoC) features dynamic instruction scheduling with short-vector lengths at the vector core level and employs a big/little architecture with tightly coupled memory (TCM) at the SoC level. The TCM design enables efficient data streaming across the cores, bypassing the cache hierarchy for streaming applications. Cygnus achieves a high average utilization of 90% across general matrix multiply (GEMM) and convolution (CONV) kernels, demonstrating energy efficiencies of 414 GOPS/W for INT8 GEMM and 109 GFLOPS/W for FP32 GEMM. In a typical computer vision kernel that implements denoising using a non-local means (NLMs) algorithm, the SoC provides a latency of 3.7 ms with an energy consumption of  $518~\mu $ J per frame. Moreover, we demonstrate the adaptability of our approach using our SoC in a drone control application that employs a model-predictive control (MPC) algorithm based on TinyMPC. Cygnus, running the Zephyr real-time operating system (RTOS), manages control for three drones while optimizing performance through vectorization, achieving over  $3.5\times $  improvement in solve time and significant reductions in position-tracking error at higher clock frequencies. The implementation demonstrates enhanced the real-time performance and accuracy compared with baseline scalar methods.},
  keywords={Aerospace control;System-on-chip;Vector processors;Very large scale integration;Circuits;Integrated circuits;Microprocessors;Application specific integrated circuits;Coprocessors;Filtering;Chiplets;digital signal processors;long vector;RISC-V vector extension (RVV);short vector;streaming dataflow},
  doi={10.1109/JSSC.2026.3676416},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11389134,
  author={Lu, Sijia and Zhu, Wenping and Yang, Bohan and Yang, Jiajun and Dai, Tongwei and Chen, Chen and Han, Xiangdong and Yang, Jinjiang and Wang, Hanning and Zhu, Min and Wei, Shaojun and Zhang, Aoyang and Liu, Leibo},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={HUTAO: A Reconfigurable Homomorphic Processing UniT With Cache-Aware Operation Scheduling}, 
  year={2026},
  volume={61},
  number={8},
  pages={4518-4532},
  abstract={Fully homomorphic encryption (FHE) enables privacy-preserving machine learning (PPML) at the cost of intensive computational overhead, which necessitates the use of domain-specific accelerators. To achieve comprehensive support for leveled FHE, this article presents a reconfigurable multi-scheme FHE processor that supports both client-side encryption/decryption and server-side evaluation. First, a reconfigurable processing element (RPE) design for modular arithmetic and a reusable data generator for polynomial sampling are developed to support the various operations in FHE. Second, a configurable RPE array supporting polynomial operations and a decoupled automorphism unit (DAU) necessary for homomorphic rotations are proposed to accelerate the FHE primitives with complex dataflow. Finally, an on-chip data generation strategy and a cache-aware operation scheduling (CAOS) method are introduced to alleviate the memory bottleneck in the end-to-end execution of FHE applications. The chip is fabricated in a 28-nm process and tested with end-to-end execution. Targeting a lightweight parameter set with polynomial degree $N=4096$  at 128-bit security level, the proposed chip achieves  $4.05~\mu $ J per encryption on the client side and provides a throughput of 8.72 kHMul/s on the server side. In terms of the number theory transform (NTT) operation, the chip demonstrates the highest throughput and best area efficiency compared with state-of-the-art solutions.},
  keywords={Polynomials;Memory management;Arithmetic;System-on-chip;Transforms;Homomorphic encryption;Optimization;Noise;Machine learning;Indexes;Domain-specific accelerator;fully homomorphic encryption (FHE);number theory transform (NTT);reconfigurable processing unit},
  doi={10.1109/JSSC.2026.3657525},
  ISSN={1558-173X},
  month={Aug},}

