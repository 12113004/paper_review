@ARTICLE{11363402,
  author={Eleraky, Mohamed and Huang, Tzu-Yuan and Wang, Hua},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Compact, Wideband Complex Cascode Power Amplifier With LC Neutralization for VSWR-Resilient Operation in High-Density Phased Arrays}, 
  year={2026},
  volume={61},
  number={8},
  pages={3940-3955},
  abstract={This article proposes a design methodology for achieving intrinsic performance resilience in power amplifiers (PAs) against antenna impedance variations inherent to modern phased-array systems through the improvement of the PA output matching ( $S\!_{22}$ ). This goal, however, presents a challenge for conventional cascode PAs due to their inherently high output impedance and often entails a direct tradeoff with PA output power and efficiency. To address this, a complex L-C neutralized cascode topology is developed to align the conjugate-match condition with the optimal load-pull impedance, thereby enabling a low output reflection coefficient without compromising the PA’s large-signal performance. In addition, the PA’s linearity is enhanced using a technique analogous to that of a multi-gate transistor (MGTR); in particular, the bias control is applied via the back gate of the SOI devices, leaving the primary RF signal path unperturbed. Fabricated in the Globalfoundries 22FDX+ technology, the PA delivers a linear power of 15.4 dBm with a peak power-added efficiency (PAE) of 34% into a 50- $\Omega $  load. When subjected to voltage standing wave ratio (VSWR) circles up to 4:1, across the 37–43-GHz frequency range and using a single bias setting, the power gain deviation remained below 1.5 dB relative to the 50- $\Omega $  case, while the degradation in  $\text {OP}_{\mathrm {1\text {dB}}}$  was limited to less than 3 dB. The corresponding drop in PAE ${}_{\text {OP1 {dB}}}$  was held to less than 11%. The PA’s performance was also assessed using a 64-QAM modulated signal. Across the 39–43-GHz band, even under 4:1 VSWR conditions, the measured error vector magnitude ( $\text {EVM}_{\mathrm {rms}}$ ) remained below −24.5 dB. Concurrently, the average output power ( $P_{\text {avg}}$ ) and average PAE (PAEavg) consistently exceeded 6.8 dBm and 9%, respectively.},
  keywords={Phased arrays;Impedance;Wideband;Power amplifiers;Linearity;Complexity theory;Power generation;Calibration;Sensors;Reflector antennas;Amplitude-to-phase (AM–PM);back-gate biasing;complex-LC neutralization;coupled-line (CL) baluns;load-insensitive power amplifiers (PAs);multi-gate transistor (MGTR);output matching ( $S\!_{22}$  );voltage standing wave ratio (VSWR);wide-band matching},
  doi={10.1109/JSSC.2026.3654669},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11418917,
  author={Zeng, Weisen and Gao, Li and Hu, Zi-Kang and Xu, Hongtao and Zhang, Xiu Yin},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Dual-Band Reconfigurable Filtering Power Amplifier for 5G mmWave Applications}, 
  year={2026},
  volume={61},
  number={8},
  pages={3956-3968},
  abstract={This article presents a frequency reconfigurable power amplifier (PA) for fifth-generation (5G) millimeter-wave dual-side local oscillator (LO) injection systems, which effectively reduces the LO design complexity. A tricoil transformer is proposed to design a high  $Q$  broadband output matching network (OMN), thus enhancing power-efficiency at high-frequency band. Besides, two distinct reconfigurable resonator topologies are proposed for the design of both the input and interstage matching networks. These resonators effectively realize filtering functionality by utilizing the switch-off capacitance in conjunction with inductive resonance, while maintaining low-circuit losses. Importantly, this design methodology inherently embeds filtering capabilities within the matching network without introducing additional area overhead. The proposed PA is implemented in 28-nm bulk CMOS and realizes 18.4–20.2 dBm  $P_{\text {sat}}$ , 13.7–19 dBm OP1dB and 24.5%–34.7% PAE over n257–n261 bands. The PA exhibits maximum image/LO rejection (LOR) of 38.5/28.5 dBc. For 5G new radio (NR) frequency range 2 (FR2) 200 MHz 64-QAM signals (9.7 dB PAPR), the PA achieves average  $P_{\text {out}}$  /PAE of >7.3 dBm and >5.2% with −25 dB EVMrms over n257–n261. The PA occupies a core area of only 0.109 mm2, making it suitable for cost-effective, high-yield 5G user equipment (UE) and large-scale phased-array applications.},
  keywords={Millimeter wave communication;Filtering;5G mobile communication;Transformers;Switches;Broadband amplifiers;Dual band;Topology;Power amplifiers;Impedance matching;CMOS;frequency reconfigurable;image rejection (IR);millimeter-wave;power amplifier (PA)},
  doi={10.1109/JSSC.2026.3666873},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11415422,
  author={Pang, Bo and You, Fei and Pang, Taotao and Qin, Rongxing and Xiao, Zehua and Liu, Yingjie and Liu, Yingyu and Wang, Xinyu and Guo, Junfu and He, Songbai},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 2--18 GHz High-Efficiency CMOS Nonuniform Distributed Power Amplifier With a Novel Reconfigurable Inductive Termination}, 
  year={2026},
  volume={61},
  number={8},
  pages={3969-3980},
  abstract={This article presents a 2–18 GHz high-efficiency CMOS nonuniform distributed power amplifier (NDPA) with a novel reconfigurable inductive termination technique for ultra-broadband efficiency enhancement. First, the inherent drawback of the degrading efficiency with growing frequency in a conventional non-reconfigurable NDPA architecture with multi-octave bandwidth is studied. A simple and effective reconfigurable inductive termination structure is thus proposed to solve this problem. Specifically, switching between low-pass and bandpass characteristic in the same NDPA is realized by the proposed technique, and a frequency reconfiguration is therefore formed to improve the overall in-band gain and efficiency. A prototype based on a triple-stacked four-stage NDPA architecture plus the proposed reconfigurable structure is designed and fabricated in 65-nm bulk CMOS process with a total area of  $0.86~{\text {mm}^{{2}}}$ . The measurement shows that a peak gain of 22.8 dB, an 18.9–21.5 dBm saturated output power and an 18.9%–34.5% maximum power added efficiency (PAE) are achieved with two reconfigurable modes within 1.9–18 GHz. Also, it is able to deliver 64-QAM modulated signal of 7.1 dB peak-to-average power ratio (PAPR) with 10.95/9.70 dBm average output power, 4.7%/3.5% average PAE and −25.4/-23.6 dB error vector magnitude (EVM) at 4/12 GHz. To the best of the authors’ knowledge, it has achieved the best power efficiency performance with a high gain and a low chip area among published Si-based DA works with multi-octave bandwidth.},
  keywords={Bandwidth;Power amplifiers;Power generation;Impedance;Computer architecture;Capacitance;Transistors;Impedance matching;Resistors;Mathematical models;CMOS;high-efficiency;nonuniform distributed power amplifier (NDPA);reconfigurable;termination;ultra-broadband},
  doi={10.1109/JSSC.2026.3665920},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11433589,
  author={Li, Kai and Wang, Keping and Meng, Fanyi and Yeo, Kiat Seng and Ma, Kaixue},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Design and Analysis of a 13.7--41 GHz Ultra-Wideband Frequency Doubler With Cross-Coupled Push-Push Structure}, 
  year={2026},
  volume={61},
  number={8},
  pages={3981-3995},
  abstract={This article presents a 13.7–41 GHz ultra-wideband frequency doubler with high efficiency and conversion gain (CG). The proposed cross-coupled push-push structure, in conjunction with the fourth-order transformer-based resonator and the series gate inductor, collaboratively shapes the input signal amplitude such that three distinct peaks emerge at different frequencies, thereby significantly improving the bandwidth. By introducing the resistor  $R_{C}$  and inductor  $L_{S}$  into the proposed cross-coupled structure, the in-band flatness can be finely tuned with minimal impact on the frequency of the third peak, thereby offering an additional degree of freedom for flatness optimization. To improve the second harmonic output power and efficiency, a st acked common-gate amplifier is introduced. Furthermore, a coupled-inductor-based output matching network is designed to further extend the bandwidth to low frequencies. Fabricated in a 40 nm CMOS process, the proposed frequency doubler achieves a 3-dB bandwidth of 27.3 GHz (fractional bandwidth of 99.8%), a 1.5-dB bandwidth of 24.5 GHz (fractional bandwidth of 91.6%), and a peak CG of −2.7 dB at an input power of 3 dBm. The measured saturated output power is 7 dBm, with a peak drain efficiency of 14.1% and a peak total efficiency of 10.6%. Across the entire bandwidth, the fundamental harmonic rejection ratio (HRR) and the third HRR are greater than 21.3 and 35.6 dBc, respectively.},
  keywords={Resonant frequency;Transformers;Logic gates;Power generation;Wideband;Inductors;Harmonic analysis;Broadband communication;Ultra wideband technology;Power amplifiers;Conversion gain (CG);cross-coupled push-push;efficiency;frequency doubler;output power;push-push;wideband},
  doi={10.1109/JSSC.2026.3667289},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11429668,
  author={Yu, Hao and Fu, Zhaojing and Liu, Lianbo and Zhou, Qiang and Chi, Taiyun and Li, Sensen},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Adaptive Linearity Enhancement of Low-Noise Amplifiers Using Doherty Active Load Modulation}, 
  year={2026},
  volume={61},
  number={8},
  pages={3996-4009},
  abstract={This article introduces Doherty active load modulation into low-noise amplifier (LNA) designs to dynamically enhance linearity. Under nominal small-signal conditions, the proposed LNA operates like conventional counterparts, consuming no additional power. When strong in-band blockers are present, auxiliary paths are adaptively engaged to activate a high-linearity mode without incurring a noise penalty. The proposed design effectively overcomes the conventional tradeoff between linearity and other key LNA performance metrics. Building on the main concept, two additional techniques were employed to further enhance linearity: dedicated gain expansion and multi-way Doherty architecture. These techniques led to the development of the two implemented prototypes presented in this article. Both designs achieve over 10-dB improvement in input 1-dB compression point (IP ${}_{1\mathrm {dB}}$ ) while maintaining a minimum noise figure (NF) of 2.5 dB. Modulation testing was conducted in the presence of in-band blockers, demonstrating successful demodulation of a 400-MHz 64-QAM desired signal with less than 5% EVM, even under 20 dBc in-band 100-MHz 16-QAM blockers.},
  keywords={Linearity;Gain;Low-noise amplifiers;Silicon-on-insulator;Power demand;Performance metrics;Noise figure;Mixers;Impedance;Couplers;Active load modulation;blocker tolerance;CMOS;linearity enhancement;low-noise amplifier (LNA);millimeter-wave circuits;noise figure (NF);silicon on insulator (SOI)},
  doi={10.1109/JSSC.2026.3667125},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11371716,
  author={Huang, Shijin and Qin, Pei and Yi, Xiang and Zhu, Haoshen and Wu, Liang and Xue, Quan},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 4.21-to-15.18 GHz Magnetically Reconfigurable and Fully Symmetrical Quad-Core Quad-Mode VCO}, 
  year={2026},
  volume={61},
  number={8},
  pages={4010-4024},
  abstract={This work proposes a wideband low phase noise (PN) quad-core quad-mode voltage-controlled oscillator (VCO) which features magnetically reconfigurable (MR) technique and fully symmetrical architecture. The MR technique, realized through a transformer-based tank integrating an embedded switched inductor, leverages varying core excitation currents to achieve four distinct equivalent inductances, thereby enabling quad-mode operation. This approach avoids the frequency tuning range (FTR) compromise encountered when using capacitive tuning elements in multi-mode tanks. Furthermore, the fully symmetrical characteristics of the inductive, capacitive, and active elements, along with the routing layout, minimize mismatches among the VCO cores, ensuring effective synchronization of the four single-core VCOs and optimizing the PN in quad-core operation. The proposed quad-core quad-mode VCO achieves an FTR of 113.2% (4.21 to 15.18 GHz), a PN of −141.4 dBc/Hz at a 10 MHz offset from 4.28 GHz, a peak figure-of-merit (FoM) of 190.5 dBc/Hz, a peak  $\text {FoM}_{T}$  of 211.6 dBc/Hz and a peak FoMTA of 220.5 dBc/Hz at a 10 MHz offset.},
  keywords={Voltage-controlled oscillators;Inductors;Inductance;Multicore processing;Magnetic cores;Couplings;Switches;Tuning;Transformers;Phase noise;Magnetically reconfigurable (MR);phase noise (PN);quad-core;quad-mode;voltage-controlled oscillator (VCO);wide frequency tuning range (FTR)},
