  volume={61},
  number={8},
  pages={4193-4205},
  abstract={Millions of quantum-bits (qubits) are envisioned for a fault-tolerant quantum computer. For scalability, silicon spin qubit stands out due to its compatibility with advanced CMOS processes. Silicon single-electron transistors (SETs) are widely adopted for the quantum state discrimination of spin qubits. For high-fidelity quantum logic gate and readout, the gate electrodes of the above Si quantum devices require a biasing voltage with ~10- $\mu $ V precision to define the electron occupation, and ultra-low noise to suppress the charge noise induced decoherence. In addition, the co-integration of a large-scale spin qubit array and cryogenic CMOS (Cryo-CMOS) electronics on a <100-mK stage of dilution refrigerator requires ultra-low power (LP). This article presents a 65-nm Cryo-CMOS manipulator integrated with a SET at 60 mK, consuming a DC power of  $60~\mu $ W only. It adopts a pair of 18-bit R-2R DACs for the gate control. Each DAC has 63 bits of MSB thermal code, 3 bits of MID thermal code, 10 bits of binary code, and 3 bits of fine-tuning code. However, at cryogenic temperature, the P+ polysilicon resistors of the DAC suffer from  $43\times $  stronger nonlinearity and  $2\times \sim 3\times $  worse device mismatch of the resistance value, limiting integral nonlinearity (INL) and differential nonlinearity (DNL). Accordingly, resistor nonlinearity calibration (RNC) is proposed to compensate for the voltage dependency of resistance using a pair of tailed pMOS and nMOS transistors. Ordered element matching (OEM) is also adopted to mitigate random mismatch. Measured at 4 K, this chip achieves a state-of-the-art 18-bit resolution with 4.6- $\mu $ V precision, an INL of ±0.8 LSB, and a DNL of ±0.8 LSB. It also exhibits an integrated noise of  $3.8~\mu $ V and a noise spectrum density of 4.1 nV/Hz0.5 at 60 mK. Finally, while the two DACs of this chip control the gate and source of the SET, respectively, a clear Coulomb diamond of the SET is measured at 60 mK.},
  keywords={Silicon;Noise;Logic gates;Electrons;Cryogenics;Spin qubits;Manipulators;Calibration;Resistors;Electric potential;Calibration;cryogenic CMOS (Cryo-CMOS);quantum computing;R-2R DAC;single-electron transistor (SET)},
  doi={10.1109/JSSC.2026.3671795},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11456381,
  author={Han, Yiming and Zhao, Linran and Jia, Yaoyao},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Noise-Shaping SAR-Based ExG Sensing Frontend With Dynamic Input-Impedance Boosting and Prediction-Assisted Mismatch-Shaping DEM}, 
  year={2026},
