  volume={61},
  number={8},
  pages={4346-4358},
  abstract={As aging effects become more pronounced in scaled technologies, designing aging-tolerant circuits with minimal guardband overhead is increasingly critical. This requires accurate propagation of transistor-level degradation to the circuit level. In multi-input standard cells, each internal timing path can exhibit varying susceptibility to aging, a challenge compounded by the inherently stochastic nature of degradation mechanisms, making accurate prediction even more difficult. While aging simulation based on device-level aging models is crucial in predicting long-term performance degradation, circuit-level characterization remains essential to capture real-world degradation effects and enable effective, data-driven guardbanding strategies. However, existing test structures fall short: they aggregate degradation across multiple cells and typically support only a single, fixed timing path per cell, limiting visibility into input- and path-specific aging. To overcome these limitations, we present a novel test structure capable of measuring delay degradation across all input combinations of individual standard cells. An array of these structures has been implemented in one chip, along with an integrated high-resolution measurement system. Experimental results demonstrate the proposed test structure’s ability to expose input- and topology-dependent aging behaviors, highlighting their stochastic nature and offering new insights for aging-aware digital circuit design.},
  keywords={Degradation;Aging;Stress;Standards;Frequency measurement;Transistors;Delays;Semiconductor device measurement;Logic gates;Periodic structures;Aging;bias temperature instability (BTI);circuit reliability;guardband;hot carrier degradation (HCD);reliability test structure;stochasticity},
  doi={10.1109/JSSC.2026.3669600},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11373333,
  author={Diaz-Fortuny, Javier and Bury, Erik and Degraeve, Robin and Kaczer, Ben},
  journal={IEEE Journal of Solid-State Circuits}, 
