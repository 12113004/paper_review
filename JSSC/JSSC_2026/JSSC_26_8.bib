@ARTICLE{11413923,
  author={Tang, Dawei and Xia, Xiaoyue and Huang, Leyang and Li, Zekun and Yang, Chun and Yan, Zheng and Tang, Si-Yuan and Zhou, Peigen and Zhang, Rui and Lu, Liqun and Zhu, Wentao and Chen, Zhe and Chen, Jixin and Gao, Hao and Hong, Wei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Sub-Terahertz Wideband ASK Transceiver for 14/27/64 Gb/s 0.27-km/0.12-m/0.1-mm Interconnection in 28-nm CMOS}, 
  year={2026},
  volume={61},
  number={8},
  pages={3832-3848},
  abstract={This article presents a 28-nm CMOS sub-terahertz (sub-THz) amplitude shift-keying (ASK) transceiver achieving competitive wireless and wireline communication performance. The over-the-air (OTA) link demonstrates 14 Gb/s/0.27 km, 16 Gb/s/1 m, and 27 Gb/s/12 cm without equalization (EQ), while supporting 64 Gb/s on-Off keying (OOK) and 40 Gb/s pulse amplitude modulation (PAM)4 in wireline mode. In the transmitter (TX), a power-boosting technique is proposed for the oscillator to maximize output power and DC-to-RF efficiency with a compact area. An ASK modulator incorporating analog-pre-distortion (APD) compensation is proposed to support high-efficiency and high-speed modulation. A compact 90–180 GHz power amplifier (PA) is utilized to deliver 15–18 dBm output power, with an integrated broadside balanced balun for differential signal interfacing. In the receiver (RX), a 110–160 GHz low-noise amplifier (LNA) with a switchable differential and single-ended interface is proposed, and a 90–180 GHz wideband envelope detector (ED) with DC-35 GHz baseband amplifier (BBA) is designed for high-speed demodulation. A novel metamaterial-loaded modified Vivaldi antenna and a wideband ground-signal-ground (GSG) pads to waveguide transition (WGT) are proposed for wireless link. The transceiver establishes new benchmarks for silicon-based sub-THz ASK systems, demonstrating the longest reported communication distance with competitive data rates, showcasing extensive communication applications.},
  keywords={Oscillators;Power generation;Amplitude shift keying;Transistors;Costs;Wideband;Transceivers;Admittance;Optical fiber communication;Voltage;Amplitude shift-keying (ASK);analog-predistortion (APD);CMOS;sub-terahertz (Sub-THz);transceiver},
  doi={10.1109/JSSC.2026.3665552},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11418900,
  author={Li, Nayu and Xiong, Ziyao and Yang, Botao and Lu, Hang and Liu, Yiwei and Qi, Xiaokang and Chen, Gaopeng and Yan, Na and Song, Chunyi and Xu, Zhiwei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={AK/Ka-Band Transmit/Receive Front-End With Triple-Coupled Transformer Technique in 65-nm Bulk CMOS}, 
  year={2026},
  volume={61},
  number={8},
  pages={3849-3860},
  abstract={This article presents a K/Ka-band transmit/receive (T/R) front-end for jointed sensing and communication (JSAC) applications. A reconfigurable matching network for both signal reception and transmission is realized using the proposed triple-coupled transformer (TCT) technique, achieving low power loss and a compact footprint. The T/R switch at the center tap of the low-noise amplifier (LNA) coil enhances the T/R isolation by cutting off the coupled leakage power from the power amplifier (PA) coil. The chip was fabricated in 65-nm bulk CMOS and occupies a 1.18-mm2 core area. In the RX mode, it achieves a power gain of 24.7–27.6 dB and an NF less than 5 dB at 17.7–29.5 GHz. In the TX mode, it achieves a maximum saturated output power ( $P_{\text {sat}}$ ) of 20.5 dBm with a power added efficiency (PAE) of 21.8% and an output-referred 1-dB gain compression point ( $\text {OP}_{\text {1dB}}$ ) of 20.2 dBm with a PAE of 20.6% at 24 GHz. The measured  $\text {OP}_{\text {1dB}}$  is larger than 16.7 dBm over the 20–31-GHz frequency range. The chip demonstrates low noise figure (NF) and high output power among K/Ka-band silicon-based T/R front-ends.},
  keywords={Coils;Switches;Transformers;Power generation;Impedance;Sensors;Power amplifiers;Insertion loss;Topology;Couplings;K/Ka band;transceiver;transmit/receive (T/R) front-end;triple-coupled transformer (TCT) technique;wideband},
  doi={10.1109/JSSC.2026.3667736},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11427319,
  author={Bai, Haoyu and Hao, Ling and Zhou, Jiazheng and Huang, Han and Wang, Dong and He, Jiaqi and Wang, Yifei and Wang, Yipeng and Liu, Junhua and Liao, Huailin},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 10--72 GHz SDR Receiver With Compact and Low-Phase-Noise LO Frequency Quintupler}, 
  year={2026},
  volume={61},
  number={8},
  pages={3861-3874},
  abstract={This article presents a wideband receiver (RX) operating in 10–72 GHz with multiprotocol coverage, which integrates the inductor-less local oscillator (LO) frequency quintupler for down-mixing. In the LO generator, phase interpolators (PIs) are implemented to obtain five-phase pulses. Then compact edge-combining switched-capacitor (SC) based frequency quintuple techniques are proposed to output LOs ranging from 10 to 40 GHz while operating within the 2–8 GHz frequency range. The lower input frequency brings lower driving difficulty, higher I/Q precision, and better phase noise performance. Therefore, based on the LOs orthogonality accuracy and IQ calibration, the baseband phase shifter (PS) with lower power and die area consumptions is applied in the receiver. For the 40–72 GHz channel, the RF signals are down-mixed two times with the same LO frequency to reduce the quintupled LO frequency to fRF/2. By folding the image band to DC during the first down-mixing, an image rejection ratio (IRR) exceeding 100 dB is achieved through the input-matching transformer of LNA, thus eliminating image interference and flicker noise introduction. Fabricated in 40-nm CMOS technology, the proposed RX features a core area of 0.9 mm2, a conversion gain of over 45 dB, an output IP3 of over 19.7 dBm, and the noise figures (NFs) lower than 6.1, 6.9, and 8.7 dB in the 10–18 GHz, 18–40 GHz, and 40–72 GHz bands, respectively.},
  keywords={Receivers;Radio frequency;Inverters;Circuits;Calibration;Bandwidth;Phase noise;Wideband;Accuracy;Generators;Baseband phase shifter (PS);broadband receiver;CMOS;compactness;DC image;local oscillator (LO) quintupler;millimeter-wave;phase noise;phased-array;switched-capacitor (SC)},
  doi={10.1109/JSSC.2026.3669994},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11389191,
  author={Maktoomi, Md Hedayatullah and Liu, Xuyang and Aghasi, Hamidreza},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 19-dBm 110--142-GHz CMOS Power Amplifier With Device-Centric Power Boosting and Dual-Coupled Slotline Combiner}, 
  year={2026},
  volume={61},
  number={8},
  pages={3875-3891},
  abstract={In this article, a broadband power amplifier (PA) with an enhanced output power is proposed for the D-band frequency range. By deploying a new device-centric power model for cascode PA stages, it is first shown how an enhanced output power can be achieved by precisely choosing the device sizes in a cascode PA. Leveraging this finding, a novel three-transistor configuration is introduced where the additional transistor not only reuses the excess current due to the device size mismatch, but also helps increase the power gain. To further enhance the output power across a large bandwidth, a 4-way slotline-based dual-coupled differential power combiner (DCDPC) is proposed. An even-odd mode analysis is presented to evaluate the impedance matching performance of the DCDPC combiner. By combining the proposed PA stage and the broadband combiner, a three-stage PA is designed and fabricated in a 65-nm bulk CMOS process. The measured data show that a peak saturated output power of 19 dBm, a peak gain of 15.3 dB, and a power added efficiency (PAE) of 5.3% is achieved. The PA is examined under various orders of amplitude modulations, where error vector magnitudes (EVMs) of  ${\leq } {-}21$  dB have been consistently achieved. The fabricated chip occupies a core area of  $0.99\times 0.48$  mm2.},
  keywords={Power generation;Transistors;Power amplifiers;Bandwidth;Gain;Load modeling;Power combiners;Impedance;Transconductance;Semiconductor device modeling;Cascode;CMOS;D-band;mm-wave;nonlinear transconductance;power amplifier (PA);power combiner (PC);slotline},
  doi={10.1109/JSSC.2026.3659771},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11364536,
  author={Wang, Chun and Herdian, Hans and Zheng, Wenbin and Angel Yong, Olivia and Liu, Chenxin and Mayeda, Jill and Liu, Yuxuan and Wang, Wenqian and Zhang, Yuncheng and da Gomez, Carrel and Shehata, Abanob and Kato, Sena and Abdo, Ibrahim and Jyo, Teruo and Hamada, Hiroshi and Takahashi, Hiroyuki and Sakai, Hiroyuki and Shirane, Atsushi and Okada, Kenichi},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 300-GHz-Band 16.2-dBm EIRP Four-Element Amplifier-Last Phased-Array Transmitter With On-Chip Vivaldi Antenna in 65-nm CMOS}, 
  year={2026},
  volume={61},
  number={8},
  pages={3892-3909},
  abstract={This article describes a 300-GHz-band four-element amplifier-last phased-array transmitter (TX) that has been implemented in a 65-nm CMOS technology. Each chip integrates four TX elements with a power amplifier (PA)-last architecture. The proposed wideband PA employs an optimized transistor layout to reduce parasitic parameters, enhancing the transistor-gain corner frequency from 250 to 300 GHz for an  $8~\mu $ m   $\times 60$  nm device. A dual-peak  $G_{\max }$ -core topology is adopted to achieve wideband inter-stage conjugate impedance matching. Operating from 237 to 267 GHz, the PA provides over 20 dB of gain while eliminating the need for power combining, thereby improving both TX output power and area efficiency. The TX also integrates an on-chip Vivaldi antenna with a measured realized gain of  $5.0~\pm ~1.0$  dBi across 220–280 GHz after proton irradiation. The four-element phased-array TX achieves a maximum data rate of 60 Gb/s using 16 quadrature modulation (QAM) over 6 cm and 56 Gb/s using quadrature phase shift keying (QPSK) over 20 cm, with a peak effective isotropic radiated power of 16.2 dBm at 245 GHz. A 2-D  $4\times 4$  beam pattern was measured using a stacked printed circuit board (PCB) configuration, demonstrating scanning coverages of ±24° in the  $E$ -plane and ±28° in the  $H$ -plane.},
  keywords={Power amplifiers;Vivaldi antennas;System-on-chip;Power generation;Phased arrays;Radio frequency;Wideband;Transistors;Layout;Mixers;2-D;300-GHz-band;amplifier-last;CMOS;on-chip Vivaldi antenna;parasitic parameters;phased-array;power amplifier (PA);transistor layout;transmitter (TX)},
  doi={10.1109/JSSC.2026.3653449},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11367692,
  author={Park, Gunwoo and Kim, Hyunjoon and Jeon, Sanggeun},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A High-Power Wideband Sub-THz Power Amplifier With Asymmetric Slotline-Based Series--Parallel Combiner in 130-nm SiGe BiCMOS Technology}, 
  year={2026},
  volume={61},
  number={8},
  pages={3910-3925},
  abstract={This article presents a high-power, wideband sub-terahertz power amplifier (PA) implemented in a 130-nm SiGe BiCMOS technology. The PA features a novel asymmetric slotline-based series–parallel combiner (ASSPC) for output power combining. The ASSPC provides both low-loss, wideband combining and efficient admittance matching for four differential cascode PA unit cells, outperforming traditional transformer-based structures. Admittance balancers (Y-balancers) are incorporated into the ASSPC, ensuring that the optimum load-pull admittance is presented to each unit cell uniformly. The analysis and design guidelines for the ASSPC with Y-balancers are provided. The PA with the ASSPC achieves the highest saturated output power ( $P_{\mathrm {sat}}$ ) of 15.7 dBm at 235 GHz and the widest 1-dB  $P_{\mathrm {sat}}$  bandwidth of 75 GHz among Si-based PAs operating in the WR-3.4 band (220–330 GHz). The peak gain is 19.8 dB with a wide 3-dB bandwidth of 72.7 GHz, spanning from 184.5 to 257.2 GHz. The PA was also tested using various modulation schemes, including 16-quadrature amplitude modulation (QAM), 32-QAM, and 64-QAM. The measured rms error vector magnitudes (EVMs) are −18.1, −22.9, and −24.5 dB for 16-QAM, 32-QAM, and 64-QAM signals, respectively, with corresponding average output powers ( $P_{\mathrm {avg}}$ ) of 4.1, 4.8, and 3.3 dBm at a carrier frequency of 242 GHz.},
  keywords={Baluns;Power generation;Power amplifiers;Wideband;Bandwidth;Transistors;Gain;Silicon germanium;Admittance;Stability analysis;Asymmetric slotline-based series–parallel combiner (ASSPC);high-power;power amplifier (PA);SiGe BiCMOS;sub-terahertz;wideband},
  doi={10.1109/JSSC.2026.3656477},
  ISSN={1558-173X},
  month={Aug},}

@ARTICLE{11370741,
  author={Diverrez, Gwennaël and Kerhervé, Eric and De Matos, Magali and Cathelin, Andreia},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Theoretical Analysis and Design of a 22--44-GHz Quasi-Balanced Doherty Power Amplifier With Enhanced Wideband PAE Performance and 3:1 VSWR Tolerance in 28-nm FD-SOI CMOS}, 
  year={2026},
  volume={61},
  number={8},
  pages={3926-3939},
  abstract={This article presents a broadband 5G power amplifier (PA) robust to voltage standing wave ratio (VSWR) variations and featuring high efficiency up to deep power back-off (PBO) in 28-nm FD-SOI CMOS technology. The proposed architecture, based on a quasi-balanced structure and an inductive load, offers an alternative to the conventional Doherty PA to maintain its  $\text {PAE}_{\text {6dBPBO}}$  enhancement up to 3:1 VSWR over a wide bandwidth. A detailed theoretical analysis demonstrates the improved broadband performance that can be achieved with this architecture, as well as its robustness to VSWR variations. Indeed, the degradation of its  $\text {PAE}_{\text {6dBPBO}}$  is kept below 7% between 22 and 44 GHz. The circuit achieves 24%  $\text {PAE}_{\text {6dBPBO}}$  and 16%  $\text {PAE}_{9.\text {7dBPBO}}$  at 28 GHz, while guaranteeing linearity in line with the 5G standard. The PA occupies a surface area of 0.82 mm2.},
  keywords={Impedance;Couplers;Reflection;Power amplifiers;5G mobile communication;Broadband amplifiers;Zinc oxide;Reflection coefficient;II-VI semiconductor materials;Voltage;5G;CMOS;Doherty;hybrid coupler;inductive load;power amplifier (PA);quasi-balanced;voltage standing wave ratio (VSWR)},
