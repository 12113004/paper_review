@ARTICLE{11456493,
  author={Santana-Andreo, Andrés and Gata-Romero, José Manuel and Castro-López, Rafael and Roca, Elisenda and Fernández, Francisco V.},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={An Array-Based IC for the Characterization of Aging in Standard Cells}, 
