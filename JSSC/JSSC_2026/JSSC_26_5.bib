  journal={IEEE Journal of Solid-State Circuits},
  title={An Optimal Modulation Bits-to-RF Digital Transmitter Using Time-Interleaved Multi-Subharmonic Switching},
  year={2026},
  volume={61},
  number={5},
  pages={1817-1829},
  abstract={This article presents a fully integrated bits-to-RF transmitter (Tx) featuring deep power back-off (PBO) enhancements, leveraging a multi-subharmonic switching (multi-SHS) digital power amplifier (DPA) with time-interleaving and a harmonic-rejection digital-to-phase converter (DPC). This work employs a nonuniform optimal modulation (OM) constellation, where symbol probability is inversely related to its amplitude, and symbols transmitted more frequently are assigned to shorter bit lengths, collectively reducing the transmission error rate. The system, operating from 2.6- to 1.3-V VDDs, achieves 22.7-dBm peak output power with 58.1% peak power-added efficiency (PAE) and 52% peak system efficiency (SE), implemented in 65-nm CMOS technology. The system is able to support both QAM and OM modes of operation with high efficiency. Dynamic measurements using 64-/256-QAM constellations achieved 23.2%/19.7% PAE and 19.7%/16.8% SE at 17.1/16.4-dBm average output power, while maintaining an error vector magnitude (EVM) of −29.7/−30.75 dB at 1.5-GHz carrier frequency. In addition, the transmission of 64-/256-point OM constellations with 23.1%/19.6% PAE and 19.4%/16.5% SE at 16.9/16.2-dBm average output power, with an EVM of −29.9/−31.37 dB was demonstrated. In comparison of standard QAM, the proposed 64-point OM scheme reduces the symbol error rate (SER) by 12.4– $15.4{\times }$  and the bit error rate (BER) by 5.4– $7.3{\times }$  through the use of padding bits and a Guessing random additive noise decoder (GRAND)-assisted demodulator, across 22–26-dB receiver (Rx) signal-to-noise ratio (SNR) levels. In addition, 256-point measurements across Rx SNR levels of 30–34.6 dB demonstrated 6– $8.5{\times }$  lower SER and 1.4– $2{\times }$  lower BER, showcasing the ability to deliver highly efficient and reliable communication across various modulation orders.},
  keywords={Power amplifiers;Quadrature amplitude modulation;Trees (botanical);Standards;Power generation;Bit error rate;Signal to noise ratio;Energy efficiency;Transmitters;Bit/symbol error rate (SER);digital power amplifier (DPA);digital-to-phase converter (DPC);nonuniform symbol distribution;optimal modulation (OM);subharmonic switching;transmitter (Tx)},
  doi={10.1109/JSSC.2026.3659903},
  ISSN={1558-173X},
  month={May},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11398766&isnumber=11494345},
}

@ARTICLE{11363454,
  author={R. Liao and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Multi-Frequency-Excited MIMO Radar Array Architecture Enabling Exponential-Order Improvement in Angular Resolution},
  year={2026},
  volume={61},
  number={5},
  pages={1830-1843},
  abstract={Improving angular resolution in millimeter-wave radars requires a large number of transceivers to fulfill a large array aperture. However, integrating tens or hundreds of transceivers is costly and power hungry. This motivates us to develop an alternative array architecture that supports high angular resolution but with many fewer transceivers. In this work, we propose a multi-frequency-excited radar array architecture by introducing a frequency dimension in multiple-input and multiple-output (MIMO) radars. By changing the excitation frequencies of the antenna array, we can diversify the electrical spacings across the antenna elements as the wavelength changes. Therefore, we can generate multiple equivalent sub-arrays with different electrical apertures and use them to synthesize an extremely large array. As a result, with k different frequencies, our proposed radar architecture can generate  $\mathbf { N^{2k}}$  equivalent array elements in the synthesized array with N physical transmitters (TX) and N receivers (RX). For a fixed aperture area, this method can reduce the total number of physical elements exponentially without introducing grating lobes. As a proof of concept, we designed a single-channel TX chip and a dual-channel RX chip that operate at 15, 30, and 60 GHz in a 65-nm CMOS process. The TX has an output power of 11.8, 10.1, and 12.0 dBm, while the RX has a noise figure of 9.8, 12.6, and 12.4 dB, and an out-of-band (OOB) input 1-dB compression point (IP $\mathbf {_{\text {1{dB}}}}$ ) of −0.7, 1.5, and −0.2 dBm, measured at 15, 30, and 60 GHz, respectively. In the system demonstration, we use one TX chip and two RX chips to form a one-TX and four-RX radar system. The over-the-air (OTA) demonstration shows a 6° angular resolution, which is  $4{\mathbf {\times }}$  improved compared to the conventional one-TX and four-RX radar systems.},
  keywords={Transceivers;MIMO radar;Apertures;Radar antennas;Linear antenna arrays;Gratings;Millimeter wave radar;Laser radar;Image resolution;Continuous wavelet transforms;Angular resolution;aperture;frequency modulated continuous wave (FMCW) radar;millimeter-wave;multiple frequency;multiple-input and multiple-output (MIMO);transceiver},
  doi={10.1109/JSSC.2026.3654992},
  ISSN={1558-173X},
  month={May},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11363454&isnumber=11494345},
}

