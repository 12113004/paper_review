@ARTICLE{11306372,
  author={R. Chen and H. -Y. Chien and B. Yan and C. -J. Tien and M. -C. Frank Chang},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 129–146-GHz Direct-Digital Modulation FinFET Transmitter With On-Chip Mismatch Calibrations for Beyond-5G Wireless Communications},
  year={2026},
  volume={61},
  number={5},
  pages={1776-1790},
  abstract={This article presents a D-band direct-digital modulation (DDM) transmitter with on-chip digital calibration blocks for future beyond-5G (B5G) wireless communication. The proposed DDM architecture mitigates the need for complex intermediate frequency (IF) generation and power-hungry digital-to-analog converters (DACs). The transmitter is implemented primarily in TSMC’s 16-nm p-FinFETs, which exhibit superior RF performance than n-type counterparts. The carrier generation block consists of an input buffer, an active balun, a frequency octupler with current shaping and common-mode (CM) suppression, and an output buffer. A switch-based variable gain amplifier (VGA), a digitally controlled artificial dielectric (DiCAD) transmission line, and current-absorbing devices on RF-DACs are implemented on each I/Q path to enable precise on-chip amplitude and phase calibration. Then, the calibrated complex vectors are sent to a three-stage power amplifier (PA) with capacitive neutralization to drive a 50- $\boldsymbol {\Omega }$  load. The transmitter has a 3-dB bandwidth of 17 GHz, ranging from 129 to 146 GHz, a  $P\mathbf {_{\text {sat}}}$  of 12.2 dBm, a total dc power consumption of 235 mW, and a total chip area of  $\mathbf {1 ~\text {mm}^{2}}$ . It supports modulation schemes, including QPSK, 16-QAM, and 64-QAM with symbol rates of 2, 4, 6, and 8 GS/s. A maximum data rate of 48 Gb/s (4.9-pJ/bit efficiency) is achieved with 64-QAM and an EVM of −23.8 dB, demonstrating the potential of FinFET-based D-band systems-on-chip (SoCs) for B5G communication.},
  keywords={Transmitters;Gain measurement;System-on-chip;Calibration;Baluns;Wireless communication;Voltage control;Signal to noise ratio;Frequency shift keying;Bandwidth;Quadrature amplitude modulation;Digital modulation;Terahertz communications;16-QAM;64-QAM;6G;beyond-5G (B5G);communication;D band;direct-digital modulation (DDM);FinFET;millimeter wave (mm-Wave);QPSK;RF-DAC;sub-terahertz (sub-THz);transmitter;wireless},
  doi={10.1109/JSSC.2025.3644224},
  ISSN={1558-173X},
  month={May},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11306372&isnumber=11494345},
}

