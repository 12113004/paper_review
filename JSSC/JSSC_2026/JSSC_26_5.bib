@ARTICLE{11180935,
  author={J. Zuckerman and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={EPOCHS-1: A 12 nm Highly Heterogeneous Open-Source SoC With Distributed Coin-Based Power Management and Integrated Hybrid Voltage Regulation},
