  journal={IEEE Journal of Solid-State Circuits},
  title={A 40-nm CMOS Phase-Tunable Four-Phase Injection-Locked Ring VCO Utilizing Unbalanced Feedforward Topology Achieving −211.1- to −207.3-dBc/Hz FoMA Over Differential/Orthogonal Phase Range of −90.0° to 80.9°/−69.6° to 76.5°},
