@ARTICLE{11148275,
  author={L. -H. Lin and Z. -S. Fu and P. -S. Chen and B. -Y. Yang and C. -H. Yang},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 4.8-mW Hybrid Crypto SoC With Post-Quantum Cryptography and Lightweight Cryptography for Secure Neural Interfacing},
