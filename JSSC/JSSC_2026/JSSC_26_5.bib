@ARTICLE{11457391,
  author={J. Zhou and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 71–86-GHz 1024-QAM Direct-Carrier Phase-Modulating Transmitter With Digital-to-Phase Converter and Constant-Envelope Phasor Combiner},
  year={2026},
  volume={61},
  number={5},
  pages={1804-1816},
  abstract={This article presents a 71–86-GHz 1024-QAM direct-carrier phase-modulating transmitter (DCPM-TX) that synthesizes high-order QAM symbols using phase modulation only. The proposed approach employs dual 9-bit digital-to-phase converters (DTPCs) and a constant-envelope phasor combiner. Each DTPC uses coarse/fine-segmented digitally controlled switched-capacitor transmission lines (SCTLs) (true-time-delay operation) plus a sign mixer, providing a 360° phase range and sub-1° rms phase error while preserving wide carrier and modulation bandwidth. To avoid linear power amplifier (PA) back-off, the modulated phasors are driven into saturation and combined to realize high output power over 71–86 GHz. Using direct-digital-synthesis control with on-chip SRAM, the transmitter also generates a 77–81-GHz FMCW chirp in 5  $\mu $ s with 84 kHz (0.0021%) rms frequency modulation (FM) error. The prototype DCPM-TX achieves 32 and 25.6 Gbps using 1024-QAM at 73 and 83 GHz, respectively, with peak Pout over 16 dBm while consuming 340-mW DC power and 0.675-mm2 core silicon area on 28-nm bulk CMOS.},
  keywords={Antennas;Radio astronomy;Frequency modulation;Radio broadcasting;Capacitors;Radiofrequency integrated circuits;System-on-chip;Integrated circuits;Millimeter wave devices;Quadrature amplitude modulation;Transmitters;Artificial dielectric;constant-envelope;digital transmitter;digital-to-phase;direct-carrier;mmWave},
