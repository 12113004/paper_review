@ARTICLE{11132087,
  author={Z. Wu and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={SKADI: A 28-nm Complete K-SAT Solver Featuring Bidirectional In-Memory Deduction and Incremental Updating},
  year={2026},
  volume={61},
  number={5},
  pages={2295-2308},
  abstract={Boolean satisfiability (K-SAT) is a canonical problem at the core of many electronic design automation (EDA) and artificial intelligence (AI) tasks. Due to its NP-complete characteristic, solving K-SAT ( $K \geq 3$ ) problems on von Neumann architectures incurs substantial energy and latency overhead. Recent ASIC K-SAT solvers have significantly improved energy efficiency, but these implementations are inherently incomplete. While these solvers have demonstrated the capability to solve satisfiable (SAT) problems, no evidence has been provided for proving unsatisfiability. This limitation severely restricts their applicability, as real-life scenarios mostly demand definitive SAT/unsatisfiable (UNSAT) outcomes. To address this gap, this work presents a complete K-SAT solver based on the DPLL framework that can determine whether the given formula is SAT or UNSAT. The proposed architecture incorporates a dual-path SRAM-based macro and a position-encoded counter (PEC) to perform highly parallel, bidirectional clause-variable deduction. Additionally, an incremental updating technique is employed for conflict-aware backtracking and search space pruning. Fabricated in 28-nm CMOS, the proposed solver achieves 100% solvability across all SAT and UNSAT benchmarks, with average solution times of  $17.1~\mu $ s (uf50-218) and  $42.1 ~\mu $ s (uuf50-218) at 0.9-V supply voltage. Corresponding energy consumptions are 58.0 and 142.8 nJ, respectively. As the first ASIC complete K-SAT solver, it enables deployment in applications where deterministically asserting SAT/UNSAT is essential.},
  keywords={Artificial intelligence;Accuracy;Integrated circuits;Backtracking;Computer architecture;Recurrent neural networks;Partitioning algorithms;Microelectronics;Boolean functions;Combinatorial testing;In-memory computing;Hardware acceleration;Boolean satisfiability (K-SAT);combinatorial optimization problems (COPs);complete solver;compute-in-memory (CIM);domain-specific accelerator},
  doi={10.1109/JSSC.2025.3598289},
  ISSN={1558-173X},
  month={May},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11132087&isnumber=11494345},
}

@ARTICLE{11147161,
  author={A. Moradifirouzabadi and M. Kang},
  journal={IEEE Journal of Solid-State Circuits},
  title={HyAtt: A Hybrid Attention Accelerator for Transformers With Analog In-Memory Computing},
  year={2026},
  volume={61},
  number={5},
  pages={2309-2321},
  abstract={Transformer-based models have achieved state-of-the-art performance in various deep learning domains, yet their heavy computation and memory demands, particularly in the self-attention mechanism, present significant challenges for efficient hardware implementation. In this work, we propose HyAtt, a hybrid attention accelerator that integrates both analog and digital computing paradigms to optimize Transformer-based workloads. Our architecture offloads token pruning to a computing-in-memory (CIM)-based analog core while delegating attention computations for unpruned tokens to a dedicated digital processor. An efficient task scheduling procedure parallelizes the token pruning, data fetching, and computations for enhanced performance. In the analog core, we introduce a transposable memory array with 9T SRAM cells for charge sharing-based CIM operations with an analog-to-digital converter (ADC)-less scheme to enhance energy efficiency. HyAtt prunes 77.9% of tokens with only a 0.65% accuracy drop, requiring the digital core to process the attention only for the remaining 22.1% of tokens. The silicon prototype of HyAtt is fabricated in a 65-nm process and achieves an operational frequency of 1.1 GHz. It delivers a peak energy efficiency of 14.8 and 1.65 TOPS/W at 0.7 V and a peak area efficiency of 976.6 and 79.4 GOPS/mm2 at 1.2 V at CIM and chip levels, respectively.},
  keywords={Transformers;In-memory computing;Energy efficiency;Computational modeling;Common Information Model (computing);Hardware;Accuracy;Transformer cores;Processor scheduling;Attention mechanisms;Attention;hybrid processor;in-memory computing;token pruning;Transformer},
  doi={10.1109/JSSC.2025.3602940},
  ISSN={1558-173X},
  month={May},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11147161&isnumber=11494345},
}

@ARTICLE{11144478,
  author={Y. Zhao and Y. Wang and R. P. Martins and C. -H. Chan and S. Yin and M. Zhang},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Hierarchical-Hybrid Floating-Point Compute-in-Memory Macro Using FP-DAC and FP-ADC for Edge-AI Devices},
  year={2026},
  volume={61},
  number={5},
  pages={2322-2335},
  abstract={The floating-point (FP) format offers superior precision compared to its integer counterpart for multiply-and-accumulate (MAC) computations. With the rapid progress of artificial intelligence (AI), FP-MAC operations are increasingly moving from the cloud to edge devices. However, the complex nature of FP processes constrains their energy efficiency. Compute-in-memory (CIM) shows promise for reducing power consumption, but FP-CIM still encounters challenges related to mantissa and exponent computations. This article presents an energy-efficient FP-CIM macro designed for edge-AI devices. It addresses energy efficiency bottlenecks through three key features: 1) an FP digital-to-analog converter (FP-DAC) simplifies the pre-alignment logic, thereby reducing undesired power overhead throughout the FP process; 2) an FP analog-to-digital converter (FP-ADC) that substitutes uniform quantization steps with FP steps, eliminating redundant conversion power through adaptive quantization range (AQR); and 3) a hierarchical-hybrid structure (HHS) optimizes the tradeoff between accuracy and energy efficiency in FP-CIM using a coarse-to-fine hybrid strategy. Fabricated in a 65-nm CMOS process, the prototype FP-CIM macro achieves 54.4 TFLOPS/W in the BF16 mode and 130.9 TFLOPS/W in the FP8 mode.},
  keywords={Energy efficiency;Quantization (signal);Accuracy;Throughput;Power demand;In-memory computing;Parallel processing;Digital-analog conversion;Computational efficiency;Analog-digital conversion;Floating-point arithmetic;Compute-in-memory (CIM);floating point (FP);FP analog-to-digital converter (FP-ADC);FP digital-to-analog converter (FP-DAC);hybrid;multiply-and-accumulate (MAC)},
