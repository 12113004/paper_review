@ARTICLE{11224926,
  author={H. Zhu and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={SHINSAI: A 586 mm2 Reusable Active TSV Interposer With Programmable Interconnect Fabric and 512 Mb Underdeck Memory},
  year={2026},
  volume={61},
  number={1},
  pages={90-102},
  abstract={This article presents SHINSAI—a 586 mm2 reusable active through-silicon via (TSV) interposer addressing key challenges in multi-chiplet integration (MCI) architectures. While active interposers overcome fundamental limitations of passive counterparts by integrating functional circuitry, existing solutions face three critical constraints: 1) non-recurring engineering (NRE) costs from application-specific interposers negating chiplet reuse benefits; 2) memory capacity limitations restricting compute scalability; and 3) inflexible interconnects unable to support diverse communication patterns. SHINSAI introduces three key innovations: a heterogeneous dual-layer network-on-active-interposer (NoAI) combining packet/circuit-switched (CS) paradigms to reduce communication latency; a programmable 2.5-D H-Link fabric enabling protocol-agnostic  $\mu $ bump-to- $\mu $ bump routing across arbitrary topologies; and a reconfigurable 3-D vertical link (V-Link) architecture integrating 512 Mb underdeck SRAM with adaptive bandwidth allocation. SHINSAI is implemented in 28-nm CMOS with TSV-middle technology, with a  $\mu $ bump-pitch of  $40~\mu $ m. A SHINSAI-based MCI prototype system with 16 chiplets is also assembled.},
  keywords={Integrated circuit interconnections;Chiplets;Silicon;Fabrics;Through-silicon vias;Load flow;Topology;Three-dimensional displays;Routing;Random access memory;Active silicon interposer;advanced package;die-to-die interconnect;multi-chiplet integration (MCI);through-silicon via (TSV)},
