  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11222679&isnumber=11318064},
}

@ARTICLE{11219076,
  author={H. S. Öztürk and J. Arenas and C. Tokunaga and N. Kurd and V. S. Sathe},
  journal={IEEE Journal of Solid-State Circuits},
