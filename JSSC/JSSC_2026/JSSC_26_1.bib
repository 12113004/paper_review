@ARTICLE{11216108,
  author={S. R. Srinivasa and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Standardized 20-Tb/s Bandwidth Scalable Heterogeneous 2.5-D System Supporting Assembly Time Workload-Dependent Chiplet Configurations},
  year={2026},
  volume={61},
  number={1},
  pages={142-153},
  abstract={The increasing adoption of chiplet-based architectures highlights the compelling paradigm of disaggregating monolithic systems into interconnected chiplets, offering numerous advantages for heterogeneous integration. This disaggregation is essential as chips approach the reticle limit, improving yield and design flexibility by combining diverse functionalities. Next-generation 2.5-D systems require enhanced interoperability across heterogeneous multi-foundry nodes, higher memory, I/O, and scalable interconnects for varied chiplet types driven by artificial intelligence (AI) and data-intensive workloads. We introduce a unique 2.5-D packaging approach integrating heterogeneous multi-foundry active chiplets over a large passive base in silicon (PBS) chiplet. Our system in package (SIP) houses up to 20 ( ${\sim } 4\,{\times }\,4$  mm) chiplets, demonstrating significant and functional heterogeneous integration and scalability beyond reticle limits, addressing integration complexities. This platform enables the creation of highly customized compute systems tailored to specific application demands. Furthermore, the high bandwidth and energy efficiency facilitate complex data processing and acceleration. To tackle memory bottlenecks in AI, future systems should enable workload-tailored assembly for optimal heterogeneous resource allocation. Our SIP achieves 20-Tb/s aggregate bandwidth in parallel computing across heterogeneous units with 0.8-pJ/bit die-to-die (D2D) efficiency, showcasing potential for high-performance, power-conscious heterogeneous disaggregated systems.},
  keywords={Chiplets;Assembly;Silicon;Artificial intelligence;Standardization;Device-to-device communication;Routing;Through-silicon vias;Hardware;Foundries;Chiplets;die-to-die (D2D);distributed computing;heterogeneous systems;multi-foundry;serializer/deserializer (SerDes)},
  doi={10.1109/JSSC.2025.3613339},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11216108&isnumber=11318064},
}

@ARTICLE{11148266,
  author={S. Moon and M. Li and G. K. Chen and P. C. Knag and R. K. Krishnamurthy and M. Seok},
  journal={IEEE Journal of Solid-State Circuits},
  title={T-REX: Hardware–Software Co-Optimized Transformer Accelerator With Reduced External Memory Access and Enhanced Hardware Utilization},
  year={2026},
  volume={61},
  number={1},
  pages={154-167},
  abstract={Transformers have emerged as the dominant neural network architecture thanks to their versatility- and human-level performance. However, a transformer model contains a very large number of parameters, which makes the overhead associated with external memory access (EMA), a critical bottleneck in computing systems. In light of this, we develop T-REX, a hardware accelerator for transformers with the goal of minimizing EMA. We develop a novel factorizing training method to reduce the parameter count substantially. We also combine a range of data compression techniques to effectively compress dense and sparse parameter matrices. Furthermore, we develop a dynamic batching technique, which can process multiple short inputs in parallel to increase parameter reuse. Last but not least, we develop a two-directional accessible register file (TRF) and the optimized dataflow to improve throughput and hardware utilization in many back-to-back matrix multiplications (MMs) commonly in a transformer model. The T-REX test chip is prototyped in Intel 16-nm FinFET. It achieves 68– $567~\mu $ s/token and 0.41– $3.95~\mu $ J/token, demonstrating 1–2 orders of magnitude improvement over the prior work.},
  keywords={Transformers;Hardware;Training;Sparse matrices;Accuracy;System-on-chip;Random access memory;Quantization (signal);Memory management;Computational modeling;Dynamic batching;external memory access (EMA);factorizing training;hardware utilization;transformer;two-directional accessible register file (TRF)},
  doi={10.1109/JSSC.2025.3603187},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11148266&isnumber=11318064},
}

@ARTICLE{11180908,
  author={S. Kim and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={EdgeDiff: Energy-Efficient Multi-Modal Few-Step Diffusion Model Accelerator Using Mixed-Precision and Reordered Group Quantization},
  year={2026},
  volume={61},
  number={1},
  pages={168-182},
  abstract={Recent advances in diffusion models (DMs)—such as few-step denoising and multi-modal conditioning—have significantly improved computational efficiency and functional flexibility, but they also introduce new hardware challenges. In particular, the elimination of inter-timestep redundancy, increased encoder/decoder workload, and heightened sensitivity to quantization demand a new class of accelerator. We present EdgeDiff, the first processor to support end-to-end, few-step, and multi-modal DM inference. EdgeDiff introduces a unified solution named condition-aware reordered group mixed precision (CRMP) with several novel microarchitectures: compress-and-add (CAA) processing elements (PEs) with bit-shuffle trees (BSTs) for efficient low-bit multiply-accumulate (MAC), a tiered accumulation unit (TAU) to reduce floating-point (FP) accumulation energy, and a grid-based quantization unit (GQU) to eliminate expensive FP division. Fabricated in 28-nm CMOS, EdgeDiff achieves up to 34.4-TOPS/W energy efficiency and reduces generation energy to 418.4 mJ/image for one-step text-to-image (T2I) generation— $3.3\times $  lower than prior state of the art. Despite aggressive quantization, EdgeDiff maintains output quality comparable to FP inference across Fréchet Inception Distance (FID), contrastive language–image pretraining (CLIP), and peak signal-to-noise ratio (PSNR) metrics, establishing it as a compelling solution for energy-efficient, real-time generative artificial intelligence (AI) on edge platforms.},
  keywords={Quantization (signal);Hardware;Energy efficiency;Computational modeling;Accuracy;Noise reduction;Computer architecture;Logic;Computational efficiency;Redundancy;Bit-slice computing;diffusion model (DM);few-step DM (FSDM);generative artificial intelligence (AI) accelerator;group quantization;mixed precision;multi-modal model},
  doi={10.1109/JSSC.2025.3611456},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11180908&isnumber=11318064},
}

@ARTICLE{11194701,
  author={S. Song and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={IRIS: An Energy-Efficient Spatial Computing SoC for Real-Time Interactive Rendering and Modeling With Surface-Aware 3-D Gaussian Splatting},
  year={2026},
  volume={61},
  number={1},
  pages={183-196},
  abstract={The 3-D Gaussian splatting (3DGS), based on a machine learning-driven radiance field technique, is rapidly emerging as a next-generation solution in 3-D graphics. Owing to its short modeling time, computational simplicity, and high rendering quality, it is expected to replace traditional 3-D graphics on edge devices. However, its substantial memory access requirements and the challenges of real-time modification present major barriers to deployment on mobile augmented/virtual reality (AR/VR) platforms. We present a spatial computing system-on-chip (SoC), IRIS, to enable real-time, spatially interactive rendering with surface-aware modelling (SAM). The architecture of IRIS introduces three key hardware features. First, the surface perception unit (SPU) reduces external memory access (EMA) and minimizes Gaussian sorting latency by clustering Gaussians based on surface alignment. Second, the reconfigurable ApproxLP (ALP)-based multiply-accumulator array (RAMA) achieves high computational efficiency and throughput during neural Gaussian feature generation and mesh deformation. Finally, the error direction cache (EDC) enables fast and efficient modeling by eliminating redundant backpropagation (BP) operations. As a result, IRIS is fabricated using a 28-nm process and occupies a die area of 20.25 mm2. When evaluated on the SyntheticNeRF dataset, IRIS achieves  $34.3{\times }$  faster interactive rendering and consumes  $300.0{\times }$  less energy per frame compared to an edge GPU, despite having  $21.3{\times }$  lower external memory bandwidth.},
  keywords={Three-dimensional displays;Computational modeling;Rendering (computer graphics);Real-time systems;Spatial computing;Intellectual property;Solid modeling;Iris recognition;System-on-chip;Iris;3-D Gaussian splatting (3DGS);3-D modeling;3-D rendering;approximate computing;augmented reality (AR);interactive rendering;mesh deformation;multi-layer perceptron (MLP);spatial computing;virtual reality (VR)},
  doi={10.1109/JSSC.2025.3613707},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11194701&isnumber=11318064},
}

@ARTICLE{11222650,
