@ARTICLE{11202686,
  author={J. Lee and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 112-Gb/s Discrete Multitone Wireline Receiver Datapath With Time-Interleaved Time-Based ADC in 5-nm FinFET},
  year={2026},
  volume={61},
  number={1},
  pages={8-19},
  abstract={This article presents a 112-Gb/s discrete multitone (DMT) wireline receiver (RX) datapath with a 50-GS/s, 8-bit, 64-way ( $8 \times 8$ ) time-interleaved time-based analog-to-digital converter (TI-TBADC) in a 5-nm FinFET. The TBADC converts the voltage input into a time-domain quantity using a ring oscillator (ROSC). Eight-slice TBADCs, driven from the same first-rank interleaver, share the identical injection-locked ROSC (IROSC) for voltage-to-time conversion (VTC). The DMT digital signal processor (DSP) achieves optimal bit and power loading with 63 orthogonal subchannels by employing a 64-way single-stage multi-path delay feedback (MDF) fast Fourier transform (FFT) core. An on-chip sign-sign least mean square (SS-LMS) engine adapts equalizer coefficients to combat channel fluctuation. The RX prototype demonstrates 4E-4 BER when communicating over the channel, exhibiting 18-dB insertion loss (IL) at Nyquist, while consuming 347-mW power and 0.242-mm2 silicon area.},
  keywords={Symbols;Loading;Signal to noise ratio;Time-domain analysis;Quadrature amplitude modulation;System-on-chip;FinFETs;Fast Fourier transforms;Electrical engineering;Digital signal processors;Bit and power loading;discrete multitone (DMT);injection locking;ring oscillator (ROSC);serial link;time-based analog-to-digital converter (TBADC);wireline transceiver (TRX)},
  doi={10.1109/JSSC.2025.3618188},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11202686&isnumber=11318064},
}

@ARTICLE{11277336,
  author={A. E. Abdelrahman and M. Badr Younis and M. Osama Selim and M. Saad Aly and M. A. Khalil and P. Kumar Hanumolu},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 1.54-pJ/b 64-Gb/s 16-QAM Intradyne Coherent Optical Receiver in 28-nm CMOS},
  year={2026},
  volume={61},
  number={1},
  pages={20-32},
  abstract={The rapid growth of data-intensive applications in modern data centers is driving demand for scalable, high-speed, and energy-efficient optical interconnects. Traditional noncoherent modulation schemes, such as pulse amplitude modulation (PAM), are reaching their scalability limits at higher data rates, making coherent detection increasingly attractive due to its higher spectral efficiency. Coherent detection systems leverage advanced modulation formats such as dual-polarization quadrature amplitude modulation (DP-QAM) but typically depend on complex digital signal processing (DSP) for polarization, phase, and timing recovery, resulting in increased power consumption. To address this, analog signal processing techniques have been explored for low-power coherent optical receivers (RXs) with several quadrature phase shift keying (QPSK)-based designs reported. However, 16-QAM remains underexplored due to its higher complexity. This article presents a low-power 16-QAM coherent optical RX designed for short-reach data center interconnects, featuring a decision-directed 16-QAM phase detector (PD) that improves carrier-phase recovery and tracking by leveraging both inner and outer constellation symbols. Fabricated in a 28-nm complementary metal–oxide–semiconductor (CMOS), the RX achieves a bit error ratio (BER) of 1E−10 at 64 Gb/s with a 20-MHz carrier-phase recovery loop bandwidth (BW) while consuming 1.54 pJ/bit. These results demonstrate the potential for scalable and power-efficient coherent RXs in future short-reach optical interconnects.},
  keywords={Adaptive optics;Optical mixing;Symbols;Optical receivers;Noise;High-speed optical techniques;Optical transmitters;Lasers;Integrated optics;Gain;16-QAM;analog signal processing;carrier-phase recovery;coherent optical communications;complementary metal–oxide–semiconductor (CMOS) integrated circuits;data center interconnects;optical receivers (RXs)},
  doi={10.1109/JSSC.2025.3635729},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11277336&isnumber=11318064},
}

@ARTICLE{11165151,
  author={S. Mondal and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 108 Gb/s PAM-4 VCSEL-Based Direct-Drive Optical Engine for Co-Packaged Optics Applications},
  year={2026},
  volume={61},
  number={1},
  pages={33-46},
  abstract={This article presents a multimode vertical-cavity surface-emitting laser (VCSEL)-based direct-drive optical engine for co-packaged optics (CPOs) applications that employs pulse amplitude modulation (PAM)-4 to enhance shoreline bandwidth (BW) density and features a compact direct optical wiring (DOW) approach for on-package fiber termination. On the transmit side, a VCSEL driver (VCDRV) comprising a passive complementary-drive complex-zero continuous-time linear equalizer (CZ-CTLE) is introduced to compensate for the VCSEL’s complex-pole response while offering the high linearity required for PAM-4 signaling. The receiver integrates a high-linearity transimpedance amplifier front-end (TIA-FE) capable of handling large input current swings, followed by an active CZ-CTLE to equalize the complex-pole pair response of the low-gain shunt-feedback transimpedance amplifier (TIA). The transceiver prototype, fabricated in a 22-nm FinFET process and integrated on-package with optical devices and fiber-termination, achieves a PAM-4 data rate of 108 Gb/s with a record energy efficiency (EE) of 0.9 pJ/b—representing over  $1.7\times $  improvement in data rate compared to previously reported VCSEL-based transceivers. The optical transmitter supports 128 Gb/s PAM-4 operation, demonstrating a  $1.5\times $  data rate improvement and  $1.6\times $  better EE than the fastest reported integrated VCDRV. Compared to PAM-4 VCDRVs in the prior art, this work achieves  $2\times $  higher data rate,  $\gt 1.8\times $  better optical modulation amplitude (OMA), and  $3\times $  better EE.},
  keywords={Vertical cavity surface emitting lasers;Integrated optics;Optical amplifiers;Optical transmitters;Optical receivers;Optical pulses;Optical fiber amplifiers;Engines;Optical distortion;Optical modulation;Complimentary-drive complex-zero continuous-time linear equalizer (CZ-CTLE);co-packaged optics (CPOs);direct optical wiring (DOW);direct-drive optical engine;fiber termination;optical transceiver;photodiode (PD);reconfigurable active CZ-CTLE;transimpedance amplifier (TIA);vertical-cavity surface-emitting laser (VCSEL)},
  doi={10.1109/JSSC.2025.3607311},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11165151&isnumber=11318064},
}

@ARTICLE{11192232,
  author={Y. Tian and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 28-nm 8–28-GHz Eight-Phase Clock Generator Using an Injection-Locked Dual-Feedback Ring Oscillator},
  year={2026},
  volume={61},
  number={1},
  pages={47-62},
  abstract={The injection-locked ring oscillator is being widely used in high-speed wireline transceivers to generate multi-phase clocks. The fundamental limit lies in the tradeoff between the number of output phases and the maximum operation frequency for a given technology node. This work proposes the dual-feedback ring oscillator that breaks the tradeoff by completely decoupling the frequency generation feedback loop and phase alignment feedback loop. Theoretical frames are provided with simulation verification. The proposed dual-feedback ring oscillator is adopted in an eight-phase clock generation circuit that injection locks the ring oscillator with a delay-locked loop (DLL). The prototype fabricated in a 28-nm CMOS process achieves 8–28-GHz frequency range with <3° phase error and <38-fs integrated jitter. The highest operation frequency is improved by ~40% compared to state-of-the-art.},
  keywords={Ring oscillators;Oscillators;Clocks;Steady-state;Feedback loop;Transceivers;Jitter;Delays;Inverters;Couplings;Delay-locked loop (DLL);dual-feedback ring oscillator;multi-phase clock generation;positive feedback cross-coupling;wireline transceivers},
  doi={10.1109/JSSC.2025.3613940},
  ISSN={1558-173X},
  month={Jan},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11192232&isnumber=11318064},
}

