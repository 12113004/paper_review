@ARTICLE{11277346,
  author={J. Yoon and Y. Chae},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Continuous-Time Zoom ADC With Coarse Noise-Shaping ADC and Interstage Low-Pass Filter},
  year={2026},
  volume={61},
  number={4},
  pages={1400-1409},
  abstract={This article presents a continuous-time (CT) zoom ADC that employs a noise-shaping coarse ADC and an interstage low-pass filter (LPF) to achieve a 6-bit linear zoom-in only with an intrinsically linear 1.5-bit digital-to-analog converter (DAC). The key idea of this design is the interstage LPF, which properly filters the shaped residue signal of the coarse delta-sigma modulator ( $\Delta \Sigma M$ ) and enables the fine  $\Delta \Sigma M$  to perform with a 6-bit linear zoom-in operation, effectively boosting the overall resolution. This substantially relaxes the design overhead and enhances overall efficiency. The noise-shaping property of the coarse  $\Delta \Sigma M$  eliminates the need for gain mismatch calibration between analog and digital domains, thus ensuring the ADC’s robustness. The ADC prototype, fabricated in a 28-nm CMOS process, occupies an active area of  $0.12~\text {mm}^{{2}}$  and consumes only  $392~\mu $ W from a 1 V supply. It achieves 91.2-dB SNDR, 92.3-dB SNR, 92.7-dB DR, and 101.4-dB SFDR over a 250 kHz bandwidth without using DAC linearization. This performance translates to Schreier SNDR/DR figure-of-merit (FoM) of 179.2/180.7 dB, respectively.},
