@ARTICLE{11408627,
  author={J. Jung and E. Lee and D. Han and J. Wang and A. P. Chandrakasan and R. Han},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 60-GHz Low-Noise mmWave Divider-Less Fractional-N Cascaded PLL Achieving −250.2-dB FoMJ in 28-nm CMOS},
  year={2026},
  volume={61},
  number={4},
  pages={1425-1437},
  abstract={This article presents a fractional- ${ {N}}$  cascaded phase-locked loop (PLL) operating in the mmWave band from 55.8 to 64.2 GHz. The cascaded architecture consists of a first-stage fractional- ${ {N}}$  reference-sampling (RS) PLL and a second-stage sub-sampling (SS) PLL, incorporating two key innovations. The first-stage RS-PLL leverages a fully differential voltage-domain quantization-noise cancellation (FDVD-QNC) scheme to suppress the quantization noise of the delta–sigma modulator. The proposed FDVD-QNC, implemented through two sequential steps—bottom-plate voltage switching of the sampling capacitor and intentional offset voltage control of the transconductance cell—achieves a resolution of 0.08 mV with an integral nonlinearity (INL) within 1 LSB, while consuming only 0.64 mW. Moreover, its differential topology minimizes susceptibility to external noise sources and doubles the gain of the sampling phase detector (PD). As a result, the first-stage RS-PLL achieves  $48.4~\text {fs}_{\text {rms}}$  jitter and a fractional spur of −62.8 dBc with only 14.2 mW of power. Next, to enable reliable frequency acquisition in the second-stage SS-PLL, a frequency-locked loop (FLL) based on a switched-capacitor (SC) frequency-to-voltage converter (FVC) is proposed. The SC-FVC realizes a mmWave divider-less FLL by converting frequency into voltage, thereby eliminating the need for a bulky and power-hungry mmWave divider. The SC-FVC-based FLL consumes 0.84 mW and achieves frequency acquisition within 448 ns without harmonic lock in the SS-PLL. The cascaded PLL is fabricated in a 28-nm CMOS process and occupies an active area of 0.33 mm2. It achieves  $58.4~\text {fs}_{\text {rms}}$  jitter with 28.4 mW, corresponding to a  $\text {FoM}\!_{\text {J}}$  of −250.2 dB.},
  keywords={Phase locked loops;Millimeter wave communication;Noise;Frequency locked loops;Clocks;Frequency conversion;Jitter;Power harmonic filters;Topology;Switches;28-nm CMOS;60 GHz;low jitter;low noise;phase-locked loop (PLL);quantization noise;reference sampling;sub-sampling (SS);crystal oscillator (XO)},
  doi={10.1109/JSSC.2026.3652928},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11408627&isnumber=11457062},
}

@ARTICLE{11353269,
  author={L. Chen and D. Ye},
  journal={IEEE Journal of Solid-State Circuits},
  title={Analysis and Design of a Series-Resonance VCO With Magnetic Mutual Resistance},
  year={2026},
  volume={61},
  number={4},
  pages={1438-1451},
  abstract={In this article, a series resonance voltage-controlled oscillator (SR-VCO) with magnetic mutual resistance (MMR) is proposed and analyzed for the mm-waveband. The proposed SR-VCO utilizes a single transformer to implement the  $LC$ -tank. By manipulating the phase shift between the currents in the primary and secondary coils of the transformer, we introduce two resistive impedances, which we refer to as MMRs. Consequently, the power consumption is reduced due to the MMR-enhanced tank impedance. Since the MMR arises from magnetic coupling and does not dissipate energy, the  $Q$ -factor of the  $LC$ -tank remains unaffected. Moreover, by lowering the amplitude of impulse sensitivity function (ISF), the proposed MMR suppresses active devices noise, which is a dominant source of phase noise (PN) at mm-wave frequencies. The proposed SR-VCO is fabricated in a 65-nm CMOS technology with  $0.06~\text {mm}^{2}$  core area. The measured PN is −120.09 dBc/Hz at 1 MHz offset and −142.7 dBc/Hz at 10 MHz offset with a power consumption of 46 mW, corresponding to a FoM of 192.3 and 194.9 dBc/Hz.},
  keywords={Oscillators;Q-factor;Resistance;Coils;Impedance;Voltage-controlled oscillators;Voltage;Inductors;Power demand;Magnetic resonance;CMOS;impulse sensitivity function (ISF);mm-wave;phase noise (PN);series resonance (SR);voltage-controlled oscillator (VCO)},
  doi={10.1109/JSSC.2025.3649681},
