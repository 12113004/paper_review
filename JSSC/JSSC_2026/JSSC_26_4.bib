@ARTICLE{11129214,
  author={M. A. Bhat and I. Mondal},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 3–5.5 GHz Compact, Power-Efficient, Switched LC Delay-Line With 0.2–1.1 ns Delay Range},
  year={2026},
  volume={61},
  number={4},
  pages={1614-1628},
  abstract={This work presents a single-ended, linear-periodically time-varying (LPTV), two-port, inductor–capacitor (LC) delay-line offering broadband programmable delay of  $0.2\!-\!1.1\,\mathrm{ns}$  between 3 and  $5.5\,\mathrm{GHz}$  in a 65-nm bulk CMOS technology. The architecture is based on stitching together the harmonic peaks of an eight-path filter spaced at multiples of the clocking frequency. Shunting one inductor at each of the radio frequency (RF) ports broadens the skirts of the harmonic bands to form the wide passband of the delay-line. The inductors are used to increase the bandwidth of signal acquisition and not as memory. This minimizes the passband loss due to on-chip inductors. The resulting compact single-ended delay-line has a delay–bandwidth product (DBW) of 2.75 and DBW per unit area of 8.46/ $\text {mm}^{2}$ . Thanks to the all-passive nature, the chip dissipates less than  $16\,\mathrm{mW}$  of clocking power and has a P1dB of  $+2\,\mathrm{dBm}$ . The measured in-band loss and noise figure (NF), which are dominated by the on-resistance of the switches, are  $15\,\mathrm{dB}$  each. A theoretical framework to analyze N-path delay-lines with a memory element attached to the common node between the N-paths has also been presented. The analytical solutions show close agreement with the simulated and the measured results. In terms of the DBW/ $\text {mm}^{2}$ , the architecture is small enough to be compared to active delay-lines, whereas, in terms of insertion loss (IL) and linearity, its performance is better than all-passive delay-lines.},
  keywords={Delays;Radio frequency;Inductors;Delay effects;Wideband;Array signal processing;Time-frequency analysis;Passband;Linearity;Capacitors;Beamformer;LPTV;N-path;radio frequency (RF);true time delay (TTD);wideband},
  doi={10.1109/JSSC.2025.3590509},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11129214&isnumber=11457062},
}

@ARTICLE{11106422,
  author={N. Jain and E. A. M. Klumperink and H. van Rumpt and B. Nauta},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Programmable Resolution Digital-to-Frequency or Period Converter With Sawtooth-Based Jitter Reduction},
  year={2026},
  volume={61},
  number={4},
  pages={1629-1642},
  abstract={Open-loop fractional output dividers (FODs) are compact, digital-intensive frequency synthesizers with instantaneous frequency switching capability. Traditional FODs linearly map a digital code to frequency [digital-to-frequency converter (DFC)] or to period [digital-to-period converter (DPC)] with a fixed frequency or period resolution, respectively. This article proposes a flexible FOD that can be reconfigured to a DFC or a DPC with a programmable frequency or period step size. An analog-sawtooth-based phase interpolation approach is used to cancel the digital quantization errors. The interpolation circuit exploits a dual-alternating slope digital-to-time converter (DTC) architecture with a delay that is insensitive to process, voltage, and temperature variations and is tolerant to power supply noise. Fabricated in GlobalFoundries 22-nm FDSOI technology, the proposed FOD prototype produces the output frequencies ranging from 132 to 404 MHz using a 3 GHz input clock while consuming 5.5 mW and occupying an active area of 0.032 mm2. The fractional spurs are below −50 dBc at the nominal condition and below −47 dBc across supply, bias current, and temperature variations after performing a one-time calibration at 0.9 V supply voltage and room temperature.},
  keywords={Clocks;Frequency conversion;Frequency synthesizers;Jitter;Noise;Delays;Switches;Interpolation;Frequency modulation;Voltage;Deterministic jitter (DJ);digital period synthesis;digital-to-frequency converter (DFC);digital-to-period converter (DPC);digital-to-time converter (DTC);direct digital synthesis;direct period synthesis;fractional divider;fractional frequency synthesis;fractional output divider (FOD);phase interpolator (PI);spread spectrum clock generator;spur cancellation},
  doi={10.1109/JSSC.2025.3591756},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11106422&isnumber=11457062},
}

@ARTICLE{11099010,
  author={S. Zhang and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={An Adaptive Three-Stage GaN Gate Driver With Peak Miller Plateau Voltage Tracking and Voltage Tailing Suppression for 36.4% Switching Loss Reduction},
  year={2026},
  volume={61},
  number={4},
  pages={1643-1655},
  abstract={Achieving low switching loss is critical for high-frequency gallium nitride (GaN)-based power converters due to the compact packaging and limited heat dissipation capacity of GaN devices. Focusing on minimizing the switching loss, this article proposes an adaptive three-stage gate driver (ATSGD) for GaN high electron mobility transistor (GaN HEMT). By providing a three-stage driving current within the Miller plateau (MP) stage, the proposed ATSGD can achieve a near-constant dV/dt, thus minimizing the switching loss under specific peak dV/dt constraints. Utilizing peak MP voltage tracking (PMPVT) and quick voltage tailing suppression (QVTS) techniques, the driver dynamically determines optimal switching timings for the three-stage driving currents in real time. Therefore, the extra losses caused by slow dV/dt start-up and voltage tailing effect are minimized under dynamic operation conditions. Fabricated in a  $0.18~{\mu }$ m bipolar-CMOS-double-diffused metal oxide semiconductor (BCD) process, the proposed driver reduces the total switching loss by 36.4% under 400 V/15 A with a peak dV/dt of 45 V/ns, benefiting from a 46.1% reduction in slow dV/dt start-up loss and an 88.7% reduction in voltage tailing loss compared with conventional gate drivers.},
  keywords={Voltage;Switching loss;HEMTs;Switches;Logic gates;Timing;Gate drivers;Gallium nitride;DVD;Systems architecture;GaN HEMT;gate driver;dV/dt;voltage tailing effect;Miller plateau (MP)},
  doi={10.1109/JSSC.2025.3591212},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11099010&isnumber=11457062},
}

@ARTICLE{11098894,
  author={C. -Y. Chen and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={Monolithic GaN-Based Secondary-Side Controller for Precise Dead-Time Control Enabling ZVS and ZCS},
  year={2026},
  volume={61},
  number={4},
  pages={1656-1667},
  abstract={Unlocking the full potential of gallium nitride (GaN)-based rectifiers requires precise dead-time management, ensuring zero-voltage switching (ZVS) turn-on and zero-current switching (ZCS) turn-off. The proposed monolithic accurate on/off synchronous rectifier (SR) control (AOSC) improves dead-time precision and improves current sensing to minimize power loss in a 380–12-V LLC resonant flyback converter. The tri-enhancement GaN driver (TGD), incorporating three key advancements, achieves an ultra-fast switching delay of less than 3 ns, enabling rapid turn on/off of the GaN-based rectifier. Additionally, the error-eliminated GaN sensor (EGS) provides precise current sensing with a sub-1% error margin, ensuring accurate rectifier turn-off timing. This enables ZCS operation and integrates on-chip overcurrent protection (OCP). Moreover, the zero-crossing GaN detector (ZGD) compensates for controller delays, effectively minimizing reverse conduction losses. As a result, the proposed design achieves a high step-down ratio and an outstanding efficiency of 97.1%.},
  keywords={Sensors;Rectifiers;Zero current switching;Gallium nitride;Zero voltage switching;Delays;Circuits;Accuracy;Inductors;Capacitors;Accurate on/off synchronous rectifier (SR) control (AOSC);error-eliminated gallium nitride (GaN) sensor (EGS);inductor, inductor, and capacitor (LLC) flyback converter;tri-enhancement GaN driver (TGD);zero-crossing GaN detector (ZGD);zero-current switching (ZCS);zero-voltage switching (ZVS)},
