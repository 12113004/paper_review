}

@ARTICLE{11113328,
  author={H. Song and S. Oh and J. Salinas and S. -Y. Park and E. Yoon},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 120 Frames/s CMOS Image Sensor With 8.19 TOPS/W Computing-In-Pixel for Energy-Efficient Low-Latency Face Detection},
  year={2026},
  volume={61},
  number={4},
  pages={1668-1681},
  abstract={We present a CMOS image sensor (CIS) with on-chip energy-efficient face detection circuits for low-latency vision-based tracking systems. The embedded charge-domain computing circuits compute early stages of cascaded machine-learning classifiers for the images acquired from a global-shutter pixel array while simultaneously providing the digitized image readout. This approach improves the system energy–latency product by  $2.3{\times }$ , compared to the conventional high-speed tracking systems, because the backend computational load can be significantly reduced with no latency overhead. In addition, charge-domain computing within the pixel array allows for little energy overhead. The prototype image sensor was fabricated in a 180-nm CIS process with  $240{\times }240$  voltage-domain global shutter pixels. On-chip face detection rejects 98% of 3500 scanning windows and reduces the backend workload by  $5.3{\times }$ , while consuming only 421 pJ/pixel at 120 frames/s. This translates to the best in-class energy efficiency of 8.2 TOPS/W among CIS with near-sensor computing. In addition, the fabricated sensor supports illumination-invariant and multi-scale detection for robust operation, which is important in real applications.},
  keywords={Energy efficiency;Machine vision;Low latency communication;Face detection;Computer architecture;Circuits;Faces;Electrical engineering;CMOS image sensors;Wireless sensor networks;Cascaded classifiers;charge-domain;CMOS image sensor (CIS);computing-in-pixel;energy-efficient;face detection;in-memory computing;low-latency;machine-learning;mobile augmented reality (AR);voltage-domain global shutter},
  doi={10.1109/JSSC.2025.3592980},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11113328&isnumber=11457062},
}

@ARTICLE{11113258,
  author={H. Wu and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={A 28-nm 88.3-TFLOPS/W POSIT-Approximate-Calculation-Based Digital Computing-in-Memory Macro Incorporating Final-Cycle Fusion and Joint Skipping},
  year={2026},
  volume={61},
  number={4},
  pages={1682-1696},
  abstract={Computing-in-memory (CiM) architecture is considered a technology that promises to alleviate the memory wall problem in artificial intelligence (AI) computing. Previous work on digital CiM macros has achieved significant energy efficiency advantages in supporting approximate calculations of traditional integer (INT)/floating point (FP) data. POSIT is an emerging FP number system. Its main characteristic is that it can approach a good tradeoff between data range and accuracy by flexibly adjusting the mantissa bit width. However, current digital CiM macros lack the ability to support approximate calculations of POSIT data. Given this, we propose a POSIT-approximate-calculation-based CiM macro. The three main contributions of our work are as follows: 1) we improve the original POSIT approximate calculation principle and design a calculation logic circuit based on unsigned Radix8+ final-cycle fusion (FCF); 2) we propose a macro-level approximate calculation control strategy to help the CiM macro find a compromise between calculation performance and calculation error; and 3) we design an activation mantissa alignment skipping (AMAS) unit, to help the hardware skip sparse activation bits when calculating POSIT multiplication. A prototype of the CiM macro was fabricated in a 28-nm complementary metal oxide semiconductor (CMOS) and scored a peak macro energy efficiency of 88.3 TFLOPS/W @ POSIT (8, 2) for a voltage supply of 0.55–1.1 V and an operating frequency of 70–280 MHz, a value  $2.12{\times }$  higher than other state-of-the-art POSIT CiM macros.},
  keywords={Artificial intelligence;Accuracy;Energy efficiency;Hardware;Computer architecture;Costs;Optimization;Approximate computing;Power demand;Throughput;Approximate calculation;artificial intelligence (AI);complementary metal oxide semiconductor (CMOS);computing-in-memory (CiM);energy efficiency;final-cycle fusion (FCF);joint skipping;multiply accumulation (MAC);neural network (NN);POSIT;Radix8},
  doi={10.1109/JSSC.2025.3590632},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11113258&isnumber=11457062},
}

@ARTICLE{11128902,
  author={Y. He and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={An Area-Efficient Lookup-Table -Based eDRAM Digital CIM Macro for Neural Network Inference},
  year={2026},
  volume={61},
  number={4},
  pages={1697-1709},
  abstract={Digital circuit is a promising approach to implement computing-in-memory (CIM) architecture for data-intensive applications, such as neural network inference. Previous digital CIM implementations have demonstrated higher throughput and robustness than the analog counterpart, benefiting from technology scaling and full-precision datapaths. However, the traditional digital CIM designs adopt a bulky adder tree as the computing circuit, limiting further improvements in area and energy efficiency. To address the above limitation, this work proposes a novel design methodology that combines the lookup-table (LUT) and high-density embedded dynamic RAM (eDRAM) cells. By storing precomputed weight summations in LUTs, the proposed approach reduces the first two stages of the adder tree. Additionally, the row-level parallelism of the CIM architecture is utilized to amortize the overheads of LUT weight encoding and eDRAM refreshing. The 28-nm prototype demonstrates a peak area efficiency of 16.2 TOPS/mm2 and an energy efficiency of 49.5 TOPS/W, both for 8-bit operations. The proposed eDRAM macro achieves a 2.4 and 0.48 Mb/mm2 density in memory and CIM mode, due to its balanced computing-storage ratio, enabling reconfigurability between computing cores and memory storage.},
  keywords={Table lookup;Adders;Random access memory;Common Information Model (computing);Logic;Decoding;In-memory computing;Energy efficiency;Encoding;Arrays;Computing-in-memory (CIM);digital circuit;embedded dynamic RAM (eDRAM);lookup-table (LUT)},
  doi={10.1109/JSSC.2025.3595012},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11128902&isnumber=11457062},
}

@ARTICLE{11096105,
  author={V. Lukito and E. Jongyoon Choi and I. -J. Chang and S. Ha and M. Je},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Spike Sorting SoC With Δ-Based Spike Detection and End-to-End Implementation of Autoencoder Feature Extraction Using Analog CIM},
  year={2026},
  volume={61},
  number={4},
  pages={1710-1721},
  abstract={To process the substantial data generated from on-chip neural recordings, a robust spike sorting (SS) system-on-chip (SoC) with minimal latency is essential to ensure timely response in closed-loop brain–computer interface (BCI) applications. In this article, we report a  $\Delta $ -based SS SoC featuring the first on-chip incorporation of analog computing-in-memory (CIM) end-to-end binary autoencoder neural network (B-AENN) feature extraction to lower computation energy while maintaining high accuracy. The use of  $\Delta $ -spike-signals in this work not only improves the noise resilience of the SS system but also provides a better foundation for feature extraction, leading to enhanced accuracy. The integration of B-AENN enables a more adaptive approach, in comparison to predefined methods, to extract features, especially for closely resembling spikes. Furthermore, by relocating the spike detection and feature extraction processes to the analog domain, our proposed system overcomes the analog-to-digital converter (ADC) conversion bottlenecks in increasingly dense channels. Fabricated using a 65-nm CMOS technology process, the prototype chip facilitates exceptional performance with 5.1- $\mu $ s computational latency, making it ideal for closed-loop, real-time applications and achieving a classification accuracy of 94.54% while consuming  $3.11~{\mu }$ W/ch, representing the highest reported on-chip classification accuracy to date.},
  keywords={Feature extraction;Accuracy;System-on-chip;Neurons;Deep learning;Recording;Power demand;In-memory computing;Autoencoders;Sorting;Autoencoder;binary;brain machine interface (BMI);computing-in-memory (CIM);neural recording;spike sorting (SS)},
  doi={10.1109/JSSC.2025.3589523},
  ISSN={1558-173X},
  month={Apr},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11096105&isnumber=11457062},
}
