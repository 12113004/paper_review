}

@ARTICLE{11370754,
  author={M. Gruber and B. Eversmann and L. Liao and R. Brederlow},
  journal={IEEE Journal of Solid-State Circuits},
  title={A Fully Integrated Bipolar Single-Ended Switched-Capacitor MEMS Driver With Voltage Boost and Energy Recovery},
  year={2026},
  volume={61},
  number={4},
  pages={1333-1341},
  abstract={This work presents a fully integrated switched-capacitor ultrasonic microelectromechanical systems (MEMS) driver. The main capacitive behavior of MEMS, and the high-frequency and high-voltage needed for their actuation, leads to significant reactive power ( $\text {fCV}^{2}$ ), which must not be dissipated. The presented driver is based on a series–parallel charge pump (SP-CP), extending its capabilities to generate positive and negative single-ended output voltages. Equations for output voltage and power consumption of the bipolar SP-CP are introduced, showing limitations by parasitic capacitances mostly present in fully integrated designs. The implemented circuit is able to generate 1.8 Vpp to 41.1 Vpp, 450 kHz waveforms, while achieving a power reduction factor (PRF) of up to 16.3. Compared to conventional unipolar SP-CP, the introduced architecture is shown to almost double the peak-to-peak output voltage and PRF. Due to its better stage utilization, savings of 50% in the number of stages are possible, compared to a unipolar SP-CP.},
  keywords={Capacitors;Voltage;Microelectromechanical systems;Switches;Capacitance;Video recording;Topology;Power demand;Computer architecture;Mathematical models;Energy recovery;fully integrated;micro-electromechanical systems (MEMS) driver;series–parallel charge pump (SP-CP);single-ended bipolar},
