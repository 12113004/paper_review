@ARTICLE{11360287,
  author={S. Kim and others},
  journal={IEEE Journal of Solid-State Circuits},
  title={MAVERIC: A Heterogeneous Robotics SoC With 4 CPU Cores and 13 INT8/FP32 Accelerators in 16-nm-Class Technology},
