@ARTICLE{11535691,
  author={Tang, Minzhe and Xu, Dongfan and Zhang, Yi and Liu, Yuxuan and Li, Zheng and Zhang, Yuncheng and Chen, Yilun and Fan, Minghao and Ren, Ziyuan and Pang, Jian and Xu, Dingxin and Liu, Chenxin and Zhang, Daxu and Li, Duo and Sakai, Hiroyuki and Kunihiro, Kazuaki and Shirane, Atsushi and Okada, Kenichi},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Ka-Band Eight-Stream Phased-Array MIMO Receiver With Time-Hopping Blocker Rejection for 6G}, 
  year={2026},
  volume={61},
  number={9},
  pages={4537-4557},
  abstract={This article presents a Ka-band phased-array multiple-input multiple-output (MIMO) receiver for sixth-generation (6G) wireless networks. A time-division (TD) MIMO architecture is combined with DP antenna array to support eight MIMO streams in the Ka band. The complex weights of each RF element in both polarization arrays are sequentially switched at the Nyquist rate to enable fast-stream switching for MIMO stream coexistence. The TD approach achieves full phased-array reuse and delivers high array gain and spatial selectivity for each stream at the expense of generating switching harmonics. To address this issue, a non-uniform time-hopping (TH) sequence is introduced in this article to spectrally spread the switching harmonics and mitigate the direct blocker folding. A proof-of-concept phased-array receiver is fabricated in 65-nm CMOS, integrating eight RF elements in a 7.2-mm2 core area and consuming 335.2 mW. Combined with DP antennas, the phased-array receiver supports  $4 \times 4$  TD-MIMO across both polarizations and achieves a maximum data rate of 38.4 Gb/s using eight 800-MHz 64-QAM signals in over-the-air (OTA) measurements. Benefiting from the TD-MIMO architecture, the phased-array receiver achieves 0.078 mm2 and 5.23 mW per element per stream. With the proposed non-uniform TH (NUTH) dithering, deep notches are generated at switching harmonics and 42.9-dB alias suppression is achieved. The proposed phased-array receiver also demonstrates a 34-dB improvement in blocker tolerance, maintaining –30-dB EVMrms under a 0-dBc in-band blocker sweeping across –90° to 90° field of view (FoV) in MIMO OTA measurements.},
  keywords={MIMO;Streams;Receivers;Arrays;Ka-band;Radio frequency;Switches;Phased arrays;Distortion;Timing;Blocker-aliasing rejection;dual-polarization;Ka band;multiple-input multiple-output (MIMO);nonuniform time hopping (TH);phased array;sixth generation (6G)},
  doi={10.1109/JSSC.2026.3695546},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11551648,
  author={Ju, Haisu and Zou, Yingtao and Rebeiz, Gabriel M.},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 6.3--18.4 GHz I/Q Receiver With RF and LO Path Reconfigurability for 6G FR3 Applications in 22-nm FD-SOI}, 
  year={2026},
  volume={61},
  number={9},
  pages={4558-4571},
  abstract={This article presents a 6.3–18.4 GHz in-phase and quadrature (I/Q) direct down-conversion receiver featuring reconfigurability in both the radio frequency (RF) and local oscillator (LO) paths. The receiver comprises a multi-band reconfigurable RF front-end, double-balanced passive I/Q mixers, an I/Q LO generation network with a tunable I/Q vector correction circuit, and wideband baseband amplifiers. The integrated reconfigurable RF front end enables optimized performance across different bands. The LO drivers and the polyphase filter (PPF) are co-designed to maximize the overall LO chain voltage gain with low power consumption. Also, the tunable LO I/Q vector correction circuit is implemented at the LO output drivers to minimize I/Q phase error over a wide frequency range while introducing minimal additional voltage loss. Fabricated in 22-nm CMOS fully depleted silicon-on-insulator (FD-SOI) technology, the receiver achieves a measured 3-dB conversion gain (CG) of 20 dB at 6.3–18.4 GHz, a noise figure (NF) of 2.4–5.3 dB, an image-rejection ratio (IRR) exceeding 40 dB, and an input 1-dB compression point (IP1dB) greater than –26 dBm, with an average power consumption of 79 mW. The receiver targets high-data-rate 6G frequency range 3 (FR3) wireless communication applications.},
  keywords={Radio frequency;Frequency;Gain;Receivers;Voltage;Design methodology;Bandwidth;Baseband;Loading;Mixers;6G;frequency range 3 (FR3);low power;low-noise amplifier (LNA);mixer;polyphase filter (PPF);quadrature generation;reconfigurable receiver;wideband},
  doi={10.1109/JSSC.2026.3698025},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11535953,
  author={Yao, Yuan and Tian, Fengshi and He, Jingyu and Ki, Wing-Hung and Tsui, Chi-Ying and Cheng, Kwang-Ting and Liu, Yang},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={Omnidirectional Multi-Transmitter Wireless Power Transfer System With Integrated Coupling Coefficient Sensor}, 
  year={2026},
  volume={61},
  number={9},
  pages={4572-4583},
  abstract={A 6.78-MHz multi-transmitter wireless power transfer (WPT) system that allows relaxed alignment power transfer is proposed. The coupling coefficient ( $k$ ) between each transmitting coil and the receiving coil is analyzed. By using a novel integrated coupling coefficient sensor ( $k$ -sensor), transmitter  $i$ ( $TX_{i}$ ) is selectively activated based on the magnitude of  $k_{i}$ , and the phase of the received current is duly adjusted to avoid current cancellation to increase the system power transfer efficiency ( $\eta _{SYS}$ ). Power control is implemented on an integrated circuit (IC) fabricated using a 0.18- ${\mu }$ m CMOS process with 3.3-V devices. The WPT system consists of one receiver (RX) coil and a  $2~{\times }~2$  transmitter (TX) coil array driven by the proposed IC. Eight RX coil positions were evaluated to assess the performance of the WPT system. Experimental results show that, compared with the multi-TX WPT system without using the  $k$ -sensor, the best improvement occurred when the RX coil was positioned perpendicular to the TX coils, with  $\eta _{SYS}$  increased from 0.3% to 63.7%, and delivered power rose from 3 mW to 2 W. Performance enhancement was observed for most cases.},
  keywords={Coils;Joining processes;Couplings;Transmitters;Current;Image sensors;Solids;Wireless power transfer;Electrons;Circuits;Amplitude and phase adjustment;coupling coefficient sensor;current sensor;efficiency maximization;magnetic resonance coupling;multiple transmitter (TX) coils;near field;wireless power transfer (WPT)},
  doi={10.1109/JSSC.2026.3693573},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11543492,
  author={Wu, Weiping and Bao, Xun and Wang, Jingze and Chen, Shi and Chen, Shulan and Wang, Yan and Zhang, Lei},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={An H-Band Continuous Broadband RF-Domain Quadrature Receiver Using a Harmonic-Enhanced LO Generator in 65-nm CMOS}, 
  year={2026},
  volume={61},
  number={9},
  pages={4584-4599},
  abstract={This article presents an  $H$ -band CMOS receiver chipset that covers a wide frequency range of 228–324 GHz, supporting the entire band of IEEE Std. 802.15.3d. The proposed receiver employs an RF-domain quadrature mixer-first architecture to alleviate the design burden of quadrature local oscillator (LO) signal generation in  $H$ -band, which is beneficial for achieving a large bandwidth. Moreover, a harmonic-enhanced  $\times 12$  frequency multiplier chain (FMC) is used as an LO generator with improved bandwidth, output power ( ${P} _{\textrm {out}}$ ), and harmonic rejection ratio (HRR) to support wideband performance of the receiver. In the FMC, a double-balanced self-mixing (DBSM) tripler is proposed to achieve a superior fundamental rejection ratio, and a dual-mode harmonic-tuning doubler is proposed to enhance the output power of the FMC in  $H$ -band. The receiver and the standalone FMC were fabricated in a 65-nm CMOS technology. Measurement results show that the FMC achieves a peak  ${P} _{\textrm {out}}$  of 4.27 dBm and a 3-dB bandwidth of 218–292 GHz. Besides, the HRR of the FMC is better than 26 dBc from 228 to 310 GHz. Moreover, the proposed receiver demonstrates a wideband performance of 228–324 GHz with a minimum noise figure (NF) of 22.1 dB. The receiver also supports 16-QAM/64-QAM/128-QAM modulation in various channels of IEEE Std. 802.15.3d, and achieves a data rate of 40 Gb/s with 16-QAM modulation in Channel 57.},
  keywords={Receivers;Frequency;Radio frequency;Solids;Mixers;Bandwidth;Joining processes;Power generation;Educational institutions;Generators;CMOS;frequency multiplier;IEEE Std. 802.15.3d;receiver;terahertz (THz);wideband},
  doi={10.1109/JSSC.2026.3697557},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11478559,
  author={He, Zhenbo and Zhang, Ying and Zhu, Yao and Heng, Chun-Huat},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 2.88-pJ/bit 830.7-MHz High-Efficiency OOK Transmitter With Pulse-Driven and Energy-Recycled MEMS Oscillator}, 
  year={2026},
  volume={61},
  number={9},
  pages={4600-4609},
  abstract={This work presents an 830.7-MHz on-off-keying (OOK) transmitter (TX) based on a MEMS oscillator employing pulse-driven and energy-recycling techniques. To improve system efficiency, stacked inverter-based power amplifier (PA) is utilized, while energy-recycling from the top stacked PA is exploited to power the oscillator. An on-chip 2.7:1 transformer is designed to boost the load impedance seen by the PA, thereby maximizing PA efficiency without the need for an external matching network. The proposed TX is fabricated in a TSMC 40-nm CMOS process and occupies a die area of 1.73 mm2. The MEMS oscillator consumes only  $176.5~{\mu }$ W while achieving a phase noise of −118.2 dBc/Hz at a 100-kHz offset. Under continuous operation, the TX supports a data rate of 100 Mb/s, resulting in an energy efficiency of 2.88 pJ/bit at an output power of −15 dBm. By adopting a duty-cycling ratio of 4%, the TX consumes only  $13.8~{\mu }$ W at a data rate of 3 Mb/s, which is at least  $7{\times }$  lower than that of other reported works.},
  keywords={Frequency modulation;Frequency shift keying;Radio broadcasting;Motion pictures;Capacitors;Circuits;Injection-locked oscillators;Integrated circuits;Oscillators;Phase noise;Duty-cycling;energy-recycling;MEMS oscillator;on-off-keying (OOK);power amplifier (PA);transmitter (TX)},
  doi={10.1109/JSSC.2026.3680487},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11458099,
  author={Liu, Yanchao and Wang, Kaihang and Li, Yang and Liu, Yuchen and Yu, Xiaohua and Ni, Ronghua},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={An Ultralow Jitter Fractional-N Sampling PLL With 8× DTC Range Reduction}, 
  year={2026},
  volume={61},
  number={9},
  pages={4610-4623},
  abstract={This work presents an ultralow jitter, high figure-of-merit (FoM) digital-to-time converter (DTC)-based fractional-N sampling phase-locked loop (PLL). DTC range- and delay-reduction techniques are proposed to lower DTC-related phase noise (PN), integral nonlinearity (INL), and power consumption. An input-biasing-based reference-phase-selection (RPS) technique generates two reference phases, enabling a one-bit coarse DTC with negligible PN and INL penalties. A complementary-DTC architecture employing complementary digital control words (DCWs) provides half the delay range (DR) per DTC and achieves zero delay offset. Overall, the proposed sampling PLL (SPLL) achieves an  $8\times $  DTC delay-range reduction and a zero delay offset. In addition, a capacitor-based INL-compensation (CBIC) technique is introduced to further improve the DTC linearity, and a clock-based reference-spur-cancellation technique is proposed to suppress the sampling-phase-detector-induced reference spurs. Fabricated in a 28-nm CMOS process, the 14.4-GHz prototype PLL achieves 28.5- and 35.3-fs rms jitter for integer-N and fractional-N channels, respectively, a −64.6-dBc fractional spur, a −69.1-dBc reference spur, and a −254.6-dB FoM, while consuming 27.9 mW.},
  keywords={Circuits;Oscillators;Circuits and systems;Voltage-controlled oscillators;Feedback;Ring oscillators;Phase noise;Very large scale integration;Capacitors;Filtering;Digital calibration;digital-to-time converter (DTC);DTC range reduction;fractional spur;nonlinearity;reference spur;sampling phase-locked loop (PLL);ultralow jitter},
  doi={10.1109/JSSC.2026.3677286},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11479796,
  author={Shin, Yuhwan and Kim, Juyeop and Lee, Junseok and Jo, Yongwoo and Choi, Jaehyouk},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Low-Jitter Fractional-N Sampling PLL With Voltage-Domain Quantization-Error Cancellation Using a Nonlinearity-Replication Technique}, 
  year={2026},
  volume={61},
  number={9},
  pages={4624-4635},
  abstract={This work presents a low-jitter, low-fractional-spur fractional- $N$  digital sampling phase-locked loop (SPLL) that generates output frequencies from 10.4 to 11.8 GHz. Conventional fractional- $N$  PLLs employ a digital-to-time converter (DTC) to cancel the quantization error (Q-error) of the delta-sigma modulator ( $\Delta \Sigma $ M). To address the nonlinearity (NL) of the DTC, i.e., NLDTC, which degrades the rms jitter and spur performance, previous designs have employed either a digital pre-distortion (DPD) technique that requires significant hardware overhead or a highly linear DTC that inevitably increases design complexity. In contrast, this work presents a replica-NL digital-to-analog converter (RNL-DAC) that intrinsically replicates the NL profile of the sampling phase detector (SPD), thereby naturally canceling the  $\Delta \Sigma $ M Q-error with minimal design resources. This work also presents a complementary voltage comparator (VC) that accommodates a wide range of input voltages, thereby maintaining high sampling gain for low in-band phase-noise (PN). The proposed fractional- $N$  SPLL was fabricated in a 40-nm CMOS process and consumed 15.3 mW while generating an 11.1-GHz output signal from a 150-MHz reference. The measured rms jitter and fractional spur were 76 fs and −65 dBc, respectively, at a fractional- $N$  frequency near 11.1 GHz, demonstrating an excellent jitter-power figure of merit (FoM ${}_{\mathrm {JIT}}$ ) despite its simple architecture.},
  keywords={Feeds;Circuits;Integrated circuits;Oscillators;Voltage-controlled oscillators;Filtering;Phase noise;Circuits and systems;Filters;Capacitors;Digital phase-locked loop (DPLL);fractional spurs;fractional-N;frequency synthesizer;nonlinearity (NL)-replication;quantization error (Q-error);rms jitter;sampling phase-locked loop (SPLL)},
  doi={10.1109/JSSC.2026.3681940},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11494655,
  author={Khalil, Mahmoud A. and Younis, Mohamed Badr and Xia, Ruhao and Abdelrahman, Ahmed E. and Wang, Tianyu and Park, Kyu-Sang and Hanumolu, Pavan Kumar},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 6.8--14-GHz Ring-Based Sampling-PLL Achieving 69.3-fs Jitter Under 50-mV Supply Noise}, 
  year={2026},
  volume={61},
  number={9},
  pages={4636-4648},
  abstract={This article presents a type-III wide-bandwidth ring-oscillator-based analog phase-locked loop (PLL) optimized for low-jitter performance in noisy supply environments. The design uses an 812.5-MHz reference frequency and a high-gain sampling phase detector to achieve a closed-loop bandwidth over 100 MHz, effectively reducing the intrinsic phase noise of the ring oscillator. To improve the voltage-controlled ring oscillator (VCRO) tuning range and supply noise rejection, the PLL includes an additional integrator and an NMOS-based voltage regulator. Fabricated in a 22-nm FinFET process, the proposed integer-N PLL achieves a 13-GHz output with an integrated (10 kHz–100 MHz) jitter of 69.3 fs and supports a continuous tuning range from 6.8 to 14 GHz with an eight-phase output. The supply regulation scheme enhances noise immunity by 31.4 dB, keeping worst case spurious tones below −54 dBc under a 50-mV $\rm _{pp}$  sinusoidal supply ripple, with minimal jitter degradation (69.3 versus 67.5 fs). The combination of a wide tuning range, low jitter, and strong supply noise suppression makes the proposed PLL ideal for high-speed clock generation in serial links over 100 Gb/s.},
  keywords={Circuits;Oscillators;Ring oscillators;Phase noise;Charge pumps;Circuits and systems;CMOS technology;System-on-chip;Capacitors;Filtering;FinFET;high-speed serial links;integer-N phase-locked loop (PLL);low jitter;multi-phase clock generator;sampling phase detector;voltage-controlled ring oscillators;wide bandwidth},
  doi={10.1109/JSSC.2026.3683111},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11460208,
  author={Huo, Runtao and Zhang, Tong and Jie, Weihao and Zheng, Yanling and Li, Deyong and Zhang, Yiwen and Gao, Li and Zhao, Yang and Li, Yongfu and Jiang, Honglan and You, Minmin and Liu, Jingquan and Mercier, Patrick P. and Wang, Hui},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 1.8-to-3.0-GHz Fully Integrated All-in-One CMOS Frequency Management Module Achieving −47-/+42-ppm Inaccuracy From −40 ∘C to 95 ∘C and −150/+70 ppm After Accelerated Aging}, 
  year={2026},
  volume={61},
  number={9},
  pages={4649-4663},
  abstract={This article presents a fully integrated all-in-one CMOS frequency management module (FMM) that features a direct-frequency-synthesis (DFS) architecture by fully integrating an LC-based reference of a temperature- and aging-stable frequency  $f_{\text {LC}} =1024$  MHz and by directly operating the synthesizer at  $f_{\text {LC}}$ . The FMM grants a  $10\times $  wider loop bandwidth for over 20 dB of additional ring-oscillator (RO) noise suppression and supports fast frequency hopping with a settling time below  $7~\mu $ s. Moreover, the FMM exploits the high-frequency sinusoidal reference with direct sampling, eliminating the need for a power-hungry divider and avoiding the division-ratio-squared in-band noise amplification, ultimately achieving an over 3-dB improved FoMJIT. A 1.8-to-3.0-GHz frequency range with a 1-MHz channel step is achieved by employing a phase modulator for fractional-N frequency synthesis. Fabricated in 40-nm CMOS, the FMM consumes 13.5 mW and occupies an active area of 0.28 mm2. The measured 18 FMM samples achieve a worst case frequency inaccuracy of −47/+42 ppm from −40 to  $95~^{\circ } $ C, and after one week of accelerated aging at  $150~^{\circ } $ C, the same samples exhibit −150/+70-ppm inaccuracy. The proposed FMM shows an rms jitter and spur of 932 fs and −53.6 dBc, respectively, with a fast frequency hopping that settles within  $7~\mu $ s, representing a fully integrated FMM with state-of-the-art frequency inaccuracy and excellent frequency-hopping capabilities.},
  keywords={Feeds;Phased arrays;Antennas;Frequency modulation;Radio broadcasting;Circuits;Oscillators;System-on-chip;Circuits and systems;Voltage-controlled oscillators;Aging;direct frequency synthesis;frequency hopping;frequency management module (FMM);LC reference;phase modulation;temperature stabilization;ultra-wide bandwidth},
  doi={10.1109/JSSC.2026.3677418},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11511455,
  author={Mohapatra, Soumen and Afshar, Emad and Zhou, Zhiyuan and Heo, Deukhyoun},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A Low-Jitter, Energy-Efficient 6/12-GHz Phase Interpolator With 0.18 mW/GHz in 65-nm CMOS}, 
  year={2026},
  volume={61},
  number={9},
  pages={4664-4677},
  abstract={This article presents a novel low-power, low-noise phase interpolator (PI) with high resolution designed for diverse applications such as local clock generation in clock data recovery (CDR) to sample time-interleaved analog-to-digital-converter (TI-ADC) and baseband delay beamforming. The proposed PI, implemented in 65-nm CMOS, utilizes a ramp signal with constant slope and swing, whose DC level is dynamically modulated by the input code. This design enables high-speed operation with a power efficiency of 0.18 mW/GHz and reduced noise levels. Integration of a four-stage injection-locked ring oscillator (RO) at the final stage eliminates the need for an input delay-locked loop (DLL), duty-cycle corrector (DCC), and output quadrature generator. This innovative design simultaneously generates a 4-phase output at 6 GHz with an IQ error below 0.9° and a 2-phase output at 12 GHz. The fabricated PI covers the full 360° range while consuming only 2.2 mW and occupying a compact 0.025 mm2. It also achieves an rms jitter of just 68 fs, with differential non-linearity (DNL) and integral non-linearity (INL) measured at 0.9 and 1.9 LSB, respectively.},
  keywords={Phased arrays;Feeds;Circuits;Injection-locked oscillators;Filtering;Oscillators;Capacitors;Filters;Circuits and systems;Phase noise;Baseband time delay;constant slope-and-swing;phase interpolator;pulsewidth modulation;ramp-rate tracking},
  doi={10.1109/JSSC.2026.3686686},
  ISSN={1558-173X},
  month={Sep.},}

@ARTICLE{11488735,
  author={Huo, Runtao and Jie, Weihao and Zhang, Yiwen and Jiang, Honglan and Wang, Hui},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 16-MHz CMOS RC Frequency Reference Achieving Accuracies of ±125 ppm From −40 °C to 85 °C and −560/+580 ppm After Accelerated Aging}, 
  year={2026},
  volume={61},
  number={9},
  pages={4678-4689},
  abstract={This article presents a low-power, high-accuracy CMOS RC frequency reference featuring a capacitively modulated RC time constant (CMT) generation and a die-to-die error removal (DDER) technique for precise frequency generation with a low-calibration cost. Unlike resistive trimming, the temperature dependence of the on-chip resistor is compensated by a  $\Delta \Sigma $ -modulated capacitance in the proposed CMT with a trimming resolution up to 6 ppm while the proposed DDER further eliminates the residual die-to-die error (DDE) due to process spread in high-order batch calibration. Fabricated in a standard 0.18- $\mu $ m CMOS process, the 16-MHz prototype occupies an active area of 0.1 mm2 and consumes  $120~\mu $ W when operating from a 1.8-V supply, achieving an energy efficiency of 7.5 pJ/cycle. Measurement results from 15 samples of the same batch demonstrate that the proposed DDER technique achieves a frequency accuracy improvement exceeding ±100 ppm compared with when DDER disabled, while maintaining an average frequency inaccuracy of ±125 ppm across the  $- 40~^{\circ }$ C to  $85~^{\circ }$ C operating temperature range. When further combining pre-aging with the proposed CMT and DDER techniques, the proposed frequency reference achieves a frequency accuracy of −560/+580 ppm after accelerated aging, while maintaining comparable or better jitter and long-term stability performance among CMOS RC-time-constant-based frequency References.},
  keywords={Circuits;Oscillators;System-on-chip;Circuits and systems;Integrated circuits;Application specific integrated circuits;Capacitors;Phase noise;Very large scale integration;Voltage multipliers;Frequency reference;frequency-locked loop (FLL);high accuracy;low power;pre-aging;RC oscillator;residual error},
  doi={10.1109/JSSC.2026.3684094},
