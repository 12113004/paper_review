  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 3 nm Fin-FET 19.87-Mbit/mm2 2RW Pseudo Dual-Port 6T SRAM With Metal Wire-R Tracking and Sequential Access-Aware Dynamic Power Reduction}, 
  year={2026},
  volume={61},
  number={9},
