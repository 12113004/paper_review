@INPROCEEDINGS{11409279,
  author={Tsai, Rick},
  title={Advancing Horizons for AI: Perspectives on Semiconductor Innovations},
  note={Section: Plenary},
  abstract={AI is redefining the semiconductor landscape. Exponential growth in compute, bandwidth, and power efficiency is driving the proliferation of agentic and physical AI. The paradigm is shifting from performance alone to breakthroughs in scalable and energy-efficient architectures and cross-layer system innovation with close cooperation across silicon, design, heterogeneous- hardware integration, and software. This plenary paper explores the key vectors of advanced packaging, power delivery, thermal management, high-bandwidth memory, interconnects, and wireless communication that will shape intelligent robust AI systems for the decade ahead.},
  keywords={Wireless communication;Technological innovation;Energy consumption;Data centers;Costs;Computational modeling;Integrated circuit interconnections;Packaging;Hardware;Artificial intelligence},
  doi={10.1109/ISSCC49663.2026.11409279},
}

@INPROCEEDINGS{11409084,
  author={Riel, Heike},
  title={1.2 Quantum Computing – Toward Large-Scale Fault-Tolerant Quantum Computing},
  note={Section: Plenary},
  abstract={Quantum computing is advancing rapidly, offering the potential to transform computational paradigms and tackle problems that are intractable for classical systems. Realizing practical quantum systems demands the development of an entirely new computing stack—from qubits and quantum processors to components, wiring and control electronics, transpilers, error handling, software, algorithms, and the compute architecture to integrate quantum and classical resources at scale. This plenary will provide an overview of the current state of quantum computing and outline the milestones on the path toward building a large-scale, fault-tolerant quantum computer by 2029. The significant improvements in hardware, software, and system integration, pushing the performance of quantum computing to reach quantum utility and advance toward quantum advantage, will be presented. Breakthroughs in error correction and a modular approach indicated in the IBM Quantum Roadmap outline a clear path to quantum systems using 200 logical qubits and 100 million quantum operations by 2029 and 2,000 logical qubits a few years later. Furthermore, advances in quantum algorithms, combined with the integration of quantum systems and high-performance computing (HPC), will unlock powerful synergies—accelerating the timeline for applications previously considered to be far in the future.},
  keywords={Wiring;Fault tolerance;Quantum system;Quantum computing;Program processors;Error analysis;Qubit;Fault tolerant systems;Logic gates;Josephson junctions},
  doi={10.1109/ISSCC49663.2026.11409084},
}

@INPROCEEDINGS{11409305,
  author={Devgan, Anirudh},
  title={Powering the AI Supercycle: Design for AI and AI for Design},
  note={Section: Plenary},
  abstract={The AI supercycle is rapidly increasing demand for compute performance and scalability across all levels, from data centers to edge devices. By 2030, the semiconductor total addressable market (TAM) is projected to reach $1.2\ \mathrm{T}$ with electronic systems at $5.2\ \mathrm{T}$. With silicon designs surpassing 200 billion transistors and chiplet-based architectures becoming common, traditional electronic-design-automation (EDA) workflows are insufficient. This plenary discusses how agentic AI can be applied to complex silicon and system design tasks through multi-agent orchestration and iterative reasoning, outlining a framework for its use in EDA solutions, highlighting some of the challenges, and exploring future directions. From optimizing power, performance, and area of silicon to managing data centers, AI-powered solutions are critical for the engineers designing the next generation of AI infrastructure.},
  keywords={Industries;Agentic AI;Data centers;Collaboration;Transforms;Silicon;Transistors;Artificial intelligence;Next generation networking;Standards},
  doi={10.1109/ISSCC49663.2026.11409305},
}

@INPROCEEDINGS{11409140,
  author={Giles, Hope},
  title={Empowering the next Wave of Silicon Engineers},
  note={Section: Plenary},
  abstract={Developing custom chips for specific applications enables fundamentally better products. As part of a full-stack optimization approach to product design, application-specific systems-on-chips (SoCs) have been one of the keys to delivering game-changing performance, power efficiency, capabilities, and user experiences. This plenary provides examples of how custom silicon enables innovative product breakthroughs and how techniques like design modularity help manage the SoC scaling challenge. As applications, such as artificial intelligence (AI), transform both silicon demand and design methodologies, we need to reimagine how we motivate and educate the next generation of silicon engineers to address these challenges. We will share our experiences in interactions between industry, universities, and students, showing how industry engagement can re-energize these programs. The future of custom silicon depends on all of us investing in the next wave of engineers who will create tomorrow's innovative products.},
  keywords={Industries;Technological innovation;Tablet computers;Transforms;Silicon;Trajectory;Transistors;Artificial intelligence;Wearable devices;Next generation networking},
  doi={10.1109/ISSCC49663.2026.11409140},
}

@INPROCEEDINGS{11409030,
  author={Adaikkalavan, Ramasamy and Smith, Alan and Singh, Teja and Rangarajan, Sundar and Chapman, Eric and Naffziger, Samuel and Maiyuran, Subramaniam and Chen, Candy and Sundaram, Sriram and Silla, Mark and Law, Duncan and Hoover, Kathy and Lipson, Samuel and Duda, Kevin and Parthasarathy, Vinay and John, Deepesh and Vemulapalli, Hanish and Gade, Srinivas Pavan Kumar},
  title={2.1 AMD Instinct MI350 Series GPUs: CDNA 4-Based 3D-Stacked 3nm XCDs and 6nm IODs for AI Applications},
  note={Section: Processors},
  abstract={The AMD Instinct MI350 Series GPU, based on a $4^{\text {th }}$-generation AMD CDNA architecture, features eight stacked accelerator complex dies (XCD), two I/O dies (IOD) interconnected with AMD Infinity Fabric, and interfaces for eight stacks of 12-hi HBM3E memory. The MI350 Series GPU delivers over $3 \times$ generational inference performance increase by improving energy efficiency, increasing compute throughput, supporting new lower-precision FP6/FP4 datatypes, and increasing both memory bandwidth and capacity.},
  keywords={Memory management;Graphics processing units;Integrated circuit interconnections;Bandwidth;Throughput;Fabrics;Energy efficiency;Solid state circuits;Artificial intelligence},
  doi={10.1109/ISSCC49663.2026.11409030},
}

@INPROCEEDINGS{11409003,
  author={Yu, Chang-Hyo and Bae, Jaewan and Kim, Jinseok and Kim, Hongyun and Shin, Wongyu and Yoon, Jae-Sung and Jin, Young-Jae and Oh, Jungju and Lee, Jaebong and Kim, Eunseo and Chi, Miock and Choi, Sungpill and Kim, Donghan and Jo, Hyunje and Kim, Hyunho and Heo, Hyungseok and Kim, Hyunsung and Kim, Seung-Goo and Choi, Myunghoon and Je, Sangeun and Ham, Junhee and Yoon, Juyeong and Arthanto, Yashael Faith and Bae, Sung-il and Park, Sanggyu and Lee, Joungwoo and Chae, Heeyoung and Ryu, Kiljun and Kim, Yongjik and Seo, Jin-O and Cho, Nara and Jeon, Taeyoung and Ahn, Gukchae and Ki, Myoungoh and Choi, Junkyeong and Baek, Seungcheol and Kim, Daehoon and Kim, JuHwan and Kang, Sungmoon and Son, Sieon and Kim, Minseo and Choe, Yeounghwan and Lee, Younggeun and Park, Sunghyun and Oh, Jinwook},
  title={A Quad-Chiplet AI SoC with Full-Chip Scalable Mesh Over 16Gb/s UCIe-Advanced Die-to-Die Interface for Large-Scale AI Inferencing},
  note={Section: Processors},
  abstract={A 4nm-based quad-chiplet with an advanced packaged LLM accelerator achieving 56.8TPS on LLaMA v3.3 70B with single-batch 2k/2k input/output sequences. The architecture combines chiplet-based design, low-latency die-to-die interfaces, unified mixed-precision compute, holistic synchronization, and HBM3E with advanced power schemes to sustain bandwidth, capacity and thermal stability. The SoC integrates four NPU chiplets, four HBM3E modules, and four ISCs for stable power delivery.},
  keywords={Chiplets;Computer architecture;Bandwidth;Power system stability;Solid state circuits;Circuit stability;Synchronization;Artificial intelligence;Low latency communication;Thermal stability},
  doi={10.1109/ISSCC49663.2026.11409003},
}

@INPROCEEDINGS{11409158,
  author={Jung, Jueun and Lee, Sangho and Yoo, Junghyun and Yun, Ghangmin and Lee, Kyuho Jason},
  title={2.3 A 71.3mJ/Frame End-to-End Driving Processor with Flexible Heterogeneous Core Orchestration via Sparsity Reasoning},
  note={Section: Processors},
  abstract={A multi-modal end-to-end driving processor is proposed with 4 features: 1) a sparsity reasoning unit to maximize sparsity exploitation, 2) a flexible sparse-dense heterogeneous architecture with a sparsity-aware adaptive core orchestrator to maximize core utilization, 3) an energy-efficient segmented aggregation network, and 4) a long-/short-term memory unit to minimize external memory access (EMA) of temporal attention. It achieves 10.3fps at 71.3 mJ/frame, consuming 218× less energy than a state-of-the-art driving SoC.},
  keywords={Adaptive systems;Cognition;Energy efficiency;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409158},
}

@INPROCEEDINGS{11409283,
  author={Yun, Sangbu and Lee, Chanhee and Kwon, Soonhyun and Chang, Jeongtaek and Zhang, Zhengya and Lee, Youngjoo},
  title={UniC-Vision: A 14.4Gb/s 7.3pJ/b Universal Vision Transformer OFDM Channel Estimation Accelerator for B5G/6G AI-RAN},
  note={Section: Processors},
  abstract={This work presents an AI-RAN channel estimation accelerator for next-generation communications, offering hyper reliability, low latency, and universal frequency range coverage, thereby meeting B5G/6G requirements. Utilizing algorithm-hardware co- optimization and architecture optimizations, the prototype achieves a throughput of 14.4 Gb/s at 7.3 pJ/b in 28 nm CMOS, surpassing the state-of-the-art channel estimation systems by 7.7 to 18.9 dB in reliability and 16 -to- $39 \times$ in throughput.},
  keywords={OFDM;Channel estimation;Prototypes;Throughput;Transformers;Solid state circuits;Low latency communication;Integrated circuit reliability;Optimization;Next generation networking},
  doi={10.1109/ISSCC49663.2026.11409283},
}

@INPROCEEDINGS{11409261,
  author={Lu, Cheng-Hsun and Tang, Wei and Kim, Jaehee and Lee, Youngjoo and Zhang, Zhengya},
  title={2.5 A 1.1mm2, 14.4ns, 13.1pJ/b Forward Error Correction with Ordered-Statistics Post Processing for Ultra-Reliable and Low-Latency Communications},
  note={Section: Processors},
  abstract={We present a two-stage FEC decoder that combines soft-decision Chase decoding with order-1 ordered statistics decoding, offering robust error correction for URLLC. A 1.1 mm2, 16 nm decoder prototype with optimized Gaussian elimination and early exits achieves an average latency of 14.4 ns and a worst-case latency of 132.6 ns, improving upon prior work by $53 \times$ and five orders of magnitude, respectively. The prototype delivers 15.2 Gbps at 13.1 pJ/b, outperforming state-of-the-art URLLC FEC decoders.},
  keywords={Prototypes;Forward error correction;Ultra reliable low latency communication;Decoding;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409261},
}

@INPROCEEDINGS{11409090,
  author={Cohen, Matthew and Kar, Monodeep and Venkataramani, Swagath and Srinivasan, Viji and Veraa, Brian and Ziegler, Matthew and Cao, Nianzheng and Ranjan, Ashish and Silberman, Joel and Guillorn, Michael and Woodward, Sandra and Lancaster, JohnDavid and Hursey, Josh and Kim, Kyu-Hyoun and Mannari, Alberto and Nagarajan, Amrit and Samajdar, Ananda and Hekmatshoartabari, Bahman and Galbraith, Bob and Zhou, Ching and Satterfield, Dave and Still, Greg and Tellez, Gustavo and Nair, Indira and Masilamanai, Indu and Jung, Jinwook and Randhawa, Kavi and Schaal, Marcel and Lutz, Martin and Crumley, Paul and Jacob, Philip and Chatarasi, Prasanth and Jain, Radhika and Lee, Saekyu and Sen, Sanchari and Krithivasan, Sarada and Rider, Scot and Jain, Shubham and Koswatta, Siyu and Roewer, Thomas and Gooding, Tom and Ferrari, Victor and Zalani, Vidhi and Ren, Zhibin and Reick, Kevin and Maurice, Lisa and Gonzalez, Chris and Catalino, Chris and Nett, Ryan and Lu, Pong-Fei and Senger, Rob and Chang, Leland},
  title={Spyre: An Inference-Optimized Scalable AI Accelerator for Enterprise Workloads},
  note={Section: Processors},
  abstract={Spyre is a scalable, power-efficient AI accelerator product for enterprise workloads. Featuring 32 AI cores, mixed-precision support, and LPDDR5 memory, it fits in a singleslot PCIe form factor and scales over a standard PCIE fabric. Optimized for inference workloads, Spyre achieves 2-to-3× better power/performance than GPUs on encoder-class models and scales up to 4 or more devices for large generative models.},
  keywords={AI accelerators;Fabrics;Solid state circuits;Integrated circuit modeling;Standards},
  doi={10.1109/ISSCC49663.2026.11409090},
}

@INPROCEEDINGS{11409204,
  author={Lu, Po-Yen and Chen, Po-Wei and Yeh, Shau-Hua and Zhang, Zhi-Jun and Chen, Yong-Tai and Wang, Ting-Yu and Huang, Chao-Tsung},
  title={Tiamat: A 98-to-134ms/Step Transformer-Based Diffusion Model Processor Supporting Classifier-Free Guidance for Image Generation},
  note={Section: Processors},
  abstract={A $16 n m$ FinFET transformer-based diffusion model processor chip is fabricated for supporting class-conditional DiT-XL/2 and text-to-image PixArt-a with 98 ms and 134 ms generation time per step with 7.37TOPS and 1477 mW at 400 MHz. Classifier-free guidance batching reduces external memory access (EMA) for weights by 50%, and weight-reordered quantization brings another 37% reduction. Hybrid microscaling blocking reduces featuremap buffer size by 37%, while approaching floating-point quality.},
  keywords={Quantization (signal);Image synthesis;Text to image;Transformers;Diffusion models;FinFETs;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409204},
}

@INPROCEEDINGS{11409294,
  author={Hsieh, Shih-Wei and Chen, Yi-Syuan and Tsai, Ping-Yuan and Lin, Ming-Hung and Cheng, Chia-Yuan and Hsu, Lien-Feng and Huang, Po-Hao and Chih, Hung-Wei and Chiang, Po-Han and Chang, Chia-Ming and Chiang, Ming-Hsuan and Yuan, Chia-Hung and Kuo, Sheng-Po and Uggu, Viswanath and Chan, Chun-Kun and Shih, Ming-En David and Tseng, Yu-Cheng and Cheng, Hsin-Ping and Huang, Stan and Chen, Chia-Ping and Chang, ShenKai and Wang, Chih-Ming and Yeh, Po-Yu and Liu, Jett and Chang, Yung-Chang and Ju, Chi-Cheng and Jou, Yucheun Kevin},
  title={MADiC: A 3nm 7.4TOPS/mm2, 17.4TOPS/W Generative Diffusion Accelerator Enabled by Hardware-Compiler Co-Optimization of Memory Hierarchy and Operator Parallelism},
  note={Section: Processors},
  abstract={This work presents MADiC, a 3nm 0.338mm2 diffusion accelerator for generative image editing on edge devices. MADiC features design-time L1/L2 memory optimization, cross-loop feature map allocation with write-over-read relaxation, and activation-aware input preloading with concurrent resizing. Operating at 0.575V and 546MHz, it delivers 7.4TOPS/mm2 and 17.4TOPS/W when running the Diffusion ConvNet model.},
  keywords={Image edge detection;Parallel processing;Solid state circuits;Resource management;Integrated circuit modeling;Optimization},
  doi={10.1109/ISSCC49663.2026.11409294},
}

@INPROCEEDINGS{11409230,
  author={Yang, Xiaolong and Wang, Yang and Xu, Wende and Qin, Yubin and Wang, Huanyu and Guo, Ruiqi and Yue, Zhiheng and Gu, Jiangyuan and Wei, Shaojun and Hu, Yang and Yin, Shouyi},
  title={2.9 A 0.24mJ/Frame Quadratic Interpolation 4DGS Processor with Recursive Computation Reuse and Tree-Based Parallel-Rendering},
  note={Section: Processors},
  abstract={4D Gaussian Splatting (4DGS) has widespread applications in fields such as VR, AR and industrial simulation. However, 4DGS suffers from significant memory requirements, redundant computations and low PE utilization. This paper introduces adaptive quadratic interpolation, recursive computation reuse and tree-based parallel rendering to tackle these challenges. The processor in the paper achieves a rendering energy of $0.24 ~\text{mJ} /$ frame and improves energy efficiency by $6.11 \times$ on the D-Nerf dataset.},
  keywords={Interpolation;Memory management;Rendering (computer graphics);Energy efficiency;Solid state circuits;Computational efficiency},
  doi={10.1109/ISSCC49663.2026.11409230},
}

@INPROCEEDINGS{11409198,
  author={Wang, Hedi and Feng, Xiaoyu and Gao, Weichen and Yang, Huazhong and Liu, Yongpan},
  title={2.10 A 1286fps 0.39mJ/Frame Modeling/Rendering Unified 3D GS Processor with Locality-Optimized Computation and Reconfigurable Architecture},
  note={Section: Processors},
  abstract={A modeling/rendering unified 3D GS processor is proposed with: 1) A locality-aware dynamic fine-grained rendering engine for reduced redundant computation. 2) A locality-optimized unified rendering workflow to reduce EMA. 3) A unified reconfigurable architecture for neural modeling and Gaussian rendering with minimal area overhead. It achieves $3.4 \times$ higher rendering throughput and 74.1% lower energy per frame than SOTA 3D GS accelerators, and an orders-of-magnitude reduction in modeling latency.},
  keywords={Solid modeling;Three-dimensional displays;Computational modeling;Rendering (computer graphics);Throughput;Reconfigurable architectures;Solid state circuits;Integrated circuit modeling;Engines},
  doi={10.1109/ISSCC49663.2026.11409198},
}

@INPROCEEDINGS{11409179,
  author={Chang, Min-Hua and Chou, Lin and Liu, Yen-Jen and Hsu, Chen-Hsing and Yang, Ying-Yu and Juan, Bo-Cheng and Lin, Guan-Yu and Lin, Yi-Jie and Huang, Yao-Wei and Kumar, Nitish and Lin, Shu-Ping and Liao, Yu-Te},
  title={3.1 A Multimodal Biosensing System-on-Chip with Integrated Wireless Transceiver and Power Management for Stress Monitoring},
  note={Section: Wearable and Wireless Biomedical Systems},
  abstract={A highly integrated SoC incorporates ECG, PPG, GSR, and ECH biosignal acquisition interface circuits with a $920 \text{MHz}, 2 ~\text{kb} / \mathrm{s}, 1.1 \mu ~\mathrm{W} \text{WuRx}$, a $2.4 \text{GHz}, 1 \text{Mb} / \mathrm{s} \text{Tx}$, and a PMU with $<5 \mu ~\mathrm{s}$ recovery time under $600 \mu ~\mathrm{A}$-to-50 mA load steps in $0.18 \mu ~\mathrm{m}$ CMOS. A shared ECG/ECH AFE reaches $0.32 \mu ~\mathrm{V}_{\text {rms }}$ IRN and 130dB CMRR. The PPG circuits attain a 113.9dB DR using a precharge scheme, while the GSR AFE achieves a 99dB DR with $3.1 \text{pA}_{\text{rms}}$ IRN. The biosensing interface consumes only $125.8 \mu ~\mathrm{W}$.},
  keywords={Wireless communication;Power system management;Circuits;Transceivers;Phasor measurement units;System-on-chip;Solid state circuits;Biosensors;Stress;Monitoring},
  doi={10.1109/ISSCC49663.2026.11409179},
}

@INPROCEEDINGS{11409080,
  author={Han, Yiming and Kumar, Neelotpala and Zhao, Linran and Yinka Adebiyi, Jide and Jiang, Linrui and Lu, Hao and Perkins, Gina and Tanaka, Hirofumi and Akinwande, Deji and Jia, Yaoyao},
  title={3.2 A Near-Field RF Reflection Transceiver ASIC for Continuous Unobtrusive Blood Pressure Monitoring},
  note={Section: Wearable and Wireless Biomedical Systems},
  abstract={This work presents continuous, unobtrusive, and clinically accurate BP monitoring in a fully wearable form factor using an near-field RF reflection TRx ASIC in 65 nm CMOS. The NRR approach enables noncontact monitoring with comfort and long-term wear. The optimized TRx achieves 98.6 nVRMS IRN, while SAR-based DC-offset cancellation and closed-loop phase calibration mitigate Rx leakage and phase error for clinical accuracy. The ASIC is thoroughly validated in human studies achieving accurate BP extraction within 6mmHg mean absolute error.},
  keywords={Radio frequency;Accuracy;Reflection;Transceivers;Blood pressure;Solid state circuits;Calibration;Biomedical monitoring;Monitoring},
  doi={10.1109/ISSCC49663.2026.11409080},
}

@INPROCEEDINGS{11409217,
  author={Li, Xiayang and Peng, Wenyu and Kumar, Limitha and Zhao, Xiaoxi and Huang, Cheng and Du, Sijun},
  title={A Battery-Powered Hybrid Resonant Pulse-Train Generator with Adaptive Frequency Tracking and Residual Energy Recycling for Ultrasonic Implants},
  note={Section: Wearable and Wireless Biomedical Systems},
  abstract={This work presents a battery-powered hybrid resonant pulse-train generator for ultrasonic wireless power transfer (US-WPT) in implantable medical devices. The ASIC integrates adaptive resonance tracking, burst-mode power regulation, a switched-capacitor–resonant architecture, and residual energy harvesting. Fabricated in $0.18 \mu \mathrm{m}$ BCD, it achieves programmable US power, $68.6 \% \mathrm{C}_{\mathrm{p}}$-loss reduction, and 21.7% end-to-end efficiency.},
  keywords={Resonant frequency;Wireless power transfer;Switches;Hybrid power systems;Generators;Acoustics;Resonance;Regulation;Solid state circuits;Recycling},
  doi={10.1109/ISSCC49663.2026.11409217},
}

@INPROCEEDINGS{11409335,
  author={Gourdouparis, Marios and Shi, Chengyao and Liu, Jiang and He, Yuming and Stanzione, Stefano and Serdijn, Wouter and Liu, Yao-Hong},
  title={3.4 an Ultrasound-Powering TX with Standing-Wave Peak Tracking Employing Adiabatic Power Sensing Achieving 82% Power-Tracking Accuracy and <90ms Settling Time for Brain Implants},
  note={Section: Wearable and Wireless Biomedical Systems},
  abstract={An ultrasound powering TX ASIC for brain implants with autonomous on-chip standingwave peak tracking for RX power (PDL) regulation is presented. With a proposed adiabatic power-sensing scheme, the TX consumes $43 \mu \mathrm{W}$ for power tracking, and the system achieves a settling time of <90ms while using the standing-wave peak-tracking FSM. The TX can achieve PDL improvement of up to $2.7\times$ with a power-tracking accuracy of 82%.},
  keywords={Ultrasonic imaging;Accuracy;Neural implants;Regulation;System-on-chip;Solid state circuits;Sensors},
  doi={10.1109/ISSCC49663.2026.11409335},
}

@INPROCEEDINGS{11409287,
  author={Lu, Tianqi and Du, Sijun},
  title={A Simultaneous Wireless Power and Full-Duplex Data Transfer System Over a Single Inductive Link Achieving 17/3.4Mb/s and 61.1% Efficiency for Miniature Biomedical Implants},
  note={Section: Wearable and Wireless Biomedical Systems},
  abstract={A single-link wireless power and full-duplex data transfer system is presented. Operating at 40.68MHz, it delivers >50mW maximum output power with 61.1% peak end-to-end efficiency while supporting 17Mb/s uplink using resonance-length keying (RLK) and 3.4Mb/s downlink using instant-carrier-suspension keying (Instant-CSK). The design removes ASK/LSK trade-offs and achieves an aggregate data rate of half the carrier frequency using 180nm TX/RX chips and 15-/8-mm-diameter coils.},
  keywords={Wireless communication;Resonant frequency;Full-duplex system;Implants;Data aggregation;Data transfer;Downlink;Solid state circuits;Uplink;Power generation},
  doi={10.1109/ISSCC49663.2026.11409287},
}

@INPROCEEDINGS{11409189,
  author={Zhou, Kaiwen and Tang, Yuxiang and Shen, Zhongqiu and Yang, Xuecheng and Qu, Tianxiang and Wang, Yiming and Ye, Shen and Hong, Zhiliang and Xu, Jiawei},
  title={4.1 A 0.64mA, -108.2dB THD+N Class-D Amplifier with Neural-Assisted Pre-Reconfiguration for Smart Power Optimization},
  note={Section: Analog Techniques & Amplifiers},
  abstract={This work presents a high-precision, power-efficient Class-D audio amplifier (CDA) that addresses switching losses and reconfiguration-induced nonlinearity through neural-network-assisted pre-reconfiguration. Consequently, this CDA achieves the lowest THD+N of −108.2 dB and a very high $\text{FoM}_{\text{THD+N }}$ of 3747, corresponding to a 48% improvement over the state-of-the-art in the accompanying comparison table. This CDA also attains an ultralow quiescent current of 0.64 mA and highest efficiency of 66% at 10 mW.},
  keywords={Switching loss;Solid state circuits;Optimization},
  doi={10.1109/ISSCC49663.2026.11409189},
}

@INPROCEEDINGS{11409038,
  author={Zhang, Miao and Zhang, Huajun and Lombardo, Domenico Maria and Fan, Qinwen},
  title={A -102.2dB THD+N, 92% Efficiency, 1.08mW Idle Power Digital-Input Class-D Amplifier with Power-Adaptive Techniques and Dual-Edge Pulse-Width Adjustment Modulator},
  note={Section: Analog Techniques & Amplifiers},
  abstract={This paper presents a digital-input Class-D headphone amplifier that achieves low noise and low idle power simultaneously. Three key techniques enable this: a power-adaptive 3 -level IDAC that scales power with signal level, an assistant IDAC that relaxes the first integrator's power consumption, and a dual-edge PWA modulator that minimizes loop filter swing. Fabricated in $0.18 \mu \mathrm{m}$ CMOS, it achieves 117.8 dB DR, -102.2 dB THD+N, 0.6 mA idle current, and 92% peak efficiency when driving a 16Ω load.},
  keywords={Headphones;Power demand;Noise;Modulation;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409038},
}

@INPROCEEDINGS{11409310,
  author={Li, Haihua and Shi, Dan and Zhou, Qi and Martins, Rui and Mak, Pui-In and Lei, Ka-Meng},
  title={A 0.6V 9.4µW 1,892µm2 Current-Pulse-Injection Crystal Oscillator Featuring Capacitively Biased Amplifier with 242.2dBc/Hz PN FoM @1KHz Offset},
  note={Section: Analog Techniques & Amplifiers},
  abstract={We report a current-pulse injection-based Crystal Oscillator (XO). A capacitively biased amplifier, powered by the stacked capacitor power supply (SCPS), delivers a short boosted current pulse into the crystal to limit the amplifier's shoot-through current while upholding the XO's phase noise. Fabricated in 65nm CMOS, the XO core occupies $1,892 \mu \mathrm{m}^{2}$. The 16MHz XO consumes $9.4 \mu \mathrm{W}$ at $0.6 \mathrm{V} V_{D \mathrm{D}}$, associated with a phase noise of $-137.9 \text{dBc} / \text{Hz}$ @ 1kHz offset, corresponding to a superior FoM of 242.2 dBc/Hz.},
  keywords={Phase noise;Power supplies;Capacitors;Crystals;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409310},
}

@INPROCEEDINGS{11409089,
  author={Tang, Zhong and Pan, Sining and Yu, Xiaopeng and Tan, Nick Nianxiong and Zhu, Zhangming},
  title={4.4 A 2.1-to-3.7ppm/°C Bandgap Voltage Reference with a Current-Domain TC Compensation and ±0.06% Inaccuracy from −40°C to 125°C in 130nm CMOS},
  note={Section: Analog Techniques & Amplifiers},
  abstract={This paper presents a CMOS bandgap reference (BGR) with a current-domain high-order TC compensation by using a capacitively-biased-diode-based super-PTAT current bias. It achieves a TC of 2.1 to 7.1ppm/°C from −40 to 125°C after a batch trim, which is on par with state-of-the-art BGRs with a 1-point trim. After a 2-point trim, it achieves a TC that ranges from 2.1 to 3.7ppm/°C and an inaccuracy of $\pm 0.06 \%(3 \sigma)$ from −40 to 125°C. Its simple architecture also results in $2 \times$ higher energy efficiency.},
  keywords={Photonic band gap;Voltage;Energy efficiency;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409089},
}

@INPROCEEDINGS{11409143,
  author={Rui, Jiaqing and Lyu, Liangjian and Wan, Yuting and Shan, Kexin and Gu, Wenxian and Shi, C.-J. Richard and Wu, Xing},
  title={A 1ppm/°C and ±0.066% 3σ Accuracy Bandgap Reference with Temperature-Adaptive PTAT Scaling},
  note={Section: Analog Techniques & Amplifiers},
  abstract={This paper presents a process-independent, curvature-compensated bandgap reference. By introducing a temperature-adaptive duty-cycled resistor to scale the PTAT voltage, the design effectively compensates for CTAT nonlinearity without introducing offset errors. Fabricated in $0.18 \mu \mathrm{m}$ CMOS, the prototype chip occupies $0.068 \text{mm}^{2}$ and consumes $15 \mu \mathrm{A}$. After two-point trimming, it achieves an average temperature coefficient of $1 \text{ppm} /{ }^{\circ} \mathrm{C}$ and a 3 o output accuracy within $\pm 0.066 {\%}$.},
  keywords={Resistors;Accuracy;Photonic band gap;Prototypes;Voltage;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409143},
}

@INPROCEEDINGS{11409327,
  author={Fang, Lele and Zhu, Yan and Martins, Rui P. and Chan, Chi-Hang},
  title={An Integrated Voltage and Current Reference Together Achieving 5.7 and 9.1ppm/°C from −40 to 125°C},
  note={Section: Analog Techniques & Amplifiers},
  abstract={This work implements an integrated voltage and current reference circuit, which has low temperature drift. By ensuring the reuse of the main circuit, we propose a current-mirror-based seamless transition technique, which can be used to achieve sub-ranging compensation. Eventually, this work realizes 3rd-order compensation in two domains simultaneously, resulting in temperature coefficients of 5.7ppm/°C and 9.1ppm/°C for voltage and current references, respectively.},
  keywords={Voltage;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409327},
}

@INPROCEEDINGS{11409290,
  author={Yuasa, Keito and Takahashi, Yuya and Watanabe, Shunya and Kato, Sena and Ema, So and Hattori, Genma and Naka, Atsushiro and Morioka, Sumio and Inagawa, Takahiro and Murata, Kentaro and Honma, Naoki and Mayeda, Jill and Shirane, Atsushi},
  title={5.1 A Formation Flight Phased-Array Transceiver for Spatial Power Combining and Distributing Architectures in Direct-to-Device-Communication Satellite Constellations},
  note={Section: Sub-THz and mm-Wave Phased Arrays and Beamformers},
  abstract={Conventional satellites are costly and unreliable. We propose a pico-satellite formation as a virtual phased array to reduce costs and improve reliability. A low-power FDD transceiver wirelessly receives an LO signal from a gateway, eliminating power-hungry PLLs. Precise beamforming is achieved by calibrating path differences and using SRFA technology. This work enables future low-cost, highly reliable satellite communications.},
  keywords={Phased arrays;Satellite constellations;Satellites;Costs;Logic gates;Transceivers;Solid state circuits;Phase locked loops;Integrated circuit reliability;Satellite communications},
  doi={10.1109/ISSCC49663.2026.11409290},
}

@INPROCEEDINGS{11409268,
  author={Zhou, Qiang and Su, Yumin and Guo, Hao and Hu, Yaolong and Yang, Kaiyuan and Chi, Taiyun},
  title={5.2 A 28GHz Frequency-Diverse Sub-Array TX with Secret Phase Keys and Antenna Subset Modulation for Eavesdropping-Resilient Wireless Communication},
  note={Section: Sub-THz and mm-Wave Phased Arrays and Beamformers},
  abstract={Prior works on physical-layer eavesdropping protection only addressed off-axis Eve. This paper presents the first TX to defend against both main-beam and off-axis Eves. Incorporating three key components: frequency-diverse sub-arrays, secret phase keys, and antenna subset modulation, the 28 GHz TX demonstrates highly scrambled constellations for all Eves, while the legitimate RX's reception remains intact ($\sim 6 \% \text{EVM}_{\text {rms }}$), with only 2% DC power overhead compared to a standard phased-array TX.},
  keywords={Wireless communication;Frequency modulation;Phase modulation;Solid state circuits;Protection;Antenna accessories;Standards;Eavesdropping},
  doi={10.1109/ISSCC49663.2026.11409268},
}

@INPROCEEDINGS{11409017,
  author={Allam, Muhamed Fouad and Fang, Wenkai and Shao, Zijian and Saeidi, Hooman and Stepko, Alexander and Sengupta, Kaushik},
  title={5.3 SPARTA: A Scalable, Programmable and Active mm-Wave Dual-Surface Reflect/Transmit Array with Integrated Gain and Phase Control Allowing Bidirectional Signal Routing Capability for Robust and Reconfigurable mm-Wave Networks at 60GHz},
  note={Section: Sub-THz and mm-Wave Phased Arrays and Beamformers},
  abstract={We present SPARTA, the first dual-surface mm-wave active surface enabling RF signal processing (gain and beamforming) on both sides with multiple transmit and reflect configurations, including simultaneous reception and multi-beam re-transmission in either direction across seven modes. The surface integrates 46 flip-chip bonded custom designed CMOS RFICs (23 per side) operating at 60 GHz on a 14-layer laminate and demonstrates NLOS wireless link closure in both reflect and transmit modes.},
  keywords={Wireless communication;Phased arrays;RF signals;Phase control;Routing;Radiofrequency integrated circuits;Solid state circuits;Laminates;Flip-chip devices;Surface treatment},
  doi={10.1109/ISSCC49663.2026.11409017},
}

@INPROCEEDINGS{11408978,
  author={Yang, Jiawei and Shen, Yizhu and Xu, Shizhe and Zhang, Zhongyuan and Lin, Zhen and Ding, Yifan and Qian, Yun and Wan, Jiapeng and Cai, Yuancheng and Zhu, Min and Hu, Sanming},
  title={5.4 A 140GHz Full-Duplex CMOS Transceiver with Metasurface-Integrated Self-Interference-Cancelling Antenna Supporting 16Gb/s 16-QAM Dual-Mode Bidirectional Communication},
  note={Section: Sub-THz and mm-Wave Phased Arrays and Beamformers},
  abstract={This paper presents a 140GHz CMOS transceiver for both full-duplex and frequency-division duplex communication. By proposing self-interference (SI)-cancelling antenna and dual-polarized metasurface, the design achieves measured EIRP of 26.8dBm and SI suppression of $>49 \text{dB}$, therefore providing enough SINR for transceivers. A $16 \text{Gb} / \mathrm{s}$ 16QAM simultaneous bidirectional communication over 1m is demonstrated, achieving the highest data rate reported for full-duplex dual-mode transceivers in the Figure 5.4.6 comparison table.},
  keywords={Antenna measurements;Interference cancellation;Full-duplex system;Bidirectional control;Metasurfaces;Transceivers;Solid state circuits;Antennas;Signal to noise ratio},
  doi={10.1109/ISSCC49663.2026.11408978},
}

@INPROCEEDINGS{11409260,
  author={Garimella, Lakshminarasimha Sastry and Davidson, Alfred and Patil, Nishant and Ma, Yuan and Junaid, Ammaar and Pabba, Kaustubh and Krishnaswamy, Harish},
  title={Full-Duplex RF Canceler Achieving Wideband High-SI-Power Low-Noise Cancellation Through a Novel N-Path-Filter-Based Architecture and ML-Based Canceler Configuration},
  note={Section: Exploratory Receiver Architectures from GHz to THz},
  abstract={We present a novel RF canceller that utilizes (i) a novel N-path-filter-based architecture that uses filter stacking to achieve passive tap combining leading to a lower NF degradation, (ii) a sub-cycle rotation technique that doubles the largest frequency shift possible in a rotary clock-path passive-frequency-shifting technique enabling wideband SIC, and (iii) an ML-based canceler configuration algorithm that requires only a limited number of canceller measurements.},
  keywords={Radio frequency;Interference cancellation;Stacking;Full-duplex system;Filtering algorithms;Frequency measurement;Solid state circuits;Noise measurement;Wideband;Rotation measurement},
  doi={10.1109/ISSCC49663.2026.11409260},
}

@INPROCEEDINGS{11409248,
  author={Zhong, Liwen and Tian, Meijun and Lee, Wooram},
  title={6.2 A Phased-Array-Inspired Broadband RF Signal Processor for 2-to-32GHz Spectrum Sensing},
  note={Section: Exploratory Receiver Architectures from GHz to THz},
  abstract={This paper presents a phased-array-inspired RF signal processor for ultra-broadband spectrum sensing. The proposed architecture exploits the bandpass response resulting from the constructive and destructive interference of a programmable dispersion-engineered array, implemented with broadband true-time delay lines and programmable phase shifters. The proposed design is fabricated in a 22 nm FDX process, achieving a measured scanning range of 2 to 32 GHz with a power consumption of 101 mW.},
  keywords={Phased arrays;Power measurement;Power demand;RF signals;Phase shifters;Interference;Delay lines;Sensors;Broadband communication;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409248},
}

@INPROCEEDINGS{11408989,
  author={Wittenhagen, Enne and Wilding, Dominik and Artz, Patrick and Linnhoff, Sebastian and Scholz, Philipp and Gerfers, Friedel},
  title={A 2×2 10GS/s TTD BF Receiver Utilizing Charge-Based Summation with 10.5GHz Bandwidth and SNDR/SFDR with 49.5dB/57.5dBc in 22nm CMOS},
  note={Section: Exploratory Receiver Architectures from GHz to THz},
  abstract={This work presents an ultra-compact $10 \text{GS} / \mathrm{s}$ sampled beamforming (BF) receiver front-end (FE) for a $2 \times 2$ antenna array, enabling both azimuth and elevation steering in 22 nm FDSOI CMOS. The $4 \times$ time-interleaved FE features a 200 ps range/14.3ps LSB true-time-delay employing a TaH-based BF with passive charge-based summation with 10.5 GHz signal bandwidth, eliminating power-hungry summing amplifiers. The FE receiver achieves an SFDR/SNDR $>57.5 \text{dBc} / 49.5 \text{dB}$ with only $52 \text{mW} /$ channel and a Schreier FOM of 153 dB.},
  keywords={Azimuth;Array signal processing;Silicon-on-insulator;Receiving antennas;Bandwidth;Iron;Solid state circuits;Antenna arrays},
  doi={10.1109/ISSCC49663.2026.11408989},
}

@INPROCEEDINGS{11409132,
  author={Guo, Hao and Hu, Hao-Tao and Lin, Zhicheng and Guo, Zijun and Xia, Xiaoyue and Shum, Kam Man and Chan, Chi Hou},
  title={A 436-to-472GHz 4-Element IF Beamforming Phased-Array Receiver in 65nm CMOS},
  note={Section: Exploratory Receiver Architectures from GHz to THz},
  abstract={This paper presents a 436-to-472GHz 4-element IF beamforming phased-array receiver in 65nm CMOS. A two-step mixing architecture reduces layout overhead. The LO frequency multiplier chain provides $>-1 \text{dBm}$ over 180 to 214GHz to drive the THz mixer. The 6-bit phase shifter covers 51 to 66GHz with 2.5° phase error. The on-chip stacked patch antenna array enables 10dBi gain and 91GHz 3dB gain-bandwidth. The receiver achieves $\pm 35^{\circ}$ scanning range, 36GHz system operating bandwidth and 27.5dB noise figure.},
  keywords={Noise figure;Array signal processing;Patch antennas;Phase shifters;Layout;Receivers;Bandwidth;System-on-chip;Solid state circuits;Mixers},
  doi={10.1109/ISSCC49663.2026.11409132},
}

@INPROCEEDINGS{11409301,
  author={Jiang, Xuhao and Chen, Qin and Zhang, Ziang and Xia, Haiyang and Zhang, Shun and Han, Yang and Chen, Xin and Cheng, Depeng and He, Long and Wu, Xu and Li, Lianming and You, Xiaohu},
  title={A 26/28/37/39GHz Reconfigurable Fully Connected MIMO Receiver Front-End with On-Chip Diplexer Achieving 52-to-70dB Blocker Rejection},
  note={Section: Exploratory Receiver Architectures from GHz to THz},
  abstract={A 24.25-to-29.5 / 37-to-40GHz fully connected MIMO receiver (RX) front-end for 5G FR2 that enables 52-to-70 dB calibration-free inter-band blocker rejection and up to −5 dBm blocker tolerance is introduced. A compact on-chip diplexer and band-selective network are integrated in the RF chain to reject undesired signals before the mixer. The RX can support concurrent dual-band or multi-stream single-band operation, and achieve $4.8 \text{Gb} / \mathrm{s}$ 64-QAM non-contiguous inter-band carrier aggregation operation.},
  keywords={Radio frequency;5G mobile communication;Dual band;Receivers;Carrier aggregation;System-on-chip;Solid state circuits;Mixers},
  doi={10.1109/ISSCC49663.2026.11409301},
}

@INPROCEEDINGS{11409221,
  author={Dutton, Neale A. W. and Branca, Xavier and Thivin, Mathieu and Collins, Steven and Thuaire, Herve and Martin, Fabrice and Clemencon, Vincent and Al-Rawhani, Mohammed and Hall, Duncan and Crocherie, Axel and Pastorelli, Cedric and Taupin, Sophie and Trochut, Severin and Singh, Abhishek and Assmann, Andreas and Rae, Bruce R. and Mellot, Pascal},
  title={7.1 54×42 LiDAR 3D-Stacked System-On-Chip with On-Chip Point Cloud Processing and Hybrid On-Chip/Package-Embedded 25V Boost Generation},
  note={Section: Image Sensors and Ranging},
  abstract={We report a $54 \times 42$-resolution SPAD-based LIDAR receiver SoC leveraging 3D-stacked $65 / 40 ~\text{nm}$ technology with high-frequency TDC and 2 counters for ToF and intensity exposure, with peripheral memories used for image signal processing (ISP) frame stores, point cloud generation & HDR management. A hybrid on-chip & package-embedded 25V boost converter is described integrating SPAD supply generation synchronized with sensor frame timing. The sensor is integrated in a LIDAR module for 9.6m ranging with <1cm error.},
  keywords={Point cloud compression;Laser radar;Memory management;Receivers;Signal processing;Hybrid power systems;System-on-chip;Solid state circuits;Synchronization;Single-photon avalanche diodes},
  doi={10.1109/ISSCC49663.2026.11409221},
}

@INPROCEEDINGS{11409182,
  author={Sang, Haoyang and Wang, Zhao and He, Longzhen and Zhao, Guangshu and Xie, Wenao and Wang, Bo and Martins, Rui P. and Law, Man-Kay},
  title={VoxCAD: A 0.82-to-81.0mW Intelligent 3D-Perception dToF SoC with Sector-Wise Voxelization and High-Density Tri-Mode eDRAM CIM Macro},
  note={Section: Image Sensors and Ranging},
  abstract={VoxCAD, an intelligent low-power dToF SoC for end-to-end 3D perception applications, is presented with three features: 1) LiDAR dToF sensing-integrated 2D-ROI guided point cloud construction for reducing sensor transfer energy and latency; 2) coarse-fine sector-wise voxelization with a central-computation unit for reducing on-chip memory size and EMAs; and 3) reconfigurable tri-mode eDRAM CIM macros with hybrid 1T1C/2T1C cells for supporting 3D transformers at high area efficiency and storage density.},
  keywords={Point cloud compression;Three-dimensional displays;Laser radar;Transformers;In-memory computing;System-on-chip;Solid state circuits;Sensors},
  doi={10.1109/ISSCC49663.2026.11409182},
}

@INPROCEEDINGS{11409229,
  author={Kim, Minkyung and Bae, Junsang and Kim, Donghyuk and Chun, Jung-Hoon and Kim, Seong-Jin and Choi, Jaehyuk},
  title={A Multi-Range, Multi-Resolution LiDAR Sensor with 2,880-Channel Modular Survival Histogramming TDC and Delay Compensation Using Double Histogram Sampling},
  note={Section: Image Sensors and Ranging},
  abstract={We present a 720 192dToF sensor with a 2,880-channel modular survival histogram TDC (shTDC) array. The shTDC supports non-destructive accumulation while concentrating depth on active bins, reducing memory by 75% with precision comparable to one-step hTDC. Modular hTDCs enable multi-range and multi-resolution imaging to 69.6 m, while double histogram sampling cancels pixel-to-shTDC offsets. The prototype achieves 0.13% precision and 0.12% accuracy.},
  keywords={Histograms;Laser radar;Accuracy;Prototypes;Imaging;Solid state circuits;Delays;Sensor arrays},
  doi={10.1109/ISSCC49663.2026.11409229},
}

@INPROCEEDINGS{11409240,
  author={Roh, Wonjong and Piao, Canxing and Jeon, Taehoon and Bae, Junsang and Chun, Jung-Hoon and Kim, Seong-Jin and Choi, Jaehyuk},
  title={A 480×320 CMOS LiDAR Sensor with Tapering 1-Step Histogramming TDCs and Sub-Pixel Echo Resolvers},
  note={Section: Image Sensors and Ranging},
  abstract={A $480 \times 320$ CMOS LiDAR sensor using tapered 1 -step hTDCs and SPER for memory-efficient operation is presented. The hTDC accumulates histograms with 1ns resolution over the full range and applies 500ps resolution only at the echoes, while SPER maps echoes to individual SPADs, enabling $4 \times$ image resolution. Implemented with $2 \times 2$ SPAD macro-pixels and shared AFEs ($2.5 ~\mathrm{T} / \text{SPAD}$) in a 90 nm BSI CIS process, the sensor achieves 3.8 cm precision at 100 m and 4.1 cm accuracy under 110 klx sunlight at 25fps.},
  keywords={Histograms;Image resolution;Laser radar;Accuracy;Solid state circuits;Single-photon avalanche diodes},
  doi={10.1109/ISSCC49663.2026.11409240},
}

@INPROCEEDINGS{11409243,
  author={Perenzoni, Matteo and Okamoto, Koichi and De Nisi, Fabrizio and Perenzoni, Daniele and Jeong, Ji Yong and Zou, Yu and Mai, Hanning and Quarta, Gabriele and Rocca, Francesco Paolo Mattioli Della and Okamura, Yusuke and Marani, Davide and Brian, Michele and Giorgetti, Daniele and Ochiai, Soichi and Tatani, Keiji and Stoppa, David},
  title={7.5 a 26.0mW 30fps 400X300-Pixel SWIR Ge-SPAD dToF Range Sensor with Programmable Macro-Pixels and Integrated Histogram Processing for Low-Power AR/VR Applications},
  note={Section: Image Sensors and Ranging},
  abstract={This paper presents a $400 \times 300{-}$ pixel Ge-SPAD SWIR/NIR sensor enabling very-low-power operation: the flexible macropixel allocation scheme and high-rate multievent time-to-digital converters, combined with up to 100 simultaneous histograms having autoexposure control allows to turn on the sensor only when and where needed, with resilience to DCR. The sensor power consumption is 26 mW when operating 500 macropixels of $3 \times 3$ SPAD at 30 fps.},
  keywords={Histograms;Power demand;Solid state circuits;Resource management;Single-photon avalanche diodes;Resilience},
  doi={10.1109/ISSCC49663.2026.11409243},
}

@INPROCEEDINGS{11409325,
  author={Wang, Jingyi and Hong, Tao and Chen, Bu and Huang, Zhangcheng and Liu, Qi and Liu, Ming},
  title={A 128×96 Multimodal Flash LiDAR SPAD Imager with Object Segmentation Latency of 18μs Based on Compute-Near-Sensor Ising Annealing Machine},
  note={Section: Image Sensors and Ranging},
  abstract={This paper presents a $128 \times 96$ multimodal flash LiDAR SPAD imager integrated with a compute-near-sensor Ising-model annealing processor for dynamic object segmentation, framed as a combinatorial optimization problem (COP). The system enables real-time updates of Hamiltonian coefficients using a high-bandwidth output-while-write scheme, and accelerates Ising spin iterations by exploiting multimodal SPAD information, achieving a segmentation latency of $18 \mu \mathrm{s}$.},
  keywords={Image segmentation;Laser radar;Annealing;Object segmentation;Real-time systems;Solid state circuits;Optimization;Single-photon avalanche diodes},
  doi={10.1109/ISSCC49663.2026.11409325},
}

@INPROCEEDINGS{11408982,
  author={Hong, Kieop and Kang, Jubin and Hwang, Jung-Hye and Son, Insang and Park, Seonghyeok and Chun, Jung-Hoon and Choi, Jaehyuk and Kim, Seong-Jin},
  title={7.7 A Fully Reconfigurable Hybrid SPAD Vision Sensor with 134dB Dynamic Range Using Time-Coded Dual Exposures},
  note={Section: Image Sensors and Ranging},
  abstract={This paper presents a fully reconfigurable HDR intensity/event hybrid SPAD sensor. The fully reconfigurable scheme enables both pixel types to be freely blended and operated simultaneously. A time-coded dual exposure encodes saturation time to provide an adaptive secondary exposure, achieving $>134 \text{dB}$ DR in both modes while reducing quantization error of the time code. Event detection with pixel-wise shot-noise thresholding keeps uniform event noise < 0.46% across all illumination conditions.},
  keywords={Quantization (signal);Codes;Event detection;Noise;Lighting;Vision sensors;Dynamic range;Solid state circuits;Single-photon avalanche diodes},
  doi={10.1109/ISSCC49663.2026.11408982},
}

@INPROCEEDINGS{11409209,
  author={Yang, Zhengke and Yu, Haofeng and Liu, Xiao and Kong, Zhen and Li, Humiao and Ran, Liang and Lyu, Zhichao and Feng, Xinhe and Zhao, Liang and Li, Yida and Li, Jiamin and Zhou, Feichi and Lin, Longyang},
  title={7.8 A 55nm Intelligent Vision SoC Achieving 346TOPS/W System Efficiency via Fully Analog Sensing-to-Inference Pipeline},
  note={Section: Image Sensors and Ranging},
  abstract={This work presents a fully analog intelligent vision SoC that eliminates both sensorprocessor and inter-layer A/D conversions for end-to-end vision. A continuous analog datapath from sensing to multi-layer inference is enabled by a PWM imager, an RRAM-based CIM, and a linearity-recovery analog memory. Fabricated in 55 nm CMOS, the chip achieves 11pJ/(pixel.frame) sensing efficiency, 8,791 TOPS/W MAC efficiency, and 346 TOPS/W system-level efficiency across diverse vision tasks.},
  keywords={Pipelines;Pulse width modulation;In-memory computing;Sensors;Solid state circuits;Analog memory;Analog-digital conversion},
  doi={10.1109/ISSCC49663.2026.11409209},
}

@INPROCEEDINGS{11409255,
  author={Lee, Sanggwon and Yoo, Sun-Young and Shim, Yeongseok and Choi, Yong-Suk and Bae, Daehee and Ito, Masamichi and Shin, Deokha and Koo, Si-Gyoung and Byun, Sung-Jae and Cho, Gihwan and Kwon, Hyukbin and Jeong, Jaehun and Kim, Bumjun and Han, Su-Hyun and Lee, Youna and Sugihara, Hiroyuki and Jung, Junghoon and Kim, Suksan and Lim, Kyungtae and Ryu, Wonoh and Kim, Yongjun and Kim, Seung-Sik and Shim, Heesung and Seo, Min-Woong and Lee, Jae-kyu and Go, Jonghyun and Song, Jaihyuk},
  title={A 1.09e−-Random-Noise 1.5μm-Pixel-Pitch 12MP Global-Shutter-Equivalent CMOS Image Sensor with 3μm Digital Pixels Using Quad-Phase-Staggered Zigzag Readout and Motion Compensation},
  note={Section: Image Sensors and Ranging},
  abstract={A quad phase-staggered digital pixel sensor with a $1.494 \mu \mathrm{m}$ pixel pitch featuring a 1.09 e-rms RN, delivering a total resolution of 12 MP composed of four 3 MP sub-frames is presented. A single ADC is shared by a $2 \times 2$ pixels sequentially digitized, enabling optical flow extraction using two-stage deep burst super-resolution framework that incorporates a U-Net-based Quad-Bayer Re-mosaic module, extending the 12 MP resolution up to 48 MP while providing de-noising, motion compensation.},
  keywords={Superresolution;Noise reduction;CMOS image sensors;Motion compensation;Solid state circuits;Optical flow},
  doi={10.1109/ISSCC49663.2026.11409255},
}

@INPROCEEDINGS{11409135,
  author={Xu, Richard and Ren, Guanjing and Mo, Yaowu and Qi, Dekui and Wang, Qian and Zhang, Shengxin},
  title={7.10 A 200MP ${0. 6 1} {\mu} \mathrm{m}$-Pixel-Pitch CMOS Imager with Sub-1e Readout Noise Using Interlaced-Shared Transistor Architecture and On-Chip Motion Artifact-Free HDR Synthesis for 8K Video Applications},
  note={Section: Image Sensors and Ranging},
  abstract={We propose a $200 \text{MP} 0.61 \mu \mathrm{m}$ pixel size CMOS image sensor featuring: 1) an interlacedshared pixel architecture to achieve a 0.7e-readout noise, 2) an on-chip motion artifact-free HDR synthesis with single-frame dynamic range of 77dB, 3) a DCG ratio self-calibration algorithm to address the CG ratio non-uniformity, and 4) a 22nm high-speed readout circuit suitable for 8K HDR video with an optimal balance of low-power and high-speed performance.},
  keywords={Heuristic algorithms;Noise;Dynamic range;CMOS image sensors;System-on-chip;Transistors;Videos},
  doi={10.1109/ISSCC49663.2026.11409135},
}

@INPROCEEDINGS{11409120,
  author={Mondal, Susnata and Krishnamurthy, Sashank and Yamada, Shuhei and Liu, Zhaokai and Qiu, Junyi and Bose, Soumya and Wu, Zuoguo and Pasdast, Gerald and Jaussi, James and Mansuri, Mozhgan},
  title={A 48Gb/s/lane 1.24Tb/s/mm UCIe-Compliant Die-to-Die Link Over 30mm Standard Package},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This work demonstrates a UCle-S compliant die-to-die PHY at $48\text{Gb} / \mathrm{s} /$ lane across 16 lanes, achieving $1.24 \text{Tb} / \mathrm{s} / \text{mm}$ shoreline BW density over a 30 mm organic package at $1.2 \text{pJ} / \mathrm{b}$, extendable to $56 \text{GT} / \mathrm{s}(1.13 \text{pJ} / \mathrm{b})$. Circuit innovations include an impedance-invariant TX CTLE, high-swing N/N driver, compact resonant clocking, double-tail latch w/ improved setup/hold times, and common-mode supply-noise rejection. Compared to prior UCle-S, it achieves $3 \times$ higher data rate and $2.8 \times$ higher BW density.},
  keywords={Technological innovation;Latches;RLC circuits;Solid state circuits;Standards},
  doi={10.1109/ISSCC49663.2026.11409120},
}

@INPROCEEDINGS{11409144,
  author={Chen, Wei-Chih and Lin, Mu-Shan and Tsai, Chien-Chun and Li, Shenggao and Lin, Wei-Shuo and Huang, Yu-Jie and Cheng, Nai-Chen and Chen, Yu-Chi and Huang, Wen-Hung and Wen, Chin-Hua and Kuo, Hsin-Hung and Ke, Han-Tzung and Huang, Jie-Ren and Li, Chang-Yi and Lai, Sheng-Tsung and Yang, Shu-Chun and Chou, Kuan-Ting and Chiou, Pei-Chen and Tsai, Tsung-Hsien and Chen, Yi-Ting and Chen, Yen-Ming and Hsieh, Kenny Cheng-Hsiang},
  title={8.2 A 32Gb/s 12.35Tb/s/mm2 0.36pJ/b UCIe-Like Die-to-Die Interface Featuring Edge-Triggered Transceivers in 3nm with Active LSI Packaging},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This paper presents edge-triggered transceivers (ETT), enabling a 32Gb UCle-like chiplet interconnect when integrated within an active local silicon interconnect (aLSI). The ETT achieves power consumption of 0.07pJ/b and supports compact top-die TX/RX designs while optimizing 0.36pJ/b energy efficiency and 12.35Tb/s/mm2 area bandwidth density. It demonstrates a 32Gb/s die-to-die link at 0.75V with 20.46ps eye width (65% UI) and 530mV eye height across 64 lanes in a 3nm CMOS process.},
  keywords={Power demand;Chiplets;Integrated circuit interconnections;Packaging;CMOS process;Transceivers;Silicon;Large scale integration;Energy efficiency;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409144},
}

@INPROCEEDINGS{11409276,
  author={Shivnaraine, Ravi and Boecker, Charles and Groen, Eric and Li, Simon and Lu, Ping and Vamvakos, Socrates and Vu, Roxanne and Hanke, Chris and Tangirala, Shankar and Liu, Wen and Salik, Marina and Bartholomew, Kevin and Reddy, Sushmitha and Tessitore, Alex and Shallal, Aws and Nallaparaju, Kalyan and Liang, Jin and Chen, Minhan and Desai, Shaishav},
  title={A 0.23pJ/b 24Gb/s Modular D2D Interface with Zero Wake Penalty Clock Gating in 3nm},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This work presents a $3 ~\text{nm} 24 ~\text{Gb} / \mathrm{s}$ D2D Interface achieving $0.23 \text{pJ} / \mathrm{b}$ (analog PHY power) and zero wake penalty clock gating and $0.17 \text{pJ} / \mathrm{b}$ at $20 ~\text{Gb} / \mathrm{s}$. The PHY achieves a total end-to-end average latency of 4.2 ns ($\sim 25 \%$ analog macro). Measured performance demonstrates a worst-case bit-error rate, extrapolated to 1e-18 measured across 1680 lanes over PVT of $12 \text{ps}_{\text{pp}}$. The modular nature of this work allows flexibility in the construction of D2D links and natively supports asymmetric TX and RX bandwidths.},
  keywords={Bandwidth;Device-to-device communication;Solid state circuits;Clocks},
  doi={10.1109/ISSCC49663.2026.11409276},
}

@INPROCEEDINGS{11409095,
  author={Huang, Zhiwen and Wang, Zhifei and Ye, Bingyi and Ye, Tianchen and Yu, Dunshan and Wang, Wei and Gai, Weixin},
  title={8.4 A 112Gb/S/Wire Single-Ended Simultaneous Bi-Directional Transceiver with Dynamic Equalizer for Die-to-Die Interface in 28nm CMOS},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This work presents an 8-lane $112 ~\text{Gb} / \mathrm{s} /$ wire single-ended simultaneous bi-directional transceiver with a 3mm shield-less on-chip channel. A dynamic equalizer is proposed to decouple the bi-directional signals, and compensate for insertion loss and crosstalk. Fabricated in 28nm CMOS, the transceiver achieves a BER of less than 10−14, and an energy efficiency of $1.01 \text{pJ} / \mathrm{b}$.},
  keywords={Equalizers;Crosstalk;Bidirectional control;Insertion loss;Transceivers;Energy efficiency;System-on-chip;Solid state circuits;Wire},
  doi={10.1109/ISSCC49663.2026.11409095},
}

@INPROCEEDINGS{11409236,
  author={Zhang, Zhaoyu and Xu, Yiqing and Liu, Jian and Wu, Nanjian and Zhang, Zhao and Liu, Liyuan},
  title={8.5 A 112Gb/s 0.76pJ/b Reference-Less Mixed-Signal PAM-4 CDR in 28nm CMOS},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This paper presents a $112 ~\text{Gb} / \mathrm{s}$ mixed-signal reference-less PAM-4 CDR in 28nm CMOS. By proposing the hybrid architecture based on a symmetrical linear PD and a bang-bang PFD, a frequency acquisition controller and a DCC-PEC-merged MPCG, the design issues of reference-less PAM-4 CDR operating at a data rate over $100 ~\text{Gb} / \mathrm{s}$ are mitigated. The 28nm CMOS prototype achieves $0.76 \text{pJ} / \mathrm{b}$ efficiency and $0.11 \text{UI}_{\text{PP}}$ jitter tolerance at $\text{BER} \leq 10^{-12}$.},
  keywords={Prototypes;Phase frequency detectors;Jitter;Solid state circuits;Frequency control},
  doi={10.1109/ISSCC49663.2026.11409236},
}

@INPROCEEDINGS{11409174,
  author={Singh, Ullas and Thasari, Kumar and Nidhi, Nitin and Iyer, Arvindh and Surana, Saurabh and Dayanik, Batu and Li, Yuanfang and Torabi, Mohammadamin and Jung, Jun Won and Grassi, Alberto and Fahimnia, Mehrdad and Kimura, Hiroshi and Bahmani, Faramarz and Chen, Hao and Wang, Alex and Zhao, Chen and Fang, Yuan and Chen, Allen and Momtaz, Afshin and Kocaman, Namik},
  title={8.6 A 280mW 112Gb/s PAM-4/NRZ Transceiver for Low-Power IOs in 5nm FinFET Technology},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This paper presents the design of an ultra-low power, compact $112 \text{Gb} / \mathrm{s}$ PAM-4 transceiver. Each lane incorporates a quarter rate RX with 3-tap FFE, 11-tap DFE equalization, and a half-rate TX using a 7b SST DAC driver. The transceiver can compensate up to 35 dB channel loss at $112 \text{Gb} / \mathrm{s}$ and achieves BER $<1 \mathrm{E}-6$, dissipating only 280 mW including both analog and digital power domains. This work has the best $\text{pJ} / \mathrm{b} / \text{dB} \text{FOM}$ as well as the lowest area versus comparable work at this data rate.},
  keywords={Low power electronics;FinFETs;Transceivers;Decision feedback equalizers;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409174},
}

@INPROCEEDINGS{11409044,
  author={Sun, Huanfa and Wei, Shangjie and Su, Yu and Cao, Chenyao and Zeng, Yujie and He, Yukun and Duan, Zhouchi and Zhang, Guohe and Gui, Xiaoyan},
  title={A 112Gb/s PAM-4 SBD Transceiver with Mismatch-Compensated 2×VDD Hybrid and Two-Step Echo Canceller in 28nm CMOS},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={A $112 \text{Gb} / \mathrm{s}$ PAM-4 simultaneous bidirectional (SBD) transceiver in 28 nm CMOS is presented. It features a hybrid with a $2 \times$ VDD stacked driver to restore signal swing, a joint delay and slew-rate matching scheme to eliminate dynamic glitches, and a two-step echo canceller to mitigate reflections. The transceiver achieves BER $<1 \mathrm{E}$-10 over a 12.7 dB loss channel (equivalent to 24.4 dB at Nyquist), with $1.73 \text{pJ} / \mathrm{b}$ energy efficiency and an FoM of $0.14 \text{pJ} / \mathrm{b} / \text{dB}$.},
  keywords={Echo cancellers;Transceivers;Reflection;Energy efficiency;Solid state circuits;Delays},
  doi={10.1109/ISSCC49663.2026.11409044},
}

@INPROCEEDINGS{11409031,
  author={Kim, Kahyun and Lee, Yoona and Na, Daehoon and Park, Ha-Jung and Song, Jeongeun and Choi, Woo-Seok},
  title={8.8 A 0.292pJ/b 56Gb/s/wire Capacitively Driven Simultaneous Bidirectional Transceiver with PVT/Mismatch Tracking for XSR and D2D Interfaces in 28nm CMOS},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={A low-power $(0.292 \text{pJ} / \mathrm{b})$, high-bandwidth $(56 ~\text{Gb} / \mathrm{s} /$ wire) single-ended capacitively driven simultaneous bi-directional (CD-SBD) TRX with PVT tolerance is proposed. Capacitive driving reduces power and self-interference in SBD. AC/DC replica and PVT/mismatch tracking provides PVT robustness without extra hardware. Per-lane CDR and a quadrature generator with QEC/DCC, secure clock margin. The TRX sustains <1e-12 BER across -6.5 to -11.5 dB loss, $0.93-1.2 ~\mathrm{V}$ supply, and $0-80^{\circ} \mathrm{C}$ temperature variation.},
  keywords={Interference cancellation;Bidirectional control;Transceivers;Robustness;Hardware;Generators;Solid state circuits;Device-to-device communication;Wire;Clocks},
  doi={10.1109/ISSCC49663.2026.11409031},
}

@INPROCEEDINGS{11409339,
  author={Cheng, Xuxu and Wu, Hongzhi and Li, Zhenghao and Wu, Weitao and Luo, Xiongshi and Zhang, Yangyi and Pan, Quan},
  title={8.9 A 72Gb/s/pin Single-Ended Simultaneous Bi-Directional Transceiver with C-Peaking Leakage Cancellation and Dual-Loop Hybrid Impedance Calibration for Chiplet Interfaces},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This paper presents a 72Gb/s/pin single-ended simultaneously bi-directional (SBD) TRX in 28nm CMOS. Capacitive peaking leakage cancellation (CPLC) suppresses the high-frequency leakage due to the main and hybrid driver mismatch in SBD links by 63%. Dual-loop hybrid impedance calibration reduces the coefficient errors of the hybrid circuits under PVT variations by 92%. The TRX achieves a 72Gb/s data rate with an eye-opening of 0.45UI and 243mV and an energy efficiency of 1.5pJ/b.},
  keywords={Chiplets;Circuits;Bidirectional control;Transceivers;Energy efficiency;Calibration;Solid state circuits;Impedance},
  doi={10.1109/ISSCC49663.2026.11409339},
}

@INPROCEEDINGS{11408972,
  author={Lin, Ziyi and Jia, Haikun and Deng, Wei and He, Shitu and Liu, Chang and Wang, Zhihua and Chi, Baoyong},
  title={8.10 A 180-to-240Gb/s Analog-Intensive PAM-4 Transmitter with 0.70pJ/b Analog Power Efficiency in 65nm CMOS},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={This paper presents a $180-240 ~\text{Gb} / \mathrm{s}$ analog-intensive PAM-4 transmitter in 65 nm CMOS process. A three-stage cascaded 2-to-1 analog MUX (AMUX) is employed to reduce the complexity and therefore the parasitic capacitance of both output and internal high-speed nodes. Reconfigurable 4-tap FFE, current injection, and dual T-coil techniques are proposed to enhance the output swing and the bandwidth. The transmitter achieves $0.70 \text{pJ} / \mathrm{b}$ analog energy efficiency at a $240 ~\text{Gb} / \mathrm{s}$ data rate.},
  keywords={Transmitters;Bandwidth;CMOS process;Energy efficiency;Solid state circuits;Complexity theory;Parasitic capacitance},
  doi={10.1109/ISSCC49663.2026.11408972},
}

@INPROCEEDINGS{11409313,
  author={Tsai, Yao-Hung and Chuang, Ming-Han and Liu, Shen-Iuan},
  title={A 1.59pJ/b 112Gb/s PAM-4 and 1.06pJ/b 168Gb/s PAM-8 Resistor-Less 7-Bit SST DAC-Based Transmitter with 8-Tap FFE in 28nm CMOS},
  note={Section: Die-to-Die and High-Speed Electrical Transceivers},
  abstract={A resistor-less 7b SST DAC-based TX with 8-tap FFE and 3 types of segments is presented to achieve low parasitic capacitance, compact area, and scaling friendliness. To reduce intersymbol-interference jitter at the output of a 4:1 multiplexer, a dual-feedback equalizer is proposed. The TX is fabricated in 28nm CMOS with a maximum output swing of 1.1Vppd. The power dissipation is 178mW at 112Gb/s PAM-4 and 168Gb/s PAM-8, and energy efficiency is 1.59pJ/b at PAM-4 and 1.06pJ/b at PAM-8.},
  keywords={Multiplexing;Transmitters;Equalizers;Jitter;Energy efficiency;Solid state circuits;Power dissipation;Parasitic capacitance},
  doi={10.1109/ISSCC49663.2026.11409313},
}

@INPROCEEDINGS{11409091,
  author={Li, Zhenhao and Tang, Junyao and Singh, Nawab and Jiang, Jianqiang and Zhao, Lei and Zhu, Wenshuo and Sun, Xuan and Dong, Liang and Huang, Cheng},
  title={A Single-Power-Link 13.56MHz Wireless Power and Data Transfer System with Synchronized Phase-Shifted Time-Multiplexing Dual Uplinks for Implantable Voltammetry},
  note={Section: Wireless Power},
  abstract={A 13.56 MHz wireless power and data transfer (WPDT) system for implantable voltammetry sensor is presented. With the synchronized phase-shifted time-multiplexing technique, the system uses a single power link to support simultaneous power and two types of data transmission via dual-uplinks with neither additional coils nor efficiency degradation. The single-power-link operation is verified in silicon, measuring a 60% peak end-to-end efficiency, a fast dynamic response, and a $>99.9 \%$ data linearity.},
  keywords={Wireless communication;Dynamic response;Wireless sensor networks;Linearity;Data transfer;Silicon;Solid state circuits;Synchronization;Velocity measurement;Uplink},
  doi={10.1109/ISSCC49663.2026.11409091},
}

@INPROCEEDINGS{11409045,
  author={Lu, Tianqi and Zhao, Bo and Du, Sijun},
  title={9.2 A 91%-Efficiency Single-Stage Bipolar Quad-Output Regulating Rectifier with Event-Driven Output Power Enhancement via Coil-Reused DC-DC for Wireless Power Transfer},
  note={Section: Wireless Power},
  abstract={A bipolar quad-output regulating rectifier for wireless power transfer (WPT) is presented. Using only five power switches, it provides four independently regulated bipolar outputs. A coil-reused DC-DC mode sustains operation under heavy-load conditions beyond the RX input power limit. The rectifier achieves up to 173 mW output power, 91% peak efficiency, and fast transient recovery.},
  keywords={Rectifiers;Wireless power transfer;Solid state circuits;Transient analysis;Power generation},
  doi={10.1109/ISSCC49663.2026.11409045},
}

@INPROCEEDINGS{11409103,
  author={Chen, Yutang and Lin, Yifan and Chen, Dihu and Guo, Jianping},
  title={An Output-Domain-Independent Single-Transmitter-Dual-Receiver Wireless Power Transfer System with Detuned-Tank and Time-Multiplexing Control for Adaptive Power Distribution},
  note={Section: Wireless Power},
  abstract={This paper presents an output-domain-independent single-transmitter-dual-receiver wireless power transfer system. The proposed detuned-tank and time-multiplexing control enable adaptive power distribution, preventing power conflicts caused by different receiver impedance $\left(\mathrm{Z}_{\text{RX}}\right)$ and coupling coefficient (k). The system achieves two output domains over k ranging from 0.14 to 0.28, with excellent load regulation of $0.07 / 0.26 \text{mV} / \text{mA}$, a peak efficiency of 82.2% and a maximum output power of 1099mW.},
  keywords={Couplings;Adaptive systems;Power distribution;Wireless power transfer;Receivers;Regulation;Distance measurement;Solid state circuits;Impedance;Power generation},
  doi={10.1109/ISSCC49663.2026.11409103},
}

@INPROCEEDINGS{11409068,
  author={Cui, Kai and Lu, Yan},
  title={9.4 A Multi-Coil Scalable Energy-Shared Wireless Power Receiver Network for Distributed Time-Division-Multiplexing Somatosensory Cortex Stimulation},
  note={Section: Wireless Power},
  abstract={This work presents a system-level scalable wireless power receiver (RX) network for miniaturized distributed somatosensory cortex stimulation. By interconnecting the power outputs of all RX cells in the network, the stimulator in each cell can access the total received power of the whole network, with a time-division-multiplexing stimulation manner. Thus, each cell owns a multiple-input single-output wireless power RX network without additional RX coils, with improved efficiency and robustness.},
  keywords={Somatosensory;Coils;Integrated circuit interconnections;Receivers;Robustness;Solid state circuits;MISO},
  doi={10.1109/ISSCC49663.2026.11409068},
}

@INPROCEEDINGS{11409073,
  author={Machida, Shiro and Fukuoka, Kazuki and Onda, Tomoya and Yada, Nobuhiro and Nakano, Hiroyuki and Yamanaka, Sho and Cao, Hung Van and Hara, Yusaku and Irita, Takahiro and Wakahara, Kohei and Cordoba, Cyril and Kamei, Tatsuya and Shimazaki, Yasuhisa},
  title={A 3nm, 400TOPS, 1080k DMIPS SoC with Chiplet Support for ASIL D Automotive Cross-Domain Applications},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={This paper presents a 3 nm SoC, designed for software defined vehicles, integrating various functions for zone-based computing. The chip includes a $1,080 \text{kDMIPS}$ APU, 400TOPS NPU and $51.2 \text{GB} / \mathrm{s}$ inter-chip bandwidth. Functional safety is ensured by RegionID-based FFI over UCle. Power efficiency is achieved with fine-gating across $90+$ power domains with enhanced IR-drop control and ASIL D-compliant DCLS. Hierarchical mCPGs reduce clock latency. The chip supports low-power modes such as Sentry and CPD.},
  keywords={Chiplets;Bandwidth;Software;Solid state circuits;Safety;Clocks;Automotive engineering},
  doi={10.1109/ISSCC49663.2026.11409073},
}

@INPROCEEDINGS{11409197,
  author={Lu, Chien-Yu and Huang, Bo-Jr and Hsueh, Sung S.-Y. and Tran, Trong-Hieu and Fang, Eric Jia-Wei and Yeh, Chao-Yang and Sun, Quan and Chen, Tao and Chen, Hsinchen and Chang, Huaichung and Tsai, C.-J. and Zhuang, Yi-Chang and Chen, Barry and Wang, Ericbill and Mair, Hugh and Hwang, Shih-Arn},
  title={10.2 A Dynamic Performance Augmentation in a 3nm-Plus Mobile CPU},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={This work presents dynamic mobile-performance augmentation (DMPA), featuring boosting-duty control (BDC) and an adaptive thermal cooler (ATC) to augment CPU maximum performance. The BDC uses an aging sensor (A-sensor) to leverage an aging budget for performance boosting. For thermal, the ATC integrates temperature sensors (T-sensors) across the CPU and works with multiple sensors and a throttler to optimize clock speed effectively cooling hotspots. The DMPA offers a score of 3917 in the GeekBenchv6 single-core benchmark on a flagship smartphone, consuming 0.078% or less total power, while occupying only 0.0122% of the CPU area.},
  keywords={Temperature sensors;Cooling;Aging;Benchmark testing;Boosting;Central Processing Unit;Solid state circuits;Clocks},
  doi={10.1109/ISSCC49663.2026.11409197},
}

@INPROCEEDINGS{11409316,
  author={Peng, Yimai and Yingling, Daniel and Hajri, Basma and Vachon, Robert and Gebreyohannes, Fikre and Li, Vincent and Chhetri, Ghanshyam and Bowman, Keith},
  title={A 2nm Clock-Edge Architecture for Processor Clock-Power Reduction},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={A 2nm clock-edge architecture (CEA) for an NPU matrix-multiplication unit (MXU) features dual-edge-triggered (DET) flip-flops, DET clock-gating circuits, and an adaptive clock duty-cycle controller to achieve iso-performance as a conventional (CNV) design while operating at half the clock frequency. Silicon measurements of the CEA MXU demonstrate $\sim 39-40 \%$ lower clock power and a total dynamic power reduction of $\sim 7-15 \%$, depending on the workload, as compared to the CNV MXU at iso-throughput.},
  keywords={Power measurement;Circuits;Silicon;Solid state circuits;Frequency control;Clocks;Flip-flops},
  doi={10.1109/ISSCC49663.2026.11409316},
}

@INPROCEEDINGS{11409123,
  author={Elkholy, Ahmed and Ismail, Yousr and Huang, Zhi and Garg, Adesh and Nazemi, Ali and Cao, Jun and Momtaz, Afshin},
  title={A 0.008mm2 16-to-1600 MHz All-Digital Fractional Divider Using AUX-DLL for Background LMS-Based DTC Calibration},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={An all-digital high-performance standalone fractional divider (FDIV) is presented. It leverages a robust replica-free least-mean square (LMS)-based digital-to-time converter (DTC) background calibration using a compact auxiliary delay locked loop (AUX-DLL). The proposed FDIV provides a wide output frequency range $(16-1600 \text{MHz})$ with very fine frequency resolution (50b) and achieves worst-case integrated jitter performance of $350 \text{fs}_{\text{rms}}$, while occupying only $0.008 \text{mm}^{2}$.},
  keywords={Jitter;Calibration;Solid state circuits;Delays},
  doi={10.1109/ISSCC49663.2026.11409123},
}

@INPROCEEDINGS{11408959,
  author={Chen, Xi and Liss, Andrew and Covington, William and Cao, Qiankai and Li, Yiqi and Wei, Kang and Magod, Raveesh and Khellah, Muhammad and Zhang, Xin and Gu, Jie},
  title={Proactive Power Management-Based Supply Regulation with Online Learning for Variation-Tolerant Workload-Aware Droop Mitigation in 28nm CMOS},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={A 28 nm SoC solution with integrated proactive power management for droop mitigation is demonstrated combining a neural droop management unit, integrated high speed power converter, and an online learning engine to combat the PDN and workload variations. The 28nm test chip integrated with CPU and accelerators achieves 59% worst-case droop reduction, $48 \times$ throttling reduction, and $>91 {\%}$ regulator peak efficiency, reducing performance degradation from prior fixed-model or throttling-only schemes.},
  keywords={Degradation;Regulators;Prevention and mitigation;Power system management;Regulation;Solid state circuits;Central Processing Unit;Engines},
  doi={10.1109/ISSCC49663.2026.11408959},
}

@INPROCEEDINGS{11409347,
  author={Knag, Phil C. and Chen, Gregory K. and Xie, Shanshan and Yada, Satish and Wu, Wei and Lin, Yu-Shiang and Kashirin, Alexander and Meng, Xiemei and Criss, Russell and Leon, Ana Sonia and Tokunaga, Carlos and Krishnamurthy, Ram K. and Tschanz, James W.},
  title={10.6 A Hybrid-Bonded 12.1Tops/mm2 5 6-Core DNN Processor with 2.5Tb/s/mm2 3D Network on Chip},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={A manycore DNN processor leverages hybrid bonding in a $14 \times 4 \times 2$ mesh network on chip to increase 3D bandwidth between cores, accelerators, and SRAM to 2.5Tb/s/mm2. Memory throughput is improved by 39% compared to an equivalent 2D design with the same memory capacity. The 56 $16 \times 16$ INT8 systolic array accelerators are stacked on top of 56 RISC-V cores to enable a peak AI performance density of 12.1 TOPS/mm2. The DNN processor scores a latency of $53 \mu \mathrm{s}$ on the image classification benchmark from MLPerf.},
  keywords={Mesh networks;Three-dimensional displays;Random access memory;Bandwidth;Benchmark testing;Throughput;Systolic arrays;Solid state circuits;Bonding;Image classification},
  doi={10.1109/ISSCC49663.2026.11409347},
}

@INPROCEEDINGS{11409109,
  author={Wu, Zihan and Tang, Xiyuan and Lin, Lishan and Yang, Youming and Luo, Haoyang and Xu, Bocheng and Liang, Yitao and Bo, Xiaochen and Wang, Yuan},
  title={A 28nm Mode-Reconfigurable CAM-CIM Hybrid Complete 3-SAT Solver Supporting Conflict-Driven Clause Learning with 100% Solvability},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={The K-SAT problem is NP-complete and costly on von Neumann machines. Several ASIC solvers have been proposed to mitigate this, but they rely on inefficient crossbar mapping, overlook community structures and lack adaptability to formula size. This work presents an ASIC complete solver with conflict-driven clause learning (CDCL), employing a mode-reconfigurable CAM-CIM hybrid architecture. Fabricated in 28 nm CMOS, it achieves 4.3-to-5.1× speedup and $1.4 \times$ energy reduction over a state-of-the-art ASIC complete solver.},
  keywords={Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409109},
}

@INPROCEEDINGS{11409141,
  author={Wu, Yihao and Bae, Jooyoung and Shin, Seunghun and Kim, Bongjin},
  title={10.8 COBI: A Degree-of-56 Column-Bipartite Densely Connected Digital Ising Chip with 8b Spin Coefficients},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={We present a 65nm digital Ising chip with an advanced column-bipartite topology, featuring densely connected spins with a degree of 56 and 8b coefficients for mapping and solving computationally intensive combinatorial optimization problems. A fabricated Ising test chip with 64 spin processing elements with spin coefficients stored in flexible embedded SRAM demonstrates solving practical problems, such as MIMO detection for a wireless network, with a fast solution time (<72ns).},
  keywords={Wireless networks;Random access memory;Topology;Solid state circuits;Optimization},
  doi={10.1109/ISSCC49663.2026.11409141},
}

@INPROCEEDINGS{11409274,
  author={Huang, Yi and Kong, Hao and Chou, Iris Ying and Wang, Bin and Kong, Xiangyu and Zhu, Jianfeng and Li, Liangwei and Li, Xiao and Wang, Hanning and Zhang, Aoyang and Liu, Leibo},
  title={SharpSAT: A Heuristic-Learning-Based SAT Accelerator Achieving 0.8μs/16.1μs Solution Time in SAT/UNSAT Cases},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={We present SharpSAT, a heuristic-learning SAT accelerator that achieves fast solution times of 0.8 μs for SAT and 16.1 μs for UNSAT cases. Our design integrates: a fast clause learning unit that prunes the search space by deriving constraints from conflicts; a dual-BCP unit that accelerates implication propagation; and a heuristic variable decider introducing non-determinism to efficiently traverse the solution space. A 28 nm prototype demonstrates 21.11×/2.61× (SAT/UNSAT) speedup over prior accelerators.},
  keywords={Prototypes;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409274},
}

@INPROCEEDINGS{11408954,
  author={Bhattacharya, Tinish and Hutchinson, George Higgins and Kwon, Dongseok and Strukov, Dmitri},
  title={PCIM-SAT: A 55nm Probabilistic K-SAT Solver with p-Bit-Based Parallel-Variable Update on a Mixed-Signal Compute-in-Memory Architecture},
  note={Section: Digital Processing and Circuit Techniques},
  abstract={We present a 55 nm mixed-signal K-SAT solver with parallel-variable update algorithm for improved convergence and a compute-in-memory fabric that maps arbitrary-order K-SAT instances without preprocessing. It solves 50 -variable 3 -SAT (satisfiable) problems in $5.5 \mu ~\mathrm{S}$ with 100% solvability at 265nJ. A custom 11T-SRAM crossbar for one-shot analog gradient computation and ADC-less gradient-based sampling with probabilistic-bit circuits enable 4-to- $13 \times$ speedup over prior ASICs.},
  keywords={Circuits;Computer architecture;Probabilistic logic;In-memory computing;Fabrics;Solid state circuits;Convergence},
  doi={10.1109/ISSCC49663.2026.11408954},
}

@INPROCEEDINGS{11409270,
  author={Wang, Jingpeng and Li, Bingrui and Luo, Haoyang and Zhan, Mingtao and He, Xiyu and Shen, Dawei and Jie, Lu and Tang, Xiyuan},
  title={11.1 A 14b 400MS/s TDC-Assisted Pipelined-SAR ADC with Rail-to-Rail Input VTC and Background Time-Domain Error Calibration},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={This paper presents a 14b 400MS/s Pipelined-SAR ADC utilizing a front-end TDC with a linearized rail-to-rail input VTC. A background calibration engine corrects VTC gain and time-domain offset errors by monitoring digital output statistics with minimal analog overhead. A replica-biasing-based ring amplifier improves energy efficiency and robustness. The 28nm chip achieves 67dB Nyquist SNDR at 4.6mW with a 6.3fJ/conv-step FoMw and 173.5dB FoMs.},
  keywords={Robustness;Energy efficiency;Calibration;Solid state circuits;Time-domain analysis;Monitoring;Engines},
  doi={10.1109/ISSCC49663.2026.11409270},
}

@INPROCEEDINGS{11409299,
  author={Liu, Qilong and Rutten, Robert and Bolatkale, Muhammed and Aralioglu, Arda and Hardeman, Gilbert and Siby, Emil and van Mourik, Patrick and Ilamurugan, Vinoth and Bajoria, Shagun and Breems, Lucien},
  title={A 28nm CMOS SAR-Based Continuous-Time Pipeline ADC with 103dB SFDR and 270MHz Bandwidth Using NCF and DAC Error Calibration},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={This 28nm CMOS SAR-based continuous-time pipeline ADC for automotive receivers achieves −95dBc THD and 103dB SFDR in 270MHz bandwidth, exceeding state-of-the-art by >20dB. Wideband high spectral purity is realized with a highly linear all-pass filter, high-SFDR coarse ADCs, a fast tone-based frequency-domain noise-cancellation filter calibration and a correlation-based element-wise DAC gain and timing error calibration. Power and area, including LDOs and calibrated filters is 155mW and 1.4mm2.},
  keywords={Maximum likelihood detection;Frequency-domain analysis;Pipelines;Nonlinear filters;Receivers;Calibration;Timing;Solid state circuits;Wideband;Automotive engineering},
  doi={10.1109/ISSCC49663.2026.11409299},
}

@INPROCEEDINGS{11409177,
  author={Rocco, Michele and Zanoletti, Gabriele and Ceroni, Alessia and Tombolan, Giacomo and Bè, Gabriele and Ricci, Luca and Levantino, Salvatore and Lacaita, Andrea Leonardo and Bertulessi, Luca and Samori, Carlo and Bonfanti, Andrea Giovanni},
  title={11.3 A 500MS/s 12b Pipe-SAR ADC Using a Triple-Cascode FIA with Virtual Supply Extension},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={This paper presents a 28 nm CMOS 500 MS/s 12b three-stage pipeline SAR ADC based on a triple-cascode single-stage floating residue amplifier with virtual supply extension to improve its efficiency and linearity. The ADC achieves 63.4 dB SNDR and 81.0 dB SFDR at 240 MHz input across PVT variations, consuming 6.64 mW with on-chip digital calibrations and occupying 0.011 mm2.},
  keywords={Pipelines;Linearity;System-on-chip;Solid state circuits;Calibration},
  doi={10.1109/ISSCC49663.2026.11409177},
}

@INPROCEEDINGS{11409164,
  author={He, Xiyu and Gu, Mingyang and Tao, Yunsong and Huang, Siyu and Zhang, Zhishuai and Zhong, Yi and Sun, Nan and Jie, Lu},
  title={A 13b 500MS/s 94dB-SFDR Resistive-Input Pipelined-SAR ADC with Linear and Efficient Current-Buffer-Based Integrating Sampler},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={This work proposes a pipelined-SAR ADC featuring a current-buffer-based integrating sampler that presents a resistive input with good linearity. A floating charge transferrer (FCT) with multi-bit pre-conversion (MB-PC) enables linear residue amplification and accelerates the second-stage conversion. The prototype ADC achieves an SNDR of 67.5 dB and an SFDR of 94.5 dB under a Nyquist input at 250 MHz. This SFDR is the highest reported for discrete-time ADCs operating above 200 MS/s.},
  keywords={Prototypes;Linearity;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409164},
}

@INPROCEEDINGS{11409101,
  author={Martens, Ewout and Parisi, Angelo and Kankuppe, Anirudh and Cooman, Adam and Li, Hanyue and Van Winckel, Steven and Renukaswamy, Pratap and Santana, Lucas Moura and Benites, Jorge Lagos and Markulić, Nereo and Craninckx, Jan},
  title={11.5 A Compact 7b 175GS/s Linearized Time-Interleaved Slope ADC with Switched Input Buffers},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={We present a $2048 \times$ time-interleaved slope-ADC implementing 7b, 175GS/s conversion. Samplers with switched buffers are proposed to realize wideband sampling in rank 1 driven by a multi-phase clock generated by a delay line with feedforward coupling. Making the slope nonlinear compensates static nonlinearities of the hierarchical sampling network. With only 0.063mm2 in 5nm CMOS, it is the smallest ultra-high-speed ADC reported to date with an excellent energy per sample of less than 2.16pJ.},
  keywords={Couplings;Switches;Delay lines;Solid state circuits;Wideband;Switching circuits;Clocks},
  doi={10.1109/ISSCC49663.2026.11409101},
}

@INPROCEEDINGS{11409345,
  author={Miyazaki, Daisuke and Yagishita, Yuki and Takasaki, Mika and Nagata, Shun and Nogamida, Takeru and Abe, Yudai and Tomita, Kazutoshi and Hasebe, Kazunori and Kikkawa, Toshiyuki and Yoshizawa, Satoshi and Suzuki, Atsuya and Kato, Soichi and Naito, Takahiro and Bunsen, Keigo and Matsumoto, Tomohiro and Katayama, Yasushi},
  title={11.6 an 8B 20Gs/S Time-Interleaved ADC with 2.6mW 1GS/s Hybrid Voltage/Time-Domain Sub-ADC in 12Nm FinFET},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={A 2.6mW, 1GHz, 42dB-SNDR sub-ADC is presented. A hybrid voltage- and time-domain architecture is employed to avoid the theorical SAR comparator trade-offs and enable power efficiency benefit from the time-domain ADC. Additionally, a hierarchical sample-and-hold circuit with a new common-mode feedback scheme is introduced to enhance signal distribution. A 20GHz time-interleaved ADC, including an input buffer and reference, demonstrates an SNDR of 37dB with a power consumption of 135mW.},
  keywords={Power demand;FinFETs;Hybrid power systems;Solid state circuits;Time-domain analysis},
  doi={10.1109/ISSCC49663.2026.11409345},
}

@INPROCEEDINGS{11409082,
  author={Zhu, Haiyang and Singer, Larry and Kapusta, Ron and Kelly, Dan and Pan, Tao and Hensley, Mike and Bardsley, Scott and Dillon, Chris and Rey-Losada, Daniel and Sheikh, Kashif M. and Hsu, Chen-Kai and Li, Zhao and Brunsilius, Janet and Alvarez-Fontecilla, Enrique and Bishop, Robert and Wilkins, Paul and L'Bahy, Hassan and Cantoni, Adalberto and Zhang, Nuo and Oo, Kaung Myat San and Asci, Cihan},
  title={A 12b 12GS/s Two-Way Interleaved Pipeline ADC with Integrated Broadband RF VGA in 5nm},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={A 12b $12 \text{GS} / \mathrm{s}$ ADC with an integrated broadband RF VGA is implemented in a 5 nm FinFET process. This combination achieves a programmable input range of 36 dB from $250 \text{mV}_{\text{ppd }}$ to $16 \mathrm{V}_{\text{ppd }}$, bandwidth of 8.5 GHz, SNDR of 49 dB, SFDR of 70 dBc (with a $5.1 \text{GHz},-1 \text{dBFS}$ input tone), and a single interleaving spur ($<-90 \text{dBc}$) between DC and $\mathrm{F}_{\mathrm{s}} / 2$. Two pipeline-stage architectures, “Flash Early-Trigger” and “Embedded SHA”, enable 6GS/s in a 12b sub-ADC, which is key to achieve two-way interleaving at $12 \text{GS} / \mathrm{s}$.},
  keywords={Radio frequency;6G mobile communication;Pipelines;Bandwidth;FinFETs;Broadband communication;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409082},
}

@INPROCEEDINGS{11409046,
  author={Luo, Hao and Long, Zhijun and Zhu, Wentao and Lu, Haowei and Fu, Yushen and Lei, Mingqian and Wang, Cheng and Zhu, Xiaoge and Diao, Yumei and Zhu, Haipeng and Zhong, Jiajun and Tian, Li and Yang, Yi and Geng, Xinlin and Ouyang, Keqing},
  title={11.8 A 14b 20GS/s RF-Sampling DAC Achieving 70.4dBc IMD3 Up to 8.9GHz},
  note={Section: Pipeline and Ultra-High-Speed Data Converters},
  abstract={This work presents a $14 \mathrm{b} 20 \text{GS} / \mathrm{s}$ RF-sampling DAC. By introducing a switch driver with process-and-temperature-adaptive (PT-adaptive) level shifting and enhanced low-crosspoint control, the DAC demonstrates an IMD3 of 70.8 dBc at 7.2 GHz and $16 \text{Gs} / \mathrm{s}$, and a maximum output power of 7 dBm. An algorithm, named ISI-minimizing dynamic element matching (ISIM-DEM), is proposed to mitigate output distortion induced by inter-symbol interference (ISI) effect at $20 \text{GS} / \mathrm{s}$ sampling, achieving 73 dBc IMD3 at 8.5 GHz.},
  keywords={Switches;Displays;Indexes;Indexing;Radio frequency;Printing;Solids;Conferences;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409046},
}

@INPROCEEDINGS{11409328,
  author={Gurbaxani, Rishabh and Vaucher, Cicero S. and Babaie, Masoud},
  title={12.1 A 74fs-Jitter, -59dBc-Spur Fractional-N DPLL Using a Supply-Resilient Time-Amplifying Dual-Ramp DTC},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={This work presents a fractional-N digital PLL that employs a supply-resilient, time-amplifying dual-ramp DTC, which offers $8 \times$ time amplification and maintains its linearity under supply variations. Additionally, a DTC code-randomization technique is included to enhance the DTC gain-calibration accuracy and convergence speed at near-integer channels. The PLL achieves $<-59 \text{dBc}$ fractional spurs and 74fs rms jitter for a stable supply and 88.5fs rms jitter for a $29 \text{mV} \mathrm{V}_{\text{rms}}, 10 \text{MHz}$-bandwidth supply noise.},
  keywords={Accuracy;Noise;Linearity;Jitter;Solid state circuits;Phase locked loops;Convergence},
  doi={10.1109/ISSCC49663.2026.11409328},
}

@INPROCEEDINGS{11409147,
  author={Fagotti, Damiano and Moleri, Riccardo and Rossoni, Michele and Rizzini, Daniele Lodi and Salvi, Pietro and Gallucci, Stefano and Trotta, Giovanni Rocco and Lacaita, Andrea Leonardo and Dartizio, Simone Mattia and Levantino, Salvatore},
  title={A Fractional-N Digital PLL with a Supply-Insensitive DTC Achieving −62dBc Spur and 69fs Jitter Under 10mVpp Sinusoidal DTC Supply Ripple and 6.2mVrms DTC Supply Noise},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={A 28 nm fractional-N digital PLL with a supply-insensitive variable-slope digital-to-time converter (DTC) is presented. Supply insensitivity is achieved by a background calibration loop, without affecting DTC linearity or noise. Measured results demonstrate 65.6fs jitter upon 6.2 mVrms supply noise and -62dBc spurs under 10 mV pp supply-ripple over 10k-to-50 MHz disturbance frequency range. The PLL covers 8.75-to-10.25GHz tuning range, while achieving a -251 dB jitter-power figure of merit at 22.5 mW power.},
  keywords={Noise;Linearity;Jitter;Frequency measurement;Solid state circuits;Calibration;Noise measurement;Phase locked loops;Tuning},
  doi={10.1109/ISSCC49663.2026.11409147},
}

@INPROCEEDINGS{11409352,
  author={Salvi, Pietro and Rossoni, Michele and Moleri, Riccardo and Rizzini, Daniele Lodi and Fagotti, Damiano and Gallucci, Stefano and Lacaita, Andrea Leonardo and Dartizio, Simone Mattia and Levantino, Salvatore},
  title={A −66dBc-Worst-Fractional-Spur and 58fs-Jitter Fractional-N Digital PLL Using a Supply-Resilient Pseudo-Differential Inverse-Constant-Slope DTC},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={A fractional-N digital PLL adopting a pseudo-differential inverse-constant-slope DTC for rejection of supply disturbances is presented. Compared to traditional fractional-N digital PLLs, it requires no additional calibration for supply rejection or additional supply-insensitive blocks. The PLL achieves integrated jitter below 59fs under 10mVpp sinusoidal disturbance applied to the DTC supply in the fractional-N mode, with fractional spurs below −66dBc and the jitter-vs-power figure of merit of −251.4dB.},
  keywords={Jitter;Solid state circuits;Calibration;Phase locked loops},
  doi={10.1109/ISSCC49663.2026.11409352},
}

@INPROCEEDINGS{11409271,
  author={Liu, Yanchao and Li, Yang and Wang, Kaihang and Yu, Xiaohua and Ni, Ronghua},
  title={12.4 A 21.6fsrms-Jitter, −260.7dB-FoM Fractional-N PLL Enabled by an Intrinsically Linear Variable-Slope SPD for Quantization-Error Cancellation},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={This work presents a fractional-N PLL with an intrinsically linear variable-slope sampling phase detector for quantization-error cancellation. Linearity, noise, and power efficiency are improved by eliminating the edge-restoration buffer. Combined with the proposed charge-injection-based nonlinearity compensation, the 14GHz prototype PLL achieves 21.6fs rms jitter, −260.7dB FoM, and −67.4dBc worst-case spur in the fractional-N mode with 18.1mW power consumption in a 28nm CMOS process.},
  keywords={Power demand;Image edge detection;Noise;Prototypes;Linearity;Detectors;Jitter;CMOS process;Solid state circuits;Phase locked loops},
  doi={10.1109/ISSCC49663.2026.11409271},
}

@INPROCEEDINGS{11409284,
  author={Liu, Yichen and Zhang, Jian and Liu, Xiaosen and Wang, Yan},
  title={A 14GHz Chopper-Refolding Sampling PLL Achieving 33.8$\text{fs}_{\text{rms}}$ and 80.8dBc Reference Spur with a kT/C-Noise-Cancellation SPD},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={A 14 GHz chopper-refolding sampling PLL is implemented in 28 nm CMOS, integrating a kT/C-noise-cancellation sampling phase detector (SPD) and a self-injection VCO with harmonic-impedance expansion. The SPD decouples jitter and phase-detection gain, while the chopper-refolding scheme filters flicker noise. The VCO enables a high FoM without manual tuning, achieving $33.8 \text{fs}_{\text{rms}}$ jitter, −80.8 dBc spur, 16.9 mW power, and competitive jitter performance among integer-N PLLs.},
  keywords={Filters;Voltage-controlled oscillators;Manuals;Detectors;Jitter;Solid state circuits;1/f noise;Phase locked loops;Tuning},
  doi={10.1109/ISSCC49663.2026.11409284},
}

@INPROCEEDINGS{11408963,
  author={Li, Yixi and Chen, Junjie and Shen, Xinyu and Yang, Jie and Liu, Jian and Wu, Nanjian and Zhang, Zhao and Liu, Liyuan},
  title={A 0.65-to-1V-VDD 10.5-to-11.85GHz Fractional-N Sampling PLL Achieving 71.47fs Integrated Jitter and <-60dBc Near-Integer Fractional Spur in 40nm CMOS},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={This paper presents a 0.65-to-$1 \mathrm{V}, 10.5$-to-11.85 GHz wide-$\mathrm{V}_{\text{DD}}$-range (WV) fractional-N sampling PLL. The QE-reduction WV SPD, high-linearity 2-stage DTC, and DCC-aided QE dithering method are proposed to address the issue of poor phase noise at low $\mathrm{V}_{\text{DD}}$, reliability at regular $\mathrm{V}_{\text{DD}}$, nonlinearity, and convergence issues at small fractional FCWs. The 40 nm prototype achieves 71.47fs jitter, −251.8 dB FoM, and $<-60 \text{dBc}$ near-integer spur.},
  keywords={Phase noise;Prototypes;Jitter;Solid state circuits;Phase locked loops;Integrated circuit reliability;Convergence},
  doi={10.1109/ISSCC49663.2026.11408963},
}

@INPROCEEDINGS{11409001,
  author={Ma, Rui and Deng, Wei and Jia, Haikun and Lan, Juntao and Wang, Zhihua and Chi, Baoyong},
  title={A 7.15-to-7.95GHz Magnetically Enhanced Feedforward Waveform-Shaping CMOS Oscillator with Implicit Common-Mode Noise Cancellation Achieving −146.72 dBc/Hz PN@1MHz and 190.6dBc/Hz FoM},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={Pure microwave sources are vital for precision instrumentation, but conventional schemes are bulky and costly. CMOS oscillators are inexpensive and compact yet limited by phase-noise performance. To address this, we present a magnetically enhanced, feedforward waveform-shaping oscillator with an implicit common-mode noise-cancellation technique. Measurements show $-146.72 \text{dBc} / \text{Hz} \text{PN}$ at a 1 MHz offset and a $190.6 \text{dBc} / \text{Hz} \text{FoM}$ at a 7.5 GHz carrier.},
  keywords={Microwave measurement;Instruments;Noise cancellation;Microwave theory and techniques;Microwave circuits;Microwave oscillators;Solid state circuits;Magnetic circuits},
  doi={10.1109/ISSCC49663.2026.11409001},
}

@INPROCEEDINGS{11409304,
  author={Lan, Juntao and Deng, Wei and Jia, Haikun and Zhang, Shiwei and Wang, Zhihua and Chi, Baoyong},
  title={A 5.7mW@0.55V-to-50mW@0.9V Deeply Power-Scalable Reconfigurable Series-Resonance/Class-F VCO with Mutual-Inductance Self-Cancellation and Hybrid 8-Shaped Coupling Techniques},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={This work presents a 28nm deeply power-scalable reconfigurable series-resonance/ClassF VCO with mutual-inductance self-cancellation and hybrid 8-shaped coupling techniques, achieving power scalability from 5.7 to 93.1 mW. By switching between parallel-resonance (Class-F) and series-resonance modes, the VCO achieves −149 dBc/Hz PN and 192.8 dBc/Hz FoM at a 10 MHz offset. This design enables flexible PN-power scalability for Wi-Fi 7, IoT, and wearable devices.},
  keywords={Couplings;Voltage-controlled oscillators;Scalability;Switches;Hybrid power systems;Solid state circuits;Wearable devices;Wireless fidelity},
  doi={10.1109/ISSCC49663.2026.11409304},
}

@INPROCEEDINGS{11409061,
  author={Li, Yang and Liu, Yanchao and Wang, Kaihang and Pu, Dong and Yu, Xiaohua and Ni, Ronghua},
  title={12.9 A 10.2-to-16.2GHz Dual-Mode-Transformer-Based Wideband Series-Resonance VCO Achieving >201.1dBc/Hz FoMT at a 10MHz Offset},
  note={Section: Frequency Synthesizers and VCOs},
  abstract={This work presents a 28nm CMOS SR-VCO enabled by a dual-mode transformer with magnetic control, achieving a wide tuning range of 10.2 to $16.2 \text{GHz}(45.2 \%)$ and a high $\text{FoM}_{\mathrm{T}} / \text{FoM}_{\text{AT}} {@} 10 \text{MHz}$ of $201.1 / 207.7 \text{dBc} / \text{Hz}$. A transformer optimization method is introduced to ensure consistent performance across modes, achieving less than 2 dB variation in measured PN and FoM at 10 MHz. A sampling PLL incorporating the presented SR-VCO demonstrates rms jitter <18.1fs and $\text{FoM}_{\text{JT}}$ of −265.8 dB.},
  keywords={Voltage-controlled oscillators;Optimization methods;Jitter;Transformers;Solid state circuits;Phase locked loops;Wideband;Tuning},
  doi={10.1109/ISSCC49663.2026.11409061},
}

@INPROCEEDINGS{11409110,
  author={Li, Jiaming and Yao, Peng and Li, Xueqi and Hao, Zhenqi and Wu, Dabin and Li, Zhouzheng and Xianyu, Haishu and Li, Lin and You, Shujuan and Chiu, Taiwei and Sheng, Maojia and Yang, Wei and Zhang, Qingtian and Tang, Jianshi and Qian, He and Gao, Bin and Wu, Huaqiang},
  title={13.1 HYDAR: A 390K QPS, 1574K QPS/W Hybrid Analog/Digital Compute-in-RRAM Accelerator for Efficient Recommendation System},
  note={Section: Circuits for AI and AI for Circuits},
  abstract={We present the first 28nm hybrid compute-in-RRAM (CiR) accelerator for recommendation system (RecSys) based on the HYDAR framework: (1) DL ADCs enable early termination of non-Top-K calculations. (2) PPSP dataflow boosts throughput for irregular workloads. (3) A coarse-to-fine architecture preserves system recall accuracy. The 36M-RRAM CiR chip achieves 390K QPS with a SOTA 1574K QPS/W. The chips scale out to a 576M system for practical RecSys task, improving by 66x in QPS and 181x in QPS/W.},
  keywords={Accuracy;Computer architecture;Throughput;Solid state circuits;Recommender systems},
  doi={10.1109/ISSCC49663.2026.11409110},
}

@INPROCEEDINGS{11409170,
  author={Zhou, Jonathan and Karahan, Emir Ali and Park¹, Juho and Ghozzy¹, Sherif and Sengupta, Kaushik},
  title={AI-Enabled End-to-End Design in RFICs with Controllable Architectural Style from 'Classical' to 'Non-Intuitive' for mm-Wave/sub-THz LNAs},
  note={Section: Circuits for AI and AI for Circuits},
  abstract={This paper introduces a unified algorithmic design flow for low-noise amplifiers (LNAs), spanning specifications to layout and integrating topology, architecture, circuit, and electromagnetic (EM) design in one framework. The algorithm supports designer input from classical to unconventional architectures, enhancing interpretability, debugging, and usability. We demonstrate two LNAs covering 24 to 150GHz with state-of-the-art performance, including novel architectures uncovered by the algorithm.},
  keywords={Low-noise amplifiers;Layout;Debugging;Radiofrequency integrated circuits;Topology;Solid state circuits;Usability;Electromagnetics},
  doi={10.1109/ISSCC49663.2026.11409170},
}

@INPROCEEDINGS{11409315,
  author={Wormald, Luke D. and Hsu, Ying-Tuan and Dikopoulos, Evangelos and Tang, Wei and Datsko, Benjamin and Hammoud, Ali and Zhang, Zhengya and Flynn, Michael P.},
  title={Medusa: A Quantum-Inspired 200-Variable 1016-Clause Analog k-SAT Solver},
  note={Section: Circuits for AI and AI for Circuits},
  abstract={A quantum-inspired analog variable $k$-SAT solver supporting up to 200 variables and 1016 clauses. Enabling techniques include make/break feedback, distributed $k$-SAT logic, digital macro coupling, and feedback optimization. The 28nm CMOS prototype achieves a $4.92 \mu \mathrm{s}$ mean solution time and a 19.1nJ mean energy consumption for 50-variable 3-SAT problems with 100% solvability and accuracy, representing $3.5 \times$ and $3 \times$ improvements in energy and solution time respectively, compared to the state-of-the-art.},
  keywords={Couplings;Energy consumption;Accuracy;Prototypes;Solid state circuits;Logic;Optimization},
  doi={10.1109/ISSCC49663.2026.11409315},
}

@INPROCEEDINGS{11409220,
  author={Chenna, Vinay and Hashemi, Hossein},
  title={13.4 An Inverse-Designed Passively Coupled N-Path Filter with gm-Boosted Active HBT Switches},
  note={Section: Circuits for AI and AI for Circuits},
  abstract={A $0.8-\text{to}-2.6 \text{GHz} \mathrm{N}$-path filter with $\mathrm{g}_{\mathrm{m}}$-boosted HBT switches and inverse-designed nonresonant passive networks is presented to enhance dynamic range and tunability of passively coupled higher-order N-path filters. A hybrid real-binary inverse design algorithm capable of inserting variable-size MIM capacitors in layouts enables synthesis of compact multilayered low-GHz passives. A BiCMOS filter prototype achieves $>15 \text{dBm}$ P1dB, $<5 ~\text{dB}$ noise figure and $<4 ~\text{dB}$ insertion loss across the full tuning range.},
  keywords={Passive networks;Noise figure;Layout;Prototypes;Switches;Filtering algorithms;MIM capacitors;Heterojunction bipolar transistors;Solid state circuits;Tuning},
  doi={10.1109/ISSCC49663.2026.11409220},
}

@INPROCEEDINGS{11409264,
  author={Chenna, Vinay and Hashemi, Hossein},
  title={A Nonintuitively Frequency-Staggered Wideband mm-Wave Low-Noise Amplifier},
  note={Section: Circuits for AI and AI for Circuits},
  abstract={An algorithmic topology optimization framework is presented to autonomously synthesize nonintuitive, multilayered wideband mm -Wave LNAs with arbitrary stage count. Cooptimization of actives and passives directly at a layout level enables improved tradeoffs among metrics like gain, bandwidth, NF, and DC power. A 3-stage SiGe HBT LNA prototype fabricated in a 180 nm BiCMOS process achieves 26.3 dB gain, $22-\text{to}-46 \text{GHz} 3 \text{dB}$ bandwidth, 3.1 dB NF and 18 mW DC power, experimentally validating the method.},
  keywords={Low-noise amplifiers;Layout;Prototypes;Topology;Solid state circuits;Noise measurement;Wideband;Gain;Optimization;Silicon germanium},
  doi={10.1109/ISSCC49663.2026.11409264},
}

@INPROCEEDINGS{11409040,
  author={Jiang, Chen and Feng, Xiaodi and Shen, Xiaohan and Chen, Chixiao and Liu, Qi and Liu, Ming and Xu, Ningsheng},
  title={14.1 THz-TSI: A 0.33pJ/b 264Gb/s Through-Silicon Interconnect Module for 3D Integration Utilizing Terahertz Coupling},
  note={Section: Unusual Interconnects and Other Uses for Light},
  abstract={A through-silicon interconnect module for 3D integration utilizing THz coupling is presented, which achieves a record high data rate of $264 ~\text{Gb} / \mathrm{s}$ and efficiency of $0.33 \text{pJ} / \mathrm{b}$. Both bidirectional point-to-point link and broadcast mode are successfully demonstrated. This scheme offers highly competitive bandwidth and density with significantly simpler fabrication and lower cost. Furthermore, its high flexibility enables real-time adjustable interconnect topology to effectively reduce latency.},
  keywords={Couplings;Fabrication;Costs;Integrated circuit interconnections;Bandwidth;Real-time systems;Topology;Solid state circuits;Three-dimensional integrated circuits},
  doi={10.1109/ISSCC49663.2026.11409040},
}

@INPROCEEDINGS{11409254,
  author={Shoobi, Amirreza and Omirzakhov, Kaisarbek and Yu, Zhehao and Pirmoradi, Ali and Aflatouni, Firooz},
  title={14.2 An $8\lambda\times 38\text{Gb}/\mathrm{s}/\lambda$ 106fJ/b Optical WDM Transmitter in 45nm CMOS SOI},
  note={Section: Unusual Interconnects and Other Uses for Light},
  abstract={This paper presents an ultra-energy-efficient MRM based 8-channel optical WDM NRZ transmitter, employing a scalable driver topology combined with monolithic electronicphotonic integration, which minimizes packaging parasitics and enables a compact design within a footprint of 0.018 mm2 per-channel. The chip incorporates an autonomous concurrent wavelength-locking mechanism with near-zero static power consumption, achieving an aggregate data rate of 304 Gb/s at 106 fJ/b energy efficiency.},
  keywords={Integrated optics;Power demand;Optical design;Packaging;Wavelength division multiplexing;Energy efficiency;Topology;Solid state circuits;Optical transmitters;Optical signal processing},
  doi={10.1109/ISSCC49663.2026.11409254},
}

@INPROCEEDINGS{11409168,
  author={Zhu, Wenshuo and Jiang, Jianqiang and Sun, Xuan and Li, Zhenhao and Gu, Tingyi and Zhang, Xin and Huang, Cheng},
  title={A Single-Chip Laser Diode Driver with Built-In Frequency-Sweep Linearization for FMCW LiDAR},
  note={Section: Unusual Interconnects and Other Uses for Light},
  abstract={A laser diode driver with supply-intrinsic current shaping for FMCW LiDAR is presented. By combining a fast optical loop and an efficient switching loop, and with the LD fitted model realized in analog circuits, the design achieves closed-loop optical frequency linearization without MZI, external PD, or bulky equipment. Measurements in 180 nm CMOS confirm effective frequency-sweep linearization and tunable modulation capability in a compact, highly integrated design for mobile FMCW LiDAR.},
  keywords={Semiconductor device modeling;Laser radar;Frequency modulation;Optical design;Optical switches;Frequency measurement;Diode lasers;Solid state circuits;Optical modulation;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409168},
}

@INPROCEEDINGS{11409357,
  author={Feng, Shuo Sarah and Chen, Fuzhan and Ma, Ruitao Matthew and Bao, Hongyu Bruce and Zhong, Kangping and Lau, Pak Tao Alan and Yue, Chik Patrick},
  title={A 40Gb/s 8mW-OMA 1-to-N VCSEL Driver for Parallel and Wireless Optical Links Using 150nm GaN HEMT},
  note={Section: Unusual Interconnects and Other Uses for Light},
  abstract={This paper presents a 40Gb/s 1-to-N VCSEL driver using 150nm GaN HEMT with fT/fMAX of 50GHz/154GHz. The proposed topology can drive VCSEL arrays in series or parallel without the need of pre-driver, using a common-source main data stage and auxiliary adjustable bias stage for different array configurations. Measured optical eye diagrams show 8mW OMA at 40Gb/s NRZ with 3-tap FFE for 4 VCSELs in series under a 15V supply. The driver consumes 480mW. For PAM-4 input, the driver can support 38Gb/s.},
  keywords={Wireless communication;Optical variables measurement;HEMTs;Optical fiber communication;Topology;Solid state circuits;Arrays;Vertical cavity surface emitting lasers;Optical signal processing},
  doi={10.1109/ISSCC49663.2026.11409357},
}

@INPROCEEDINGS{11409127,
  author={Privitera, Marco and Naveed, Muhammad Zahid and Ballo, Andrea and Giustolisi, Gianluca and Grasso, Alfio Dario and Alioto, Massimo},
  title={Highly-Integrated Light-Sensing System with RF Harvesting and Transmission in Commercial N-Type IGZO Flexible Technology},
  note={Section: Unusual Interconnects and Other Uses for Light},
  abstract={A sticker-like light sensing system is demonstrated in flexible N type-only IGZO TFT. It reuses RF signals for harvested battery charging and backscattered communications, and repurposes resistors as light sensors. Low-power operation is enabled by techniques for state-of-the-art efficiency in voltage regulation, signal amplification, data conversion and pseudo-dynamic logic. Indoor light sensing and 0.9 GHz data transmission are demonstrated with $2.02 \text{mm}^{2}$ area at $15.5 \mu \mathrm{W}$ ($<1 {\%}$ duty cycle).},
  keywords={Resistors;Radio frequency;Data conversion;RF signals;Sensors;Thin film transistors;Solid state circuits;Logic;Data communication;Voltage control},
  doi={10.1109/ISSCC49663.2026.11409127},
}

@INPROCEEDINGS{11409258,
  author={Lee, Eunseok and Jung, Jaehong and Ashok, Maitreyi and Chandrakasan, Anantha P. and Han, Ruonan},
  title={Self-Programmable Twin PUFs via Photovoltaic Energy Harvesting During the Pre-Wafer-Dicing Stage},
  note={Section: Unusual Interconnects and Other Uses for Light},
  abstract={We present a CMOS self-programmable twin PUF which can be formed at the pre-wafer-dicing stage via photovoltaic harvesting. Two adjacent PUFs share entropy during oxide breakdown, enabling mutual authentication without pre-stored secrets. The prototype is implemented with twin PUF macros with a $128 \times 8$ array and achieves 98.4% pairwise consistency with 0.4% native BER. Using a low-cost LED, we demonstrate photovoltaic twin-PUF generation, confirming wafer-level batch processing feasibility.},
  keywords={Photovoltaic systems;Electric breakdown;Prototypes;Batch production systems;Authentication;Light emitting diodes;Entropy;Solid state circuits;Energy harvesting},
  doi={10.1109/ISSCC49663.2026.11409258},
}

@INPROCEEDINGS{11409136,
  author={Thimmaiah, Jayanth M. and Yamashita, Ryuji and Yoon, In-Soo and Li, Jason and Hsu, Cynthia and Ariki, Takuya and Ookuma, Naoki and Kato, Yosuke and Hayashi, Koichiro and Yamauchi, Kazuki and K V, Indra and Kano, Masahiro and Bhamidipati, Sirisha and Bhatia, Sneha and Malhotra, Seema and Ojima, Naoki and Wu, Ella and Yang, Zhiyong and Tsai, Frank W. and Bayle, Mathias and Minami, Naoyuki and Fujihara, Yasuyuki and Kitamura, Kei and Kitani, Tomofumi and Kodama, Takuyo and Handa, Takaya and Kanagawa, Naoaki and Ishizaki, Yuki and Fujimura, Susumu and Suzuki, Yoshinao and Sako, Mario and Higashi, Yumi and Watanabe, Yoshihisa and Kouchi, Toshiyuki and V, Aravinth and Chen, Chin-Yi and Yang, Xiang and Liang, Guirong and Wang, Jenny},
  title={A 2Tb 4b/Cell 6-Plane 3D-Flash Memory with 37.6Gb/mm2 Bit Density and >85MB/s Write Throughput},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={A 332-WL-layer stacked 2Tb 4b/Cell 6-plane 3D Flash memory achieves an areal density of $37.6 \text{Gb} / \text{mm}^{2}$. An 8 kB -physical and 16 kB -logical page architecture realizes a $<65 \mu \mathrm{s}$ read latency and a $>85 \text{MB} / \mathrm{s}$ program throughput. Write throughput is enhanced by 4.2% through voltage-level sensing based on SEN2-LBUS coupling, and an additional 8% by reduced verify operations using 4 check points. A fast SLC burst programming technique reduces program time by $\sim 11 {\%}$.},
  keywords={Couplings;Three-dimensional displays;Programming;Throughput;Solid state circuits;Sensors;Flash memories},
  doi={10.1109/ISSCC49663.2026.11409136},
}

@INPROCEEDINGS{11409350,
  author={Trivedi, Manish and Sinha, Sandipan and Halli, Ramesh and Gurumurthy, Girishankar and Singh, Jaswinder and Cheng, Chun-Yuan and Chen, Linchien and Lin, Jeff and Mair, Hugh},
  title={15.2 A 350mV Single-Rail SRAM Using a Custom-Logic-Bitcell in 2nm-CMOS-Nanosheet Technology for Mobile and Edge-AI Applications},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={This work presents a single-rail, $21.04 \text{Mb} / \text{mm}^{2}$ logic-bitcell 2-port SRAM in a 2 nm nanosheet technology for CPU, GPU and NPU caches. The implemented ×BIT cell in a $2 \mathrm{R} \times 1 \mathrm{C}$ configuration uses dual BL for balanced NMOS/PMOS devices to form a rectangular array and maximize area density. Optimized for dynamic power, it operates reliably from $0.35-1.2 \mathrm{V}$, achieving an industry-leading 102ps read-access time to support 4 GHz processor and making it ideal for shallow-depth caches.},
  keywords={Random access memory;Graphics processing units;Solid state circuits;Central Processing Unit;Integrated circuit reliability},
  doi={10.1109/ISSCC49663.2026.11409350},
}

@INPROCEEDINGS{11409300,
  author={Shin, Hyunjin and Kang, Gyuseong and Kim, Yeseul and Kim, Dohui and Kim, Kyuseong and Lee, Sunkyu and Lee, Hangil and Won, Sanggyeong and Kim, Mijoung and Lee, Jaeho and Ko, Seungpil and Shim, Jaechul and Han, Shinhee and Suh, Kiseok and Hwang, Sohee and Lee, Hyunchang and Jung, Jonghoon and Baek, Sanghoon},
  title={15.3 An 8nm eMRAM for Auto-G1 with a 125MHz Read Speed at 0.6V and 19.94Mb/mm2 Density},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={This paper proposes techniques to improve read margin and write performance for an 8nm eMRAM: temperature compensation, resistance-mismatch improvement and margin-verify-write MVW. These techniques enable 8ns read and 300ns write operations for 283b at a time with a 128Mb density in a temperature range of −40 −150°C and from a 0.60V supply. A 19.94Mb/mm2 memory macro is implemented and silicon validation shows a mass-production yield is achieved.},
  keywords={Temperature distribution;Silicon;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409300},
}

@INPROCEEDINGS{11409096,
  author={Lee, Po-Hao and Lee, Chia-Fu and Lin, Hon-Jarn and Lu, Cheng-Han and Chang, Yen-An and Sanjaya, Pranata W. and Tsen, Chia-Jung and Chen, Kuan-Chun and Lin, Ming-Chieh and Hung, Chao-Jung and Chou, Tan-Li and Weng, Chih-Hui and Wang, Chia-Yu and Wu, J.J. and Chuang, Harry and Wang, Yih and Chih, Yu-Der and Chang, Tsung-Yung Jonathan},
  title={15.4 A 16nm 168Mb Embedded STT-MRAM with 0.0249µm2 Bit-Cell, Dual-Port Access, and 51.2Gb/s Read Throughput for Automotive and Edge AI Applications},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={A 16nm 168Mb embedded STT-MRAM with a 0.0249μm2 bit cell that overcomes density and performance challenges of competing NVM technologies is presented. The design features a modular architecture supporting customizable macros, a dual-port access scheme, and an interleaving read architecture achieving a 51.2Gb/s throughput. Fabricated in a 16nm FinFET process, the chip demonstrates a 20-year data retention at 150°C, 1M-cycle write endurance, and is suitable for automotive and edge AI applications.},
  keywords={Microprocessors;Computer architecture;Edge AI;Throughput;FinFETs;Solid state circuits;Automotive engineering},
  doi={10.1109/ISSCC49663.2026.11409096},
}

@INPROCEEDINGS{11409338,
  author={Nagata, Shunya and Sawada, Yohei and Takiguchi, Kenichiro and Morimoto, Masao and Tanaka, Shinji and Fujita, Naoya and Miura, Tomohiro and Nakamura, Daisuke and Ito, Takashi},
  title={A 3nm 0.167fJ/b 5.27Mb/mm2 Configurable TCAM with Macro-Wise Pipelined Search Methods for Automotive Applications},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={This paper presents a TCAM design that includes a bank-less small-grain TCAM-macro compiler, a configurable soft-macro generator, selective macro-wise pipelined search techniques, and a split data-bus architecture for ECC. The proposed TCAM achieves 0.167fJ/b search energy and 5.27Mb/mm2 density with a 512-entry and 256b search key configuration in a 3nm bulk Fin-FET process technology for automotive network applications.},
  keywords={Search methods;Automotive applications;Generators;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409338},
}

@INPROCEEDINGS{11409139,
  author={Joo, Sunghwan and Kim, Jinyeon and Lee, Yongsun and Kim, Ji-Young and Lee, Youngsik and Kim, Yong-Min and Oh, ChiSung and Shim, Kyu-Ha and Lee, Haesuk and Byun, Young-Yong and Bae, ChangHyun and Kim, Joohwan and Ryu, Je-Min and Kang, Shin-haeng and Lee, Jaehoon and Chang, Young-Uk and Lee, JaeKyung and Hwang, JongTae and Seo, Daehwan and Na, Ki-Heon and Song, Young Guen and Lim, Daihyun and Ha, Kyung-Soo and Sohn, Young-Soo and Hwang, Sang-Joon},
  title={15.6 A 36GB 3.3TB/S HBM4 DRAM with Per-Channel TSV RDQS Auto Calibration and Fully-Programmable MBIST},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={LLM-based generative AI requires high-capacity and high-bandwidth memory. We propose an HBM4 with 2048 I/Os, 3.3TB/s bandwidth, and 36GB cube density. Core die uses the 6th gen. DRAM and the base die uses a 4nm Fin-FET process. TSV count and data window are doubled for high-frequency margin. tCCDR is improved via per-channel TSV-RDQS auto calibration, enhancing rank-to-rank access. PMBIST enables at-speed testing in CoW and SiP. The on-die WDQS skew cancellation ensures robust timing, enabling reliable highspeed operation and improved yield.},
  keywords={Generative AI;Memory management;Random access memory;Cows;Calibration;Timing;Solid state circuits;Through-silicon vias;Integrated circuit reliability;Testing},
  doi={10.1109/ISSCC49663.2026.11409139},
}

@INPROCEEDINGS{11409121,
  author={You, Jungtaek and Kim, Mino and Kwon, Daehan and Yoon, Sangsic and Park, Joonhong and Do, Hyungrok and Park, Jeongje and Jung, Yooseok and Lee, Seongseop and Kim, Kyuyoung and Jeong, Hyeongsoo and Kang, Jaeyeol and Kwon, Hanbyeol and Oh, Minwook and Kim, Jieun and Oh, Jinseok and Hong, Gi-Moon and Ka, Dongyoon and Lee, Seungho and Song, Heewoong and Kim, Minchang and Yun, Daeho and Kwon, Sooncheol and Lee, Dongbeom and Shin, Taekyun and Lee, Jongmyeong and Yoon, Jungmin and Kang, Kyeongpil and Heo, Sanghyuk and Kim, Dongkyun and Jang, Jieun and Kim, Hyungsoo},
  title={A 1cnm 14.4Gb/s/pin 16Gb LPDDR6 SDRAM with Efficiency Mode, LDO-Based WCK Tree, Dynamic Write NT-ODT, Fast CS Control and System Meta Mode},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={This paper presents a 16 Gb LPDDR6 DRAM in a 1 cmm process, compliant with the JEDEC LPDDR6 specification. In implementing LPDDR6 functions, measures were taken to limit increase in power: including dynamic WR NT-ODT, LDO regulator-based WCK distribution, adding efficiency mode with power gating techniques, using fast CS control and system meta mode. These techniques enhance per-channel bandwidth by more than 50%, achieve $14.4 \text{Gb} / \mathrm{s}$ at 1.025 V and improve power efficiency by over 20% compared to LPDDR5.},
  keywords={Power measurement;Trees (botanical);Bandwidth;Control systems;Solid state circuits;Velocity measurement;SDRAM},
  doi={10.1109/ISSCC49663.2026.11409121},
}

@INPROCEEDINGS{11409018,
  author={Kim, Kiheung and Song, Hong-Joo and Um, Youngdo and Jang, Jinhun and Lee, Seungjun and Seol, Hoseok and Kwon, Hye-Jung and Seol, Ji-Hwan and Shin, Hoon and Lee, Jaehyung and Choi, JongMoon and Yoon, Sung-Woo and Kim, Sang Yun and Lee, Dongkeon and Jang, Minsoo and Kwon, Daehyun and Lee, Sangyong and Kim, Jinguk and Kim, Jonghyuk and Jung, In and Song, Taeha and Kim, Chang Won and Baek, Seung Ho and Choi, Jinyong and Seo, Young-Hun and Choi, Won Ho and Yoo, Changsik and Hwang, SangJoon},
  title={A 16Gb 12.8Gb/s LPDDR6 SDRAM with 12-DQ/Sub-Channel Wide NRZ Signaling and Enhanced Reliability by Per-Row Activation Counting and Meta-Data Scheme},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={This paper presents a $12.8 \text{Gb} / \mathrm{s} /$ pin LPDDR6 SDRAM implemented in a $10-\text{nm}$ class process. It shows 33.3% higher bandwidth and 21.0% better energy efficiency than LPDDR5x by using wide NRZ signaling (12 DQ/sub-channel with two sub-channels) and optimum allocation of two supply rails (1.0 and 0.875 V) across functional blocks. The dynamic and static efficiency modes provide better energy efficiency and higher capacity, respectively by dynamically or statically turning off the I/O circuitry of a sub-channel.},
  keywords={Rails;Bandwidth;Turning;Energy efficiency;Solid state circuits;Pins;SDRAM;Resource management;Optical signal processing;Integrated circuit reliability},
  doi={10.1109/ISSCC49663.2026.11409018},
}

@INPROCEEDINGS{11409122,
  author={Park, Hyunsu and Lee, Sungkwon and Kim, Kyunghoon and Cha, Jinyoup and Ko, Hyeongjun and Yang, Jaehyeok and Kim, Seongjin and Kim, Youngtaek and Park, Minsoo and Lee, Gangsik and Lee, Keonho and Lee, Sanghoon and Lee, Jiseok and Jeon, Gyunam and Jeong, Sera and Joo, Yongsuk and Cha, Jaehoon and Hwang, Seonwoo and Kim, Seulgi and Song, Eunji and Ji, Junghwan and Kang, Byungjun and Kim, Boram and Byeon, Sangyeon and Chi, Hankyu and Kim, Hyungsoo and Kim, Jonghwan},
  title={15.9 A 48Gb/s 24Gb GDDR7 DRAM for Mid-Range Inference AI with Symmetric 2CH-Mode Operation, Clock-Path Optimization, and RAS Features},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={This paper introduces a GDDR7 DRAM for mid-range inference AI. A center GIO architecture is used to remove the speed penalty of the 2CH mode, which doubles memory density and reduces the clock path. This work supports ECC, CRC, and DPP to meet the RAS features required in server systems. Additionally, energy efficiency is enhanced for on-device AI applications through a low- V_DDQ mode. For nominal conditions, with a 1.2 V supply voltage, a 48 Gb/s data transmission speed is achieved.},
  keywords={Random access memory;Voltage;Energy efficiency;Solid state circuits;Error correction codes;Servers;Data communication;Artificial intelligence;Optimization;Clocks},
  doi={10.1109/ISSCC49663.2026.11409122},
}

@INPROCEEDINGS{11409152,
  author={Yoon, Hyunchul and Park, Youngseok and Park, Tae Jin and Kim, Suk Lae and Jung, Seungjae and Kim, Daesun and Kim, Kyunghwan and Kim, Yongjun and Kang, KyuChang and Won, Bokyeon and Jung, Sang-Hoon and Woo, Seunghan and Kim, Donggeon and Kim, Jonghyuk and Jung, In and Kim, Junsoo and Song, Jae-Joon and Nam, InCheol and Seo, Young-Hun and Yim, Sungsoo and Park, Jemin and Yoo, Changsik and Hwang, SangJoon},
  title={15.10 A Vertical-Cell-Transistor-Based 4F2 DRAM with Cell-on-Peripheral Architecture Using Wafer-to-Wafer Hybrid Copper Bonding},
  note={Section: DRAM, SRAM, and Non-Volatile Memories},
  abstract={The paper presents a 16Gb SDRAM with a vertical-channel-transistor-based 4F2 cell and cell-on-peripheral (COP) architecture. Wafer-to-wafer hybrid copper bonding is applied to COP, which increases the total die count per wafer by more than 20 % with the same design rules. Fabricated in a 10 nm-class DRAM process, the test chip performs read and write operations successfully, opening the possibility for further DRAM-technology scaling.},
  keywords={Microprocessors;Computer architecture;Solid state circuits;Copper;SDRAM;Bonding},
  doi={10.1109/ISSCC49663.2026.11409152},
}

@INPROCEEDINGS{11409208,
  author={Zhong, Ziyang and Martins, Rui P. and Huang, Mo},
  title={16.1 PV Energy-Harvesting Interface Using Reconfigurable Self-Clamp CSCR Converter Achieving 3.83× High-Efficiency VCR Ratio and Open-Voltage-Sense-Free MPPT},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This work presents a PV energy harvesting interface using a self-clamp CSCR SC converter. It reduces VCF stress without additional SC stages, enabling low-voltage CFS, 17.1mW/mm2 power density and 90 % peak PCE. A reconfigurable self-clamp scheme extends the high-PCE VCR ratio to 3.83 using only 13 CFs, outperforming prior works. An open-circuit MPPT scheme reuses the converter as a slope sensor, eliminating the open-voltage sensor, while reconfiguration enhances MPPT accuracy under VIN variations.},
  keywords={Power system measurements;Low voltage;Accuracy;Density measurement;Solid state circuits;Energy harvesting;Video recording;Stress},
  doi={10.1109/ISSCC49663.2026.11409208},
}

@INPROCEEDINGS{11409246,
  author={Zhang, Rui and Wang, Chuhui and Ye, Zhongxin and Leung, Ka Nang and Guo, Jianping},
  title={16.2 A Bias-Flip-Based Piezoelectric Energy Harvesting Interface with a Digital Track-and-Lock MPPT Achieving Sampling-Free Operation and 99.8% MPPT Efficiency},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={A fully digital MPPT is proposed for a bias-flip piezoelectric energy harvester. Once the MPP is identified, its parameters are stored and locked. Even if the vibration amplitude or frequency changes or disappears entirely, it directly operates at the pre-recorded MPP state. There is no need for repeated tracking, thus ensuring continuous maximum power output. By reusing the zero-current detector used for switching control, no dedicated sampling operation is required for MPPT. The measured IQ of the MPPT circuit is 17nA, and the peak MPPT efficiency is 99.8%.},
  keywords={Vibrations;Energy measurement;Switches;Detectors;Control systems;Solid state circuits;Energy harvesting},
  doi={10.1109/ISSCC49663.2026.11409246},
}

@INPROCEEDINGS{11409317,
  author={Wu, Xiaonan and Yuan, Jinyi and Shang, Minghao and Wang, Baochuang and Du, Sijun and Cheng, Lin},
  title={A Fully Integrated Piezoelectric Energy-Harvesting Interface with Single-Stage Bias-Flip and MPPT Achieving $\mathbf{5. 6 3} \boldsymbol{\times}$ Maximum Output Power Improving Rate},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This paper presents a fully integrated PEH interface that enhances output power while minimizing on-chip capacitor area. The proposed design employs a SC structure that reuses both the piezoelectric capacitor and the rectifier capacitor as flying capacitors. Meanwhile, on-chip capacitors serve as DC capacitors, thereby eliminating parasitic-capacitance losses. As a result, the interface achieves a maximum output power improvement of $5.63 \times$ and a normalized on-chip capacitor area of $0.09 \text{mm}^{2} / \text{nF}$.},
  keywords={Capacitors;Rectifiers;System-on-chip;Solid state circuits;Power generation},
  doi={10.1109/ISSCC49663.2026.11409317},
}

@INPROCEEDINGS{11408962,
  author={Peng, Wenyu and Peng, Jida and Van Driel, Willem and Zhang, Guoqi and Du, Sijun},
  title={16.4 A One-Stage Bidirectional Rectifier with Pre-Charge-Based MPPT for Triboelectric Energy Harvesting with 93% MPPT Efficiency and 8.86× Power Enhancement},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This work proposes a one-stage bidirectional rectifier with a pre-charge voltage (VPC) based perturb-and-observe (P&O) maximum power point tracking (MPPT) algorithm for triboelectric energy harvesting. The proposed VPC-based MPPT dynamically locates the true MPP while accounting for circuit non-idealities, using a simplified implementation compared to conventional P&O methods. Consequently, it achieves 93% MPPT efficiency and 8.86× energy enhancement compared to the full-bridge rectifier.},
  keywords={Maximum power point trackers;Heuristic algorithms;Rectifiers;Voltage;Solid state circuits;Energy harvesting;Triboelectricity},
  doi={10.1109/ISSCC49663.2026.11408962},
}

@INPROCEEDINGS{11408952,
  author={Yang, Yunzhe and Du, Sijun},
  title={A Single-Inductor Multi-Channel Thermoelectric Energy Harvesting Interface Realizing Uneven Temperature MPPT with 39.6% Efficiency Enhancement and 62mV Tapped-Inductor-Oscillator-Based Start-Up},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This paper presents a thermoelectric energy harvesting (TEH) interface that realizes: 1) a multi-channel TEH for maximum power point tracking (MPPT) under uneven temperature conditions, improving efficiency by up to 39.6% and 2) a tapped-inductor start-up functionality, which can begin operating at 62 mV with no additional inductors or series switches. The overall design achieves a 90.51% peak end-to-end efficiency.},
  keywords={Maximum power point trackers;Solid state circuits;Energy harvesting;Inductors},
  doi={10.1109/ISSCC49663.2026.11408952},
}

@INPROCEEDINGS{11409337,
  author={Yang, Jianxin and Martins, Rui P. and Huang, Mo},
  title={16.6 A Parameter-Free Runtime-Energy-Loss Optimizer Achieving 2.15% Error in Energy-Recycling Duty-Cycled Systems},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This work proposes a predefined-parameter-free runtime-Eloss optimizer for energy-recycling duty-cycled systems. By leveraging a 3 -level converter to recycle output-capacitance energy to the flying capacitor, it achieves <2.15 % deviation from optimal Eloss with increased robustness against battery voltage and leakage current variations. It achieves a quiescent current of 15 nA and an 80% efficiency at a 1µA load current, while eliminating sub-harmonic oscillation. It saves energy loss by up to 60% across a wide range of time spent in the sleep state.},
  keywords={Energy loss;Capacitors;Voltage;Robustness;Solid state circuits;Recycling;Batteries;Leakage currents;Oscillators},
  doi={10.1109/ISSCC49663.2026.11409337},
}

@INPROCEEDINGS{11409265,
  author={Jiang, Shunmin and Wang, Tiansu and Mercier, Patrick and Du, Sijun},
  title={A 90.7%-Efficiency Piezoelectric Resonator-Based Sigma Converter with 6-Phase 2-DoF on-Chip Regulation and Zero-Standby Sigma Mode for Transient and Output Power Enhancement},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This paper proposes an on-chip sigma regulation system for the accurate and power-efficient control of piezoelectric resonator (PR)-based DC-DC converters to address the challenges of conventional off-chip controllers. A zero-standby sigma-mode is implemented for transient response/output power improvement. Peak efficiencies of 91.2% and 90.7% are achieved for the PR converter and the PR-sigma converter respectively.},
  keywords={Accuracy;2-DOF;DC-DC power converters;Regulation;System-on-chip;Solid state circuits;Transient analysis;Power generation},
  doi={10.1109/ISSCC49663.2026.11409265},
}

@INPROCEEDINGS{11409124,
  author={Wang, Yuanfei and Zhang, Zhiyuan and Zhang, Yihan and Martins, Rui P. and Huang, Mo},
  title={16.8 A Battery Charger Based On Mesh-Connection 2×CF Continuously-Scalable-Conversion-Ratio Converter Achieving $\mathbf{3. 2 W} / \mathbf{m m}^{\mathbf{3}}$ Power Density},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This work presents a battery charger for smartwatches based on a mesh-connected continuously scalable-conversion ratio converter that uses only two flying capacitors. The proposed design reduces the number of invalid phases along with the switch and routing resistance, achieving 89.2% efficiency at a 16.8 W output and a power density of $3.2 ~\mathrm{W} / \text{mm}^{3}$. A shared-error-amplifier scheme ensures a smooth transition between constant current & constant voltage modes. With a peak power conversion efficiency of 92%, this compact and efficient design is well-suited for smartwatch applications.},
  keywords={Battery chargers;Resistance;Power system measurements;Density measurement;Capacitors;Voltage;Switches;Routing;Solid state circuits;Power conversion},
  doi={10.1109/ISSCC49663.2026.11409124},
}

@INPROCEEDINGS{11409319,
  author={Kim, Minsu and Lee, Yunho and Park, Hyunjun and Kim, Hongseok and Jung, Woojoong and Kim, Minwoo and Bae, Junhyun and Oh, Hyoung-Seok and Yu, Hwayeal and Lee, Hyung-Min},
  title={16.9 A 96.6% Single-Mode Hybrid Dual-Path Buck-Boost Converter with Conduction Loss Reduction through Conversion-Ratio-Based Adaptive 3-Phase Control},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={This paper presents a 3-phase dual-path buck-boost converter that effectively reduces conduction loss by combining a dual-path topology with adaptive 3-phase control. The proposed control technique minimizes inductor current ripple, which allows the use of a low-inductance inductor with low DCR, while reducing the inductor current. Fabricated in a $0.13 \mu \mathrm{m}$ CMOS process, the converter achieves a high peak-efficiency of 96.6% with a small $1.92 \text{mm}^{3}$ inductor and 0402-size flying capacitors.},
  keywords={Capacitors;CMOS process;Topology;Solid state circuits;Inductors},
  doi={10.1109/ISSCC49663.2026.11409319},
}

@INPROCEEDINGS{11409288,
  author={Ballo, Andrea and Yang, Ruiyuan and Ali, Karim and Alioto, Massimo Bruno},
  title={Fully Integrated Mm-Scale 5G RF MIMO Harvester with −40dBm Sensitivity and Spatial MPPT via Hybrid Transformer-Based Combining/Shifting},
  note={Section: Energy Harvesting, Piezo and Chargers},
  abstract={A MIMO RF harvester in the 5G 28-GHz band with spatial MPPT is introduced to self-align high-gain harvesting direction with maximum power availability. Spatial scanning is enabled by a hybrid 2-level RF/DC antenna power combining and phase shifting based on transformers, while eliminating conventional off-chip capacitor(s). A 22nm test-chip shows −40dBm harvesting sensitivity, and power conversion efficiency of 56.7% at $0 \text{dBm}(1.3 \times$ better than prior art at 28GHz).},
  keywords={Radio frequency;Sensitivity;Art;5G mobile communication;Hybrid power systems;Solid state circuits;Power conversion;Antennas},
  doi={10.1109/ISSCC49663.2026.11409288},
}

@INPROCEEDINGS{11409351,
  author={Skende, A. and Rosseel, G. and Pinckney, N.},
  title={17.1 NVIDIA GB10: SoC Built for AI Acceleration},
  note={Section: Highlighted Chip Releases for AI},
  abstract={This paper details the GB10 SoC that powers the recently launched DGXTM Spark workstation. A dual-die solution, fabricated in TSMC's 3 nm process, co-packages a CPU die featuring 20 ARM v9.2 cores alongside a Blackwell iGPU die tuned for desktop performance. The GPU features 5th-generation Tensor Cores, 4th-generation RT cores, and 24MB of L2 cache, achieving 31TFLOPS of FP32 and 1PFLOPS of FP4.},
  keywords={Tensors;Graphics processing units;Workstations;Solid state circuits;Central Processing Unit;Sparks;Artificial intelligence},
  doi={10.1109/ISSCC49663.2026.11409351},
}

@INPROCEEDINGS{11409013,
  author={Desoli, G. and Agaësse, J-F. and Chawla, N. and Hilkens, E. and Boesch, T. and Taufour, V. and Ayodhyawasi, M. and Ravenhill, P. and Pal-Singh, S. and Soulie, M.},
  title={17.2 the STM32N6 Microcontroller: Enabling Intelligent Edge AI for IoT and Beyond},
  note={Section: Highlighted Chip Releases for AI},
  abstract={The STM32N6 microcontroller meets the growing need for intelligent edge devices in IoT, wearables, industrial automation, and smart home systems supporting real-time, energyefficient AI processing at the edge, reducing latency and enhancing data privacy by limiting cloud reliance. At its core, the Neural-ART neural processing unit delivers complex and power efficient AI inference. This paper examines the chip's 16nm FinFET design, performance, computational power and energy efficiency.},
  keywords={Data privacy;Limiting;Microcontrollers;Smart homes;Edge AI;FinFETs;Real-time systems;Energy efficiency;Solid state circuits;Wearable devices},
  doi={10.1109/ISSCC49663.2026.11409013},
}

@INPROCEEDINGS{11409083,
  author={Shin, D. and Yang, H. and Jeon, S. and Park, J. and Han, S. and Park, J. and Lee, J. and Kim, J. and Kim, H. and Oh, Y. and Kim, M. and Jung, C. and Kim, W. and Kim, S. and Jeong, H. and Kim, G. and Lee, K. and Song, G. and Min, Y. and Song, C. and Kanybek, A. and Jung, Y. and Song, J. and Cho, S. and Na, H. and Park, J. and Si, D. and Lee, B. and Park, B. and Jeon, H.},
  title={17.3 ARIES and REGULUS: A Unified and Scalable hardware–software co-designed NPU SoC Family for On-Device and On-Premises Multimodal Inference},
  note={Section: Highlighted Chip Releases for AI},
  abstract={We present a scalable NPU architecture, proven in two SoCs (ARIES and REGULUS), designed to efficiently execute diverse AI workloads from vision to large language models. The architecture scales seamlessly across cores, clusters, and chips via a unified programming model. Our holistic hardware-software co-design preserves model accuracy through a bound- and distribution-aware mixed-precision quantization scheme, while efficiently handling complex activation functions via a non-uniform piecewise-linear method. Silicon measurements demonstrate near-linear performance scaling and high power and bandwidth efficiency on both vision and language workloads.},
  keywords={Semiconductor device measurement;Quantization (signal);Power measurement;Accuracy;Spectral efficiency;Large language models;Programming;Silicon;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409083},
}

@INPROCEEDINGS{11409201,
  author={Xu, S. and Mandal, G. and Jahagirdar, S. and Tripathy, S. and Parthasarathy, P. and Srinivasan, S. and Levin, A.},
  title={17.4 Maia: A Reticle-Scale AI Accelerator},
  note={Section: Highlighted Chip Releases for AI},
  abstract={In Paper 17.4, the architecture and implementation of Microsoft's MAIA AI silicon, a reticle-scale 750W AI SoC, is presented. Innovation across power delivery, thermal management, physical design, validation, and packaging is detailed, resulting in a scalable approach to high-performance AI acceleration.},
  keywords={Technological innovation;Data centers;Software design;AI accelerators;Packaging;Thermal management;Silicon;Energy efficiency;Solid state circuits;Physical design},
  doi={10.1109/ISSCC49663.2026.11409201},
}

@INPROCEEDINGS{11409067,
  author={Thonnart, Yvain and Bernard, Christian and Bernabe, Stephane and Assous, Myriam and Boutafa, Laura and Charbonnier, Benoit and Franiatte, Remi and Fuguet, Cesar and Guille, Olivier and Josselin, Vincent and Malhouitre, Stephane and Mendizabal, Laurent and Myko, Andre and Patrice, Damien Saint and Velard, Remi and Charbonnier, Jean},
  title={A 3.19pJ/b Electro-Optical Router with 18ns Setup Frame-Level Routing and 1-to-6 Wavelength-Flexible Link Capacity for Photonic Interposers},
  note={Section: Technology and Circuits for Domain-Specific Accelerators},
  abstract={Global interconnect on interposers between chiplets is currently mostly limited to nearest-neighbor communication. We propose an electro-optical router in 28nm on a photonic interposer to handle queuing and routing between dies and optical link drivers capable of 18ns link setup time for frame-level routing, with 1-to-6 lambda flexible wavelength capacity. Compact analog drivers and standard-cell-based SerDes and clocking achieve 0.007mm2 active area per link and 3.19pJ/b power.},
  keywords={Chiplets;Integrated circuit interconnections;Routing;Optical fiber communication;Solid state circuits;Electro-optical waveguides;Photonics},
  doi={10.1109/ISSCC49663.2026.11409067},
}

@INPROCEEDINGS{11409100,
  author={Ren, Wenjie and Li, Mingxuan and Jin, Zhenghao and Ding, Yifan and Xu, Ruohuang and Ye, Xiangjun and Ma, Yufei and Jia, Tianyu and Ye, Le},
  title={18.2 A 22nm 1.87ms/Frame Streaming Multi-Speaker ASR Accelerator Leveraging Contextual-Aware Redundancy Skipping with 2D-Writable Microscaling Compute-in-Memory and Similarity-Aware TCAM Design},
  note={Section: Technology and Circuits for Domain-Specific Accelerators},
  abstract={This paper presents a DCIM-based accelerator for on-device streaming multi-speaker ASR (MS-ASR), featuring: 1) a context-aware redundancy skipping scheme with online sparse block prediction, 2) a 2D-writable CIM with static pages and dynamic pages, 3) a similarity-aware TCAM for rapid search of similar speakers and N-best semantic results. The test chip achieves a system energy efficiency of 37.50TFLOPS/W in MXFP8 and shows superior performance on MS-ASR tasks with $1.87-7.51 \text{ms} /$ frame and $0.158-1.26 \text{mJ} /$ frame efficiency.},
  keywords={Redundancy;Semantics;Life estimation;In-memory computing;Energy efficiency;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409100},
}

@INPROCEEDINGS{11409285,
  author={Ha, Sangwoo and Lee, Jingu and Moon, Youngjin and Whang, Sunjoo and Jo, Wooyoung and Park, Gwangtae and Kim, Sangjin and Um, Soyeon and Ryu, Junha and Jo, Yurim and Yoo, Hoi-Jun},
  title={SMoLPU: 122.1µJ/Token Sparse MoE-Based Speculative Decoding Language Processing Unit with Adaptive-Offload NPU-CIM Core},
  note={Section: Technology and Circuits for Domain-Specific Accelerators},
  abstract={SMoLPU is an energy-efficient MoE-based speculative decoding LLM processor with an NPU-CIM core. It has 3 features: 1) Token-adaptive expert refinement removes redundant expert activations and schedules expert load order, achieving $2.3 \times/4.2 \times$ energy efficiency improvement in prefill/decode; 2) An adaptive-offload NPU-CIM core and a top scheduling unit maintain HW utilization under dynamic INT–FP ratios, achieving $3.3 \times$ lower latency; 3) A reconfigurable DRAM-based LUT-CIM reduces adder tree power/area, while supporting dynamic input size. The LLM processor achieves 43.5% lower energy per parameter than prior SOTA.},
  keywords={Schedules;Processor scheduling;Trees (botanical);Dynamic scheduling;Energy efficiency;Decoding;Solid state circuits;Adders},
  doi={10.1109/ISSCC49663.2026.11409285},
}

@INPROCEEDINGS{11409002,
  author={Fu, Haotian and Zhou, Yue and Zhang, Zhuo and Zheng, Hongzhao and Yang, Renxu and Huang, Yulong and Yang, Dezhen and Xing, Yannan and Demirci, Tugba and Qiao, Ning and Cheng, Bojun},
  title={SpikeRAM: A 48.1pW/Synapse/Bit Event-Driven Spiking Compute-Near/In-Memory Processor with Neuromorphic Sensor Enabling Life-Long On-Chip Learning},
  note={Section: Technology and Circuits for Domain-Specific Accelerators},
  abstract={SpikeRAM is a high efficiency ($48.1 \text{pW} /$ Synapse/Bit) memory-centric neuromorphic system with perception, computing and on-chip learning, achieving 464M synapses and 8.28 mW power in real-time processing, while realizing few-shot learning for event-based signature verification. The EVS-sCNN core enables asynchronous sensing and feature extraction. The sFC-OCL core enables event-driven inference and learning with the e-OTBP algorithm. Gray-code weights and ternary gradients reduce memory write times by over 86%.},
  keywords={Handwriting recognition;Neuromorphics;Feature extraction;Real-time systems;Inference algorithms;System-on-chip;Solid state circuits;Sensors;Few shot learning;Synapses},
  doi={10.1109/ISSCC49663.2026.11409002},
}

@INPROCEEDINGS{11409075,
  author={Yue, Zhiheng and Xiang, Xujiang and Fu, Jiamu and Wei, Shaojun and Wang, Yang and Hu, Yang and Yin, Shouyi},
  title={A 28nm 47.3TFLOPs/W 894mJ/Inference Visual Autoregressive Accelerator with Differential-Amplifier Speculation and Chain-Reaction-Like Parallel Generation},
  note={Section: Technology and Circuits for Domain-Specific Accelerators},
  abstract={To accelerate Visual Autoregressive (VAR) applications, this work implements a 28 nm VAR accelerator achieving 47.3TFLOPs/W and <0.6% FID loss. A differential visual attention amplifier speculates critical tokens for selective execution; a full-path optimized MXINT PE adapts to biased data distribution; and, a chain reaction-like parallel generation exploits spatial correlation. The $5.76 \text{mm}^{2}$ chip runs at 400 MHz, accelerating DeiT/ViT VAR by $37.6 \times$ with $2.75 \text{TFLOPs} / \text{mm}^{2}$ area efficiency.},
  keywords={Visualization;Reactive power;Correlation;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409075},
}

@INPROCEEDINGS{11409108,
  author={Yang, Yunzhe and Zhang, Xin and Du, Sijun},
  title={19.1 Piggybacked SC-on-CSCR: A Modular On-Chip Switched-Capacitor Converter for 12-to-60V Input 1.8-to-5V Output Achieving 5.67mW/mm2 Power Density and 71.5% Peak Efficiency},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This paper presents an on-chip switched-capacitor converter, named piggybacked SC-onCSCR, featuring: 1) a power density of 5.67 mW/mm2 enabled by eliminating high-voltage switches and jointly utilizing MOM and MOS capacitors; 2) a 12-to-60V input and 1.8-to-5V output achieved through a chip-level modular design; 3) 71.5% peak efficiency enabled by full soft-charging operation; and 4) fast high-voltage startup protection, verified under a 20 V/ms power-on slope.},
  keywords={Power system measurements;Density measurement;MOS capacitors;High-voltage techniques;Switches;System-on-chip;Solid state circuits;Protection;Method of moments;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409108},
}

@INPROCEEDINGS{11409072,
  author={Cao, Peng and Xu, Jiawei and Hong, Zhiliang},
  title={19.2 A Three-Mode Single-Inductor Four-Quadrant Converter Achieving 94.6% Peak Efficiency with Seamless Zero-Crossing},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This paper presents a three-mode single-inductor four-quadrant converter with 94.6% peak efficiency for electrochromic smart windows. It supports a 5 to 12V input, a −5 to +5V output and a −3 to 3A load current, achieving full four-quadrant operation by employing buck/boost, inverting buck/boost and auxiliary transition modes. This integrated converter enables seamless zero-crossing and mode switching with a single inductor, thus resulting in a compact, low-cost, and low-complexity system.},
  keywords={Solid state circuits;Inductors;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409072},
}

@INPROCEEDINGS{11409171,
  author={Choi, Hyeon-Ji and Cho, Joo-Mi and Nam, Sang-Yun and Hong, Sung-Wan},
  title={A 94.8%-Peak-Efficiency Double Step-Up SIBO Converter Achieving 88% Output Ripple Reduction for AMOLED Display},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This paper presents a double step-up single-inductor bipolar-output (DSU-SIBO) converter for AMOLED displays. By employing a 1:2 charge pump, the proposed design reduces both DC and AC components of the inductor current, thereby minimizing loss and achieving a peak efficiency of 94.8%. With 2-out-of-3-phase energy delivery, each output receives energy during two phases per cycle, reducing output ripple by up to 88%. The prototype is implemented in a $180-\text{nm}$ BCD process.},
  keywords={Charge pumps;Prototypes;Solid state circuits;Inductors;Active matrix organic light emitting diodes},
  doi={10.1109/ISSCC49663.2026.11409171},
}

@INPROCEEDINGS{11408965,
  author={Kawai, Shusuke and Horii, Kohei and Miyazaki, Koutaro and Bushimata, Yuto and Takaya, Satoshi and Ishihara, Hiroaki},
  title={19.4 A Digital-Feedback Active-Gate-Driver IC for 600A 1200V SiC MOSFETs Supporting High-and Low-Side Drive with Simultaneous ${\text{dV}}_{\text{ds}}$/dt Control and ${\mathrm{V}}_{\text{ds}}$ Surge Suppression Enabled by Miller Capacitance Calibration},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={A digital feedback active gate driver IC applicable to both high- and low-side $600 ~\mathrm{A}, 1200 ~\mathrm{V}$ SiC MOSFETs is proposed and demonstrated on the high-side. High-side voltage sensing uses a parasitic Miller capacitance calibration circuit, while digital feedback enables simultaneous turn-on/off $\text{dV}_{\text{ds}} / \text{dt}$ control and $\mathrm{V}_{\text{ds}}$ surge suppression. Measurements show 58% surge voltage and 66% switching loss reduction, with $\text{dV}_{\text{ds}} / \text{dt}$ control within 10% error and an additional 29% loss reduction.},
  keywords={MOSFET;Voltage measurement;Silicon carbide;Switching loss;Control systems;Capacitance;Loss measurement;Calibration;Surges;Voltage control},
  doi={10.1109/ISSCC49663.2026.11408965},
}

@INPROCEEDINGS{11409021,
  author={Horii, Kohei and Miyazaki, Koutaro and Kawai, Shusuke and Ishihara, Hiroaki},
  title={A Binary-Weighted Switched-Capacitor Gate Driver IC for Overcoming Trade-Offs Between Driving Loss and Delay Time with Gate-Current Feedback Achieving 85% Driving Loss Reduction},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={A binary-weighted switched-capacitor gate driver IC achieving up to 85% reduction in driving loss ($\mathrm{E}_{\text{drv }}$) is presented. Four binary-weighted flying capacitors enable nine-level gate-voltage segmentation, enhancing charge supply capability. Adaptive state interval time control based on gate-current feedback mitigates the trade-off between the switching time of the gate-voltage ($t_{\text{sw}}$) and $\mathrm{E}_{\text{drv}}$, reducing tsw by 19% at equal $\mathrm{E}_{\text{drv}}$, and reducing $\mathrm{E}_{\text{drv}}$ by 9% at equal $\mathrm{t}_{\text{sw}}$.},
  keywords={Capacitors;Switches;Logic gates;Gate drivers;Control systems;Solid state circuits;Delays;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409021},
}

@INPROCEEDINGS{11409181,
  author={Huang, Qiao and Pan, Dongfang and Xu, Weiwei and Zhang, Yongle and Cheng, Lin},
  title={19.6 A 68%-Peak-Efficiency Single-Transformer Multi-Output Isolated DC-DC Converter with a Regulated Negative Rail},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This paper presents a single-transformer multi-output isolated DC-DC converter generating three regulated rails $(+15 ~\mathrm{V},-5 ~\mathrm{V}$, and +5 V) from wide $12 / 24 ~\mathrm{V}$ inputs. By sharing a common secondary winding in a dual-doubler rectifier configuration, the design achieves three outputs using only four power transistors. Additionally, a reconfigurable two-mode inverter ensures high efficiency across both input voltage conditions. The converter reaches a peak efficiency of 68% with maximum output power of 2.5W.},
  keywords={Rails;Windings;Rectifiers;DC-DC power converters;Power transistors;Inverters;Solid state circuits;Power generation},
  doi={10.1109/ISSCC49663.2026.11409181},
}

@INPROCEEDINGS{11408979,
  author={Cho, Joo-Mi and Kim, Jeong-Hun and Lee, Yong-Chan and Hong, Sung-Wan},
  title={A Hybrid Bipolar-Output Isolated Converter with +15V/-5V Outputs for SiC Gate Drivers},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This paper presents a hybrid bipolar-output isolated (HBO-I) gate-driver power supply (GDPS) that combines a flyback-based TX with primary-side regulation (PSR) and a switched-capacitor-based RX. Even with a compact 1:1 coupled inductor and all 5 V CMOS devices, the HBO-I GDPS delivers bipolar outputs of $+15 \mathrm{V} /-5 \mathrm{V}$ from a 5 V input without additional 5 V regulators. Therefore, the HBO-I GDPS attains $\approx 1 \text{kV}$ galvanic isolation barrier, robust high CMTI, and 89.23% peak efficiency at 3 W.},
  keywords={Regulators;Economic indicators;Silicon carbide;Power supplies;Logic gates;Regulation;Hybrid power systems;Solid state circuits;Inductors;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11408979},
}

@INPROCEEDINGS{11409225,
  author={Datta, Kishalay and Wu, Yue and Sullivan, Charles and Stauth, Jason},
  title={A Fully Integrated Bidirectional 5-Level Isolated DC-DC Converter with 42.5% Efficiency and 170mW/mm2 Transformer Power Density},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This work presents a bidirectional 5 kV -isolated DC-DC converter, fully-integrated in a 180 nm SOI CMOS process. The design uses a distributed multi-winding transformer to maximize utilization of the standard on-chip metal stackup. A 5-level hybrid full-bridge power stage allows fundamental and harmonic waveform shaping with current ballasting. The design achieves peak efficiency of 42.5% at over 550 mW, for system power density over $69 \text{mW} / \text{mm}^{2}$ and transformer power density over $170 \text{mW} / \text{mm}^{2}$.},
  keywords={Power system measurements;Density measurement;Metals;DC-DC power converters;Power system harmonics;Transformers;Hybrid power systems;System-on-chip;Solid state circuits;Standards},
  doi={10.1109/ISSCC49663.2026.11409225},
}

@INPROCEEDINGS{11409104,
  author={Liu, Gang and Jiang, Junmin and Du, Sijun and Liu, Xun},
  title={19.9 A 2.15W 120V/230Vac to 5-to-12Vdc Offline Power Converter with Full-Duty-Cycle Input-Series Dual-Branch Converter Achieving 1088mW/${\text{cm}}^{3}$ and 87.2% Peak Efficiency},
  note={Section: High-Voltage, Isolated and Display Power},
  abstract={This paper presents a $120 ~\mathrm{V} / 230 \text{Vac}$ to 5-to-12Vdc offline power converter consisting of a capacitor-drop AC-DC rectifier and a full-duty-cycle input-series dual-branch DC-DC converter for IoT devices. The proposed converter operates at full-duty-cycle with VCR of D/2 and reduces both the $\mathrm{C}_{\text {REC }}$ volume and the voltage stress on components, while achieving high efficiency across a broad input and output voltage range. 87.2% peak efficiency, 2.15W output power, and $1088 ~\text{mW} / \text{cm}^{3}$ power density are achieved.},
  keywords={Power system measurements;Density measurement;Rectifiers;Voltage;DC-DC power converters;Solid state circuits;Internet of Things;Video recording;Stress;Power generation},
  doi={10.1109/ISSCC49663.2026.11409104},
}

@INPROCEEDINGS{11409069,
  author={Xu, Jinglong and Huang, Tzu-Yuan and Eleraky, Mohamed and Tolaib, Islam and Wang, Hua},
  title={20.1 An Ultra-Compact Asymmetrically Load-Pulled Series Doherty Power Amplifier in 22Nm FDSOI CMOS with 25.3dBm Psat and 29.7% PAE6dB for Ku-Band 6G FR3},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper presents an ultra-compact asymmetrically load-pulled series Doherty PA in 22 nm CMOS SOI with a single-footprint output combiner. A quantitative analysis of a single transformer as an impedance inverter enables a passive-network transformation to a single- footprint EM structure. In addition, an asymmetric load-pull concept is proposed. The PA achieves 25.3 dBm Psat, 1.56 W/mm2 power density, up to 30% PAE6 dB, and wideband modulation for 3GHz QPSK and 2GHz 64QAM.},
  keywords={Power system measurements;Phase shift keying;Statistical analysis;Silicon-on-insulator;Power amplifiers;Transformers;Ku-band;Solid state circuits;Wideband;Periodic structures},
  doi={10.1109/ISSCC49663.2026.11409069},
}

@INPROCEEDINGS{11409253,
  author={Park, Seungwon and Lee, Jooseok and Baek, Seungjae and Kim, Taewan and Chen, Yifei and Jeon, Sehyug and Yang, Sung-gi},
  title={A High Back-Off Efficiency Unequal-Stacked Doherty Power Amplifier Achieving 16.7dBm Pavg in a 22nm FDSOI CMOS Technology for 5G FR2 Applications},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper proposes an unequal-stacked Doherty power amplifier. The proposed Doherty structure consists of a common-source topology for the carrier amplifier and an N-stacked topology for the peaking amplifier with a theoretically determined quarter-wave line. Thanks to the proposed Doherty structure, the back-off efficiency is enhanced. With a 5 GNR 64-QAM OFDM 100 MHz signal, the $\mathrm{P}_{\text{avg }}$ and $\text{PAE}_{\text{avg }}$ exceed 15.8 dBm and 16.9%, respectively, from 24 to 28 GHz with the EVM of −25 dB.},
  keywords={5G mobile communication;OFDM;Power amplifiers;Silicon-on-insulator;CMOS technology;Topology;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409253},
}

@INPROCEEDINGS{11409346,
  author={Liu, Lianbo and Fang, Yidong and Zhou, Qiang and Chi, Taiyun and Li, Sensen},
  title={A mm-Wave Doherty Power Amplifier in a Single-Path Footprint Using Compact Reciprocal Doherty Networks},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper presents a compact, single-path-footprint Doherty PA with minimized passive network areas. A systematic analysis for its realization is developed based on the proposed theory of reciprocal Doherty networks employing a single transformer. Implemented with only three transformer footprints and a single driver, the design occupies a core area of 0.12 mm2, comparable to that of a linear PA, while supporting wideband, high-order QAM OFDM signals with high average efficiency.},
  keywords={Passive networks;Systematics;Quadrature amplitude modulation;OFDM;Power amplifiers;Transformer cores;Transformers;Solid state circuits;Wideband},
  doi={10.1109/ISSCC49663.2026.11409346},
}

@INPROCEEDINGS{11409238,
  author={Eleraky, Mohamed and Zeng, Jianping and Wang, Hua},
  title={20.4 An Ultra-Compact, Inherently Resilient FR3 Source-Follower Power Amplifier with 4:1 VSWR Resilience and RIMD Immunity for Large-Scale SATCOM and 6G Phased Arrays},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper presents a source-follower power amplifier (PA) designed to combat high VSWR and reverse intermodulation distortion (RIMD) in phased arrays. Its inherently low output impedance enables conjugate matching and robust resilience to load variations, mitigating degradation from antenna mismatches up to 4:1 VSWR. The design maintains strong largesignal performance without compromise, proving its suitability for compact, calibration-free integration in large-scale SATCOM and 6G systems.},
  keywords={Phased arrays;6G mobile communication;Degradation;Intermodulation distortion;Power amplifiers;Load management;Solid state circuits;Impedance;Loaded antennas;Resilience},
  doi={10.1109/ISSCC49663.2026.11409238},
}

@INPROCEEDINGS{11409043,
  author={Yu, Luqi and Chen, Peng and Yu, Yucheng and Zhang, Gaojing and Lu, Xiaoyu and Zhang, Xiang and Chen, Jixin and Zhu, Xiaowei and Yu, Chao and Hong, Wei},
  title={20.5 A 24-to-27.5GHz Self-Adaptive Load-Modulated Balanced Amplifier for Integrated Communication, Sensing, and Power Transfer Scenarios},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={A 24-to-27.5GHz self-adaptive load-modulated balanced amplifier (SALMBA) is proposed for 6G integrated communication, sensing, and power-transfer scenarios. Based on the proposed self-adaptive power divider, the power divide ratio can dynamically change according to the input power levels, and the back-off PAE and saturated performance of the SALMBA can be significantly improved. The SALMBA achieves the saturated PAE of 28.5 to 33%, and 10 dB OPBO PAE of 15.3 to 22.1% over 24 to 27.5 GHz.},
  keywords={Power dividers;6G mobile communication;Sensors;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409043},
}

@INPROCEEDINGS{11409192,
  author={Wang, Weibo and Chen, Wenhua and Xie, Kenan and Luo, Chenjie and Zhang, Yibin and Shang, Dechun and Jiang, Ziwei and Yu, Guodong and Chen, Yan and Wang, Keping},
  title={20.6 A 330-to-344GHz GaN Power Amplifier with Maximum-Available-Gain-Boosting Technique and Compact Tandem Coupler Achieving 86mW Output Power at 340GHz},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper demonstrates a 330-to-344GHz GaN power amplifier (PA), fabricated using a 35nm GaN HEMT process with a 15-stage cascaded architecture. The maximum-available-gain-boosting technique enhances the high frequency gain, while the miniaturized Tandem coupler reduces port reflection and combining losses. The PA achieves $>21 \text{dB}$ gain, $>18 \text{dBm}$ saturated output power $\left(\mathrm{P}_{\text{SAT}}\right)$, and $>0.6 \%$ power-added efficiency. The peak PSAT reaches 19.3dBm at 340GHz, with a power density exceeding 0.925W/mm.},
  keywords={Power system measurements;Density measurement;Power amplifiers;Couplers;HEMTs;Reflection;Solid state circuits;High frequency;Power generation},
  doi={10.1109/ISSCC49663.2026.11409192},
}

@INPROCEEDINGS{11409314,
  author={Uddin, Syed Mohammad Ashab and Lee, Wooram},
  title={20.7 An Ultra-Compact D-Band Transceiver Front-End Based on a Common-Gate Bidirectional Amplifier Achieving 11.2dBm TX $P_{\text{sat }}$ and 8.2dB RX Average NF for an Area-Constrained 2D Beamformer AiP},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={An ultra-compact D-band transceiver based on a common-gate bi-directional amplifier is presented in a 45nm RFSOI process for an area-constrained 2D beamformer antenna-inpackage. By employing a switchless symmetric inter-stage matching network and compact, low-loss reconfigurable input/output networks, the transceiver front-end achieves a TX peak $P_{\text{sat }}$ of 11.2dBm at 135GHz and an average RX NF of 8.2dB over 129 to 145GHz. The active chip area, excluding pads, is only $0.08 \text{mm}^{2}$.},
  keywords={Switches;Bidirectional control;Transceivers;Solid state circuits;Noise measurement;Antennas},
  doi={10.1109/ISSCC49663.2026.11409314},
}

@INPROCEEDINGS{11409097,
  author={Zhou, Jia and Du, Jieqiong and Tien, Chao-Jen and Chen, Jhih-Wei and Soong, Ruei-Chen and Beltran, Francisco Cardenas and Cuskelly, Lachlan and Chen, Christopher and Zhu, Minji and Tang, Adrian and Tam, Sai-Wang and Chang, Mau-Chung Frank},
  title={A 16-to-256QAM G-Band Subharmonic Phase-Modulating Transmitter for Beyond-5G Communications},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper presents a highly integrated G-band digital transmitter for beyond-5G communications featuring: 1) a subharmonic phase-modulating architecture with timeinvariant phase tripling, 2) a GS/s segmented 9-bit digital-to-phase converter (DTPC) with a sub-degree rms error, and 3) a carrier-saturating and multiplying chain for direct QAM synthesis. It achieves $51.2 \text{Gbps} / 16 \text{QAM}, 24 \text{Gbps} / 64 \text{QAM}$, and 8Gbps/256QAM with −2 dBm peak output power while consuming $280-\text{to}-350 \text{mW}$ DC power.},
  keywords={Transmitters;Quadrature amplitude modulation;Solid state circuits;Power generation},
  doi={10.1109/ISSCC49663.2026.11409097},
}

@INPROCEEDINGS{11408956,
  author={Luo, Jiaming and Wen, Jincai and Wu, Yuxia and Wang, Xu and Sun, Lingling},
  title={20.9 A Compact 26/38GHz-Reconfigurable Dual-Band Low-Noise Amplifier Using Transformer-Based Pole-Zero-Inversion Image-Rejection Technique Achieving >39/41dB IRR for 5G Multi-Band Applications},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This paper presents a compact 26/38GHz reconfigurable dual-band low-noise amplifier (LNA) for a narrow-LO dual-side mixing. By adopting a transformer-based pole-zero-inversion image-rejection technique, the LNA achieves 20dB and 19dB of gain, 3.5dB and 3.9dB noise figures at 26GHz and 38GHz, respectively. The image rejection ratios are better than 39dB and 41dB with an intermediate frequency of 6GHz.},
  keywords={6G mobile communication;Low-noise amplifiers;Noise figure;5G mobile communication;Dual band;Transformers;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11408956},
}

@INPROCEEDINGS{11409245,
  author={Meng, Qianqi and Wang, Zhihua and Zhou, Peigen and Tang, Dawei and Tang, Siyuan and Xiao, Junyue and Zhou, Rui and Li, Jinben and Chen, Zhe and Chen, Jixin and Gao, Hao and Hong, Wei},
  title={20.10 A 214-to-242GHz Miniaturized Co-Packaged PA-Antenna Array with 29dBm Lens-Less Eirp in a 0.13μm SiGe Process},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={This work presents a miniaturized, high-power, and wideband THz PA-antenna array, realizing 29 dBm lens-less peak EIRP from 214 to 242 GHz. To improve the BW and Psat of the PA, a folded 10th-order power-splitting/combining and staggered-matching method is proposed, achieving 17.4 dB peak gain and 16.5 dBm peak Psat from 160 to 248 GHz. To address the efficiency and BW limitation of the AoC, a co-packaged ULP slot-patch antenna is integrated, extending the radiation efficiency to 66.7 % and BW to 36 GHz.},
  keywords={Slot antennas;Terahertz radiation;Solid state circuits;Wideband;Gain;Antenna arrays;Silicon germanium},
  doi={10.1109/ISSCC49663.2026.11409245},
}

@INPROCEEDINGS{11409102,
  author={Elmenshawi, Ahmed and Muralidharan, Sriram and Hella, Mona M.},
  title={20.11 A 215GHz 8×8 Radiator-Oscillator Array with Robust Coupling Achieving 25.5dBm EIRP and 12.9% FTR},
  note={Section: RF Transceiver Subsystems from cm-Wave to THz},
  abstract={A $215 \text{GHz} 8 \times 8$ radiator-oscillator array with robust coupling achieving 25.5dBm average EIRP over a 12.9% continuous frequency tuning range. The proposed coupling scheme, based on distributed coupling through multi-functional networks, achieves robust 2D-scalable coupling over a wide frequency range with sub-nanosecond synchronization. A high-directivity horn-antenna radiation package with a glass superstrate is proposed to achieve a high EIRP and radiation efficiency.},
  keywords={Couplings;Glass;Solid state circuits;Synchronization;Frequency synchronization;Tuning},
  doi={10.1109/ISSCC49663.2026.11409102},
}

@INPROCEEDINGS{11408970,
  author={Han, Jeongwon and Woo, Sunsik and Oh, Kwang-Seok and Kim, Donghyeon and Ko, Youngwoon and Choi, Won-Jong and Han, Seungjun and Park, Kyungdam and Choi, Juncheol and Lee, Jinseop and Jeon, Jin-Yong and Son, Young-Suk and Lee, Sang-Gug and Kwon, Kyeongha},
  title={21.1 Sub-1mV-Accuracy, 24-CH Synchronous Battery Monitoring IC with Bipolar-Sampling ADCs and Calibration Engines},
  note={Section: Sensor Interfaces},
  abstract={This paper presents a 24-CH BMIC with sub-1mV accuracy and enhanced fault detection for EVs. Dedicated bipolar-sampling ADCs enable simultaneous measurements across -2 V to +5 V input ranges, supporting busbar fault detection. Bipolar operation uses only 12 V-rated MOS through active body biasing and clock doubling. Calibration engines correct for CH-dependent gain variations and input offsets. Fabricated in 0.13µm BCD, the BMIC achieves sub- 1 mV accuracy across -2 V to +5 V and -40° C to +130° C.},
  keywords={Accuracy;Fault detection;Calibration;Solid state circuits;Batteries;Engines;Monitoring;Clocks},
  doi={10.1109/ISSCC49663.2026.11408970},
}

@INPROCEEDINGS{11409196,
  author={Wu, Mengze and Lassalle-Balier, Remy and Aguirre, Pablo and Ferrer, Florencia and Alizad, Sina Haji and Kummari, Shekher and Latham, Alex and Hall, Drew A.},
  title={A Fully Integrated GMR Biosensor with On-Chip Coils and Sensors Achieving 605 Resolution FoM for Multiplexed PoC Diagnostics},
  note={Section: Sensor Interfaces},
  abstract={This paper presents a fully integrated GMR biosensor chip for point-of-care in vitro diagnostics featuring on-chip sensors, excitation coils, and a digital back-end. The system achieves $120 \text{nT}_{\text {rms }}$ noise, 0.38 ppm sensitivity, <0.2% mismatch, and a resolution FoM of 605, outperforming prior GMR designs with $21 \times$ faster readout and $10 \times$ lower baseline with full integration. Real-time IL-6 immunoassay results demonstrate high specificity and multiplexing, enabling compact, high-throughput PoC testing.},
  keywords={Multiplexing;Coils;Sensitivity;Point of care;Real-time systems;System-on-chip;Sensors;Solid state circuits;Biosensors;Testing},
  doi={10.1109/ISSCC49663.2026.11409196},
}

@INPROCEEDINGS{11409332,
  author={Qu, Tianxiang and Wang, Nan and Zhou, Kaiwen and Liu, Jiayao and Xiang, Longxi and Sun, Mingqian and Hong, Zhiliang and Zeng, Xiaoyang and Xu, Jiawei},
  title={21.3 A Temperature- and Aging-Compensated TMR Current Sensor with ±0.13% Sensitivity Variation from −40°C to 120°C},
  note={Section: Sensor Interfaces},
  abstract={This paper presents a TMR-based contactless current sensor that mitigates sensitivity drift due to temperature and aging. The proposed sensitivity stabilization loop continuously adjusts the TMR sensitivity, making residual drift dependent only on the on-chip curvature- corrected current reference (IREF). A built-in stress sensor is used to further compensate the aging-induced drift of IREF. These techniques achieve ± 0.13% sensitivity variation from −40° C to 120° C and reduce the aging drift to 0.1% at 25° C.},
  keywords={Temperature sensors;Sensitivity;Aging;System-on-chip;Solid state circuits;Stress},
  doi={10.1109/ISSCC49663.2026.11409332},
}

@INPROCEEDINGS{11409074,
  author={Toth, Nandor G. and Makinwa, Kofi A. A.},
  title={21.4 A Background-Calibrated NPN-Based Temperature Sensor with 0.05°C ($3 \sigma$) Inaccuracy from −70°C to 125°C},
  note={Section: Sensor Interfaces},
  abstract={In this work, an NPN-based temperature sensor is presented that introduces a backgroundcalibration scheme to correct all current-domain errors in its front-end. It achieves an inaccuracy of 0.05° C(3 \sigma) from −70° C to 125° C (RIA=0.05%) after a one-point trim, which represents the state-of-the-art energy efficiency (100fJ.K2) and power supply sensitivity (PSS) (0.004°C/V).},
  keywords={Temperature sensors;Sensitivity;Power supplies;Energy efficiency;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409074},
}

@INPROCEEDINGS{11408948,
  author={Choi, Haejung and Kim, Jooseong and Jung, Woojoong and Yoo, Sungmin and Yang, Jun-Hyeok and Lee, Sunghyuck and Park, Jihye and Choi, Michael and Rhew, Ben},
  title={A 0.6V 625um2 Fully Stacked RC-Based Temperature Sensor Using Low TCR Metal Resistor Achieving 0.017nJ.%2-Accuracy FoM in 2nm Gate-All-Around Process},
  note={Section: Sensor Interfaces},
  abstract={The proposed RC-based temperature sensor, fabricated on a 2 nm gate-all-around process, minimizes silicon area by fully stacking low temperature coefficient of resistance (TCR) metal resistors and a ring-oscillator time-to-digital converter. The conversion time is $12 \mu \mathrm{s}$ by using a time-offset compression technique to overcome the disadvantage of a low TCR metal resistor while having $\pm 0.5^{\circ} \mathrm{C}(3 \sigma)$ inaccuracy after 2-point calibration with a range of −40 to 125° C, resulting in accuracy-FoM of $0.017 \text{nJ} \cdot \%^{2}$.},
  keywords={Temperature sensors;Resistors;Resistance;Stacking;Metals;Logic gates;Silicon;Solid state circuits;Calibration},
  doi={10.1109/ISSCC49663.2026.11408948},
}

@INPROCEEDINGS{11409085,
  author={Kuang, Jian-Jun and Ming, Xin and Gong, Xin-Ce and Lang, Tian-Chen and Geng, Xiang and Zhang, Bo},
  title={A ±60mA-Inaccuracy Low-Side Average Current Sensor with Operating-Conditions-Insensitive Control Supporting 0.1-to-3A Load Range and Sub-100ns Sample Time for Automotive USB Charge Application},
  note={Section: Sensor Interfaces},
  abstract={In Paper 21.6, UESTC and SouthChip Semiconductor Technology present a low-side average current sensor for automotive USB charging, which supports 0.1-to-3A load range and sub100ns sample time with $\pm 60 \text{mA}$ inaccuracy. This is achieved by 1) an adaptive settling helper to reduce the settling delay, 2) a DC level-shift bias to improve the light-load current sense accuracy, and 3) an anti-duty resistor to suppress the drift of −3dB bandwidth.},
  keywords={Resistors;Accuracy;Bandwidth;Universal Serial Bus;Solid state circuits;Delays;Automotive engineering},
  doi={10.1109/ISSCC49663.2026.11409085},
}

@INPROCEEDINGS{11409062,
  author={Wang, Weixiao and Shen, Yili and Cai, Tianyi and Xiao, Qijing and Luo, Yuxuan and Zhao, Bo},
  title={A Battery-Free Wireless Electrochemical-Interface SoC Featuring 143dB Dynamic Range for Multimodal Wearables},
  note={Section: Sensor Interfaces},
  abstract={A battery-free wireless electrochemical-interface SoC is implemented and demonstrated in a sweatband prototype for physiological monitoring in body sweat, where the proposed techniques improve the dynamic range with a high linearity and low power consumption: 1) A self-adaptive stepwise-sinking technique for an OTA-less potentiostat extends the dynamic range to 143dB with 23.3μW power. 2) A frequency-digital-hybrid structure helps to ensure a high linearity of R2=0.99997 across the 143dB range.},
  keywords={Wireless communication;Power demand;Linearity;Prototypes;Dynamic range;Solid state circuits;Wearable devices;Biomedical monitoring;Monitoring},
  doi={10.1109/ISSCC49663.2026.11409062},
}

@INPROCEEDINGS{11409117,
  author={Dai, Jun and Zhong, Yi and Tao, Yunsong and Zhang, Aodong and Zhan, Mingtao and Zhang, Hao and Jie, Lu and Sun, Nan},
  title={21.8 A CMOS Hybrid Common-Gate Current-Integrating Sampler with <37dB SNDR Across 51GHz BW in a 128GS/s Front-End},
  note={Section: Sensor Interfaces},
  abstract={This work proposes a CMOS hybrid common-gate current integrating sampler to address linearity, BW, and jitter limitations in prior wideband ADC front-ends. The front-end employs a hybrid common-gate V-I converter, transformer-coupled inductive peaking, and an automatic power-gating hold buffer, enabling 48.1dB SFDR and 38.6dB SNDR near its 52GHz BW−3dB. This work demonstrates superior SNDRBW (measured near BW3dB), outperforming prior samplers/ADCs reported in ISSCC/JSSC/VLSI with BW>30GHz.},
  keywords={Current measurement;Linearity;Jitter;Transformers;Solid state circuits;Wideband},
  doi={10.1109/ISSCC49663.2026.11409117},
}

@INPROCEEDINGS{11409178,
  author={Ma, Heng and Zhang, Huajun and Fan, Qinwen},
  title={21.9 A -82.3dB THD+N 60V Fully Integrated Shunt-Resistor-Based In-Line Current Sensor with DLL-Assisted Dynamic Body-Biasing Technique},
  note={Section: Sensor Interfaces},
  abstract={Floating-$\mathrm{G}_{\mathrm{m}}$-based current sensors are effective in rejecting PWM common-mode voltage. But their linearity drops at high voltages due to substrate-current-induced body effect in LDMOS devices. To address this issue, this work introduces a DLL-assisted dynamic body biasing sensor in $0.18 \mu \mathrm{m}$ BCD, improving HD2 by 31 dB and THD+N by 14 dB. And a peak THD+N of −82.3 dB is achieved in the meanwhile. It supports 60 V common-mode, rejects PWM up to 2 MHz, and enables high-linearity sensing for high power audio and motor-driver systems.},
  keywords={Linearity;Voltage;High-voltage techniques;Pulse width modulation;Sensor systems;Sensors;Solid state circuits;Substrates},
  doi={10.1109/ISSCC49663.2026.11409178},
}

@INPROCEEDINGS{11409159,
  author={Wang, Jinchen and Han, Yuyang and Harris, Isaac B. and Lee, Eunseok and Hu, Yong and Liu, Di and Englund, Dirk and Han, Ruonan},
  title={22.1 A Cryo-CMOS Color-Center Quantum Controller with Diamond Waveguide Micro-Chiplet Integration},
  note={Section: Circuits in Extreme Environments},
  abstract={We present a scalable cryo-CMOS controller for color-center-based quantum processors. A diamond waveguide micro-chiplet with NVs is pick-and-placed on CMOS with a 3D-printed prism for scalable photonic readout. A serial qubit driver array using grid inductors and pulse-width modulators generates a programmable 2.87GHz magnetic field for each qubit with low power and strong confinement. Up to 144 qubits can be operated on a single chip, with $204\mu\mathrm{W}$ power consumption per qubit under active control.},
  keywords={Program processors;Power demand;Qubit;Modulation;Diamond;Solid state circuits;Magnetic fields;Inductors;Photonics},
  doi={10.1109/ISSCC49663.2026.11409159},
}

@INPROCEEDINGS{11409194,
  author={Tien, Kevin and Frank, David J. and Bulzacchelli, John F. and Rosno, Pat and Moertl, Daniel and Timmerwilke, John and Noori, Ari and Underwood, Devin and Inoue, Ken and Ray, Subhajit and Ramirez, Daniel and Schmerbeck, Timothy J. and Snell, Bryce and Ekman, Jeremy and Black, Ryan and Yeck, Mark and Haselhorst, Tom and Erickson, Emma and Demsky, Kevin and Baks, Christian W. and Kaus, Jonathan and Ruffino, Andrea and Francese, Pier Andrea and Davies, Andy and Chakraborty, Sudipto and Lekuch, Scott and Gaucher, Brian P. and Sadhu, Bodhisatwa and Willenborg, Scott M. and Friedman, Daniel J.},
  title={22.2 A 16-Channel Low-Power Cryo-CMOS Flux Control Pulse Generator ASIC in 14nm FinFET Technology},
  note={Section: Circuits in Extreme Environments},
  abstract={This work presents a 16-channel flux pulse generator ASIC for qubit control in 14nm FinFET technology consuming $<7 \text{mW}$ per channel. Multiple 10b sub-DACs operating at different rates (up to $1 \text{GS} / \mathrm{s}$) are used to realize a pulse generator with 14b level resolution and IIR precompensation. A custom SERDES designed for $<1 \text{mW}$ power dissipation enables offchip $2 \text{Gb} / \mathrm{s}$ (up) and $250 \text{Mb} / \mathrm{s}$ (down) communications. Multi-qubit control is demonstrated, and measured error-per-2-qubit-gate is as low as 0.0017.},
  keywords={Pulse generation;Pulse measurements;Qubit;Measurement uncertainty;FinFETs;Solid state circuits;Power dissipation},
  doi={10.1109/ISSCC49663.2026.11409194},
}

@INPROCEEDINGS{11409175,
  author={Fakkel, Niels and Enthoven, Luc and Elbadry, Mohamed Abdelrahman and van Ommen, Hendrik Benjamin and van Riggelen, Margriet and Yun, Jiwon and Taminiau, Tim Hugo and Sebastiano, Fabio and Babaie, Masoud},
  title={22.3 A Multi-Qubit Cryo-CMOS SoC with Polar-Based Electron-Spin and PDM-Based Nuclear-Spin Controllers for Color Centers in Diamond},
  note={Section: Circuits in Extreme Environments},
  abstract={Co-integrating a cryo-CMOS SoC with nitrogen-vacancy (NV) centers in diamond enables a scalable quantum platform. This work introduces a combined Class-DE RFDAC and classD PDM driver for multi-qubit electron- and nuclear-spin control. A switch allows shared coil driving enabling multi-band 2.5-3.2GHz(1.9-2.1MHz), large-current 70mA(38mA), highRabi frequency 2.31MHz(1.93kHz) and high-fidelity 99.34(3)%(99.78(2)%) electron(nuclear) quantum logic gates with decoupled coherence times >50ms.},
  keywords={Coils;Time-frequency analysis;Color;Logic gates;Control systems;Diamond;Solid state circuits;Nitrogen;Frequency control;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409175},
}

@INPROCEEDINGS{11408995,
  author={Cheng, Quan and Yang, Zhengke and Li, Haoyuan and Li, Qiufeng and Kong, Zhen and Niu, Gaoqiang and Liang, Yuan and Li, Jiamin and Yoo, Jerald and Hashimoto, Masanori and Lin, Longyang},
  title={A Radiation-Hardened Self-Healing CMOS Imager with Online Pixel/Logic Annealing and Tile-Adaptive Compression for Space Applications},
  note={Section: Circuits in Extreme Environments},
  abstract={CMOS imagers in space suffer radiation-induced faults and downlink bandwidth limits. This work presents an 180 nm self-healing imager with localized online thermal annealing for both pixels and logic, as well as adaptive ROI-lossless compression for 75.5% data reduction. Measurements show $4.82 \times / 3.97 \times$ reductions in pixel/logic leakage and nearly full image recovery after 20kGy X-ray exposure, enabling continuous, robust space imaging.},
  keywords={Image coding;Annealing;Imaging;Bandwidth;Extraterrestrial measurements;Downlink;Solid state circuits;Logic;Circuit faults;X-ray imaging},
  doi={10.1109/ISSCC49663.2026.11408995},
}

@INPROCEEDINGS{11408968,
  author={Narukiyo, Yasuto and Kato, Sena and Yanaka, Kotaro and Takahashi, Yuya and Miyahara, Masaya and Mayeda, Jill and Shirane, Atsushi},
  title={A 500kGy Radiation-Hardened 2.4GHz Wi-Fi Receiver for Innovative Nuclear Power Plant Decommissioning},
  note={Section: Circuits in Extreme Environments},
  abstract={This work presents a 2.4 GHz Wi-Fi receiver in 65 nm CMOS, designed with radiationhardened techniques to sustain operation under total ionizing dose to 500 kGy. Such tolerance addresses the requirements of nuclear power plant decommissioning, where conventional studies have considered doses of only several Gy. Measurement results confirm that even at 500 kGy, the proposed receiver maintains acceptable performance showing the feasibility of wireless systems in extreme radiation environments.},
  keywords={Wireless communication;Power measurement;Receivers;CMOS technology;Solid state circuits;Total ionizing dose;Wireless fidelity;Power generation;Nuclear measurements},
  doi={10.1109/ISSCC49663.2026.11408968},
}

@INPROCEEDINGS{11409081,
  author={Song, Sanquan and Mehta, Nandish and Nedovic, Nikola and Rekhi, Angad and Kalogerakis, Georgios and Xu, Li and Zimmer, Brian and Tell, Stephen G. and Nishi, Yoshi and Chen, Xi and Lopes, Ward and Lee, Benjamin G. and Greer, Thomas H. and Gray, C. Thomas},
  title={A 32 Gb/s/λ 256Gb/S/Fiber Half-Rate Bandpass-Filtered Clock-Forwarding DWDM Optical Link in a 3D-Stacked 7nm EIC/65nm PIC Technology},
  note={Section: Next-Generation Optical Transceivers},
  abstract={We present a $32 \text{Gb} / \mathrm{s} / \lambda$ dense wavelength division multiplexing bandpass-filtered clockforwarding link featuring nine 200 GHz - spaced wavelengths (8 for data and 1 for clk). Fabricated in a 3D-stacked technology with an electronic IC in a 7 nm process and a photonic IC in a 65 nm SiPh process, our implementation achieves a throughput of $256 \text{Gb} / \mathrm{s} /$ fiber, delivering an energy efficiency of approximately $2.78 \text{pJ} / \mathrm{b}$ and an area efficiency of $1.33 \text{Tbps} / \text{mm}^{2}$-while maintaining 0.46 UI wide eye openings at $<1 \mathrm{E}-11 \text{BER}$.},
  keywords={Wavelength division multiplexing;Throughput;Optical fiber communication;Energy efficiency;Solid state circuits;Photonics},
  doi={10.1109/ISSCC49663.2026.11409081},
}

@INPROCEEDINGS{11409176,
  author={Sosio, Marco and Nani, Claudio and Monaco, Enrico and Ghittori, Nicola and Albano, Domenico and Di Pasquo, Alessio and Bosi, Alessandro and Lovitt, Travis and Gira, Gabriele and Martinelli, Fulvio and Karam, Victor and Khanna, Devrishi and Khiarak, Mehdi N. and Cyrusian, Sasan and Davoodi, Mehdi and Garampazzi, Marco and Miral, Nimesh N. and Giunco, Fabio and Fabiano, Ivan and Codega, Nicola and Asero, Claudio and Herbas, Daniel L. and Temporiti, Enrico and Scouten, Shawn and Kota, Kishore and Fu, Yang and Jin, Ruibin and Mueller, Josef and Leung, Michael and Farhoodfar, Arash and Jantzi, Stephen and Chang, Ken},
  title={23.2 A 2-Channel 800Gb/s Transceiver for Coherent-Lite Applications with <300ns Latency in 5nm FinFET},
  note={Section: Next-Generation Optical Transceivers},
  abstract={A full transceiver suitable for coherent-lite optical communications over 2-to-20km distances is presented. The low-latency transceiver combines the advantages of advanced coherent modulation with the benefits and manufacturing scale of O-band optics to deliver a power-and cost-effective module. Fabricated in 5 nm FinFET, it comprises two $400 ~\text{Gb} / \mathrm{s} / \lambda$ transmitters and receivers to realize a 2 -channel DP-16QAM $800 ~\text{Gb} / \mathrm{s}$ link tailored to the market of distributed campus data center interconnects.},
  keywords={Integrated circuit interconnections;Receivers;FinFETs;Optics;Transceivers;Optical fiber communication;Solid state circuits;Manufacturing;Optical transmitters;Low latency communication},
  doi={10.1109/ISSCC49663.2026.11409176},
}

@INPROCEEDINGS{11409086,
  author={Xu, Ziang and Lin, Yalong and Jin, Jinxuan and Ye, Zhenkai and Xu, Dacheng and Xu, Aolin and Sheng, Chaodi and Hong, Binwen and Bi, Xiaojun},
  title={A 2×500Gb/s Monolithic Silicon-Photonic DWDM PAM-4 Transceiver in 45nm CMOS SOI},
  note={Section: Next-Generation Optical Transceivers},
  abstract={This work presents a monolithic $2 \times 5 \lambda$ DWDM microring transceiver in 45 nm CMOS SOI delivering $2 \times 500 \text{Gb} / \mathrm{s}$ ($100 \text{Gb} / \mathrm{s}$ PAM-4/channel). The transceiver features a low-noise TIA with Q-tamed CTLE, a high-speed MRM driver, and a PWM-based IL-adjustable wavelength- locking circuit. V-groove and a PSR-to-CRR front end enable low coupling loss and tight $\lambda$-spacing. Through electro-photonic co-design, the transceiver achieves an efficiency $<2.5 \text{pJ} / \mathrm{b}$ at $100 \text{Gb} / \mathrm{s}$ per channel in end-to-end loopback.},
  keywords={Couplings;Wavelength division multiplexing;Transceivers;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409086},
}

@INPROCEEDINGS{11409070,
  author={Kashmiri, Mahdi and Yadav, Ajay and Namkoong, Jin and Nakhkoob, Behrooz and Kao, Tony and Shen, Shen and Pandey, Vaibhav and Chen, Kuan-Chang and Han, Jinho and Gaddam, Sudheer and Kazemkhani, Shayan and Kim, Sang Young and Maangat, Simar and Nguyen, Bo and Robinson, Mike and Hedayati, Hiva},
  title={23.4 A 6.4Tb/s 4.2pJ/b Co-Packaged Optics ASIC with Direct-Drive Integrated TIA and Retimed Segmented Mach-Zehnder Modulator Driver in 7nm FinFET},
  note={Section: Next-Generation Optical Transceivers},
  abstract={A $6.4 ~\text{Tb} / \mathrm{s}$ co-packaged optics ASIC integrates 64 ingress path direct-drive TIAs and 64 egress path retimed segmented Mach-Zehnder modulator drivers in 7 nm FinFET. The 7 nm ASIC is 3D packaged with a photonics IC (PIC) and achieves an energy efficiency of $4.2 \text{pJ} / \mathrm{b}$. At $106.25 ~\text{Gb} / \mathrm{s}$, its PAM-4 TIA has a sensitivity better than −11 dBm and a BER floor better than 1E-9. The transmitted PAM-4 optical eye achieves a TDEQ of 1.48 dB and an extinction ratio of 4.57 dB.},
  keywords={Mach-Zehnder interferometers;Integrated optics;Three-dimensional displays;Sensitivity;FinFETs;Solid state circuits;Optical sensors;Optical modulation;Floors;Photonics},
  doi={10.1109/ISSCC49663.2026.11409070},
}

@INPROCEEDINGS{11409273,
  author={Chowdhury, Antroy Roy and Rahman, Wahid and ElShater, Ahmed and Ali, Tamer and Stojanovic, Vladimir},
  title={A 212Gb/s/λ 0.91pJ/b Direct-Drive O-Band Monolithic Coherent Transmitter Based on Carrier-Injection-Mode Mach-Zehnder Modulator},
  note={Section: Next-Generation Optical Transceivers},
  abstract={This work presents an 0-band coherent direct-drive optical transmitter (OTX) in 45 nm CMOS-SOI using a compact 0.4 mm monolithically integrated forward-biased PIN-MZM. A multistage linear driver with shunt peaking, passive equalization and TX-FIR enables 106Gb/s PAM-4 IMDD and $212 ~\text{Gb} / \mathrm{s}$ QAM16 coherent signaling. The OTX achieves $0.91 \text{pJ} / \mathrm{b}$ electrical power efficiency with a $2.76 \times$ lower laser power and $5 \times$ area reduction versus a conventional reverse-biased TW-MZM fabricated on the same die.},
  keywords={Mach-Zehnder interferometers;Power lasers;Solid state circuits;Optical transmitters},
  doi={10.1109/ISSCC49663.2026.11409273},
}

@INPROCEEDINGS{11409355,
  author={Wang, Cheng and Gu, Ye and Coudyzer, Gertjan and Niu, Shengpu and Zhang, Jing and Yin, Xin},
  title={23.6 A 112Gb/s NRZ Heterodyne Detection 23ns Settled Burst-Mode RX with CD Suppression and Envelope Demodulation for 100G PON},
  note={Section: Next-Generation Optical Transceivers},
  abstract={This work presents a burst-mode receiver based on an intensity modulation heterodyne detection scheme. SSB quadrature IF generation and envelope detection enhance baseband signal integrity and chromatic dispersion tolerance. Pre/post-demodulator loop separation allows parallel AGC/AOC in burst-mode. The SiGe BiCMOS front-end, co-integrated with an O-band silicon photonic PIC, achieves $112 \text{Gb} / \mathrm{s}$ NRZ with −25.8 dBm OMA (B2B), 23ns settling, and $-23.7 /-22.9 \text{dBm}$ OMA over 20 km SMF in $1290 / 1329 \text{nm}$.},
  keywords={Chromatic dispersion;Receivers;Silicon photonics;BiCMOS integrated circuits;Solid state circuits;Intensity modulation;Optical signal processing;Signal integrity;Silicon germanium;Demodulation},
  doi={10.1109/ISSCC49663.2026.11409355},
}

@INPROCEEDINGS{11408967,
  author={Kwon, Yongil and Kim, Sunkwon and Choi, Youngkil and Kwon, Taehyun and Ryu, Seongyoung and Na, Sewhan and Kim, Kangjoo and Song, Uijong and Lim, Hyun-Wook and Lee, Jongwoo and Lee, Jae-Yeol},
  title={24.1 A 28nm CMOS 1-Chip In-Pixel Memory Backplane Circuit with Pixel-Level Sensing and Compensation for 6652-PPI MicroLED AR Glasses},
  note={Section: Displays},
  abstract={This work presents a 28nm CMOS 1-chip in-pixel memory backplane for a 6652-PPI microLED AR display. Pixel-level sensing with pBIST enables accurate calibration and compensation of current variation. The $2.7 \mu ~\mathrm{m}$-pitch array integrates an 8b shifter with MSB latch for PWM. System techniques including self-refresh, partial update, and foveated rendering reduce MIPI bandwidth by 59.2% and power by up to 40.1%. Measured DNL $< \pm 0.25$ LSB and flicker SNR −72 dB validate circuit and system effectiveness.},
  keywords={Latches;Fluctuations;Backplanes;Current measurement;Glass;Pulse width modulation;Rendering (computer graphics);Sensors;Solid state circuits;Signal to noise ratio},
  doi={10.1109/ISSCC49663.2026.11408967},
}

@INPROCEEDINGS{11409298,
  author={Kim, Kihyun and Lee, Jun-Gi and Kim, Hyun-Sik},
  title={A 4042-PPI 10b 240Hz Digital-PWM CMOS Backplane for Micro-Led-on-Silicon Displays with a Shared, Unified Memory-in-Pixel Architecture},
  note={Section: Displays},
  abstract={This paper presents a 10b 240Hz digital-PWM CMOS backplane for $\mu \text{LED}$-on-Silicon with a shared, unified memory-in-pixel structure. A unified D-FF chain (UDC) merges the in-pixel register, counter, and comparator into one reconfigurable unit. Hierarchical time-divided PWM (HTD-PWM) with shuffled rolling-shutter (SRS) time-multiplexes an LSB engine across $1 \times 6$ pixel clusters. Fabricated in 28 nm CMOS, the $120 \times 120$ backplane achieves 4042PPI and an 88% active-area, with DNL/INL of 0.9/7.1LSBs.},
  keywords={Backplanes;Memory architecture;Pulse width modulation;Solid state circuits;Registers;Engines},
  doi={10.1109/ISSCC49663.2026.11409298},
}

@INPROCEEDINGS{11408983,
  author={Lee, Ching-Yen and Tsai, Yueh-Feng and Lin, Ying-Sheng and Yang, Chia-Hsiang},
  title={A 144mW 161Mpixels/s Tensor Display Processor for 3D Virtual Reality},
  note={Section: Displays},
  abstract={This work presents a 3D display processor that converts the focal stack to tensor display. Algorithm-architecture co-optimization is applied to reduce the computational complexity and hardware complexity. It achieves the maximum throughput of 161 Mpixels/s (equivalent to 87 fps at HD resolution) at a clock frequency of 200 MHz, with normalized energy consumption of $0.9 \text{nJ} /$ pixel, and a PSNR of 23.7 to 24.8 dB,},
  keywords={Energy consumption;Three-dimensional displays;Tensors;Energy resolution;Virtual reality;Throughput;Hardware;Solid state circuits;Computational complexity;Clocks},
  doi={10.1109/ISSCC49663.2026.11408983},
}

@INPROCEEDINGS{11409353,
  author={Park, Yousung and Lim, Gyu-Wan and Kim, Hyun-Sik},
  title={A 512ch 10b Source-Driver IC with Current-Mode Auto-Zeroing Scheme Achieving 1.4mV DVO and 600ns 1-Horizontal Time for Mobile OLED Displays},
  note={Section: Displays},
  abstract={This paper presents a 10b source-driver IC (SD-IC) for ultra-fast, uniform-luminance mobile OLEO displays. A current-mode auto-zeroing (CM-AZ) scheme transparently cancels output-buffer offset-lowering DVO with zero timing penalty-while simultaneously suppressing AC-coupling errors in the LSB-stacked DAC. Fabricated in 180nm CMOS with an 11.37µm channel pitch, the 512ch SD-IC achieves a 600ns 1-H time and a 1.4mV DVO, successfully demonstrated on an LED display panel.},
  keywords={Organic light emitting diodes;Timing;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409353},
}

@INPROCEEDINGS{11409093,
  author={Kim, Hyeong-Joon and Park, Yousung and Kim, Kihyun and Shin, Seunghwa and Kim, Hyun-Sik},
  title={A 10b Display Driver IC with a Pivoting Translinear-Loop DAC-in-Buffer Enabling $1\mu\mathrm{s}1-\mathrm{H}$ Scan Time and $1722\mu\mathrm{m}^{2}$ Per Channel},
  note={Section: Displays},
  abstract={This paper presents a 10b display driver IC (DDI) for high-resolution OLEDs. It features a novel pivoting translinear-loop (PTL) DAC-in-buffer that overcomes the area, speed, and linearity trade-offs. A key enabler is a floating voltage-mirror (FVM) that decouples coarse/fine domains, allowing an area-efficient 5b+5b architecture via true-DC interpolation while maintaining high linearity. Fabricated in 180nm CMOS, the DDI achieves a fast 1-H scan time of 1μs and a compact 1722μm2/channel.},
  keywords={Interpolation;Linearity;Organic light emitting diodes;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409093},
}

@INPROCEEDINGS{11409115,
  author={Jo, Yun-Rae and Na, Sewhan and Byun, Sanho and Park, Junchul and Ha, Gyeongmin and Ok, Jiheon and Song, Tae-Gyun and Lee, Woo-Nyoung and Lee, Jihyun and Lim, Hyun-Wook and Kim, Siwoo and Lee, Jae-Youl},
  title={24.6 A Touch-Embedded OLED Display-Driver IC with Display Noise Referencing and Display Coupling Noise Prediction Based on Dedicated Neural Networks for Mobile Applications with CoE Display},
  note={Section: Displays},
  abstract={This paper proposes a TDDI, integrating display driver and touch controller to overcome the interference issue between touch and display electrodes. In addition, an analog front-end (AFE) circuit is introduced to suppress coupling noise from display, and a dedicated neural network engine is used to improve interference based on displayed image and display driving condition. The TDDI can achieve SNRs of 43.4 and 41.8 dB with white and 1 H zebra images, respectively.},
  keywords={Couplings;Electrodes;Noise;Neural networks;Interference;Organic light emitting diodes;Solid state circuits;Mobile applications;Engines},
  doi={10.1109/ISSCC49663.2026.11409115},
}

@INPROCEEDINGS{11409291,
  author={Golder, Anupam and Kumar, Raghavan and Taneja, Sachin and Race, Kylan and Aseron, Paolo and Greensky, James and Wang, Wen and Gong, Huijing and Kethareswaran, Lalith and Suresh, Vikram and Vartak, Adish and Challagundla, AppaRao and Casas, Jeremy and Lalwaney, Poornima and Kim, Duhyeong and Gutierrez, Christopher N. and Ramos, Ernesto Zamora and Cho, Wonhee and Chaves, Jose M. Rojas and Steiner, Michael and Lake, Dan and Yennampelli, Nataraj and Nivarthi, Karthik and Bijinapally, Kamalakanth and Talamala, Bala Prasad and Valluri, Sravanth and Srirambhatla, Vasantha and Wilkerson, Chris and Cammarota, Rosario and Mathew, Sanu},
  title={HERACLES: 8192-Way SIMD Programmable Scalable Fully-Homomorphic Encryption SoC for Privacy-Preserving Cloud Computing in Intel 3 CMOS},
  note={Section: Hardware Security},
  abstract={A fully homomorphic encryption (FHE) accelerator SoC fabricated in Intel 3 CMOS with single-cycle 8k polynomial arithmetic throughput using a massively-parallel 8192-way SIMD vector compute engine is presented. The programmable SoC employs a 3-tiered memory subsystem, optimized Cooley-Tukey NTT/iNTT butterflies and a 2D mesh NoC to support multiple FHE schemes and parameters, with measured compute engine throughput of 29.49 TOPs at $0.75 \mathrm{V}, 1.2 \text{GHz}$, delivering up to $5547 \times$ higher FHE performance than generalpurpose CPUs.},
  keywords={Cloud computing;Single instruction multiple data;Throughput;Vectors;Polynomials;Solid state circuits;Homomorphic encryption;Engines;Arithmetic},
  doi={10.1109/ISSCC49663.2026.11409291},
}

@INPROCEEDINGS{11409039,
  author={Yu, Xinglong and Sun, Yi and Zhao, Yifan and Kuang, Honglin and Wang, Song and Yang, Zhen and Han, Jun},
  title={25.2 A 28nm 0.48mJ/boot Torus FHE Processor for Arbitrary Computation on Encrypted Data},
  note={Section: Hardware Security},
  abstract={This work presents a $3.24 ~\text{mm}^{2}$ torus fully homomorphic encryption (FHE) processor fabricated in 28 nm CMOS, featuring: 1) a security-preserving low-bit-width torus quantization with keys hints reducing latency by $62 \%, 2$) a divide-and-conquer innovative polynomial multiplication engine improving energy efficiency by 29%, and 3) a conflict-free atomic swizzling with full-depth pipelining reducing memory size by 96%. It delivers $196 \times$ higher energy efficiency in bootstrapping compared to a CPU.},
  keywords={Quantization (signal);Memory management;Energy efficiency;Polynomials;Solid state circuits;Computational efficiency;Cryptography;Homomorphic encryption;Engines;Pipeline processing},
  doi={10.1109/ISSCC49663.2026.11409039},
}

@INPROCEEDINGS{11409037,
  author={Ghosh, Archisman and Li, Ming-Che and Ding, Lingke and Kundu, Suparna and Sayeed, Abdullah and Karmakar, Angshuman and Naman, Harshit and Antal, Sarthak and Verbauwhede, Ingrid and Sen, Shreyas},
  title={25.3 A 16nm 0.042mm2 0.66μJ/Ops Lightweight MLWE PQC KEM with Cryptanalysis-ASIC Co-Optimization},
  note={Section: Hardware Security},
  abstract={Resource-limited devices demand post-quantum cryptography (PQC) within stringent power, area, and memory limits. To our knowledge this work introduces the first cryptanalysis-ASIC co-optimized PQC IC, achieving minimal area, power, and memory footprint. This approach achieves an area reduction of $8 \times$ relative to the state-of-the-art M-LWE accelerator and up to 509× compared to a generic PQC processor. Fabricated in Intel16, this IC operates over a frequency range of 0.1 MHz to 1.03 GHz and achieves an $8.5 \times$ reduction in energy-area product.},
  keywords={Solid state circuits;Cryptography},
  doi={10.1109/ISSCC49663.2026.11409037},
}

@INPROCEEDINGS{11409329,
  author={Putra, Adiwena and Cho, Hyunjun and Yune, Sungwoong and Duong, Cuong Manh and Jeon, Jaeho and Kim, Joo-Young},
  title={OmniCrypt: A 435.86M-GOPS/W Bootstrappable Multi-Scheme FHE Accelerator with on-Chip Data Generation for Privacy-Preserving Computation},
  note={Section: Hardware Security},
  abstract={OmniCrypt is a silicon-proven multi-scheme FHE accelerator that supports both bootstrapping and scheme switching. Fabricated in 28nm CMOS (12.96 mm2), it integrates three specialized engines for efficient external product computation, on-chip data generation, and the SAM3 modular multiplier to minimize memory and compute overhead. OmniCrypt achieves 252.8M-GOPS, 19.5M-GOPS/mm2, and 435.9 M-GOPS/W, delivering the highest CKKS bootstrapping throughput and $107 \times$ CPU speedup in application benchmarks.},
  keywords={Memory management;Switches;Data collection;Benchmark testing;Throughput;System-on-chip;Solid state circuits;Computational efficiency;Central Processing Unit;Engines},
  doi={10.1109/ISSCC49663.2026.11409329},
}

@INPROCEEDINGS{11408981,
  author={Ramapragada, Krishna Sai Tarun and Banerjee, Utsav},
  title={A 0.05mm2 1.19-to-7.34mW SQIsign-1D Isogeny-Based Post-Quantum Signature Verification Accelerator for IoT},
  note={Section: Hardware Security},
  abstract={This work presents a $0.05 \text{mm}^{2}$ and 1.19 -to- 7.34 mW hardware accelerator for the isogeny-based NIST post-quantum digital signature candidate SQIsign. Our Montgomery multiplier design enables $2 \times$ speedup and energy savings, and efficient memory organization provides 31% area savings. We demonstrate SQIsign-1D uncompressed signature verification in a small form factor for IoT applications with order of magnitude improvement in performance and energy-efficiency compared to assembly-optimized software.},
  keywords={Handwriting recognition;Memory management;Energy conservation;Organizations;NIST;Software;Energy efficiency;Solid state circuits;Internet of Things;Hardware acceleration},
  doi={10.1109/ISSCC49663.2026.11408981},
}

@INPROCEEDINGS{11409007,
  author={Zhao, Cankun and Shui, Hanyue and Yang, Bohan and Zhu, Wenping and Cao, Yuluan and Hou, Zhang and Liu, Yuqi and Han, Xiangdong and Yin, Shuying and Chen, Weinan and Wang, Hanning and Yang, Jinjiang and Zhu, Min and Zhang, Aoyang and Liu, Leibo},
  title={25.6 A 17%/27% Area-/Energy-Overhead Glitch-Transition Secure SHA-3 Engine Fusing Dual-Rail Precharge Logic and Asymmetric Masking},
  note={Section: Hardware Security},
  abstract={This 0.046 mm2 SHA-3 engine demonstrates overheads of only 17% area, 27% energy, and 0% latency while achieving provable glitch- and transition-robust security (power/EM TVLA MTD $>100 \mathrm{M}$). Glitch-free DPL reduces masked states by $3 \times$, resulting in a $72,950 \mu \mathrm{m}^{2}$ register area reduction and lower logic energy. LMDPL refresh preserves secure asymmetric-share mapping. Masked transitions enable partial replacement of DPL with SRL, saving $50,852 \mu \mathrm{m}^{2}$ in registers, precharge gates, and multiplexers.},
  keywords={Multiplexing;Logic gates;Registers;Solid state circuits;Security;Logic;Engines},
  doi={10.1109/ISSCC49663.2026.11409007},
}

@INPROCEEDINGS{11409005,
  author={Li, Mao and Wan, Rentao and Mathew, Sanu K and De, Vivek and Seok, Mingoo},
  title={TinyPAD: A 166μm2/Lane Variation-Tolerant Probing-Attack Detector for an 8Gb/s/Lane Chip-to-Chip Interface in 16nm FinFET},
  note={Section: Hardware Security},
  abstract={We present TinyPAD, a $166 \mu \mathrm{m}^{2} /$ lane probing-attack detector in 16 nm FinFET with 82pF maximum supported loading as well as 0.2 pF minimum detectable capacitance (MDC) that operates robustly over −40 to 125 °C and from a 0.65-to-1.2 V supply. We integrate TinyPAD in a 5-lane $8 \text{Gb} / \mathrm{s} /$ lane chip-to-chip interface. Compared to the prior arts, TinyPAD achieves $3.3 \times$ maximum supported loading, $2.5 \times$ smaller MDC over all voltage and temperature conditions, $1.3 \times$ wider range for temperature, $1.2 \times$ for voltage, at $11 \times$ smaller area overhead.},
  keywords={Temperature distribution;Art;Loading;Voltage;Detectors;FinFETs;Capacitance;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409005},
}

@INPROCEEDINGS{11409111,
  author={Xu, Shufan and Liu, Kunyang and Chan, Lando and Tagawa, Hironori and Shinohara, Hirofumi and Niitsu, Kiichi},
  title={A Sub-Threshold All-NMOS Reconfigurable PUF with Secure Configuration Selection for Stable 6b/Cell},
  note={Section: Hardware Security},
  abstract={In this work, a reconfigurable PUF featuring secure configuration selection is presented. Without exposing secret PUF data, it achieves 6 stable bits per cell (b/cell) and “zero” bit error $(<6.5 \mathrm{E}-8 \text{BER})$ across 0 to $70^{\circ} \mathrm{C}$ and 0.6 to 0.8 V. The area per effective bit is only 253F2. Operating in the sub-threshold region, the PUF achieves low energy consumption of $16.8 \text{fJ} / \mathrm{b}$. The all-NMOS bitcell structure mitigates long-term NBTI aging, which is verified through a 45-hour accelerated stress test.},
  keywords={Negative bias temperature instability;Energy consumption;Thermal variables control;Accelerated aging;Life estimation;Solid state circuits;Stress},
  doi={10.1109/ISSCC49663.2026.11409111},
}

@INPROCEEDINGS{11409323,
  author={Youn, Yelim and Lim, Yong and Lee, Jongmi and Hong, Dongyeon and Kim, Wan and Kwak, Yong-Sik and Moon, Kyoung-Jun and Kang, Bogyeong and Yoo, Sangmin},
  title={A PVT Variation- and Attack-Tolerant Metastability-Based TRNG Using Binary Search in 2nm},
  note={Section: Hardware Security},
  abstract={This work presents a single source, metastability-based TRNG using binary search with offset-tunable comparator. The proposed TRNG operates without warm-up time and is robust against low-frequency noise, PVT variations and environmental attacks, while its stochastic model is analytically verified. Fabricated in 2nm MBCFET, the prototype occupies $320 \mu \mathrm{m}^{2}$, operates at 20Mb/s with 1.8pJ/b. The measurement result of 320 chips shows NIST- and AIS-compliant randomness across all PVT corners.},
  keywords={Semiconductor device measurement;Analytical models;Low frequency noise;Stochastic processes;Prototypes;Solid state circuits;Integrated circuit modeling},
  doi={10.1109/ISSCC49663.2026.11409323},
}

@INPROCEEDINGS{11409134,
  author={Cheng, Kai and Huang, Yunbo and Yang, Zunsong and Wang, Li and Ren, Hongyu and Shan, Xiaoyu and Mak, Pui-In and Chen, Yong and Li, Bo},
  title={25.10 A 65nm 0.066pJ/b Floating-Latch-Based True Random Number Generator Resilient to Power-Noise Injection Attacks},
  note={Section: Hardware Security},
  abstract={In Paper 25.10 a floating-latch-based true random number generator (FL-TRNG) is presented that achieves an energy efficiency of 0.066pJ/b by leveraging a floating reservoir capacitor as its power supply. This architecture inherently offers strong resilience against power-supply noise injection attacks. Furthermore, current-starved inverters are employed within the latch to perform mismatch compensation and enhance PVT tolerance.},
  keywords={Latches;Power supplies;Noise;Capacitors;Reservoirs;Generators;Inverters;Energy efficiency;Solid state circuits;Resilience},
  doi={10.1109/ISSCC49663.2026.11409134},
}

@INPROCEEDINGS{11409126,
  author={Yang, Jianxin and Zhang, Fuyao and Martins, Rui P. and Huang, Mo},
  title={26.1 Coupled-OSC-Based Converters Achieving 89.5% Peak Efficiency at 61MHz, 1.82W/mm2 Power Density at 360MHz, and Inherent Even Phase Interleaving},
  note={Section: Compute Power and Supply Modulators},
  abstract={This work proposes coupled-OSC-based high-frequency converters. Retaining gate-charge recycling from prior single-phase design, this work achieves inherent even phase interleaving along with per-phase and per-inductor current balancing. It reduces the inductor count per phase, while enabling high-speed ON-OFF control and improving load-transient performance using a fast startup scheme. It achieves 89.5% peak PCE at 61MHz with air-core inductors, and 80% peak PCE and 1.82W/mm2 density at 360MHz using bondwire inductors.},
  keywords={Power system measurements;Density measurement;Logic gates;Solid state circuits;Recycling;Inductors},
  doi={10.1109/ISSCC49663.2026.11409126},
}

@INPROCEEDINGS{11409219,
  author={Du, Yukan and Ren, Shengdao and Fei, Zheyuan and Chen, Ziteng and Zhao, Menglian and Li, Chushan and Ding, Yong and Li, Wuhua and Tan, Zhichao and Qu, Wanyuan},
  title={26.2 A Compact 4Vin 93.4%-Peak-Efficiency 12A Load and 20mV Undershoot Resonant Sigma Converter with PCB-Embedded Converter-on-Substrate Packaging},
  note={Section: Compute Power and Supply Modulators},
  abstract={This work presents a 4 V input 12 A load resonant sigma converter which consists of a 10 MHz high-side switched-capacitor Buck (SCB) and a 5 MHz low-side direct resonant switchedcapacitor (ReSC) converter. The proposed converter features a low V.A metric, a compact volume, and more importantly, a fast response by providing an $\sim 0.5 \mathrm{A}/\text{ns}$ current slew rate during the transient. The measurements show 93.4% peak efficiency, 20 mV undershoot under a 6 A load step and 0.38 A/mm2 system current density.},
  keywords={Density measurement;Switches;Packaging;Solid state circuits;Transient analysis;Current density},
  doi={10.1109/ISSCC49663.2026.11409219},
}

@INPROCEEDINGS{11409149,
  author={Yang, Jiacheng and Tang, Zihao and Martins, Rui P. and Huang, Mo},
  title={A Multi-Phase Hybrid Converter with Q Samplers Enabling Simultaneous IL Auto-Balance and Arbitrary Phase Count},
  note={Section: Compute Power and Supply Modulators},
  abstract={The paper presents a multiple-phase hybrid converter with $Q$ samplers. Split- $T_{0 \mathrm{N}}$ control enables $V_{C F}$ auto-balance and arbitrary phase counts under all-phase interleaving, while O-V $Q$ samplers support $I_{\mathrm{L}}$ auto-balance with minimal reduction in power density. It achieves peak efficiencies of 90.5% and 91.5% at 1 V and $1.8 \mathrm{V} V_{0}$. With 6-phase operation and ALL-ON control, the converter attains the lowest normalized undershoot. This method is extendable to other hybrid converters.},
  keywords={Power system measurements;Density measurement;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409149},
}

@INPROCEEDINGS{11409227,
  author={Min, Qingqing and Yuan, Jinyi and Jin, Ji and Ji, Yichao and Xu, Weiwei and Cheng, Lin},
  title={26.4 A 12-to-1V 90.5%-Peak-Efficiency 721A/cm3-Current-Density Quad-Output Converter with One Shared DC Capacitor},
  note={Section: Compute Power and Supply Modulators},
  abstract={This paper presents a 12-to-1V 4-output hybrid DC-DC converter that shares a single DC capacitor among all outputs. This shared capacitor stores and redistributes energy, ensuring independent regulation at each output. The proposed design achieves a 721A/cm3 current density and 90.5% peak efficiency at 12-to-1.1V at 2MHz, delivering up to 16A of total load current. The measured results during load transients shows there is no cross-regulation issue.},
  keywords={Capacitors;DC-DC power converters;Regulation;Solid state circuits;Transient analysis;Current density},
  doi={10.1109/ISSCC49663.2026.11409227},
}

@INPROCEEDINGS{11409286,
  author={Zhu, Zhongyao and Huang, Junwei and Song, Zhibang and Yu, Zhewen and Han, Shousheng and Sin, Sai-Weng and Lu, Yan},
  title={26.5 An Inductor-at-Middle Hybrid Buck Converter with Shared Power-Signal Path for Distributed Vertical Power Delivery},
  note={Section: Compute Power and Supply Modulators},
  abstract={This work presents an inductor-at-middle hybrid buck converter for high-current density vertical power delivery, reusing the power inductors as signal feedback paths. The proposed switching-bus-multiplexing control reuses the power path to carry a feedback signal, mitigating the challenges in sophisticated signal and power network co-design for pinintensive distributed power delivery networks. The prototype achieves a vertical current density of $3.17 \mathrm{A} / \text{mm}^{2}$.},
  keywords={Buck converters;Prototypes;Switches;Control systems;Hybrid power systems;Solid state circuits;Inductors;Current density},
  doi={10.1109/ISSCC49663.2026.11409286},
}

@INPROCEEDINGS{11408986,
  author={Jeong, Hyun-Woo and Lee, Chan-Ho and Choi, Hyeon-Ji and Hong, Sung-Wan},
  title={26.6 a 92.4%-Peak-Efficiency 48V to 0.8-to-1.6V Hybrid Converter with Inductor-Interleaved Fibonacci Switched-Capacitor},
  note={Section: Compute Power and Supply Modulators},
  abstract={This paper presents a 92.4%-peak-efficiency 48V to 0.8-to-1.6V hybrid converter based on an inductor-interleaved Fibonacci switched-capacitor (I2-FSC). The proposed converter reduces $\Delta \mathrm{V}_{\mathrm{L}}$ with few flying capacitors, thereby achieving a high duty cycle under ultra-low VCRs and reducing ACR loss. It also minimizes switching and conduction losses, while current distribution lowers DCR loss and a fixed 0.5 duty in the capacitive path reduces $\mathrm{V}_{0}$ ripple. The chip is fabricated in a 180nm BCD process.},
  keywords={Capacitors;Switches;Current distribution;Solid state circuits;Video recording;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11408986},
}

@INPROCEEDINGS{11409334,
  author={Liu, Zeguo and Ji, Yichao and Luo, Zhiren and Ge, Yu and Xu, Weiwei and Huang, Weiwei and Cheng, Lin},
  title={26.7 A 100A 93.4%-Peak-Efficiency LLC Resonant Converter with an Embedded Primary-Current-Extracted Regulator},
  note={Section: Compute Power and Supply Modulators},
  abstract={This paper presents a $100 \mathrm{A} 93.4 \%$-peak-efficiency LLC resonant converter with an embedded primary-current-extracted regulator. The proposed regulator powers the gate drivers of the LLC converter, eliminating the need for an external auxiliary buck converter or additional auxiliary windings. Fabricated in a $0.18 \mu \mathrm{m}$ BCD process, the proposed regulator occupies a die are of $8.3 \text{mm}^{2}$ and achieves a 60 V-to-2 V conversion at 1 MHz with a peak efficiency of 93.4%.},
  keywords={Regulators;Buck converters;Windings;Resonant converters;Gate drivers;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409334},
}

@INPROCEEDINGS{11409118,
  author={Chen, Changjin and Shang, Minghao and Ji, Yichao and Cheng, Lin},
  title={A 1.2μs 1-to-12V Symbol Power Tracking Supply Modulator with Two-Step Subranging DVS Scheme and Boosted IL Slew Rate for 5G Mobile Devices},
  note={Section: Compute Power and Supply Modulators},
  abstract={This paper presents a symbol power tracking supply modulator that delivers a high output voltage and a wide output range for 5G high-voltage GaN PAs. To accelerate voltage transitions, a two-step subranging DVS scheme reduces the charge required for large voltage steps, while an inductor current slew-rate enhancement technique boosts the charging current. Fabricated in a $180-\text{nm}$ BCD process, the proposed modulator achieves a $1.2 \mu \mathrm{s}$ transition across a wide $1-\text{to}-12 \mathrm{V}$ range.},
  keywords={5G mobile communication;Modulation;Symbols;Voltage;High-voltage techniques;Mobile handsets;Solid state circuits;Voltage control;Inductors},
  doi={10.1109/ISSCC49663.2026.11409118},
}

@INPROCEEDINGS{11409358,
  author={Yu, Zhewen and Tong, Zhiguo and Huang, Junwei and Yin, Jun and Lu, Yan},
  title={A Compact Dual-Capacitor Relay SPT Supply Modulator with Overshoot-Free Adaptive on-Time Control for 5G FR2 CMOS PA},
  note={Section: Compute Power and Supply Modulators},
  abstract={5G new-radio frequency-range-2 CMOS PAs with high peak-to-average-power ratios suffer from low efficiency, calling for compact and fast symbol-power-tracking (SPT) supply modulators (SMs). Inductor-based SPT shows limited tracking speed, while multilevel switched-capacitor approaches need redundant capacitors and switches. The proposed prototype dual-capacitor relay SPT SM with overshoot-free adaptive constant on-time control achieves <290ns tracking using a 0402 inductor, suitable for compact PA arrays.},
  keywords={Frequency modulation;5G mobile communication;Capacitors;Prototypes;Adaptive arrays;Switches;Solid state circuits;Relays;Inductors},
  doi={10.1109/ISSCC49663.2026.11409358},
}

@INPROCEEDINGS{11408980,
  author={Ye, Zonglin and Sun, Yuxuan and Hou, Longxiang and Ding, Yuhan and Wen, Yixuan and Zhang, Hongyang and Geng, Xinlin and Xie, Qian and Yang, Shiheng and Wang, Zheng},
  title={27.1 A 20GHz Frequency Synthesizer with Spur-Shaping Modulator Achieving 46.2fs Jitter and −76.5dBc Worst-Case Fractional Spur},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={In this paper, a frequency synthesizer is proposed with low fractional spur and low jitter, featuring a spur-shaping-modulator (SSM) technique that suppresses the nonlinearity arising from inter-slice mismatch. Implemented in 28 nm CMOS, the prototype synthesizer is measured to achieve a 46.2 fs integrated jitter, a −84.1 dBc near-integer fractional spur, and a −76.5 dBc worst-case fractional spur with a −251.4 dB FoM and −102.6 dB FoMIBS.},
  keywords={Frequency synthesizers;Synthesizers;Prototypes;Modulation;Jitter;Solid state circuits;Frequency measurement},
  doi={10.1109/ISSCC49663.2026.11408980},
}

@INPROCEEDINGS{11409292,
  author={Zhang, Haoming and He, Yongjun and Zhu, Yuyang and Ren, Huanyu and Iizuka, Tetsuya},
  title={A 157fsrms-Jitter, −73dBc-Fractional-Spur, Calibration-Free Cascaded SPLL Employing Robust Feedforward Noise Cancellation and MMD-Based Quantization-Error Cancellation with a 60MHz Reference},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={This work presents a 6.2-to-6.8GHz calibration-free fractional-N sampling PLL with cascaded architecture, achieving 157fsrms jitter and a −73dBc fractional spur using feedforward noise cancellation (FFNC) and MMD-based quantization-error cancellation (QEC). The QEC reduces Q-error by N, enabling a low-noise SPD for fractional-N operation. With both stages as SPLLs, the FFNC-path gain and the original-path gain inherently match regardless of division-ratio changes, ensuring robust cancellation of the first-stage VCO noise.},
  keywords={Voltage-controlled oscillators;Jitter;Noise cancellation;Solid state circuits;Phase locked loops},
  doi={10.1109/ISSCC49663.2026.11409292},
}

@INPROCEEDINGS{11409125,
  author={Zhu, Zhaochen and Lin, Qingxuan and Huang, Zhiqiang},
  title={A 14GHz Ring-Based 3rd-Order Fractional-N PLL with 164fsrms Jitter and a 100MHz Reference},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={This work presents a 14 GHz ring-based $3^{\text{rd }}$-order fractional-N PLL with $164 \text{fs}_{\text{rms }}$ jitter and a 100 MHz reference. A sub-sampling DLL is cascaded in the type-II PLL output for extra phase-noise and supply-noise suppression. A narrow-pulsed integrator is used in the sub-sampling DLL to reduce integrated jitter. A tri-state polarity-reversible SSPD is employed to reduce the DTC range and bandwidth degradation. Delay calibration is applied to reduce the VCDL delay range and implement the VCDL duty-cycle calibration.},
  keywords={Degradation;Bandwidth;Jitter;Delays;Calibration;Solid state circuits;Phase locked loops},
  doi={10.1109/ISSCC49663.2026.11409125},
}

@INPROCEEDINGS{11409041,
  author={Du, Xincheng and Zhan, Xiangxun and Ou, Tincheng and Chen, Zaize and Li, Jinge and Li, Haoran and Yang, Zhizhan and Xu, Zhuo and Mak, Pui-In and Martins, Rui P. and Yin, Jun},
  title={A 0.068mm2 8.5-to-12.7GHz Complementary Dual-Core VCO with Auto-2nd-Harmonic-Tracking Technique Achieving 202.7dBc/Hz Peak FoMT and 0.9dB-FoM Variation at a 1MHz Offset in a 39.6% Tuning Range},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={A complementary dual-core VCO with auto $\mathrm{f}_{\text{2nd }}$ tracking is proposed to achieve consistently low PN and a high FoM over a wide tuning range (TR). Prototyped in 65 nm CMOS, the proposed VCO achieves a peak $\text{FoM}_{@ 1 / 10 \text{MHz}}$ of $190.7 / 193.5 \text{dBc} / \text{Hz}$ with only $0.9 / 1.6 \text{dB}$ variation across the TR from 8.5 to $12.7 \text{GHz}(39.6 \%)$. The VCO occupies a compact area of $0.068 \text{mm}^{2}$ including a small decoupling capacitor of 18pF.},
  keywords={Voltage-controlled oscillators;Capacitors;Solid state circuits;Tuning},
  doi={10.1109/ISSCC49663.2026.11409041},
}

@INPROCEEDINGS{11409336,
  author={Wu, Yue and Peng, Yatao and Li, Jiawei and Yuan, Fengen and Li, Jinge and Yin, Jun and Martins, Rui P. and Mak, Pui-In},
  title={27.5 A $17.9-\text{to}-22.4 \text{GHz} 195.6 \pm 1.3 \text{dBc} / \text{Hz}$ FoM Quad-Core Class-F−1 VCO Featuring Improved Synchronization Using a Circular Pentafilar Transformer-Based Tank},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={A $17.9$-to-22.4GHz quad-core inverse-Class-F VCO achieving PN of −145.6 to $-141 \text{dBc} / \text{Hz}$ and an FoM of 194.3 to $196.9 \text{dBc} / \text{Hz}$ is reported. The VCO features a circular pentafilar transformer tank that provides high Q1/Q2 without requiring extra CM resonators. Multi-path synchronizations—in-phase at gates, out-of-phase at drains, and an auxiliary dual-path coil—equalize impedances at both $\mathrm{f}_{0}$ and $2 \mathrm{f}_{0}$. A segmented alignment technique is proposed to preserve 1D tuning with improved robustness against PVT variations.},
  keywords={Voltage-controlled oscillators;Logic gates;Transformers;Robustness;Solid state circuits;Synchronization;Resonators;Tuning},
  doi={10.1109/ISSCC49663.2026.11409336},
}

@INPROCEEDINGS{11409004,
  author={Zhang, Daxu and Zhang, Yuncheng and Liu, Zezheng and Xiong, Yuang and Rossoni, Michele and Wang, Wenqian and Fadila, Ashbir Aviat and Li, Duo and Tang, Minzhe and Xu, Dongfan and de Gomez, Carrel and Xu, Dingxin and Kunihiro, Kazuaki and Sakai, Hiroyuki and Okada, Kenichi},
  title={27.6 A 9.7GHz Self-Linearized-VCO-Based FMCW Chirp Generator Achieving 1.56GHz/μs Slope and 0.57μS Duration with 0.094% RMS Frequency Error},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={A 9.7GHz self-linearized-VCO-based Type-III FMCW synthesizer is presented. A $\mathrm{C}_{\text{Cal }}$ bank calibrates the nonlinearity of the $\mathrm{C}_{\text{Mod }}$ bank, and two LMS-based calibrations (gain and offset) reduce digital overhead and ensure stable convergence under fast chirp rates. Fabricated in 65 nm CMOS, it achieves the shortest chirp duration of $0.57 \mu \mathrm{s}$, a 40 ns retrace, and a $1562.8 \text{MHz} / \mu \mathrm{s}$ chirp rate, delivering a 1GHz bandwidth with a $0.094 \% \text{rms} \text{FM}$ error.},
  keywords={Chirp;Synthesizers;Bandwidth;Generators;Solid state circuits;Calibration;Convergence},
  doi={10.1109/ISSCC49663.2026.11409004},
}

@INPROCEEDINGS{11409312,
  author={Liu, Yi and Jing, Zixi and Yang, Wen and Yang, Hanlin and Zhang, Bodong and Luong, Howard Cam},
  title={A 40.5-to-58.5GHz 36%-Fractional-Chirp-Bandwidth 18GHz-Absolute-Chirp-Bandwidth 2.2GHz/μs-Chirp-Rate 0.02%-Chirp-Error Post-Mixing Bandwidth-Extending Sawtooth-FMCW Frequency Synthesizer Employing a Chirp-Tracking ILFT and a Fractional-Bandwidth Doubler},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={An 18GHz-bandwidth (BW) sawtooth-FMCW synthesizer is presented. First, a chirp-tracking ILFT with feed-forward and frequency-tracking loop ensures robust and continuous tracking of fast chirps. Second, a fractional-BW (FBW) doubler enables sawtooth generation and extends both the BW and FBW while halving the chirp error. The synthesizer measures a 36% FBW sawtooth FMCW chirp from 40.5 to 58.5 GHz with a 0.02% chirp error at a chirp rate of $2.2 \text{GHz} / \mu \mathrm{s}$ without DCO-nonlinearity digital pre-distortion.},
  keywords={Frequency locked loops;Tracking loops;Frequency synthesizers;Chirp;Synthesizers;Measurement uncertainty;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409312},
}

@INPROCEEDINGS{11409183,
  author={Park, Geonho and Moon, Byeong-Taek and Kim, Kyunghwan and Kim, Doyoon and Baek, Goeun and Yook, Byungho and Park, Hyun-Chul and Park, Chan-Hong},
  title={A 77GHz 8-bit CMOS Phase Shifter Adopting a Nested-Vector-Based Error Correction with 0.33°/0.07dB RMS-Error for MIMO Radar Applications},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={In this paper, we present a 77GHz 8-bit nested vector-sum phase shifter in 28nm CMOS. The architecture performs vector modulation by splitting a single outer vector into two inner vectors generated by a two-stage I/Q coupler. Owing to its insensitivity to I/Q mismatch and the peak error smoothing technique, the phase shifter achieves 0.33° and 0.065dB rms phase and gain errors while occupying a core area of 0.17mm2.},
  keywords={Smoothing methods;MIMO radar;Phase shifters;Couplers;Vectors;Solid state circuits;Error correction},
  doi={10.1109/ISSCC49663.2026.11409183},
}

@INPROCEEDINGS{11409064,
  author={Chen, Jiawen and Xu, Kai and Guo, Luyi and Siriburanon, Teerachot and Yin, Jun and Al-Hashimi, Bashir M. and Staszewski, Robert Bogdan},
  title={27.9 A Dual-Mode DCO-PA with a Twisted 8-Shape Inductor for BLE Achieving 42% TX Efficiency at 1.6dBm and 0.29mW RX Clock},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={This paper presents a 0.3 V dual-mode $(2.4 / 4.8 \text{GHz})$ DCO-PA for BLE, achieving 42% efficiency in the TX mode and 0.29 mW power consumption in the RX clock mode. It features: 1) a twisted 8-shape inductor enabling octave tuning, with Class-D-like operation boosting transistor efficiency to 75%; 2) a tail transistor in the RX mode that minimizes power consumption and lowers the 1/f phase-noise corner to $\sim 40 \text{kHz}$.},
  keywords={Power demand;Boosting;Transistors;Inductors;Tuning;Clocks},
  doi={10.1109/ISSCC49663.2026.11409064},
}

@INPROCEEDINGS{11409289,
  author={Jamal, Jismal and Piotto, Lorenzo and Vecchi, Federico and Pirbazari, Mahmoud M. and Mazzanti, Andrea},
  title={A 48-to-82.5GHz CMOS Split-Tail Gilbert-Cell Frequency Doubler Achieving 11% PAE at 8.5dBm Output Power},
  note={Section: Frequency Generators, Multipliers and Modulators},
  abstract={A 48-to-82.5 GHz frequency doubler in 28 nm FDSOI CMOS using a modified Gilbert cell is presented. The tail transconductors are split and the switching-quad transistors AC-shorted by capacitors. DC offset builds up across the capacitors, reducing the switching-quad duty cycle in steady state. This mechanism enhances power-conversion gain and efficiency. Measurements show 8.5 dBm output power at 11% PAE.},
  keywords={Power measurement;Capacitors;Silicon-on-insulator;Switches;Transconductors;Steady-state;Transistors;Power generation;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409289},
}

@INPROCEEDINGS{11409280,
  author={Mishra, Umesh K. and Clymore, Christopher J. and Akso, Emre and Guidry, Matthew},
  title={28.1 Importance of GaN for 5G and Solid-State mm-Wave Circuits of the Future},
  note={Section: Innovations from Outside the (ISSCC) Box},
  abstract={GaN has played an important role in both RF and power devices. GaN made the rapid development and deployment of 5G base stations possible with use of its Ga-polar face. Meanwhile, the N-polar face of GaN has shown great promise through current research, with record power and efficiency at W-band. The benefits of N-polar GaN for systems include a smaller size with fewer power amplifier chips combined due to its higher power density, and lower cost of operation with its improved efficiency.},
  keywords={Radio frequency;Power system measurements;Base stations;Costs;5G mobile communication;Density measurement;Circuits;Power amplifiers;Solid state circuits;Faces},
  doi={10.1109/ISSCC49663.2026.11409280},
}

@INPROCEEDINGS{11409216,
  author={Yao, Shun and Du, Xingyu and Ding, Yixiao and Wu, Shuxian and Chang, Chin-Yu and Allen, Mark and Olsson, Roy H.},
  title={28.2 High-Selectivity, Tunable Filters with Zero Static Power Consumption Formed using Micromachined Magnetostatic Wave Cavities},
  note={Section: Innovations from Outside the (ISSCC) Box},
  abstract={This work reports zero-static-power, high-Q magnetostatic wave filters in YIG films with wide frequency tuning range and high selectivity. A compact 1.2-cc magnetic bias circuit enables continuous operation without DC power. This supports bandpass filter tuning from $3.3-9.7 \text{GHz}$ with $2-3 ~\text{dB}$ insertion loss and $>35 ~\text{dB}$ rejection, and notch filter tuning from 3.5-to-16.8GHz with $<0.9 ~\text{dB}$ loss and $>38 ~\text{dB}$ notch. Thickness-scaled YIG extends operation to 32 GHz with fewer spurs and higher power handling.},
  keywords={Power demand;Magnetostatics;Magnetic separation;Magnetostatic waves;Insertion loss;Filtering theory;Solid state circuits;Tuning;Notch filters;Magnetic circuits},
  doi={10.1109/ISSCC49663.2026.11409216},
}

@INPROCEEDINGS{11409234,
  author={Gao, Wei},
  title={Body-Interfaced Biosensors},
  note={Section: Innovations from Outside the (ISSCC) Box},
  abstract={The rise of personalized medicine is transforming healthcare through predictive and tailored strategies. I will present our progress on wearable, implantable, and ingestible biosensors for real-time molecular analysis across diverse body fluids. These scalable, nanomaterialbased systems enable continuous monitoring of metabolites, hormones, and drugs, with applications in stress, nutrition, chronic disease, and personalized therapy.},
  keywords={Drugs;Fluids;Precision medicine;Real-time systems;Solid state circuits;Biosensors;Biomedical monitoring;Stress;Monitoring;Diseases},
  doi={10.1109/ISSCC49663.2026.11409234},
}

@INPROCEEDINGS{11409202,
  author={Sapiro, Guillermo and Di Martino, Matias and Dawson, Geraldine},
  title={28.4 The Sensing, Computing, and Devices Opportunities of Computational Behavioral Phenotype: An Autism Spectrum Disorder Case Study},
  note={Section: Innovations from Outside the (ISSCC) Box},
  abstract={The AI revolution will come when high-quality healthcare is accessible to all. We describe steps towards this in autism screening. We developed an app displaying stimuli eliciting behaviors that allow to detect signs of autism. These are automatically detected and quantified using machine learning, enabling an early, scalable, and accurate detection. This exemplifies the potential for mobile AI to provide an accessible approach to health and the technology challenges that come with it.},
  keywords={Autism;Phenotypes;Accuracy;Medical services;Machine learning;Solid state circuits;Sensors},
  doi={10.1109/ISSCC49663.2026.11409202},
}

@INPROCEEDINGS{11409025,
  author={Wu, Xiaoyuan and Zhao, Kangjie and Liu, Mengyao and Ding, Shixiang and Li, Xuyang and Lu, Yuri and Wang, Ruohan and Zhao, Ziyan and Qian, Liwen and Yang, Yang and Wu, Jing and Huang, Leilei and Shi, Chunqi and Wei, Yuhong and Lu, Yue and Guan, Ningzi and Ye, Haifeng and Chen, Jinghong and Zhang, Runxi},
  title={29.1 A 48-Day-Duration Pasting Bioelectronic Device Realizing Closed-Loop Realtime Detection and Precision Treatment for Type-1 Diabetes},
  note={Section: Biochemical Sensors for Life Sciences and Agriculture},
  abstract={Conventional management of type-1 diabetes (T1D) relies on finger-prick blood sampling or electrochemical methods, which prevent continuous monitoring and treatment. This paper presents a novel epidermal pasting bioelectronic device (PBD). The device integrates a 19fA-resolution bioluminescence analog front-end (BAFE) with TDM-SAR calibration and a hybrid-mode LED driver. It enables closed-loop realtime detection and precision treatment for T1D. The battery life reaches 48 days.},
  keywords={Bioluminescence;Light emitting diodes;Epidermis;Diabetes;Solid state circuits;Calibration;Batteries;Monitoring;Blood},
  doi={10.1109/ISSCC49663.2026.11409025},
}

@INPROCEEDINGS{11409267,
  author={David, Jean-Baptiste and Siligaris, Alexandre and Dehos, Cédric and Jimenez, José Luis Gonzalez and Jacquot, Jean-François and Lombard, Christian and Chighine, Kevin and Maurel, Vincent and Gambarelli, Serge},
  title={A 1400THz/s Ultra-Fast-Scan 14GHz EPR-on-a-Chip Based on Injection-Locked Phase Detection Featuring 120μM Concentration Sensitivity},
  note={Section: Biochemical Sensors for Life Sciences and Agriculture},
  abstract={A battery-operated low power (96mW), high sensitivity $(120 \mu \mathrm{M}$), wide span (100Gauss) Ultra-fast scan (1400THz/s) EPR-on-a-Chip based on injection-locked phase detection, implemented in CMOS 22nm-FDSOI technology is presented. 14GHz coherent frequency generation and sensing signal down-conversion is used to implement a stable and low noise EPR readout at around 500MHz without requiring lock-in based demodulation. A single inductor is used as paramagnetic sensor.},
  keywords={Sensitivity;Noise;Phase frequency detectors;CMOS technology;Solid state circuits;Sensors;Inductors;Demodulation},
  doi={10.1109/ISSCC49663.2026.11409267},
}

@INPROCEEDINGS{11409180,
  author={Crols, Sander and Lopez, Carolina Mora and Tavernier, Filip and Verhelst, Marian and Van Helleputte, Nick},
  title={29.3 A 256-Channel Event-Driven Readout for Solid-State Nanopore Single-Molecule Sensing with 193pArms Noise in a 1MHz Bandwidth},
  note={Section: Biochemical Sensors for Life Sciences and Agriculture},
  abstract={The paper presents a 256 -channel solid-state nanopore readout IC in 65 nm CMOS. A new integrate-and-hold TIA cuts per-pore power and area $>6 \times$ while achieving 1 MHz BW and 193 pArms at 10 nA. Event detection with dynamic slot allocation exploits sub-1 percent activity to reduce ADC data $32 \times$. The chip delivers 1 mW and 0.019 mm2 per pore and records labeled DNA translocations, enabling scalable, low-cost single-molecule diagnostics.},
  keywords={Event detection;Noise;DNA;Bandwidth;Dynamic scheduling;Solid state circuits;Sensors;Resource management},
  doi={10.1109/ISSCC49663.2026.11409180},
}

@INPROCEEDINGS{11409324,
  author={Huang, Zhikai and Jiang, Fuze and Liu, Hangxing and Wang, Adam and Sheng, Yuguo and Saif, Marco and Wang, Hua},
  title={29.4 Shape-Memory Multi-Size Micro-Cage Array on CMOS with Integrated Electrochemical Sensors for Joint Bio-Sample Manipulation and Sensing},
  note={Section: Biochemical Sensors for Life Sciences and Agriculture},
  abstract={Lab-on-CMOS platforms require joint sensing-manipulation capabilities for biosamples from single cells to organoids. Existing methods such as DEP, optical, and acoustic tweezers need external setups, continuous power, and face limitations in physiological media. We present a CMOS-integrated shape-memory multi-size micro-cage array with multi-material electrochemical potentiostats, enabling power-free immobilization and multiplexed sensing, advancing multiscale biosample culture and monitoring.},
  keywords={Multiplexing;Biomedical optical imaging;Organoids;Media;Solid state circuits;Optical sensors;Biosensors;Monitoring;Faces;Sensor arrays},
  doi={10.1109/ISSCC49663.2026.11409324},
}

@INPROCEEDINGS{11409026,
  author={Nitto, Daiki and Yanase, Keishi and Fujisawa, Yui and Shiomi, Jun and Midoh, Yoshihiro and Wadatsumi, Takuya and Nagata, Makoto and Oncu, Ahmet and Sideris, Constantine and Suriyasak, Chetphilin and Ishibashi, Yushi and Miura, Noriyuki},
  title={29.5 A Sub-Gram Individual Plant Stress Sensor Tag for Smart Farming},
  note={Section: Biochemical Sensors for Life Sciences and Agriculture},
  abstract={This paper presents a 0.62 g light-weight battery-less sensor tag for continuous monitoring of plant stress. A wireless link at 920 MHz powers the tag for in-vivo measuring pH in the plant as a key stress indicator. The pH data are backscattered to the link through an XOR- based multiplexer, enabling a single miniature antenna to establish simultaneous power and data link over 80 cm distance. More than 30 -days in-vivo plant stress monitoring was successfully demonstrated for future smart farming.},
  keywords={Smart agriculture;Wireless communication;Multiplexing;Antenna measurements;Wireless sensor networks;Solid state circuits;Stress;Monitoring;Antennas;Stress measurement},
  doi={10.1109/ISSCC49663.2026.11409026},
}

@INPROCEEDINGS{11409129,
  author={Cheng, Ting-Yu and Mukkamala, Raj S. and Alcalde, Reinaldo E. and Panahandeh, Mohamadamin and Agarwal, Akshit and Kornfield, Julia A. and Newman, Dianne K. and Emami, Azita},
  title={29.6 A 65nm CMOS Hydrogel-Based Dual Fluorescence Sensor for Bioavailable Phosphorus Detection},
  note={Section: Biochemical Sensors for Life Sciences and Agriculture},
  abstract={A hydrogel-based single-culture dual-fluorescence sensor is presented for bioavailable phosphorus (P) detection. The sensor achieves 6.6fA sensitivity with a 15.5 dB SNR and an output noise of 1.97 mV at 182 ms integration time. A large dynamic range is enabled through high-precision automatic background calibration with a coarse and fine control loop. The sensor was validated using hydrogels embedded with a bioreporter strain and successfully detected both P limitation and cell viability.},
  keywords={Sensitivity;Hydrogels;Fluorescence;Dynamic range;Phosphorus;Solid state circuits;Calibration;Strain;Signal to noise ratio},
  doi={10.1109/ISSCC49663.2026.11409129},
}

@INPROCEEDINGS{11409034,
  author={Wang, Xing and Du, Yucheng and Jiao, Tianhui and Wu, Defa and Chen, Xi and Tang, Miaoyu and Yang, Yi and Liu, Zhichao and Guo, An and Fu, Gaoming and Li, Peng and Dong, Jun and Liu, Bo and Liu, Xinning and Shan, Weiwei and Cai, Hao and Sun, Guangyu and Tong, Lin and Yang, Jun and Si, Xin},
  title={30.1 A 28nm 127.54TFLOPS/W MXFP6 and 117.42TFLOPS/W MXFP8 Compute-in-Memory Macro with Adaptive-Preserved-Bit-Width and Serial-Dual-Bit-Sliding Schemes},
  note={Section: Compute-in-Memory},
  abstract={Conventional FP-CIMs suffer from fixed preserved bit-width (PBW), limiting their adaptability and efficiency. This work proposes the first MXFP-CIM macro enabling wide-range adaptive PBW, featuring: (1) A serial dual-bit-sliding scheme; (2) A harmless data mapping scheme with a hierarchical hidden-bit decoder; (3) An adjustable-PBW MXFP-MAC circuit via twin-stage allocation. The 28nm MXFP-CIM macro achieves a peak energy efficiency of 127.54TFLOPS/W in the MXFP6/6 mode.},
  keywords={Limiting;In-memory computing;Energy efficiency;Solid state circuits;Decoding;Resource management},
  doi={10.1109/ISSCC49663.2026.11409034},
}

@INPROCEEDINGS{11409272,
  author={Shen, Junzhe and Zhou, Zhidao and Zha, Wenfeng and Li, Zhi and Li, Weizeng and Wang, Bohan and Zhu, Junyu and Gao, Hanghang and Han, Zhongze and Wang, Yiman and Wang, Linfang and Hu, Hongyang and Luo, Qing and Dou, Chunmeng and Liu, Ming},
  title={A 12nm 4Mb 104.56-to-137.75TFLOPS/W Charge-Trap Transistor-Based Computing-in-Memory Macro Using Analog-Predict-Digital-Compute for AI Edge Devices},
  note={Section: Compute-in-Memory},
  abstract={Previous non-volatile CIM (nvCIM) macros suffer from low storage density, unnecessary multiply-and-accumulate (MAC) operations, and large hardware cost for floating point computations. A 4Mb CTT nvCIM macro, fabricated in 12nm CMOS, supports INT/FP4 MAC operations with the analog-predict-digital-compute scheme for power saving, achieving an energy-efficiency of 137.75TFLOPS/W and >40 times improved density FoM (storage density×computing density).},
  keywords={Costs;In-memory computing;Hardware;Energy efficiency;Common Information Model (computing);Solid state circuits;Artificial intelligence},
  doi={10.1109/ISSCC49663.2026.11409272},
}

@INPROCEEDINGS{11409297,
  author={Hsu, Hung-Hsi and Khwa, Win-San and Yeh, Yao-Kai and Wu, Chih-Ling and Chen, Chang-Yuan and Huang, Yen-Che and Lin, Yen-Hua and Chang, Cheng-Feng and Shao, Yen-Tung and Tien, Jen-Chun and You, De-Qi and Wu, Ping-Sheng and Zhang, Bo and Liu, Ren-Shuo and Hsieh, Chih-Cheng and Tang, Kea-Tiong and Chang, Meng-Fan},
  title={A 22nm 96Mb 50.6-to-90.2TFLOPS/W Non-Linear MLC ReRAM CIM Macro with High-Retention for Mamba/Transformer/CNN},
  note={Section: Compute-in-Memory},
  abstract={We present a DTCO-designed high-retention multi-mode ReRAM nvCIM macro supporting linear MLC (L-MLC), non-linear MLC (NL-MLC), and SLC modes for Mamba, Transformer, and CNN workloads, addressing key challenges in inference accuracy, energy, and readout robustness. The proposed macro incorporates: 1) a reconfigurable compute mode for accuracy/efficiency tradeoff, 2) ISE-HF encoding to enhance input sparsity and save energy, 3) an S2R-Db ADC that enables high-yield, low-power NL-MLC readout. The design achieves 50.6-to-90.2TFLOPS/W (BF16) with ImageNet accuracy loss that is 79.17% lower than L-MLC after 10 years of retention.},
  keywords={Accuracy;Transformers;Robustness;Encoding;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409297},
}

@INPROCEEDINGS{11409281,
  author={Feng, Lichen and Liu, Yunlong and Wu, Lin and Li, Dong and Zhu, Zhangming},
  title={30.4 A 28nm 106.85TOPS/W and 77.68TFLOPS/W CIM Macro with Stage-Wise-Enabled Lossless Compressors Based on Sign-Bit-Embedded Transition-Counting-Lines for Edge-AI Devices},
  note={Section: Compute-in-Memory},
  abstract={This paper proposes a bit-parallel digital CIM macro featuring a lossless compressor based on transition-counting-lines (TCLs) for bit-column addition. The bus TCL incorporates signbit extension to support signed 2's-complement MAC operations with minimal area overhead. A stage-wise enabling circuit prevents unnecessary toggling of adders, improving energy efficiency by 42%. Leveraging these techniques, the proposed CIM macro, which is fabricated in 28nm CMOS, achieves 106.85TOPS/W for INT8 operations and 77.68TFLOPS/W for BF16 operations.},
  keywords={CMOS technology;Energy efficiency;Solid state circuits;Adders},
  doi={10.1109/ISSCC49663.2026.11409281},
}

@INPROCEEDINGS{11409052,
  author={Tien, Jen-Chun and Khwa, Win-San and Hsieh, Le-Jung and Lou, Tsung-Han and Bai, Jyun-Cheng and Kao, Yu-Sheng and Hsu, Ting-Hao and Tseng, Mai and Hsu, Hung-Hsi and Yeh, Yao-Kai and You, De-Qi and Lele, Ashwin Sanjay and Crafton, Brian and Zhang, Bo and Wu, Ping-Sheng and Yang, Ya-Tang and Lo, Chung-Chuan and Liu, Ren-Shuo and Hsieh, Chih-Cheng and Tang, Kea-Tiong and Chang, Meng-Fan},
  title={30.5 A 16nm 72kb 120.5TFLOPS/W Versatile-Format Dual-Representation Gain-Cell CIM Macro for General Purpose AI Tasks},
  note={Section: Compute-in-Memory},
  abstract={Diverse AI workloads require flexible data representations and numerical formats. In this work, we present a reconfigurable 2's-complement and sign-magnitude scheme integrated within a versatile-format CIM macro supporting MX, LNS, FP, and INT for MAC operations. Implemented in a 16 nm 72 kb gain-cell array, the macro achieves record energy efficiency (120.5TFLOPS/W) and throughput density $(3.18 \text{TOPS} / \text{mm} 2)$ in MXINT8 mode.},
  keywords={Data visualization;Throughput;Energy efficiency;Solid state circuits;Arrays;Artificial intelligence},
  doi={10.1109/ISSCC49663.2026.11409052},
}

@INPROCEEDINGS{11409218,
  author={Li, Weizeng and Wang, Bohan and Zhou, Zhidao and Zhu, Junyu and Li, Zhi and Shen, Junzhe and Zha, Wenfeng and Han, Zhongze and Wang, Yiman and Wang, Linfang and Hu, Hongyang and Luo, Qing and Dou, Chunmeng and Liu, Ming},
  title={30.6 A 16Mb 166.8TOPS/W Near-Memory Phase-Domain-Computing Ferroelectric NAND Flash for Approximate Nearest Neighbor Search on Edge Devices},
  note={Section: Compute-in-Memory},
  abstract={Previous near-memory computing (NMC) or in-memory-computing (IMC) NANDs suffers from limited IO width, large energy-delay-product, and an inability to support diverse vector formats. This work presents a fabricated 16Mb near-memory phase-domain-computing (NM-PDC) FeNAND chip can compute the 512 similarity distances between 256-dimensional 4b vectors in a single search operation, achieving 166.8TOPS/W energy efficiency and a $12.8 \times$ reduction in end-to-end search latency.},
  keywords={Nearest neighbor methods;Vectors;Energy efficiency;Solid state circuits;Flash memories},
  doi={10.1109/ISSCC49663.2026.11409218},
}

@INPROCEEDINGS{11409184,
  author={Cao, Yue and Jiang, Jinghao and Jiang, Haijun and Zhang, Qian and Liu, Xuanzhi and Cheng, Jinhui and Han, Zhongze and Jiang, Xiping and Zuo, Fengguo and Wang, Song and Bai, Fujun and Guo, Yixin and Dou, Chunmeng and Yang, Jianguo and Lv, Hangbing and Liu, Qi and Liu, Ming},
  title={A 1.2GHz 12.77GB/s/mm2 3D Two-DRAM-One-Logic Process-Near-Memory Chip for Edge LLM Applications},
  note={Section: Compute-in-Memory},
  abstract={A high-bandwidth-density $(12.77 \text{GB} / \mathrm{s} / \text{mm}^{2})$ high-memory-density $(99.4 \text{Mb} / \text{mm}^{2})$ low-energy-consumption $(0.67 \text{pJ} / \mathrm{b})$ 3D PNM design that operates at 1.2 GHz is presented. The design adopts a two-DRAM-one-logic architecture that enables near-DRAM computing through a high-density 3D integration path, reducing memory-access latency by up to 93% and GEMM execution time by up to 98%, demonstrating strong potential for edge-LLM workloads.},
  keywords={Three-dimensional displays;Computer architecture;Solid state circuits;Three-dimensional integrated circuits},
  doi={10.1109/ISSCC49663.2026.11409184},
}

@INPROCEEDINGS{11409250,
  author={Yeh, Yao-Kai and Su, Jian-Wei and Hsu, Ting-Hao and Tseng, Mai and Tien, Jen-Chun and Chen, Ko-Chi and Yue, Chih-Yen and Lin, Yu-En and Hu, Yu-Jia and Hsieh, Le-Jung and Bai, Jyun-Cheng and Kao, Yu-Sheng and Lou, Tsung-Han and Hsu, Hung-Hsi and You, De-Qi and Shyh-Shyuan, Sheu and Lo, Wei-Chung and Chang, Shih-Chieh and Yang, Ya-Tang and Lo, Chung-Chuan and Liu, Ren-Shuo and Hsieh, Chih-Cheng and Tang, Kea-Tiong and Chang, Meng-Fan},
  title={A 16nm, 1Mb, 1-to-8b-Configurable 444.21TOPS/W Fully Digital SRAM Compute-in-Memory Macro for Hybrid SNN-CNN Edge Computing},
  note={Section: Compute-in-Memory},
  abstract={We present a silicon-verified fully digital SRAM-CIM macro that supports multi-bit hybrid SNN-CNN processing. Key innovations include: (1) a compact CFD-SC-RC architecture that shares SNN-CNN MAC hardware to minimize area and energy overhead while enabling adaptive model and precision selection; and (2) a PS-WR-ODM scheme that balances partial-sum storage and weight-update energy. Fabricated in 16nm FinFET CMOS, the test chip achieves 444.21TOPS/W (1 bIN-8bW-14bOUT, SNN) and 62.84TOPS/W(8bIN-8bW-22bOUT, CNN).},
  keywords={Semiconductor device modeling;Technological innovation;Random access memory;Computer architecture;In-memory computing;FinFETs;Hardware;Solid state circuits;Energy storage;Edge computing},
  doi={10.1109/ISSCC49663.2026.11409250},
}

@INPROCEEDINGS{11409207,
  author={Agarwal, Amit and Hsu, Steven K. and Anders, Mark A. and Raha, Arnab and Mathaikutty, Deepak A. and Krishnamurthy, Ram},
  title={30.9 A 147TOPS/W, 250TOPS/mm2, Fully Synthesizable, Digital Compute-in-Memory Accelerator Supporting INT8×INT8 with Zero-Point Quantization in Intel 18A Technology},
  note={Section: Compute-in-Memory},
  abstract={A fully synthesizable DCiM on-die accelerator with 128 input channels, 32 output channels, and 2 weight sets, supporting zero-point-quantized INT8×INT8 computation, is fabricated in Intel 18A technology and occupies $0.0856 \text{mm}^{2}$. The DCiM accelerator operates at 2.62 GHz for a supply voltage of 1.1 V, and 25 °C, achieving a peak area-efficiency of $250 \text{TOPS} / \text{mm}^{2}$. Robust operation of DCiM is maintained down to $400 \text{mV}, 25^{\circ} \mathrm{C}$, where it delivers a peak energy-efficiency of 147TOPS/W at 25% input activity, with a power consumption of 6.1 mW.},
  keywords={Quantization (signal);Power demand;Voltage;In-memory computing;Energy efficiency;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409207},
}

@INPROCEEDINGS{11409211,
  author={Dong, Pingcheng and Tan, Yonghao and Liu, Xuejiao and Luo, Peng and Liu, Yu and Pang, Di and Ma, Songchen and Huang, Xijie and Liu, Shih-Yang and Zhang, Dong and Lu, Zhichao and Liang, Luhong and Tsui, Chi-Ying and Tu, Fengbin and Zhao, Liang and Cheng, Kwang-Ting},
  title={31.1 A 14.08-to-135.69Token/s ReRAM-on-Logic Stacked Outlier-Free Large-Language-Model Accelerator with Block-Clustered Weight-Compression and Adaptive Parallel-Speculative-Decoding},
  note={Section: AI Accelerators},
  abstract={This work presents a 55nm speculative decoding-based LLM accelerator with bumpingbased face-to-face ReRAM-on-logic stacking technology. It features a local rotation unit for outlier-free low-bit quantization, a stacking-aware PNM architecture co-designed with blockwise vector quantization to reduce weight EMA overheads, and an adaptive parallel speculative decoding scheme with out-of-order scheduler for high resource and bandwidth utilization. Our chip achieves 14.08-to-135.69token/s and 4.46-to-7.17× speedup over vanilla speculative decoding.},
  keywords={Out of order;Vector quantization;Stacking;Bandwidth;Decoding;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409211},
}

@INPROCEEDINGS{11409015,
  author={Kim, Sangjin and Oh, Jungjun and Kim, Byeongcheol and Choi, Yuseon and Park, Gwangtae and Yoo, Hoi-Jun},
  title={31.2 Revolver: Low-Bit GenAI Accelerator for Distilled-Model and CoT with Phase-Aware-Quantization and Rotation-Based Integer-Scaled Group Quantization},
  note={Section: AI Accelerators},
  abstract={Revolver is a low-bit GenAI accelerator that enables reasoning and multi-turn chat on edge devices under tight memory and power budgets. It introduces Phase-Aware Precision Selection (PAPS) with Multi-Precision Residual Encoding (MPRE) for memory-efficient multi-phase execution, Local Rotation with Harmonic-Aligned Permutation (LR-HAP) for low-cost rotation, and a Sliced Integer-based Dequantization Unit (SIDU) for efficient dequantization, achieving $3.99 \times$ energy savings and $2.10 \times$ speedup.},
  keywords={Quantization (signal);Energy conservation;Encoding;Cognition;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409015},
}

@INPROCEEDINGS{11409212,
  author={Liu, Bo and Zou, Zihan and Yan, Xinming and Kang, Xilong and Chen, Xinyang and Hu, Bo and Lin, Jiaming and Du, Haoran and Yang, Jun and Si, Xin and Cai, Hao},
  title={A 51.6μJ/Token Subspace-Rotation-Based Dual-Quantized Large-language-Model Accelerator with Fused Scale-Activation INT Datapath and Rearranged Bit-Slice LUT Computation},
  note={Section: AI Accelerators},
  abstract={A $51.6\mu \mathrm{J}/\text{token}$ accelerator for rotation-based dual-quantized LLMs is presented. A subspace-rotation method with parallel Hadamard transposer reduces on-chip rotation power by 62.3% and area by 59.7%. A fused scale-activation unit lowers energy by 61.5% vs. the naive FP design. Rearranged bit-slice LUT computation achieves $2. 28\times$ better energy efficiency compared to a direct bit-parallel MAC implementation, while supporting flexible bit-width. The chip reduces per-token energy by 32.6% over SOTA under an equal accuracy constraint.},
  keywords={Accuracy;Energy efficiency;Table lookup;System-on-chip;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409212},
}

@INPROCEEDINGS{11409066,
  author={Zhou, Jiaqi and Li, Hongou and Jiang, Keyao and Sun, Yiyang and Jia, Tianyu},
  title={31.4 VARSA: A Visual Autoregressive Generation Accelerator Using Performance-Scalable Multi-Precision PE-LUT and Grid-Similarity Attention Compression},
  note={Section: AI Accelerators},
  abstract={This paper presents VARSA, a 22 nm visual autoregressive accelerator for efficient text-to-image generation, featuring: 1) a performance-scalable hybrid PE-LUT core; 2) multi-precision parallel processing with runtime precision management; 3) attention map compression leveraging inter-grid similarity. The innovations enable VARSA to achieve $503 ~\text{mJ} /$ inference for $512 \times 512$ image generation, which is 2.7- to- $8.9 \times$ better than prior diffusion-based SOTA accelerators.},
  keywords={Visualization;Technological innovation;Image coding;Runtime;Image synthesis;Text to image;Parallel processing;Hybrid power systems;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409066},
}

@INPROCEEDINGS{11409048,
  author={Hong, Seongyon and Choi, Jiwon and So, Jeonggyu and Lee, Nayeong and Jo, Wooyoung and Kalzhan, Zhamaliddin and Chin, Woojin and Yoo, Hoi-Jun},
  title={31.5 SoulMate: A 9.8mW Mobile Intelligence System-on-Chip with Mixed-Rank Architecture for On-Device LLM Personalization},
  note={Section: AI Accelerators},
  abstract={This work presents SoulMate, a fully on-device mobile intelligence system-on-chip, integrating retrieval-augmented generation (RAG) and fine tuning of a personal LLM. SoulMate is fabricated in 28nm CMOS with a novel mixed-rank token processing and similarity-aware sequence processing architecture. It demonstrates real-time user interaction consumining only 9.8-to-180.5mW power, and state-of-the-art energy efficiency, such as $26.3 \mu \mathrm{J} /$ token for inference and $56.8 \mu \mathrm{J} /$ token for fine-tuning.},
  keywords={Retrieval augmented generation;Real-time systems;Energy efficiency;System-on-chip;Solid state circuits;Tuning},
  doi={10.1109/ISSCC49663.2026.11409048},
}

@INPROCEEDINGS{11408987,
  author={Yoo, Seungjae and Kim, Hangyeol and Son, Muyoung and Chen, Yi and Jeong, Suheon and Kim, Joo-Young},
  title={Tri-Oracle: A 17.78μJ/Token Vision-Language Model Accelerator with Token-Attention-Weight Redundancy Prediction},
  note={Section: AI Accelerators},
  abstract={This paper presents Tri-Oracle, a VLM accelerator exploiting token, attention, and weight redundancies. A Token Merging Unit (TMU) merges 68% of redundant tokens. An Attention Head Prediction Unit (AHPU) predicts streaming heads and skips them, reducing attention latency by 44% and balancing load. A Strip-wise SNZV Computation Unit (SSCU) predicts near-zero values, cutting FFN latency by 45% and EMA by 57%. Fabricated in 28 nm CMOS, Tri-Oracle achieves $17.78 \mu \mathrm{J} /$ token and 1.19 to $3.99 \text{TOPS} / \text{mm}^{2}$ without fine tuning.},
  keywords={Semiconductor device modeling;Solid modeling;Computational modeling;Redundancy;Merging;Predictive models;Solid state circuits;Integrated circuit modeling;Tuning;Load modeling},
  doi={10.1109/ISSCC49663.2026.11408987},
}

@INPROCEEDINGS{11409105,
  author={Yoo, Sunwoo and Kam, Dongyun and Park, Gunho and Kwon, Soonhyun and Lee, Dongsoo and Lee, Youngjoo},
  title={31.7 LUT-SSM: A 99.3TFLOPS/W LUT-Based State-Space Model Accelerator Using Energy-Efficient Element-Wise Layer Fusion and LUT-Friendly Weight-Only Quantization},
  note={Section: AI Accelerators},
  abstract={State-space models (SSMs) and weight-only quantization alleviate huge external memory access with a minimal accuracy degradation. To support both efficiently, we propose LUTSSM, a LUT-based SSM accelerator with a many-to-many LUT-ACC and an element-wise (EW) layer fusion. LUT-SSM efficiently supports INT-FP GEMM and sequential EW operations in the SSM blocks. Fabricated in 28nm FD-SOI, LUT-SSM achieves 99.3TFLOPS/W peak efficiency and 96.1TFLOPS/W on Mamba 1.4B, improving energy efficiency by $1.28 \times$ over recent designs.},
  keywords={Degradation;Quantization (signal);Accuracy;Energy efficiency;State-space methods;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409105},
}

@INPROCEEDINGS{11408953,
  author={Wang, Yang and Wang, Huanyu and Yang, Jiaxin and Su, Yutong and Guo, Ruiqi and Yue, Zhiheng and Gu, Jiangyuan and Wei, Shaojun and Hu, Yang and Yin, Shouyi},
  title={A 28nm Speculative-Decoding LLM Processor Achieving 105-to-685µs/Token Latency for Billion-Parameter Models},
  note={Section: AI Accelerators},
  abstract={LLMs face decoding bottlenecks. Speculative Decoding (SD) reduces latency via a small draft model for serial decoding and a large target model to verify in parallel. Despite this advantage, it still suffers from exponent redundancy, inefficient weights/KV, and hardware underutilization. We propose an SD LLM processor with three innovations: an exponent dual-reuse MAC, draft back-propagation target mixed-precision dataflow, and draft early start parallel compute, achieving $10.29 \times$ speed increase.},
  keywords={Technological innovation;Solid modeling;Computational modeling;Redundancy;Hardware;Decoding;Solid state circuits;Integrated circuit modeling;Faces},
  doi={10.1109/ISSCC49663.2026.11408953},
}

@INPROCEEDINGS{11409322,
  author={Keller, Ben and Venkatesan, Rangharajan and Dai, Steve and Clemons, Jason and Fojtik, Matthew and Chang, Muya and Tambe, Thierry and Pinckney, Nathaniel and Tell, Stephen G. and Huang, Qijing and De Mello, Shalini and Khailany, Brucek},
  title={31.9 Alpha-Vision: A Real-Time Always-on Vision Processor with 787µs Face Detection Latency in <5mW},
  note={Section: AI Accelerators},
  abstract={ALPhA-Vision is an always-on low-power subsystem for DNN-inference-based vision tasks in edge SoCs. Flexible and programmable, the subsystem supports CNN and ViT inference and employs hardware/software co-design to enable fully end-to-end execution with no external memory accesses. Fine-grained power management features to mitigate leakage enable the subsystem to perform face detection with 787µs latency and 99.3% detection accuracy with 4.6 mW average power at 60fps.},
  keywords={Accuracy;Power system management;Image edge detection;Feature extraction;Real-time systems;Solid state circuits;Face detection},
  doi={10.1109/ISSCC49663.2026.11409322},
}

@INPROCEEDINGS{11409150,
  author={Xing, Chaoyang and Cui, Yilu and Pan, Sining and Zhong, Yi and Sun, Nan and Jie, Lu},
  title={A 98.5dB-SNDR 250kHz-BW 1V-Supply Continuous-Time Zoom ADC with Smart-Tracking and Floating-Tail-Resistor Linearized Gm-C Loop Filter},
  note={Section: Low-Power Noise-Shaping ADCs},
  abstract={This paper presents a 98.5 dB SNDR, 250 kHz bandwidth CT incremental Zoom ADC. The design features a chopped capacitive front-end, Gm-C residue integrator, and 10b SAR ADC. A smart-tracking (ST) technique with dynamic step-sizing extends the input tracking bandwidth to the Nyquist frequency. A floating-tail-resistor (FTR) linearized Gm-C integrator achieves high linearity and efficiency. Fabricated in 28nm CMOS, the ADC consumes $400 \mu \mathrm{W}$ and achieves a superior 186.5 dB FoMs.},
  keywords={Linearity;Bandwidth;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409150},
}

@INPROCEEDINGS{11408998,
  author={Kaneko, Tohru and Ishida, Hideaki and Yamaki, Yuzuru and Takehara, Satoshi and Moon, Un-Ku},
  title={32.2 A PVT-Robust Frequency-Scalable Fully Dynamic ΔΣ ADC with Bottom-Plate Level Shift},
  note={Section: Low-Power Noise-Shaping ADCs},
  abstract={A fully dynamic calibration-free $\Delta \Sigma$ ADC using capacitive-degeneration integrators with bottom-plate level shift (BPLS) is presented. BPLS samples negative charge to reduce threshold-voltage dependence, improve settling, and cancel kT/C noise, enabling 0.5pF sampling capacitance. The ADC achieves 91.7dB peak SNDR and 95.6dB DR with $10.1 \mu \mathrm{W}$ at 10kHz bandwidth (BW). Up to 40kHz BW, the worst-case DR degradation is $\leq 2 \text{dB}$ under $\pm 10 \% \mathrm{V}_{\text{DD}}$ or −40 to 100°C. $\text{FoM}_{\mathrm{S}, \text{DR}}$ is 185.6 dB (10 kHz BW) and $>184 \text{dB}$ (1-to-40kHz BW).},
  keywords={Degradation;Power line communications;Noise;Bandwidth;Capacitance;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11408998},
}

@INPROCEEDINGS{11409252,
  author={Wang, Zongnan and Li, Bingrui and Luo, Haoyang and Chu, Chenyuan and Yang, Jiachang and Wang, Yuan and Tang, Xiyuan},
  title={32.3 An 85.1dB-SNDR 8MS/s Incremental Pipeline ADC with Dual-Residue-Assisted Exponential Quantization},
  note={Section: Low-Power Noise-Shaping ADCs},
  abstract={This paper presents an incremental pipeline ADC with dual-residue architecture. An exponential $\Delta \Sigma$ loop is proposed to directly quantize the residue, replacing conventional interpolators that are complex and less accurate. It enables fast and high-precision backend conversion while maintaining insensitivity to inter-stage gain variations. The prototype achieves 85.1 dB SNDR, the highest among comparable dual-residue ADCs, and 8MS/s conversion speed, the fastest among comparable high-precision incremental ADCs.},
  keywords={Quantization (signal);Accuracy;Pipelines;Prototypes;Solid state circuits;Gain},
  doi={10.1109/ISSCC49663.2026.11409252},
}

@INPROCEEDINGS{11409262,
  author={Li, Zhensheng and Wang, Biao and Guo, Mingqiang and Martins, Rui P. and Sin, Sai-Weng},
  title={A 103.9dB-SFDR 83.8dB-SNDR 3MHz-BW Multi-Bit Quadratic-Exponential Noise-Coupled IDSM with High Tolerance to DAC Non-Linearity},
  note={Section: Low-Power Noise-Shaping ADCs},
  abstract={This paper presents a quadratic-exponential noise-coupled (NC) IDSM to achieve a quantization noise shaping effect greater than $4^{\text{th }}$ order with OSR 22, while having high tolerance to DAC non-linearity and a small noise penalty factor. The DAC2 and adder in NC are reused for a larger effective OSR and improve energy efficiency. Implemented in 28nm CMOS, the IDSM achieves an SNDR/SFDR of $83.8 \text{dB} / 103.9 \text{dB}$, with a 3 MHz bandwidth, and $794 \mu \mathrm{W}$, resulting in Schreier FoM $\mathrm{M}_{\text{SNDR }} / \text{FoM}_{\text{DR }}$ of $179.6 \text{dB} / 181.4 \text{dB}$.},
  keywords={Quantization (signal);Noise;Bandwidth;Energy efficiency;Solid state circuits;Noise shaping;Adders},
  doi={10.1109/ISSCC49663.2026.11409262},
}

@INPROCEEDINGS{11408990,
  author={Deng, Heqi and Shokrolahzade, Ehsan and Fakkel, Niels and Spirito, Marco and Sebastiano, Fabio and Babaie, Masoud},
  title={A 22-to-25GHz CMOS Non-Magnetic Balanced Circulator Achieving at Least 20dB TX-RX Isolation for an Antenna VSWR of 2},
  note={Section: Time-Varying Circuit Techniques from RF to mm-Wave},
  abstract={This paper presents a mm-wave non-magnetic balanced circulator that bridges the gap between the high insertion loss (IL) of electrical balance duplexers and the transmitter (TX)-to-receiver (RX) isolation degradation of conventional circulators under varying antenna (ANT) voltage standing wave ratio (VSWR). Using quadrature couplers, a balance network, and (non)-reciprocal branches, it achieves $<5.2 \text{dB}$ TX-to-ANT IL, $<4.2 \text{dB}$ RX-to-ANT IL, and $>20 \text{dB}$ TX-to-RX isolation over $\mathrm{a}>2.2 \text{GHz}$ bandwidth at VSWR $=2$.},
  keywords={Degradation;Transmitting antennas;Circulators;Voltage;Insertion loss;Couplers;Bandwidth;Propagation losses;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11408990},
}

@INPROCEEDINGS{11409051,
  author={Ghorbanpoor, Mohsen and Eleraky, Mohamed and Manetakis, Konstantinos and Nussbaum, Pascal and Wang, Hua},
  title={33.2 An Infinite-Loop CMOS-Compatible Isolator Enabled True VSWR-Resilient Power Amplifier for 6G FR3 in Massive MIMO and Phased-Array Systems},
  note={Section: Time-Varying Circuit Techniques from RF to mm-Wave},
  abstract={This work presents a balanced power amplifier (PA) featuring a time-varying output matching network designed to suppress unwanted reflections and couplings in phased array and MIMO systems. By leveraging lossy non-reciprocal phase shifters in an indirect infinite loop, the architecture minimizes transmission loss while maintaining perfect isolation. Fabricated using a 22 nm CMOS SOI process, the proposed PA achieves IP1dB variation within \pm 0.43 dB across 3:1/2:1 VSWR contours and bandwidth (BW).},
  keywords={Phased arrays;Isolators;Impedance matching;Phase shifters;Power amplifiers;Massive MIMO;Propagation losses;Reflection;Solid state circuits;Time-varying systems},
  doi={10.1109/ISSCC49663.2026.11409051},
}

@INPROCEEDINGS{11409161,
  author={Li, Yicheng and Xie, Feng and Yin, Yun and Cao, Lixuan and Yang, Tianze and Li, Jiaxiang and Xu, Hongtao},
  title={33.3 A 6GHz Quadrature Digital Transmitter Supporting a 1GHz Signal Bandwidth with <-40dB EVM Floor and >55dB Dynamic Range in 28nm CMOS},
  note={Section: Time-Varying Circuit Techniques from RF to mm-Wave},
  abstract={A 6GHz quadrature DTX supporting a 1 GHz signal bandwidth is presented in 28 nm CMOS, where static and dynamic nonlinearities are carefully optimized. Occupying a core area of $0.67 \text{mm}^{2}$ and packaged in a fanout SiP, the DTX delivers 23.1 dBm peak output power with a 30.3% peak PAE at 6.0 GHz, and the 1 dB RF bandwidth is from 5.7 to 6.5 GHz. For 1 GHz 64-QAM signals, it achieves $18.0 \text{dBm} \mathrm{P}_{\text{avg }}$ and $16.2 \% \text{PAE}_{\text{avg }}$ with −25.5 dB EVM. The dynamic power range is $>55 \text{dB}$, and its EVM floor is −40.8 dB.},
  keywords={6G mobile communication;Radio frequency;Transmitters;Bandwidth;Dynamic range;Solid state circuits;Floors;Power generation},
  doi={10.1109/ISSCC49663.2026.11409161},
}

@INPROCEEDINGS{11409165,
  author={Yang, Bingzheng and Zhou, Jie and Mao, Junfa and Luo, Xun},
  title={33.4 A 4.5-to-7.2GHz Beyond Rail-to-Rail Output SCPA with 27.9dBm Pout and 46.2% DE at 5.1GHz Using Periodic Voltage-Pacing Network},
  note={Section: Time-Varying Circuit Techniques from RF to mm-Wave},
  abstract={This work presents a switched-capacitor power amplifier (SCPA) using periodic voltagepacing network, capable of generating output voltage beyond conventional rail-to-rail limit, which enhances both the output power (Pout) and efficiency. Fabricated in a 40 nm CMOS process, it shows a competitive 27.92 dBm peak Pout and 46.2% peak drain efficiency covering a wide 1 dB bandwidth from 4.5 to 7.2 GHz. Furthermore, it supports 200 MHz 64QAM and 80 MHz 256 QAM, confirming its suitability for 5 G/6 G and WiFi systems.},
  keywords={Quadrature amplitude modulation;Power amplifiers;Voltage;Switches;Bandwidth;CMOS process;Solid state circuits;Wireless fidelity;Rail to rail amplifiers;Power generation},
  doi={10.1109/ISSCC49663.2026.11409165},
}

@INPROCEEDINGS{11409343,
  author={Liang, Xiqing and Yang, Bingzheng and Tang, Hongxin and Luo, Xun},
  title={A 0.6-to-0.9GHz, 28.06dBm Pout, 43.73% SE, 6-Phase Switched-Capacitor Power Amplifier Using In-Cell Digital Waveform Synthesis for the 2nd-, 3rd-, and 4th-Harmonic Suppression},
  note={Section: Time-Varying Circuit Techniques from RF to mm-Wave},
  abstract={This work presents a 6-phase 0.6-to-0.9GHz switched-capacitor power amplifier with a peak output power of 28.06 dBm and a peak system efficiency of 43.73%, using digital waveform synthesis for harmonic suppression. A reused differential-switch topology is utilized to generate multi-level stepped waveform with intrinsically canceled 2nd, 3rd, and 4th harmonics. Such an SCPA achieves 38.7/52.8/39.5dBc suppression level of the 2nd/3rd/4th harmonics at 850 MHz and supports $40 \text{MHz} 64-\text{QAM}$ and $20 \text{MHz} 256-\text{QAM}$ signals.},
  keywords={Harmonics suppression;Power amplifiers;Switches;Harmonic analysis;Topology;Solid state circuits;Power generation;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409343},
}

@INPROCEEDINGS{11409224,
  author={Bhat, Mohmad Aasif and Mondal, Imon},
  title={33.6 A Frequency-Translated, 1-to-5GHz Centred, All-Passive, Programmable-Bandwidth, Switched-Capacitor Delay Line with 6.5-to-8.2dB Delay-Independent Insertion Loss in 65nm CMOS},
  note={Section: Time-Varying Circuit Techniques from RF to mm-Wave},
  abstract={We propose an all-passive, programmable-bandwidth, frequency-translated switched- NF<11 dB, and P1 dB > +5.5dBm. In a narrow-bandwidth mode the DL has the OOB-IIP3 of capacitor delay line (DL) with a 6.5-to-8.2dB delay-independent insertion loss in 65nm +28dBm. The DL consumes an average power between 12 and 33mW across all bandwidth CMOS. The DL offers tunable bandwidth (0.2 to 1 GHz) and tunable centre frequency (1 to settings. 5GHz) while supporting ns delay range. The results demonstrate a $\text{delay-range} \times$ BW of 3,},
  keywords={Capacitors;Insertion loss;Bandwidth;Switches;Delay lines;Solid state circuits;Delays;Noise measurement;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409224},
}

@INPROCEEDINGS{11409249,
  author={Lou, Liheng and Zhou, Zeyu and Yuan, Luyao and Long, Yucheng and Chen, Gong and Li, Xiaoyu and Yang, Shaoqi and Cui, Han and Peng, Ji and Tao, Weichen and Deng, Juncheng and Hu, Yizhe},
  title={34.1 A 128mW 2×4 Radar-on-Chip with Forward-ΔΣ DPLL-Locked Multi-Injection RTWO in 22nm CMOS Enabling ADC-Free Digitization and PS-Free Beamforming Demonstrated in In-Cabin Vital-Sign Monitoring},
  note={Section: Integrated Radar and UWB Transceivers from Microwave to Sub-THz},
  abstract={A 2×4 phased-array SIL radar-on-chip in 22 nm CMOS is demonstrated for in-cabin vital-sign monitoring. Built on a forward-ΔΣ DPLL-locked multi-injection RTWO at 20 GHz, it concurrently serves as (de)modulator, beamformer, and data converter. The chip delivers 0dBm CW/PMCW for respiration cancellation, boosting SFDR by 9dB for cardiac extraction. RTWO-based beamforming covers ± 48° FoV in ~ 15° AoA step. The 1.42 mm2 chip consumes 128 mW and achieves RR/HR errors <± 6bpm with 1.2mW DSP on-chip.},
  keywords={Array signal processing;Digitization;Boosting;System-on-chip;Solid state circuits;Monitoring},
  doi={10.1109/ISSCC49663.2026.11409249},
}

@INPROCEEDINGS{11409071,
  author={Moon, Byeong-Taek and Li, Mingyuan and Suh, Junseuk and Lee, Minseob and Kim, Doyoon and Kim, Kyunghwan and Park, Geonho and Baek, Goeun and Yook, Byungho and Choi, Dooseok and Yoo, Kyungwoo and Kim, Junseong and Yu, Taewoo and Kang, Seonghyeon and Jo, Hyeonsu and Son, Juhee and Lee, Sangsung and Lau, Pak-Kim and Lu, Siuchuang Ivan and Rogers, Gregory Eric and Jain, Ajaypat and Wang, Jian and Ariyarathna, Viduneth and Kim, Wan Jong and Eliezer, Oren and Feygin, Gennady and Zhou, Wen and Moon, Kyoung-Jun and Chung, Jaehyun and Lee, Woncheol and Kim, Seongjung and Kim, Jonghyun and Lee, Joonggeun and Kim, Taeyeon and Kim, Sungjoo and Lee, Youngki and Jang, Yonghwan Harold and Rayudu, Sai Krishna and Chien, Shihchieh and Chen, Ying and Lim, Hyungsun and Kang, Kidong and Lee, Sungjun and Lee, Joonhee and Bae, Jeongyeol and Seok, Hyun-Gi and Dayal, Pranav and Wu, Wanghua and Park, Hyun-Chul and Hur, Joonhoi and Yoo, Sangmin and Park, Chan-Hong and Kim, Joonsuk},
  title={34.2 Compact, Low-Power 60-and-77GHz 4T/4R Multi-Mode FMCW Radar RFICs in 28nm CMOS},
  note={Section: Integrated Radar and UWB Transceivers from Microwave to Sub-THz},
  abstract={This paper presents 60-and-77GHz FMCW radar RFICs with 4T/4R MIMO and cascading capability in 28nm CMOS. The RFICs demonstrate excellent RF/analog/digital performance, including $>14.8 \text{dBm}$ TX $P_{\text{SAT }}$, 7-bit phase resolution, and $>36 \text{MHz}$ RX IF BW, with a compact $4.5 \times 4.5 \text{mm}^{2}$ chip size and $<2.1 \mathrm{W}$ power consumption. The RFICs support multiple radar modes and are validated through OTA tests, demonstrating their suitability for various radar applications.},
  keywords={Power demand;Radiofrequency integrated circuits;Radar applications;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409071},
}

@INPROCEEDINGS{11408966,
  author={Chen, Xibi and Dogiamis, Georgios C. and Han, Ruonan},
  title={A 234-to-252GHz Dual-Polarized Transceiver Using Antenna-in-Package Technologies for Cross-Polarimetric Sensing},
  note={Section: Integrated Radar and UWB Transceivers from Microwave to Sub-THz},
  abstract={We present a 234 -to-252GHz dual-polarized monostatic CMOS (Intel16) transceiver for cross-polarimetric sensing, with antenna-in-package (AiP) technology and a $10 \times 10 \text{mm}^{2}$ modular system assembly. The AiP achieves 69% peak radiation efficiency estimated from measurements, which demonstrates the feasibility of $>200 \text{GHz}$ passive antenna/interconnects implemented in low-cost standard organic packages for enhanced performance and silicon area-saving, as opposed to the traditional all-on-chip scheme.},
  keywords={Antenna measurements;Area measurement;Antenna-in-package;CMOS technology;Transceivers;Silicon;Sensors;Solid state circuits;Standards;Assembly},
  doi={10.1109/ISSCC49663.2026.11408966},
}

@INPROCEEDINGS{11408988,
  author={Fu, Renjie and Shi, Linxu and Cai, Fanxun and Yang, Yunqi and Lei, Hao and Fu, Zhigang and Xu, Yilin and Wang, Pengcheng and Li, Ziyang and Wang, Shixuan and Jiao, Junkai and Liang, Dingqi and Wu, Lianbo and Zhang, Guangzhong and Du, Naike and Wang, Zijie and Gu, Yucong and Ye, Xiuzhu and Fang, Xiao and Zhao, Weisheng and Zhang, Hui},
  title={A 1.6-to-3.8GHz Reconfigurable FMCW Radar SoC with 81.5% Relative-Bandwidth PLL for Real-Time Life Detection in Disaster Response},
  note={Section: Integrated Radar and UWB Transceivers from Microwave to Sub-THz},
  abstract={A 1.6-to-3.8GHz FMCW radar SoC for real-time non-line-of-sight life detection is implemented in 40nm CMOS. An 81.5% BW ring-VCO PLL with DTC achieves 29.6kHz frequency error and 0.78-to-400MHz/µs chirp slopes. The TX integrates a 13.43dBm PA, while the RXRF features 8.1dB NF, baseband chain with 100dB-rejection SC-HPF at 1kHz and CT Δ-∑ ADC. A RISC-V core with FPU/VPU enables DSP, detecting people behind 6 walls and vital signs behind 2, occupying 7.65mm2 and consuming 0.395W.},
  keywords={Baseband;Chirp;Disasters;Radar detection;Radar;Real-time systems;Solid state circuits;Noise measurement;Phase locked loops},
  doi={10.1109/ISSCC49663.2026.11408988},
}

@INPROCEEDINGS{11409119,
  author={Son, Jihun and Park, Minsu and Park, Chansoo and Lee, Kyoungtae and Yoon, Jong-Hyeok and Lee, Junghyup and Song, Minyoung},
  title={34.5 A 0.0523mm2 11.4mW IEEE 802.15.4a/z/ab Compatible Aliasing-Suppressing All-Digital IR-UWB Transmitter Featuring Comb-Notched Maximally Flat Amplitude Spectral Shaping},
  note={Section: Integrated Radar and UWB Transceivers from Microwave to Sub-THz},
  abstract={This work presents an IEEE 802.15.4a/z/ab compatible IR-UWB TX using an anti-phase delayed dual-Gaussian pulse with self-delay pulse comb-notch to maximize the spectrum utilization while meeting global masks. A slope-aware non-uniform interpolation suppresses sampling aliases by 11dB. A dual-level switched-capacitor PA cuts sidelobe emission up to 12dB. The TX draws 11.4mW, reaches 83.4% spectrum utilization and near-in sidelobe (≤35dBr at 489MHz) with ≥9× smaller area than prior arts.},
  keywords={IEEE 802.15 Standard;Interpolation;Art;Transmitters;Switches;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409119},
}

@INPROCEEDINGS{11409235,
  author={Abolmagd, Hany and Kuo, Shih-Kai and Hasan, Md Nazmul and Kadaveru, Sreevatsank and Nejad, Aboozar Ghorbani and Dunna, Manideep and Khorami, Ata and Yu, Yichen and Bharadia, Dinesh and Mercier, Patrick and Shekhar, Sudip},
  title={35.1 CANCEL: A Cancellation-Aided Ambient IoT Nanopowered Communication System for Energy-Limited Tags},
  note={Section: Low Power Wireless Transceivers for Localization and Communications},
  abstract={This paper presents a system that breaks the trade-off between range and power present in conventional wireless backscatter systems caused by phase noise leakage at low intermediate frequencies (IFs). By employing a self-interference cancellation chip together with a full-duplex antenna that achieves up to 125 dB of cancellation, spectral leakage can be effectively eliminated, allowing for the developed backscatter tags to operate down to 92 nW for communication at up to 32 m at 1 kb/s.},
  keywords={Wireless communication;Phase noise;Interference cancellation;Full-duplex system;Solid state circuits;Antennas;Backscatter},
  doi={10.1109/ISSCC49663.2026.11409235},
}

@INPROCEEDINGS{11409200,
  author={Shen, Yi and Young, Steve and Komma, Demba and Strohman, Ryan and Narasimha, Rahul and Chang, Jeongtaek and Bejarano-Carbo, Andrea and Wang, Yunfan and Tao, Guanren and Kim, Hun-Seok and Blaauw, David},
  title={35.2 A 20mg Battery-Free Crystal-Less Miniaturized TX System for Flying Insects Localization with 1.45km Range},
  note={Section: Low Power Wireless Transceivers for Localization and Communications},
  abstract={A complete, 20mg, battery-free, crystal-less localization tag with a 28nm TX IC, custom antenna, PV cells, and storage cap achieves 0.9m accuracy over 1.45km. Designed for tracking wasps, this system also enables unobtrusive monitoring of other small insects/objects. We deployed a tag on a live wasp and demonstrated full system functionality while the wasp was able to fly normally. The system achieves the longest range, highest long-distance accuracy, and lowest weight, with battery-free operation, among the state-of-the-art entries in the comparison table in Figure 35.2.6.},
  keywords={Location awareness;Accuracy;Insects;Solid state circuits;Monitoring;Antennas},
  doi={10.1109/ISSCC49663.2026.11409200},
}

@INPROCEEDINGS{11409278,
  author={Ayesh, Mostafa and Shuo-Wei Chen, Mike},
  title={A 0.052mm2 Blocker-Tolerant Non-Uniform Current Sub-Sampling Receiver with a Discrete-Time FIR/IIR Filter Enabling 56dB Rejection in 28nm CMOS},
  note={Section: Low Power Wireless Transceivers for Localization and Communications},
  abstract={This paper presents a $0.052 \text{mm}^{2}$ blocker-tolerant $18-\text{to}-22 \text{GHz}$ non-uniform current sub-sampling (NUCSS) receiver featuring NU DT FIR/IIR filtering and equalized Gm-cells, addressing aliasing, noise folding, and alias/non-alias band blockers. Fabricated in 28nm CMOS, this prototype achieves up to 56 dB blocker rejection, $>14 \text{dB}$ higher blocker rejection than conventional NU DT FIR RX, −29.1 dB EVM for a $64-\text{QAM} 150 \text{MS} / \mathrm{s}$ signal centered at 20 GHz, and $\mathrm{B}_{1 \text{dB}}$ of 5.8 dB while consuming 20 mW power.},
  keywords={Finite impulse response filters;Filtering;Noise;Prototypes;Receivers;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409278},
}

@INPROCEEDINGS{11409199,
  author={Yu, Rui and Liu, Supeng and Chen, Xuesong and Zhang, Tantan and Chan, Wei Khuen and Hu, Deyong and Yu, Haohong and Yao, Wang and Yeo, Theng Tee and Wu, Peilin and Zhao, Xingpeng and Guo, Zhan},
  title={35.4 A NearLink 2.0 Compliant Dual-Band RF Transceiver for Smart Wireless Personal Audio Applications},
  note={Section: Low Power Wireless Transceivers for Localization and Communications},
  abstract={This work presents a NearLink 2.0-compliant dual-band RF transceiver. Compared with traditional BT/BLE counterparts, this design achieves receiver figures of merit (FOM) of 188.7 dB in the 2.4 GHz band and 185.2 dB in the 5 GHz band, exceeding the state-of-the-art by $>4 \text{dB}$. Furthermore, it demonstrates a 30.9% 2.4GHz-transmitter-system power efficiency with exceptional EVM performance: 3.3% in $3 \text{Mb} / \mathrm{s}$ BT Enhanced Data Rate mode and 3.64% in 4M-16-QAM NearLink 2.0 mode $(16 \text{Mb} / \mathrm{s})$.},
  keywords={Radio frequency;Wireless communication;Dual band;Receivers;Transceivers;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409199},
}

@INPROCEEDINGS{11409239,
  author={Yang, Ruiyuan and Ali, Karim and Alioto, Massimo},
  title={35.5 Fully Integrated Backscattered WiFi 802.11b Transmitter with Active Harmonics and Image Rejection for 30dB IRR and 36dB HRR at ${0. 8 8} {\mu} \mathrm{W}$},
  note={Section: Low Power Wireless Transceivers for Localization and Communications},
  abstract={A sub-$\mu \mathrm{W}$ fully integrated backscattered 802.11b WiFi transmitter is introduced with active image and harmonics rejection for common dense wireless environments. Rejection is achieved via time-domain complex filters, and oversampling with sequential RF switch enablement (no digital filter). Temperature event-driven calibration adjusts the underlying pulse basis and programmable complex impedance. A 22 nm test chip shows 30 dB IRR $(12 \text{dB}$ better than prior art in Fig. 35.5.6), 36dB HRR (not shown priorly).},
  keywords={Wireless communication;Radio frequency;Transmitters;Switches;Harmonic analysis;Solid state circuits;Impedance;Time-domain analysis;Wireless fidelity;Power harmonic filters},
  doi={10.1109/ISSCC49663.2026.11409239},
}

@INPROCEEDINGS{11409060,
  author={Pandey, Aviral and Lin, I-Ting and Vaish, Dhruv and Rammohan, Ashwin and Bhat, Savit and Pinkenburg, Jade and Muller, Rikky},
  title={36.1 ReFIND: A Resolution-Reconfigurable Bio-Signal Classification SoC Enabling $>10\times$ Savings in AFE Power Per Channel},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This work presents ReFIND, an SoC integrating together 16 resolution-reconfigurable AFEs, a feature extractor, and a classifier. The VCO ADC architecture trades power for resolution by scaling the integration time, from 13 to 10 b at 1.77 to $0.12 \mu \mathrm{W} /$ channel. End-to-end validation shows up to $14 \times$ power saving over a fixed array, $3 \times$ more than channel selection. ReFIND enables runtime resolution scaling, opening up power-performance optimization in bio-signal classifiers.},
  keywords={Runtime;Voltage-controlled oscillators;Feature extraction;Solid state circuits;Optimization},
  doi={10.1109/ISSCC49663.2026.11409060},
}

@INPROCEEDINGS{11409094,
  author={Zhong, Zhiwei and Yu, He and McGarry, William and Wei, Yijie and Gu, Jie},
  title={36.2 A Neural Interface SoC for Smart Glasses with Low-Power Neural Commanding and Efficient LoRA-Enabled On-Chip Learning},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This work presents a 65 nm ExG SoC for smart glasses, enabling low-power neural interaction. A 10-ch AFE and on-chip CNN deliver real-time EOG/EMG/EEG inference. On-device continual learning via LoRA fine-tuning cuts trainable parameters by 54 to 77%. An ultra-lower-power nearest-feature neural commanding path was implemented to issue user commands and wake up heavy computation only when needed. Chunked delta encoding and a streaming pipeline reduce memory and expand training data by $2.1 \times$.},
  keywords={Continuing education;Pipelines;Memory management;Training data;Real-time systems;Encoding;System-on-chip;Solid state circuits;Smart glasses},
  doi={10.1109/ISSCC49663.2026.11409094},
}

@INPROCEEDINGS{11409275,
  author={Wang, Yang and Lin, Longyang and Yoo, Jerald and Li, Jiamin},
  title={A 16.4nJ/Class Patient-Independent Prototype-Based Spatio-Temporal CNN Processor with Forward-Inference-Based Adaptation for Robust and Low-Latency Seizure Detection},
  note={Section: Neural and Biomedical Interfaces},
  abstract={We present a patient-independent, prototype-based spatio-temporal CNN processor for seizure detection, achieving high accuracy without patient-specific data, at an energy of 16.4nJ/class and latency of <120 ms. An optional forward-inference-based zero-shot adaptation improves robustness to variability and low-quality inputs. The 40nm IC achieves 94.3%/94.9% sensitivity/specificity without patient data, improving to 95.4%/97.9% with adaptation.},
  keywords={Accuracy;Robustness;Solid state circuits;Low latency communication},
  doi={10.1109/ISSCC49663.2026.11409275},
}

@INPROCEEDINGS{11409049,
  author={Huo, Dexuan and Cheng, Ziyi and Zhang, Jilin and Jiang, Yumeng and Zhang, Lushuo and Wang, Hui and Ma, Na and Huang, Zebin and Lin, Minggui and Zhao, Yunxia and Wang, Zhihua and Tang, Kea-Tiong and Chen, Hong},
  title={36.4 ANP-OT: A 0.17nW/Synapse 0.46pJ/SOP Neuromorphic Olfactory Processor with On-Chip Transfer Learning for Non-Invasive Cross-Hospital Cross-Pulmonary-Disease Diagnosis},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This paper reports an olfactory processor with on-chip transfer learning for cross-hospital and cross-pulmonary-disease diagnosis, which achieves $>94 \%$ pulmonary disease detection accuracy at 3 different hospitals. This work achieves a $0.46 \text{pJ} /$ SOP energy efficiency, and a power density of $0.17 \text{nW} /$ synapse.},
  keywords={Power system measurements;Neuromorphics;Hospitals;Pulmonary diseases;Transfer learning;Olfactory;Energy efficiency;System-on-chip;Solid state circuits;Synapses},
  doi={10.1109/ISSCC49663.2026.11409049},
}

@INPROCEEDINGS{11409036,
  author={Kim, Geunha and Park, Kyuhyeon and Lee, Minoo and Wie, Jeongyoon and Jeong, Seokhan and Shin, Yeonjae and Lee, Kyoungtae and Yoon, Jong-Hyeok and Song, Minyoung and Lee, Junghyup},
  title={36.5 A 185.6dB-FOMDR 180.3dB-FOMSNDR 10.64-NEF NS-SAR-ADC with Calibration-Free 2nd-Order kT/C-Noise Shaping for Wearable ExG Acquisition},
  note={Section: Neural and Biomedical Interfaces},
  abstract={To enable high-fidelity wearable ExG acquisition, this paper presents an NS-SAR ADC that performs 2nd-order shaping of both quantization and kT/C noises through a multi-tasking integrator (MTI) and loop dynamics, without calibration. In addition, correlated-level-shifting (CLS) and ZIN-boosting techniques are used to enhance linearity and ZIN, respectively. Fabricated in $0.18 \mu \mathrm{m}$ CMOS, the ADC achieves 98.3dB SNDR, 103.6dB DR, $3.49 \mu \mathrm{V}_{\text{rms}}$ IRN over a 1 kHz BW, and ZIN of $168 \mathrm{M} \Omega$ while consuming $6.3 \mu \mathrm{W}$.},
  keywords={Quantization (signal);Noise;Linearity;Multitasking;Solid state circuits;Calibration},
  doi={10.1109/ISSCC49663.2026.11409036},
}

@INPROCEEDINGS{11409079,
  author={Wu, Hui and Tian, Fengshi and Chen, Jinbo and Liao, Zhipeng and Zhang, Hongyong and Liu, Xing and Zou, Wenjun and Cheng, Sirui and Zhang, Zhao and Xu, Jianlong and Tsui, Chi-Ying and Cheng, Kwang-Ting Tim and Yang, Jie and Sawan, Mohamad},
  title={36.6 A Sparsity-Aware Neural Interface with CIM-Based Predictive Focused Sampling for Hotspot Spike Tracking},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This 1024-electrode neural interface solves the power, area, and bandwidth bottleneck by combining low-power panoramic scanning for hotspot prediction with high-fidelity spike tracking on active sites. The dynamic allocation is guided by a real-time compute-in-memory (CIM) engine, providing a $16 \times$ resolution boost $(10 \text{kHz})$ and $0.0011 \text{mm}^{2} / \text{ch}$ efficiency in 40 nm CMOS. The design maximizes spike density to lower power and silicon area.},
  keywords={Bandwidth;In-memory computing;Dynamic scheduling;Silicon;Real-time systems;Common Information Model (computing);Solid state circuits;Resource management;Engines},
  doi={10.1109/ISSCC49663.2026.11409079},
}

@INPROCEEDINGS{11409033,
  author={Kang, Joonghoon and Roh, Hyeonhee and Eom, Kyeongho and Lee, Hyun-Su and Chon, Hojae and Im, Maesoon and Lee, Hyung-Min},
  title={A 90.7%-Efficiency Hybrid Optogenetic Stimulation System with Sub-Threshold Electrical Stimuli Achieving 70.6% Optical Energy Saving},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This work presents a hybrid optogenetic stimulation system with sub-threshold electrical stimuli that lower the optical threshold and reduce energy consumption. It achieves 90.75% LED driving efficiency through efficient capacitor charge-discharge operation and generates decaying-exponential irradiance to enhance neural responses. Ex vivo experiments in mice validate equivalent neural activation with a 70.6% optical energy saving compared to conventional optogenetics.},
  keywords={Energy consumption;Stimulated emission;Energy conservation;Capacitors;Light emitting diodes;Optogenetics;Mice;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409033},
}

@INPROCEEDINGS{11408955,
  author={Eom, Kyeongho and Lee, Hyun-Su and Kim, Minju and Im, Maesoon and Lee, Hyung-Min},
  title={An 80×80μ$\mathrm{m}^{2}$/Pixel 55.48dB-Wide-DR 400-Pixel Subretinal Prosthesis SoC with Power-Aware Light Adaptation and Charge-Recycling Local Dynamic Supply},
  note={Section: Neural and Biomedical Interfaces},
  abstract={We propose a light-adaptive retinal prosthesis (LARP) SoC, which employs power-aware light adaptation achieving a wide light-sensing DR of 55.48 dB. Pixel clustering enables a compact pixel size of $80 \times 80 \mu ~\mathrm{m}^{2}$, enhancing the stimulation spatial resolution. The charge- recycling local dynamic supply scheme enables up to a 34% reduction in stimulation energy. Image projection tests and ex vivo experiments using mouse retinal cells demonstrate the effectiveness of the LARP SoC.},
  keywords={Retina;Solid state circuits;Recycling;Spatial resolution;Prosthetics},
  doi={10.1109/ISSCC49663.2026.11408955},
}

@INPROCEEDINGS{11409263,
  author={Yang, Xiaolin and Neutens, Pieter and Humblet, Alexis and Sawigun, Chutham and O'Callaghan, John and Geurts, Thijs and Li, Zheyi and Gubin, Yaroslav and De Munck, Koen and Tilmans, Harrie A. C. and De Proft, Anabel and Dutta, Barundeb and Lopez, Carolina Mora},
  title={A CMOS Neural Probe with 1280 Electrodes and 88 Emission Sites Featuring Thermo-Optic Switching and on-Chip Calibration for Dual-Wavelength Optogenetics},
  note={Section: Neural and Biomedical Interfaces},
  abstract={We present a waveguide-based optogenetics neural probe with 1,280 electrodes, 384 recording channels, and 88 emission sites enabled by dual-layer silicon photonics. Thermo-optic switches are controlled by a custom photonic driver IC, while integrated tap couplers with photodiodes and a temperature sensor provide on-chip calibration and thermal monitoring. The probe achieves a large number of recording and emission sites, enabling reliable large-scale, cell-type-specific optogenetic studies.},
  keywords={Electrodes;Temperature sensors;Silicon photonics;Optogenetics;System-on-chip;Recording;Calibration;Solid state circuits;Probes;Switching circuits},
  doi={10.1109/ISSCC49663.2026.11409263},
}

@INPROCEEDINGS{11409107,
  author={Choi, Haidam and Yun, Gichan and Suh, Ji-Hoon and Park, Seonwoo and Yi, Donghyeon and Ha, Sohmyung and Je, Minkyu},
  title={A 43.8-to-662.0μW 27.5-to-878.9fps Frame-Rate-Scalable Duty-Cycled Electrical Impedance Tomography System with MIMO Current-Balancing IA},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This paper presents a frame-rate-scalable duty-cycled electrical impedance tomography system to reduce average power consumption. A proposed multiple-input multiple-output current-balancing IA halves power consumption, area, and input parasitics. Digital matched filters with harmonic-canceling FIR filters significantly reduce settling time, improving system throughput. The system achieves 878.9 fps at $662.0 \mu \mathrm{W}$ and 27.5 fps at $43.8 \mu \mathrm{W}$.},
  keywords={Electrical impedance tomography;Matched filters;Power demand;Finite impulse response filters;Throughput;MIMO;Solid state circuits},
  doi={10.1109/ISSCC49663.2026.11409107},
}

@INPROCEEDINGS{11408992,
  author={Li, Jiayang and Zhang, Qingyu and Ha, Sohmyung and Demosthenous, Andreas and Jiang, Dai and Wu, Yu},
  title={A 0.62μW/sensor 82fps Time-to-Digital Impedance Measurement IC with Unified Excitation/Readout Front-End for Large-Scale Piezo-Resistive Sensor Array},
  note={Section: Neural and Biomedical Interfaces},
  abstract={This paper presents a fast impedance-measurement IC for large-scale piezo-resistive sensor arrays. It features a unified differential time-to-digital demodulation architecture that reads out impedance directly through the excitation circuit. A pre-saturation adaptive bias technique further improves power efficiency. The chip scans 253 sensors in 12.2 ms (82 fps) at 125 kHz, consuming $158 \mu \mathrm{W}$ ($7.5 \text{nJ} /$ sensor). With loads from 20Ω to $500 \mathrm{k} \Omega$, it achieves 0.5% error and up to 71.1 dB SNR.},
  keywords={Impedance measurement;Solid state circuits;Impedance;Sensor arrays;Signal to noise ratio;Demodulation},
  doi={10.1109/ISSCC49663.2026.11408992},
}

@INPROCEEDINGS{11409257,
  author={Wu, Hongzhi and Cheng, Xuxu and Zhang, Yangyi and Luo, Xiongshi and Li, Zhenghao and Wu, Weitao and Pan, Quan},
  title={A 72Gb/s/pin Single-Ended Driver-Cooperative Coded PAM3 Transceiver with Asymmetric Data-Dependent Equalization and Bias-Peaking for Chiplets and Memory Interfaces},
  note={Section: Memory Interface},
  abstract={This paper presents a 72Gb/s/pin PAM-3 single-ended transceiver in 28nm CMOS. Driver-cooperative coding enhances signal integrity and reduces signaling power by $\geq 46 \%$. Asymmetric data-dependent equalization and bias peaking mitigate PAM-3 different edge ISI and switching jitter, enlarging eye area by $1.9 \times$ and $2.8 {\times}. \mathrm{A} \frac{1}{8}$-rate forwarded-clock multiplication scheme enables low-power and wide-range de-skew. The transceiver supports a 72Gb/s/pin data rate, with power efficiencies of 0.7pJ/b at 48Gb/s and 1.17pJ/b at 72Gb/s.},
  keywords={Chiplets;Switches;Jitter;Transceivers;Encoding;Solid state circuits;Signal integrity},
  doi={10.1109/ISSCC49663.2026.11409257},
}

@INPROCEEDINGS{11408977,
  author={Liu, Qian and Hui, Yiheng and Nong, Yuanlin and Ma, He and Xu, Yiwei and Hu, Hao and Zhu, Jinpeng and Wang, Quan and Wang, Lei and Du, Li and Du, Yuan},
  title={37.2 A 47.0Tb/s/mm 112Gb/s/pin PAM4 Single-Ended Transceiver Featuring 4-Aggressor Crosstalk Cancellation and Supply-Noise Tolerance for Short-Reach Memory Interfaces},
  note={Section: Memory Interface},
  abstract={This paper presents a five-lane 112Gb/s/pin PAM4 single-ended transceiver in 28nm CMOS for high-density short-reach memory interfaces. Low-power triple-equalization, 4-aggressor shape-fitting crosstalk cancellation and supply-noise-tolerant clock distribution networks are involved to improve the signal integrity. The design demonstrates robust performance against severe crosstalk and supply noise, achieving an energy efficiency of 0.52pJ/b and an edge density of 47.0Tb/s/mm.},
  keywords={Noise;Memory management;Crosstalk;Distribution networks;Transceivers;Energy efficiency;Solid state circuits;Signal integrity;Clocks},
  doi={10.1109/ISSCC49663.2026.11408977},
}

@INPROCEEDINGS{11409321,
  author={Choi, Yoonjae and Kim, Daero and Kim, Myunggon and Lee, Sangmin and Kang, Hansol and Lee, Gwangwon and Kim, Yoonhyung and Kang, Sungsik and Cho, Hyun and Kang, Boyoung and Lee, Kyoungwon and Song, Jaegeun and Choi, Jinho and Yi, Shinyoung and Koo, Billy and Chae, Kwanyeob and Rhew, Hyo-Gyuem},
  title={37.3 A 2nm All-Digital 14.4Gb/s/pin LPDDR6 PHY with Quarter-Rate Clocking Architecture and Multi-Level FIFO-Based Speculative DFE},
  note={Section: Memory Interface},
  abstract={This paper presents a 2 nm all-digital LPDDR6 PHY that achieves 14.4 Gb/s/pin, increasing bandwidth while optimizing power. Key innovations include quadrature clocking, with QEC, to reduce jitter sensitivity, and a multi-level FIFO-based speculative DFE to relax timing constraints in standard-cell implementation. An efficiency mode, employing clock gating, dramatically reduces power. A reconfigurable serializer supports both 1:6 and 1:8 DFIs, ensuring high bus efficiency and backward compatibility.},
  keywords={Technological innovation;Sensitivity;Bandwidth;Jitter;Timing;Solid state circuits;Clocks},
  doi={10.1109/ISSCC49663.2026.11409321},
}

@INPROCEEDINGS{11409172,
  author={Lin, Xiaohui and Javadi, Ramin and Bose, Bella and Anand, Tejasvi},
  title={37.4 A 100Gb/s, 1.92pJ/b Aggregate 4-Lane Single-Ended NRZ Transceiver with 15dB Far-End Crosstalk Cancellation via On-Chip Feature Extraction and Classification in 16nm FinFET},
  note={Section: Memory Interface},
  abstract={A low-power (1.92 pJ/bit), high-speed (100 Gb/s), equalizer-free, 4 -lane single-ended transceiver that leverages machine learning principles for crosstalk compensation is proposed. The transceiver uses feature extraction and on-chip classification. It achieves more than 0.2 UI horizontal opening for BER<10−12. The classification compensates the crosstalk from 3 aggressors and −15 dB far-end crosstalk power sum. The classification only accounts for 7% of the total transceiver power.},
  keywords={Equalizers;Aggregates;Crosstalk;Machine learning;Feature extraction;FinFETs;Transceivers;System-on-chip;Solid state circuits;Optical signal processing},
  doi={10.1109/ISSCC49663.2026.11409172},
}

@INPROCEEDINGS{11409057,
  author={He, Yuchen and Luo, Yunbin and Wang, Yunzhengmao and Yi, Tengyue and Jiang, Chen and Chen, Chixiao and Liu, Qi and Liu, Ming and Jiang, Wenning},
  title={A 16Gb/s/pin 0.51pJ/b Single-Ended NRZ Transceiver with Distributed Dual-Loop VDDQ-Ripple Compensation and Dynamic Clock Duty-Cycle Calibration for Memory Interfaces},
  note={Section: Memory Interface},
  abstract={A 16Gb/s/pin 0.51pJ/b single-ended NRZ transceiver with distributed dual-loop compensation (DDLC) for $\mathrm{V}_{\text{DDO }}$-ripple suppression and dynamic duty-cycle calibration (DDCC) for robust clocking is presented. The DDLC locally regulates $\mathrm{V}_{\text{DDQ}}$ with a shared low-power LDO, reducing the required decoupling capacitor by 91.4%, while improving horizontal and vertical eye margins by 61% and 36%. Demonstrated on five channels, the proposed DDLC scales naturally to larger DQ counts for high-density memories.},
  keywords={Capacitors;Transceivers;Calibration;Solid state circuits;Optical signal processing;Clocks},
  doi={10.1109/ISSCC49663.2026.11409057},
}

@INPROCEEDINGS{11409155,
  author={Lee, Ki-Soo and Han, Chanheum and Chae, Joo-Hyung},
  title={37.6 A 0.092pJ/b and 7.7fJ/b/dB Cross-Self-Referenced Slope-Sampling Receiver with Long-Tail ISI Robustness for Next-Generation Low-Power Memory Interfaces},
  note={Section: Memory Interface},
  abstract={We present a cross-self-referenced slope-sampling RX that is robust against long-tail ISI, without equalization, for next-generation low-power memory interfaces. By determining received data based on the slope of the input signal, the proposed architecture enhances resilience to accumulated post-cursor ISI. Fabricated in a 65-nm CMOS process, the prototype achieves a 0.092pJ/b energy efficiency at 12.5Gb/s and a 7.7fJ/b/dB FoM at 12Gb/s, while occupying only 0.001 mm2.},
  keywords={Heavily-tailed distribution;Memory management;Prototypes;Receivers;CMOS process;Robustness;Energy efficiency;Solid state circuits;Next generation networking;Resilience},
  doi={10.1109/ISSCC49663.2026.11409155},
}

@INPROCEEDINGS{11409228,
  author={Moon, Ji-Won and Kim, Taehyeon and Kim, Minwook and Seong, Hyeonwoo and Lee, Jewon and Park, Jeongbin and Park, Dongjun and Lee, Jaehoon and Park, Jung-June and Yoon, Chiweon and Sim, Jae-Yoon and Lee, Seon-Kyoo},
  title={37.7 A 12.8Gb/s Parallel Receiver with a One-Way Self-Training Scheme for Equalizing ISI and Reflections in Multi-Drop Memory Interfaces},
  note={Section: Memory Interface},
  abstract={This paper presents a $12.8 \text{Gb} / \mathrm{s} /$ pin receiver with a one-way self-training scheme for highly-reflective multi-drop memory interfaces. DFE tap coefficients are directly derived from a single-pulse response, eliminating controller interaction during training. Implemented in 40 nm CMOS, the receiver reopens a closed eye in a 4-drop channel at BER $<10^{-12}$. Reusing existing circuitry, the design achieves $102.4 \text{Gb} / \mathrm{s}$ throughput with only a 6.74% hardware overhead and a $0.64 \text{pJ} / \mathrm{b}$ energy efficiency.},
  keywords={Training;Memory management;Receivers;Throughput;Reflection;Hardware;Energy efficiency;Decision feedback equalizers;Solid state circuits;Pins},
  doi={10.1109/ISSCC49663.2026.11409228},
}

@INPROCEEDINGS{11409032,
  author={Kim, Byeong-Chan and Lee, Kyongsu and Park, Dongjun and Park, Jung-June and Yoon, Chiweon and Sim, Jae-Yoon and Lee, Seon-Kyoo},
  title={A 0.87pJ/b 17Gb/s/pin Parallel Receiver with a Local DQS Recovery for a Supply-Noise-Tolerant DQS Distribution in High-Performance NAND Flash Interfaces},
  note={Section: Memory Interface},
  abstract={This work presents a 0.87pJ/b, 17Gb/s/pin parallel receiver with local DQS recovery and a dual-DQS tree for reduced clock power and mitigated power supply-induced jitter (PSJJ). The local DQS recovery time-multiplexes a CML and an inverter tree $(^1/_{8}:^{7}/_8)$, enabling a hidden lock to the CML tree and subsequently generating a PSIJ-filtered DOS from the inverter tree with low power consumption. Fabricated in 40nm CMOS, it achieves $< 10^{-12}$ BER under $100\text{mV}_{\mathrm{P}\mathrm{P}}$ supply noise, while reducing clocking power by 70%.},
  keywords={Power demand;Trees (botanical);Noise;Receivers;Jitter;Inverters;Solid state circuits;Flash memories;Clocks},
  doi={10.1109/ISSCC49663.2026.11409032},
}

@INPROCEEDINGS{11409153,
  author={Lee, Jeonghyeon and Shin, Ho-Joon and Ko, Han-Gon and Park, Kwanseo},
  title={37.9 A 14Gb/s/pin 0.163pJ/b DQ Receiver for HBM with Baud-Rate Phase Tracking Loop Supporting Background Offset Calibration},
  note={Section: Memory Interface},
  abstract={This paper presents a compact 14Gb/s/pin HBM DQ receiver that continuously tracks sampling phase and detector offset in live data, using a baud-rate phase tracking loop with a background-calibrated time-window phase detector. Rise/fall edge-triggered decision logic decouples phase error from detector offset, keeping the sampling-clock lock point of the DCDL fixed under drift and thereby eliminating the need for retraining. A 28nm prototype achieves 0.163pJ/b energy efficiency in 0.00547mm2 at <10−12 BER with a 0.295UI sampling margin. High-frequency jitter tolerance reaches 0.188UI at 14Gb/s.},
  keywords={Tracking loops;Image edge detection;Prototypes;Detectors;Receivers;Jitter;Energy efficiency;Solid state circuits;Calibration;Logic},
  doi={10.1109/ISSCC49663.2026.11409153},
}
