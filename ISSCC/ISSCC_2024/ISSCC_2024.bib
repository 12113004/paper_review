@INPROCEEDINGS{10454562,
  author={Alben, Jonah},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={1.3 Computing in the Era of Generative AI}, 
  year={2024},
  volume={67},
  number={},
  pages={26-28},
  abstract={Generative AI has captured the imagination of users across multiple industries, and we’ve only begun to tap the potential of this amazing technology. GenAI applications can synthesize text, computer code, protein sequences, images, video, rendered 3D graphics, music, with more generation types being constantly added. The combination of the immense and growing compute demands and real-time requirements of many GenAI-based applications requires that computers be designed at data center scale. This talk will cover the breadth of technology innovations – spanning circuits to software to the entire datacenter – needed to enable today’s latest supercomputers for GenAI, and discuss NVIDIA’s experiences applying GenAI in our business.},
  keywords={Industries;Training;Technological innovation;Three-dimensional displays;Generative AI;Graphics processing units;Bandwidth},
  doi={10.1109/ISSCC49657.2024.10454562},
  ISSN={2376-8606},
  month={Feb},}

