@INPROCEEDINGS{10454333,
  author={Lee, Jongsoo and Jang, Jaehyuk and Lee, Wooseok and Suh, Bosung and Yoo, Heeyong and Park, Beomyu and Woo, Jeongkyun and Jang, Jaeeun and Ryu, Inhyo and Han, Honggul and Kim, Jaeyoung and Kang, Byoungjoong and Kang, Minchul and Kang, Hojung and Kang, John and Lee, Minseob and Lee, Danbi and Son, Hyeonuk and Lee, Suhyeon and Kim, Soyeon and Park, Hongjong and Lee, Sangsung and Bae, Jeongyeol and Kim, Huijung and Lee, Joonhee and Yoo, Sangmin},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={4.2 A Tri-Band Dual-Concurrent Wi-Fi 802.11be Transceiver Achieving -46dB TX/RX EVM Floor at 7.1GHz for a 4K-QAM 320MHz Signal}, 
  year={2024},
  volume={67},
  number={},
  pages={78-80},
  abstract={The Wi-Fi 7 standard (IEEE 802.11be) was developed to meet the growing need for increased capacity and high throughput. However, the new, more demanding requirements for RF/analog circuits, including an extended bandwidth of 320MHz with 4K-QAM, result in increased complexity in circuit design to address issues of linearity, noise, bandwidth, and power consumption. Despite these challenges, Wi-Fi 7 promises faster and more reliable wireless connectivity. This paper presents a Wi-Fi 7 transceiver that demonstrates excellent linearity with the smallest power consumption among state-of-the-art transceivers listed in the comparison table (Fig. 4.2.6), operating at up to 7.1GHz with a 320MHz bandwidth. Figure 4.2.1 illustrates the Wi-Fi transceiver, which consists of two identical tri-band transceivers and local-oscillator (LO) generation circuits with three phase-locked loops (PLLs) to support various operation modes, including a real simultaneous dual-band (RSDB), and an enhanced multi-link single radio (EMLSR) of 2.4GHz+5GHz (or 6GHz).},
  keywords={Wireless communication;Power demand;Linearity;Bandwidth;Throughput;Transceivers;Solid state circuits},
  doi={10.1109/ISSCC49657.2024.10454333},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454281,
  author={Bae, Jeongyeol and Lee, Sangsung and Lee, Joonggeun and Jo, Ikkyun and Kim, Heesoo and Yoon, Kyunghyun and Kim, Taejong and Lee, Jiyoung and Lee, Myunghun and Lee, Jaeseung and Jeong, Jongmin and Lee, Sungjun and Kim, Taewan and Kim, Sungjoo and Cho, Gwangsik and Kim, Duksoo and Lee, Sangyun and Jang, Pilsung and Yang, Euibong and Song, Jeongmin and Park, Gwangchun and Choi, Se-Eun and Son, Juhee and Ko, Won and Kim, Jonghyun and Park, Seong Ho and Lee, Sangho and Lee, Yoonki and Park, Euiyoung and Kang, Pillseong and Kim, Taeyeon and Lee, Hyojin and Han, Byungki and Lee, Joonhee and Lee, Jongsoo and Yoo, Sangmin},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={4.3 A 43mm2 Fully Integrated Legacy Cellular and 5G FR1 RF Transceiver with 24RX/3TX Supporting Inter-Band 7CA/5CA 4×4 MIMO with 1K-QAM}, 
  year={2024},
  volume={67},
  number={},
  pages={80-82},
  abstract={As mobile applications have become more prevalent, the demand for higher network capacity and data rates has increased. This has led to the development of complicated platforms including RF transceivers that can support various frequency bands, a massive multiple-input and multiple-output (MIMO), multiple carrier components (CCs) and carrier aggregations (CAs). This paper presents a fully integrated, versatile RF transceiver designed to handle high data rates and to achieve a cost-efficient RF solution, incorporating various techniques. The transceiver comprises 24 receivers (RXs) and 7 RX local oscillators (LOs) to support 9 downlink (DL) inter-band 7CA or 5CA with 4×4 MIMO, 3 transmitters (TXs) and 3 TX LOs to enable 3 uplink (UL) MIMO, 2 feedback receivers (FBRXs), a dual-band global navigation satellite system (GNSS), and a digital interface, as depicted in Fig. 4.3.1. It supports both NR (5G) and legacy (2/3/4G) protocols, operating across a very wide frequency range spanning from 450MHz to 7125MHz.},
  keywords={Radio frequency;Global navigation satellite system;Protocols;5G mobile communication;Transmitters;Receivers;Transceivers},
  doi={10.1109/ISSCC49657.2024.10454281},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454514,
  author={Li, Jiaxiang and Li, Zimu and Yin, Yun and Yan, Changgu and Qi, Nan and Liu, Ming and Xu, Hongtao},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={4.4 A Highly-Integrated 6-Phase Cell-Reused Digital Transmitter Using 1/3 Duty-Cycle LO Signals for Harmonic Rejection}, 
  year={2024},
  volume={67},
  number={},
  pages={82-84},
  abstract={To fully benefit from advanced CMOS technologies, it is desirable to completely digitize the transmitter, which yields reduced die area, highly efficient operation and direct interface to digital baseband. However, the ever-increasing data demand with complex OFDM and wideband high-order modulation poses great challenges on transmitter output power, efficiency and linearity. The quadrature and polar digital transmitters (DTXs) are two types of widely-used architectures: the quadratur e DTX is suitable for wideband signals but the orthogonal vector combination limits output power and efficiency [1, 2]; the polar DTX has advantages of high output power and efficiency, but it requires extra design complexity of phase modulators and AM-PM synchronization [3, 4]. Moreover, the switch-based digital power amplifier (DPA) driven by square-wave LOs will generate significant unwanted odd harmonic components, where the 3rd harmonic usually falls in the crowded sub-6GHz band and potentially interferes with other terminals. In this work, a 6-phase cell-reused DTX driven by 1/3 duty-cycle LO signals is proposed, which approaches the output power range of polar counterparts and realizes 18 efficiency peaks on the complex plane. By introducing a multi-phase injection-locked ring oscillator (ILRO) as an accurate, low-jitter and low-power solution for multi-phase LO generation (MPLG), this DTX achieves good 3rd-order harmonic rejection (HR3) and linearity performance.},
  keywords={Transmitters;Power amplifiers;Linearity;Switches;Power system harmonics;Harmonic analysis;Vectors},
  doi={10.1109/ISSCC49657.2024.10454514},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454269,
  author={Zhong, John and Vasilakopoulos, Konstantinos and Liscidini, Antonio},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={4.5 A Reconfigurable, Multi-Channel Quantized-Analog Transmitter with <-35dB EVM and <-51dBc ACLR in 22nm FDSOI}, 
  year={2024},
  volume={67},
  number={},
  pages={84-86},
  abstract={The presence of multiple operative modes and standards in 5G/6G systems set two crucial requirements for the next generations of wireless transmitter (TX): flexibility and high spectral purity. While the former can be obtained by more digital systems such as a radio-frequency digital-to-analog converter (RF-DAC) TX [1, 2], mixer-based solutions still outperform RF-DACs in terms of spectral purity for a given power dissipation [3, 4]. The reason is that RF-DACs need a very large number of bits (up to 18bits) to lower the quantization noise, and a very high sampling rate to meet the spectral purity required by 5G/6G TXs [2]. This work aims to find a compromise between RF-DAC and analog-based TXs by using the Quantized Analog (QA) signal processing presented by Musayev et al. [5]. The signal is sliced in amplitude to feed an array of analog TXs, and recombined after the upconversion (Fig. 4.5.1). While keeping similar spectral purity as analog TXs, this approach has a higher level of flexibility by enabling multi-carrier operation, power scalability and an agile reconfiguration of the class of operations. Moreover, it will be shown how the QA approach is a very competitive solution in terms of area and power dissipation compared to RF-DAC-based solutions.},
  keywords={Wireless communication;Radio frequency;Quantization (signal);Scalability;Radio transmitters;Silicon-on-insulator;Power dissipation},
  doi={10.1109/ISSCC49657.2024.10454269},
  ISSN={2376-8606},
  month={Feb},}

