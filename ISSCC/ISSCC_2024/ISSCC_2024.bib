@INPROCEEDINGS{10454493,
  author={Xu, Hao and Bi, Junyan and Zou, Tenghao and He, Weitao and Zeng, Yaxin and Gu, Junjie and Jiao, Ziyang and Liu, Shubin and Zhu, Zhangming and Yan, Na},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={5.1 A 5-to-16GHz Reconfigurable Quadrature Receiver with 50% Duty-Cycle LO and IQ-Leakage Suppression}, 
  year={2024},
  volume={67},
  number={},
  pages={88-90},
  abstract={Agile multi-functional RF systems supporting multiple communication and radar protocols are of greater demand in modern wireless applications. The core of these systems is the transceiver IC that covers an ultra-wide frequency range from sub-GHz to >20GHz, provides highly flexible signal bandwidths, and adjusts its power consumption accordingly in different use cases. This imposes several design challenges. Firstly, the RF front-end must process the incoming signal over a wide frequency range (fRF) without contributing excessive noise and distortions [1, 2]. Secondly, the difficulty of generating multi-phase clocks with low phase mismatches and low jitter that are essential for mixing grows significantly at higher carrier (fLO) frequencies [2]. Thirdly, whereas the power consumption of the front-end remains independent of the baseband signal bandwidth (fBB) on the first order, the analog baseband intensively using amplifiers sees dramatic power overhead with increasingly higher fBB [3]. Lastly, the desired high reconfigurability including gain, bandwidth and power consumption inevitably complicates circuit design [4]. To address these challenges, this work describes a 5-to-16GHz, 32-to-72dB gain and 2.2-to-5.7dB noise figure (NF) quadrature RF receiver with on-chip multi-phase clock generation and enhanced I-Q isolation.},
  keywords={Radio frequency;Wireless communication;Power demand;Baseband;Bandwidth;Receivers;Transceivers},
  doi={10.1109/ISSCC49657.2024.10454493},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454516,
  author={Araei, Soroush and Mohin, Shahabeddin and Reiskarimian, Negar},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={5.2 0.25-to-4GHz Harmonic-Resilient Receiver with Built-In HR at Antenna and BB Achieving +14/+16.5dBm 3rd/5th IB Harmonic B1dB}, 
  year={2024},
  volume={67},
  number={},
  pages={90-92},
  abstract={Widely tunable and reconfigurable receivers are heavily in demand both for high-performance and low-power applications such as 5G New Radio and IoT. One of the crucial features required for a widely tunable RX is the ability to suppress harmonic blockers efficiently and at the earliest opportunity. Methods to achieve harmonic rejection (HR) can be categorized into two groups of active and passive HR (Fig. 5.2.1). Many active approaches have been introduced based on weighted recombination at the baseband (BB) [1] or at a preliminary stage employing multi-input multi-output HR-TIAs [2] to prevent harmonic blockers from undergoing any voltage amplification for improved linearity. However, active methods can only tolerate small blocker voltage swings at their input, leading to the desensitization of the entire receiver in the presence of strong harmonic blockers. In the past year, passive approaches to achieve HR have been reported in [3, 4]. The HR N-path transformixer in [3] passively suppresses harmonic blockers before they reach BB LNAs, offering a higher linearity. Yet, this method suffers from limited $3 ^{rd}/ 5 ^{th}$ HR of 25dB and exhibits poor performance against even harmonic blockers. The fully passive N-path-based HR mixer described in [4], effectively rejects harmonic blockers before they reach the BB amplifiers, by simultaneously utilizing capacitor stacking and charge sharing in the HR mixer cell. Although this approach ensures harmonic blockers are eliminated at the mixer output, the terminals of the mixer switches in each path are still exposed to the harmonic blockers.},
  keywords={Stacking;Capacitors;Linearity;Receiving antennas;Voltage;Switches;Harmonic analysis},
  doi={10.1109/ISSCC49657.2024.10454516},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454550,
  author={Ayesh, Mostafa and Mahapatra, Soumya and Yang, Ce and Chen, Mike Shuo-Wei},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={5.3 A 0.072mm2 18-to-21GHz Non-Uniform Sub-Sampling Receiver with a Non-Uniform Discrete-Time FIR Filter Achieving 42dB Blocker Rejection in 28nm CMOS}, 
  year={2024},
  volume={67},
  number={},
  pages={92-94},
  abstract={Conventional wireless receivers employing a heterodyne/homodyne architecture or N-path filter often result in a significantly higher area and power overhead owing to the requirement of LO generation and distribution at high frequencies [1]. Those overheads can be alleviated by uniform sub-sampling (USS) architectures that directly sample the RX input signal at a much lower clock frequency and rely on a particular harmonic aliasing for signal downconversion and reconstruction [2]. Such receivers require the desired signal to be strictly bandpass filtered, otherwise destructive aliasing would happen if blockers exist at other harmonics of the sub-sampling frequency, and hence compromise signal integrity. A non-uniform sub-sampling (NUSS) technique was presented in [3] to avoid such destructive in-band aliasing. It spreads the blocker energy appearing at those unwanted harmonics to out-of-band (OOB) frequencies after sampling, which is called spectral alias spreading. These OOB spectral aliases can still result in a large signal swing and may even saturate the ADC input. To mitigate this issue and further enhance the blocker tolerance of an NUSS receiver with low cost, this work features the following: 1) A non-uniform discrete-time (NU DT) FIR filter following NUSS to attenuate the unwanted energy of spectral alias spreading and hence relax the required dynamic range (DR) and sampling rate of the ADC, 2) A delay-locked-loop (DLL)-based NU sampling clock generator and a co-aligned decimation clock for converting the NU samples back to uniform ones, and 3) A current-mode NU DT FIR filter implementation that integrates the weighted current onto the capacitive DAC (CDAC) of the SAR ADC as part of an integrate-and-hold (I/H) network. This reduces area, power, and offers higher linearity. A proof-of-concept receiver prototype is fabricated in 28nm CMOS with reconfigurable blocker-rejection notches. The alias-band blocker rejection achieves as high as 39dB at 2.5GHz and 42dB at 5GHz frequency offset from a 20GHz carrier frequency. Compared to the conventional uniform DT FIR in a USS receiver, the proposed NU DT FIR together with NUSS shows nearly 31dB improvement in blocker tolerance in the case of a target SNDR of 20dB with ~150MHz baseband signal bandwidth.},
  keywords={Band-pass filters;Wireless communication;Finite impulse response filters;Prototypes;Receivers;Harmonic analysis;Solid state circuits},
  doi={10.1109/ISSCC49657.2024.10454550},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454530,
  author={Yu, Yiming and Sun, Bohan and Geng, Mengqian and Zhao, Chenxi and Liu, Huihua and Wu, Yunqiu and Zhang, Jingzhi and Kang, Kai},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={5.4 A 22.4-to-30.7GHz Phased-Array Receiver with Beam-Pattern Null-Steering and Beam-Tracking Techniques Achieving >30.2dB OTA-Tested Spatial Rejection}, 
  year={2024},
  volume={67},
  number={},
  pages={94-96},
  abstract={Mm-wave phased-array receivers (RXs) operating in complicated electromagnetic environments often suffer from spatially diversified interference, which leads to saturation and non-linear distortion in the RXs. One commonly used approach to mitigate this issue is the application of sidelobe suppression methods using window functions [1, 2], which comes with a drawback of array gain reduction. Alternatively, spatial notch filters are proposed, which can generate a spatial notch to undesired in-band blockers. This can be achieved at baseband and intermediate frequency (IF) stages where the blocker received in each channel is amplified, downconverted, and processed [3, 4]. However, the blocker handling capability is limited by the linearity of the downconversion mixers and subsequent IF circuits, thereby a power-hungry, highly linear mixer is in demand. Another approach is to suppress the blocker in RF chains, but this approach imposes limitations on the scalability of phased-array RXs since each element requires an individual spatial notch filter and a symmetrical layout [5]. In this work, we demonstrate a beam-pattern null-steering (BPNS) technique for mm-wave phased-array RXs, which (1) suppresses in-band blockers before the mixer, (2) eliminates the need for lossy attenuators or power-hungry variable-gain amplifiers (VGAs) in each RF channel, and (3) supports higher scalability. Also, a beam-tracking (BT) method is developed to timely detect the incident angles of blockers, as well as that of the desired signal.},
  keywords={Radio frequency;Scalability;Nonlinear distortion;Layout;Linearity;Receivers;Solid state circuits},
  doi={10.1109/ISSCC49657.2024.10454530},
  ISSN={2376-8606},
  month={Feb},}

@INPROCEEDINGS{10454419,
  author={van Zanten, Stef and van der Zee, Ronan and Nauta, Bram},
  booktitle={2024 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={5.5 A Stacking Mixer-First Receiver Achieving >20dBm Adjacent-Channel IIP3 Consuming less than 25mW}, 
  year={2024},
  volume={67},
  number={},
  pages={96-98},
  abstract={The sub-6GHz spectrum is used by many standards including 5G New Radio. In this crowded spectrum, an RX requires good linearity and flexibility to address different bands without separate SAW filters, whilst maintaining low NF. Traditional mixer-first receivers (MF-RX) offer this flexibility while postponing voltage amplification to the end of the RX chain, benefiting linearity but leading to relatively poor NF. LNTA-based designs [1, 2] offer an alternative: initial amplification alleviates noise constraints, but the pole at the LNTA output limits the RX operating range, though efforts to reduce parasitic capacitance have been fruitful [2]. Still, linearity is impacted by this initial voltage gain, which is typically addressed by deploying an N-path notch filter in feedback around the LNTA, but its slope is generally limited to 20dB/decade, reflecting in poor adjacent channel IIP3. Although solutions to increase this slope exist, the extra circuitry increases the RF parasitics and power consumption. Also, in contrast to an MF-RX which has a low-ohmic OOB path to ground, the LNTA output stage has to fully absorb any out-of-band (00B) interferer currents.},
  keywords={Radio frequency;Stacking;Linearity;Voltage;Receivers;SAW filters;Solid state circuits},
  doi={10.1109/ISSCC49657.2024.10454419},
  ISSN={2376-8606},
  month={Feb},}

