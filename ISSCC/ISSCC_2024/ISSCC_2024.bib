@INPROCEEDINGS{10067616,
  author={Khakifirooz, Ali and Anaya, Eduardo and Balasubrahrmanyam, Sriram and Bennett, Geoff and Castro, Daniel and Egler, John and Fan, Kuangchan and Ferdous, Rifat and Ganapathi, Kartik and Guzman, Omar and Ha, Chang Wan and Haque, Rezaul and Harish, Vinaya and Jalalifar, Majid and Jungroth, Owen W. and Kang, Sung-Taeg and Karbasian, Golnaz and Kim, Jee-Yeon and Li, Siyue and Madraswala, Aliasgar S. and Maddukuri, Srivijay and Mohammed, Amr and Mookiah, Shanmathi and Nagabhushan, Shashi and Ngo, Binh and Patel, Deep and Poosarla, Sai Kumar and Prabhu, Naveen V. and Quiroga, Carlos and Rajwade, Shantanu and Rahman, Ahsanur and Shah, Jalpa and Shenoy, Rohit S. and Menson, Ebenezer Tachie and Tankasala, Archana and Thirumala, Sandeep Krishna and Upadhyay, Sagar and Upadhyayula, Krishnasree and Velasco, Ashley and Vemula, Nanda Kishore Babu and Venkataramaiah, Bhaskar and Zhou, Jiantao and Pathak, Bharat M. and Kalavade, Pranav},
  booktitle={2023 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={A 1.67Tb, 5b/Cell Flash Memory Fabricated in 192-Layer Floating Gate 3D-NAND Technology and Featuring a 23.3Gb/mm2 Bit Density}, 
  year={2023},
  volume={},
  number={},
  pages={27-29},
  abstract={Successful deployment of multiple generations of the $4\mathsf{b}/\mathsf{cell}$ (QLC) floating-gate 3D-NAND technology has paved the way for the industry-wide adoption of $\mathsf{QLC} [1-4]$. The transition to 5b/cell (PLC) will be another steppingstone to accelerating bit density growth and expanding Flash storage to wider markets, where a lower cost at a reasonable performance is the paramount requirement.},
