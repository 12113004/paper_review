  year={2024},
  volume={67},
  number={},
  pages={214-215},
  abstract={The Deep Neural Network (DNN) era was ushered in by the triad of algorithms, big data, and more powerful hardware processors for training large-scale neural networks. Now, the ubiquitous deployment of DNNs for neural inference in edge, embedded, and data center applications demands more power-efficient hardware processors, while attaining increasingly higher computational performance. To address this Inference Challenge, we developed the NorthPole Architecture and implemented a NorthPole Chip instantiation [1, 2].},
  keywords={Training;Data centers;Program processors;Computer architecture;Artificial neural networks;Big Data;Hardware},
