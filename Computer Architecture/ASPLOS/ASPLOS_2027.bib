@inproceedings{10.1145/3845814.3850043,
  author={Gao, Xiangyu and Li, Winston and Li, Jiakang and Li, Zirui and Huang, Yipeng and Iancu, Costin and Zhang, Eddy Z.},
  title={Accordion: An End-to-end Approach for Fermionic Simulation in Quantum Devices},
  abstract={Simulating fermionic systems on quantum hardware requires compiling fermionic Hamiltonians into executable quantum circuits through three stages: fermion-to-qubit mapping, circuit synthesis, and hardware routing. Existing approaches largely optimize these stages independently, relying on stage-specific heuristics that can lead to &gt;&gt; O(n4) scaling in gate count and circuit depth, as well as compilation times of several hours for large instances. We present SimP, an end-to-end compilation framework that vertically integrates fermion-to-qubit mapping, circuit synthesis, and hardware routing. SimP exploits the regular structure of two-body fermionic operators across these compilation stages to substantially reduce the complexity of the resulting circuits. For full-rank all-to-all two-body Hamiltonians, SimP achieves O(n4) gate count and circuit depth, with gate count matching the information-theoretic lower bound imposed by the ?(n4) terms in a two-body fermionic Hamiltonian. Across linear, IBM heavy-hex, and square-grid architectures, SimP reduces gate count by up to 80\% and circuit depth by up to 77\% relative to the state of the art, while reducing compilation time by up to 99\% on large instances. The source code of SimP is publicly available at https://github.com/ruadapt/Accordion-Fermionic-Simulation.},
  keywords={quantum computing, fermionic simulation, qubit mapping, uccsd ansatz, compiler},
  doi={10.1145/3845814.3850043}
}

@inproceedings{10.1145/3845814.3850056,
  author={Routh, Xavier and Noor, Abdul Rafae and Kothari, Akash and Li, Zheyu and Afarin, Mahbod and Rosing, Tajana and Adve, Vikram},
  title={ApproxHDC: Approximation Tuning for Hyperdimensional Computing},
  abstract={As Moore's law reaches its physical and economic limits, domain-specific approaches are increasingly employed to accelerate machine learning workloads. Hyperdimensional Computing (HDC) represents one such emerging paradigm, offering an alternative to conventional deep learning techniques. Rooted in cognitive models of computation, HDC is designed bottom-up with hardware efficiency as a first-class objective. Consequently, HDC workloads map naturally to heterogeneous hardware platforms, including CPUs, GPUs, and FPGAs, as well as emerging in-memory computing technologies such as Resistive RAM (ReRAM) and Phase-Change Memory (PCM). The intrinsic tolerance of HDC algorithms to noise and approximation enables substantial performance gains with minimal loss in inference quality. In this work, we introduce ApproxHDC, a framework for automated identification and application of domain-specific approximations in HDC workloads. ApproxHDC extends the HPVM-HDC compiler infrastructure to enable retargetable compilation across diverse hardware backends, including CPUs, GPUs, and simulated ReRAM and PCM-based accelerators. The space of possible software and hardware approximations in HDC is exponentially large, making exhaustive exploration intractable; ApproxHDC employs efficient search and analysis techniques to navigate this space and identify high-impact approximations. We further integrate hardware-level approximation mechanisms within the HDC accelerator to demonstrate ApproxHDC's ability to exploit both software and hardware approximations. Experimental evaluation shows that ApproxHDC achieves up to 17.25x speedup on CPUs, 14.97x on GPUs, and 4.69x on SpecPCM while staying within user-specified quality-of-service constraints, outperforming the state-of-the-art MicroHD framework by 3.49x. HDC-specific search space pruning reduces the design space by 71 to 491 orders of magnitude automatically and up to 89 more with developer guidance, enabling discovery of high-quality configurations within minutes.},
  keywords={hyperdimensional computing, approximate computing, compilers, auto-tuning, heterogeneous systems},
  doi={10.1145/3845814.3850056}
}

@inproceedings{10.1145/3845814.3850081,
  author={Huang, Zongle and Fan, Shupei and Lin, Xinyuan and Tang, Chen and Chen, Wenya and Deng, Shuwen and Liu, Yongpan},
  title={Argus: Hardware-Software Co-Scaling of Tensor Parallelism for Efficient LLM Training},
  abstract={Training LLM requires hybrid parallelism across thousands of GPUs, yet tensor parallelism (TP)—partitioning large weight tensors—remains limited to small degrees in practice due to hardware and software scalability constraints. This limited TP degree forces deeper pipeline parallelism or larger data parallelism, each incurring additional inefficiencies. It also increases memory bandwidth demand, placing an unnecessary burden on already capacity-constrained training systems.Driven by these limitations, we advocate scalable TP, where the TP degree scales with the model hidden size. We realize this with Argus, a communication- and memory-efficient system co-designed across hardware and software. On the hardware front, Argus leverages a switchless chiplet architecture for low link latency and high scalability. We further introduce a split-memory design that consistently prevents memory access from becoming a bottleneck at scale under physical and cost constraints. On the software front, we develop a TP solution with low communication complexity, and adopt an interleaved transfer pattern tailored for connectivity-limited switchless networks. We further remove the TP-degree constraint imposed by attention head count by eliminating partial-sum transfer overhead.Collectively, these optimizations enable coordinated scaling: computation, communication, and memory overheads remain asymptotically constant as the TP degree increases. This property is validated by both theoretical analysis and experiments, with Argus delivering 3.10{\texttimes}/2.02{\texttimes} speedup/energy saving over typical TP baselines. Scalable TP further improves hybrid-parallel training efficiency by better balancing different forms of parallelism, yielding an estimated 65\% MFU for Llama3.1-405B.},
  keywords={chiplet, tensor parallelism, llm training},
  doi={10.1145/3845814.3850081}
}

@inproceedings{10.1145/3845814.3850029,
  author={Zhang, Chengyi Lux and Wei, Tianrui and Maroo, Ansh and Yan, Ruohan Richard and Shao, Yakun Sophia and Karandikar, Sagar},
  title={ATT: High-Fidelity System-Level CPU Profiling with Accurate Basic-Block Timing},
  abstract={Performance profiling tools inform developers where time is spent. However, as hardware and software grow more complex, accurately answering this question is increasingly challenging. Many existing profiling tools require users to make trade-offs in the fidelity space. Sampling loses temporal continuity, and instrumentation may incur high overhead. Hardware tracing offers continuous, low-overhead visibility into control flow, but many deployed trace formats attach timestamps only sparsely, requiring reconstruction tools to smear time across multiple basic blocks and thereby reducing attribution accuracy. We revisit accurate, continuous basic-block timing as an important capability for high-fidelity system-level CPU profiling. We present Accurately Timestamped Trace (ATT), a trace encoding format that treats time as a first-class payload and compresses packets to reduce overhead, together with Timestamp-Accurate Control-flow Instruction Tracing (TACIT), an open-source end-to-end hardware-software system that implements it. On the hardware side, we implement the TACIT trace encoder as an RTL generator supporting multiple different RISC-V cores. On the software side, we provide OS support for control and metadata logging, together with an offline decoder that reconstructs full-stack execution timelines and enables flexible analysis. We demonstrate TACIT through three case studies. First, we use TACIT to analyze latency variation in the Linux process launch and exit lifecycle, explaining and resolving the p99.9 tail latency caused by RCU and scheduler interactions. Second, we construct variational basic-block profiles for Lua, a bytecode interpreter, to characterize its bottleneck. We identify the context-sensitive indirect jump, apply a profile-guided operator fusion optimization, and reduce the end-to-end runtime by up to 20\%. Finally, we use TACIT to characterize the overhead of inter-processor interrupt TLB shootdown. These results show that precise per-basic-block timing enables useful performance analyses.},
  keywords={cpu profiling, processor tracing},
  doi={10.1145/3845814.3850029}
}

@inproceedings{10.1145/3845814.3850041,
  author={Kang, Byeongjee and Hoffmann, Jan and Jia, Limin and Lucia, Brandon and Saad, Feras A.},
  title={Bao: Automatic Region Placement and Memory Allocation for Intermittent Computing},
  abstract={Intermittent computing enables batteryless embedded devices to operate in harsh environment, but frequent power failures interrupt program execution and require careful management of state across power cycles. The core challenge is to guarantee both memory consistency and forward progress while minimizing the energy overhead of checkpointing. Recent compile-time approaches identify regions that fit in the energy buffer. At runtime, the device waits and recharges between the regions. However, they still rely on greedy or path-local heuristics that commit to local decisions and can miss globally lower-overhead boundary placements. To address this limitation, we present Bao, a system that jointly finds optimal energy-aware region formation and memory allocation decisions with formal correctness guarantees, by formulating it as a mixed-integer linear program. We prove that any feasible solution guarantees energy safety and implement our approach in LLVM. Our evaluation on 13 benchmarks across 3 capacitor sizes shows that Bao outperforms existing baselines, achieving 10\% faster execution and 52\% fewer region boundary hits on average compared to the best baseline.},
  keywords={intermittent computing, checkpointing, memory allocation, compilation, energy modeling, mixed-integer linear programming},
  doi={10.1145/3845814.3850041}
}

@inproceedings{10.1145/3845814.3850089,
  author={Jung, Seonghun and Moon, Sieun and Jeong, Jiyoung and Lee, Jimin and Huh, Jaehyuk},
  title={Beyond LLM Serving: Characterizing Vision-Language-Action Workloads for Embodied AI System Design},
  abstract={Vision-language-action (VLA) models translate multimodal observations into low-level robot actions. During robot operation, each control period sets an inference deadline, and overruns leave the robot acting on stale observations, reducing task success. Meeting this deadline motivates on-device or nearby edge execution, where a single robot requires batch-1 inference outside the design point of LLM serving systems. Although VLA architectures combine familiar vision-language, autoregressive, and diffusion-style components, their runtime behavior in this batch-1 control setting remains uncharacterized. We characterize four representative VLA models on an edge GPU server and two onboard SoCs, using single-inference profiling and 43,200 closed-loop episodes. Action tensor dimensionality determines whether a stage is memory- or compute-bound, platform balance can shift that bottleneck, and GPU frequency scaling yields a platform-dependent energy-latency sweet spot. In closed-loop operation, overlapping inference with action execution creates an accuracy-speed-energy tradeoff, and no configuration is Pareto-dominant across deployment SLOs. These results guide joint design of VLA model architectures, hardware, and runtime policies.},
  keywords={vision-language-action models, embodied manipulation, closed-loop inference, workload characterization},
  doi={10.1145/3845814.3850089}
}

@inproceedings{10.1145/3845814.3850083,
  author={Sprokholt, Dennis and Levine, Reese and Sarkar, Susmit and Goens, Andr{\'e}s and Nagarajan, Vijay and Chakraborty, Soham},
  title={Beyond the Fence: Sound Compilation for GPU and Heterogeneous CPU+GPU Systems},
  abstract={Modern heterogeneous processors like NVIDIA's Grace Hopper tightly integrate CPUs and GPUs with shared coherent memory, relying on independent compilation of CPU and GPU code. We show that the standard compilation path for such heterogeneous CUDA programs is unsound: Independently compiled code can violate the guarantees of the scoped-C/C++ concurrency model. In diagnosing this failure, we uncover a deeper flaw in the PTX memory model itself. The compilation from scoped-C/C++ to PTX-which NVIDIA formally verified and considered ''an important prerequisite to the official release of the model''-is unsound; NVIDIA has confirmed our finding. The flaw stems from the model treating full fences specially, unlike other ordering primitives.We resolve both the heterogeneous and homogeneous flaws with a single, targeted change to the PTX SC ordering. Our modified model preserves non-multicopy-atomic behaviors, respects scope boundaries, and-as we confirm through empirical litmus testing on NVIDIA A100, H100, GH200, and GB10 GPUs-imposes no new requirements beyond what the hardware already enforces. All soundness proofs are mechanized in Agda. Although our model is specific to PTX and ARM-PTX, the lesson is general: Ordering between fences should not be treated specially but should instead be derived from existing primitive relations.},
  keywords={weak memory, compound memory models, gpus},
  doi={10.1145/3845814.3850083}
}

@inproceedings{10.1145/3845814.3850028,
  author={Zheng, Hangyu and Shu, Zhihao and Zhu, Kunxiong and Qin, Minghai and Ma, Xiaolong and Agrawal, Gagan and Niu, Wei},
  title={BitLLM: Efficient Low-Bit, Conversion-Hiding LLM Decoding on Mobile GPUs},
  abstract={The rapid scaling of large language models (LLMs) has unlocked remarkable capabilities across various domains. However, deploying LLMs on mobile devices remains challenging because of their high computational and memory requirements. Low-bit quantization (e.g., 4-bit weights, 8-bit activations) can reduce model size while preserving accuracy, but its practical efficacy on mobile GPUs has been limited so far. In this paper, we identify that the performance gap stems primarily from frequent data type conversions between quantized and floating-point values, and dynamic and inefficient memory access patterns caused by the growing Key-Value (KV) cache during autoregressive decoding. We introduce BitLLM, a mobile inference engine that addresses type conversion overhead and suboptimal memory accesses in quantized LLMs. Our approach features an adaptive layout and packing strategy for the KV cache that ensures efficient memory access throughout LLM decoding. This is coupled with an integer-native execution pipeline that defers and overlaps type conversion outside the compute hot path, keeping the critical MatMul stages in the integer domain. Implemented on off-the-shelf mobile GPUs, BitLLM outperforms leading engines, i.e., LLAMA.CPP, MNN-LLM, LiteRT-LM, and MLC-LLM, achieving average speedups of 1.78{\texttimes}, 1.73{\texttimes}, 1.58{\texttimes}, and 1.47{\texttimes}, respectively, across various models and quantization levels. Under long-context generation, BitLLM reduces average energy consumption (per token) by up to 88.9\%.},
  keywords={large language models, quantization, mobile computing},
  doi={10.1145/3845814.3850028}
}

@inproceedings{10.1145/3845814.3850071,
  author={Liu, Yicheng and Qiao, Yifan and Xia, Tian and Xu, Yi and Hong, Tony and Zhou, Yutong and Sun, David and Yang, Shuo and Zhao, Yilong and Shu, Junyi and Xing, Jiarong and Xu, Harry and Stoica, Ion and Gonzalez, Joseph and Kumar, Sam},
  title={Breaking the Tradeoff: Elastic and Isolated GPU Sharing with GVM},
  abstract={GPUs are expensive resources but often underutilized. This inefficiency is exacerbated by the increasing diversity of AI workloads, where small or specialized models often fail to saturate high-capacity devices, necessitating GPU sharing. Existing sharing approaches force a hard tradeoff. They either partition hardware to provide strong isolation but sacrifice elasticity, or employ application-level resource sharing to provide flexibility at the expense of memory isolation or fault containment. We present GVM, an OS-level GPU virtualization layer integrated into the open-source GPU driver. GVM uses three mechanisms to break this hard tradeoff: (1) a GPU container abstraction with cgroup-like APIs for compute and memory control, (2) fine-grained per-container memory accounting and proactive swapping via GPU page tables and extended fault handlers, and (3) privileged hardware-level scheduling and preemption for dynamic compute resource management. Fully compatible with existing applications, GVM improves throughput by up to 2 times and reduces latency by up to 43 times across three representative AI pipelines. GVM is open-sourced at https://github.com/ovg-project/gvm.},
  keywords={gpu virtualization, resource isolation, memory management, scheduling, memory},
  doi={10.1145/3845814.3850071}
}

@inproceedings{10.1145/3845814.3850044,
  author={Cong, Chuanqi and Liu, Yi and Wang, Rui and Du, Zidong and Qian, Depei},
  title={ChronoShear: Breaking Loop-Carried Dependencies in RTL Simulation via Microarchitectural Oracles},
  abstract={RTL simulation is indispensable in modern hardware design for functional verification, design space exploration, and defect detection. Inter-cycle parallel simulation offers substantial potential because adjacent cycles perform highly uniform computations. The key challenge is that this approach is fundamentally hindered by the sequential nature of register updates, where the evaluation of each cycle depends on the state computed in the preceding one. Our key insight is that while the inter-cycle dependency graph of sequential logic contains numerous state-updating feedback loops, severing a small fraction of critical paths eliminates a lot of loop-carried dependencies. To exploit this, ChronoShear leverages a microarchitectural reference model that co-runs alongside the RTL simulator, providing oracles (i.e., lookahead values) for critical state variables to break these dependencies. With loop-carried dependencies resolved, the highly uniform computations across clock cycles naturally lend themselves to massive acceleration via SIMD ISA extensions (e.g., AVX-512). Furthermore, ChronoShear automatically cross-verifies the injected oracles against the RTL-computed ground truth at runtime, detecting discrepancies between the reference model and the RTL implementation. Across seven designs, ChronoShear achieves 2.1-9.6x speedup over Verilator and further improves performance when combined with existing multithreaded simulation techniques.},
  keywords={rtl simulation, microarchitectural oracles, inter-cycle parallelism, simd},
  doi={10.1145/3845814.3850044}
}

@inproceedings{10.1145/3845814.3850065,
  author={Zhao, Siyao and Mashtizadeh, Ali Jos{\'e}},
  title={Cobalt: An Open Architecture for Processor Extensibility},
  abstract={In recent years, an increasing number of devices, such as smart NICs, provide programmability to developers. However, modern processors still lack extensibility, even though processor vendors have long embraced a similar approach through microcode. We propose that processors should expose this capability to developers to promote creating novel processor features.This paper presents Cobalt, a novel open architecture that enables developers to access low level architectural features with microcode level overhead. Unlike microcode, Cobalt enables developers to write architectural extensions in high level languages such as C. We design Cobalt for the AArch64 architecture and provide our implementation in the gem5 simulator. We also build a research OS and numerous architectural extensions to demonstrate the capabilities of Cobalt.},
  keywords={processor extensibility, vertical microcode, instruction set architecture extensions, out-of-order processors},
  doi={10.1145/3845814.3850065}
}

@inproceedings{10.1145/3845814.3850069,
  author={Liu, Chenfei and Hajiabadi, Ali and Razavi, Kaveh},
  title={Compression: Impossible — Securing Hardware-Level Memory Compression},
  abstract={Transparent hardware-level memory compression has become increasingly attractive for commercial deployment, particularly in hyperscalers and cloud infrastructures. While it is well known that compression can introduce data-dependent leaks, as the compressibility of data inherently depends on its content, a common intuition is that such leaks can be mitigated using constant-time compression algorithms. Unfortunately, as we show in this paper, despite constant-time compression algorithms, all existing designs suffer from information leakage vulnerabilities due to inherently-insecure architectural design decisions. We develop several novel leakage primitives that exploit the fundamental design aspects shared across existing proposals. Relying on these leakage primitives, we show secret-dependent behaviors in widely-used cryptographic libraries and construct an end-to-end attack that leaks passwords from a popular web server. To secure memory compression against these serious vulnerabilities, we introduce a new compression non-interference property and prove that a compression system that adheres to this property does not introduce any leakage primitives. We then demonstrate that practical and secure memory compression is achievable by designing a new secure memory compression system called ZipLock. Our evaluation shows that compared to the insecure state-of-the-art baseline, ZipLock incurs only 3.5\% performance overhead while providing a similar compression rate of 1.65x.},
  keywords={hardware-level memory compression, software-transparent compression, compression non-interference},
  doi={10.1145/3845814.3850069}
}

@inproceedings{10.1145/3845814.3850048,
  author={Sun, Yitian and Xiao, Youwei and Zou, Yuyang and Yin, Chenyun and Liang, Yun},
  title={Customizing Scalable Instructions via Multi-Level E-Graph Anti-Unification},
  abstract={Modern workloads demand computational capabilities that general-purpose processors cannot efficiently provide. Extending these architectures with domain-specific instructions and hardware offers a practical solution. The open RISC-V instruction-set architecture (ISA) significantly lowers the barrier to such customization. However, existing automated customization flows face two key limitations. First, they typically operate on low-level intermediate representations, obscuring higher-level computation patterns and thereby limiting both performance and reusability. Second, they decouple instruction identification from microarchitectural design, leading to suboptimal performance under on-chip resource constraints. These issues become more pronounced as instructions scale up and reusability becomes more critical.We present ScaleISA, an end-to-end framework for customizing scalable instructions from domain applications. The major insight of ScaleISA is combining MLIR and e-graphs to identify reusable instructions at appropriate levels of abstraction and performing joint microarchitectural exploration. It introduces a dialect-agnostic encoding that brings MLIR into e-graphs. Its core methodology, multi-level instruction identification (MLII), applies microarchitectural transformations through e-graph rewrites, and then leverages multi-level e-graph anti-unification (MLAU) to identify reusable instruction candidates together with their microarchitectural implementations in a single unified search space. Final budget-aware e-graph extraction jointly chooses custom instructions and their microarchitectures. Evaluation shows that aleisa achieves an average 1.42x (up to 2.87x) speedup over the best baselines by performing multi-level instruction identification.},
  keywords={custom instruction, asip, e-graph, hardware-software co-design, compiler},
  doi={10.1145/3845814.3850048}
}

@inproceedings{10.1145/3845814.3850035,
  author={Das, Subhrajit and Bichhawat, Abhishek and Patel, Yuvraj},
  title={DigitsOnTurbo: Leveraging SIMD for Accelerating Large-number Arithmetic},
  abstract={Large-number arithmetic, widely used in scientific computing and cryptography, has seen limited adoption of single instruction, multiple data (SIMD) parallelism on modern CPUs due to the inherent dependencies in traditional algorithms. We present DigitsOnTurbo (DoT), which restructures the computation around independent, data-parallel operations, rather than vectorizing the standard algorithms, thereby leveraging the benefits provided by SIMD. Over prior SIMD implementations, DoT achieves up to 1.85{\texttimes} speedups for addition and subtraction, and 2.3{\texttimes} for multiplication. When integrated into state-of-the-art libraries (e.g., GMP, OpenSSL), DoT yields up to 4{\texttimes} speedup for addition and subtraction, and up to 2{\texttimes} speedup for multiplication, cascading into end-to-end throughput gains of up to 15.8\% for scientific computations, and up to 5.6\% latency and 6.2\% throughput improvements on cryptographic implementations.},
  keywords={multi-precision arithmetic, algorithm restructuring, simd, avx-512, carry propagation, vertical and crosswise multiplication},
  doi={10.1145/3845814.3850035}
}

@inproceedings{10.1145/3845814.3850046,
  author={Lin, Shouxu and Guo, Zhiyuan and Lin, Jiaxin},
  title={Direct-Access-Enabled GPU Memory Offloading with Optimal Efficiency for LLM Inference},
  abstract={LLM inference is constrained by GPU memory capacity and bandwidth. Tiered memory architectures mitigate this by allowing the GPU to offload memory to the remote tier. However, existing memory offloading frameworks rely on prefetching data into local GPU HBM. This approach underutilizes system resources by introducing HBM contention, squandering memory capacity, and creating pipeline bubbles. We show that enabling direct GPU access to remote memory significantly outperforms prefetching, achieving optimal aggregate system bandwidth. We propose SplitKernel, an end-to-end direct-access memory offloading framework that uses the Tensor Memory Accelerator (TMA) to asynchronously fetch offloaded weights and KV caches directly from remote memory into GPU shared memory (SMEM). To maximize remote access performance, SplitKernel introduces a greedy algorithm to determine optimal per-operation offloading ratios, alongside active congestion control and TMA multicast to eliminate interconnect bottlenecks and read amplification. Evaluations across diverse architectures show that SplitKernel achieves near-optimal bandwidth aggregation, with up to 7.7{\texttimes} performance gains on NVLink-C2C and 2.3{\texttimes} on PCIe systems compared to state-of-the-art memory offloading baselines.},
  keywords={large language models, gpu interconnects, memory offloading},
  doi={10.1145/3845814.3850046}
}

@inproceedings{10.1145/3845814.3850067,
  author={Wang, Yi-Chieh and He, Congjie and Xiao, Haocheng and Grot, Boris and Mai, Luo},
  title={DLR: Efficient Defect-Tolerant Routing at Wafer Scale},
  abstract={Wafer-scale integration enables unprecedented compute density on a single chip, affording nearly a million processing elements (PEs) in a mesh-connected topology. However, wafer-scale meshes must tolerate inevitable manufacturing defects. Existing industrial practice for wafer-scale relies on holding healthy PEs back. Repair mechanisms either substitute spares through redundant links or disable entire rows and columns, costing tens of thousands of PEs in production. Prior fault-tolerant (FT) routing schemes fall short at wafer-scale by requiring prohibitively large per-router state or many sets of virtual channels, or require disabling healthy PEs to enforce regular fault shapes.  We observe that under realistic defect densities, although the chip contains nearly a million PEs, only several dozen are expected to be faulty, leaving the mesh almost entirely intact. This suggests that fault tolerance should not be imposed uniformly across the whole wafer, but instead only where faults actually disrupt regularity. Motivated by this insight, we present Defect-driven Locality-preserving Routing (DLR), a fault-tolerant routing scheme that decomposes the defective wafer mesh into regular, defect-free submeshes and applies standard low-cost routing within each submesh. Routing across submeshes (i.e., across fault boundaries) is done over a virtual spanning tree. This hierarchical structure preserves deadlock freedom with only two sets of virtual channels (VCs), just one more than the fault-free baseline. DLR achieves 100\% utilization of healthy PEs, low per-router storage and hardware overhead, competitive path lengths, and low offline algorithmic complexity; none of the prior techniques manage to achieve all of these requirements.},
  keywords={wafer-scale computing, fault-tolerant routing, network-on-chip, deadlock freedom, manufacturing defects},
  doi={10.1145/3845814.3850067}
}

@inproceedings{10.1145/3845814.3850047,
  author={Agliamzanov, Ramil and Tuck, James},
  title={DNACache: Dynamic Management of Read Depletion and Resynthesis in DNA Storage},
  abstract={DNA-based Archival Storage is a compelling future storage technology due to its longevity and density. However, current approaches for reading DNA are destructive, and Polymerase Chain Reaction (PCR), a technique that can copy DNA cheaply, introduces significant skew and errors raising questions of long-term data integrity. Hence, DNA would need to be resynthesized periodically to retain integrity. Furthermore, random access accelerates this process.We propose a new organization for DNA storage systems to overcome these challenges that uses DNACache: a molecular cache of DNA molecules. First, DNACache provides an architectural abstraction: reading from the cache means that permanent, high-fidelity DNA molecules are not destroyed on a read hit, only the copies held in the cache are removed and sequenced. This preserves the archive and delays resynthesis. Second, it uses PCR to cheaply acquire molecules for the cache during random access. Creating copies of DNA using PCR is cheaper and faster than synthesizing new, unique DNA strands, allowing the cache to be populated quickly and affordably. Since the cache is not permanent storage and is only used to provide reads in a best-effort manner, the errors introduced by PCR during copying are not incorporated into permanent storage, ensuring long term data integrity. Third, DNACache adapts to the dynamic properties of a workload rather than making many copies in advance.},
  keywords={archival storage, dna-based archival storage, cache, synthesis, pcr},
  doi={10.1145/3845814.3850047}
}

@inproceedings{10.1145/3845814.3850072,
  author={Long, Yuhai and Wei, Yuanxin and Wu, Kai and Wei, Jinhui and Huang, Dan and Du, Jiangsu},
  title={EdgeAgent: Orchestrating On-Device LLM inference for End-User Multi-Agent Systems on CPU-GPU Unified Memory Architectures},
  abstract={Emerging multi-agent LLMs demand privacy-preserving edge deployment, yet current inference systems struggle with these collaborative workflows. Specifically, the memory-bound decode phase causes severe bus contention on unified memory architectures (UMA), paralyzing naive CPU-GPU co-execution. Furthermore, speculative decoding in multi-agent workloads faces extreme variance in drafting difficulty, alternating between complex reasoning and predictable structured generation. Compounded by frequent tool-induced stalls, this highly fragmented execution severely underutilizes hardware and defeats traditional static batching. We present EdgeAgent, a cross-layer inference system explicitly co-designed for edge UMA and multi-agent workloads. At the micro-architectural level, it bypasses rigid graph-compiler constraints to enable zero-copy UMA-aware tensor parallelism, utilizing asymmetric memory layouts to fully saturate both CPU and GPU compute units. At the scheduling level, it dynamically allocates draft budgets based on real-time sequence predictability to bound bandwidth waste. Concurrently, an asynchronous suspend-and-yield mechanism actively evicts stalled agents, ensuring continuous hardware saturation during unpredictable tool invocations. Extensive evaluations on an Apple M4 SoC demonstrate that the UMA-aware execution alone contributes a 1.29{\texttimes} speedup over batched speculative decoding. Adding the agent-aware scheduling lifts the full EdgeAgent system to a 1.77{\texttimes} speedup under extreme tool-use latencies.},
  keywords={on-device llm inference, multi-agent systems, unified memory architectures, speculative decoding},
  doi={10.1145/3845814.3850072}
}

@inproceedings{10.1145/3845814.3850080,
  author={Xia, Tianhua and Wang, Haiyu and Yu, Fengze and Lin, Jieyu and Li, Ziyun and De Salvo, Barbara and Zhang, Sai Qian},
  title={EDIVA: Exploiting Human Behavioral Patterns for Differential Egocentric Video Processing in AR},
  abstract={Augmented reality (AR) systems increasingly rely on real-time image segmentation to interpret continuous egocentric video streams and enable immersive, intention-aware interactions. However, executing neural segmentation models on every high-resolution frame introduces significant computational overhead and latency, exceeding the real-time constraints of AR devices. This paper presents EDIVA, an algorithm–hardware co-optimization framework for differential egocentric video processing that exploits temporal redundancy and multimodal sensory cues in AR environments. EDIVA uses gaze, pose, and inertial signals to infer user intent and reproject previous segmentation masks via perspective transformation, updating only regions with significant visual changes. A lightweight mask refinement module corrects residual distortions to maintain segmentation fidelity. We further design a dedicated EDIVA accelerator that integrates with the AR system-on-chip (SoC), enabling efficient cache management, mask reprojection, and reuse detection. Evaluations on representative AR workloads show that EDIVA reduces segmentation latency by 2.67{\texttimes} and energy consumption by 3.65{\texttimes} while preserving accuracy and temporal consistency, achieving real-time performance on edge AR hardware. Code is available at https://doi.org/10.5281/zenodo.23225199.},
  keywords={video segmentation, hardware accelerator, augmented reality},
  doi={10.1145/3845814.3850080}
}

@inproceedings{10.1145/3845814.3850082,
  author={Avalos Baddouh, Cesar and Payer, Mathias and Rogers, Timothy G.},
  title={EoSS: Exploring SASS - A Systematic Framework to Explore NVIDIA's ISA},
  abstract={NVIDIA GPUs are ubiquitous in AI, HPC, and graphics, yet their native SASS instruction set remains undocumented. No public infrastructure exists to answer fundamental questions: which instructions exist on a given architecture, what encodings the hardware accepts, and how instructions behave at the microarchitectural level. Each research effort must rediscover encoding formats, build ad hoc tooling, and reverse-engineer instruction semantics from scratch.We present EoSS, an end-to-end framework for systematic SASS exploration. EoSS extracts machine-readable instruction specifications from data embedded in NVIDIA tooling, generates valid instruction encodings, and executes them on real hardware through binary patching. The framework produces complete toolchains, kernel templates, operand setup, and measurement harnesses that turn opaque SASS into a workable experimental interface. We release validated instruction sets for seven architectures spanning Volta through Blackwell, with 539-1,338 runtime-valid instruction classes per target.Our infrastructure supports diverse research tasks: reverse-engineering and executing exotic ray-tracing instructions, performing extensive timing characterization across execution pipelines, measuring contention-based timing effects on resources unreachable through PTX, and systematically probing undocumented special registers. EoSS provides the missing foundation for GPU ISA research, making native SASS exploration routine and reproducible for compiler optimization, performance modeling, and security analysis on modern GPUs.},
  keywords={gpu architecture, nvidia sass, instruction set architecture, reverse engineering, binary rewriting, microbenchmarking, instruction fuzzing, rt cores, raytracing},
  doi={10.1145/3845814.3850082}
}

@inproceedings{10.1145/3845814.3850084,
  author={Zhang, Mingfei and Wu, Anbang and Pang, Pu and Lu, Liqiang and Wang, Zongwu and Liu, Fangxin and Liu, Zihan and Feng, Yu and Leng, Jingwen and Guo, Minyi},
  title={Erasynth: Improving Quantum Uncomputation with Structural Measurements},
  abstract={In quantum computing, safely clearing temporary ancilla qubits, a process known as uncomputation, is essential to prevent irreversible computational errors caused by entanglement. The typical uncomputation process removes entanglement by reversing gates used to correlate ancilla and (program) data, potentially doubling circuit depth and gate counts. The alternative approach introduces measurements to directly reset ancilla to the ground state and has the potential of reducing uncomputation overhead. Unfortunately, existing measurement-based methods may need to correct the minus sign of exponentially many quantum state terms due to measurement uncertainty, instead incurring larger gate overhead. Our insight to further reduce the uncomputation overhead is to integrate the idea of both methods. To some extent, the unitary-based method is highly structural, reflecting the circuit's computation-uncomputation symmetry, while the measurement-based method introduces randomness due to the uncertainty of the involved qubit set and the resulting phase corrections. Either being too structural or too random introduces high overhead for uncomputation. This work improves existing methods by incorporating structural circuit analysis to suppress the randomness of measurements. This work proposes Erasynth, which analyzes the circuit context and identifies the best timing of applying measurements to release ancilla; unveils the optimal strategy to release ancilla according to the dimension of involved quantum data subspace; prunes and only corrects the key data subspace suffering from measurement-induced phase flip. Experimental evaluations show that Erasynth reduces CX gates by up to 37.48\%/97.56\% and T gates by up to 50.0\%/98.54\% over the unitary-based/measurement-based baseline, while also reducing circuit depth by up to 75.62\%/98.89\%.},
  keywords={quantum uncomputation, structural measurements, quantum circuit optimization, quantum compilation},
  doi={10.1145/3845814.3850084}
}

@inproceedings{10.1145/3845814.3850032,
  author={Chen, Qi and Chen, Guanyi and Zhang, Jian},
  title={FaultMesh: Characterizing and Taming GPU UVM Page Faults},
  abstract={Modern GPUs are increasingly used for data-intensive workloads such as scientific computing, graph analytics, and LLM training and inference, but their limited memory capacity makes oversubscription unavoidable (i.e., application memory demand exceeding available GPU memory). GPU Unified Virtual Memory (UVM) supports transparently migrating pages between CPU and GPU memory on demand. However, the page fault handling overhead remains a major bottleneck. To amortize fault-handling overhead, UVM groups multiple GPU fault records and processes them together as a fault batch. We characterize UVM fault handling in two dimensions: fault batch effectiveness, which means how many useful faults are contained in each batch, and fault handling effectiveness, which means how efficiently the CPU services those faults. We find that existing UVM fault batches often contain many redundant entries, including duplicate and stale faults. We further propose fault locality, which describes how concentrated the faults in a batch are, as another key factor that affects fault handling effectiveness: when faults are scattered across many virtual address blocks, this leads to low fault locality and degrades fault handling effectiveness. In addition, we observe a severe GPU–CPU parallelism mismatch: thousands of GPU threads can generate page faults concurrently, but existing UVM designs largely process them using a single CPU worker thread. We present FaultMesh, a cross-layer UVM page fault handling engine that improves both fault batch effectiveness and fault handling effectiveness. On the GPU side, FaultMesh reduces duplicate and stale faults before they enter the fault buffer. Furthermore, it clusters and dispatches memory accesses by virtual address block to improve fault locality. On the CPU side, FaultMesh continues filtering stale faults and parallelizes fault handling across multiple CPU cores. We show that FaultMesh improves microbenchmark and GPGPU application performance by up to 2.8{\texttimes} and 3.3{\texttimes}, respectively, while accelerating real-world applications including ANN search by 1.63{\texttimes} and Llama 70B by 1.23{\texttimes}.},
  keywords={gpu unified virtual memory, gpu page fault, memory oversubscription, heterogeneous memory},
  doi={10.1145/3845814.3850032}
}

@inproceedings{10.1145/3845814.3850066,
  author={Wong, Wai Kin and Xiao, Dongwei and Ke, Ping Fan and Zhang, Fengwei and Wang, Shuai},
  title={Finding Performance Regressions in GPU Compilers},
  abstract={Graphics Processing Units (GPUs) accelerate many modern computationally intensive workloads, and achieving high performance on them depends heavily on sophisticated GPU compiler optimizations. However, even small changes in GPU compiler optimization heuristics or code-generation decisions can silently introduce severe performance regressions without causing crashes or wrong outputs.These regressions are notoriously difficult to detect with existing approaches. Functional test suites and existing GPU compiler fuzzers primarily target correctness bugs, while benchmark suites lack the scale and diversity needed to systematically expose optimization failures.To address this, we present GPUDiff, an automated testing framework for finding performance bugs in GPU compilers. GPUDiff is grounded in the observation that GPU compiler optimizations are fundamentally shaped by the underlying GPU architecture. Guided by this principle, GPUDiff generates performance-centric program variants using architecture-informed mutations that stress three key dimensions of GPU execution: computation, memory hierarchy, and thread divergence. To address the testing oracle problem, GPUDiff uses differential testing, comparing each mutated program's performance across different compiler versions. Over three months, GPUDiff uncovered 20 issues in NVIDIA and AMD compilers. The median regression increases kernel execution time by 37\%.},
  keywords={gpu compilers, performance testing, differential oracles, compiler optimization quality},
  doi={10.1145/3845814.3850066}
}

@inproceedings{10.1145/3845814.3850034,
  author={Anzai, Shu and Liu, Shi and Yu, Shan and Qiao, Yifan and Wang, Yichen and Vij, Deepak and Ding, Xiaoning and Wang, Chenxi and Kumar, Sam and Shu, Junyi and Xu, Harry},
  title={Firework: Efficient and Transparent DSM with Hardware-Coherent CXL Shared Memory},
  abstract={Multi-threading offers the most straightforward path to accelerating applications with extra resources, but extending this capability beyond a single physical server remains difficult— it typically demands significant rewrites of application logic and reliance on specialized systems tailored to particular distributed workloads. This paper introduces Firework, a DSM system co-designed across the runtime and OS kernel that transparently and dynamically manages page placement between local DRAM and hardware-coherent CXL memory, enabling unmodified multi-threaded C/C++ applications to execute across multiple servers. A central challenge lies in supporting both transparency and efficiency. For transparency, Firework maintains a partitioned global address space and coordinates page-level sharing and migration across servers without application-level annotations. For efficiency, Firework dynamically shares pages on demand and unshares them as access patterns change, minimizing the footprint of the coherent shared-memory region. Extensive evaluation across a diverse suite of applications demonstrates up to 10.1{\texttimes} performance gain against a shared-heap baseline and promising scalability results.},
  keywords={cxl, distributed shared memory, memory disaggregation},
  doi={10.1145/3845814.3850034}
}

@inproceedings{10.1145/3845814.3850073,
  author={Kalani, Neelu S. and Castes, Charly and Chen, Guokai and Doukhan, Alexandre and Bucher, Daniel and Bourgeat, Thomas and Bugnion, Edouard},
  title={Flashpoint: Privileged-Software Isolation on RISC-V for Dynamic Root of Trust},
  abstract={Bugs in the large platform firmware executing in the highest privilege mode put the entire system's security at risk.We present a solution to isolate software in the highest privilege mode on RISC-V. Our solution is a hardware-software co-design comprising a minimal ISA extension and a thin mediating software. Our solution enables remotely attestable dynamic root of trust for a trusted security monitor and removes boot-time firmware, which can execute arbitrary code in the highest privilege mode, from the TCB.We extend the open-source XiangShan processor with our ISA extension, incurring negligible hardware overhead (0.039\%). We simulate the full software stack on an FPGA, which shows negligible boot-time overhead (0.008\% more instructions, 0.006\% more cycles) to enable dynamic root of trust. We demonstrate the end-to-end dynamic root of trust with a TPM emulator on QEMU. We use exhaustive model checking to verify correct isolation enforcement in the highest privilege mode, thanks to the system's finiteness. To this end, we formally specify our ISA extension in Sail, translate the CPU model to Rust (using an existing compiler), and verify it alongside our Rust-based mediating software with the Kani model checker. Finally, we demonstrate our solution's generality with a case study that isolates a security monitor from the run-time platform firmware.},
  keywords={risc-v, dynamic root of trust, remote attestation, hardware-software co-design, model checking},
  doi={10.1145/3845814.3850073}
}

@inproceedings{10.1145/3845814.3850076,
  author={Augoustis, Theofilos and Reimers, Sebastian and Krinitsin, Christian and Gouicem, Redha and Sprokholt, Dennis and Bhatotia, Pramod},
  title={Focaccia: Semantic Validation for CPU Emulators},
  abstract={CPU emulators are widely used to execute programs across different ISAs, but their implementation complexity makes them prone to mistranslation errors, where guest instructions are incorrectly translated to the host. These errors subtly corrupt program state or control flow, yet often surface only much later in execution, making them difficult to detect and localize with existing validation methods. We propose Focaccia, our novel semantic validation system that automatically detects, localizes and reproduces mistranslation errors in unmodified CPU emulators. Focaccia bridges formal methods with systems by defining a formal model of emulation correctness based on state transition systems and building a translation validator around that model. To validate an emulator, Focaccia compares emulated behavior against native semantics captured through speculative concolic tracing, while cross-ISA record-replay handles OS-level non-determinism. We evaluate Focaccia on QEMU and Box64 across multiple ISAs, detecting and localizing 17 known mistranslation errors across six different bug categories, all of which escape existing emulator test suites. Focaccia further identified eight previously unknown mistranslations, all subsequently confirmed and fixed. Focaccia scales to full applications, including SQLite, Curl and the Lua interpreter, tracing and validating a 99,000-instruction SQLite execution in approximately 5 minutes. Generated reproducers reduce program size by up to 99\%, isolating errors to single basic blocks.},
  keywords={cpu emulation, translation validation, symbolic execution, deterministic replay, bug reproduction},
  doi={10.1145/3845814.3850076}
}

@inproceedings{10.1145/3845814.3850033,
  author={Moon, Chanyoung and Pence, Travis and Yamada, Daisuke and Mo, Jiaqi and Zhang, Yanxin and Singh, Vikas and Sankaralingam, Karthikeyan},
  title={FORGE: Procedural Weight Generation for Sparse MoE Inference},
  abstract={We introduce FORGE (Fast On-chip Rotor Generation for Experts), a procedural weight generation system for Sparse Mixture-of-Experts (MoE) inference. Rather than storing and loading every expert weight tensor from HBM, we show how a compact accelerator inside each Streaming Multiprocessor can regenerate them on-the-fly from O(log2 d) rotor parameters per projection. Per replaced layer, gigabytes of stored expert weights are approximated with under a megabyte of seeds. This addresses the dual memory bottleneck of autoregressive Sparse MoE decode, where per-expert FFN operations are HBM-bandwidth-bound at small routed-token counts and the aggregate expert footprint forces multi-node Expert Parallelism (EP) with all-to-all traffic. We realize the approach as the Rotor Generation Unit (RGU), a fixed-function datapath that generates FFN weight tiles without competing with Tensor Core execution. With 30\% of the MoE FFN layers replaced across five Sparse MoE models, we estimate 1.3-2.8x higher system throughput at matched GPU count and 1.10-1.15x lower per-user decode latency at short context. In exchange, downstream accuracy on three model families falls below that of the same model fine-tuned without rotor replacement, and the replacement ratio controls this tradeoff. FORGE also expands KV cache capacity by 1.2-2.6x. It is agnostic to the bit width at which weights are stored, so it can compose with quantization. The RGU is fully implemented/verified in SystemVerilog at ~0.9\% SM area overhead (0.032 mm2/SM, 7nm).},
  keywords={mixture of experts, llm inference, procedural weight generation, gpu architecture, hardware accelerators},
  doi={10.1145/3845814.3850033}
}

@inproceedings{10.1145/3845814.3850055,
  author={Kapoor, Hastin and Bagchi, Soham and Zhang, An Qi and Chakraborty, Soham and Elver, Marco and Goens, Andr{\'e}s and Sarkar, Susmit and Stutsman, Ryan and Nagarajan, Vijay},
  title={Formalizing the User-Kernel Shared-Memory Boundary: The C/LKMM Compound Model},
  abstract={The boundary between an operating-system kernel and its user-space applications has moved into shared memory. Zero-copy interfaces such as io_uring and BPF arenas place shared memory directly between code that obeys the C memory model and code that obeys the Linux Kernel Memory Model (LKMM). No formal model spans this boundary, and the two underlying models are structurally different. C builds happens-before from explicit release-acquire pairs, while the LKMM builds it from preserved program order. We present the C/LKMM compound memory model, the first formal memory model specification of the user-kernel boundary. The compound model takes the LKMM as its structural basis and bridges it with C through two ideas: a synchronize-threads relation that parameterizes synchronization strength by the language of the operations involved, and fence context sharing, which lets a single LKMM fence context participate in multiple synchronizations without leaving its native context. We prove three correctness properties: pure-C programs retain their C semantics, pure-Linux programs retain their LKMM semantics, and shared synchronization primitives are interchangeable across the boundary-and complement them with systematic litmus-test validation. Using the model as a guide, we develop a family of lock-free data structures shared between user-space C and eBPF kernel code over BPF arenas. Finally, we identify and fix a real cross-boundary memory ordering bug in the Linux kernel's kcov subsystem; both halves of the fix have been accepted upstream.},
  keywords={memory consistency models, lkmm, compound memory model, ebpf},
  doi={10.1145/3845814.3850055}
}

@inproceedings{10.1145/3845814.3850060,
  author={Sun, Hao and Li, Zenan and Li, Cong and Su, Zhendong},
  title={From Specification to Kernel Commit: Verified Code Generation on Real-World Systems},
  abstract={Verified code generation, in which an LLM produces both an implementation and a correctness proof, offers a promising path toward correct-by-construction software. Prior evaluations report that LLM capability remains unsatisfactory, but they test models in a bare-model setting that no longer reflects how LLMs are deployed in practice, e.g., as coding agents. We re-evaluate existing benchmarks and find that coding agents solve nearly all tasks derived from well-studied sources such as programming contests.This raises the question of whether such success extends to real-world systems tasks. We present Vero, a benchmark of 103 verified code generation tasks drawn from three security- and correctness-critical projects: the Linux kernel eBPF verifier, the LLVM compiler, and the seL4 microkernel. Each task is real-world, encodes a new specification, and is valuable to solve in that a correct solution directly benefits the upstream project. We evaluate three coding agents; the strongest solves only 3 of the 103 tasks, establishing that real-world verified code generation remains an open problem. Notably, one agent-discovered solution to a Vero task has been merged into the Linux kernel, replacing a 20-line algorithm proposed by domain experts with a 4-line provably correct one. The unsolved tasks provide concrete targets for future work.},
  keywords={verified code generation, llm agents},
  doi={10.1145/3845814.3850060}
}

@inproceedings{10.1145/3845814.3850052,
  author={Zhu, Shuntao and Lu, Rui and Zhang, Hengjia and Zhang, Jiahao and Wang, Dan},
  title={GiTT: Forecasting the GPU Thermal Profiles in AI Datacenters with Immersion Cooling Systems},
  abstract={Today's GPUs generate a significant amount of heat and have a great probability of experiencing high temperatures. This has motivated thermal-aware scheduling systems to control operating temperature at the system level. These schedulers need a thermal model to forecast GPU temperature. Existing models have two limitations: (1) the cooling system (i.e., heat dissipation) models are largely simplified due to the challenges in interdisciplinary modeling, and (2) current models are commonly developed for specific tasks, e.g., LLM inference, and have difficulty scaling across different AI tasks.In this paper, we develop a new thermal forecasting system, GiTT, for AI datacenters in immersion cooling systems. The core of GiTT is a machine learning model and the key challenge is data-efficient learning. Specifically, for heat dissipation, we develop a physics-informed neural network (PINN) based approach where we capture the unique phase-change processes of immersion cooling systems by integrating appropriate physical models to balance data complexity and accuracy. For heat generation, we leverage existing observations where the AI workloads can be decomposed into kernel functions and develop feature engineering schemes to allow the learning to be generic across different AI tasks.Our evaluation shows that GiTT has an RMSE of 1.63°C, while existing approaches can be 4.52 °C and 8.73°C. The RMSE of GiTT in a succinct dataset and a comprehensive dataset (with 100 times more data) is comparable, i.e., 1.62°C and 1.24°C. Without our data-efficient learning schemes, however, the RMSE of GiTT increases to 4.47°C.},
  keywords={immersion cooling, thermal control, ai datacenter, gpu thermal profiles},
  doi={10.1145/3845814.3850052}
}

@inproceedings{10.1145/3845814.3850053,
  author={Yang, Hongbin and Zhang, Huanle and Pan, Runyu},
  title={Hardware Support for Deterministic User-Level Interrupts in Real-Time Embedded Systems},
  abstract={Modern real-time embedded systems demand strong component isolation for safety and security. Normally, interrupts are handled in kernel mode before they are passed on to the application, which induces high latency if isolated components need to react to external events. Thus, hardware-assisted, low-latency user-level interrupts are highly desirable. Nevertheless, existing hardware mechanisms only optimize average-case performance while neglecting worst-case latency for sensitive applications including autonomous vehicles and robots. To overcome this limitation, we propose a novel open-source hardware extension that integrates spatial isolation setup, execution budget management, cross-domain nesting, and accelerated context switching for user-level interrupts with tight latency. It enables direct, deterministic delivery upon user-level interrupt arrival-without kernel intervention-even when the target process is dormant. Across the entire design space, the best-performing design reduces worst-case latency by over 50{\texttimes}, while the lowest-overhead design incurs only a 23\% increase in core area (2\% of total die area) and a 3\% increase in dynamic power. To the best of our knowledge, this is the first integrated mechanism to guarantee multi-tenant user-level interrupt delivery with a nanosecond-scale yet bounded worst-case latency. It provides a holistic solution for developing secure, dependable, and low-latency cyber-physical systems in real-time consolidation scenarios.},
  keywords={user-level interrupts, latency, jitter, real-time systems, security, safety, isolation, risc-v},
  doi={10.1145/3845814.3850053}
}

@inproceedings{10.1145/3845814.3850068,
  author={Zalman, David and Kafman-Raz, Nizan and Daube, Omer and Amit, Nadav},
  title={How to Move an Immovable Page},
  abstract={I/O devices require fixed physical addresses for the memory they access, forcing the OS to pin pages in place. This locks out memory management operations that depend on page migration—NUMA rebalancing, defragmentation, memory tiering, and hardware error recovery. The problem is acute for device-assigned virtual machines, where the entire guest address space (tens to hundreds of gigabytes) remains pinned for the VM's lifetime. Existing alternatives demand I/O page-fault support that most devices lack, or add per-I/O overhead incompatible with persistently mapped buffers. We present virtual pinning, a migration protocol that keeps device mappings permanently valid while safely relocating the underlying physical page. Virtual pinning atomically redirects each virtual-to-physical translation to the new location, using hardware ordering guarantees to detect concurrent writes and ensure no update is lost. We implement virtual pinning in the Linux kernel and evaluate it on device-assigned VMs running PostgreSQL and on bare-metal RDMA. Virtual pinning can reduce query latency by 16\% and RDMA latency by 29\% through NUMA-aware migration of pinned pages, and restores huge page availability that pinning previously destroyed—all impossible with standard pinning on existing hardware.},
  keywords={page migration, pinned memory, iommu, dma, rdma, virtualization, device passthrough},
  doi={10.1145/3845814.3850068}
}

@inproceedings{10.1145/3845814.3850042,
  author={Lee, Hyunsei and Park, Sehyeon and Gwak, Jaewoo and Jang, Shinhyoung and Lee, Junyoung and Kim, Yeseong},
  title={HVKV: Scalable Long-Context Inference through Hypervector KV Cache Retrieval},
  abstract={Long-context inference is increasingly bottlenecked by the KV cache rather than the model weights. CPU offloading can extend capacity, but transferring the full KV cache at each decode step turns memory pressure into a bandwidth bottleneck. We present HVKV, a KV-cache retrieval framework based on compact yet effective binary key representations. HVKV keeps these compact binary keys on the GPU for Hamming-distance indexing and offloads the full-precision KV cache to CPU memory, fetching only the selected KV pairs to compute attention over the retrieved top-k subset. This design confines approximation to candidate selection, reducing the cost and memory footprint of index-based retrieval, while preserving full-precision attention. To make this efficient in practice, HVKV combines an incremental Hamming-distance update that reuses distance state across adjacent decode steps with a dual GPU cache for retrieved KV pairs. HVKV matches Full Attention at a 1\% token budget while outperforming the strongest compared baseline at similar budgets by 35.0\% in average score, and reduces per-token decode latency by up to 32.8\% at 1M context.},
  keywords={long-context inference, kv cache, sparse attention},
  doi={10.1145/3845814.3850042}
}

@inproceedings{10.1145/3845814.3850027,
  author={Yu, Liukun and Qiang, Xinwei and Sun, Shixuan and Chen, Chen and Leng, Jingwen and Dong, Jin},
  title={Impeller: Scalable and Efficient Zero-Knowledge Proof Computation Framework via Graph Compilation},
  abstract={Zero-knowledge proofs (ZKPs) have become a cornerstone for privacy-preserving applications, yet the computational cost of proof generation remains a primary bottleneck. To improve proof generation, we present Impeller, a compiler-driven framework that transforms high-level ZKP algorithm specifications into efficient execution plans for heterogeneous CPU-GPU systems. Rather than treating the GPU as a stateless accelerator for isolated kernels as previous efforts do, Impeller models the entire proving process as a global computation graph. We introduce several key techniques, including aggressive arithmetic subgraph fusion, iterative chunked execution to handle memory-intensive operators, and a static hierarchical memory planner that orchestrates data placement across GPU, CPU, and NVMe storage. Experimental evaluations across a range of benchmark circuits demonstrate that Impeller achieves speedups ranging from 5.9{\texttimes} to 99{\texttimes} over the reference implementation, while being 6.9{\texttimes} to 12.2{\texttimes} faster on production-scale real-world applications.},
  keywords={graph compilation and optimization, zero-knowledge proofs, parallel computing},
  doi={10.1145/3845814.3850027}
}

@inproceedings{10.1145/3845814.3850050,
  author={Yuan, Yichao and Chowdhury, Mosharaf and Talati, Nishil},
  title={KAIROS: Stateful, Context-Aware Power-Efficient Agentic Inference Serving},
  abstract={Power has become a central bottleneck for AI inference. This problem is becoming more urgent as agentic AI emerges as a major workload class, yet prior power-management techniques focus almost entirely on single-turn LLM serving. Our analysis shows that agentic serving behaves fundamentally differently: each request carries long-lived context that evolves across tool-interleaved turns, and lowering GPU frequency can push the system into a thrashing regime where memory pressure sharply worsens both performance and power efficiency. These observations show that power optimization for agentic serving requires rethinking.We present KAIROS, a context-aware power optimization system for agentic AI serving. KAIROS uses agent context as a first-class control signal to jointly manage GPU frequency, per-instance concurrency, and multi-instance request placement. This enables KAIROS to save power when memory headroom exists while avoiding thrashing and preserving performance targets. At a high level, KAIROS tracks requests at agent granularity, adapts local control to context growth and agent progress, and routes agents across instances to jointly improve power efficiency and memory stability. Evaluated across diverse software and data engineering agentic tasks, KAIROS achieves an average of 27\% (up to 39.8\%) power reduction while meeting the performance targets.},
  keywords={agentic ai, llm inference serving, power efficiency, dvfs, gpu frequency scaling, kv cache management},
  doi={10.1145/3845814.3850050}
}

@inproceedings{10.1145/3845814.3850038,
  author={Scholtz, Timothy and Hicks, Matthew},
  title={Leveraging Software Analysis for Better Bespoke Processor Generation},
  abstract={Bespoke processors occupy a middle ground between general-purpose processors and ASICs. General-purpose processors must support all possible software, yet any single application exercises only a fraction of their logic. ASICs sit at the other extreme, hardware tailored to one application with no unnecessary logic. One approach wastes resources at runtime while the other wastes human design effort. Bespoke processors bridge this gap through an automated trimming of unused logic from an existing design, saving power, area, and expense while maintaining functional equivalence. This middle ground is particularly appealing in embedded domains, where power and cost are primary design constraints. Current bespoke processor generation techniques face significant hurdles: they require processor-specific tooling and sacrifice effectiveness to mitigate path explosion.While prior work treats bespoke processor generation as a wholly-hardware concern, we view it as a software analysis problem. We present ReCast, a software-oriented bespoke processor generation system. In contrast to previous hardware-oriented approaches that require custom hardware tooling, ReCast leverages mature, reusable software analysis tools and unmodified hardware simulators to create bespoke processors for arbitrary in-order RTL processors without asynchronous events. ReCast decomposes the generation problem into two regimes based on software complexity: a precise semantic approach for software with tractable path spaces and a conservative syntactic approach for intractable software. We also introduce a fuzzing-based lower bound to quantify bespoke generation quality. Our evaluation across 4 processor cores and 20 software benchmarks shows area and power reductions within 10\% of our fuzzing-based lower bound (roughly a 50\% reduction).},
  keywords={ultra-low-power processors, application-specific processors, bespoke processors, hardware-software co-analysis},
  doi={10.1145/3845814.3850038}
}

@inproceedings{10.1145/3845814.3850088,
  author={Zhong, Runxin and Chen, Yumo and Jin, Yuyang and Zheng, Size and Zhang, Qihao and Lei, Kinman and Zhai, Jidong},
  title={LinAC: Exposing Reduction Parallelism in Linear Attention through Affine Composition},
  abstract={Linear attention replaces softmax attention with recurrent state updates, reducing time and memory complexity to linear in sequence length. However, the resulting sequential dependence along the sequence dimension severely limits GPU utilization. To address this, our key insight is that the composition of affine functions remains affine, enabling a bottom-up dataflow analysis that transforms general linear attention recurrences into an associative form, unlocking additional reduction parallelism. We realize this insight in LinAC, a compilation-based optimization system that automatically extracts and exploits reduction parallelism from linear attention recurrences. LinAC introduces a second-order array combinator-based abstraction that uniformly represents linear attention recurrences, and applies dataflow analysis to canonicalize them into associative form. On top of this, LinAC further turns the exposed parallelism into efficient GPU execution while controlling the resulting memory overhead. Evaluated on H100 GPUs with typical linear attention models, LinAC accelerates attention modules by 2.06{\texttimes} and end-to-end inference by 1.24{\texttimes} on average over state-of-the-art works.},
  keywords={linear attention, compiler optimization, reduction parallelism, associative scan, gpu kernel generation, domain-specific language},
  doi={10.1145/3845814.3850088}
}

@inproceedings{10.1145/3845814.3850030,
  author={Wang, Meng and Nair, Prashant J.},
  title={MagicFlow: Breaking the Magic State Bottleneck for Scalable Fault-Tolerant Quantum Computing},
  abstract={Magic states are indispensable resources for fault-tolerant quantum computation (FTQC). While magic state cultivation (MSC) offers significant theoretical advantages over magic state distillation (MSD), its practical viability is hindered by two critical inefficiencies. First, MSC suffers from extreme qubit underutilization; individual processes operate at only 21\% utilization, and the high throughput requirements of FTQC necessitate parallel ancilla operations that drive overall system utilization down to a mere 14\%. Second, current hybrid MSC-MSD approaches rely on rigid protocols that result in significant resource waste through premature state discarding and excessive overpurification.This paper introduces MagicFlow, a dynamic resource management framework designed to bridge these efficiency gaps. To maximize MSC throughput, MagicFlow implements intelligent qubit sharing between concurrent operations and introduces dynamic ancilla allocation for magic state transport, yielding a 2.3{\texttimes} reduction in qubit-cycle volume per magic state. To optimize hybrid workflows, the framework employs adaptive MSD protocol selection that eliminates waste and reduces the demand for pre-purified states by up to 9.4{\texttimes}. By addressing these architectural bottlenecks, MagicFlow significantly enhances the scalability and efficiency of magic-state preparation for practical FTQC systems.},
  keywords={fault-tolerant quantum computing, magic state cultivation, magic state distillation, resource management},
  doi={10.1145/3845814.3850030}
}

@inproceedings{10.1145/3845814.3850064,
  author={Ueyama, Rui},
  title={mold: A Massively Parallel Linker},
  abstract={Linking is a critical step in the software build process that combines compiled object files into a single executable or shared library. Despite decades of engineering effort, link times remain a significant bottleneck in the edit-compile-debug cycle, particularly for large C++ programs. Existing linkers exploit limited parallelism, leaving most CPU cores idle during linking. We present mold, a Unix/Linux linker that applies data parallelism systematically across the entire linking pipeline. We first analyze the architectural constraints that prevent existing linkers from scaling, including entangled symbol resolution and archive processing, and then show how a clean-slate design that decouples them overcomes these limitations. On large real-world programs, mold links multi-gigabyte binaries in at most a few seconds, and often in under a second. It is 2.4-16.1x faster than the state-of-the-art lld linker, and up to 112x faster than the traditional GNU ld. An ablation study shows that no single optimization dominates; the speedup comes from the cumulative effect of parallelizing all passes.},
  keywords={linkers, elf, data parallelism, build systems},
  doi={10.1145/3845814.3850064}
}

@inproceedings{10.1145/3845814.3850079,
  author={Chen, Jiefei and Lin, Binbin and Ma, Jinming and Duan, Jiangfei and Duanmu, Haojie and Liu, Hao and Cheng, Qinxiu and Li, Xiuhong and Pei, Zhilin and Wang, Hui and Zhang, Xingcheng and Lin, Dahua},
  title={NanoCP: Taming Load Imbalance in Data-Expert Parallel Decoding under Variable-Length Workloads},
  abstract={Modern serving systems for Mixture-of-Experts (MoE) models adopt hybrid data-expert parallelism: expert parallelism (EP) shards experts across GPUs to scale capacity, while data parallelism (DP) replicates attention layers across instances to process independent requests. Existing systems bind each request's attention, MoE communication, and KV cache to a single instance. Because attention latency scales with KV cache size while MoE communication latency scales with batch size, this binding cannot balance both simultaneously, producing EP stragglers; it also fragments KV memory across instances, inflating tail latency under long contexts. While existing context parallelism (CP) mitigates these constraints, existing group-level and uniform CP designs incur prohibitive communication and attention-side overheads. We present NanoCP, which decouples MoE communication from KV cache placement and achieves dual balance through dynamic context parallelism (DCP). DCP assigns each request a context-parallel degree sized to its KV footprint: long requests distribute attention across multiple instances; short requests remain local. This dynamic parallelism effectively liquefies the KV cache across DP instances within each node, balancing both the per-instance KV cache occupancy and batch sizes without unnecessary load-balancing costs. To bridge DCP with static execution, NanoCP introduces an ahead-of-time (AOT) graph engine paired with a custom routing-based communication backend. Experimental results show that, under 99\% TPOT-SLO attainment, NanoCP achieves 3.27{\texttimes} and 2.11{\texttimes} the maximum sustainable request rate of the best-performing vLLM baseline on the DeepSeek-V3 Issue 1\% and Issue 5\% workloads, respectively, while reducing P99 TPOT by 1.94{\texttimes} and 2.01{\texttimes} on the same two workloads, respectively.},
  keywords={mixture-of-experts, llm serving, distributed inference, dynamic context parallelism},
  doi={10.1145/3845814.3850079}
}

@inproceedings{10.1145/3845814.3850062,
  author={Chougule, Atharva and Root, Alexander J and Lacouture, Rubens and Yan, Bobby and Yadav, Rohan and Kjolstad, Fredrik},
  title={Partitioning Unstructured Sparse Tensor Algebra for Load-Balanced Parallel Execution},
  abstract={Sparse tensor algebra is challenging to efficiently parallelize due to the irregular, data-dependent, and potentially skewed structure of sparse computation. \% We propose the first partitioning algorithm that provably load balances the computation of any sparse tensor algebra expression across parallel execution units. \% Our algorithm generalizes parallel merging algorithms to any number of operands, and to multi-dimensional, hierarchical sparse data structures. \% We implement our algorithm within an existing sparse tensor algebra compilation framework to automatically generate parallel sparse tensor algebra kernels that target multi-core CPUs and GPUs. \% We show that our generated code is competitive with hand-implemented parallelization strategies used by vendor libraries like Intel MKL and NVIDIA cuSPARSE (geo-means of 0.93--5.5{\texttimes}) and Taco (geo-means of 1.2--2.4{\texttimes}), and significantly outperforms PyTorch Sparse's general-purpose strategies on sparse tensor expressions where specialized algorithms have not been developed (geo-means of 2.0-9.1{\texttimes}).},
  keywords={sparse tensor algebra, parallelism, load balance, gpus, multicore cpus, partitioning, compilers},
  doi={10.1145/3845814.3850062}
}

@inproceedings{10.1145/3845814.3850054,
  author={Ma, Jiaao and Liang, Ning and Xu, Ceyu and Lanschot, Alexander van and Xiao, Yunming and Lin, Shihan and Yang, Xiaowei and Wills, Lisa Wu},
  title={PhantomBox: Fully Homomorphic Web Application Firewall},
  abstract={Web Application Firewalls (WAFs) defend against malicious traffic by inspecting application payloads against regular expression (RegEx) rulesets. Because ruleset maintenance requires specialized expertise, operators typically delegate WAF functionality to third-party middleboxes, which cannot inspect encrypted traffic without access to the secret keys. Prior privacy-preserving WAFs sacrifice either RegEx expressiveness, third-party offloading, or communication costs. Fully Homomorphic Encryption (FHE) can evaluate RegEx on encrypted traffic, but thousand-fold ciphertext expansion and seconds-per-character compute costs have kept FHE-based WAFs unrealistic.We present PhantomBox, an FHE-based WAF that co-designs the datapath from client-side encryption through middlebox rule compilation and execution. To mitigate the compute bottleneck, PhantomBox introduces a novel ahead-of-time RegEx compiler with two FHE-specific optimizations: Fast Literal Matching and Boolean Fusion. The compiler also exploits equality saturation to further leverage the optimizations. To reduce network overhead, PhantomBox employs hardware-accelerated transciphering, keeping on-wire size comparable to plaintext while reducing client encryption latency by 84.6{\texttimes} over CPU. Evaluated on the Proofpoint ruleset with over 5,800 web-attack signatures, PhantomBox achieves a median evaluation latency of 7.7 ms on an AWS EC2 F2 instance. PhantomBox is the first system to make FHE-based WAF practical for real-world deployment, achieving full RegEx expressiveness, middlebox offloading, and cryptographic privacy simultaneously.},
  keywords={fully homomorphic encryption, web application firewall, regular expression, compiler, equality saturation, transciphering, fpga},
  doi={10.1145/3845814.3850054}
}

@inproceedings{10.1145/3845814.3850077,
  author={Strickler, Cole and Mancuso, Renato and Athanassoulis, Manos and Yun, Heechul},
  title={Programmable Data Layouts via On-The-Fly Data Transformation},
  abstract={The performance of modern computing systems is heavily bottlenecked by the widening gap between processing throughput and main memory latency, a problem exacerbated when an application's logical data access patterns misalign with the physical layout of data in memory. To address this, we propose a hardware-software co-design framework comprising the Data Transformation Language (DTL) and the Data Transformation Unit (DTU). DTL allows programmers to concisely express complex data layout reorganizations, which the compiler translates into efficient hardware routing configurations. The DTU, a hardware engine logically situated between the Last-Level Cache (LLC) and main memory, transparently evaluates these configurations on-the-fly to gather scattered data elements into dense, logically contiguous cache lines. By converting explicit layout transformations into virtual views, this approach eliminates the need for explicit data materialization in software. We evaluate the DTU within a quad-core RISC-V SoC using FireSim, demonstrating substantial improvements in execution speed and memory efficiency.},
  keywords={data transformation, data layout, cache locality, memory systems, hardware-software co-design},
  doi={10.1145/3845814.3850077}
}

@inproceedings{10.1145/3845814.3850037,
  author={Million, Davy and Monemi, Alireza and Evans, Adrian and Fuguet, C{\'e}sar and Alvarez, Lluc and P{\'e}trot, Fr{\'e}d{\'e}ric and Balkind, Jonathan},
  title={RAVEN-3.5D: Rapid Architecture Validation Enabling NoC-based 3.5D Multi-CPU/GPU Chiplet Systems},
  abstract={Advanced processors leverage 3.5D Integration to deploy stacks of 3D chiplets on an interposer. The architecture of such processors is complex as the chiplets need to be dimensioned, taking into account area and power, while ensuring that they can be assembled to make modular systems, such as the re-use of AMD's CCD chiplets in multiple products. As the cost for advanced packaging technology drops, it will migrate to lower-end systems, but the academic and open-source communities are not yet ready for studying such systems. Indeed, there are currently no openly available platforms to explore complex multi-chiplet, heterogeneous (CPU/GPU) architectures, particularly with appropriate high-bandwidth 3.5D NoCs, cache coherency and the ability to prototype at the RTL level. We present Raven-3.5D, a platform which can quickly generate the full RTL for these systems. The user specifies the system topology (number of chiplets, their composition, the global NoC topology, etc.) in a simple YAML file, and our platform generates the full RTL and software configuration. To program these systems, we present a lightweight software flow based on OpenCL which can compile applications to run on multi-core CPUs and multi-GPUs. We present two case-studies (i) focused on a footprint-constrained system (ii) a system design based on three re-usable chiplets. The full research platform is available as open-source and we believe it will be of great benefit to an interdisciplinary research community.},
  keywords={3.5d integration, chiplets, multi-core, gpu, noc},
  doi={10.1145/3845814.3850037}
}

@inproceedings{10.1145/3845814.3850074,
  author={Jahshan, Zuher and Belkar, Shahar and Mor, Yaron and Cigler, Tomer and Bergman, Shai and Zhang, Cheng and Ben-Ishay, Ben},
  title={Read Without Fault: DPU-Mediated Memory Disaggregation over PCIe},
  abstract={Data-intensive workloads can exceed local DRAM, making memory disaggregation attractive. Swap-based remote-memory systems reduce fault-handler overhead, but a demand read to a page absent from host memory still incurs a kernel fault and a full-page transfer before completing. We present Bytex, a transparent Linux remote-memory system built around a Data Processing Unit (DPU). Bytex maps evicted pages into the DPU's PCIe Base Address Register (BAR) using present, read-only page-table entries. CPU loads reach the DPU without a page fault; its programmable engines fetch remote pages into a local buffer and return the requested cache line. The demand read avoids a synchronous full-page transfer into host DRAM. Writes take a protection fault that restores a writable host copy. Device-resident pages remain immutable, allowing clean host-cache copies without additional coherence-tracking hardware. Background threads flush evicted pages and promote frequently read pages, while every host can both borrow and donate DRAM. We validate functionality with a QEMU/virtio bridge to a Hi1823E DPU and evaluate performance through simulation combining measured engine latencies with modeled PCIe costs. At 50\% host DRAM relative to the working set, KV throughput reaches 1.16–1.37{\texttimes} Fastswap's and 1.08–1.18{\texttimes} Hermit's. Across the graph study, five of six GAPBS kernels reach up to 2.39{\texttimes} over Fastswap and 1.84{\texttimes} over Hermit. Trace analysis reports up to 1.56{\texttimes} less data movement.},
  keywords={memory disaggregation, remote memory, data processing unit, pcie, rdma, transparent memory management, byte-addressable memory},
  doi={10.1145/3845814.3850074}
}

@inproceedings{10.1145/3845814.3850049,
  author={Zhang, Jiashuai and Han, Wenyong and Tang, Zhimin and Li, Huiyun},
  title={ReconLLM: Execution-Internal Interconnect Specialization for MoE Serving on Chiplet Systems},
  abstract={Chiplet technology and active interposers enable dynamic reconfiguration of physical routing topologies. However, Mixture-of-Experts (MoE) serving introduces pronounced phase heterogeneity in communication demands, creating a structural mismatch with fixed interconnects. We propose ReconLLM, a hardware/software co-designed framework for execution-internal interconnect specialization in MoE serving on chiplet-based active interposers. ReconLLM shifts interconnect adaptation to offline compilation: for deterministic phases (prefill and decode), it analytically extracts phase-specific communication requirements from model structure and execution order; for input-dependent MoE routing phases, it pre-generates a bounded family of routing templates based on serving parameters such as batch size and expert-load skew, with lightweight binding performed at runtime. The framework then synthesizes an offline library of phase-optimal topologies and triggers one-shot synchronous switching at runtime-visible phase/window boundaries. To support this model, we design ARIC, a lightweight reconfigurable active interposer that enables asynchronous preloading, double-buffered configuration state, one-shot synchronous commit, and direction-safe switching. Fabricated in 28 nm technology, ARIC operates at 500 MHz, delivers 400 GB/s bandwidth, and supports sub-microsecond one-shot reconfiguration. Evaluations on ASTRA-Sim 2.0 using a normalized 4{\texttimes}4 chiplet platform show that ReconLLM reduces communication cycles by 45.4\%--52.2\% compared with the fixed sparse interposer baseline (ARIC-fixed) and achieves up to 3.05{\texttimes} communication speedup over fixed mesh-class interposers. On the same workloads, ReconLLM improves serving metrics by reducing time-to-first-token (TTFT) by 1.4\%--9.1\%, time-per-output-token (TPOT) by 27.4\%--44.2\%, and end-to-end critical-path wall cycles by 23.9\%--39.5\%, while increasing steady-state throughput by 37.8\%--79.3\%. These results demonstrate that phase-level interconnect specialization is a powerful optimization dimension for MoE systems on physically constrained chiplet substrates.},
  keywords={large language models, mixture-of-experts, chiplet systems, reconfigurable interposer, phase-aware interconnect},
  doi={10.1145/3845814.3850049}
}

@inproceedings{10.1145/3845814.3850051,
  author={Bang, Seongtae and Park, Gyeongseo and Kang, Ki-Dong and Shin, Hyunkyun and Kim, Sungju and Kim, Daehoon},
  title={ReFlow: Exposing Parallelism in CPU-Offloaded LLM Training via Register-Resident SIMD Fusion and Decoupled Update Scheduling},
  abstract={CPU offloading is a practical approach to large language model training when FP32 optimizer state exceeds GPU HBM capacity. Prior work treats the CPU path as a slow fallback and hides its latency rather than reducing it. We observe that the exposed host-side bottleneck is fundamentally a host-memory-traffic problem, not a CPU-arithmetic problem, rooted in unnecessary materialization, gradient inflation, and serialized update scheduling. We present ReFlow, a CPU-offloaded training framework that redesigns the host update path around this diagnosis. To this end, ReFlow introduces register-resident optimizer fusion, host-side gradient processing, and deadline-aware update scheduling. Across the evaluated workloads, ReFlow improves throughput by up to 4{\texttimes} over the conventional baseline and 3{\texttimes} over the state-of-the-art in CPU-offloaded training, while preserving exact training semantics.},
  keywords={large language model, cpu offloading, heterogeneous memory, efficient deep learning training, cpu simd},
  doi={10.1145/3845814.3850051}
}

@inproceedings{10.1145/3845814.3850087,
  author={Liu, Shiyi and Xia, Yiran and Zhu, Zhenhua and Bai, Chen and Xu, Ceyu and Xie, Yuan},
  title={rLLM: A Serving-Aware Simulation Framework for Realistic LLM Hardware Evaluation},
  abstract={Large language model inference has become a major target for computer architecture research, driving a wide range of work on specialized accelerators, serving systems, and emerging technologies. However, prior studies usually evaluate inference hardware under simplified assumptions, such as static request shapes or fixed execution patterns. These assumptions divorce hardware evaluation from actual serving dynamics, ultimately leading to inaccurate performance estimates and suboptimal architectural conclusions. We present rLLM, a zero-semantic-gap framework for realistic LLM hardware evaluation. rLLM is implemented as an extension to the official vLLM codebase, allowing it to seamlessly track upstream vLLM updates while interoperating with other vLLM extensions. By coupling the real vLLM software stack with our pluggable hardware simulators, rLLM enables end-to-end evaluation of LLM accelerators driven by realistic, highly dynamic serving behaviors without requiring full platform-specific vLLM re-implementations. We validate rLLM's end-to-end fidelity using profiling-based, analytical, and microarchitecture backend configurations. Designed with modularity in mind, the framework is easily extensible to support a wide range of emerging accelerators. Crucially, our exploration reveals that realistic serving dynamics fundamentally shift system bottlenecks and optimal design points compared to static evaluations. By uncovering these discrepancies, rLLM offers the community fresh design insights from a serving perspective, underscoring the necessity of serving-aware co-simulation for robust LLM hardware co-design.},
  keywords={large language model inference serving, hardware-software co-simulation, vllm, design space exploration, performance modeling},
  doi={10.1145/3845814.3850087}
}

@inproceedings{10.1145/3845814.3850045,
  author={Zheng, Yusheng and Yu, Tong and Yang, Yiwei and Jiang, Minghui and Gao, Xiangyu and Su, Jianchang and Mao, Wenan and Zhang, Wei and Williams, Dan and Quinn, Andi},
  title={Safe and Programmable OS-Level GPU Resource Management with eBPF},
  abstract={GPU resource management policies govern how a system places memory and schedules GPU tasks. They play an important role in determining application performance, and the ideal policy for a given deployment often depends on low-level details such as the application, workloads, and hardware. AI agents would make it possible to automatically optimize GPU resource management policies, but require three properties of a system: safety, to ensure that a broken policy cannot cause a system crash; dynamism, to enable policy changes without restarts; and full-stack, to ensure that the policy can observe device and application states and control low-level hardware. Unfortunately, existing techniques for GPU resource management fail to meet these needs. We introduce gpu_ext, a new system that provides an OS interface for GPU resource management that is safe, dynamic, and full-stack by turning to eBPF: gpu_ext policies include eBPF callback functions that the system invokes on a specified event (e.g., when code reaches a function). The system includes a novel execution model that separates the effect of a callback from its triggering event. Namely, gpu_ext supports policies that asynchronously transition resources between states, potentially invoking multiple transitions at a single point-in-time. We implemented gpu_ext on the Linux NVIDIA GPU driver and find that AI-generated policies improve throughput by 1.76{\texttimes} over application-tuned baselines and reduce tail latency by up to 2{\texttimes}, without application modifications. Reimplementations of seven prior policies with gpu_ext achieve performance close to their native implementations. Moreover, we find that there were zero OS kernel panics through the optimization process, highlighting gpu_ext's safety.},
  keywords={gpu resource management, ebpf, os kernel extensibility, memory management, scheduling, unified virtual memory},
  doi={10.1145/3845814.3850045}
}

@inproceedings{10.1145/3845814.3850085,
  author={Xu, Zheyuan and Zhang, Xiaobei and Li, Zihan and Nie, Zekai and Zhu, Guangtao and Lu, Zhuang and Zhang, Qianying and Zhao, Shijun and Chen, Haibo and Hou, Rui},
  title={safeL4: Rethinking Safe-Language-Based Single Address Space Microkernels},
  abstract={Microkernels provide good features such as high security, safety, and flexibility, but their reliance on hardware-based isolation leads to heavy performance overhead, limiting their widespread adoption. Although constructing single-address-space microkernels based on safe language-based isolation is a promising approach to addressing the performance issue, this approach still faces challenges in maintaining the principle of minimality and enforcing capability-based, fine-grained access control over system resources. We propose safeL4, an approach to constructing microkernels based on safe languages. It guarantees minimality through low-level abstractions for unsafe operations, and implements a capability system based on the safe language's object capabilities to achieve fine-grained access control over all operations on system resources. We implement a prototype system in Rust, and our evaluation results show that the primitives provided by safeL4 are, on average, 1.9{\texttimes} faster than those of seL4.},
  keywords={microkernel, safe language, capability system},
  doi={10.1145/3845814.3850085}
}

@inproceedings{10.1145/3845814.3850070,
  author={Agbarya, Mohammad and Yaniv, Idan and Tsafrir, Dan},
  title={Selecting Memory Layouts for Model-Based Microarchitectural Performance Evaluation},
  abstract={Virtual memory research increasingly relies on empirical performance models that use simulated address translation metrics (x)---such as TLB miss rate and page-walk cycles---to predict benchmark runtimes (y) for new hardware designs. The accuracy of these models depends on the training data: a set of (x,y) pairs collected by executing the benchmark on real hardware with memory layouts that mix pages of different sizes. Because the number of possible layouts grows exponentially with address space size, a key challenge is to select layouts that yield informative training samples spanning a broad range of x values. Previously proposed selectors rely on flawed heuristics that can leave large gaps in the model's input domain, necessitating a costly manual search for additional layouts. We solve this problem with Moselect, a feedback-driven layout selector that uses previously observed x values to steer selections toward uncovered regions. Moselect eliminates the manual effort, achieves good x domain coverage, converges faster than prior selectors, and significantly reduces worst-case runtime prediction error. Moreover, the higher-quality training data Moselect yields allow simpler simulators and runtime models to achieve worst-case prediction errors similar to those of their more sophisticated counterparts.},
  keywords={virtual memory, huge pages, address translation, tlb, page table walks, performance counters},
  doi={10.1145/3845814.3850070}
}

@inproceedings{10.1145/3845814.3850075,
  author={Reimers, Sebastian and Fink, Martin and Elver, Marco and de Le{\'o}n, Hern{\'a}n Ponce and Sprokholt, Dennis and Bhatotia, Pramod},
  title={Should Linux Kernel Memory Model Dependencies Be Afraid of a Big Bad Optimizing Compiler?},
  abstract={The reliability of the global compute stack rests on an informal symbiosis between the Linux kernel and its compilers. To scale on weak memory architectures, the kernel relies on fine-grained dependency ordering, a zero-overhead synchronization mechanism preserved by data or control flow. However, a ''compiler gap'' has emerged: while the Linux Kernel Memory Model (LKMM) formalizes these dependencies, modern compilers optimize under C11, which does not recognize them. As optimizations grow more aggressive, this mismatch risks silently eliminating critical synchronization.We present a novel hybrid framework for automatically detecting broken LKMM dependencies at scale in the Linux kernel. It bridges formal semantics with system-level verification through: (1) a rigorous operational characterization of dependencies; (2) a path-sensitive compiler-based analysis integrated into LLVM to identify broken dependency chains; and (3) a model checking phase to prove actual violations.Our analysis of the v6.16 kernel, covering 25,000+ modules and 2 million dependency chains, gives us a high degree of confidence that the kernel remains semantically safe, even after nearly half of all syntactic dependencies are broken. This safety is not due to formal guarantees but rather ''defense-in-depth'': a combination of inline assembly, locks, and luck! This work provides the empirical foundation to resolve a decade-long debate and paves the way for concurrency-aware compilation.},
  keywords={weak memory consistency models, linux kernel, formal verification, translation validation, compilers},
  doi={10.1145/3845814.3850075}
}

@inproceedings{10.1145/3845814.3856751,
  author={Hui, Haojia and Guang, Mo and Li, Yaqian and Yan, Jiale and Du, Xiaobo and Gong, Laiyuan and Wang, Shengcheng and Hou, Anzhou and Zhang, Ye and Li, Yiqiang and Sun, Shichun and Chen, Lin and Jiang, Zhuoxuan and Miao, Mingkai and Chen, Chen and Long, Kaiwen},
  title={SL²OT: Scaling LLM Locality on Tile with Distributed 3D-DRAM as Unified Memory},
  abstract={Large language models (LLMs) are increasingly limited by memory bandwidth and latency rather than compute throughput. Our modeled 3D-DRAM system offers 4{\texttimes} the raw bandwidth of the HBM reference. However, high remote-access latency (~3{\texttimes} local latency) and redundant NoC traffic reduce its effective bandwidth below that of HBM. We present SL2OT, a hardware--software memory system that harnesses the raw bandwidth of distributed 3D-DRAM to improve LLM performance, guided by four principles---Scalability, Locality, Orchestration, and Temporality. Unified Virtual Memory (UVM) localizes remote accesses through asynchronous prefetching while preserving a unified address space. Asynchronous Request Coalescing (ARC) merges asynchronously arriving requests to the same address across tiles, reducing redundant transfers. Kernel Memory Migration (KMM) prefetches data for upcoming kernels, overlapping host-to-device transfers with computation. Accel-Sim evaluations using A100-80GB SASS traces show 1.22--3.03{\texttimes} speedup over HBM across operators and transformer blocks, and 3.51{\texttimes} speedup over naive distributed 3D-DRAM on GEMM. A matched FlashAttention study reduces mean global-read latency by 73.4\% relative to Mesh. SL^2 OT reaches 72.2\% effective bandwidth utilization, versus 15.1\% without SL2OT.},
  keywords={distributed memory, 3d-dram, memory migration, gpu},
  doi={10.1145/3845814.3856751}
}

@inproceedings{10.1145/3845814.3850057,
  author={Zhang, Ziyang and Mottola, Luca and Wu, Zheshun and Liu, Jie and Wang, Tian},
  title={SparseDVFS: Sparsity-aware DVFS for Energy-Efficient Edge Inference},
  abstract={We present SparseDVFS, a sparsity-aware DVFS technique operating at fine-grain for energy-efficient edge inference. Our key insight is that operator sparsity is a primary metric for hardware frequency modulation. Traditional model-level DVFS, on the other hand, is often too coarse-grained to capture intra-inference variations in sparsity and computational intensity, whereas fine-grained operator-level scaling suffers from prohibitive performance degradation due to significant hardware switching latency. By distinguishing between compute-bound dense operators and memory-bound sparse operators, SparseDVFS applies specialized frequency configurations to maximize energy efficiency. We achieve this with a combination of three techniques: (1) an offline modeler that establishes a mapping between operator sparsity and optimal frequency configurations via white-box timeline analysis; (2) a runtime graph partitioner that aggregates operators into super-blocks, balancing scaling granularity and DVFS switching latency through a latency amortization constraint; and (3) a co-governor that employs a scaling engine to jointly synchronize CPU, GPU, and memory clock frequencies and a look-ahead instruction queue to eliminate antagonistic effects between independent component governors and hide hardware switching latencies. Extensive evaluations show that SparseDVFS improves energy efficiency by 78.17\% with only a 12.8\% latency penalty and reduces DVFS switching overhead by 8.5{\texttimes}, while ensuring thermal stability.},
  keywords={edge inference, sparsity, power management, fine-grained dvfs},
  doi={10.1145/3845814.3850057}
}

@inproceedings{10.1145/3845814.3850078,
  author={Liu, Rui and Zhang, Xiaoyu and Liu, Bowen and Wang, Xinyu and Dou, Chunmeng and Li, Xueqi and Tang, Minghua and Chen, Xiaoming},
  title={SparseX-PIM: Sparse Linear Algebra on Processing-in-Memory},
  abstract={Sparse linear algebra is a fundamental workload in scientific computing and machine learning, but its performance is severely constrained by memory bandwidth. Processing-in-memory (PIM) has shown great potential for sparse linear algebra, yet its efficiency is heavily bottlenecked by irregular computation and memory access patterns. Through a systematic analysis of sparse kernels, we identify three key challenges: inter-bank communication caused by poor data locality, workload imbalance caused by irregular sparsity, and computation stalls caused by complex task dependencies. Hardware-software co-design is key to resolving these tightly coupled challenges. In this work, we propose SparseX-PIM, a hardware-software co-designed 3D PIM architecture that unifies sparse matrix multiplication, factorization, and linear system solving, and enables the first PIM-based direct solver for sparse linear systems. On the software side, we develop an instruction set and an application programming interface (API) for code generation, together with a dependency-aware data layout and task scheduling scheme enabled by a PIM-oriented compiler, to improve load balance and reduce communication overhead. On the hardware side, we combine coarse-grained asynchronous execution with fine-grained pipelining, complemented by hierarchical scratchpads and grouped content-addressable memory (CAM) acceleration to effectively mask computation stalls and accelerate index matching. Evaluation results demonstrate that, compared with CPU and GPU baselines (PARDISO and cuDSS), SparseX-PIM achieves average speedups of 135.7{\texttimes} and 146.2{\texttimes} in factorization, and 5060.5{\texttimes} and 1987.0{\texttimes} in solving, alongside massive energy savings. Furthermore, SparseX-PIM delivers superior performance and energy efficiency compared with highly specialized state-of-the-art PIM accelerators across a broad spectrum of sparse kernels.},
  keywords={keywords{processing-in-memory, sparse linear algebra, sparse lu factorization, sparse linear system solve}},
  doi={10.1145/3845814.3850078}
}

@inproceedings{10.1145/3845814.3850026,
  author={Wang, Wenfeng and Hou, Xiaofeng and Xia, Xinfeng and Wang, Xinkai and Zhang, Mingxuan and Tang, Peng and Liu, Jiacheng and Li, Chao},
  title={Specter: Fast MoE Inference via Quantization-Enabled Multi-Step Speculative Offloading},
  abstract={Mixture-of-experts (MoE) models often exceed a single accelerator's memory capacity. Offloading experts to host memory creates a severe PCIe I/O bottleneck because data-dependent routing keeps transfers on the critical path.We present Specter, an inference system that uses quantization to combine speculative decoding with expert offloading. Its lightweight quantized draft model runs efficiently on device while preserving high-fidelity expert activation patterns. This provides accurate multi-step lookahead over future expert usage, allowing the runtime to organize expert movement and execution ahead of verification and improve both communication and execution efficiency.Under single-request inference, Specter achieves an average 1.50{\texttimes} (up to 1.88{\texttimes}) speedup in time per output token (TPOT) over the state-of-the-art system. Specter makes memory-constrained, single-GPU MoE inference more practical on commodity hardware. Our code is available at https://github.com/wwwwwf/specter_asplos.},
  keywords={mixture-of-experts, speculative decoding, expert offloading, model quantization},
  doi={10.1145/3845814.3850026}
}

@inproceedings{10.1145/3845814.3850086,
  author={Biswas, Anish and Goel, Kanishk and S, Srivarshinee and Mohan, Jayashree and Khare, Alind and Parayil, Anjaly and Bansal, Chetan and Ramjee, Ram},
  title={Sutradhara : An Intelligent Orchestrator-Engine Co-design for Tool-based Agentic Inference},
  abstract={Agentic applications are LLMs that iteratively invoke external tools to accomplish complex tasks. Such tool-based agents are rapidly becoming the dominant paradigm for deploying language models in production. Unlike traditional single-turn inference, agentic workloads chain together multiple LLM calls and tool executions before producing a final response, creating a new performance bottleneck that manifests as increased latency in First Token Rendered (FTR) of the final answer. Through analysis of requests at production scale, we reveal three critical challenges: tool calls account for 30-85\% of FTR latency, KV cache hit rates collapse despite substantial context reuse across iterations, and sequential orchestration wastes potential intra-request parallelism. These bottlenecks stem from a design gap in which orchestrators and LLM engines operate as decoupled black boxes, preventing cross-layer optimizations. We present Sutradhara, a co-designed agentic inference system that integrates orchestration with LLM serving through a thin API enabling three optimizations: overlap tool execution with subsequent LLM prefill using tool-aware prompt splitting, streaming tool execution to dispatch tools incrementally during decode rather than waiting for complete output, and orchestrator-aware cache management that uses semantic hints to improve hit rates and reduce thrashing. Implemented on vLLM, Sutradhara improves the throughput–latency trade-off in agentic systems, sustains up to 77\% higher load at the same median FTR latency, or reduces median FTR latency by up to 15\% at the same load while reducing end-to-end latency by up to 11\% on A100 GPUs.},
  keywords={large language models, agentic inference, inference serving, scheduling, memory management},
  doi={10.1145/3845814.3850086}
}

@inproceedings{10.1145/3845814.3850059,
  author={Hou, Bohan and Jin, Hongyi and Wang, Guanjie and Hong, Shushi and Chen, Jinqi and Cai, Yaxing and Yang, Lijie and Ye, Zihao and Ding, Yaoyao and Lai, Ruihang and Mowry, Todd C. and Chen, Tianqi},
  title={TIRx: A Unified Tile Primitive ML Compiler Across Heterogeneous Backends},
  abstract={Modern ML kernels evolve rapidly with new optimizations and hardware features. ML compiler abstractions must accommodate richer memory hierarchies, more forms of thread cooperation, and increasingly heterogeneous backends while retaining the control required for peak performance. We present TIRx, an ML compiler for GPUs and AI accelerators that exposes these ingredients through explicit interfaces. TIRx introduces an explicit execution-scope abstraction that captures participating hardware teams at multiple granularities. It also uses tensor layouts to map logical tensors to heterogeneous hardware spaces through named axes and shard/replica/offset semantics. Finally, it introduces tile-primitive dispatch, which lowers high-level operations to efficient implementations according to scope, layout, and backend. This design preserves native-level control while automating recurring address calculation, operand preparation, and instruction-loop generation. Our evaluation shows vendor-level performance across the latest GPUs and AI accelerators, while native-code case studies show substantial reductions in low-level implementation code.},
  keywords={ml compilers, tile primitives, tensor layouts, execution scopes, heterogeneous computing},
  doi={10.1145/3845814.3850059}
}

@inproceedings{10.1145/3845814.3850039,
  author={Zhang, Chi and Sun, Yi and Zhang, Weichuang and Chen, Quan and Zhao, Jieru},
  title={TranSAGE: Automating Spatial Accelerator Generation for Large-Scale Transformer Models},
  abstract={Large-scale Transformers have achieved remarkable success across NLP, computer vision, and robotics, but their growing computational and memory demands challenge efficient inference. Spatial accelerators offer advantages in on-chip bandwidth and energy efficiency, yet designing them for large models remains costly and time-consuming. Existing accelerator generators typically focus on single-operation support, overlooking the benefits of multi-operation pipelining, which limits throughput and energy efficiency.We propose TranSAGE, a compiler-based framework that jointly optimizes scheduling for large-scale transformers under multi-operation pipelining and generates corresponding accelerator implementations. Our approach integrates a DSE engine with multi-operation dataflow optimization and a dynamic programming-based graph partitioning algorithm to efficiently identify pipeline-friendly operation clusters and their optimal dataflow parameters. We further design spatial architecture primitives and lowering passes to automatically generate efficient RTL implementations.Evaluations on four representative LLMs demonstrate that TranSAGE achieves up to 2.41{\texttimes} higher throughput and 13.04{\texttimes} higher energy efficiency over commercial GPU/NPU baselines. Compared with state-of-the-art accelerator generators, TranSAGE achieves up to 11.33{\texttimes} higher throughput and 6.07{\texttimes} higher energy efficiency. Our code is available at https://github.com/sjtu-zhao-lab/TranSAGE.git.},
  keywords={transformer accelerators, spatial architectures, accelerator generation, compiler optimization, dataflow optimization},
  doi={10.1145/3845814.3850039}
}

@inproceedings{10.1145/3845814.3850036,
  author={Chen, Yuanliang and Zhang, Xudong and Yu, Zehong and Yan, Zhen and Ma, Fuchen and Jiang, Yu},
  title={TrapFuzz: Understanding and Detecting Recovery Failure Issues in Multi-Trap Mechanisms of RISC-V CPUs},
  abstract={Modern RISC-V processors support a rich trap mechanism that handles exceptions and interrupts across multiple privilege levels. While the ISA specification defines the expected behavior of nested traps, real CPU implementations introduce many microarchitectural optimizations for trap entry, context saving, and trap return, which makes multi-trap handling particularly error-prone. However, existing CPU testing techniques rarely explore nested traps and therefore miss a large space of recovery-failure issues. This paper first presents a study of real-world multi-trap issues in six widely used open-source RISC-V CPUs, analyzing their symptoms, triggering conditions, and root causes. We find that deeply nested trap sequences, where exceptions or interrupts recur inside trap handlers, are essential for exposing these correctness issues, yet are difficult to generate due to the combinatorial interactions of trap-entry constraints, privilege rules, delegation settings, and CSR state transitions. Guided by this study, we design TrapFuzz. TrapFuzz first builds a Multi-Trap Sequence Model that encodes trap-entry, delegation, priority, and trap-return constraints to generate legal nested-trap sequences. It then uses trap-state volatility as feedback to guide execution toward deeper and more error-prone trap interactions. Finally, TrapFuzz employs an MTSM-derived recovery oracle that validates CSR consistency, privilege-flow legality, and forward progress. In total, TrapFuzz detected 21 new recovery-failure issues in eight real-world RISC-V CPUs.},
  keywords={keywords{risc-v cpus, fuzzing, bug detection}},
  doi={10.1145/3845814.3850036}
}

@inproceedings{10.1145/3845814.3850031,
  author={Mamak, Gunagya Singh and Vittal, Suhas and Dubey, Kabir and Smith, Kaitlin N. and Qureshi, Moinuddin K.},
  title={Trident: Efficient Load Verification for Yoked Surface Codes using a Three-Level Memory Hierarchy},
  abstract={Fault-Tolerant Quantum Computers (FTQCs) commonly use the surface code to encode program qubits as error-corrected logical qubits. Unfortunately, the surface code has a poor encoding rate, so recent work has proposed Yoked Surface Codes (YSCs), which concatenate the surface code with a high-rate quantum code. The surface code qubits in YSCs are protected by the checks, or yokes, of the high-rate code. YSCs have 1D and 2D variants, which are 1.8{\texttimes} and 4.5{\texttimes} more efficient than the surface code, respectively. Modern FTQC architectures use a two-level hierarchy: surface codes perform logical operations (compute) while 2D YSCs store idle program qubits (memory). To load a qubit from memory, the FTQC first performs retrieval, which logically moves a program qubit from a 2D YSC into a surface code (8 cycles). However, retrieval is not fault-tolerant, so the FTQC must verify the load by measuring all the yokes of the 2D YSC (178 cycles). As verification dominates memory access latency, eliminating it can provide a speedup of 5.7{\texttimes}. Our goal is to reduce the verification overhead of 2D YSCs while retaining their storage efficiency. We exploit the fact that 1D YSCs, though less storage-efficient, incur negligible verification latency. We propose Trident, which expands the two-level hierarchy into a three-level hierarchy by adding a small intermediate level containing a 1D YSC (L1). If most loads hit L1 rather than L2 (2D YSC tier), it can significantly reduce verification overhead. We present two variants: Trident-D (demand-driven) and Trident-P (prefetch-driven), which achieve speedups of 2.8{\texttimes} and 4.2{\texttimes}, respectively, while increasing the physical qubit cost of memory by only 4.9\%.},
  keywords={fault-tolerant quantum computing, quantum error correction, quantum computer architecture, quantum memory hierarchy, yoked surface codes},
  doi={10.1145/3845814.3850031}
}

@inproceedings{10.1145/3845814.3850058,
  author={Li, Ying and Hao, Yueming and Berard, David and Zhao, Xu and Huang, Barney and Chi, Wenyuan and Tsai, Cheng-huan and Patel, Prithvi and Ramesh, Srivatsan and Ren, Manman and Yu, Hongtao and Wu, James and Zimmerman, Dan and Riasanovsky, Nicholas J. and Mainz, Adam and Maher, Bert and Hua, Peiying and Shi, Daohang and Robie, Taylor and Fang, Yuanwei and Zhu, Shuofei and Yu, Shangdi and Patel, Nikhil and Bao, Bin and Chen, Yang and Szczepaniec, Jan and Zhu, Haishan and Li, Patrick and Nay, Shane and Aziz, Adnan and Yoshimi, Bill and Loginov, Alexey and Sun, Yifan},
  title={TritonParse: Multi-IR Provenance and Reproducible Debugging for Triton Kernel Compilation},
  abstract={Domain-specific languages (DSLs) for deep learning, such as Triton, reduce the development effort required to write high-performance GPU kernels. However, debugging Triton kernels remains challenging. To facilitate quick and streamlined debugging, we present TritonParse, a unified framework that systematically collects and organizes debugging evidence to help developers efficiently localize Triton kernel failures. TritonParse follows a 4R workflow: Record, Reconstruct, Review, and Reproduce. Beginning with capturing compilation and launch metadata, TritonParse then reconstructs traces into analyzable forms by aggregating data from multiple sources, supports human-in-the-loop inspection through a user interface, and generates reduced single-kernel reproducers (runnable programs that replay captured kernels) for manual debugging and automated regression analysis. Evaluations across NVIDIA H100 and AMD Instinct MI300 show that TritonParse reliably reproduces bugs across all known cases. Trace collection and execution replay incur modest runtime and storage overheads: 21\% additional runtime and 4 MB of reconstructed storage per operator on average.},
  keywords={triton, compiler debugging, gpu kernels, multi-ir provenance, reproducibility},
  doi={10.1145/3845814.3850058}
}

@inproceedings{10.1145/3845814.3850063,
  author={Shan, Haoxuan and Guo, Cong and Duan, Bowen and Wei, Chiyue and Cheng, Feng and Fu, Yuzhe and He, Yintao and Li, Hai and Chen, Yiran},
  title={Vortex: Bridging Extreme Compression and Efficient LLM Inference},
  abstract={Extreme compression techniques, including vector quantization (VQ) and input-dependent sparsity, can significantly reduce the memory footprint of large language models (LLMs). However, a key challenge remains in translating such compression into practical efficiency. On conventional systolic-array-based accelerators, VQ incurs high dequantization overhead, while the irregular patterns of input-dependent sparsity are difficult to exploit. In this study, we address these challenges with Vortex, an architecture compatible with systolic-array-based accelerators with minimal hardware overhead, bridging the gap between extreme compression and efficient inference. Vortex adopts a bi-flow execution strategy that efficiently supports vector-quantized models across both prefill and decoding workloads, and we further optimize it through systematic design space exploration. On the algorithm side, we propose codebook-wise contextual sparsity to align with VQ execution. Across end-to-end workloads, Vortex achieves 8.03x-23.7x speedup and 5.68x-12.5x energy reduction over state-of-the-art accelerators.},
  keywords={vector quantization, contextual sparsity, hardware accelerator, llm},
  doi={10.1145/3845814.3850063}
}

@inproceedings{10.1145/3845814.3850061,
  author={Pan, Yanqi and Chen, Jiahao and Huang, Hao and Xia, Wen and Zou, Xiangyu and Li, Shiyi and Wu, Chentao and Wang, Jianzong},
  title={Wisdom From File Systems: Fast and Reliable Update for Graph-based Vector Search via Soft Insert},
  abstract={Low-latency persistent memory (PM) encourages immediate vector persistence for fast, crash-consistent graph-based ANNS updates. However, existing approaches rely on graph-grained copy-on-write, incurring intolerable persistence overheads. We propose soft insert for fast and crash-consistent graph-based vector updates on PM. The key idea, inspired by soft update in file systems, is to perform graph-specific, fine-grained, and ordered insertions for crash consistency while delaying insertions for efficiency. This is achieved by (1) reasoning and enforcing graph write order using lightweight PM I/O, and (2) decoupling and delaying the insert phase to overlap with the search phase. We further propose an array of techniques to improve the efficiency, scalability, and reliability. Experiments on million- and billion-scale datasets show that our approach significantly outperforms existing ANNS indexes (e.g., OdinANN) in update performance, while providing fast (near-instant), crash-consistent persistence.},
  keywords={approximate nearest neighbor search, persistent memory, vector update, crash consistency, file system},
  doi={10.1145/3845814.3850061}
}

@inproceedings{10.1145/3845814.3850040,
  author={Chung, Yi-Hua and Hsiao, Hao-Hsiang and Chiu, Cheng-Hsiang and Zhang, Boyang and Chang, Che and San Miguel, Joshua and Huang, Tsung-Wei},
  title={XEG: A GPU-parallel Algorithm for Efficient and Effective E-Graph Extraction},
  abstract={Equality saturation is a promising compiler optimization approach that addresses the phase-ordering problem by compactly representing equivalent programs in an e-graph. However, extracting the optimal program from a saturated e-graph, known as e-graph extraction, is very time-consuming as the e-graph becomes dense and large. In this paper, we present XEG, a GPU-parallel e-graph extractor that achieves both fast runtime and high solution quality. Specifically, XEG introduces efficient algorithms to establish the e-graph and solution space on GPU and leverages ILP to extract a high-quality solution. Experimental results show that XEG (GPU-based) achieves a 243{\texttimes} average speedup over SmoothE (GPU-based) while improving solution quality by 7\%. Compared with e-boost (CPU-based), XEG achieves a 7.73{\texttimes} average speedup while maintaining comparable solution quality. In addition, XEG can operate without ILP as a standalone extractor, achieving a 123{\texttimes} average speedup over egg (CPU-based) with comparable solution quality.},
  keywords={compiler optimization, gpu algorithms},
  doi={10.1145/3845814.3850040}
}
