  author={Huang, F. and Saini, B. and Wan, L. and Lu, H. and He, X. and Qin, S. and Tsai, W. and Gruverman, A. and Meng, A. C. and Wong, H.-S. P. and McIntyre, P. C. and Wong, S. S.},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Observation of Ultra-high Polarization (~ 108 μC/cm²) in Nanometer Scaled High Performance Ferroelectric HZO Capacitors with Mo Electrodes}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={We demonstrate, for the first time, excellent ferroelectricity, and endurance of 4 nm-thick and $65\mathrm{~nm}\times 45\mathrm{~nm}$ size Hf0.5 Zr0.5 O2 (HZO) capacitors with Mo electrodes. We show 1) the crystallization temperature is as low as 400 °C, which is critical for BEOL FeRAM; 2) benefits from thickness scaling, low operation voltage (1.2 V) and high endurance (>1010 cycles) are achieved; 3) the wake-up effect is further reduced to 20% and the beginning of fatigue is delayed by an order of magnitude by adding a 1 nm CeO2 stressor layer; and 4) direct measurements of ferroelectricity with ultra-high polarization switching $(\sim 108 \mu\mathrm{C}/\mathrm{cm}^{2})$ in devices scaled down to $95\mathrm{~nm}\times 85\mathrm{~nm}$ size. This study advances the understanding of scaling effect in HZO capacitors.},
