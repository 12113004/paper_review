  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Experimental Demonstration of Probabilistic-Bit (p-bit) Utilizing Stochastic Oscillation of Threshold Switch Device}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={To realize p-bits that fluctuate between 0 and 1 with precisely controlled probabilities, stochastic oscillation behavior of threshold switch (TS) device was induced by applying supply voltage ($\mathrm{V}_{\mathrm{D}\mathrm{D}}$) near-threshold voltage ($\mathrm{V}_{\mathrm{T}\mathrm{H}}$). Insulator-metal transition (IMT) device and ovonic threshold switch (OTS) device were investigated as a source of p-bit generation. It was confirmed that a small voltage change of mV-scale in the near-threshold region can give a high degree of stochasticity to the oscillation frequency. Also, the probability was controlled by a comparator and shift of a compare-voltage ($\mathrm{V}_{\mathrm{comp}}$) with excellent controllability. Finally, a simple probabilistic Boolean logic operation was tested by 100 p-bits generated from IMT devices.},
  keywords={Switches;Very large scale integration;Traveling salesman problems;Probabilistic logic;Controllability;Threshold voltage;Behavioral sciences},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185217},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185207,
  author={Aadit, Navid Anjum and Mohseni, Masoud and Camsari, Kerem Y.},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Accelerating Adaptive Parallel Tempering with FPGA-based p-bits}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Special-purpose hardware to solve optimization problems formulated as Ising models has generated great excitement recently. Despite a large diversity in hardware, most solvers employ standard variations of the classical (simulated) annealing (CA) algorithm. Here, we show how powerful replica-based Parallel Tempering (PT) algorithms can significantly outperform CA, using FPGA-based probabilistic computers. Using a massively parallel (graph-colored) architecture, we implement the Adaptive PT (APT) algorithm, generating problem-dependent temperature profiles to equalize replica swap probabilities. We benchmark our p-computer against analytical results from classical Ising theory and use our machine to solve spin-glass instances formulated as hard optimization problems. APT outperforms heuristic choices of temperature profiles used in conventional PT and a replica-based version of CA. Our machine provides 6,000X speedup over optimized CPU, with orders of magnitude further speedup projected for scaled implementations. The developed co-design techniques may be useful for a broad range of Ising machines beyond p-computers.},
  keywords={Computers;Temperature distribution;Computational modeling;Simulated annealing;Computer architecture;Very large scale integration;Probabilistic logic},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185207},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185381,
  author={Kaiser, Karl and Patil, Dinesh and Beigne, Edith},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A prototype 5nm custom sensor SoC for Augmented Reality/Virtual Reality targeting Smartglasses with embedded computer vision, audio, security and ML}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Augmented and Virtual Reality (AR/VR) are disruptive technologies poised to become the next generation compute platforms. It represents a merging of the physical and the digital domains into a rich, context aware and accessible user interface delivered in real-time through a socially acceptable form factor. Innovations in the key technical areas of Power/Performance, Form Factor, and Thermal are essential to produce all-day wearable AR products. We present a research prototype sensor SoC, optimized for AR/VR and Smartglasses prototypes, aiming at reducing future product size and power. It allows substantial computational capabilities, through specialized accelerators, at very low power levels. It is architected to allow data locality and reuse, as well as power efficient data movement.},
  keywords={Technological innovation;Thermal factors;Prototypes;Virtual reality;Very large scale integration;User interfaces;Real-time systems},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185381},
