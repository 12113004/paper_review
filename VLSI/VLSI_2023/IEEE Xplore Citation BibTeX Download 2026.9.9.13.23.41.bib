  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 6.5nW, -73.5dBm Sensitivity, Cryptographic Wake-Up Receiver with a PUF-based OTP and Temperature-Insensitive Code Recovery}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This work proposes an algorithm and circuits for a cryptographic wake-up receiver (WuRX). Main contributions include 1) an algorithm and its implementation of OTP-based wake-up code generation that enables resynchronization, 2) implementation of a physically unclonable function (PUF) for the WuRX, 3) temperature-compensated ring-oscillator circuit, and 4) transition-based correlator that prevents accumulation of timing error to extend frequency mismatch tolerance up to 58%.},
  keywords={Codes;Sensitivity;Receivers;Very large scale integration;Physical unclonable function;Correlators;Timing},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185235},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185304,
  author={Wang, Dong and Zhou, Jiazheng and Xu, Hui and Zhang, Ningyuan and Su, Xiaolei and Shen, Zhengkun and Jiang, Haoyun and Yang, Fan and Wang, Yixiao and Liu, Junhua and Liao, Huailin},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An All-Digital Outphasing Transmitter IC for Ka-Band Bit-to-RF Concurrent Multi-Beam DBF Array}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={The first Ka-band DTX-based bit-to-RF multi-beam transmitter array is demonstrated in this work. The DTX IC features a prototype digital outphasing architecture with a 4x frequency multiplication scheme and a piecewise varactor array (PVA) linearization technique. Further, a compact wideband ADPLL with 24-bit phase shifting is integrated, eliminating the high-frequency LO distribution and improving the phase/gain alignment in the array. Leveraging these techniques, a low-cost 24.5-30GHz DTX is fabricated in 40nm CMOS. It achieves an EVM of-24.2dB for 16QAM without calibration and only occupies a core area of 1.2 x1.35mm2. Bit-to-RF concurrent multi-beam forming is demonstrated with a lx8 uniform linear array (ULA) and the best normalized energy/area efficiency are achieved.},
  keywords={Varactors;Phased arrays;Transmitters;Prototypes;Linearization techniques;Very large scale integration;Frequency conversion;multi-beam;DTX;DBF;outphasing;ADPLL},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185304},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185362,
  author={Forghani, Mahdi and Zhao, Yu and Khanna, Pawan K. and Razavi, Behzad},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 112-Gb/s 58-mW PAM4 Transmitter in 28-nm CMOS Technology}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={A voltage-mode transmitter employs a resistorless output DAC, a 3-tap latchless FFE, a passive output skew compensation network, and a 56-GHz integer-N PLL. The prototype delivers an output swing of $0.8 \mathrm{V}_{{\mathrm {pp,d}}}$ with an rms clock jitter of 160 fs and RLM = 96%.},
  keywords={Transmitters;Prototypes;Very large scale integration;Jitter;CMOS technology;Phase locked loops;Clocks;Wireline;PAM4;serializer},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185362},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185280,
  author={Xuan, Zhe and Balamurugan, Ganesh and Huang, Duanni and Kumar, Ranjeet and Sharma, Jahnavi and Levy, Cooper and Kim, Jinyong and Ma, Chaoxuan and Su, Guan-Lin and Liu, Songtao and Wu, Xinru and Acikalin, Tolga and Rong, Haisheng and Jaussi, James},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 256 Gbps Heterogeneously Integrated Silicon Photonic Microring-based DWDM Receiver Suitable for In-Package Optical I/O}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a 256 Gb/s (8$\lambda$*32 Gb/s/$\lambda$) 3D-integrated silicon photonic (SiPh) receiver suitable for integration in XPU/switch packages. The photonic IC (PIC) integrates a multi-wavelength laser, optical amplifier, and cascaded micro-ring resonators (MRRs) to implement dense wavelength division multiplexing (DWDM) with minimal footprint. The 28nm CMOS electronic IC includes eight SerDes channels, and PIC interface/control electronics. A dither-based thermal control unit tunes MRRs in the optical demux to align with the laser grid with sub-pm resolution. Measured results demonstrate BER<1e-12 when receiving 256 Gb/s DWDM input generated by MRRs modulating eight 200 GHz-spaced wavelengths. This is 2X higher aggregate bandwidth than previously published SiPh MRR-based receivers, with higher level of photonic integration.},
  keywords={Integrated optics;Optical resonators;Very large scale integration;Wavelength division multiplexing;Silicon photonics;Optical receivers;Optical amplifiers;SiPh transceiver;MRR;Co-packaged optics},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185280},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185378,
  author={Kashani, Milad Haghi and Shakiba, Hossein and Sheikholeslami, Ali},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.32pJ/b 90Gbps PAM4 Optical Receiver Front-End with Automatic Gain Control in 12nm CMOS FinFET}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents a 0.32pJ/b90Gbps PAM4 optical receiver (RX) front-end with a 13.4pA/$\sqrt{}$Hz noise density. The proposed design employs a new transimpedance amplifier (TIA) and a single-ended-to-differential (S2D) block providing a large gain-bandwidth product with less power and area overhead compared to the conventional designs. The proposed RX is implemented in 12nm CMOS FinFET process and co-packaged with a commercial photodiode (PD), offering the best power efficiency, input-referred noise, and figure-of-merit (FOM) amongst the previous state-of-the-art designs [1] –[5].},
  keywords={Very large scale integration;FinFETs;CMOS technology;Optical receivers;Photodiodes;Optical noise;Optical amplifiers;TIA;PAM4 Optical Receiver;CMOS},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185378},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185285,
  author={Zhang, Zhao and Zhang, Zhaoyu and Chen, Yong and Qi, Nan and Liu, Jian and Wu, Nanjian and Liu, Liyuan},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 64-Gb/s Reference-Less PAM4 CDR with Asymmetrical Linear Phase Detector Soring 231.5-fsrms Clock Jitter and 0.21-pJ/bit Energy Efficiency in 40-nm CMOS}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper reports a quarter-rate reference-less PAM4 clock and data recovery (CDR) circuit. Our proposed asymmetrical linear phase detector (A-LPD) can simultaneously detect frequency and phase difference for the PAM4 input, thus, fully eliminating the external reference clock or frequency-locked loop. Meanwhile, the presented A-LPD can sense all 12-type PAM4 transitions to reduce the recovered clock’s RMS jitter. An exclusive-OR ring phase-locked loop (XOR-RPLL) is devised for low-power and low-jitter 8-phase clock generation. Fabricated in a 40-nm CMOS, our prototype CDR achieves 231.5-f$\mathrm{s}_{\mathrm{I}\mathrm{m}\mathrm{s}}$ clock jitter, 0.21-pJ/bit energy efficiency, <1$0^{-12}$ bit error rate at 64 Gb/s, and a capture range of 57.2-to-65 Gb/s. Keywords: PAM4, CDR, reference-less, phase detector.},
  keywords={Frequency locked loops;Prototypes;Detectors;Phase frequency detectors;Jitter;Very large scale integration;CMOS technology},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185285},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185267,
  author={Yi, Il-Min and Kaile, Srujan Kumar and Zhu, Yuanming and Diaz, Julian Camilo Gomez and Hoyos, Sebastian and Palermo, Samuel},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 50Gb/s DAC-Based Multicarrier Polar Transmitter in 22nm FinFET}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={A DAC-based polar transmitter (TX) for wireline applications efficiently implements jitter-robust multicarrier signaling with arbitrary modulation formats. 50Gb/s total data rate is supported by three parallel 5GS/s output drivers operating with baseband PAM-4 and mid-band (MB) and highband (HB) 16-state complex modulation on 5 and 10GHz orthogonal carriers. DAC amplitude resolution is 7b plus 2b predistortion for all drivers, while the polar MB and HB drivers also have 7b phase resolution. The TX DSP implements 8-tap FIR filtering on all bands. Fabricated in 22nm FinFET, the TX has 1.2$\mathrm{V}_{\mathrm{p}\mathrm{p}\mathrm{d}}$ swing and achieves 50Gb/sBER<$10^{-4}$ with both QAM-16 and APSK-4+12 modulations at 1. 68pJ/b.},
  keywords={Baseband;Transmitters;Finite impulse response filters;Filtering;Modulation;Very large scale integration;FinFETs;DAC;multicarrier signaling;transmitter},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185267},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185388,
