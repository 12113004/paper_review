  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3-nm 27.6-Mbit/mm2 Self-timed SRAM Enabling 0.48 - 1.2 V Wide Operating Range with Far-end Pre-charge and Weak-Bit Tracking}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={A 3-nm single-port (SP) 6T SRAM macro has been proposed using far-end pre-charge (FPC) circuit and weak-bit (WB) tracking circuit. These circuit can reduce write cycle time to boost the pre-charge time and read cycle time to improve the trackability of supply voltage. We designed and fabricated a 434kbit SP SRAM macro on 3-nm FinFET technology. The bit density is $27.6-\mathrm{Mbit} / \mathrm{mm}^{2}$ and achieved 1.9GHz operation at $0.75 \mathrm{~V}$ which is 35% faster than conventional performance.},
  keywords={Time-frequency analysis;Temperature dependence;Random access memory;Voltage;Very large scale integration;FinFETs;Delays;SRAM;3-nm FinFET;Cache family;Far-end pre-charge;Weak-Bit tracking},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185429},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185420,
  author={Moroz, Victor and Svizhenko, Alexei and Choi, Munkang and Asenov, Plamen and Lee, Jaehyun},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Exploring Power Savings of Gate-All-Around Cryogenic Technology}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Operating CMOS circuits at cryogenic temperatures is becoming the most promising way to reduce power consumption of server farms [1–5]. This becomes possible by drastically reducing power supply voltage Vdd due to the steep subthreshold slope at low temperatures, avoiding 60 mV per decade “Boltzmann curse”. A key factor for reducing Vdd is a tight variability, which is enabled by the GAA (Gate-All-Around) technology [6–8]. In this work, we explore possible reduction of power consumption by operating GAA logic circuits at cryogenic temperatures. Besides, we estimate the combined power consumption of logic at cryogenic temperatures and the power required for cooling it.},
  keywords={Temperature distribution;Temperature dependence;Power demand;Gallium arsenide;Logic gates;Very large scale integration;Market research},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185420},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185351,
