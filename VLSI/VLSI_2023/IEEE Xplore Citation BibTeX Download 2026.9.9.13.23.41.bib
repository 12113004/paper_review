@INPROCEEDINGS{10185297,
  author={Kosuge, Atsutake and Sumikawa, Rei and Hsu, Yao-Chung and Shiba, Kota and Hamada, Mototsugu and Kuroda, Tadahiro},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 183.4nJ/inference 152.8μW Single-Chip Fully Synthesizable Wired-Logic DNN Processor for Always-On 35 Voice Commands Recognition Application}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={A 183.4nJ/inference single-chip wired-logic DNN processor that is capable of recognizing all 35 commands defined in the industrial standard voice recognition data set (Google Speech Command Dataset) is developed. The fully synthesizable processor recognizes 3.5 times more commands with 1.6 times better energy efficiency than the state-of-the-art analog processor while keeping design cost low. By implementing all the processing circuits and wiring required for the 16-layer DNN onto a single chip (7.63 mm2 in 40nm), the need to store weight coefficients and intermediate data in DRAM/SRAM is eliminated. Owing to the proposed architecture, a low power consumption of 152.8$\mu$W is achieved, which is low enough for always-on applications on battery-powered IoT devices.},
  keywords={Wiring;Power demand;Costs;Speech recognition;Very large scale integration;Energy efficiency;Internet of Things},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185297},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185296,
  author={Chang, En-Jui and Xue, Cheng-Xin and Deshpande, Chetan and Jedhe, Gajanan and Liang, Jenwei and Cheng, Chih-Chung and Lin, Hung-Wei and Lee, Chia-Da and Kumar, Sushil and Jway, Kim Soon and Guo, Zijie and Garg, Ritesh and Lu, Allen-Cl and Lin, Chien-Hung and Hsieh, Meng-Han and Lin, Tsung-Yao and Chen, Chih-Cheng},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 12-nm 0.62-1.61 mW Ultra-Low Power Digital CIM-based Deep-Learning System for End-to-End Always-on Vision}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This work proposes an ultra-low power DCIM-based DL system (DCIM-DLS) for end-to-end AoV with the power range from 0.62 to 1.61 mW (INT8, 2-15 fps). Compared to the prior art [3], the power consumption of DCIM-DLS can be reduced by 70.9% based on the following techniques: 1) an area and energy efficient DCIM that reduces compute RC loading by using pushed-rule 2p8T SRAM bitcell with folded kernels selector, 2) a DCIM-friendly dataflow strategy with dual accumulators that minimizes the DCIM power of weight update and avoids redundant data movement for power saving, and 3) a reconfigurable DCIM control scheme that supports mixed-precision to further reduce power consumption.},
  keywords={Power demand;Art;Loading;Random access memory;Very large scale integration;Energy efficiency;Low-power electronics},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185296},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185279,
  author={Mittal, Rishabh and Shibata, Hajime and Patil, Sharvil and Krommenhoek, Erik and Shrestha, Prawal and Manganaro, Gabriele and Chandrakasan, Anantha P. and Lee, Hae-Seung},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 6.4-GS/s 1-GHz BW Continuous-Time Pipelined ADC with Time-Interleaved Sub-ADC-DAC Achieving 61.7-dB SNDR in 16-nm FinFET}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, we present a continuous-time (CT) pipeline ADC with time-interleaved sub-ADC-DAC path in its first stage. The proposed sub-ADC-DAC path helps in increasing the ADC bandwidth by improving the signal cancellation at the stage-1 summing node. We have also designed an inductorless delay line for the first stage to improve amplitude and phase matching which reduces the input signal leakage into the backend ADC. A prototype ADC was fabricated in 16nm FinFET process. The ADC achieves 61.7/60.8dB (low/high frequency) SNR over 1-GHz bandwidth. The active area is 0.77m$\mathrm{m}^{2}$ and the ADC consumes 240mW. The Schreier figure-of-merit ($\mathrm{FOM}_{\mathrm{S}}$) is 157.9dB which is amongst the best for ADCs with digitization bandwidth greater than 500MHz.},
  keywords={Pipelines;Prototypes;Bandwidth;Very large scale integration;Delay lines;FinFETs;Frequency conversion;Continuous-time (CT) ADC;pipeline ADC;time-interleaving;oversampling;anti-alias.},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185279},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185345,
  author={Chen, Hsiang-Wen and Lee, Seungjong and Flynn, Michael},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.024mm² 84.2dB-SNDR 1MHz-BW 3rd-Order VCO-Based CTDSM with NS-SAR Quantizer (NSQ VCO CTDSM)}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a VCO-Based Continuous-Time (CT) delta-sigma modulator (DSM) with a noise-shaping (NS) SAR quantizer for a 3rd order NTF. An anti-aliasing filter (AAF) enables this new hybrid architecture. The 28nm CMOS prototype NSQ VCO $\mathrm{CT}\sum\Delta$ achieves 84.2dB SNDR and 86.8dB DR within a 1MHz bandwidth while consuming 1.62mW at 100MS/s. The core circuit occupies only $0.024\mathrm{mm}^{2}$. No calibration or coefficient tuning is required.},
  keywords={Voltage-controlled oscillators;Prototypes;Bandwidth;Very large scale integration;Delta-sigma modulation;Noise shaping;Calibration},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185345},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185356,
  author={Javvaji, Sundeep and Bolatkale, Muhammed and Bajoria, Shagun and Rutten, Robert and Essink, Bert Oude and Beijens, Koen and Makinwa, Kofi and Breems, Lucien},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 6GHz Multi-Path Multi-Frequency Chopping CTΔΣ Modulator achieving 122dBFS SFDR from 150kHz to 120MHz BW}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Advances in CMOS technologies have led to the development of continuous-time ΔΣ modulators (CTDSMs) with GHz sampling rates that achieve better than-100dBc linearity and bandwidths above 100MHz. However, at low frequencies (below ~10MHz), their SNDR is limited by 1/f noise, which limits their use in radio receivers intended to cover both the AM and the FM bands. In this work, a multi-path multi-frequency chopping scheme is proposed to suppress 1/f noise, while maintaining interferer robustness, noise, spurious, and linearity performance. Implemented in a CTDSM sampling at 6GHz, it reduces its 1/f noise corner frequency by 22x and achieves −98.3dBc THD, 122dBFS SFDR in 120MHzBW.},
  keywords={6G mobile communication;Frequency modulation;Linearity;Receivers;Bandwidth;Very large scale integration;CMOS technology},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185356},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185281,
  author={Edler, Julius and Runge, Marcel and Linnhoff, Sebastian and Gerfers, Friedel},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 4.4 GS/s 220 MHz ΣΔ ADC with a Linearized Back-Gate Controlled GmC Filter}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a 4.4 GS/s220Mhz bandwidth continuous time sigma delta modulator with a linear GmC loop filter enabled by voltage tracking through multi-bit feedback and an active linearization scheme employing the back-gate node. An auxiliary amplifier drives the back-gate node of the main differential pair to linearize the overall $\mathrm{G}_{\mathrm{m}}(\mathrm{V}_{\mathrm{i}\mathrm{n}}$) curve. The fabricated prototype shows a 27dB reduction in third order intermodulation (IM3) products down to -78dBc and a SNDR of 62dB while consuming 22 mW, reaching excellent 49fJ/step power efficiency.},
  keywords={Tracking loops;Sigma-delta modulation;Maximum likelihood detection;Prototypes;Modulation;Voltage;Nonlinear filters},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185281},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185368,
  author={Zhang, Yuncheng and Sun, Zheng and Liu, Bangan and Qiu, Junjun and Xu, Dingxin and Zhang, Yi and Fu, Xi and You, Dongwon and Huang, Hongye and Madany, Waleed and Fadila, Ashbir Aviat and Liu, Zezheng and Wang, Wenqian and Xiong, Yuang and Shirane, Atsushi and Okada, Kenichi},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Time-Mode-Modulation Digital Quadrature Power Amplifier Based on 1-bit Delta-Sigma Modulator and Transformer Combined FIR FIlter}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper proposes a Time-Mode Modulation (TMM) digital quadrature power amplifier (PA), which can realize high efficiency at power back-off (PBO) by applying the proposed 1-bit DSM and transformer (XFMR) combined FIR filter. The 1-bit Delta-Sigma Modulator (DSM) and digital mixer encode the input into a 2-level intrinsically linear on/off signal for TMM operation. The XFMR combined FIR filter suppresses the DSM quantization noise to avoid efficiency degradation and is insensitive to delay mismatches. The TMM PA is fabricated in 65 nm CMOS. Without digital pre-distortion (DPD), it achieves 26.4% efficiency with 40MS/s 64-QAM at 2.6GHz and supports 256-QAM.},
  keywords={Degradation;Quantization (signal);Finite impulse response filters;Power amplifiers;Modulation;Very large scale integration;Transformers;Power Amplifier;DSM;Quadrature;CMOS;DPD},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185368},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185245,
  author={Song, Minyoung and Allebes, Erwin and Marshall, Chris and Bhat, Anoop Narayan and Bechthum, Elbert and Dijkhuis, Johan and Traferro, Stefano and Tiurin, Evgenii and Vis, Peter and Heuvel, Johan van Den and Soussi, Mohieddine El and Boer, Pepijn and Sheikh, Alireza and Meyer, Bernard and Liu, Jiang and Ven, Stan van der and Winkel, Nick and Hijdra, Martijn and Ramachandra, Gururaja Kasanadi and Baykal, Yunus and Visser, Huib and Zhang, Peng and Breeschoten, Arjan and Liu, Yao-Hong and Bachmann, Christian},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An 8.7 mW/TX, 21 mW/RX 6-to-9GHz IEEE 802.15.4a/4z Compliant IR-UWB Transceiver with Pulse Pre-Emphasis achieving 14mm Ranging Precision}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents an IEEE 802.15.4a/4z compliant IRUWB transceiver for high-precision ranging. By virtue of the proposed digital deserialization-serialization, the TX can generate the Inter-Symbol-Interference (ISI) free IEEE 802.15.4a/4z packet. The proposed analog Finite Impulse Response (FIR)-based TX pre-emphasis improves $3.5 \times $ ranging precision without substantial power overhead and fulfills the spectrum requirement of the standard and the worldwide UWB regulations. The presented transceiver consumes 8.7 mW in TX mode and 21 mW in RX mode.},
  keywords={IEEE 802.15 Standard;Very large scale integration;Transceivers;Distance measurement;Regulation;Standards},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185245},
  ISSN={2158-9682},
