  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Circuit designs for practical-scale fault-tolerant quantum computing}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={To demonstrate reliable and scalable quantum computation, we need quantum error correction to reduce its error rates. One of the most challenging parts of implementing quantum error correction is to design error-decoding units, which estimate errors during computation. We estimate the required performances of error-decoding units to run practical-scale quantum algorithms and discuss the directions to satisfy them.},
  keywords={Flowcharts;Fault tolerance;Quantum computing;Quantum algorithm;Error analysis;Fault tolerant systems;Very large scale integration;Quantum computing;Quantum error correction;Fault-tolerant quantum computing.},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185351},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185412,
  author={Inoue, Hisashi and Tamura, Hiroto and Kitoh, Ai and Chen, Xiangyu and Byambadorj, Zolboo and Yajima, Takeaki and Hotta, Yasushi and Iizuka, Tetsuya and Tanaka, Gouhei and Inoue, Isao H.},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Long-time-constant leaky-integrating oxygen-vacancy drift-diffusion FET for human-interactive spiking reservoir computing}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Reservoir computing is one of the best feasible means of information processing that does not require substantial computation, such as backpropagation. Implementation using spiking neural networks is promising for real-time and low-energy computation that can be completed by edge devices alone. The key parameter is a time constant $\tau_{\mathrm{n}}$ of the neurons, which should be close to that of external stimuli and can be on the order of milliseconds for human-interactive reservoir computing. Here, we present a slow spiking neuron based on an oxygen-vacancy drift-diffusion field-effect transistor (ODD-FET). In these transistors, the slow migration of oxygen vacancies mimics a leaky integration with $\tau_{\mathrm{n}}$ on the order of 10 to 100 ms. The feasibility of the proposed ODDFET on the human-interactive application is demonstrated by a spiking reservoir composed of these neurons, which can accurately detect handwriting anomalies.},
  keywords={Backpropagation;Neurons;MIMICs;Field effect transistors;External stimuli;Information processing;Very large scale integration;reservoir computing;drift diffusion;spiking neural network;anomaly detection;oxygen vacancy},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185412},
