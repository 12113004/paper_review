  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Doping-Optimized Back-illuminated Single-Photon Avalanche Diode in Stacked 40 nm CIS Technology Achieving 60% PDP at 905 nm}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={We report on back-illuminated single-photon avalanche diodes (SPADs) based on 40 nm CIS technology. The SPAD performance is optimized with doping engineering, enabling the extension of the effective active area resulting in much higher efficiency. It achieves a dark count rate (DCR) of $15 \mathrm{cps} / \mathrm{\mu m}^{2}$, timing jitter of 97 ps, and excellent photon detection probability (PDP) in near-infrared (NIR) wavelength of about 60% at 905 nm and 44% at 940 nm at the excess bias voltage $\left(V_{E}\right)$ of 2.5 V.},
  keywords={Temperature measurement;Timing jitter;Breakdown voltage;Voltage measurement;Three-dimensional displays;Wavelength measurement;Simulation},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185229},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185224,
  author={Swaminathan, Raja and Schulte, Michael J. and Wilkerson, Brett and Loh, Gabriel H. and Smith, Alan and James, Norman},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={AMD InstinctTM MI250X Accelerator enabled by Elevated Fanout Bridge Advanced Packaging Architecture}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={The recent advancement of leadership class supercomputers was enabled by Frontier, the world’s first Exascale supercomputer, leveraging AMD EPYCTM CPU and AMD InstinctTM GPU accelerators. Meeting the compute density and efficiency targets was beyond traditional Moore’s Law silicon scaling; accordingly, innovations in the AMD CDNATM architecture and design as well as packaging and platform architectures were required. AMD utilized an advanced packaging architecture known as Elevated Fanout Bridge (EFB) to fabricate the accelerator engine with integrated High Bandwidth Memory (HBM). EFB has proven to be a cost-effective and reliable packaging technology with the ability to meet the current performance requirements for HBM2e and to scale for future architectures.},
  keywords={Technological innovation;Memory management;Bridge circuits;Computer architecture;Packaging;Very large scale integration;Trademarks;Advanced Packaging;AMD;EFB;EPYC;ExaFLOP;Exascale;Frontier;Instinct},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185224},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185238,
  author={Tung, Chih-Hang and Yu, Doug C.H.},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An Integrated System Scaling Solution for Future High Performance Computing}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Transistor and system parallel tracks scaling will drive the scaling trends in semiconductor Performance, Power, Area/Formfactor, and Cost (PPAC). System scaling includes 3D/2.5D wafer level integration and heterogeneity. 3D FabricsTM scaling continues with system vertically scaling up, laterally scaling out, and interconnection pitch scaling in, all significantly contribute to system PPAC optimization. Latest 3D Fabrics pitch scaling are demonstrated for the first time. Another important scaling trend will be discussed is to incorporate in-package photonics heterogeneous integration, for PPAC scaling. 3DFabrics classical scaling, and heterogeneous photonics integration are the two pillars for future system scaling.},
  keywords={Three-dimensional displays;High performance computing;Multichip modules;Integrated circuit interconnections;Very large scale integration;Market research;Fabrics},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185238},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185308,
