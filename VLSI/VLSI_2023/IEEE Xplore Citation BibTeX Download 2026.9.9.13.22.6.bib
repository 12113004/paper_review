  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={A self-referenced distributed on-chip scheme is introduced to achieve continuous detection of laser voltage probing (LVP) attacks against digital IPs with full-area coverage via temperature sensing. Calibration-free, automated and design-agnostic adoption are enabled by a stdcell-based approach, offering a 2.5X area overhead reduction compared to prior art.},
  keywords={Temperature sensors;Art;Lasers;Voltage;Very large scale integration;System-on-chip;Sensors;HW security;laser voltage probing;cryptography},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185360},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185225,
  author={Gupta, Animesh and Kumar, Sayan and Konandur, Viveka and Taneja, Sachin and Alioto, Massimo},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Visual Content-Agnostic Novelty Detection Engine with 2.4 pJ/pixel Energy and Two-Order of Magnitude DNN Activity Reduction in 40 nm}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={An engine to identify frames with novel content in a video stream is proposed as additional vision pipeline stage following conventional saliency detection. Based on connected component analysis with mean-center tracking, its complexity is reduced to linear compared to quadratic in prior art. This introduces frame-level temporal sparsity for subsequent DNN activity/power reduction (177X beyond saliency detection). 2.4 pJ/pixel energy is achieved in 40 nm.},
  keywords={Visualization;Art;Pipelines;Very large scale integration;Streaming media;Complexity theory;Engines;computer vision;low power;neural net gating},
