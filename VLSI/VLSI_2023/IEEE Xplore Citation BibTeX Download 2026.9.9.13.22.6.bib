  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Proactive Power Regulation with Real-time Prediction and Fast Response Guardband for Fine-grained Dynamic Voltage Droop Mitigation on Digital SoCs}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={A proactive power regulation scheme for mitigating dynamic supply droop is proposed with a fully-integrated buck converter, a CPU core and a real-time machine learning (ML) engine. Combined with droop guardband circuits, the proactive scheme demonstrates up to 9.9% higher CPU frequency or 9.2% higher power efficiency compared with prior fast LDO scheme or conventional converters using a 65 nm test chip.},
  keywords={Buck converters;Machine learning;Very large scale integration;Frequency conversion;Regulation;Real-time systems;Central Processing Unit},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185397},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185254,
  author={Augustine, C. and Meinerzhagen, P. and Lim, W. and Veerabathini, A. and Bright, M. and Mojjada, K. and Tschanz, J. and Khellah, M. and De, V.},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 2.6 mV/b Resolution, 1.2 GHz Throughput, All-Digital Voltage Droop Monitor Using Coupled Ring Oscillators in Intel 4 CMOS}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={We present an all-digital voltage droop monitor (VDM) with coupled ring-oscillators (CoRO) for accurate in-situ droop monitoring every clock cycle. Measurements from a 3.2mm2 testchip in Intel 4 CMOS containing 9 3-way CoRO and baseline RO VDMs demonstrate 3X improvement in CoRO resolution $(\sim 2.6$ mV/b) over the baseline. In addition, measurements show $3 \sigma$ uncertainty (repeatability) error of CoRO VDM (+/-9mV) is $\sim25$ % lower than the baseline. The overall droop detection error improvements achieved by CoRO VDM are 12mV, 15mV and 17mV, respectively, depending on the type of calibration used - per instance/temperature/die, per temperature/die, or per die. This corresponds to associated IP power savings of 2.9%, 3.2% and 3.7% during functional use.},
  keywords={Temperature measurement;Temperature sensors;Ring oscillators;Uncertainty;Measurement uncertainty;Very large scale integration;Throughput},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185254},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185360,
