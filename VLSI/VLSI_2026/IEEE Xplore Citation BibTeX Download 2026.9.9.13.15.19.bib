  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 1.58-W/mm2 Extreme-Power-Density Ka-Band GaN PA with Electro-Thermal-Mechanical Co-Design in CMOS+GaN Heterogeneous Integration}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a comprehensive electro-thermal-mechanical co-design methodology for CMOS+GaN heterogeneous integration, validated using a Ka-band GaN power amplifier (PA) with a record power density of 1.58 W/mm2. To mitigate reliability risks from extreme heat flux, we propose a reliability-aware packaging strategy using an Aluminum Nitride (AlN) substrate. We optimize the Residual Copper (RC) rate to address the trade-off between thermal dissipation and mechanical stress. Fabricated in a 150-nm GaN-on-SiC process, the compact 2.30-mm2 PA chiplet delivers a saturated output power of 35.6 dBm(3.6 W) with a peak power-added efficiency (PAE) of 32.0%. This work demonstrates that the proposed co-design framework ensures system robustness even under aggressive power scaling.},
  keywords={Generative adversarial networks;Dies;Printing;Design methodology;Ka-band;Substrates;Technology;Gain;GaN power amplifier;Ka-band;heterogeneous integration;high power density;electro-thermal-mechanical reliability;co-design},
