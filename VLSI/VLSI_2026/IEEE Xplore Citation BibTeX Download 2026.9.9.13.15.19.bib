  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Interfacial-Layer-Free NCFETs Achieving $\mathbf{2 mV}$ Hysteresis, $\mathbf{27 mV}$ /dec SS, $\mathbf{2 mV/V}$ DIBL, and Record $2088 \mu \mathrm{A} / \boldsymbol{\mu} \mathrm{m}$ Ion at $\mathrm{V}_{\text{DS}}=\mathrm{V}_{\text{ov}}=0.5 \mathrm{V}$}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={To reduce $\mathrm{V}_{\text{DD}}$, not only a small subthreshold swing (SS) of 27 mV (minimum) and 53 mV (average from Ioff to $\mathrm{V}_{\mathrm{T}}$) $\text{mV} / \text{dec}$ with only 2 mV hysteresis, but also record high $\mathrm{I}_{\text {ON }}$ per footprint ($2088 \mu \mathrm{A} / \mu \mathrm{m}$ @ $\mathrm{V}_{\text{DS}}=\mathrm{V}_{\text{ov}}=0.5 \mathrm{V}$) are achieved by negative capacitance, with low CET (capacitance equivalent thickness) of 0.43 nm and no interfacial layer (IL). IL-free stacked ferroelectrics around $\text{Ge}_{0.95} \text{Si}_{0.05}$ nanosheets accomplish all the above with negligible DIBL ($2 \text{mV} / \mathrm{V}$) and demonstrate a promising path to future low power AI chips.},
