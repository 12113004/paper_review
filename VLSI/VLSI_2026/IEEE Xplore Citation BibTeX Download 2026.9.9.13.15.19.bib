  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 6.8W 91.3%-Peak-Efficiency Coupled Micro-Inductor-Based Bidirectional Isolated Converter with Tri-State Magnetic Charging for Battery Active Cell Equalization}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A coupled micro-inductor (CMI)-based bidirectional isolated converter for battery cell equalization is proposed. With tri-state magnetic charging, the converter operates in BCM, DCM and LRBM modes in a varying load current, with a fsw from 4.2 kHz to 1.25 MHz. With active cell equalization, it supports $\text{CC} / \text{CV}$ balance control with a maximum 1.6 A load current, achieving 99.2% SOC accuracy and 10 mV droop voltage. At $12 \mathrm{V} \mathrm{V}_{\text{IN}}$, peak efficiency is 91.3% in charge state and 90.7% in discharge state respectively.},
  keywords={Cells (biology);Converters;Current;Switches;Loading;Voltage;Batteries;Timing;Displays;Indexes},
