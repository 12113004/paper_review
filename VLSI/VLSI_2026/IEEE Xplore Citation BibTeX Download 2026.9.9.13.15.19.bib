  doi={10.1109/VLSITechnologyandCir65830.2026.11577361},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577570,
  author={Yang, Junjie and Yu, Jingjing and Chang, Hao and Lao, Yunhong and Cui, Jiawei and Yang, Han and Yang, Xuelin and Liu, Xiaosen and Wang, Maojun and Shen, Bo and Wei, Jin},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={6.5 kV Enhancement-Mode GaN Monolithic Bidirectional Switch (MBDS) Achieving Record Power Figure of Merit}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work reports 6.5-kV GaN monolithic bidirectional switch featuring symmetric gate termination extensions (GTEMBDS). The introduced GTE effectively modulates the electric field distribution under bidirectional stress to enhance breakdown voltage and to harden stability. Thus, the GTEMBDS with an $L_{\text{GG}}$ of $62 \mu \mathrm{m}$ exhibits symmetric breakdown voltages $(B V \mathrm{s})$ of −7874 V and 7884 V. With a specific ONresistance $(R_{\text{SP}})$ of $25.97 \mathrm{m} \Omega \cdot \text{cm}^{2}$, GTE-MBDS achieves a high figure of merit $(\text{FOM} =B V^{2} / R_{\text{SP}})$ of $2.39 \text{GW} / \text{cm}^{2}$. Both the $B V$ and FOM represent record values among reported MBDS in SiC, GaN and $\text{Ga}_{2} \mathrm{O}_{3}$. Furthermore, for the first time, this work reports the dynamic $R_{\text{ON}}$ performance of GaN MBDS up to $2-\text{kV}$ stress, demonstrating a decent dynamic $R_{\text{ON}} /$ static $R_{\text{ON}}$ ratio of 1.43 after 2-kV stress at $150{}^{\circ} \mathrm{C}$. In addition, negligible conduction degradation was observed after holding the GTE-MBDS for $10^{3} \mathrm{s}$ at 3 kV and 150 °C.},
  keywords={Electric fields;Generative adversarial networks;Human factors;Stress;Printing;Displays;Indexes;Indexing;Breakdown voltage},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577570},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577439,
