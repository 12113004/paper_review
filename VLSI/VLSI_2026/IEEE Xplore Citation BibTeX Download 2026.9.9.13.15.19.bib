  title={CPU Cores in GAA with Backside Power: Silicon-Validated Design Insights}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents key design learnings from CPU cores implemented in Gate-All-Around (GAA) transistors with Backside Power Delivery (BSPD), contrasting with FinFET technologies. Silicon data reveals improved translation of transistor improvements to core frequency, especially at low voltages (30% frequency at $\sim 0.5 \mathrm{V})$ because of lower Vt and reduced IR drop. GAA-BSPD designs exhibit altered behavior in frequency sensitivity to Vcc and temperature, while posing MCMM (multi-corner multi-mode) tool challenges. Lower Vt and IR drop expose more of the Local Layout Effects (LLE), necessitating enhanced front-end modeling. As lower Vt provides lesser benefits at high voltage in GAA-BSPD designs, we demonstrate through presilicon analysis that adding coarse-pitch metal layers serves as a low-cost, high-Vcc performance booster, improving power and frequency via reduced capacitance and wiring congestion (lower coupling = fewer Signal Integrity issues).},
  keywords={Displays;Indexes;Indexing;Design methodology;Modeling;Frequency;Silicon;Central Processing Unit;Metals;Transistors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577340},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577450,
  author={Sonawane, Jay and Deng, Sunbin and Lee, Kiseok and Waqar, Faaiq and Zhang, Chengyang and Phadke, Omkar and Datta, Suman and Yu, Shimeng},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={FAB Gain Cell Memory: A Folded Asymmetric Boosted Design to Improve Sense Margin for a Refresh-Free Operation}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We propose a folded asymmetric boosted 3T gain cell (GC) to enable a refresh-free, high-speed on-chip memory, using amorphous oxide semiconductor (AOS) FETs. An underlapped write FET suppresses write WL coupling, while an overlapped storage/read gating FET enables read WL driven storage node (SN) boosting through a preferential capacitive coupling. This boosting operation shifts the sensing operation out of the near-threshold regime, improving $\mathrm{V}_{\text{TH}}$ variation tolerance. The measurements show a 1.48 V boosted memory window (at $\mathrm{V}_{\text{DD}}=1 \mathrm{V}$) and $>300 \mathrm{s}$ at $85{ }^{\circ} \mathrm{C}$ data retention (3 orders of improvement over conventional 3T GC). The projected 7nm FAB design shows 2.6 ns read delay and satisfies the refresh-free requirement for GPU last-level cache, given maximum data lifetime profiled from AI workloads.},
  keywords={Boosting;Tin;Printing;Writing;Field effect transistors;Timing;Joining processes;Arrays;Couplings;Displays},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577450},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577397,
  author={Kim, Hyoungjun and Chen, Ethan and Chen, Vanessa},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Hybrid Processing-In-Sensor Architecture With a Computational Mosaic Array and Residual-Enhanced Analog Skip Connections for Robust Color Vision}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a hybrid Processing-in-Sensor (PIS) architecture for always-on color vision. The proposed sensor employs a Computational Mosaic Array (CMA) that enables 4 b in-pixel convolution while achieving a 55 % reduction in photodiode area. Filter-less color computation is enabled by triple-well photodiodes, and the proposed time-domain median pooling achieves 98.8 % data reduction. A residualenhanced analog skip connection is incorporated to improve robustness against analog mismatch and noise. A $126 \times 126$ CMOS 180nm sensor array consumes $62.08 \mu ~\mathrm{W}$ at 40 fps with iFoM of $97.76 \text{pJ} /$ pixel frame, achieving 97.25 % accuracy on face detection task.},
  keywords={Timing;Pixel;Arrays;Image sensors;Color;Architecture;Computer architecture},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577397},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577297,
