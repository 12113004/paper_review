  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A CMOS Energy Harvesting System Integrating SIDO/DISO Continuously-Scalable-Conversion-Ratio SC Converter and Energy-Recycling BSI Photovoltaics}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We present a near-infrared energy harvesting system that integrate a continuously-scalable-conversion-ratio (CSCR) switched-capacitor (SC) converter, backside-illuminated (BSI) CMOS photovoltaics (PVs), a maximum power point tracking (MPPT), and all controls in a single chip. The PVs recycle incident BSI light to enhance photo-collection efficiency ($\eta_{\text{PC}}$) and enable 3-D stacking of energy-reservoir capacitors by optical grating and reflector. The CSCR SC converter alternates between single-input-dual-output and dual-input-single-output with low ripple according to MPP and improves power conversion efficiency ($\eta_{\text{PCE}}$) via adaptive virtual level selection and flying capacitor-split schemes. The system achieves $21 \% \eta_{\text{PC}}$ at low illumination intensity of $90 \mu \mathrm{W}/\text{mm}^{2}$ and 91.1% peak $\eta_{\text{PCE}}$.},
