  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={µAgent: A 7nm 404.3mJ/Action Edge SoC for Agentic AI Reasoning with Adaptive Block-Wise Mixed-Format 4-Bit Quantization and Decoupled Access-Execute}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={$\mu$ Agent is a $4 \text{mm}^{2} 7 \text{nm}$ SoC for on-device agentic AI reasoning with an edge-targeted large language model (LLM), using only 64 MB of off-chip HyperRAM. Its LLM accelerator, $\mu$ Thinker, reduces external memory access via block-wise mixed-format 4-bit quantization with adaptive block/element size. $\mu$ Thinker efficiently couples to the CPU via a coprocessor interface and decoupled access-execute streams, minimizing communication stalls. $\mu$ Agent operates up to 1.22 GHz and achieves $404.3 \text{mJ} /$ Action while outperforming standard quantization formats (INT4/FP4) on navigation tasks.},
  keywords={Quantization (signal);Modeling;Memory;Indexes;Indexing;Large language models;Printing;Displays;Media Access Control;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577534},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577598,
