  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 10-MHz Integrated Voltage Regulator with Cycle-Accurate and Lightweight Predictive Control Achieving 5-mV Off-Chip Droop}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a $10-\text{MHz}$ integrated voltage regulator featuring cycle-accurate, lightweight predictive control. A bandwidth-matched weighted training scheme selects 78 sparse transition detectors (TDs) that capture only power-delivery-network-shaped (PDN) frequency components. These TDs are used to predict the cycle-accurate core current $(I_{\text{Core}})$; an adaptive PDN emulator with in-situ calibration then maps $I_{\text{Core}}$ to the regulator-relevant load-current envelope $I_{\text{Load}}$ for proactive regulation. Across 18 workloads, the predictor achieves 3.3% normalized root-mean-square error (NRMSE) on $I_{\text{Core}}$, which translates to 1.5% NRMSE on $I_{\text{Load}}$. Fabricated in $28-\text{nm}$ CMOS, the DC-DC prototype supports 0.81-A load steps with $66-\text{ns}$ edges, suppresses on-die second droop from $72-\text{mV}$ to less than $6-\text{mV}$, and reaches 90.1% peak efficiency.},
  keywords={Loading;Regulators;Dies;Bandwidth;Printing;Current;Displays;Indexes;Indexing},
