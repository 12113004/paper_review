  number={},
  pages={1-3},
  abstract={We present a full-surround anode SPAD (FS-SPAD) fabricated in a back-illuminated 90 nm CMOS image sensor (CIS) foundry technology with high-performance timing jitter for short/mid-range dTOF sensors. The FS-SPAD improves carrier transport by co-optimizing the p-epitaxial (p-epi) layer and the anode, which is ease-modification with other non-isolated SPADs. The SPAD achieves a breakdown voltage $(V_{B})$ of 15.8 V and demonstrates a timing jitter of 49 ps (FWHM), a photon detection probability (PDP) of 24.2%, and a normalized dark count rate (nDCR) of $12.57 \text{cps} / \mu \mathrm{m}^{2}$.},
  keywords={Single-photon avalanche diodes;Timing jitter;Technology;Printing;Bismuth;Business intelligence;Very large scale integration;Anodes;LiDAR;SPAD;Timing Jitter;Physical AI;PDP},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577590},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577347,
  author={Jang, Hyeong-Seok and Kim, Munhyeon and Hu, Luhing and Shim, Jaewoo and Kim, Joonyun and Seol, Minsu and Kim, Sang Won},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Device-to-Architecture Co-Design of Monolithic 3D FPGA Using 2D Transistor}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a measurement-driven monolithic 3D (M3D) field-programmable gate arrays (FPGAs) enabled by vertically integrated SRAM using two-dimensional (2D) semiconductor devices. We propose a new FPGA architecture in which the block RAM (BRAM) based on transition metal dichalcogenide (TMD)-channel transistor is monolithically stacked directly above Si CMOS logic blocks. The feasibility of the approach is experimentally validated through integration of logic gates by using MoS2 NMOS and WSe2 PMOS transistors and translated into SPICE models for both circuit-and system-level evaluation. Based on the measured models, a stacked TMD-channel-based BRAM macro is designed for the first time and validated in terms of stability and functionality. When evaluated using Verilog-to-Routing (VTR)-based benchmarks, the proposed approach achieves 59% area reduction and 13% critical path delay improvement over a conventional FPGA. This work demonstrates that M3D memory integration can provide tangible system-level benefits for next-generation FPGA architectures.},
  keywords={Field programmable gate arrays;SRAM chips;Modeling;Memory;Design methodology;Stacking;Architecture;Computer architecture;Silicon;Technology;M3D;2DMs;FPGA;3D SRAM},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577347},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577552,
  author={Yang, Heesoo and Kim, Hyeongjun and Choi, Yurim and Lee, Seungmin and Kam, Dongyun and Jung, Haksoon and Lee, Yongwoo and Kim, Seongju and Kwon, Jimin},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Vertical-Die (V-die) 3.5D Integration for Cool Ultrahigh-Bandwidth Memory Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work explores a 3.5D V-die memory architecture as an alternative integration paradigm, where conventionally fabricated DRAM dies are rotated upright to exploit three-dimensional space at the system level. We assess the feasibility of the V-die concept by benchmarking its achievable bandwidth, capacity scalability, and thermal behavior against state-of-the-art HBM. By standing dies upright to expand exposed surface area and enabling direct liquid cooling between adjacent dies, V-die supports substantially higher thermal design power while unlocking scalable I/O density and capacity beyond conventional HBM.},
  keywords={Dies;Bandwidth;DRAM chips;Memory;Modeling;Technology;Architecture;Computer architecture;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577552},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577422,
  author={Yang, Sheng and Bömmels, Jürgen and Kükner, Halil and Bufler, Fabian M. and Verschueren, Lynn and Mertens, Hans and Vandooren, Anne and Horiguchi, Naoto and Farokhnejad, Anita and Hellings, Geert},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Double-Flip Sequential CFET: Superior 3T Library Efficiency and PPA}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Double-flip sequential CFET (sCFET) architecture enables split-gate devices and dense BM0 routing, supporting 3-track standard cells with high library efficiency. Hybrid orientation and asymmetric nanosheet widths in sCFET further optimize device-level PPA, offering scaling potential.},
  keywords={Cells (biology);Printing;Libraries;Layout;Joining processes;Capacitance;Displays;Indexes;Indexing;Optimization},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577422},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577514,
  author={Kikushima, Fumie and Murakami, Yosuke and Aoike, Hideomi and Yoshitaka, Naoya and Yamauchi, Kazuhiro and Hizume, Yuma and Miyachi, Katsunori and Ogura, Tatsuo and Fukumoto, Atsushi and Kaneyama, Junichi and Sasaki, Yusuke and Moriyama, Takumi and Hosoda, Naohiro and Takuma, Shunsuke and Tsutsumi, Masanori and Isogai, Tatsunori and Takeda, Hiroshi},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Deposition Process-Based Charge Trap Layer Segmentation for 3D Flash Memory Achieving Improved Cell Reliability While Maintaining Program/Erase Characteristics}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={In this study, we propose a 3D flash memory incorporating a pseudo-segmented charge trap layer (CTL) structure formed by a deposition process-based CTL segmentation scheme. By keeping part of the CTL continuous, program slope degradation is suppressed, and the simulated CTL thickness margin-which maintains the program slope and improves cell-to-cell interference (C2C)-is larger than that of fully segmented CTL cells. The demonstrated pseudo-segmented CTL cells achieve a 29% reduction in C2C and a 44% reduction in lateral charge loss (LCL). The word line (WL) pitch scalability for unstressed cells is estimated to be 8 nm for triple-level cells and 10 nm for quadruple-level cells.},
  keywords={Cells (biology);Programming;Displays;Indexes;Indexing;Memory;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577514},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577362,
  author={Kwon, Ohhyuk and Lee, Junyoung and Jung, Jaemin and Yang, Siyoung and Park, Kwangmin and Choi, HanMei and Park, Sejun and Hwang, Hyunsang},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Uniform and Direction-Controllable Metal-Induced Lateral Crystallization for 3D NAND Flash Memory via $\text{NiSi}_{2}(111)$-Oriented Seed Layer Transfer}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper reports a growth-direction-controllable Metal-Induced Lateral Crystallization (MILC) technique to overcome the self-blocking issue caused by the stochastic collision of randomly oriented whiskers in high-aspect-ratio channels. Utilizing a seed layer transfer process, we effectively suppressed random nucleation and successfully guided MILC whiskers along a predefined orientation. This method guarantees stable and continuous crystallization by minimizing whisker collisions. We validated the proposed technology in a 155-layer 3D NAND structure, demonstrating significant improvements in crystallinity. This work highlights the critical role of whisker directionality and provides essential guidelines for implementing MILC in future 3D NAND architectures.},
  keywords={Crystallization;Seeds (agriculture);Nickel;Silicon;Technology;Displays;High-resolution transmission electron microscopy;Indexes;Indexing;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577362},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577209,
  author={Zhang, Yichen and Liang, Yaogan and Ide, Michihiro and Takamiya, Makoto},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={4.5-W 5-V-Input DC-DC Converter with Six Isolated 15-V Outputs Achieving 175-kV/μs CMTI Without Signal Isolators}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={To reduce the volume of isolated DC-DC converters using bulky transformers and signal isolators for the gate drivers, a compact single input, six isolated output DC-DC converter using a single PCB transformer for both power and signal transfer is proposed. The proposed sensing for TX input power control prevents efficiency degradation even when subjected to large common-mode transient (CMT) without signal isolators. Fabricated in 180nm BCD process, the proposed converter with $>3 \text{kV}$ isolation and $314 \text{mm}^{3}$ per output achieved 67% efficiency and CMTI of $+175 /-167 \text{kV} / \mu \mathrm{s}$ at single 5 V input, six 15 V isolated outputs, and 4.5 W total power.},
  keywords={DC-DC power converters;Converters;Printing;Power control;Transformers;Degradation},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577209},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577436,
  author={Tan, Fei and Berner, Raphael and Zhao, Zhongyu and Xie, Yuhan and Joudi, Amirmahdi and Fu, Yiheng and Sakr, Icare and Collin, Thibault and Rouanne, Vincent and Lorach, Henri and Un, Ka-Fai and Mak, Pui-In and Bloch, Jocelyne and Courtine, Gregoire and Shoaran, Mahsa},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 64-Channel, Low-Power End-to-End Transformer-Based BCI SoC for Efficient Motion Intention Decoding}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Real-time brain-computer interfaces (BCIs) demand fully on-chip neural decoding with tight power, area, and latency budgets. This work presents the first fully-integrated transformer-based BCI SoC that performs energy-efficient motion intention decoding from ECoG signals. The chip integrates a 64-channel analog front-end (AFE) and a distilled, light-weight transformer-based decoder featuring customized 7T-SRAM computing-in-memory (CIM) macros with hybrid sign-magnitude and two's-complement (SM-2C) computation. Fabricated in 65nm, the decoder achieves a 67.8% accuracy on a 6-class upper-limb motion-intention dataset, consuming $47 \mu \mathrm{W}$ in $4.7 \text{mm}^{2}$, while the complete SoC occupies $10.1 \text{mm}^{2}$.},
  keywords={Decoding;In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;System-on-chip;Displays;Indexes;Indexing;Modeling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577436},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577363,
  author={Xiao, Qijing and Yang, Changgui and Sun, Junhong and Wang, Weixiao and Zhang, Yunshan and Hu, Xin and Huang, Kai and Zhao, Bo},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Cross-Band Wi-Fi/BLE Passive Tag Demonstrating Battery-Free Standard-Mask Communication with Smartphones and Battery-Free AoA Localization}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper demonstrates a Wi-Fi/BLE passive crystal-less tag achieving battery-free cross-band backscatter communication with smartphones. The proposed cross-band technique suppresses the image component of backscattered signal by more than 32 dB, which eliminates the self-jammer and enables battery-free angle-of-arrival (AoA) localization. Moreover, the polar-modulated pre-distortion mask-shaping technique makes this chip fully compliant with both Wi-Fi and BLE standard masks.},
  keywords={Wireless fidelity;Tagging;Backscatter;Batteries;Smart phones;Printing;Shape;Standards;Displays;Location awareness},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577363},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577644,
  author={Wang, Chun and Yong, Olivia Angel and Liu, Chenxin and Wang, Wenqian and Tian, Anyi and Shehata, Abanob and Kojima, Takumi and Herdian, Hans and Yamazaki, Yudai and Park, Sunghwan and Tang, Minzhe and Xu, Dongfan and Kato, Sena and Zhang, Yuncheng and Kunihiro, Kazuaki and Sakai, Hiroyuki and Okada, Kenichi},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 240–270 GHz $4 \times 4$ Bi-Directional Phased-Array Transceiver with On-Chip Half-Wavelength-Spaced Array and Ultra-Low Power Consumption in 65-nm CMOS}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 300-GHz-band 2D $4 \times 4$ bi-directional phased-array transceiver with on-chip half-wavelength-spaced array and ultra-low power consumption in 65-nm CMOS. Each element comprises a phased shifter, doubler, injection-locked tripler, sub-harmonic mixer, and on-chip dipole antenna, occupying a compact core area of 0.30 mm2. The power consumption of each element is 26 mW. The $4 \times 4$ phased-array features pitches of 0.49 - and 0.50 -wavelength in the E - and H planes, respectively, with measured main-beam scanning angles of $\pm 32^{\circ}$. The single chip achieves a peak EIRP of −17.1 dBm at 256 GHz.},
  keywords={Arrays;Timing;Displays;Indexes;Indexing;Phased arrays;System-on-chip;Printing;Technology;Bismuth;300-GHz-band;2D;bi-directional;phased-array;transceiver;on-chip;half-wavelength-spaced array;ultra-low power consumption},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577644},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577335,
  author={Lu, Jingguang and Zhou, Zuopu and Jiao, Leming and Zheng, Zijie and Xie, Jiawei and Hao, Weibing and Chand, Umesh and Ranjan, Akhil and Chien, Yu-Chieh and Lim, Khee Yong and Liang, Gengchiau and Gong, Xiao},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of Highly-Scaled Trench-Structured Ferroelectric Capacitive Memory with Record-High Capacitive Memory Window and Integrated ITO Sensing FET}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A highly-scaled inversion-type FCM is demonstrated with trench structure on silicon and scaled to minimum $0.02 \mu \mathrm{m}^{2}$. The MFS structure combined with high-aspect-ratio trench enables $\mathrm{a}>10 \times$ capacitance ratio and a record-high capacitance difference of $\sim 19 \mu \mathrm{F} / \text{cm}^{2}$. Integrating an ITO sensing FET with FCM, for the first time, we experimentally demonstrate the sensing of individual highly scaled FCM, validating the scalability of this emerging memory.},
  keywords={Capacitance;Memory;Voltage;Displays;Indexes;Indexing;Silicon;Polarization;Technology;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577335},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577498,
  author={Li, Shengman and Petty, Mary Vaughan and Safron, Nathaniel and Wei, Aslan and Natani, Shreyam and Zhong, Donglai and Lee, Sang Young and Wu, Aylee A and Bandaru, Prabhakar and Kummel, Andrew and Radu, Iuliana and Pitner, Gregory and Mitra, Subhasish and Wong, H.-S. Philip},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={10-nm-Gate-Length Nanosheet CNFET with Self-Aligned Extension Doping for Ambipolar Leakage Suppression}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={In this work, we demonstrate a self-aligned nanosheet carbon nanotube FET (CNFET) technology that fundamentally suppresses ambipolar leakage through localized extension doping. Doped extensions between the gate and contacts enable aggressive gate-length scaling down to 10 nm while achieving a high on-current of $1.2 \text{mA} / \mu \mathrm{m}$ and a low off-state current of $10 \text{nA} / \mu \mathrm{m}$ at $V_{\text{DS}}=-0.7 \mathrm{V}$, representing over $10 \times$ leakage reduction compared with prior CNFET reports. Systematic device comparisons reveal that highly doped extensions reduce leakage by $\sim 10 \times$ across both low and high drain bias, mitigate short-channel effects, and maintain high $I_{\max} / I_{\min}$ over more than 5 decades of gate-length scaling. Further, CNT diameter reduction from 1.4 nm to 1.1 nm increases the bandgap, yielding an additional $100 \times$ leakage reduction at $V_{\text{DS}}=-0.7 \mathrm{V}$ and SS of $95 \text{mV} / \text{dec}$.},
  keywords={Doping;Displays;Indexes;Indexing;CNTFETs;Printing;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577498},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577280,
  author={Li, Xiaguang and Yang, Chao and Yang, Shiheng and Du, Sijun and Zeng, Xiaoyang and Chen, Zhiyuan},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 6.78MHz Fully Integrated Dual-Output Symmetric 1/16-Cycle Regulating Rectifier Achieving 92.57% Efficiency and 3.7 V Voltage Difference}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 6.78-MHz fully integrated dual-output symmetric 1/16-cycle regulating rectifier that employs adaptive duty-ratio control and symmetry-based phase scheduling to enable fine-grained intra-cycle regulation with fast transient response and low ripple. In addition, dual-mode regulation, pulse merging, and gate-charge recycling effectively suppress ripple and balance transient performance and overall efficiency. The fabricated chip delivers up to 110 mW with fully integrated output capacitors, achieves a peak receiver efficiency of 92.57%, a maximum output voltage difference of 3.7 V, a 72.5% end-to-end efficiency, and the highest FoM with $>21 \times$ improvement compared to prior work.},
  keywords={Rectifiers;Voltage;Loading;Timing;Technology;Regulation;Transient analysis;Printing;Steady-state},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577280},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577371,
  author={Zhao, Guangshu and Sang, Haoyang and Wang, Chenxi and Wu, Hao and Zhang, Litao and Lin, Ningchao and Ma, Kaixue and Martins, Rui P. and Law, Man-Kay},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Universal Piezoelectric Energy-Harvesting Interface with Machine Learning-Based Excitation Identification and Cross-Topology MPPT for Diverse Input Vibrations}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents the first universal piezoelectric energy harvesting (PEH) interface that achieves machine learning (ML)-based coarse/fine excitation type identification and ML-assisted cross-topology maximum power point tracking (MPPT), capable of selecting the best-matched topology under distinct input excitation types. Moreover, by decomposing prior PEH topologies into a functional control framework, the proposed interface can realize arbitrary PEH topologies. The fabricated interface achieves near-normalized peak output across diverse excitations and a versatility FoM of 7.39, corresponding to a $1.3-2.4 \times$ compared with prior arts.},
  keywords={Topology;Maximum power point trackers;Electric shock;Shock (mechanics);Steady-state;Displays;Indexes;Indexing;Printing;Cams},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577371},
  ISSN={2158-9682},
  month={June},}
