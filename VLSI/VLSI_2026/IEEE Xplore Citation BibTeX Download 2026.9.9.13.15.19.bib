  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={High-Performance Normally-Off IGZO FeFETs with Thermally Stable Ru S/D for Power-Efficient Memory Arrays}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We propose a Ru source/drain (S/D) engineering strategy to achieve normally-off IGZO-based ferroelectric FETs (FeFETs) with a positive threshold voltage $(\mathrm{V}_{\text{th}})$. Owing to the high oxide formation energy of Ru, oxygen scavenging from the IGZO channel is suppressed, enabling stable $\mathrm{V}_{\text{th}}$ control under high-temperature annealing. Ru S/D FeFETs demonstrate excellent endurance up to 109 program/erase (PGM/ERS) cycles with maintaining positive $\mathrm{V}_{\text{th}}$. The resulting normally-off FeFETs enable energy-efficient read operation in 3D arrays, reducing read energy by 60% compared to conventional S/D devices.},
  keywords={Arrays;Displays;Indexes;Indexing;FeFETs;Annealing;Electrodes;Tin;Oxygen;Energy},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577607},
  ISSN={2158-9682},
