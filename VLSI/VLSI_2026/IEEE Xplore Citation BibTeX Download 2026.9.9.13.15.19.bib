  title={A 12 V-to-1V Scalable 2N-Phase Buck Converter Using 0V-Stress Balancer with Shortest $I_{\mathrm{L}}$ Balancing Path for Parallel IC Expansion in xPU Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a scalable 2 N -phase buck converter using a 0V-stress balancer with the shortest inductor current balancing path for parallel IC expansion in xPU systems. The proposed converter supports arbitrary phase expansion with all-phase interleaving. A prototype was tested using 1, 2, 3, and 4 chips (2,4,6, and 8 phases), and achieves peak efficiencies of 89.2% at 1.0 V and 90.4% at 1.2 V in 2-chip (4-phase) prototype.},
  keywords={Timing;Inductors;Printing;Buck converters;Video recording;Human factors;Measurement units;Stress;Switches},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577414},
  ISSN={2158-9682},
