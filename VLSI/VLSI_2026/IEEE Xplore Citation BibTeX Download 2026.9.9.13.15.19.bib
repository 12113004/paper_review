  month={June},}@INPROCEEDINGS{11577495,
  author={Moon, Sanghyuck and Huluvallay, Ashfakh and Chung, Hyunwon and Ko, Myeongsu and Jeong, Seokhyeon and Lee, Jungho and Khreishah, Mohammad and Chang, Jeongtaek and Do, Hung and Sutherland, Caitlyn and Kapit, Jason and Nicholson, David and Reinhardt, William and Sylvester, Dennis and Miskin, Mark and Blaauw, David},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 95.0 dB Dynamic Range Zero-Bias PV Light-to-Digital Converter for Seawater Monitoring with Single Point Calibration}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We present a single chip, self-zero-biased light sensor for sea-water analysis for application in a wireless underwater vehicle. The sensor achieves linear irradiance-to-frequency conversion, single point calibration, and light-proportional power consumption. It has a measured dynamic range of $56,500 \times$ with temperature-robust operation in 180 nm CMOS.},
  keywords={Lighting;Displays;Indexes;Indexing;Poles and zeros;Temperature;Distance measurement;Image sensors;Voltage;Very large scale integration},
