  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Cryo-CMOS Sub-1K 16nm FinFET DAC for Fast Two-Qubit Gates in Spin Qubits}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a cryo-CMOS DAC for driving two-qubit gates in semiconductor spin qubits. Thanks to a current-integrating coarse/fine architecture implemented in a 16-nm FinFET process, the proposed design generates adiabatic waveforms for very fast (<50 ns) high-fidelity operations, while operating at sub- 1 K temperatures with a small footprint (0.026 mm2) and low power ($275 \mu \mathrm{W}$), thus demonstrating its compatibility with qubit co-integration.},
  keywords={Qubit;Printing;Displays;Indexes;Indexing;Current;Technology;Very large scale integration;cryo-CMOS;spin qubits;quantum computing},
