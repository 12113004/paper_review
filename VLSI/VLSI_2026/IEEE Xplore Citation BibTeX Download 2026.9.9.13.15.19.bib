@INPROCEEDINGS{11577581,
  author={Kayano, Kosuke and Koh, Sang-Gyu and Sun, Shiyuan and Hamasuna, Satoshi and Miyasako, Takaaki and Hosokura, Tadasu and Yajima, Takeaki},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Highly Scalable and Noise-Robust Direct Digital Readout (DDRO) for E-Skin Temperature Sensor Arrays Achieving 12.2 pJ/Sensor and 710 ns/Row}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper proposes a scalable and noise-robust readout architecture for high-density multi-point e-skin applications, termed Direct Digital Readout (DDRO), which directly reads the binary outputs of phase-transition sensors using digital logic circuits. Conventional readout schemes based on analog sensors and analog-to-digital converters (ADCs) suffer from rapidly degraded signal margin and conversion accuracy as sensor arrays scale up, due to increased wiring noise and parasitic capacitance and resistance. By fully digitizing the signals on the interconnects, the proposed DDRO structurally suppresses noise sensitivity during array expansion and achieves high scalability for large-scale sensor arrays. A prototype system consisting of a flexible 1024-sensor array and a DDRO chip demonstrates a readout latency of 710 ns per row and a readout energy of 12.2 pJ per sensor. The proposed approach enables full-frame readout of all 1024-sensor array within $23 \mu \mathrm{s}$ while consuming 12 nJ.},
  keywords={Image sensors;Arrays;Sensor arrays;Voltage;Noise;Circuits;Energy;Resistance;Printing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577581},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577251,
  author={You, Hyeongyu and Nam, Geonwoo and Cho, Jaehee and Jeong, Minjae and Yu, Jisu and Do, Jungho and Jung, Hakchul and Baek, Sanghoon},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={High-Performance 2nm GAA Standard Cell Architecture Exploiting Backside Power Delivery via Dynamic Area Borrowing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Aggressive scaling of standard cells to a 5-track (5T) height in the 2nm GAA node creates a critical performance bottleneck by physically confining the maximum active width $(W_{\text{active}})$. To overcome this limitation, we propose dynamic area borrowing (DAB), a design-technology co-optimization (DTCO) architecture enabled by a backside power delivery (BPD) and direct backside contacts (DBC). By accommodating larger active cells via row-boundary area borrowing, DAB maximizes drive strength within a uniform cell footprint. The proposed DAB achieves a $5.0 {\%}-9.0 {\%}$ cell-level delay reduction and a $9.8 {\%} F_{\max}$ improvement in block-level evaluation on a representative ARM core without area overhead. Ultimately, DAB redefines the performance frontier of logic scaling in sub-2nm nodes, providing an effective solution for next-generation high-performance logic.},
  keywords={Cells (biology);Technology;Architecture;Computer architecture;Design methodology;Libraries;Printing;Very large scale integration;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577251},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577618,
  author={Hiroki, Mizuha and Takeuchi, Tatsuya and Nakamoto, Yuta and Silva, Yhang R. and Yoshimura, Yuki and Hagiwara, Hiroki and Takata, Ryotaro and Hotta, Kaihei and Nishikawa, Rui and Nishimura, Yuji and Yamaguchi, Shingo and Takayama, Ayumi and Nakamura, Ryosuke and Toyoshima, Takahiro and Sakano, Yorito and Oike, Yusuke},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 2.1-μm Pixel-Pitch CMOS Image Sensor with 65% MTF/35% QE IR Global Shutter and RGB Rolling Shutter Sequential Operation for In-Cabin Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={In this work, we propose a $2.1-\mu \mathrm{m}$ RGB-IR CMOS image sensor with sequential operation combining rolling shutter (RS) and global-shutter (GS) modes for in-cabin applications. As an RGB sensor, it achieves a dynamic range (DR) of 112 dB at $T_{j}=85^{\circ} \mathrm{C}$, enabling high-quality visible imaging. For the IR sensor, we achieve state-of-the-art characteristics with 65% modulation transfer function (MTF) and 35% infrared quantum efficiency (IR-QE), facilitating gaze detection under IR illumination.},
  keywords={Pixel;Image sensors;Displays;Indexes;Indexing;Printing;Timing;Lighting;Personal digital devices;Signal detection},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577618},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577206,
  author={Seok, Hyun-Gi and Kim, Sinyoung and Jung, Wonjun and Kim, Junhyeong and Park, Eunhye and Kim, Yeongdae and Lee, Jaekeun and Kang, Sumin and Myeong, Jonghoon and Seo, Duyong and Han, Honggul and Son, Hyeonuk and Jang, Junyoung and Kang, Hoon and Ahn, Chiyoung and Sung, Hyukjun and Kim, Wan and Park, Hyun-Chul and Park, Chan-Hong and Kim, Joonsuk},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An IEEE 802.15.4z-Compliant IR-UWB System-on-Chip with 27 dB Self-Interference Cancellation and Reconfigurable TIA for Automotive Radar and Ranging}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents an IEEE 802.15.4z-compliant UWB SoC with a TX spillover cancellation enabling shared-antenna fullduplex operation. The proposed PVT-robust FIR filter based SIC achieves 27 dB average rejection $(\sigma=1.4 \text{dB})$, improving the RX NF from 21 to 4 dB. A reconfigurable TIA supports both of low-power ranging and wide bandwidth radar modes using a feed-forward architecture. Child presence detection is demonstrated in a real vehicle using a certified infant dummy and human subjects, including worst-case legroom scenarios.},
  keywords={Silicon carbide;Displays;Indexes;Indexing;Pediatrics;Distance measurement;Radar;Antennas;Gain;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577206},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577286,
  author={Yu, Haochen and Jiang, Yixuan and He, Ruihao and Yu, Hao and Deng, Zihao and Jiang, Hongwu and Huang, Shanshi and Xu, Zefeng},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of High-Precision (15 Bits) Photonic-Electronic Hybrid Compute-in-Memory System Based on FeFET Pockels Photonic Memory}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a photonic-electronic hybrid high-precision computing-in-memory (CIM) system. By leveraging the cyclic output characteristic of Pockels photonic memory and residual number system (RNS) encoding, the proposed system is closed under multiplication and addition, significantly reducing signal-to-noise ratio (SNR) requirements. The ferroelectric field-effect transistor (FeFET) Pockels photonic memory utilizes the Pockels effect for waveguide modulation and the screening effect for in-memory multiplication. With RNS implemented in this hybrid system, the system achieves up to 15-bit computational precision, showing improvement of up to 42% in inference accuracy on transformer-based model and 10 dB in super-resolution task, compared to conventional analog CIM arrays.},
  keywords={Arrays;In-memory computing;Printing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Memory;Very large scale integration;Accuracy;Modeling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577286},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577336,
  author={Zaffin, S. and Leoncini, M. and Bertolini, A. and Dago, A. and Gasparini, A. and Levantino, S. and Ghioni, M.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.5W/mm2-Power-Density, 91.6%-Peak-Efficiency, Resonant Dual-Path Interleaved DC-DC Converter}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A DC-DC converter is presented that combines dual-path power delivery with resonant capacitor soft charging and interleaved operation to achieve high power density in sub-1V portable power management. The chip, implemented in a $0.18 \mu \mathrm{m}$ BCD technology, is co-designed together with a PCB interposer, enabling vertical stacking of passive components while leveraging the PCB parasitic inductance to realize zerocurrent switching. The converter operates with a 4.0 -to- 5.0 V input voltage and delivers a current up to 7A at a voltage in the 0.6 -to- 1.2 V range, with 91.6% peak power efficiency and 0.5 W/mm2 peak power density.},
  keywords={Current;Converters;Dies;Voltage;Inductors;Renewable Portfolio Standard;Technology;Loading;Printing;Zero current switching},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577336},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577211,
  author={Guo, Yanshu and Li, Heyue and Zhang, Siqi and Shi, Jun and Yin, Shijie and Liu, Qichun and Deng, Ning and Wang, Zhihua and Li, Tiefu and Wang, Guoxing and Zheng, Yuanjin and Jiang, Hanjun},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Cryo-CMOS Fully-Integrated Superconducting Qubit Reflectometry Readout IC with FCNN-Based Adaptive Drift Mitigation and FIR-DSM-Based Stimulus TX}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a neural-network augmented cryo-CMOS readout IC for superconducting quantum computing. With the FCNN-based qubit state detector, this IC achieves the ability of real-time qubit readout drift monitoring and adaptive drift mitigation. Adopting the FIR-DSM-based stimulus TX technique, the measured TX power is 2.6mW, which is $>1.9 \mathrm{x}$ lower than prior designs. Quadrature digital-IF reflected RX is implemented with stimulus pulses synthesis and reflected signal processing, resulting in a fully-functional readout IC with a lowest power of 10.3mW. Verification with a transmon qubit at 4K, this IC achieves a readout fidelity up to 95.6%.},
  keywords={Integrated circuits;Qubit;Printing;Displays;Indexes;Indexing;Finite impulse response filters;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577211},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577540,
  author={Sheng, C. and Demuynck, S. and Batuk, D. and Ganguly, J. and Peng, A. and Chiarella, T. and Eyben, P. and Schippers, D. and Loo, R. and Choudhury, S. and Dursap, T. and Porret, C. and Di Donato, L. and Huang, H. and Iacovo, S. and Mingardi, A. and Khazaka, R. and Cullen, C. P. and Casey, D. and Sebaai, F. and Gowda, P. Puttarame and Saroj, R. Kumar and Vandooren, A. and Cavalcante, C. and Hosseini, M. and Mitard, J. and Vandersmissen, K. and Jourdan, N. and Reddy, N. and Koo, I. and Sanchez, E. Altamirano and Marquez, A. Sepulveda and Lima, L. P. B. and Horiguchi, N. and Biesemans, S.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Improved Backside Contacting for CFET}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We report on improvements to the integration flow of backside contacted (BSC) monolithic CFET (mCFET) devices, demonstrated by enhanced survival rate (SR) and bottom pFET performance. A new BSC scheme (code name: delta), enabled by frontside-formed bottom dielectric isolation (FS-BDI) under the source/drain (SD), reduces the variability in eSiGe:B volume and reduces the contact resistance to the device. Combined with optimized bonding, extreme wafer thinning, backside-formed BDI (BS-BDI) and BSC etch, pFET SR improves from 45% to 85% versus our previous report.},
  keywords={Displays;Indexes;Indexing;Silicon;Printing;Etching;Strontium;Very large scale integration;Fluid flow;Transmission electron microscopy},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577540},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577295,
  author={Schram, T. and Smets, Q. and Arutchelvan, G. and Yao, C.-H. and Chou, S.A. and Li, M.-Y. and Batuk, D. and Rodrigues, T. and Ghosh, S. and Kumar, P. and Groven, B. and Opdebeeck, A. and Alvarez, D.M. and Jiang, Y. and Sarkar, T. and Kellens, K. and Vrancken, E. and Da Silva, C. R. and Mogultay, C. and Shen, T-H and Faramarzi, V. and Kar, G. S. and de la Rosa, C. J. Lockhart and van Dal, M. and Yen, A. and Radu, I. P. and De Poortere, E.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First EUV-Enabled Integration Route for 50 nm Pitch N and PMOS Transistors with 2D Materials Channel from a 300 mm Fab}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={EUV lithography and 300mm fab processing are used to enable an innovative integration approach for transistors with 2D materials channel. The route demonstrates for the first time scaled transistors, as relevant for technology applications, contact pitch down to 50nm, active width down to 75 nm and EOT $\sim 2 \text{nm}$. Quasi-CMOS integration was done by using different channel materials, $\text{MoS}_{2}$ for NMOS and $\text{WSe}_{2}$ for PMOS, side by side on the same 300mm wafer by die/ small wafer transfer. A key achievement is the demonstration of fabprocessed 2D PMOS transistors nearly matching the performance of best lab devices. This solves a critical missing piece for the lab to fab transition of 2D and BEOL CMOS technologies.},
  keywords={Displays;Indexes;Indexing;High-k dielectric materials;Transistors;Materials;Contacts;Printing;Technology;Field effect transistors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577295},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577431,
  author={Ungethüm, Jonathan and Kauffman, John G. and Ortmanns, Maurits},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 120-MHz BW CT 0-4 MASH DS ADC Employing a 2xTI SAR ADC and a Digital 1-0 MASH DSM DAC in 22nm FDSOI}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A continuous-time (CT) 0-4 multi-stage noise shaping (MASH) Delta-Sigma (DS) ADC achieving high linearity without DAC calibration in a 120 MHz bandwidth (BW) is presented. The ADC uses a dual-return-to-zero (DRTZ) DAC with single-ended LSBs and requires a single 0.8 V supply. The prototype fabricated in 22 nm FDSOI operates at 2.4 GHz sampling frequency and achieves 70.2 dB SNDR and 93.3 dB SFDR.},
  keywords={Multi-stage noise shaping;Mashups;Delta-sigma modulation;Printing;Filtering;Finite impulse response filters;Filters;Linearity;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577431},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577349,
  author={Fu, Zih-Sing and Li, Peter Zhi Xuan and Karaman, Sertac and Sze, Vivienne},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Gleanmer: A 6 mW SoC for Real-Time 3D Gaussian Occupancy Mapping}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={High-fidelity 3D occupancy mapping is essential for many edge-based applications (such as AR/VR and autonomous navigation) but is limited by power constraints. We present Gleanmer, a system on chip (SoC) with an accelerator for GMMap, a 3D occupancy map using Gaussians. Through algorithm-hardware co-optimizations for direct computation and efficient reuse of these compact Gaussians, Gleanmer reduces construction and query energy by up to 63% and 81%, respectively. Approximate computation on Gaussians reduces accelerator area by 38%. Using 16 nm CMOS, Gleanmer processes $640 \times 480$ images in real time beyond 88 fps during map construction and processes over 540 K coordinates per second during map query. To our knowledge, Gleanmer is the first fabricated SoC to achieve real-time 3D occupancy mapping under 6 mW for edge-based applications.},
  keywords={Timing;Printing;Weighted sum model;Construction;Information rates;Technology;Throughput;3D mapping;autonomous navigation;AR/VR},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577349},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577339,
  author={Lin, Ji-Yung and Yang, Yu-Hua and Kükner, Halil and Yang, Sheng and Verschueren, Lynn and Bömmels, Jürgen and Dell'Atti, Francesco and Zografos, Odysseas and Farokhnejad, Anita and Hellings, Geert},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Scaling High Density Designs Towards Angstrom Nodes: BEOL Routability, Pin Accessibility Challenges and Impact of Gear Ratio}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A comprehensive study on the design scaling in angstrom nodes is performed on a high-density processor core. The scaling trends foresee the degradation of BEOL routability and pin accessibility over technology nodes. In results, designs in A7 node reach −6% utilization compared to N 2 node, enlarging area by 8% from the expected level. Nevertheless, increasing M1 density with higher gear ratio (GR) is proposed to recover routability. GR $2: 1$ is shown to significantly increase utilization in A7 designs, reducing $14 {\%} / 8 {\%}$ area vs. GR 1:1/3:2 while keeping performance & power impacts within 2%. Thus, GR 2:1 is required to achieve expected area scaling for high-density designs in angstrom nodes.},
  keywords={Design methodology;PIN photodiodes;Pins;Printing;Technology;Displays;Indexes;Indexing;Cells (biology);Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577339},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577521,
  author={Cho, Chen-Yi and Shih, Yu-Ling and Lao, Ming-Yeh and Chen, Yu-An and Lin, Yu-De and Yeh, Po-Chun and Sheu, Shyh-Shyuan and Hou, Tuo-Hung},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Origin and Modeling of the Access-Rate-Dependent Degradation and Dual-Interface Optimization in Ultra-Thin Nanolaminate HZO}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Access-rate (AR)-dependent degradation under a noncontinuous cycling (NCC) with hold times between operations is a new showstopper for the practical use of $\text{Hf}_{1-\mathrm{x}} \text{Zr}_{\mathrm{x}} \mathrm{O}_{2}$ (HZO)-based FeRAM. We provide new insights into this critical reliability issue from the following perspectives: (1) reveal strong thickness- and hold-polarity-dependent AR degradation originating from interface property and asymmetry down to the ultrathin thickness of 4 nm, (2) develop a comprehensive physics-based AR degradation model that bridges continuous cycling (CC)-to-NCC behavior based on the interplay between charge trapping and depolarization-field (Edep) -driven redistribution, and (3) demonstrate an optimized symmetric ZHZ tri-layer nanolaminate based on new physics understanding and largely mitigate AR-dependent degradation.},
  keywords={Degradation;Modeling;Argon;Displays;Indexes;Indexing;Printing;Technology;Timing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577521},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577559,
  author={Park, Jongyoun and Jeong, Heejae and Won, Jiwoo and Lee, Junhyeok and Ahn, Chunghyun and Lee, Sangsu and Cho, YoungWoo and Park, Geuntae and Yu, Sangho and Kwon, Hyuk-Jun and Yu, Hyun-Yong},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A High-Performance Heterogeneous 2T0C DRAM with PSLC-Si/IGZO Complementary Gain Cell for Monolithic 3D Leveraging Capacitive Coupling}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This study experimentally demonstrates a highperformance monolithic 3D (M3D) integrated 2-transistor-0-capacitor (2T0C) DRAM cell utilizing a complementary gain cell (CGC) with n-IGZO and p-channel patterned seedless laser crystallization (PSLC)-Si. Using PSLC, we achieved a worldrecord grain size of $32.3 \mu \mathrm{m}$ and a hole mobility of $265 \text{cm}^{2} / \text{Vs}$ for the read-transistor (R-Tr). The CGC architecture leverages capacitive coupling (C.C.) to boost the sensing margin (SM) to $\sim 10^{6}$, satisfying the 1k-array criterion $(\text{SM}>10^{4})$ and outperforming conventional 2-nIGZO 2T0C. Simulation confirms an estimated read time of 11.8 ns. These findings establish the M3D CGC 2T0C DRAM as a candidate for highdensity, and high-performance 3D memory solutions that overcome the limitations of conventional architecture.},
  keywords={Cells (biology);Silicon;Arrays;Crystallization;DRAM chips;Printing;Very large scale integration;Indexes;Indexing;Lasers;Monolithic 3D;PSLC;2T0C DRAM;Complementary Gain Cell;Sensing Margin (SM);Mobility},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577559},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577543,
  author={Levy, Cooper S. and Sharma, Jahnavi and Xuan, Zhe and Huang, Duanni and Gao, Junyi and Liu, Songtao and Wu, Xinru and Wang, Xiaoxi and Mondal, Susnata and Krishnamurthy, Sashank and Lake, Dan and Jaussi, James E.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An 800 Gbps/Fiber Silicon Photonic Microring-Based DWDM Transceiver in an Open-Cavity Package}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Silicon photonic (SiPh) micro-ring resonator (MRR) based optical interconnects integrated with XPU/switch packages can enable very high data rates per-fiber through dense wavelength division multiplexing (DWDM). We demonstrate an O-band DWDM link with simultaneous $16-\lambda$ transmission at $50 \text{Gbps} / \lambda$, for an aggregate data-rate of 800 Gbps/fiber, with BER<1e-9. An Intel 22 nm CMOS electronic integrated circuit (EIC) is 3D assembled with an Intel Fab11X photonic IC (PIC) and placed in an open-cavity substrate. The PIC integrates a $16-\lambda$ laser, $\lambda$-interleavers, MRRs for modulation and $\lambda$-demultiplexing, and optical amplification for link margin. The 22nm EIC features several high-speed techniques to push per-$\lambda$ data rate.},
  keywords={Joining processes;Printing;Displays;Indexes;Indexing;Packaging;Textile fibers;Very large scale integration;SiPh transceiver;MRR;Co-packaged optics},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577543},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577216,
  author={Cao, Wei and Inoue, Takayuki and Zhang, Peng and Guo, Jiacen and Yang, Xiang and Dutta, Deepanshu},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Toward Thousands-Layer 3D Nand: Unleashing the Block Size Constraint by Enabling Lateral Sub-Block Mode}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Stacking more wordline layers has been the main scaling approach for 3D NAND to achieve higher bit density. However, this approach leads to growing block size, which is becoming a major challenge to maintain the bit density increase rate in the beyond-1000-layer arena. To surmount this obstacle, a novel lateral sub-block mode is demonstrated in this work based on the advanced 3D NAND platform, which allows the large-block size induced bit density loss to be recovered by as much as $80 {\%}-90 {\%}$. This demonstration provides a costefficient pathway for future 3D NAND scaling.},
  keywords={Programming;Windows;Electrons;Personal digital devices;Technology;3D NAND;bit density;sub-block mode;program disturb;pre-charge},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577216},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577496,
  author={Xu, Li and Song, Sanquan and Nedovic, Nikola and Kalogerakis, Georgios and Mehta, Nandish and Rekhi, Angad and Zimmer, Brian and Tell, Stephen G. and Nishi, Yoshinori and Chen, Xi and Lopes, Ward and Lee, Benjamin G. and Greer, Thomas H. and Poulton, John W. and Gray, C. Thomas},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.416-pJ/b, 32-Gb/s 3D-Stacked Optical NRZ Receiver with −18.5-dBm OMA Sensitivity Using Self-Timed Decision Feedback Equalization}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a $32 \text{Gb} / \mathrm{s}$ optical non-return-to-zero (NRZ) receiver with 3D-stacked 7 nm CMOS and 65 nm photonic dies. It uses a low-bandwidth front-end followed by self-timed decision feedback equalization (STDFE). OMA sensitivity for $\text{BER}<10^{-12}$ and PRBS31 is −18.5 dBm. The receiver consumes $0.416 \text{pJ} / \mathrm{b}$ at $32 \text{Gb} / \mathrm{s}$ and occupies $3360 \mu \mathrm{m}^{2}$.},
  keywords={Rails;Clocks;Displays;Indexes;Indexing;Sensitivity;Printing;Design methodology;Joining processes;Bit error rate},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577496},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577227,
  author={Park, Seunghan and Park, Yohwan and Kim, Tae Hyung and Lee, Jinkyu and Kang, Hongjeon and Seo, Youngjae and Kim, Hyungjin and Ha, Sunghyuk and Kim, Dongjun and Choi, Jeongmin and Jung, Jongki and Ro, Jongjin and Park, Youngmin and Lee, Jongho and Choi, Kyuwon and Hong, Dukho and Kim, Jongmoo and Cho, Hyojong and Jeong, MinYong and Ivaniukovich, Aliaksei and Kim, Taejung and Jeong, Jaehun and Lee, Ho and Kim, Hyun-Jo and Yasuda-Masuoka, Yuri and Ku, Ja-Hum},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Ultra Low-Power SRAM Technology on High Performance FinFET Platform for HPC, Mobile, and High-Reliability Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Extreme Low-Power FinFET SRAM technology has been developed on the top of the latest advanced high performance 4nm FinFET Technology. The technology offers the worldbest low-leakage SRAM, achieving a $0.52 \times$ bit-cell leakage current compared to the previous FinFET node. Additionally, SRAM $\mathrm{V}_{\min}$ is successfully reduced by 70mV. To attain these advancements, total SRAM transistor design from Fin/SD to Gate stack is performed. As a result, in compiler level, significant leakage reduction, such as 0.35x in standby and 0.31x in retention mode, are achieved, as well as Performance $+50 {\%}$ and Power $-35 {\%}$.},
  keywords={Displays;Indexes;Indexing;SRAM chips;Optimization;Technology;Stacking},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577227},
