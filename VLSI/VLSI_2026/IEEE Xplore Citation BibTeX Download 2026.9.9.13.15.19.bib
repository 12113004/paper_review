  month={June},}@INPROCEEDINGS{11577356,
  author={Lischke, S. and Heinemann, B. and Steckler, D. and Peczek, A. and Rücker, H. and Mai, C. and Kroh, A. and Marschmeyer, S. and Yamamoto, Y. and Krüger, A. and Korndörfer, F. and Lenke, T. and Kulse, P. and Fursenko, O. and Wolansky, D. and Fraschke, M. and Redd, K. Dorai Swamy and Teply, F. and Simon, S. and Herbel, T. and Huber, R. and Kissinger, D. and Zimmermann, L.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Monolithic Photonic BiCMOS Technology with 400-GHz SiGe-HBTs and Germanium-Fin Photodiodes}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We present a novel monolithically integrated SiGe-photonics technology that combines top-tier SiGe-HBTs with $\mathrm{f}_{\mathrm{t}} / \mathrm{f}_{\max}= 390 / 440 \text{GHz}$ and Ge-fin photodiodes with bandwidths estimated $>200 \text{GHz}$. This ePIC platform is enabled by adapting IHP's SG13G3 SiGe-HBT modules and leveraging Ge-fin photodiode technology. As a proof of concept, we demonstrate a monolithic photonic receiver realized in a development run of this process, achieving electro-optical bandwidth $>110 \text{GHz}$.},
  keywords={Technology;Displays;Indexes;Indexing;Silicon germanium;Bandwidth;Receivers;Printing;Silicon;Heterojunction bipolar transistors;Silicon Photonics;BiCMOS;electronic-photonic integration;SiGe HBT;OE Receiver;Ge photodiode},
