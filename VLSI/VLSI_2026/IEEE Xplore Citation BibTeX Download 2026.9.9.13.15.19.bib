  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 28nm 44.15TFLOPS/W and 1.57TFLOPS/mm2 Joint-Alignment Floating-Point CIM Macro with ISO26262 ASIL-D Safety Level for Autonomous Driving}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a floating-point Computing-in-Memory (FPCIM) macro tailored for AI model acceleration in autonomous driving. It has three features: 1) A joint-alignment CIM structure that performs the exponent-mantissa joint-alignment, reducing 3.97x accuracy loss and 31.24% area efficiency loss. 2) A hybrid XNOR/XOR adder tree (HAT) featuring first-level XNORbased 6T and other-level XOR-based 10T full adders (FA), reducing 71.35% area overhead. 3) A unified all-inclusive Silent Data Corruption (SDC) decoder (UASD) that directly protects final MAC results against SDC, achieving <0.5% SDC rate with only 8.41% area cost and ISO 26262 ASIL-D safety level.},
  keywords={In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Printing;Joints;Media Access Control;Adders;Modeling;Safety},
