  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Backside-Compatible Oxide Vertical Channel-All-Around Transistors and Cylindrical Capacitors for On-Chip Voltage Conversion at High Power Density}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents monolithic integration of indium-gallium-oxide (IGO) vertical channel-all-around transistors (VCAAT) and vertical cylindrical flying capacitors (VCCaps) for high-efficiency point-of-load (PoL) active backside power delivery network (BSPDN) design at 3 V rating, achieving a low specific on-resistance $(\mathrm{R}_{\text{on.sp}})$ of 7.57 $\mu \Omega \cdot \text{mm}^{2}$ and a high capacitance density of $162 \text{fF} / \mu \mathrm{m}^{2}$. With calibrated device models from experiments, circuit-level simulation shows 80.2% efficiency at high power density (1 $\mathrm{W} / \text{mm}^{2}$) with a proposed 4:1 ladder-based DC-DC converter for 3 V to 0.75 V step-down conversion, improving the power density by 4 times compared to recent works for the active BSPDN at the comparable voltage ratings and efficiency.},
  keywords={Printing;Technology;Capacitors;Transistors;Switching loss;Very large scale integration;Capacitance;Converters;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577630},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577291,
  author={Zhou, Yuejia and Yang, Yuancheng and Chen, Liang and Yu, Mingxiang and Luo, Wenpu and Ning, Zhiyuan and Huang, Weiqin and Xu, Xiaojian and Guo, Jing and Zhu, Runteng and Shao, Hanyong and Xia, Zhiliang and Huo, Zongliang and Tang, Kechao and Huang, Ru},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={3D Vertical Fefet Array with Record Endurance (¾1012), Fast Writing (± 2 V, 20 ns), Disturb Immunity, and Kb-Scale Verification for High Density 1T Ram}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We report a comprehensively optimized 3D vertical ANDtype ferroelectric FET (FeFET) memory, with highlights below: 1) Record-level key metrics of the 3D cells, including endurance $>10^{12}$, fast write at $\pm 2 ~\mathrm{V} / 20 ~\text{ns}$, immediate read-after-write, and $0.001 \mu ~\mathrm{m}^{2}$ channel area; 2) First demonstration of 3D array reliability, showing disturb immunity with aggressively scaled $40-\text{nm}$ vertical pitch, and error-free $\text{Kb}{-}$ scale readout; 3) Systematic process modulation with in-depth nano-analysis, revealing co-optimization mechanisms related to FE grain and channel oxygen engineering. The proposed 3D FeFETs enable high density 1T RAM, offering a low-cost and high-speed solution for the expanding hot data in AI era.},
  keywords={Arrays;Writing;FeFETs;Displays;Indexes;Indexing;Iron;Optimization;Technology;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577291},
