  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of ${f}_{\max}>{700} \text{GHz}$ in ${L}_{{g}}={45} \text{nm In}_{0.13} {Al}_{0.83} {Ga}_{0.04} {N} / {GaN}$ Hemts for Future 6G Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We report InAlGaN/GaN HEMTs with $L_{g}=45 \text{nm}$ that achieve record high-frequency characteristics. This outstanding performance is enabled by the successful integration of selective S/D regrowth and a high-aspect-ratio T-gate process using mix-and-match wafer-level integration. To gain insight into carrier transport and identify the key factors governing such performance, we employed methodologies based on $L_{g}$–scaling driven $g_{m}$ modeling and delay time analysis. The $L_{g}=45 \text{nm}$ device exhibits a combination of $R_{O N}=0.33 \Omega \cdot \text{mm}, g_{m_{-} \max }=1.03 \mathrm{S} / \text{mm}, f_{\max}= 742 \text{GHz}$ and $f_{\text{avg }}=497 \text{GHz}$. To the best of our knowledge, this work represents the first demonstration of $f_{\max}>700 \text{GHz}$ and the highest reported $f_{\text{avg}}$ for any GaN HEMT technology.},
  keywords={Generative adversarial networks;Modeling;Displays;Indexes;Indexing;Technology;HEMTs;Printing;High frequency;Delays},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577225},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577516,
  author={Huang, Yu-Ting and Wu, Xiao-Quan and Chen, Chi-Yu and Chiu, Po-Jui and Cho, Chien-Wei and Chen, Ke-Horng and Peng, Seng-Yu and Tsai, Tsung-Heng and Lin, Ying-His and Lin, Shian-Ru and Tsai, Tsung-Yen},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Hybrid LDO with Region-Detection and Power-Supply-Rejection-Based Control Achieving High PSR and Fast Transient Response}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={The proposed hybrid LDO integrates region detection (RD) and gate-edge detection (GED) techniques to optimize the ALDO-DLDO current ratio to break the PSR trade-off. At 10 kHz, the proposed HLDO achieves −49 dB and −40 dB PSR when VDO is 200 mV and 50 mV, respectively, maintaining high PSR up to 10 MHz range. For transient response, GED enables fast settling time; under a 1 mA-200 mA load step, the undershoot is 90 mV with an 8.7 ns settling time, and the overshoot is 92 mV with a 10.2 ns settling time.},
  keywords={Displays;Indexes;Indexing;Timing;Transient analysis;Windows;Signal detection;Current;Loading},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577516},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577402,
  author={Zhang, Chen and Radens, Carl and Bajpai, Utkarsh and Reboh, Shay and Khan, Shahrukh and Deming, Matt and Jain, Nikhil and Lanzillo, Nick and Seshadri, Indira and Sarkar, Debarghya and Mignot, Yann and Shanker, Nirmaan and Sieg, Stuart and Younus, Imran and Akter, Shirin and Liu, Feng and Rana, Uzma and Fan, Susan and Ramachandran, Ravi and Yamashita, Tenko and Guo, Dechao and Bu, Huiming},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Area and Performance of Staggered-Channel Nanostack SRAM Bitcells}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A staggered-channel SRAM bitcell design in the Nanostack sequential stacking architecture is presented. We show the role of top-bottom gate merge contact, a unique requirement in sequential stacking, in determining cell height and how the staggered design where top and bottom channels are not aligned helps scaling. We also show for the $1^{\text{st}}$ time in the world the gate merge structure developed on silicon. $>40 {\%}$ cell height reduction versus the state-of-the-art non-stacked cells can be achieved within the current patterning capability. Finally, simulation shows Nanostack bitcell has an improved wordline (WL) performance and comparable bitline (BL) performance compared to non-stacked bitcells.},
  keywords={Cells (biology);Stacking;Displays;Indexes;Indexing;Merging;Contacts;SRAM chips;Technology;Capacitance},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577402},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577592,
  author={Zhang, Kun and Zhou, Hong and Lyu, Qifeng and Zhang, Naiqian and Zhang, Chenrui and Liu, Jianfei and Yao, Yixu and Wang, Chenlu and Zhou, Min and Liu, Zhihong and Huang, Sen and Pei, Yi and Hao, Yue and Zhang, Jincheng},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={AlN Buffered K/Ku Bands GaN RF Power HEMTs with in-Situ SiN Silicidation Enabled Low $R_{C}=0.03 \Omega \cdot \text{mm}$ at 500 K and Record High $P_{\text{out}}=25 \mathrm{W}/\text{mm}$}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Ku(12-18 GHz)/K(18-26.5 GHz) bands are typically used for radar, satellite communication and navigation et al., which are however limited by maximum output power density (Pout) of RF devices, mainly constrained by low breakdown voltage (BV) and increased high temperature (T) contact resistance (RC). This work reports a record $\mathrm{P}_{\text{out}}=25/24 \mathrm{W}/\text{mm}$ at 18/20 GHz, which is twice of previous highest Pout value of 12 W/mm for Ku/K bands. This breakthrough is realized by combining a thick AIN buffer with enhanced carrier confinement and source field-plate (S-FP) structure for increased BV, and an in-situ SiN layer-assisted Ohmic silicidation enabled low RC of 0.03 $\Omega \cdot \text{mm}$ at $\mathrm{T}=500 \mathrm{K}$. Those results indicate a significant progress for Ku/K bands GaN RF power devices to achieve high-power and high-efficiency RF applications.},
  keywords={Generative adversarial networks;Displays;Printing;Indexes;Indexing;Radio frequency;HEMTs;Recording;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577592},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577534,
