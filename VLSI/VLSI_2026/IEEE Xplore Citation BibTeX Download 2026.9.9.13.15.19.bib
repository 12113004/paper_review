  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 10-Bit Source-Driver IC with Mismatch-Resilient Cross-Point DAC Achieving 1223μm2/Channel and 4.3 mV DVO for Mobile OLED Displays}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 10 -bit source-driver IC for OLED displays. The cross-point (XP) DAC enables a compact layout footprint through symmetric centroid-based mismatch resilience. Also, the improved correlated double integration (I-CDI) not only eliminates DAC errors but also auto-zeros amplifier offset with minimal hardware overhead. The SD-IC, fabricated in 180 nm CMOS, achieves a state-of-the-art area ($107.6 \times 11.3 \mu \mathrm{m}^{2}$ /channel) and a 4.3 mV DVO with a $1-\mathrm{H}$ scan time of $1.5 \mu \mathrm{s}$.},
  keywords={Current;Timing;Printing;Integrated circuits;Displays;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577261},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577555,
  author={Li, Mingxuan and Ren, Wenjie and Li, Zhuolin and Ye, Le and Jia, Tianyu},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A $\mathbf{1 2 2. 2} \boldsymbol{\mu} \mathbf{J} /$ Token Reasoning LLM Accelerator with Reinforcement Fine-Tune Featuring Two-Level KV-Cache Compression and Spike-Driven Predictive Update}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={In this paper, we introduce an accelerator for reasoning LLM with reinforcement learning fine-tune (RLFT) via three key features: 1) two-level KV cache compression with importanceoriented KV evicting and low-rank decomposition; 2) online reward model scoring using min-hash encoding scheme; 3) spike-driven predictive gradient updating on a hybrid tensor forwarding engine using both digital transpose-free PE and compute-in-memory (CIM) macros. The above innovations enable $2.03 \times$ less KV cache, $2.27 \times$ less RM scoring latency and $3.79 \times$ less weight update. Overall, a $122.2 \mu ~\mathrm{J} /$ Token energy efficiency including EMA and 747.2 ms /iteration latency are obtained for Qwen3-4B reasoning and RLFT.},
  keywords={Modeling;Timing;Printing;Large language models;Cognition;Cognitive systems;Very large scale integration;In-memory computing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577555},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577381,
  author={Bonomi, Stefano and Praemassing, Frank and Chiang, Sie Boo and Grollitsch, Werner and Nonis, Roberto},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Robust, Digital-Friendly, Differential and Distributed Supply Monitor Architecture for Automotive SoC in 28nm}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={The proposed supply monitor digital architecture is applied in Automotive applications on Sense and Adapt and on State of Health systems. It operates within the core supply domain using core regular devices without additional sensors or analog references. It requires a one-time, one-point calibration at wafer test. It ensures a robust, digital-friendly and easy-tointegrate implementation that satisfy the ASIL safety level and temperature range $-40^{\circ} \mathrm{C}$ to 160 °C of Automotive applications. Fabricated in n 28 the active area is $0.01 \text{mm}^{2}$, power consumption 540 uW. It tracks variations of 217 mV in 1 us, FoM is $2.45 \text{pJ} /$ conv-step., an inaccuracy of 10 mV, after stress and in presence of supply aggressors.},
  keywords={Monitoring;Calibration;Voltage;Temperature;Oscillators;Frequency;Very large scale integration;Printing;Technology;Supply Monitor;Voltage level detector;on-chip voltage sensor;voltage droop detector;digital voltage monitor},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577381},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577568,
  author={Zhu, Zhongyunshen and Yao, Aijia and Sun, Patricia and Jiao, Yixuan and Mohamed, Mohamed and Park, Ji-Hoon and Li, Jingxian and Kong, Jing and Zhu, Jiadi and Palacios, Tomás},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Performance Demonstration of Monolayer MoS2 Transistors at Cryogenic Temperatures Down to 6 K for Ultralow-Power Electronics}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={The DC and noise characterization of monolayer MoS2 transistors are measured over a wide temperature range from 300 K to 6 K. Temperature-dependent trends in $V_{\mathrm{T}}$, onand off-currents, and subthreshold swing (SS) are analyzed through both individual devices and statistics. At 6 K, the transistors exhibit significantly improved performance, achieving: 1) $\text{SS}_{\min } \approx 22 \text{mV} / \text{dec}$, 2) on/off ratio $>10^{8}$, and 3) twofold enhancement in peak transconductance efficiency compared to 300 K. In addition, MoS2 FETs show strongly suppressed low-frequency noise at cryogenic temperatures, outperforming Si counterparts. A temperature-dependent compact model calibrated to the measurements is employed to simulate MoS2 FETs with ultrathin EOT and channel length down to 18 nm, predicting ultralow-power (ULP) switching and reduced energy-delay product (EDP) relative to scaled Si FETs (planar Si CMOS and FD-SOI). These results highlight the promise of MoS2 for ULP cryogenic electronics.},
  keywords={Temperature;Field effect transistors;Printing;Silicon;Technology;Modeling;Displays;Indexes;Indexing;Noise},
