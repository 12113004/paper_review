@INPROCEEDINGS{11577610,
  author={Kim, Changjoo and Park, Sooho and Shim, Minkyun and Lee, Woojin and Kim, Hyunjin and Seo, Donghwi and Lee, Jaeuk and Kim, Chulwoo},
  title={An 8Bit 4.8GS/s 10.9fJ/Conv.-Step TI-SAR ADC with 4Bit/3Cycle Ping-Pong Architecture and Data-Driven Zero-Overhead Background Calibration},
  abstract={This paper presents a 4-channel $4.8 \text{GS} / \mathrm{s} 8$ bit timeinterleaved SAR ADC in 14 nm FinFET that overcomes the throughput limitations of conventional ping-pong architectures. While traditional ping-pong schemes are limited to 1bit/cycle, the proposed $4 \text{bit} / 3$ cycle architecture utilizes a background-calibrated time reference using forbidden-code detection to accelerate conversion speed. Uniquely, the design features a data-driven zero-overhead background offset calibration scheme that exploits idle cycles identified during conversion, eliminating the throughput penalty of dedicated calibration phases. The ADC achieves $\text{FoM}_{\mathrm{w}}$ of $10.9 \text{fJ} /$ conversion-step, demonstrating the best energy efficiency among state-of-the-art ADCs operating above $3 \text{GS} / \mathrm{s}$.},
  keywords={Timing;Calibration;Printing;Specific absorption rate;Synthetic aperture radar;Architecture;Computer architecture;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577610},
}

@INPROCEEDINGS{11577583,
  author={Nian, Cheng and Mo, Xiaorui and Zhang, Jiaqi and Peng, Jiaying and Farrukh, Fasih Ud Din and Li, Yifan and Jia, Wen and Chen, Fei and Lu, Liang and Zhang, Chun},
  title={Uni4D: A 12nm 0.16mJ/Frame 4D Gaussian Spatial Video Rendering Processor with Unified Deformation and On-Chip Hierarchical Sorting},
  abstract={Uni4D is a $12-\text{nm}$ spatial video rendering processor for real-time 3D/4D Gaussian splatting with $0.16-0.52 \text{mJ} /$ frame energy. A unified deformation engine (UniMAC) combines Hex-plane sampling with MLP-based deformation, while K-plane Weights Segmentation (KWS) factorizes 3D indexing to reduce K-plane buffer area by 84%. A non-blocking key-value pair (KVP) generation engine and a hierarchical radix sorting engine jointly pipeline tile-based preprocessing and on-chip sorting, cutting Gaussian box-bounding latency by 76% and external memory access by 93.8%. Fabricated in $12-\text{nm}$ CMOS, Uni4D renders dynamic Gaussian scenes at up to 232 fps, achieving more than an order-of-magnitude lower energy than prior NeRF/3DGS processors.},
  keywords={Sorting;Planing;Rendering (computer graphics);Tiles;Indexes;Indexing;Deformation;System-on-chip;Displays;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577583},
}

@INPROCEEDINGS{11577466,
  author={Mitarai, Yuki and Kawano, Masaya and Huang, Hung-Chih and Fukushima, Takafumi and Kuroda, Tadahiro and Hamada, Mototsugu and Kosuge, Atsutake},
  title={3D Orthogonal Die Stacking Technology for DRAM-on-GPU Integration Using Contactless Die-to-Die Interface},
  abstract={Massive orthogonal stacking assembly of IC (MOSAIC) technology was demonstrated to overcome thermal limitations in 3D memory-on-GPU configurations. By stacking memory dies orthogonally to the GPU, heat is dissipated effectively, enabling twice the memory capacity. A contactless die-to-die interface, achieving up to $4 \text{Gbps} / \text{ch}$ in a prototype, mitigates assembly challenges, enabling TSV-free 3D integration.},
  keywords={Dies;Graphics processing units;Memory;Coils;Stacking;Printing;Technology;Timing;Assembly;Modeling;Advanced packaging;3D integration;contactless interface},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577466},
}

@INPROCEEDINGS{11577379,
  author={Lyu, Haoran and Chen, Yulong and Li, Humiao and Yang, Zhengke and Liao, Wang and Li, Jiamin and Lin, Longyang},
  title={A Full-MWPM Surface Code Decoder with On-the-Fly Weight Computation and Cross-Platform Adaptability Achieving 1.9×10-6 LER and 20.8-ns Decode Time at 4K},
  abstract={A cryo-CMOS surface code decoder supporting full minimum-weight perfect matching (MWPM) up to distance-21 is presented. The design employs on-the-fly weight computation to reduce weight memory area by $989 \times$, a parallel matching engine for full MWPM, and lock-pair-based speed tuning for cross-platform speed adaptability. The $40-\text{nm}$ test chip achieves a logical error rate of $1.9 \times 10^{-6}$ with a 20.8 ns decode time at 4K, providing a $3.3 \times$ to $612 \times$ speedup over prior art while consuming 2.46nJ per decode.},
  keywords={Decoding;Timing;Codes;Surfaces;Printing;Qubit;Technology;QEC;surface code;MWPM;cryo-CMOS},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577379},
}

@INPROCEEDINGS{11577321,
  author={Chung, Hyunwon and Senta, Parin and Yu, Jason and Fang, Yukun and Abillama, Pierre and Chen, Kuan-Yu and Dreslinski, Ronald and Blaauw, David and Kim, Hun-Seok},
  title={A 248.5 $\text{GFLOPS}/\text{mm}^{2}$, 1.67 TFLOPS/W Streaming Processor with Hardware-Level Scheduling for Advanced Spectrum Sensing},
  abstract={This work presents a fast-programmable streaming processor for spectrum sensing in dynamic RF environments. To respond to rapidly changing RF channels, the 2D array of 77 processing elements is tightly integrated with a light-weight kernel launcher that achieves 10 ns array reconfiguration without host-CPU intervention. The processor is able to analyze multiple heterogeneous signals/channels in highly dynamic conditions and achieves a compute density of 248.5 GFLOPS $/ \text{mm}^{2}$ and an energy efficiency of 1.67 TFLOPS/W.},
  keywords={Kernel;Arrays;Memory;Timing;Very large scale integration;Printing;Displays;Indexes;Indexing;Measurement units},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577321},
}

@INPROCEEDINGS{11577215,
  author={Hsieh, Yi-Yen and Chang, En-Jui and Teng, Chieh-Fang and Huang, Po-Hua and Kuo, Hsien-Kai and Chou, Hsing-Chang and Yang, Kai-Siang and Ou, Shiyi and Huang, Chiao-Chun and Xue, Cheng-Xin and Hung, Wei-Ting and Wan, Zhe and Lin, Hung-Wei and Jedhe, Gajanan and Chu, Yi-Chen and Chang, Tun-Yi and Chou, Chia-Hsien and Lee, Kun-Geng and Wang, Perry H. and Deshpande, Chetan and Liang, Jenwei and Lin, Chien-Hung and Lin, Tsung-Yao and Jou, Yucheun Kevin},
  title={TinyNPU: A3nm 0.06-134.36 μJ/Token DCIM-Based Ultra Low Power NPU for Always-On Reasoning on Wearables},
  abstract={Tiny neural processing unit (TinyNPU) is the first commercial $3-\text{nm}$ DCIM NPU for ultra-low-power always-on reasoning (AoR) in wearables. By co-optimizing the DCIM architecture, an L1-efficient composite flow, and softwarehardware (SW-HW) co-optimized scheduling, it delivers 1.47 TOPS with 512 8-bit MACs and 256 KB on-chip memory. Measurement results show up to 10 days of battery life on smart glasses and $31.8 \times$ less energy on Transformer models vs. state-of-the-art works, enabling efficient next-generation AoR.},
  keywords={Displays;Indexes;Indexing;Modeling;Printing;Fluid flow;Timing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577215},
}

@INPROCEEDINGS{11577372,
  author={Huo, Yong and Cao, Yuefeng and Zhang, Minglei and Zhu, Yan and Martins, Rui. P. and Chan, Chi-Hang},
  title={A 14b 500MS/s Pipelined-SAR ADC with Loop-Unrolled Correlated Level Shifting and Rapid Sequential Sampling},
  abstract={This paper presents a $14 ~\mathrm{b} 500 \text{MS} / \mathrm{s}$ PipelinedSAR ADC, which features the loop-unrolled correlated level shifting (LU-CLS) and rapid sequential sampling (RSS) to enable a swift, accurate and PVT-robust residue amplification at wideband inputs. The ADC achieves 70.12 dB SNDR at the Nyquist input and consumes 7.6 mW, leading to 175.3 dB FoMs.},
  keywords={Printing;Timing;Gain;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577372},
}

@INPROCEEDINGS{11577438,
  author={Hao, Weibing and Xie, Jiawei and Jiao, Leming and Lu, Jingguang and Sun, Chen and Wang, Yuxuan and Ni, Kai and Liang, Gengchiau and Gong, Xiao},
  title={Breaking Mobility–${V}_{\text{th}}-{R}_{\text{sd}}$ Trade-off in Oxide Semiconductor FETs: Novel p-NiO Junction Engineering},
  abstract={For the first time, junction engineering using a p-type NiO capping layer is implemented in ITO FETs, simultaneously enabling a significant positive threshold voltage $(V_{\text{th}})$ for enhancement-mode operation, preservation of channel mobility $(\mu_{\text{eff}})$, and reduction of source/drain series resistance $(R_{\text{SD}})$, capabilities that are unattainable through conventional channel thickness $(T_{\text{CH}})$ engineering. By modulating the carrier concentration of p-type NiO, a 2 V positive shift in $V_{\text{th}}$ is achieved together with a field-effect mobility of 34 $\text{cm}^{2} / \mathrm{V} \cdot \mathrm{s}$ and a $1.5 \times$ enhancement in on-state current $(I_{\text{ON}})$ in long-channel devices $\left(L_{\text{CH}}=10 \mu \mathrm{m}\right)$. Enhancement-mode operation is also realized in shortchannel devices $(L_{\text{CH}}=150 \text{nm})$, delivering a $V_{\text{th}}$ of 0.6 V and a $2.9 \times$ improvement in $I_{\text{ON}}$ compared with control devices, owing to the combined benefits of mobility preservation and $R_{\text{SD}}$ reduction. Moreover, relative to devices without NiO, the proposed devices exhibit a much lower subthreshold swing of $28 \text{mV} / \text{dec}$ at 77 K, along with excellent wafer-scale uniformity.},
  keywords={Printing;Very large scale integration;Field effect transistors;Displays;Junctions;Indexes;Indexing;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577438},
}

@INPROCEEDINGS{11577277,
  author={Hou, Yaoru and Xiao, Zhihua and Wu, Xuezhao and Wang, Shuyu and Zhu, Zheng and Wu, Di and Wang, Jiayong and Li, Yuesheng and Cai, Hao and Shao, Qiming},
  title={A 28nm CMOS-Integrated VCMA-MTJ Dual-Function Macro for Deterministic In-Memory Computing Synapses and Stochastic Poisson Neurons in Hybrid Vision},
  abstract={Unlike current-driven spintronic devices, Voltage-Controlled Magnetic Anisotropy (VCMA) Magnetic Tunnel Junctions (MTJs) utilize electric-field-induced switching to overcome energy bottlenecks and enable tunable stochastic behavior. This work presents a 28 nm CMOS-integrated VCMA-MTJ dual-function macro that employs a single spintronic device to support both deterministic and stochastic neuromorphic primitives. The integrated VCMA-MTJs function as deterministic in-memory-computing (IMC) synapses for signed-weight storage and array-level MAC operations, while their voltage-tunable probabilistic switching enables the implementation of stochastic Poisson neurons. The fabricated macro is validated in a hybrid ANN/SNN hardware platform for frame-event hybrid vision detection, achieving 92.5% inference accuracy and 411 TOPS/W energy efficiency. These results demonstrate the potential of VCMA-MTJ devices as a promising solution for low-power, high-accuracy neuromorphic computing.},
  keywords={Modeling;Printing;Technology;Arrays;In-memory computing;Displays;Indexes;Indexing;Switches;Neurons},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577277},
}

@INPROCEEDINGS{11577250,
  author={Kalogerakis, Georgios and Song, Sanquan and Xu, Li and Mehta, Nandish and Rekhi, Angad and Nedovic, Nikola and Lee, Benjamin G. and Zimmer, Brian and Tell, Steve and Nishi, Yoshinori and Chen, Xi and Lopes, Ward and Greer, Trey and Gray, C. Thomas},
  title={A $\mathbf{3 2 G b} / \mathbf{s}$ Optical Receiver Utilizing a Differential TIA with $- 1 7. 3 d B m$ Sensitivity in a 3D-Stacked Silicon Photonics Platform},
  abstract={This work presents a $32 ~\text{Gb} / \mathrm{s}$ optical receiver that utilizes a differential transimpedance amplifier (TIA) from a single supply in a 3D-stacked silicon photonics (SiPh) platform. The receiver sensitivity (in terms of Optical Modulation Amplitude or OMA) at the photodiode (PD) is -17.3 dBm and -18.9 dBm at $32 ~\text{Gb} / \mathrm{s}$ and $28 ~\text{Gb} / \mathrm{s}$, respectively. The energy efficiency at $32 ~\text{Gb} / \mathrm{s}$ is $0.484 \text{pJ} / \mathrm{b}$. The receiver consists of a 7 nm FinFET CMOS electronic IC (EIC) stacked on top of a 65 nm silicon photonics IC (PIC) via $\text{Cu}-\text{Cu}$ hybrid bonding.},
  keywords={Cathodes;Receivers;Displays;Indexes;Indexing;Sensitivity;Personal digital devices;Printing;Circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577250},
}

@INPROCEEDINGS{11577364,
  author={Kim, Jongwha and Jo, Yongwoo and Min, Seongyun and Chun, Juntak and Shin, Yuhwan and Song, Hyunjun and Kwak, Seohyeon and Park, Kwanseo and Choi, Jaehyouk},
  title={A 16.8-33.6 Gb/s, 0.93pJ/b Direct-Frequency-Tracking Digital CDR with an SSC Profile Replicator for Per-Lane Data-Rate Variation and High Jitter Tolerance Under Deep SSC},
  abstract={This work presents a direct frequency-tracking (DFT) CDR that supports flexible per-lane data rates and improves jitter tolerance (JTOL) under deep spread-spectrum clocking (SSC). A $\Delta \Sigma \mathrm{M}-{}$ based fractional-$N$ PLL directly tracks frequency offset, while an SSC profile replicator (SSC-PR) eliminates SSC-induced phase error in a type-II loop. The proposed CDR in 28 nm CMOS demonstrates wide data-rate flexibility from 16.8 to 33.6 Gb/s and improved JTOL under up to 7000 ppm SSC. Operating at 0.7 V without power-hungry phase interpolators (PIs), the highly digital CDR achieves an excellent energy efficiency of 0.93 \pJ/b.},
  keywords={Frequency;Printing;Jitter;Discrete Fourier transforms;Phase locked loops;Tracking;Displays;Indexes;Indexing;Clocks},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577364},
}

@INPROCEEDINGS{11577392,
  author={Seo, Donguk and Choi, Youjin and Kim, Mingyu and Kim, Heeyeon and Lee, Kyungjun and Kim, Jaerok and Kim, Donggyu and Han, Shin and Lee, Yoonmyung},
  title={A 16 Mb 28 nm FD-SOI STT-MRAM Achieving 2.0 ns Read Access Time at 0.9 V via a PVT-Variation-Tolerant Dual-Reference Sensing Scheme},
  abstract={A 16 Mb STT-MRAM is presented in 28 nm FD-SOI. To address PVT-induced read margin degradation, a read interface combines a dual-reference sense amplifier (DRSA) with an array-adaptive dual-reference (AADR) scheme. This technique extends the read window by tracking local resistance variations. The proposed sensing scheme expands the normalized zero-BER read window by $2.00 \times, 2.34 \times$, and $2.62 \times$ compared to a conventional scheme at $-40^{\circ} \mathrm{C}, 25^{\circ} \mathrm{C}$, and $125{ }^{\circ} \mathrm{C}$, respectively. The chip achieves a 2.0 ns read access time at $0.9 \mathrm{V} / 25^{\circ} \mathrm{C}$ and 3.3 ns at 125 °C with $\text{BER}=0$.},
  keywords={Arrays;Timing;Printing;Bit error rate;Very large scale integration;Displays;Indexes;Indexing;Cells (biology);Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577392},
}

@INPROCEEDINGS{11577415,
  author={Li, Mengyu and Yang, Xiaolin and Rodriguez, Alejandro Lopez and Duckert, Bastien and Neutens, Pieter and Jaramillo, Valentina Restrepo and Coppejans, Phillippe and Lopez, Carolina Mora},
  title={A 300-Channel Photometry Neural Probe with In-Pixel Adaptive-Noise $\boldsymbol{\Delta} \boldsymbol{\Sigma}$ Modulators Achieving $\mathbf{1 6. 8 ~ f A} / \sqrt{ } \mathbf{H z}$ Noise for High-Sensitivity Fluorescence Recording},
  abstract={This work presents a 300 -channel photometry neural probe with in-pixel readout for scalable, high-resolution fluorescence sensing. Each channel integrates an on-chip photodiode and a $\Delta \Sigma$-based adaptive-noise readout with serialized data transfer. By exploiting a duty-cycled unipolar current DAC (IDAC) with a passive integrator, the readout achieves an adaptive noise floor with a compact implementation. The input-referred noise decreases at lower signal levels, enabling an 88.7 dB dynamic range which is 12 dB higher than the peak SNR. The system achieves an ultra-low noise floor of $16.8 \text{fA} / \sqrt{ } \text{Hz}$ while consuming 70 nW per channel. Each channel occupies $0.0015 ~\text{mm}^{2}$ with a $25 \mu ~\mathrm{m}$ pitch, supporting high-spatialresolution neural recording along the probe shank.},
  keywords={Noise;Photometry;Probes;Printing;Current;Signal to noise ratio;Personal digital devices;Pixel;Displays;Fluorescence},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577415},
}

@INPROCEEDINGS{11577228,
  author={Xie, Wenao and Li, Zhongqi and Chen, Jiaer and Yoo, Jerald and Yoo, Hoi-Jun},
  title={Silicon-Oracle (Soracle): A Multi-Modal Autoregressive Model Accelerator for Context-Aware Assistance on Mobile Platform},
  abstract={This paper presents Soracle, a multi-modal autoregressive (AR) model accelerator for context-aware assistance. It integrates a mixed-precision exponent-tracked LUT-counter MAC unit and a row-broadcast/column-unicast AR core for EMA-free, headlocal attention execution. Weight storage and transfer overhead are further reduced by slice-shared $\log _{2}$-partition quantization and bandwidth-aligned, stride-adaptive streaming. Soracle also reduces redundant token computation via exponent-aligned dominant-token extraction and dominance-trackable attention process. Fabricated in 28 nm FDSOI with a die area of 20.25 $\text{mm}^{2}$, Soracle achieves state-of-the-art $83.93 \text{mJ} /$ frame energy consumption and $0.671 \mathrm{s} /$ frame image generation speed.},
  keywords={Argon;Printing;Modeling;Image processing;Image synthesis;Timing;Media Access Control;Technology;Measurement units;Broadcasting},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577228},
}

@INPROCEEDINGS{11577619,
  author={Kim, Jung-Kyun and Yoo, Sijung and Jo, Sanghyun and Hyun, Seung Dam and Park, Yoonsang and Kim, Taek Jung and Kim, Kihong and Song, Kyung Mee and Kim, Donghoon and Jung, Kyooho and Yang, Jee-Eun and Jang, Younjin and Han, Na-Rae and Chae, Byeong Gyu and Won, Jung Yeon and Lee, Hyangsook and Heo, Jinseong and Kim, Yongsung and Kim, Sangwook and Choe, Duk-Hyun},
  title={Elucidating the Role of Channel Materials and Interlayers in Ferroelectric NAND},
  abstract={Oxide-semiconductor (OS) channels are being actively explored for ferroelectric NAND (FeNAND), but their impact relative to Si channels remains poorly understood under fully identical device conditions. Here, we systematically compare Si - and OS-channel FeNAND devices, explicitly isolating the channel-induced effects within an identical top-gated structure and process. We find that OS channels exhibit a strongly asymmetric switching behavior, leading to a reduction of the memory window by more than half and its complete confinement to the negative $\mathrm{V}_{\text{th}}$ regime. We further show that introducing a high-$k$ channel interlayer (Ch.IL) effectively recovers the degraded memory window. Moreover, the Ch.IL is found to be essential for ensuring stable operation in OS-channel FeNAND. These results highlight critical design considerations for channel and interlayer engineering in FeNAND devices.},
  keywords={Displays;Indexes;Indexing;Silicon;Polarization;Materials;Printing;Very large scale integration;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577619},
}

@INPROCEEDINGS{11577594,
  author={Liu, Szu-Lin and Lien, Bei-Shing and Lai, Wie-Lin and Lu, Yi-Chen and Jen, Ching-Lin and Peng, Yung-Chow and Hsieh, Kenny Cheng-Hsiang},
  title={A 0.75V, 1.43%-Inaccuracy 4T MOS-Based Voltage Reference in $251 \mu \mathrm{m}^{2}$ Area},
  abstract={This paper presents a 4-transistor (4T) MOS-based voltage reference in a 3 nm FinFET node. By using single threshold voltage (VTH) design and identifying the temperature-slope correlation between the required CTAT voltage and the nMOS-VTH, this voltage reference achieves a $3 \sigma$-inaccuracy of 1.43% and a temperature coefficient (TC) of 42.7 ppm/° C from a 0.75 V -supply. The whole circuit consumes $12 \mu \mathrm{W}$ power and only occupies area of $251 \mu \mathrm{m}^{2}$.},
  keywords={Voltage;Temperature;Design methodology;Printing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577594},
}

@INPROCEEDINGS{11577617,
  author={Kim, Seungbin and Jeong, Hoichang and Kim, Dongwook and Kim, Jiwon and Lee, Kyuho Jason},
  title={HCNP: A 70.2 TOPS/W Hybrid CIM-NPU Processor with In-Streaming Processing for Energy-Efficient CNN/Transformer Acceleration in HMD},
  abstract={This paper presents HCNP, an energy-efficient hybrid CIMNPU processor designed to accelerate diverse DNN topologies under strict power constraints of head-mounted display (HMD) platforms. Unifying CIM and NPU architectures through instreaming processing enables layer fusion (LF), reducing offchip access by 79.7%. NPU core co-designed with runtime KV cache eviction (RKVe) reduces 79.8% memory footprint and 32.1% computation. Optimizing flexible-route network-onchip (FR-NoC) and single-column-multiple-output (SCMO) architectures facilitates hierarchical inter-/intra-core dataflow strategy, maximizing 81.8% CIM utilization. Fabricated in 28 nm CMOS technology, HCNP achieves 70.2 TOPS/W, reducing energy consumption by 32.3% and 93.6% compared to CIM [7] for mobile-targeted CNNs (MCNNs) and NPU [8] for large language models (LLMs), respectively.},
  keywords={Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;In-memory computing;Large language models;Printing;Architecture;Computer architecture;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577617},
}

@INPROCEEDINGS{11577497,
  author={Gu, Zhiwen and Pham, Hieu and Le, Hanh-Phuc},
  title={A 48V-5V Coupled-Inductor Middle-Switched-Capacitor Hybrid GaN Converter Achieving 156µH Equivalent Inductance and 30mA Ripple},
  abstract={This paper presents a middle-switched-capacitor (MSC) hybrid converter that employs coupling between the input and output planar inductor to achieve ideally ripple-free currents at the output, and a synchronous L-C path to also achieve the same at the input. Implemented in a $0.5-\mu \mathrm{m}$ GaN-on-Silicon process, the $8.58-\text{mm}^{2}$ MSC converter prototype achieves 30 mA output current ripple and 160 mA input current ripple, amounting to 48.8 X and 9.5 X ripple reduction, respectively.},
  keywords={Current;Inductors;Converters;Joining processes;Switches;Printing;Steady-state;Voltage;Capacitors;Topology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577497},
}

@INPROCEEDINGS{11577611,
  author={Song, Y. S. and Park, K. D. and Lee, W. and Lee, K. and Yang, H. M. and Koo, B. J. and Jang, G. and Lee, C. H. and Park, W. H. and Park, J. H. and Wu, Z. and Oh, S. C. and Park, K. M. and Lee, S. H. and Yoon, S. J. and Kim, T. Y. and Lee, S. H. and Shim, M. and Kim, D. S. and Ko, S. P. and Ha, D. and Ahn, S. J. and Song, J. H.},
  title={Decoupling Dual Degradation Pathways in OTS Endurance for High-Reliability Selector-Only Memory},
  abstract={We reveal two distinct degradation pathways for Ovonic threshold switch endurance: irreversible threshold voltage broadening from fatigue-driven elemental loss and partially reversible probabilistic reset-misread caused by filament instability. Their opposite stress dependences establish a unified framework validated by multi-scale experiments and simulations. Guided by this model, composition and bias co-optimization suppress both modes, achieving $>10^{8}$-cycle endurance in a fully integrated $14-\text{nm}$ Selector-only memory.},
  keywords={Displays;Indexes;Indexing;Degradation;Fatigue;Optimization;Stress;Writing;Cells (biology);Human factors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577611},
}

@INPROCEEDINGS{11577343,
  author={Jeong, Shinwoo and Jang, Jiuk and Kim, Chulmin and Choi, Yuseok and Son, Youngwoo and Woo, Dongsoo and Ryu, Hoin and Chae, KyoSuk and Lee, Byung-hyun and Hwang, Sangjoon},
  title={Innovative Performance of 6th Generation 11nm DRAM Cell Transistor for HBM4 Application},
  abstract={The performance of $11 ~\text{nm}-6$th generation in $1 \mathrm{x}-\text{nm}{-}$ class-dynamic random access memory (DRAM) cell transistor is demonstrated in High Band Width Memory (HBM) products and its ultra-scaled device technology and electrical superiority are proved. The evaluated performance of DRAM retention characteristics shows that the suppressed leakage current under Sub-45A Gate Oxide is attributed to the fully exploited dual work function gate node of Buried Channel Array Transistor (BCAT) on the flat-zone oriented silicon wafer ($\text{FZ}$). In particular, despite of the dramatically decreased capacitance of cell storage module (Cs), the final output of the cell transistor under operating and stand-by modes exhibits novel and innovative performance characteristics. Furthermore, we have achieved the overall outstanding cell refresh interval time (tREFi) performance at high temperature of 120° C during Chip on Wafer (CoW) test for 12-High stacked HBM devices.},
  keywords={Cells (biology);Transistors;Silicon;Leakage currents;DRAM chips;Displays;Indexes;Indexing;Technology;Conferences},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577343},
}

@INPROCEEDINGS{11577427,
  author={Kim, Seryeong and Park, Jongjun and Lee, Sangmyoung and Joo, Hyungnam and Park, Wonhoon and Song, Seokchan and Ryu, Junha and Park, Gwangtae and Kim, Sangjin and Choi, Jiwon and Hong, Seongyon and Jo, Wooyoung and Kim, Hyeonrae and Yoo, Hoi-Jun},
  title={SR-VLNA: A 5.0-23.9 mJ/meter Spatial Reasoning-based Vision Language Navigation Accelerator for Embodied Agents},
  abstract={This paper presents SR-VLNA, an energy-efficient spatial reasoning-based vision language navigation (VLN) accelerator. The spatial reasoning consists of 1) 3D Gaussian splattingbased semantic understanding (SU), and 2) language-based planning (LP). SR-VLNA proposes 4 features of ESU, MRDU, CAGQU, and HSAT and reduces energy of SU and LP by $7.0 \times$ and $10.9 \times$, respectively. Fabricated in 28 nm FDSOI, SRVLNA achieves state-of-the-art SU performance at 0.004 $0.021 \mu ~\mathrm{J} /$ point and is the first to demonstrate LP with $0.25-0.96 \text{mJ} /$ task. Finally, SR-VLNA demonstrates end-to-end VLN system with $5.0-23.9 ~\text{mJ} /$ meter.},
  keywords={Timing;Displays;Indexes;Indexing;Trees (botanical);Vegetation;Strontium;Adders;Energy;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577427},
}

@INPROCEEDINGS{11577585,
  author={Tong, Zhiguo and Yang, Wenjie and Yu, Zhewen and Han, Shousheng and Martins, Rui P. and Lu, Yan},
  title={A 2D-Extendable $\mathbf{4 8 V}$-1V Ladder-Series-Capacitor Buck Converter for Computing Power Delivery},
  abstract={This paper presents a 48 V -to- 1 V two-dimensional extendable ladder-series-capacitor buck converter (LSCB) which supports both input-voltage stackable and outputcurrent parallel architecture of power cells, to reduce switch voltage stress and extend output current simultaneously. We also implement an input-series output-parallel (ISOP) twostage configuration to realize vertical power delivery. Fabricated in $180-\text{nm}$ BCD for input-series chips and $65-\text{nm}$ process for output-parallel chips, the cascaded ISOP system achieves a peak power density of $2132 ~\mathrm{W} / \text{in}^{3}$ while delivering a maximum output current of 25 A.},
  keywords={Voltage;Capacitors;Converters;Current;Steady-state;Printing;Switches;Architecture;Computer architecture;Human factors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577585},
}

@INPROCEEDINGS{11577254,
  author={Lee, Sanghoon and Yun, Soohyun and Yoon, Seokho and Kang, Kyungmin and Jeon, Taejune and Park, Sang Hoon and Lee, Ju Young and Chung, Won Gi and Park, Jang-Ung and Yu, Ki Jun and Bae, Joonsung and Chae, Youngcheol},
  title={A 16-Channel Neural Recording IC with Spike-Driven Adaptive-Basis Compressive Sensing},
  abstract={This paper presents a 16-channel neural recording IC that achieves massive data-rate reduction through a spike-driven adaptive-basis compressive sensing (CS). To address wireless data-rate bottlenecks in high-density recording, a two-stage compression scheme that integrates on-chip spike detection with CS encoding is proposed. The adaptive dictionary learning tracks non-stationary neural signals in real-time, maintaining high reconstruction fidelity even under significant temporal drift. Furthermore, a wide-DR analog front-end ensures robust tolerance to large transient stimulation artifacts. Measured results demonstrate $168 \times$ data-rate reduction with 96.8% classification accuracy, slashing the per-channel datarate to 1.92 kbps, while the CS block consumes only $2.2 \mu \mathrm{W}/\text{ch}$. This enables a highly efficient and scalable interface for artifact-tolerant, long-term implantable neural recording.},
  keywords={Timing;Printing;Displays;Indexes;Indexing;Recording;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577254},
}

@INPROCEEDINGS{11577506,
  author={Takamatsu, Ryo and Yabuuchi, Makoto and Hamada, Masaya and Tanaka, Tomotaka and Hsu, Shu-Huan and Liu, Yao-Yi and Ishii, Yuichiro and Nii, Koji and Wang, Isabel and Cheng, Hong-Chen and Liao, Hung-Jen and Chang, Tsung-Yung Jonathan},
  title={A $\mathbf{2 n m}$ 37.4 Mbit $/ \text{mm}^{2}$ Dual-Rail SRAM with Row-Access Aware Read Tracking and Write Assist Circuits Enabling 2.28 pJ/Access Energy Efficient Operation},
  abstract={This paper proposes an energy efficient high-density (HD) 6T single-port SRAM employing row-access aware read tracking and write assist (WA) circuits. In the read operation, the excessive bitline (BL) swing is narrowed by 45 % at the worst condition, reducing the read dynamic power by up to 8.7 %. It is also reduced by 8.5 % on average thanks to the rowaccess aware read tracking and its optimal wordline (WL) deactivating timing. In the write operation, the WA circuit switches the negative BL boost capacitance by being aware of row-access, reducing up to 15 % write dynamic power on average. 539-kbit dual-rail multi-array SRAM macros are demonstrated in $2-\text{nm}$ nanosheet technology [1], achieving a bit-density of $37.42 \text{Mbit} / \text{mm}^{2}$. Measured silicon data show $0.35-1.10 ~\mathrm{V}$ wide low voltage operation at $125{ }^{\circ} \mathrm{C}$ and an energy efficient read/write operation with $2.28 \text{pJ} /$ access.},
  keywords={Arrays;Tracking;Cells (biology);Writing;Very large scale integration;Circuits;Printing;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577506},
}

@INPROCEEDINGS{11577445,
  author={Shin, Keun Wook and Lee, Hyangsook and Kim, Changhyun and Yang, Dae-Jin and Lee, Young Min and Jang, Hyeong-Seok and Han, Yujin and Leem, Youngchul and Jo, Gi-Young and Lee, Jeong Yub and Byun, Kyung-Eun and Kim, Sang Won},
  title={Topological Semimetal MoP as Future Conductors in Back-End-of-Line: Thin Film Deposition, Resistivity Scaling, Processability, Integration, and Reliability},
  abstract={To overcome the RC delay bottleneck in interconnect applications (Fig. 1(a)), topological semimetals (TSMs) have emerged as promising candidates for post-Cu interconnects. This study investigates MoP as a representative TSM, with a focus on its crystallographic structure, electrical properties, processability, integration, and reliability. This work provides the first experimental demonstration that MoP thin films exhibit reduced resistivity with decreasing thickness, a behavior that is preserved in narrow line structures. These lines sustain a Jmax exceeding 100 MA/cm2 and an electromigration (EM) lifetime of more than 20 h, highlighting MoP's strong potential for advanced interconnect technologies.},
  keywords={Conductivity;Thin films;Printing;Displays;Indexes;Indexing;Modeling;Technology;Surfaces;Copper},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577445},
}

@INPROCEEDINGS{11577615,
  author={Choi, Yunhyeok and Lee, Yong Ki and Karpinskyy, Bohdan and Park, Jieun and Ko, Hyunwoo and Kim, Yongsoo and Park, Taewook and Kang, Jisu and Lee, Sungha and Kim, Gapkyung and Shin, Jonghoon and Rhew, Hyo-Gyuem},
  title={An 80.198um2 Compact TRNG with Bias Mitigation, Proven PVT Tolerance in 4nm},
  abstract={This paper presents a ring-oscillator (RO) based true random number generator (TRNG) that improves a 97.54% bias reduction, achieving a high entropy per bit of 0.986 (NIST SP 800-90B IID-track) without post-processing at 4 Mbps. Enabled by a simple yet novel bias-mitigation method, the proposed TRNG occupies only $80.198 \text{um}^{2}$.},
  keywords={Entropy;Jitter;Displays;Indexes;Indexing;Printing;Frequency;Technology;Testing;Very large scale integration;random number generator;security;key;entropy source;noise source},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577615},
}

@INPROCEEDINGS{11577637,
  author={Han, Jeehoon and Sim, Jaeryong and Kang, Seogoo and Jun, Junghoon and Park, Jihwan and Kim, Donghwan and Yu, Changyeon and Lim, Jongho and Choi, Yusik and Kim, Changmin and Yoon, Jisoo and Kim, Seonghwan and Jang, Jaehoon and Song, Jaihyuk},
  title={Demonstration of Cell Multi-Bonding (CMB) Technology for Future Vertical NAND Over $\mathbf{1} \mathbf{k}$-Layer},
  abstract={For the first time, 900 -layer class VNAND integration was implemented by bonding two 450 -layer cell wafers. The cell wafer with a large warpage could be successfully supported in the upper chuck through an appropriate warpage design during bonding process, and the alignment deterioration that occurs in bonding between cell wafers with large warpage was also solved by applying new overlay correction technology. In addition, normal cell operation characteristics were verified based on the newly introduced the bit-line (BL) and word-line (WL) structure that can drastically improve the power consumption and chip size.},
  keywords={Cells (biology);Bonding;Displays;Indexes;Indexing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577637},
}

@INPROCEEDINGS{11577512,
  author={Qiang, Geyu and Luo, Xiao and Chen, Xinyang and Liu, Chang and Wang, Cheng},
  title={A 209 ∼ 245GHz CMOS Spectroscopic Transmitter with DTC-Based 4FSK Baseline Elimination and Phase-Offset Calibrated SSPLL for Chip-Scale Molecular Clocks},
  abstract={This paper presents a CMOS spectroscopic transmitter probing the 231.061 GHz rotational spectra of OCS gas molecules for chip-scale molecular clocks (CSMC). It adopts 4FSK modulation through a DTC FSK modulator to mitigate the baseline tilting of gas cell with negligible SNR penalty. A $104.4 \sim 122.4 \text{GHz}$ integer-$N$ sub-sampling PLL (SSPLL, $N=36$) reduces the phase noise (PN) for high SNR. Phase offset calibration ensures robust locking of SSPLL under PVT variation. A $5.8 \sim 6.8 \text{GHz}$ fractional-$N$ sampling PLL (SPLL) drives the SSPLL. Fabricated on $65-\text{nm}$ bulk CMOS, it achieves a measured PN of $-79.2 \text{dBc} / \text{Hz} {@} 2 f_{m}=100 \text{kHz}$ offset, and 86.9 fs jitter at $f_{0}=231.061 \text{GHz}$, consuming $P_{D C}=73 \text{mW}$. The measured 4FSK dispersion curve records a SNR of 85.7 dB with only 1.9 dB SNR penalty. After the CSMC locking, ADEV of $3.7 \times 10^{-10} {@} \tau=1 \mathrm{s}$, and ADEV of $3.4 \times 10^{-11} {@} \tau=10^{3} \mathrm{s}$ are measured.},
  keywords={Modulation;Timing;Signal to noise ratio;Frequency;Calibration;Technology;chip-scale molecular clock;CMOS spectrometer;4FSK modulation;DTC;phase offset calibration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577512},
}

@INPROCEEDINGS{11577238,
  author={Gong, Jiang and He, Long and Jang, Taekwang},
  title={A 5.7-6.8GHz Capacitively-Coupled Series-Assisted Parallel-Resonance VCO Achieving −148.8 dBc/Hz PN, 193.5 FoM, and 202.0 FoMA at 10MHz Offset},
  abstract={This paper presents a capacitively-coupled series-assisted parallel-resonance (CSA-PR) VCO that achieves ultra-low phase noise with high power and area efficiency. By capacitively coupling a parallel LC tank with low-impedance auxiliary elements, the design provides passive voltage gain and waveform shaping to reduce both thermal and flicker noise. The tunable tank impedance enables flexible trade-offs between power and noise. Fabricated in $22-\text{nm}$ FDSOI CMOS, the single-core VCO achieves $-148.8 \text{dBc} / \text{Hz}$ phase noise and $193.5 \text{dBc} / \text{Hz}$ FoM at 10 MHz offset while consuming 11.8 mW in a $0.14 \text{mm}^{2}$ area.},
  keywords={Voltage-controlled oscillators;Impedance;Printing;Noise;Joining processes;Strontium;Technology;Oscillators},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577238},
}

@INPROCEEDINGS{11577612,
  author={Gong, Minxiang and Butzen, Nicolas and Yu, Jingshu and Krishnamurthy, Harish and Weng, Sheldon and Ravichandran, Krishnan and Pelto, Christopher and Ahan, Ramiz and Waldemer, James and Tschanz, James},
  title={A Monolithic 20W/$\text{mm}^{2}$ 4.8V Input 94.8% Peak Efficiency 2-1 Switched Capacitor Voltage Regulator as First-Stage Current Multiplier for Vertical Power Delivery},
  abstract={A monolithic first stage 2-1 SCVR pushing SoC package $V_{\text{IN}}$ to 4.8 V. It features stacked devices with synchronized auxiliary power converters, realizing self-generated drive voltages, efficient gate driving and safe startup, achieving $20 \mathrm{W} / \text{mm}^{2}$ power density and 94.8% peak efficiency.},
  keywords={Voltage;Stacking;Technology;Displays;Indexes;Indexing;Printing;Training},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577612},
}

@INPROCEEDINGS{11577578,
  author={Maejima, Hiroshi and Isobe, Katsuaki and Hashimoto, Toshifumi and Unno, Masaki and Okada, Nobuaki and Utsumi, Tetsuaki and Hisada, Toshiki and Nakajima, Takao and Noda, Mitsuhiko and Nakatsuka, Keisuke and Tagami, Masayoshi and Suzuki, Shinji and Kobayashi, Shigeki and Maruyama, Keiji and Kouchi, Toshiyuki and Kotani, Toshiya and Shiga, Hitoshi},
  title={A Multi Stacked Cell Array (MSA) Structure with an Up-Down Crossed Bit Line Architecture (Ud-CBL) in 3D Flash Memory},
  abstract={We propose a Multi Stacked Cell Array (MSA) structure with an Up-down Crossed Bit Line architecture (Ud-CBL) to enhance the performance of 3D Flash memory. The MSA can address two key performance issues common in 3D Flash memory with increasing word line (WL) layers: reduced cell current and increased block (BLK) size. The Ud-CBL minimizes area overhead through layout innovations, halving both WL length and BLK size. For a 1Tb 3-bit per cell (TLC) 4-plane design, assuming 400 WL layers, the read time (tR) is estimated to improve by 11% compared to a conventional structure. Additionally, we present a 4KB read method leveraging the Ud-CBL that enhances power efficiency by 7%.},
  keywords={Arrays;Cells (biology);Displays;Indexes;Indexing;Printing;Memory;Technology;Architecture;Computer architecture},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577578},
}

@INPROCEEDINGS{11577274,
  author={Noda, Mitsuhiko and Hashimoto, Susumu and Mizumoto, Ryuta and Watanabe, Mamoru and Sawada, Genki and Kawasaki, Kanta and Sonoda, Masahisa and Kamiya, Eiji and Morooka, Tetsu and Nakatsuka, Keisuke and Maejima, Hiroshi and Kobayashi, Shigeki and Suzuki, Shinji and Sakotsubo, Yukihiro and Osawa, Kohei and Sato, Shinya and Shibasaki, Teiji and Yaegashi, Masahiro and Honma, Ryoichi and Tagami, Masayoshi and Sekine, Katsuyuki},
  title={A Multi-Stacked Cell Array Architecture with Wafer-to-Wafer Cu Direct Bonding for Ultra-High-Density 3D Flash Memory Beyond 1,000 Word Lines},
  abstract={This paper demonstrates the world's first successful Quad-Level Cell (QLC) operation of a multi-stacked cell array CMOS directly bonded to array (MSA-CBA). This breakthrough overcomes key challenges in high stacking of 3D flash memory: cell current degradation, wafer warpage, and large block (BLK) size. These results mark a milestone toward ultra-high-density 3D flash memory with over 1,000 stacked layers, paving the way for next-generation memory technologies.},
  keywords={Arrays;Cells (biology);Bonding;Displays;Indexes;Indexing;Stacking;Memory;Flash memories;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577274},
}

@INPROCEEDINGS{11577263,
  author={Chen, Yiyang and Nam, Suhyeon and Byun, Sun-woong and Velcich, Pietro and Cho, Shinil and Lee, Chanwoo and Lee, Ju Young and Weaver, Sean and Brugnolotto, Enrico and Hwang, Eunkyu and Seo, Dongseok and Lee, Eunee and Yu, Ki Jun and Choi, Woojun and Jang, Taekwang},
  title={A 256-Channel, 32-Interconnect, 1.25-NEF, in Vitro and In Vivo Neural Interface With Auto-Calibrated Input Impedance Boosting and on-Chip Spike Detection for Flexible Capacitive Microelectrode Array},
  abstract={This work presents a capacitive neural interface for 256 -channel simultaneous recording with 32 interconnects. Fabricated in a $22-\text{nm}$ CMOS, the prototype is evaluated using two flexible capacitive microelectrode arrays (MEAs) for in vitro and in vivo applications. To the authors' best knowledge, this is the first to demonstrate in vivo or in vitro measurement of the series-parallel amplifiers (SPA). The proposed system achieves a noise efficiency factor (NEF) of 1.25 and 0.81, measured with and without the ADC, respectively, which are the lowest among the AFEs reporting in vivo or in vitro results.},
  keywords={Printing;Displays;Indexes;Indexing;Noise;In vivo;Capacitance;Recording;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577263},
}

@INPROCEEDINGS{11577314,
  author={Lin, Qiuyang and Sijbers, Wim and Hu, Yixiong and Beamish, Eric and Botermans, Wouter and Lopez, Carolina Mora and Van Helleputte, Nick},
  title={A 16-Channel 97pArms 1MHz Bandwidth IC for Solid State Nanopore Sequencing},
  abstract={A fully integrated 16-channel nanopore interface IC fabricated in $0.13 \mu \mathrm{m}$ CMOS is presented. The design achieves $20 \mathrm{M} \Omega$ transimpedance gain, 1MHz bandwidth, and $97 \text{pA}_{\text{rms}}$ noise at 1.7mW per channel, and demonstrates reliable parallel detection of labeled DNA translocation events using solid-state nanopores.},
  keywords={Noise;Labeling;Gain;Root mean square;Resistors;Printing;Equalizers;Current;DNA;Feedback},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577314},
}

@INPROCEEDINGS{11577631,
  author={Peng, Jida and Toth, Nandor G. and Makinwa, Kofi A. A.},
  title={A 75nW BJT-Based Temperature Sensor with ±0.1°C Inaccuracy from −40°C to 85°C},
  abstract={This paper describes a BJT-based temperature sensor that combines a dual-mode front-end (DMFE), and a low-power switched capacitor (SC) $\Delta \Sigma$ modulator with a 10-tap FIR-DAC. After a low-cost 1-point trim, it achieves $\pm 0.1^{\circ} \mathrm{C}(3 \sigma)$ inaccuracy from $-40^{\circ} \mathrm{C}$ to 85 °C while dissipating only 75 nW. This is $3 \times$ lower than prior precision BJT-based sensors, and $2-3 \times$ more accurate than prior low-power MOS-based sensors.},
  keywords={Timing;Printing;Image sensors;Modulation;Temperature;Technology;Sensors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577631},
}

@INPROCEEDINGS{11577554,
  author={Lue, Hang-Ting and Yeh, Teng-Hao and Hsieh, Chih-Chang and Hsu, Tzu-Hsuan and Hu, ChihWei and Chiu, Chia-Jung and Lee, Guan-Ru and Chen, Ken-Hui and Chang, Chin-Hung and Wang, Keh-Chung and Lu, Chih-Yuan},
  title={A 4Gb 32-Layer 3D NOR Flash Test Chip with Innovative Design Methods Enabling Sub-100ns Low-Latency Read and Robust Retention},
  abstract={We develop a 4Gb 32-layer 3D NOR Flash test chip to achieve low latency read (<100ns) and good high-temperature retention after P/E cycling stress. To address the fundamental issues of large parasitic capacitance loading accompanied with high-layer stacked 3D memory that impacts read latency, and the retention challenges of charge-trapping memories to fulfill the automotive-grade wide temperature operations, we employed several innovative design methods. The large bitline capacitance loading in 3D array causes spurious transient displacement current, and we have invented an ideal capacitive matching design to cancel the displacement current to meet low-latency read. The charge-trapping memories often generate shallow-trapped electrons especially after P/E cycling stress. We found that the “recovery programming” built in the erase algorithm provides an effective shallow-trap reduction mechanism, providing much better data retention. Technology challenges including the stringent requirements of “zero defect (after repair)” and “initial RBER=0” are discussed. We also propose a prospect of 3D NOR for high-density and low-latency non-volatile memory (NVM) chiplets connected to advanced CMOS to support high-performance on-device AI computing.},
  keywords={Arrays;Tiles;Indexes;Indexing;Memory;Current;Displays;Programming;Technology;Design methodology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577554},
}

@INPROCEEDINGS{11577384,
  author={Lee, Sumi and Lin, Jian-Yu and Niu, Chang and Shih, Chun-An and Long, Linjia and Alam, Muhammad A. and Ye, Peide D.},
  title={Different Low-Frequency $(1 / f)$ Noise Origins in Atomically Thin ALD In2O3 TFTs Determined by the Quantum-Confinement Effect},
  abstract={Low-frequency $(1 / f)$ noise in amorphous-oxide-semiconductor (AOS) TFTs increases as device area scales down, but its origin is obscured by misleading $\mathrm{S}_{\text{ID}} / \mathrm{I}_{\mathrm{D}}{ }^{2}-\mathrm{V}_{\text{OV}}$ slopes. Using ultrathin atomic-layer-deposited (ALD) In2O3 TFTs that span channel degeneracy and contact barriers (2 nm: degenerate, $\varphi_{S B H}<0; 1.2 \text{nm}$: nondegenerate, $\varphi_{S B H}>0$), we combine temperature-dependent $\mathrm{S}_{\text{vg}}$ with Dutta-Horn analysis and cleanly separate two regimes: the 2 nm devices follow tunneling-assisted carrier-number fluctuations $(\Delta N)$ ($\alpha \approx 1$, nearly flat $D\left(E_{\mathrm{a}}\right)$), whereas the 1.2 nm devices exhibit $\alpha<1$ with a redistributed $D\left(E_{\mathrm{a}}\right)$, implicating band-tail-coupled $\Delta N$. Finally, bias- and $L_{c h}$–scaling reveal a transition to contact-noise dominance at high Vov only in the 1.2 nm devices.},
  keywords={Noise;Printing;Contacts;Electrons;Temperature;Tail;Electron devices},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577384},
}

@INPROCEEDINGS{11577428,
  author={Kim, Jong-Hun and Lee, Seong-Ju and Jeong, Seogyong and Cho, Mun-Jung and Jeong, Yeon-Woo and Kim, Min-Sik and Kim, Myeong-Ho and Lee, Dong-Chan and Jeong, Min-Gyu and Kim, Geon and Hur, In-Hye and Ko, Eun-Jae and Shin, Se-Un},
  title={A 6.78MHz Fractional-Resonance Full-Wave Current-Mode Wireless Receiver with Real-Time SAR-Based Optimum Tracking and Power-Aware Division Control},
  abstract={This work presents a 6.78 MHz fractional-resonance current-mode wireless receiver with successive-approximation (SAR) based optimum tracking and power-aware division control for implantable devices. A new full-wave topology and dithering control method enable fractional resonance to enhance energy extraction, while the controller autonomously adapts to link variations. Fabricated in 180 nm CMOS, it achieves 81.2% efficiency at 18.9 mW and the widest received power range among state-of-the-art designs.},
  keywords={Displays;Indexes;Indexing;Printing;Energy;Joining processes;Distance measurement;Specific absorption rate;Synthetic aperture radar;Current},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577428},
}

@INPROCEEDINGS{11577533,
  author={Sun, Shihui and Zhuo, Yi and Qiu, Weixiong and Zhao, Yunxu and Yang, Tianyu and Huang, Zhaofeng and Shen, Linxiao and Zhang, Yacong and Chen, Zhongjian and Li, Zhihong and Lu, Wengao},
  title={A 4.32uW/Ch 256-Channel Neural Probe Integrating In-Situ ADC and Stimulation for Closed-Loop DBS},
  abstract={This work presents a 256-channel neural probe for closedloop DBS with per-channel low-power in-situ dual-looposcillator ADCs. Two operating modes are supported: neural recording with baseline stabilization and stimulation with synchronous monitoring. The $0.0010 \text{mm}^{2} /$ channel probe consumes $4.32 \mu \mathrm{W} /$ channel and achieves $3.68 \mu$ Vrms input-referred noise over a 10 kHz bandwidth. The area-energy efficiency FoM ($0.21 \text{fJ} \cdot \text{mm}^{2} /$ step) and NEF (2.69) represent state-of-the-art performance.},
  keywords={Recording;Timing;Probes;Printing;Displays;Indexes;Indexing;Oscillators;Architecture;Computer architecture;active neural probe;analog-to-digital (A/D) conversion;biomedical sensor;implantable biomedical device;multielectrode arrays;microelectrodes;neural recording},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577533},
}

@INPROCEEDINGS{11577378,
  author={Wang, Yimeng and Di, Xinyang and Wang, Jingxiang and Chen, Hongjiang and Zhang, Ran and Sin, Sai-Weng and Martins, Rui P. and Guo, Mingqiang},
  title={A 12-Bit 4-GS/s ADC with PLL-Based Sub-Ranging RO-TDC},
  abstract={This paper proposes a PVT-robust sub-ranging ring oscillator-based time-to-digital converter (SSRO-TDC) with phase-locked loop (PLL), integrated into a $12 \mathrm{b} 4-\text{GS} / \mathrm{s}$ timeinterleaved pipelined ADC as a backend. With frequency multiplication by PLL, the proposed background-running subranging RO (SRRO) is shared among TI channels, enhancing time resolution and PVT robustness and improving power efficiency. The proposed offset calibration algorithm suppresses the time offset in SRRO. Measurement result shows an SNDR of 58.5 dB at Nyquist frequency with $\text{FoM}_{\mathrm{W}}$ of $15.94 \text{fJ} /$ conv.-step.},
  keywords={Phase locked loops;Timing;Distance measurement;Technology;Calibration;Printing;Titanium;Frequency;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577378},
}

@INPROCEEDINGS{11577330,
  author={Shen, Zhongqiu and Zhou, Kaiwen and Chen, Shi and Ye, Shen and Hong, Zhiliang and Yang, Yingguo and Xu, Jiawei},
  title={A 3D-Conformal Flexible X-Ray Detector with 2.06 pArms Ultra-Low Noise Readout Circuit Enabling Low-Dose Computed Tomography Imaging},
  abstract={This paper presents the first demonstration of a flexible X-ray imaging system for low-dose computed tomography (CT). The system features a 3D-conformal flexible X-ray detector that integrates ultra-high-mobility ITZO thin-film transistors (TFTs) with perovskite-based X-ray sensing layers, achieving a sensitivity of $296 \mu \mathrm{C} /\left(\text{Gy} \cdot \text{cm}^{2}\right)$. The detector is co-designed with an ultra-low-noise, scalable current readout consisting of 6-channel ping-pong C-TIAs and a shared CT-IADC with an optimized reset scheme, delivering 2.06pArms input-referred noise over a 5kHz bandwidth. Experiments with the TFT-based flexible detector and a real X-ray source validate the system's capability to reconstruct both gradient and patterned features, demonstrating its practical viability for low-dose CT imaging.},
  keywords={X-rays;Detectors;Printing;Noise;Arrays;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577330},
}

@INPROCEEDINGS{11577221,
  author={Han, Seung Uk and Han, Jin-Woo and Oh, Gyuhwan and Han, Sang-IL and Park, Sungmin and Kim, Juhyun and Kim, Taekyong and Bae, Taejin and Kang, Taegyu and Shin, Joongchan and Hong, Seongbin and Yoo, Bowon and Choi, Hongrak and Kim, Yujin and Sung, Sang Hyun and Choi, Kyoseon and Kim, ManBok and Lee, Jin Kwan and Lee, Janghee and Jung, Chang Hwa and Oh, Jungmin and Jung, Myoung Ho and Lee, Hojin and Kim, Yungjun and Lee, Soongun and Hwang, Kyuman and Cha, Moon-Hyun and An, Taeyoon and Lee, DK and Kim, BC and Kim, Dongwan and Ahn, Kwangho and Park, Kwangmin and Park, Sang Wuk and Lee, Seung Hun and Hwang, Sangmin and Lee, Siwoo and Hyun, Sangjin and Park, Se Guen and Song, Jaihyuk},
  title={Vertically Stacked Dram Technology for Scaling Evolution},
  abstract={Vertical Stacked DRAM (VS-DRAM) has emerged as a promising candidate to extend DRAM generations beyond the 10 nm node, leveraging cell stacking similar to V-NAND. Demonstrating reliable device operation at higher tiers is crucial to ensuring its competitiveness. For the first time, this paper presents experimental results of a 16-tier VS-DRAM structure. The study integrates Gate-All-Around (GAA) type cell transistors (CTR) and horizontal storage capacitors (CAP) and compares these results with conventional DRAM. Additionally, a core/peri ($\mathrm{C} / \mathrm{P}$) device is fabricated on a separate wafer and its backside is bonded to the cell wafer, enabling the implementation of Peri-on-Cell architecture. The findings highlight the potential of VS-DRAM and pave the way for future DRAM innovations.},
  keywords={Displays;Indexes;Indexing;DRAM chips;Cells (biology);Technology;Bonding;Very large scale integration;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577221},
}

@INPROCEEDINGS{11577240,
  author={Huang, Yunbo and Yang, Zunsong and Wang, Li and Cheng, Kai and Ren, Hongyu and Shan, Xiaoyu and Mak, Pui-In and Chen, Yong and Li, Bo},
  title={A 54-to-60GHz Cascaded PLL Featuring Implicit Frequency Doubling and Harmonic-Mixing Phase Detector Achieving 53.8fsrms Jitter and −281.1dB FoMN},
  abstract={This work presents a low-jitter and low-power mm-wave cascaded PLL that leveraging the $2^{\text{nd}}$ harmonic extraction and $5^{\text{th}}$ harmonic-mixing to improve the jitter performance. The 54-60GHz PLL prototyped in 28nm CMOS achieves an excellent jitter-power figure of merit $\left(\text{FoM}_{\mathrm{N}}\right)$ below −280dB, while the jitter performance (53.8fs) is very competitive.},
  keywords={Phase locked loops;Jitter;Waves;Wireless Access in Vehicular Environments;Voltage-controlled oscillators;Printing;Displays;Indexes;Indexing;Frequency},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577240},
}

@INPROCEEDINGS{11577410,
  author={Tanabe, Shinichi and Okada, Naoya and Irisawa, Toshifumi and Cheng, Hao and Miura, Hitoshi and Warashina, Hisashi and Huang, Yu-min and Nagasaka, Keiichi and Fukazawa, Atsuki and Maehara, Hiroki},
  title={Direct Synthesis of Multi-Stacked Channels and Doped Source/Drains for TMD CFETs},
  abstract={A simple LSI-compatible technique for synthesizing multistacked MoS2 channels (up to 10 stacks) directly on Si substrates is demonstrated by utilizing post annealing of MoOx. Thickness-controlled high-quality bilayer MoS2 films with mobility reaching 12 cm2/Vs on a wafer scale is achieved, which is the highest mobility reported for MoS2 directly synthesized on SiO2 by post annealing of MoOx. In addition, multi-stacked WSe2 channels are also demonstrated through annealing of WOx in a selenium environment. This approach also enables formation of doped thick-layered MoS2 source/drains (S/Ds) by incorporating metals into the MoOx prior to the post annealing. The capability to fabricate both MoS2 and WSe2 multi-stacked channels along with gate-allaround (GAA) compatible S/Ds offers promising prospects for the integration of transition-metal dichalcogenide (TMD) complementary field-effect transistors (CFETs).},
  keywords={Annealing;Films;Motion pictures;Stacking;Argon;Technology;Displays;Indexes;Indexing;Metals},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577410},
}

@INPROCEEDINGS{11577455,
  author={Bowonder, A. and Acton, O. and Adhikari, S. and Aggarwal, R. and Agrawal, U. and Armstrong, J. and Asoro, M. and Auth, C. and Aykol, M. and Bambery, R. and Baran, A. and Bhuiyan, M. and Burgess, S. and Byon, K. and Caselli, D. and Chakraborty, M. and Charue-bakker, S. and Chatterjee, A. and Chaudhari, P. and Cheemalapati, S. and Chin, S. and Chung, P. and Crum, D. and Danda, G. and Das, R. K. and Das, N. and Dhar, P. and Dhar, S. and Di Francesco, G. and Dolejsi, M. and Epple, J. and Ezaz, T. and Fathipour, S. and Forslund, R. and Gaddam, C. and Grimm, W. and Gu, Y. and Guha, B. and Hafez, W. M. and Han, C. and Hanken, D. and Harris, D. and Hattendorf, M. and Heil, P. E. and Ho, I. and Hong, D. and Horsch, M. and Hryn, A. and Hsu, W. and Isa, N. S. and Jaloviar, S. and Jayawardena, S. and Jung, K. and Kameswaran, J. G. and Kamysbayev, V. and Karl, E. and Karumuri, S. and Kirby, S. and Kobrinsky, M. and Krishnamurthy, S. and Kulkarni, O. and Kumar, A. and Lahiri, J. and Lakhani, A. and Lee, G. and Lee, S-H. and Li, W. and Liao, Y-A. and Lin, C-H. and Lin, W. and Liu, Y. and Loh, O. and Malyavanatham, G. and Mandal, S. and Mandal, S. and Mavrakakis, K. and Mehta, N. and Mleczko, M. and Moore, A. and Moumen, N. and Movva, H. C. P. and Murugavel, A. and Nigam, S. and Nolan, L. and Novak, S. R. and Pan, L. and Panchamgam, S. and Paredes, I. and Park, J. K. and Parker, J. and Patel, R. and Paul, P. K. and Pauls, J. and Pipes, L. and Prasad, C. and Puls, C. and Qiu, W. Z. and Ramaswamy, R. and Saadat, O. and Saunders, J. and Sayal, A. and Sell, B. and Serrao, C. and Shah, R. and Shah, F. and Sharma, M. and Shingla, V. and Smith, M. and Starko-bowes, R. and Su, C-Y. and Subramanian, S. and Sultana, A. and Tanaka, A. and Techane, S. and Thulasi, S. and Towner, D. J. and Wadekar, S. and Wang, X. and Wu, Y-T. and Xu, G. and Fischer, K.},
  title={Intel 18A-P CMOS Technology Enhancement Featuring Advanced RibbonFET (GAA) Transistors and PowerVia for High-Performance Computing},
  abstract={Intel 18A-P is a performance-enhanced, RibbonFET gate-all-around (GAA) transistor technology with backside power delivery through PowerVia. Relative to Intel 18A [1], Intel 18A-P offers over 18% lower power at iso-performance, or over 9% performance gain at iso-power. This improvement is achieved through newly added technology features, transistor performance enhancement, interconnect enhancement and design technology co-optimizations (DTCO). Added features in Intel 18A-P include additional logic VT pairs, skew corner tightening, new low power devices in both high-density (HD) and high-performance (HP) libraries and performanceimproved HP devices in both libraries. In addition, Intel 18AP offers reduced thermal resistance for improved heat conduction.},
  keywords={Displays;Indexes;Indexing;Transistors;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577455},
}

@INPROCEEDINGS{11577386,
  author={Kim, Jeongho and Park, Donghyun and Kang, Hyeri and Jeong, Minhyeok and Seo, Donguk and Lee, Kyungjun and Lee, Yoonmyung},
  title={A 0.511 pJ/Bit Data-Independent and Post-Processing-Free 6T-SRAM-Based TRNG Exploiting Differential Bit-Line Leakage},
  abstract={This paper presents a 6T SRAM-based true random number generator (TRNG) that achieves the lowest reported energy among memory-based TRNGs while enabling dataindependent operation without disturbing stored data. Fabricated in 28 nm CMOS, the TRNG exploits differential bit-line leakage to eliminate post-processing and achieves $0.511 \text{pJ} /$ bit at 0.7 V while passing NIST tests. To the best of our knowledge, it is the first memory-based TRNG demonstrating fully data-independent operation, with only 2.85% energy variation across data patterns. The proposed architecture is fully compatible with conventional 6T SRAM arrays without requiring any modification to the memory cell.},
  keywords={SRAM chips;Energy;Memory;Arrays;Printing;Entropy;Very large scale integration;Noise;Design methodology;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577386},
}

@INPROCEEDINGS{11577601,
  author={Kim, Jae-Young and Suh, Teokkyu and Lim, Junsoo and Park, Minjun and Choi, Hyunmin and Min, Jaeha and Kim, Donghyuk and Kim, Joo-Young},
  title={Specter: 376 fps 2.67 nJ/Pixel 4DGS Processor for Spatiotemporal Reconstruction with Contribution-Ordered Rendering and Deformation-Aware Modeling},
  abstract={This paper presents Specter, the first 4D Gaussian Splatting (4DGS) processor for spatiotemporal reconstruction (STR). Specter reduces redundant external memory access (EMA) and computation with (i) opacity/shape-aware bound tightening for accurate Gaussian-to-tile allocation, (ii) contribution-ordered rendering with hierarchical skip of non-contributing operations, (iii) hash-based deformation detection to skip modeling of non-deformed tiles. Fabricated in 28nm CMOS technology, Specter occupies 12.96 mm2 die area and achieves up to 376 fps at 2.67 nJ/pixel for rendering and up to 112.3 iterations/s for modeling.},
  keywords={Modeling;Pixel;Tiles;Rendering (computer graphics);Printing;Timing;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577601},
}

@INPROCEEDINGS{11577253,
  author={Shigetoshi, T. and Zhao, P. and Witters, L. and Georgieva, V. and Montero, D. and Saroj, R. K. and Gowda, P. P. and Altantzis, T. and Shen, T. H. and Jourdan, N. and Kenens, B. and Vrancken, E. and Maes, J. W. and Vos, J. De and Beyer, G. and Beyne, E. and Tokei, Z. and Shimizu, K. and Kagawa, Y.},
  title={High-Density Backside Connectivity with Remaining Bulk Silicon Substrate Using Self-Aligned Local Backside Dielectric Isolation for Frontside Active},
  abstract={We demonstrate a Local Backside Dielectric Isolation (Local-BDI) process that enables nanoscale Via-last Through Silicon Vias (VL-TSV) overlap with the Active region, thereby overcoming design constraints in conventional approaches. Robust dielectric isolation of TSVs was confirmed across various layouts, without compromising backside-to-frontside connectivity. Compared to prior work, the Local-BDI increases the VL-TSV overlay window by threefold and, when TSVs are used as lines, reduces line resistance by over 50 % compared to Buried Power Rail (BPR) at an equivalent footprint. This approach offers a solution for high-density backside connections with remaining bulk silicon.},
  keywords={Through-silicon vias;Displays;Indexes;Indexing;Silicon;Filling;Resistance;Very large scale integration;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577253},
}

@INPROCEEDINGS{11577623,
  author={Li, Gu-Huan and Cheng, Wan-Hsueh and Liang, Chen-Wei and Chou, Shaun and Yuh, Perng-Fei and Yeh, Li-Yu and Huang, Yen-Hsiang and Liu, Yi-Ching and Huang, Chungi and Yang, Duncan and Wang, Yih and Chang, Tsung-Yung Jonathan and Hung, Lien-Jung and Wang, Ping-Wei and Hou, Chin-Shan and Chuang, Hsin-Jou and Teng, An-Shun and Luo, Li-Ling and Hsu, Jordan},
  title={A $\mathbf{2 n m}$ Nanosheet $\mathbf{1 2 8 K b}$ Anti-Fuse One-Time-Programmable Memory Featuring Core-Transistor-Only High Voltage Program Circuit and Fault-Tolerant Design},
  abstract={This paper presents a 128 K -bit anti-fuse One-Time-Programmable (OTP) memory fabricated in a 2 nm nanosheet CMOS process, utilizing a core-transistor-only architecture. A novel Decoded-stack High Voltage Scheme (DSHVS) is introduced, enabling reliable 5 V programming despite the core-transistor-only constraint. This DSHVS effectively mitigates peripheral device reliability risks by maintaining all core transistors operating below 1 V, far from their $2 ~\mathrm{V}-3 ~\mathrm{V}$ breakdown region. Validated across the full industrial temperature range ($-40^{\circ} \mathrm{C}$ to 125° C), the design demonstrates robust performance with no functional failures post programming. Furthermore, an effective Triple Modular Redundancy (TMR) read scheme significantly enhances the minimum read voltage to 0.7 xVDD, providing an additional 50 % read margin. This achieves low macro ppm defect rates, eliminating the need for Error Correction Code typically employed in conventional 2-bit redundancy schemes.},
  keywords={Stacking;Displays;Indexes;Indexing;Programming;Transistors;Cells (biology);Tunneling magnetoresistance;Fuses;Dielectrics},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577623},
}

@INPROCEEDINGS{11577329,
  author={Lin, Jian-Yu and Lin, Zehao and Niu, Chang and Liu, Chang and Lu, Juanjuan and Nam, Kisoo and Wang, Haiyan and Ye, Peide D.},
  title={Record-Performance In2O3 FETs with Ultra-Scaled Contacted Gate Pitch: Enabled by Higher-$\boldsymbol{k}$ HZO Linear Dielectric and Novel Ti-Seeded Contact},
  abstract={In this work, we demonstrate two strategies to enhance the performance of oxide semiconductor (OS) FETs with ultra-scaled contacted gate pitch (CGP $\leq 80 \text{nm}$). First, the gate capacitance-equivalent thickness (CET) is scaled to 1.36 nm using $\text{Hf}_{0.5} \text{Zr}_{0.5} \mathrm{O}_{2}$ (HZO)-based linear dielectric with $\mathrm{k}>28$. Second, a novel ultrathin $0.5-\text{nm}$ Ti-seeding layer is introduced to further reduce contact resistance $\left(R_{\mathrm{C}}\right)$. By combining CET scaling and Ti-seeded metal contact, In2O3 FETs achieve a record-low $R_{\mathrm{C}}$ of $29.4 \Omega \cdot \mu \mathrm{m}$ (approaching the Landauer limit), a record-high maximum current of $4.15 \text{mA} / \mu \mathrm{m}$, and a record-high on-current of $1.74 \text{mA} / \mu \mathrm{m}$ among all reported OS FETs with contact length scaling. These results establish a new benchmark for OS FETs with ultra-scaled device footprints.},
  keywords={Contacts;Field effect transistors;Printing;Titanium;Recording;Seeds (agriculture);Very large scale integration;Nickel;Dielectrics;Displays},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577329},
}

@INPROCEEDINGS{11577587,
  author={Hong, Feifan and Chen, Jiawen and Liu, Chunxiao and Guan, Pingda and Staszewski, Robert B. and Siriburanon, Teerachot},
  title={A 28-GHz Quadrature LO-Phase-Shifting Digital Wave-Locked Loop (WLL) Achieving 57.2-fsrms Jitter, -80.6-dBc Spurref, and 0.59-μs Near-Integer Lock Time},
  abstract={We propose a $28-\text{GHz}$ digital wave-locked loop (WLL) achieving ultra-low jitter, low reference spurs, and rapid lock time, with integrated LO phase-shifting (LO-PS) for mm -wave MIMO phased arrays. A waveform detector, using I/Q sampling and arctangent-based phase estimation (PEU) provides full- $2 \pi$ monotonic detection with high resolution. Fabricated in $28-\text{nm}$ CMOS, the WLL achieves $57.2-\text{fs} \text{rms}$ jitter and $-80.6-\text{dBc}$ reference spur at 27.375 GHz. A full 360° LO-PS range with 2.8° resolution is demonstrated, along with fast $\pm 1.5-\text{GHz}$ frequency hopping and sub $-0.59-\mu \mathrm{s}$ lock time (<74 reference cycles).},
  keywords={Printing;Distance measurement;Waves;Wireless Access in Vehicular Environments;Jitter;Timing;Frequency},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577587},
}

@INPROCEEDINGS{11577588,
  author={Lee, Jaehoon and Min, Yeji and Sim, Jae-Yoon},
  title={A Floating-Inverter Integrator LDO Achieving Near-Zero Line Regulation via Parasitic-Synthesized Supply-Tracking Offset},
  abstract={This paper presents an analog LDO achieving near-zero line regulation $(<50 \mu \mathrm{V} / \mathrm{V})$. The proposed architecture harnesses the intrinsic parasitic effect-traditionally considered a source of error-within a Floating-Inverter Integrator (FII). By operating the FII under an asymmetric loop configuration, this parasitic-induced charge is converted into a deterministic supply-tracking offset. This offset effectively synthesizes the reference modulation required to neutralize supply disturbances, bypassing the fundamental limitations of finite loop gain with negligible hardware overhead. Implemented in 40 nm CMOS, the LDO demonstrates a $50 \mu \mathrm{V} / \mathrm{V}$ line regulation and $>70 \text{dB}$ PSR, confirming that the parasitic-converted offset enables robust regulation comparable to infinite-gain systems.},
  keywords={Regulation;Gain;Loading;Frequency;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577588},
}

@INPROCEEDINGS{11577518,
  author={Lin, Wei-Hwa and Liu, Yen-Yu and Chih, Yue-Der and Wang, Yih and Chang, Jonathan and King, Ya-Chin and Lin, Chrong Jung},
  title={4nm FinFET CMOS Logic Embedded 1T Contact RRAM},
  abstract={An ultra-high density 4nm FinFET CMOS logic embedded 1T Contact RRAM (CRRAM) is firstly developed in advanced TSMC 4 nm FinFET CMOS logic platform with a small unit size of $0.0103 \mu \mathrm{m}^{2}/\text{cell}$ for high performance SOC applications. The new 4 nm FinFET 1T CRRAM consists of one 4 nm n-type FinFET core device in serial of an innovated contact TMO to form the FinFET CRRAM cells. The Ti based oxynitride TMO served as a memristive storage is fabricated by FinFET contact Ti silicidation and ALD ILD processes. Besides, the ultra-high density 4 nm FinFET 1T CRRAM is fully compatible with 4 nm CMOS logic FinFET platform without extra mask and process, and the specific FinFET contact TMO structure can be adapted to next generations of CMOS FinFET and NSFET technology platforms. Furthermore, the firstly developed 4 nm FinFET 1T CRRAM exhibits quite stable and high performance operations with good reliability and high scalability, which are leading the high density 4 nm FinFET CMOS logic embedded 1T CRRAM to be a promising embedded memory solution in the future of HPC, AI, and SoC applications.},
  keywords={Contacts;Technology;Logic;Cells (biology);Memory;Resistive RAM;Arrays;RRAM;FinFET;Embedded;Contact;Memory;TMO},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577518},
}

@INPROCEEDINGS{11577388,
  author={Kale, Saurabh and Wicht, Bernhard},
  title={A 48 V, 25 W, 6.78 MHz Self-Starting Class-D WPT Transmitter with Self-Biasing and Autonomous Clocking Achieving 91% Peak DC-DC Efficiency},
  abstract={This work presents a self-sustained Class-D wireless power transmitter operating without auxiliary supplies or level shifting. High-side bias is generated using dual-edge capacitor charge harvesting, reducing the required harvesting capacitance, while switch-node voltage sensing is used for autonomous clock recovery eliminating cross-domain gate control. A dedicated startup mechanism initializes operation from rest, enabling entire operation solely with a DC bus voltage and a single clock input. Implemented with a monolithic control stage driving a discrete GaN half-bridge, the system delivers 25 W at 6.78 MHz from 48 V with 91 % DC-DC efficiency over 40 mm transfer distance.},
  keywords={Clocks;Printing;Capacitors;Transmitters;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577388},
}

@INPROCEEDINGS{11577308,
  author={Ding, Cong and Gao, Mingxiang and Zhao, Shaokang and Kuster, Niels and Tajalli, Armin and Shoaran, Mahsa},
  title={A 50-mm2 Crystal-Free Bidirectional WPDT System with Carrier-Reuse Clocking for Implantable Neural Interfaces},
  abstract={Neural implants require compact and energy-efficient wireless power and data transfer (WPDT) while avoiding reliance on costly on-board clock sources. This work presents a crystal-free, full-duplex WPDT link that reuses a 500-MHz power carrier as the sole system clock for synchronized downlink and uplink telemetry. A clock-data recovery (CDR)-less coherent ASK downlink achieves 5 Mb/s, while maintaining uninterrupted power transfer through a 6-mm implant loop. The recovered 500-MHz carrier also wirelessly locks a fast-settling UWB PLL, enabling a duty-cycled uplink supporting 5-500Mb/s. Burst-mode operation enables data-rate-scalable uplink power, ranging from 0.23 mW at 5 Mb/s to 4.93 mW at 500 Mb/s, and extends the uplink range to 40 cm using an on-chip antenna. The complete system, including the loop antenna and chip, occupies 50 mm2.},
  keywords={Uplink;Printing;Distance measurement;Downlink;Phase locked loops;Timing;Joining processes;Clocks;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577308},
}

@INPROCEEDINGS{11577435,
  author={Jung, H. and Son, M. and Chung, W. and Shim, J. and Kim, Y. and Yang, J. and Sato, H. and Noh, S. and Kim, D.S. and Choi, J. and Kwon, H. and Ji, N. Y. and Lee, K. and Park, J. and Kim, C. and Kim, W. K. and Jung, J. and Park, J.-H. and Han, S. H. and Lee, B. and Kang, G. and Ko, S. and Hyun, S. and Ahn, S. J. and Song, J. H.},
  title={Automotive-Grade 5 nm Embedded MRAM with Robust Read Margin from −40°C to 150°C via Co-Optimized MTJ and Integration},
  abstract={We demonstrate the first 5 nm embedded MRAM (eMRAM) with 2T1R cell architecture that meets automotive-grade reliability requirements. By implementing a co-optimized process flow, we simultaneously enhanced key device metrics: tunneling magnetoresistance (TMR) by 15%, breakdown voltage by 15%, and suppressed bitline leakage current by over >6 orders of magnitude, significantly improving device reliability and scalability. The device shows no hard failures in both read and write operations, maintains robust read margin across $-40^{\circ} \mathrm{C}$ to 150 °C, and meets the automotive grade raw bit error rate (BER) requirement. This work enables 5 nm eMRAM for automotive SoCs targeting AEC-Q100-level reliability, overcoming key scaling challenges in photolithography, dielectric integrity, and inter-cell leakage.},
  keywords={Displays;Indexes;Indexing;Tunneling magnetoresistance;Optimization;Cells (biology);Automotive engineering;Resistance;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577435},
}

@INPROCEEDINGS{11577523,
  author={Tan, Fei and Zhao, Zhongyu and Yu, Wei-Han and Un, Ka-Fai and Xu, Jiawei and Hu, Yingzhe and Shoaran, Mahsa and Martins, Rui P. and Mak, Pui-In},
  title={A 0.0257 mm2, 1.16 µW, Mask-Efficient KWS SoC with Hybrid Cap-ROM-IMC/SRAM-NMC and Transfer Learning for Flexible Multi-Keyword Recognition},
  abstract={Scaling always-on keyword spotting (KWS) system to larger vocabularies increases model size, driving higher memory and compute demands that push SoCs $>100 \mu \mathrm{W}$, with significant off-chip loading energy and area overhead. This work presents the first KWS SoC featuring a hybrid Cap-ROM-based in-memory computing (Cap-ROM-IMC)/5T-SRAM-based near-memory computing (SRAM-NMC) architecture with a transfer-learning based model supporting 20 keywords. Fabricated in 28 nm, the SoC achieves 92.1% accuracy on GSCD-v2 with the lowest reported power $(1.16 \mu \mathrm{W})$ and highest ROM memory density $(2372.6 \text{KB} / \text{mm}^{2})$ among prior arts.},
  keywords={Modeling;Read only memory;SRAM chips;In-memory computing;Memory;System-on-chip;Printing;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577523},
}

@INPROCEEDINGS{11577511,
  author={Vitale, Nicholas and McDermott, Mark and Zare, Davood and Hassibi, Arjang and Lee, Tom},
  title={Filter-Free Time-Gated Fluorescence CMOS Biochip with Fast Thermal Cycling for PoC DNA Testing},
  abstract={A 16 × 24 time-gated fluorescence CMOS biosensor array is presented for nucleic acid analysis. Time-interleaved measurement of excitation and fluorescence emission enables each pixel to achieve 9.9 fA input-referred fluorescence photocurrent sensitivity, 129 dB detection dynamic range, and $>133 \text{dB}$ suppression of combined excitation and autofluorescence background, eliminating the need for an optical emission filter. Integrated on-chip heating with passive cooling supports thermocycling with heating and cooling rates exceeding $18{ }^{\circ} \mathrm{C} / \mathrm{s}$, as well as precision melt-curve analysis for immobilized DNA probes on pixel.},
  keywords={Timing;Arrays;Fluorescence;DNA;Pixel;Signal detection;Printing;Filtering;Light emitting diodes;Technology;Fluorescence;biosensors;CMOS biochip;molecular diagnostics;pinned photodiodes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577511},
}

@INPROCEEDINGS{11577481,
  author={Fan, Minghao and Chen, Yilun and Li, Zheng and Ren, Ziyuan and Tang, Minzhe and Liu, Junqing and Liu, Yuxuan and XU, Dongfan and Liu, Zezheng and Yamazaki, Yudai and Kato, Sena and Kunihiro, Kazuaki and Sakai, Hiroyuki and Zhang, Yuncheng and Okada, Kenichi},
  title={A 57-71-GHz CMOS Phased-Array Transceiver with Aperture-Tuning Antenna Achieving 47.9-62.2% EIRP Efficiency Improvement},
  abstract={This work presents a $60-\text{GHz}$ aperture-tuning antenna and transceiver for wide frequency coverage in the 5G NR FR2-2 n263 band. Distributed tuners reconfigure the radiation to enable mode-dependent operation, achieving frequencyselective EIRP enhancement under narrow instantaneous bandwidth operation. Fabricated in $65-\text{nm}$ CMOS, a dualpolarized transceiver with switchless antenna-port modeseparated TX/RX operation is implemented. The proposed design achieves measured TX EIRP improvements of $62.2 {\%} (2.1 \text{dB})$ at 57 GHz and $47.9 {\%}(1.7 \text{dB})$ at 71 GHz without additional power consumption. Using a customized OFDM waveform with $14-\text{GHz}$ frequency coverage, a maximum data rate of $56 \text{Gb} / \mathrm{s}$ is demonstrated with 16-QAM modulation.},
  keywords={Tuning;Apertures;Antennas;Tuners;Displays;Indexes;Indexing;Frequency;Impedance;Printing;Aperture-tuning antenna;high data rate;phased-array;mm-wave;5G NR FR2-2},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577481},
}

@INPROCEEDINGS{11577442,
  author={Nam, Sang-Yun and Kim, Won-Gyu and Lee, Jaeseung and Yang, Jun-Hyeok and Hong, Sung-Wan},
  title={A Scalable Distributed Digital LDO Achieving Fast and Accurate Current Balancing},
  abstract={This paper presents a scalable distributed digital LDO (SDDLDO) achieving fast and accurate current balancing for advanced SoCs. The proposed design utilizes a group-based balancing technique, reducing calibration steps to $\log _{4}{ }^{\mathrm{N}}$, which is much faster than conventional approaches. In addition, a compact analog current sensor enables high-accuracy sensing. The prototype achieves a convergence time of $134.6 \mu \mathrm{s}$ with a 5.2% error rate, proving its practicality for large-scale.},
  keywords={Current;Calibration;Design methodology;Timing;Cells (biology);Measurement units;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577442},
}

@INPROCEEDINGS{11577411,
  author={Gambhir, M. and Mostafa, A. and Chu, F. and Guo, Z. and Hasan, M. and Hassan, A. and Hsiao, E. and Li, Z. and Liu, P. and Lu, F. and Singh, M. and Su, Y.-P. and Visani, D. and Zhou, D. and Wang, H. and Chang, K. and Chen, R. and Lu, K.-M. and Su, Y.-P. and Lahiri, A. and Ramakrishna, P. and Shukla, U. and Singh, A. and Shannon, M.},
  title={A 2.05pJ/bit, 212.5Gbps DSP Based Transceiver with 55dB Reach in 3nm FinFET},
  abstract={This work presents 212.5Gbps ultra-long reach PAM4 transceiver implemented in 3nm FinFET technology. 4-lane transceiver achieves pre-FEC BER of 2e-7 for 54.7dB bumpbump loss and 4e-9 for 49.5dB loss. Per-lane analog power efficiency at 212.5Gbps is 2.05pJ/bit which represents the lowest power as well as the longest reach published for this data rate. DAC current-mode driver-based transmitter achieves SNDR of 36dB, RLM of 0.97 and rms jitter of 50fs.},
  keywords={Displays;Indexes;Indexing;Clocks;Transceivers;Phase locked loops;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577411},
}

@INPROCEEDINGS{11577465,
  author={Lee, Chang-Young and Park, Young-Seok and Park, Hyeon-Jin and Shin, Dong-Hak and Park, Keon-Woo and Yoon, Se-Ryeong and Lee, Dong-Kyu and Kim, Min-Soo and Sung, Gi-Jong and Kang, Kyu-Chang and Kim, Sang-Yun and Yoon, Hyun-Chul and Won, Bok-Yeon and Nam, In-Cheol and Seo, Young-Hun and Bae, Seung-Jun and Sohn, Young-Soo and Hwang, Sang-Jun},
  title={Dual-Phase Offset Compensation and Conditional Latch Gating for a Fully Singleended Dram Core Data-Line Architecture Operating at 0.75 V},
  abstract={This paper proposes a fully single-ended DRAM core dataline architecture for low-power operation and improved backend routing efficiency. And also, this paper proposes a dual-phase offset compensation (DPOC) scheme to prevent charge transfer (CT) gain degradation caused by overcompensation, along with a conditional latch gating (CLG) technique to suppress CSL-induced latch disturb under low supply voltage. The proposed design was implemented in a test chip fabricated using a $10-\text{nm}$–class DRAM process. At 0.75 V operation, the proposed scheme achieves a 99.4% reduction in fail bit count (FBC) compared to the case without CLG, while reducing IDD0 current by 27%.},
  keywords={Displays;Indexes;Indexing;Architecture;Computer architecture;Printing;DRAM chips;Current;Voltage;Switches},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577465},
}

@INPROCEEDINGS{11577338,
  author={Deng, Huanshihong and Fu, Yiheng and Safari, Negin and Huang, Cong and Tan, Fei and Shoaran, Mahsa},
  title={TARNA: A 1.18-μW/Channel Topology-Aware Residual Recurrent CIM Processor for Zero-Shot Seizure Detection},
  abstract={Zero-shot seizure detection avoids patient-specific training but remains challenging under strict power constraints and patient variability. This work presents TARNA, a topologyaware recurrent network accelerator implemented as an ultra-low-power computing-in-memory (CIM) zero-shot seizure detector. TARNA combines graph convolutions with masked residual recurrent updates to eliminate nonlinear gating, while a sparsity-aware CIM macro further reduces energy. Fabricated in $65-\text{nm}$ CMOS, TARNA achieves 100 % zeroshot event-based sensitivity and a $0.048 / \text{hr}$ false-alarm rate on the CHB-MIT dataset, and an AUROC of 0.88 on the TUSZ dataset, operating at the lowest reported power of $22.5 \mu ~\mathrm{W}$.},
  keywords={Modeling;Poles and zeros;Printing;In-memory computing;Signal detection;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Energy;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577338},
}

@INPROCEEDINGS{11577316,
  author={Kao, Chen-Chien and Wei, Tianyu and Tang, Wei and Zhang, Zhengya},
  title={A $5.69 ~\text{mm}^{2} 6.22 \text{Gbps}$ User-Correlation-Based Hybrid Detector for $\mathbf{1 0 2 4 \times 6 4}$ Massive MIMO Systems},
  abstract={This work presents a massive multi-user MIMO (MU-MIMO) detector for next-generation wireless systems. The $5.69 ~\text{mm}^{2}$ detector employs user grouping and hybrid detection, leveraging a mixed-precision architecture to achieve a $6.22 ~\text{Gb} / \mathrm{s}$ throughput with 1259 mW. The chip supports the largest configuration to date, with 1024 base station (BS) antennas and 64 users using 256-QAM. Compared to the state of the art, the chip achieves up to $16.1 \times$ higher area efficiency and up to $8.4 \times$ lower normalized energy.},
  keywords={Signal detection;Correlation;Detectors;MIMO;Printing;Complexity theory;Indexes;Indexing;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577316},
}

@INPROCEEDINGS{11577423,
  author={Han, Seunghee and Kim, Seokman and Han, Sanghyun and Kim, Younghwan and Kim, Joo-Young},
  title={A 0.06pJ/b Current-Conveyor-Based Current-Domain Transceiver with DC-Balanced Multi-Transmission-Line PAM Symbol Encoding},
  abstract={This paper presents a current-domain transceiver using DC-balanced PAM symbol encoding across multiple transmission lines (TLs). By minimizing TL voltage swing to a few millivolts and transmitting information through controlled TL currents using an RX-side current conveyor (CC), the proposed architecture significantly reduces switching power and circuit area. The symbol encoding constrains a constant aggregate PAM level across a TL group, thereby reducing data-dependent simultaneous switching noise (SSN). CC-based current mirroring and ordering-based decoding remove the need for resistive I-V conversion and reference thresholds. A 4-TL PAM-4 group prototype fabricated in 14 nm CMOS achieves 22.9 Gb/s/ pin data rate with 0.006 mm2 silicon area per TL and 0.06 pJ/b energy efficiency. Limited by the CC current-feedback response rather than RC time constants, the proposed transceiver is expected to scale favorably with advanced technology nodes.},
  keywords={Current;Transceivers;Symbols;Voltage;Technology;Printing;Very large scale integration;Energy efficiency},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577423},
}

@INPROCEEDINGS{11577412,
  author={Ichihara, Reika and Kamiyama, Akinori and Kosaka, Takao and Tokuhira, Hiroki and Saito, Nobuyoshi and Toda, Masaya and Matsuo, Kazuhiro and Haga, Ken-ichi and Hamai, Takamasa and Kabuyanagi, Shoichi and Tsukamoto, Takayuki and Kajita, Akihiro and Saitoh, Masumi and Fujii, Shosuke},
  title={Hydrogen Overflow as a Novel Negative Vth Shift Mechanism in PBTI Universal to Planar and Vertical IGZO FETs},
  abstract={We identified novel Positive-Bias-Temperature-Instability (PBTI) mechanism in InGaZnO (IGZO) gate stack by separating multiple PBTI factors using in-depth $C-V$ analysis and atomistic calculations. Besides well-known electron ($\mathrm{e}^{-}$) trapping and donor generation, hydrogen overflow followed by proton accumulation in the gate insulator was found to play a critical role in negative $V_{\text{th}}$ shift of PBTI for the first time. This mechanism was also verified with scaled vertical channel transistors, demonstrating over 10 years of lifetime via process optimization based on a solid understanding of PBTI.},
  keywords={Human factors;Stress;Insulators;Displays;Indexes;Indexing;Timing;Optimization;Printing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577412},
}

@INPROCEEDINGS{11577394,
  author={Li, Yanqing and Bao, Yunjiao and Shi, Mingcheng and Liu, Shuang and Wang, Feixiong and Ding, Yi and Liu, Xiying and Yang, Yanyu and Wei, Yanzhao and Zhang, Yadong and Xu, Gaobo and Zhang, Zhaohao and Wang, Yuyan and Huang, Heyi and Tang, Jianshi and Yin, Huaxiang and Wang, Xiaolei and Ye, Tianchun},
  title={Monolithic 3D Integration of Stacked IGZO/Si Memtransistor-Based 2T0c Gain Cell for Attention Computation and CFET SRAM-DCIM With Multiple Spectral CNT-Sensors for End-To-End Vision Transformers (Vits) on Edge AI},
  abstract={We demonstrate the first memtransistor-based gain-cell (MGC) compute-in-memory device implemented in a monolithic three-dimensional (M3D) chip integrating Si, IGZO, and CNTs technologies. Beyond logics, Si transistors employing dopantsegregation exhibit memtransistor characteristics suitable for memory applications. By vertically stacking an IGZO access transistor on the low-thermal-budget-Si (LT-Si) read memtransistor, an innovative hybrid 2T0C gain cell is realized, enabling low-voltage programmable multistate and stable CIM operation. The device is structurally matched with DEtection TRansformer (DETR) vision transformers, where persistent key-value (K/V) tensors of the frame are stored in memtransistors and dynamic object queries are parallelly pipelined into the storage nodes. Combined with CFET SRAM-DCIM and on-chip multiple spectral CNT-sensor, this end-to-end Q/K/V-aware device-algorithm co-design achieves an $8.93 \times$ energy-efficiency improvement over the baseline, highlighting the potential of M-GC CIM and DCIM for edge vision transformers (ViTs).},
  keywords={Silicon;Displays;Indexes;Indexing;In-memory computing;SRAM chips;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577394},
}

@INPROCEEDINGS{11577584,
  author={Singh, A. and Abdi, D. and Weckx, P. and Singh, A. and Sharma, A. and Biswas, D. and Garcia-Redondo, F.},
  title={Backside Split-VDD Write-Assist Driven SRAM Macro Scaling in Nanosheet-Era},
  abstract={SRAM's scaling at advanced CMOS nodes requires robust write-assist schemes to ensure reliable write operations. This reliance becomes even more critical due to aggressive voltage scaling at advanced CMOS nodes for $\mathrm{V}_{\min}$ applications. This work leverages the backside routing offered in A14 nanosheet technology to enable backside split-VDD implementation without impacting bitcell footprint scaling. This technique offers enhanced writability without requiring self-timed circuits or large capacitors used in conventional negativebitline write-assist. The proposed approach supports up to 512 rows per bitline and delivers a 40% improvement in write energy along with macro level area savings of 12% area per IO column, compared to these conventional assist schemes. The proposed design enables robust SRAM operation at 0.7 V and delivers 100 mV improvement in bitcell write trip point and 200 fJ write energy per bit for 512 rows per bitline with 86% array efficiency and $44.9 \text{Mb} / \text{mm}^{2}$ density for 512 × 256 subarray.},
  keywords={Writing;Arrays;Technology;Very large scale integration;Cells (biology);Printing;SRAM chips;Circuits;Rails;Conferences},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577584},
}

@INPROCEEDINGS{11577369,
  author={Zhang, Yuncheng and Li, Duo and Zhang, Zihang and Sakai, Hiroyuki and Kunihiro, Kazuaki and Okada, Kenichi},
  title={A Switched Inductor-Capacitor Power Amplifier Supporting 100MHz 256-QAM},
  abstract={This paper presents a switched inductor-capacitor power amplifier (SLCPA) that enhances power efficiency. By inserting inductors into the capacitor array, the proposed SLCPA suppresses capacitor charging currents, mitigating switching loss, and improving efficiency. A prototype fabricated in 65 nm CMOS shows a $1.29 \times$ efficiency improvement over typical Class-B efficiency at $6-\text{dB}$ PBO. This design supports up to $100 \text{MSymbol} / \mathrm{s}$ 256-QAM operation without digital predistortion (DPD).},
  keywords={Printing;Capacitors;Quadrature amplitude modulation;Frequency;Inductors;Technology;Current},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577369},
}

@INPROCEEDINGS{11577519,
  author={Zhao, Biqi Rebekah and Chou, Alexander and Lee, Changuk and Pandey, Aviral and Pinkenburg, Jade and Murray, Liz and Gopalan, Karthik and Liu, Chunlei and Lustig, Michael and Muller, Rikky},
  title={A Wireless Pressure Sensor Implant with MRI-Encoded Data Uplink},
  abstract={This work presents a wireless implantable pressure sensor using active MRI-based uplink for simultaneous sensing and localization. The system integrates a MEMS pressure transducer with a $2 \times 1 ~\text{mm}^{2} 28 ~\text{nm}$ IC powered by a 1 MHz inductive link. Data uplink is performed by actively modulating MR image voxels using an on-chip micro-coil. A 12-bit $1^{\text {st }}$-order CT $\Sigma \Delta$ ADC digitizes pressure data at $375 \mu ~\mathrm{W}$. In-scanner tests show 15 % modulation depth at $56 \mu ~\mathrm{W}$.},
  keywords={Uplink;Magnetic resonance imaging;Implants;Coils;Modulation;Radio frequency;Current;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577519},
}

@INPROCEEDINGS{11577258,
  author={Li, Nealson and Liu, Che-Kai and Ellis, Zachary J. and Talley, Connor and Noh, Young-Seok and Patino-Sosa, Kevin and Sathe, Visvesh and Raychowdhury, Arijit},
  title={Event-Gaze: A 28nm 441μs-Latency 12.88mW SoC for Sparse-Event-Based Dynamic Eye Tracking and Gaze Estimation in XR},
  abstract={This paper introduces Event-Gaze, an eye-tracking and gaze-estimation SoC that natively processes asynchronous, sparse event-camera data. Using an algorithm-hardware code-sign approach, the system performs graph construction from the event stream and leverages dedicated Graph Neural Network (GNN) and Transformer accelerators to enable eye tracking and gaze estimation, respectively. Fabricated in 28 nm CMOS, the SoC achieves 1.12° accuracy with $441 \mu$ s latency while consuming 12.88 mW. Compared to baseline solutions, the proposed SoC demonstrates a $1.8 \times$ latency reduction and a 15% improvement in system power efficiency.},
  keywords={Estimation;Engines;Timing;Eyes;Printing;Algorithms;Cameras;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577258},
}

@INPROCEEDINGS{11577550,
  author={Jung, Hakchul and Lim, Jinyoung and Kim, Ingyum and Yu, Jisu and Kim, Daeyeon and Choi, SoonHo and Joo, Bomin and Cho, Jaehee and Han, Jiyun and Choi, Junil and Do, Jungho and Park, Sangdo and Baek, Sanghoon and Shin, Jongshin},
  title={An Innovative DTCO for 2 nm GAA Technology with Hyper-Cells in an Extremely High-Density Library for AI/HPC and Mobile SoC Applications},
  abstract={In this paper, Hyper-cells are introduced as key technology for high-performance and high-efficiency logic design in 2 nm GAA (Gate-All-Around) technology. A Hyper-cell is enabled with wide nanosheets to maximize drive current and area efficiency in an extremely high-density architecture. With state-of-the-art DTCO (Design-Technology Co-Optimization), a block containing Hyper-cells achieves a significant speed improvement of up to 21%, emerging as a key technology that enhances competitiveness in AI, HPC, and mobile-SoC applications.},
  keywords={Cells (biology);Technology;Displays;Indexes;Indexing;Libraries;Printing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577550},
}

@INPROCEEDINGS{11577482,
  author={Moon, Youngjin and Ha, Sangwoo and Ryu, Junha and Oh, Jungjun and Lee, Jingu and Jo, Wooyoung and Kim, Minsung and Yoo, Hoi-Jun},
  title={NOVA: A 5.3mJ/Frame Fully Integrated Neural Video SoC with Content-Adaptive Architecture for 4K Real-Time Encoding/Decoding and Processing},
  abstract={This paper presents NOVA, the first fully integrated neural video system-on-chip (SoC) for end-to-end decoding-processing-encoding on a single chip. A bound-guided mixed quantization (BMQ) and bound-guided unified (BU) core achieves 41.7% computation power reduction. A temporal interpolation unit (TIU) with tiered direct memory access (DMA) reduces system energy by 71.8%. An adaptive entropy coding unit (AECU) reduces coding latency by 79.2%. NOVA is fabricated in 28nm CMOS technology and achieves 31.4 TOPS/W energy efficiency on 4K UVG benchmark.},
  keywords={Videos;Encoding;Printing;Decoding;Displays;Indexes;Indexing;Technology;Quantization (signal)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577482},
}

@INPROCEEDINGS{11577437,
  author={Han, Jiyoon and Tang, Wei and Lu, Cheng-Hsun and Lee, Jungho and Madhow, Upamanyu and Zhang, Zhengya},
  title={A 17.6Gb/s, 39.1pJ/b Tiled Beamspace Training and Detection Processor for mmWave Massive MIMO},
  abstract={A 3.17 mm2 tiled beamspace training and detection processor is designed for mmWave massive MIMO. It integrates channel estimation, weight calculation, and detection using a 2D beamspace transform and adaptive windowing, achieving 17.6 Gb/s throughput at 39.1 pJ/b for a $256 \times 8$ uplink, with 461 ns channel-estimation latency. Compared to recent work, this design provides up to $9.76 \times$ higher throughput, $6 \times$ higher area efficiency, and $1.78 \times$ lower training latency.},
  keywords={Arrays;Timing;Tiles;Antennas;Signal detection;Training;Windows;Design methodology;Transforms;Digital signal processing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577437},
}

@INPROCEEDINGS{11577535,
  author={Kim, Jaerok and Seo, Donguk and Lee, Yoonmyung},
  title={A 0.33 pJ/b Differential CMOS Thyristor-Based TRNG with PVT Tolerance and LSB Min-Entropy Preservation in 28nm Process},
  abstract={This paper presents a differential CMOS thyristor-based TRNG (DCT-TRNG) achieving high energy efficiency and PVT robustness with three key techniques: 1) bias selfregulation using source followers and charge pumps to regulate noise accumulation time, 2) a glitch-filtering latch that prevents state-dependent sampling to preserve LSB entropy, and 3) differential short-window activation to minimize active power. Fabricated in 28 nm CMOS, the prototype achieves $0.33 \text{pJ} / \mathrm{b}$ energy efficiency and 13.3 $\text{Mb} / \mathrm{s}$ throughput at 0.8 V. It maintains consistent entropy across −40 to 125° C and $0.8-1.1 ~\mathrm{V}$, passing all NIST tests without post-processing.},
  keywords={Entropy;Timing;Latches;Printing;Noise;Temperature;Technology;Very large scale integration;NIST;Voltage},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577535},
}

@INPROCEEDINGS{11577413,
  author={Cho, Dongseok and Choi, Hyun-Seung and Park, Injun and Na, Yoondeok and Yang, Seonghun and Yang, Minkyoung and Youn, Yerin and Cheon, Jimin and Lee, Myung-Jae and Chae, Youngcheol},
  title={A SPAD-Based iToF Flash LiDAR Sensor with a Coarse-Fine Operation Scheme Robust Against Strong Background Light},
  abstract={This paper presents a SPAD-based indirect ToF LiDAR sensor achieving a record 94 m range with 11 cm depth precision at 35 fps. To achieve high depth precision and robust operation under strong background light (BGL), we propose a coarse-fine distance measurement scheme. The coarse operation utilizes a binary search to progressively confine the target distance, while the fine operation employs a four-phase method to suppress BGL and ensure high-precision ranging. Fabricated in a 110 nm BSI CIS process, the $100 \times 75$ sensor achieves a high fill factor of 38.7% and a photon detection probability (PDP) of 42.1% at 850 nm. Experimental results demonstrate robust performance under 90 klx BGL.},
  keywords={Distance measurement;Timing;Image sensors;Printing;Pixel;Single-photon avalanche diodes;Displays;Indexes;Indexing;Signal detection},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577413},
}

@INPROCEEDINGS{11577616,
  author={Watanabe, Ryota and Uno, Kazumasa and Kojima, Hidemitsu and Yamada, Ayumu and Otsubo, Hiromasa and Chu, Ted and Huang, Tsung-Hsien and Cheng, Hong-Chen and Nii, Koji and Wang, Yih and Jonathan Chang, Tsung-Yung},
  title={A 25.3% Area-Efficient 1CPP Mask ROM with Robust Power Mesh on 2-nm NanoSheet Logic CMOS},
  abstract={An area-efficient physical layout for a 1T ROM array with robust VSS mesh and coding procedure are proposed in this study. A 1.8 -Mbit 1CPP ROM macro on $2-\text{nm}$ Nanosheet logic CMOS technology shows the record bit-density of $160.7 \text{Mbit} / \text{mm}^{2}$ and access speed of 513 ps, as well as maximum operational frequency and active power are improved by 10.6% and 8.4% from the baseline layout, while suppressing the peak IR drop comparable to the baseline.},
  keywords={Read only memory;Cells (biology);Arrays;Timing;Displays;Indexes;Indexing;Printing;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577616},
}

@INPROCEEDINGS{11577285,
  author={Yang, Heejin and Abillama, Pierre and Wei, Xiangdong and Huluvallay, Mohammed Ashfakh Ali and Zhang, Qirui and Chen, Junhao and Yi, Jayeon and Chen, Chieh-Shen and Bejarano-Carbo, Andrea and Stankovich, Michael Alexander and Lentz, Martin and Bellouard, Yves and Stockton, Patrick and Friel, James and Trickey-Glassman, Andrew and Blaauw, David and Sylvester, Dennis and Kim, Hun-Seok},
  title={A 90.6 pJ/pixel 1280×800 65 fps cm-Scale Fully Integrated Video Encoder System Utilizing a 2×2 Microlens Array},
  abstract={This work presents a compact $(31.5 \times 10.7 \times 4 \text{mm}^{3})$ video encoder system with a commercial imager, flash, a custom 2×2 microlens array, and an image signal processing (ISP) chip using novel 2×2 intra-frame compression. Leveraging the subframe redundancies inherent to the microlens array, the system achieves $>59 \times$ compression with $>32 \text{dB}$ PSNR. With this, the ISP chip fabricated in 28nm CMOS attains 90.6 pJ/pixel energy efficiency at 1280×800, 65fps video stream.},
  keywords={Timing;Arrays;Displays;Indexes;Indexing;Videos;Pixel;Printing;Energy;Modules (abstract algebra)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577285},
}

@INPROCEEDINGS{11577327,
  author={Hwang, Jung-Hye and Hong, Kieop and Kang, Jubin and Kim, Jong-Beom and Hong, Yunji and Kim, Seong-Jin},
  title={A 3.86 TOPS/W TTFS-Based Neuromorphic Image Sensor Featuring Clocked-Recharging SPAD Pixels and Sub-Pixel-Array-Level Processing},
  abstract={This paper presents a neuromorphic SPAD image sensor that features in-sensor computation using a spiking neural network (SNN). Clocked-recharging (CR) SPAD pixels inherently encode light intensity into a time-to-first-spike (TTFS) format, enabling sparse, low-latency computation. An 8b exponential counter at each pixel captures spike timing, while a low-power analog counter with a CDAC implements TTFS-based weighted integrate-and-fire (IF) operation. The proposed 3 × 3 sub-pixel-array (SPA) convolution architecture maximizes insensor parallelism and achieves high throughput. The prototype sensor, fabricated in a $110-\text{nm}$ CMOS process, consumes 5.1 mW at 6.67 kfps, achieving a FoM of 2.6 $\text{pJ} / \text{pixel} \cdot \text{fps} \cdot$ filter and an energy efficiency of 3.86 TOPS/W. Using the extracted $1^{\text{st}}$-layer feature maps (FMs) and a software-based fully connected (FC) layer, a face detection accuracy of 91.5% is achieved.},
  keywords={Timing;Pixel;Image sensors;Radiation detectors;Filtering;Filters;Arrays;Printing;Single-photon avalanche diodes;Architecture;clocked recharging SPAD;neuromorphic image sensor;time-to-first-spike;processing-in-sensor (PIS)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577327},
}

@INPROCEEDINGS{11577213,
  author={Xin, Haoming and van Wegberg, Roland and Stanzione, Stefano and Mihajlovic, Vojkan and Lopez, Carolina Mora and Konijnenburg, Mario and Van Helleputte, Nick},
  title={A Dynamic Supply Temporal Interference Stimulation ASIC Achieving 70% Peak Power Saving and 21V Compliance with Accurate Charge Balancing},
  abstract={A Temporal Interference Stimulation (TIS) ASIC featuring a novel dynamic supply (DS) and common-mode voltage generation technique is proposed. Charge balancing (CB) strategy that works seamlessly with the proposed DS generation technique is also integrated for safety. Fabricated in 130 nm BCD technology, the proposed ASIC uniquely offers HV compliance, high power saving and accurate CB. The ASIC is fully validated both electrically and in-saline.},
  keywords={Titanium;Application specific integrated circuits;Current;Printing;Technology;Tracking},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577213},
}

@INPROCEEDINGS{11577235,
  author={Tang, Minzhe and Ren, Ziyuan and Liu, Yuxuan and Chen, Yilun and Fan, Minghao and Xu, Dongfan and Gu, Haiyun and Li, Zheng and Zhang, Yi and Pang, Jian and Zhang, Daxu and Liu, Zezheng and Xu, Dingxin and Liu, Chenxin and Li, Duo and Zhang, Yuncheng and Wang, Chun and Yamazaki, Yudai and Kato, Sena and Sakai, Hiroyuki and Kunihiro, Kazuaki and Okada, Kenichi},
  title={A Ka-Band Time-Division Multi-Stream Phased-Array Transmitter with Built-in Spatial Notch Generation for 6G MIMO},
  abstract={This work presents an area-efficient Ka-band time-division phased-array MIMO transmitter supporting two streams with only four RF elements. Nyquist-rate beam switching enables RF path sharing and MIMO streams coexistence, reducing chip area and power. A built-in spatial notch generation is embedded without extra hardware cost. A $65-\text{nm}$ CMOS prototype achieves $9.6 ~\text{Gb} / \mathrm{s}$ OTA throughput via MIMO and 35 dB spatial isolation in measurement. An embedded bandpass filter with $42.5 ~\text{dB} / \text{GHz}$ roll-off achieves -24.6 dBc ACLR for OOB emission suppression.},
  keywords={MIMO;Displays;Indexes;Indexing;Streams;Arrays;Timing;Beams;Radio frequency;Phased arrays;time-division;spatial notch generation;phasedarray;Ka-band;MIMO;6G},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577235},
}

@INPROCEEDINGS{11577575,
  author={Tashiro, Yoshiaki and Toyoshima, Takahiro and Yamane, Masataka and Okumura, Kenichi and Kimura, Kota and Murata, Maasa and Kimura, Takumi and Anjo, Kenichiro and Oohama, Tomohiro and Aoki, Goki and Nishijima, Shigeto and Yoshiki, Keisuke and Umeki, Satoru and Iwashita, Tetsuhiro and Ueno, Tomoya and Sakano, Yorito and Oike, Yusuke},
  title={A 50M Pixels 1.22μm Pitch Pixel Image Sensor with 100dB Single Exposure Dynamic Range by Triple Conversion Gain and LOFIC},
  abstract={This paper presents the world's smallest $1.22 \mu \mathrm{m}$ pixel pitch, 50-megapixel triple conversion gain sensor with a low read noise of $0.73 \mathrm{e}^{-} \text{rms}$, a high full well capacity of $250 \text{ke}^{-}$ and single exposure dynamic range of 100 dB. To achieve this, a new pixel architecture is introduced that incorporates a transfer-gate-type LOFIC and separates the reset and source-follower drains.},
  keywords={Pixel;Gain;Image sensors;Displays;Indexes;Indexing;Technology;Personal digital devices;Noise;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577575},
}

@INPROCEEDINGS{11577476,
  author={Gebreyohannes, Fikre and Peng, Yimai and Asghar, Sohail and ElGammal, Khaled and MacHale, John and O'Donoghue, Keith and Bowman, Keith},
  title={A 3nm Variation-Tolerant On-Die Current Sensor for Power-Limits Management},
  abstract={A CPU core globally distributed head switch (GDHS) integrates an on-die resistor-less current sensor (I-Sensor) to measure core current $(\mathrm{I}_{\text{IN}})$ for power-limits management (PLM). The I-Sensor features a replica head switch (RHS) to track the GDHS resistance across process, voltage, and temperature (PVT) variations and an analog front-end (AFE) circuit to measure the voltage drops across GDHS and RHS. With a nearly constant RHS reference current $(\mathrm{I}_{\text{REF}})$ across PVT variations, the I-Sensor calculates $\mathrm{I}_{\text{IN}}$ from a ratio of the AFE measured GDHS and RHS voltage drops, thus cancelling out the GDHS and RHS resistance variations and AFE gain error, resulting in a fast and accurate current measurement, while minimizing post-silicon calibration. From silicon data, the I-Sensor demonstrates a 1.2 MHz bandwidth and a 92.8% accuracy for $\pm 3$ standard deviations $(\sigma)$ for a $100 \times$ dynamic current range (0.12 A to 12 A).},
  keywords={Image sensors;Current;Dies;Voltage;Silicon;Circuits;Calibration;Resistance;Timing;Program processors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577476},
}

@INPROCEEDINGS{11577355,
  author={He, Yifan and Park, Sungjin and Mun, Hangyeol and Hu, Xiaofeng and McMahon, Peter and Molnar, Alyosha C. and Seo, Jae-sun},
  title={A $28 \mathrm{nm} 0.7$ pJ/Bit Optically-Programmable, Fully-Digital Sram-Based Receiver Array with on-Chip Skew Calibration for Energy-Efficient Wireless Data Transfer},
  abstract={This paper presents an Optically-Programmable, fully-digital SRAM-based Receiver (OP-SR) array to address the energy overhead of off-chip memory access. The 28 nm chip demonstrates optical wireless data transfer using spatially modulated light at $0.7 \text{pJ} /$ bit energy with on-chip skew calibration.},
  keywords={Arrays;Cells (biology);Timing;Strontium;Printing;Calibration;Energy;Indexes;Indexing;SRAM chips},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577355},
}

@INPROCEEDINGS{11577608,
  author={Mun, HanGyeol and Meng, Jian and Chen, Chun-Ting and Byun, Hyung Joon and He, Yifan and Hu, Xiaofeng and Park, Sungjin and Seo, Jae-sun},
  title={Spectra: An Asymmetric-Precision Speculative Decoding LLM Accelerator with Product Quantization and Reconfigurable Flip-Flop Buffers in 28Nm CMOS},
  abstract={We present SPECTRA, an LLM accelerator that supports speculative decoding (SD) [1] via prefill/decode/verify phase-wise reconfigurable flip-flop buffers (RFLB). With no accuracy loss, SPECTRA achieves ~4.1×/3.8×/3.7× and ~7.7×/7.9×/ 7.3× reductions in external memory access (EMA)/energy/latency, over micro-scaling (MX) INT8 [2] and FP16 baseline models.},
  keywords={Decoding;Printing;Timing;Modeling;Table lookup;Accuracy;Arrays;Quantization (signal);Energy;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577608},
}

@INPROCEEDINGS{11577374,
  author={Morein, S. and Mahji, P. and Gilmore, W. and Lu, C.-L. and Lin, S.C. and Chuang, C.H. and Sung, C.F. and Chen, C.H. and Huang, C.W. and Chang, Y.L. and Chang, S.-Z. and Liu, Chris and Hcueh, HN and Yeh, Hamy and Chen, PT and Chen, Wenliang},
  title={Multiple-Wafer (9-Layer), Extreme Thin ($3 \mu ~\mathrm{m}$-Si per Stack) and Innovative Fusion-Bonded Via-In-One Architecture for High Bandwidth 3D Memory},
  abstract={An innovative and cost effective multiple-wafer via-in-one TSV architecture implementing into 3D high bandwidth DRAM cube has been demonstrated. Every BEoL routing layer in the 8 -stacked cube directly links to the TSV bus for providing better signal and power integrity is reported. Custom DRAM wafers with via-in-one TSV could reduce power consumption during data movement ($<0.7 \text{pJ} /$ bit). Comparing to stacking memory by hybrid bonding and typical TSV, the ultra-thin $(3 \mu ~\mathrm{m})$ Si substrate of each stacked memory, the directly link of metal routing to TSV, and the embedding via-in-one TSV into oxide trench slot ($10 \times 85 \mu ~\mathrm{m}^{2}$ per area) in the structure provide better signal integrity and minimum transferring path in-between power and signal during the high speed data transfer. Consistence of normalized resistance for each via-in-one TSV and contact ring ($<10 \%$ variation) test describes the good quality of interconnection. The O-type contact ring (Metal to TSV) is decided because of 40 % contact resistance lower than C-type one. Functional validation of 8 stack DRAM $(0.95 ~\mathrm{V}-1.2 ~\mathrm{V})$ on one Logic and successful reliability testing confirm its robustness. This architecture can offer exceptional memory bandwidth $\left(\sim 0.25 ~\text{Tb} / \mathrm{s} / \text{mm}^{2}\right)$ at low data transfer power ($<0.35 ~\mathrm{W} / \text{mm}^{2}$), presenting a completing solution for memory-intensive workloads in AI and HPC.},
  keywords={DRAM chips;Through-silicon vias;Stacking;Memory;Indexes;Indexing;Displays;Contacts;Logic;Silicon},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577374},
}

@INPROCEEDINGS{11577332,
  author={Yamazaki, Yudai and Kinugawa, Ryuji and Kojima, Takumi and Uchino, Takaya and Tian, Anyi and Liu, Chenxin and Park, Sunghwan and Ito, Kotaro and Kato, Sena and Wang, Chun and Tang, Minzhe and Tomura, Takashi and Zhang, Yuncheng and Sakai, Hiroyuki and Kunihiro, Kazuaki and Okada, Kenichi},
  title={A 144Gbps D-Band Dual-Polarized MIMO High-Density Phased-Array Transceiver in 65nm CMOS for 6G UE},
  abstract={This work presents the world's first D-band dual-polarized (DP) multi-input and multi-output (MIMO) phased-array transceiver targeting 6G user equipment (UE), fabricated in a 65 nm CMOS process. The proposed transceiver achieves a maximum data rate of 144 Gbps. Each IC integrates 4 vertical (V) and 4 horizontal (H) polarized TRX elements in a compact layout, resulting in power consumption per element of 124 mW in TX and 90 mW in RX. Furthermore, the transceiver is embedded within a high-power-density antenna-in-package (AiP) module, enabling long-distance single-stream communication up to 50 meters.},
  keywords={Arrays;Phased arrays;Displays;Indexes;Indexing;MIMO;Transceivers;Printing;Measurement;Integrated circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577332},
}

@INPROCEEDINGS{11577279,
  author={Hwang, Donghoon and Jeon, Jaeho and Kim, Gwangsik and Kim, Seong Kwang and Min, Jiwoo and Kim, Hyunsoo and Moon, Byungho and Kim, Jina and Her, Jeongeun and Jeong, Kyutae and Park, Seongbin and Han, Soobin and Yoon, Hyeji and Seo, Jaehun and Ha, Younsu and Shaji, Sandra and Kumar, Aravindh and Park, Tae-Hoi and Kwon, Donghoon and Lee, Junghan and Lee, Byounghoon and Ha, Seungmo and Lee, Sang-Moon and Lee, Do-Sun and Shin, Heonjong and Lee, Wonchang and Jung, Youngchai and Simka, Harsono and Lee, Seung Hun and Park, Sang Wuk and Kwon, Wookhyun and Hyun, Sangjin and Kim, Ilryong and Song, Jaihyuk},
  title={First Demonstration of 3D Stacked Fets at Gate Pitch of 42 nm Featuring Triple Stacked Nanosheet Channels for Advanced Logic Applications},
  abstract={We first present the industrial implement technology of three-dimensional stacked field effect transistors (3DSFETs) at gate pitch of 42 nm and triple-stacked nanosheet channels for n - and p-FETs, respectively. This paper provides a comprehensive overview of the key technologies required for the industrial production of 3DSFETs. Notable advancements include an epitaxial growth process that suppresses channel defect density and the incorporation of epitaxial layers with three distinct Ge contents to precisely form the middle dielectric isolation (MDI). Following the successful implementation of these essential technologies, we evaluate the electrical characteristics and discuss prospects for future logic applications.},
  keywords={Displays;Indexes;Indexing;Field effect transistors;Technology;Stacking;Optimization;Epitaxial growth;Printing;Silicon},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577279},
}

@INPROCEEDINGS{11577252,
  author={Park, Seulki and Jeong, Dongchan and Lee, Sanghoon and Kim, Seungkwon and Lee, Minseong and Choi, Byungha and Masuoka, Sada-Aki and Sohn, Chang-Woo and Kim, Sung Won and Jung, Younghun and Kim, Taeyoung and Kim, Ju-Youn and Park, Kichul and Kim, Hyunjo and Jeong, Jaehun and Kang, Hee Sung and Yasuda-Masuoka, Yuri and Ku, Ja-Hum},
  title={A Product-Oriented 3rd-Generation 2nm GAA Platform Technology with Enhanced Speed and Power Efficiency across Nanosheets},
  abstract={The state-of-art $3{}^{\text{rd}}$ generation 2nm GAA platform has been developed to offer further Power-Performance enhancement with better DTCO options. To boost intrinsic performance in a wide range of nano-sheet, novel Si Surface roughness control and enhanced S/D strain technique have been introduced to obtain $+10 \sim 12 {\%}$ performance. For further product level gain, significantly improved MOL/BEOL resistance $-30 \sim 40 {\%}$ and capacitance $-15 \sim 17 {\%}$ are also offered simultaneously. SF2P GAA provides the best PPA matrix with DTCO solution.},
  keywords={Cells (biology);Technology;Displays;Indexes;Indexing;Optimization;Very large scale integration;Gain},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577252},
}

@INPROCEEDINGS{11577532,
  author={Cho, Seong-Eun and Kim, Ye-Dam and Lee, Jongmi and Lim, Yong and Kwak, Yong-Sik and Moon, Kyoung-Jun and Yoo, Sangmin},
  title={Robust Configurable 1.5 MHz/2.5 MHz IF Quadrature CT ΔΣ Modulator Using SAQB and QDNC for 175.4 dB FoMs in 14 Nm FinFET},
  abstract={This paper presents a quadrature continuous-time delta-sigma modulator (QCTDSM) with low intermediate frequency (Low-IF) applications, featuring a configurable IF switching between 1.5 MHz and 2.5 MHz. The proposed architecture employs a Single-Amplifier Quadrature Biquad (SAQB) together with a proposed Quadrature Digital Noise Coupling (QDNC) technique, enabling sixth-order noise shaping with a compact, efficient loop structure. By utilizing the digitally operated QDNC scheme, the proposed modulator achieves improved robustness against process variations. As a result, the modulator achieves FoMs of 175.2 dB and 175.4 dB for 2 MHz and 4 MHz BW, respectively. Measurement results from 50 fabricated chips demonstrate performance variations confined within $\pm 3 \text{dB}$, validating the robust characteristics of the proposed design. Implemented in a 14 nm FinFET process, the prototype operates at 1.05 V, consumes 914 mW, and exhibits $\pm 1.65 \text{dB}$ of STF peaking.},
  keywords={Noise shaping;Poles and zeros;Very large scale integration;Printing;Architecture;Computer architecture;Noise;Shape},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577532},
}

@INPROCEEDINGS{11577333,
  author={Chae, Suyun and Kwon, Taeksu and Park, Yousung and Kim, Insuk and Kim, Yeongmin and Kim, Siwoo and Kim, Hyun-Sik},
  title={A 3200×2880, 120Hz OLED Display Driver IC with Miller-Charge Cancellation (MCC) Achieving a $\text{13.3V} {/} {\mu}\mathrm{s}$ Slew Rate Under Worst-Case Full-Channel Load},
  abstract={This paper presents a 2880-channel 10b driver IC for $3200 \times 2880120 \text{Hz}$ OLED displays. Miller-charge cancellation boosts the slew rate (SR) by $3.3 \times$ without static power, while a fast-slew input method relieves dynamic loading. Fabricated in 28 nm CMOS, the $10 \mu \mathrm{m}$-pitch chip attains a worst-case SR of $13.3 \mathrm{V} / \mu \mathrm{s}\left(\sigma_{\text{SR}}=7.5 {\%}\right)$ under full-channel transitions, improving color fidelity and uniformity on a 6.9-inch OLED.},
  keywords={Strontium;Displays;Organic light emitting diodes;Printing;Timing;Amplifiers;Loading},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577333},
}

@INPROCEEDINGS{11577359,
  author={Hermans, Yannick and Fang, Yu and De Wachter, Bart and Wiaux, Vincent and Kovalevich, Tatiana and Lariviere, Stephane and Mingardi, Andrea and Ciofi, Ivan and Blanco, Victor and Halder, Sandip},
  title={First Demonstration of Metal Interconnect At-Resolution Stitching with 0.55NA EUV Lithography for A10 Node and Beyond},
  abstract={We report the first comprehensive assessment of at-resolution stitching for BEOL interconnects using 0.55NA EUV lithography, a key enabler for continued transistor scaling. With 0.55NA anamorphic optics limiting the maximum field size, at-resolution stitching is being considered to extend the field size for large chip applications. Based on experimental characterizations complemented by simulations, we demonstrate similar electrical performance and reliability for at-stitch and in-field interconnects down to metal pitch 24 nm, supporting future BEOL integration with 0.55 NA EUV lithography.},
  keywords={Printing;Displays;Indexes;Indexing;Resistance;Testing;Simulation;BEOL;interconnect;at-resolution stitching;0.55NA EUVL;electrical characterization;reliability tests},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577359},
}

@INPROCEEDINGS{11577370,
  author={Yoon, Junghyun and Lu, Zhaonan and Lim, Yong and Tan, Zhichao and Chae, Youngcheol},
  title={A 1MHz-BW 90.1dB-SNDR CT Zoom ADC with Mismatch Error Shaping Preserving Full-Scale Input Range},
  abstract={This paper presents a high-resolution, CT zoom ADC with mismatch error shaping (MES) technique. While conventional MES techniques often reduce the maximum stable amplitude (MSA), the proposed ADC preserves the full-scale input range through a partial-feedback coarse $\Delta\Sigma\mathrm{M}$. To reduce the MES implementation overhead, bitwise subtraction technique is introduced. A tri-level RDAC with a dummy DAC enhances HD3 by 15.5dB by suppressing signal-dependent reference modulation. Fabricated in a 65nm CMOS, it achieves 104.8dB SFDR, 90.1dB SNDR, and 92.5dB DR in a BW of 1MHz, while consuming only 1.7mW. This corresponds to a state-of-the-art FoM of 180.2dB.},
  keywords={Printing;Distance measurement;Sigma-delta modulation;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577370},
}

@INPROCEEDINGS{11577396,
  author={Kosugo, E. and Yamanaka, T. and Yahata, K. and Hayashida, M. and Ohashi, T. and Matsumoto, K. and Aoki, M. and Yoshida, H. and Watanabe, K. and Kiyofuji, Y. and Gondo, S. and Sakano, Y. and Oike, Y.},
  title={A Single Exposure 137 dB Dynamic Range CMOS Image Sensor with Low Dielectric Absorption Image Lag},
  abstract={This paper presents a 2897 × 1877 CMOS image sensor with a $3.0 \mu \mathrm{m}$ pixel pitch. The proposed sensor achieves a 137 dB single-exposure dynamic range (SEDR) at 85 °C and a 28 dB junction SNR at 105 °C. The sensor employs a sub-pixel architecture with 3D-MIM technology and includes a function to reduce the dielectric-absorption image lag. The combination of high dynamic range and reduced dielectric-absorption image lag makes the sensor well-suited for automotive applications.},
  keywords={Pixel;Image sensors;Timing;Displays;Indexes;Indexing;Dielectrics;Technology;Absorption;Distance measurement},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577396},
}

@INPROCEEDINGS{11577473,
  author={Abdi, D. and Singh, A. and Weckx, P. and Sharma, A. and Boemmels, J. and Yang, S. and Verschueren, L. and Hellings, G.},
  title={5T+1 CFET SRAM with Dual-Bitline-Per-Cell-Height Enabling Differential Readout and 12.5% Area Reduction},
  abstract={This work presents the 5T+1 CFET SRAM, a 5Tfootprint bitcell exploiting vertical $\mathrm{n} / \mathrm{p}$ stacking to integrate a transmission-gate access device without area penalty. A dual-bitline-per-cell-height architecture is proposed to enable differential sensing using the bitline of an unselected cell as a reference. The bitcell integrates a split–$\mathrm{V}_{\text{DD}}$ in-bitcell writeassist to improve writability without impacting bitcell footprint. DTCO evaluation shows 12.5% smaller bitcell than 6T CFET, $7-15 {\%}$ faster write, and 21% standby leakage reduction, while maintaining comparable RSNM and $>150 \text{mV}$ five-percentile HSNM for unselected cells during write under split–$\mathrm{V}_{\text{DD}}$.},
  keywords={SRAM chips;Writing;Cells (biology);Printing;Stacking;Arrays;Technology;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577473},
}

@INPROCEEDINGS{11577620,
  author={Kanchwala, Mustafa and Xu, Jianxiong and Abdolrazzaghi, Mohammad and Kim, Wonjune and O'Leary, Gerard and Huang, Yu and Ma, Junyu and Filho, Jose Sales and Nag, Sudip and Cai, Hanfeng and Deng, Qiaosong and Deng, Weian and Mutyala, Anush and Kumaresan, Theeban and Ren, Shidu and Lim, Chae and Movahed, Mandana and Moradi, Homeira and Eleftheriades, George and Valiante, Taufik A. and Robinson, Jacob T. and Genov, Roman},
  title={A Split-Inference Intracortical Interface IC for Battery-Free mm-Scale Magnetoelectrically Powered Brain Implants},
  abstract={This paper presents a brain-interfacing IC that enables depth-scalable edge inference within the tight form factor and energy budget of a minimally invasive, battery-free implant. A $181-\text{dB}$ FoM noise-shaping SAR ADC with an LNA is shared across 20 of 32 recording electrodes. On-chip inference combines boosted decision-stump spike classification with first-layer spiking- and deep-neural-network (SNN/DNN) inference, reducing the output data rate by up to $16,732 \times$. An event-based body-coupled communication (BCC) TX streams intermediate activations to a wearable device for remaininglayer execution. The communication and computation energy costs are 1.23 nW and 53 nW per input, respectively, enabling wireless powering by a mm -scale magnetoelectric film.},
  keywords={Displays;Indexes;Indexing;Printing;Timing;Joining processes;Biological tissues;Technology;Integrated circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577620},
}

@INPROCEEDINGS{11577634,
  author={Dutta, Ananya and Peer, Akshit and Siddiqui, Saima and Bunyan, Jonathan and Feng, Weijie and Huang, YuWen and Jezewski, Christopher and Jordan, Robert and Kalita, Abinasha and Kevek, Joshua and Khora, Emmannuel and Krist, Brian and Mehta, Nikhil and Metz, Matthew and Seidel, Robert and Shih, En-Min and Sukrittanon, Supanee and Kobrinsky, Mauro},
  title={Performance Improvement from Subtractive Ruthenium Interconnects with Airgap},
  abstract={Subtractive ruthenium (sRu) interconnects have shown great promise for future interconnect pitch scaling, especially for pitch ≤ 22 nm. In this publication, we first demonstrate R&D results from a fully functional sRu and airgap (AG) interconnect architecture integrated with RibbonFET devices on an advanced R&D test vehicle. Implementation of sRu interconnects with airgaps resulted in approximately 2% ring oscillator frequency improvement at matched leakage, as compared to a damascene Cu reference, primarily driven by a significant line-to-line capacitance reduction. Airgap is shown to enable up to a 35% reduction of line-to-line capacitance. We also identified opportunities to improve via resistance by up to 50% for both upper and lower vias.},
  keywords={Air gaps;Displays;Silver;Indexes;Indexing;Copper;Metals;Technology;Capacitance;Kelvin},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577634},
}

@INPROCEEDINGS{11577393,
  author={Lin, Hong-De and Su, Yuan-Chun and Su, Tzu-Chuan and Ambrosi, Elia and Wu, Cheng-Hsien and Kuo, Cheng-Chen and Chang, Chih-Yu and Chiang, Hung-Li and Wei, Ting-Hua and Hsu, Yu-Wei and Huang, Ching-Shuan and Lee, Sin-Yue and Chang, Wei-Ning and Fu, Jui-Han and Tung, Vincent and Sun, Jack Y.-C. and Hu, Chenming and Wu, Chih-I and Lin, Chao-Cheng and Hou, Tuo-Hung and Bao, Xinyu and Lee, Tsung-En},
  title={First Demonstration of Heterogeneous n-IGZO/p-WSe2 Integration as a Power-Performance Area Booster for BEOL Complementary Gain-Cell Memory},
  abstract={This work presents the first demonstration of a BEOL-compatible complementary two-transistor gain cell (2T GC) memory, featuring a heterogeneous integration of an oxide semiconductor (OS) nFET as the write transistor and a 2D-material pFET as the read transistor. At a scaled channel length $\left(\mathrm{L}_{\text{CH}}\right)$ of 50 nm and width $\left(\mathrm{W}_{\text{CH}}\right)$ below 100 nm, both n-IGZO and p-WSe ${ }_{2}$ FETs exhibit large $\mathrm{I}_{\text{on }} / \mathrm{I}_{\text{off }}\left(>10^{8}\right)$, leading to the record-high read current $(\mathrm{I}_{\text{RBL }} \sim 22 \mu \mathrm{A})$ and $\mathrm{I}_{\text{RBL margin}}$ of $1.5 \times 10^{5}$ for high-speed read operation. Though aggressive cell size scaling increases the challenge of capacitive coupling, the counter-coupling inherited from the NP-GC effectively reduces the coupling-induced voltage drop at the storage node by $\sim 0.57 \times$ during the read operation. The read margin $(\mathrm{V}_{\text{margin}})$ is enhanced by $\sim 1.52 \times$ through the optimization of the proposed n-OS/p-2D 2T GC structure. This design provides a scalable pathway toward high-density multilayered cache memory stacked on advanced CMOS technology.},
  keywords={Couplings;Joining processes;Timing;Displays;Indexes;Indexing;Tin;Printing;Modeling;Cells (biology)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577393},
}

@INPROCEEDINGS{11577604,
  author={Bader, Samuel J. and Vora, Heli and Chen, Po-Han and Jha, Saket and Frolov, Dimitri and Khandelwal, Isha and Jayaprakash, Shreyas S. and Koirala, Pratik and Oni, Adedapo and Beumer, Michael and Golani, Prafful and Zubair, Ahmad and Hoff, Thomas and Vyatskikh, Andrey and Radosavljevic, Marko and Rangaswamy, Jagdish and Momson, Ibukunoluwa and Yu, Qiang and Rami, Said and Sarkar, Soumen and Le, Hanh-Phuc and Then, Han Wui},
  title={A 300mm Monolithic GaN MOSHEMT and Si pMOS Technology Demonstrating Energy-Efficient Multi-Thousand-Gate Digital Logic for Power Management},
  abstract={This work demonstrates multi-thousand-gate, standard-cellbased digital circuits realized in a monolithic GaN nMOS and Si pMOS process. First, we report a 32 -bit simplex serialperipheral interface for configuring on-chip designs. Second, we report a record power-delay-product of $6.2 \text{aJ} /$ stage for a 7213-stage ring oscillator (>3 orders more efficient than GaN DCFL). These circuits show that “GaN+Si” technology expands the viable scale of monolithically-integrated controls for GaN power delivery and RF applications.},
  keywords={Generative adversarial networks;Printing;Displays;Indexes;Indexing;Silicon;Inverters;Technology;Delays;Design methodology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577604},
}

@INPROCEEDINGS{11577346,
  author={Lee, Donggun and Song, Kyoungseok and Rhee, Sangho and Kim, Tae Wook},
  title={A 3.25-Gb/S 0.74-pJ/bit IR-UWB Transmitter Using Edge-Reference Differential Phase Shift Keying (ER-DPSK)},
  abstract={This paper presents a high-data-rate, low-power impulse-radio ultra-wideband (IR-UWB) transmitter employing edge-reference differential phase-shift keying (ER-DPSK). ER-DPSK uses the rising edge of each pulse as an inherent phase reference and encodes data in the phase difference between adjacent pulses. ER-DPSK eliminates the need for power-hungry phase-locked loops (PLLs) and preamble-based synchronization. ER-DPSK is compatible with pulse-position modulation (PPM), pulse-width modulation (PWM), and frequency-shift keying (FSK), enabling high-order hybrid modulation. The transmitter achieves 3.25 Gb/s with an energy efficiency of 0.74 pJ/bit. To the best of our knowledge, this is the first IR-UWB transmitter to reach the 3-Gb/s class while breaking the 1-pJ/ bit energy-efficiency barrier.},
  keywords={Erbium;Phase shift keying;Modulation;Synchronization;Phase locked loops;Pulse width modulation;Transmitters;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577346},
}

@INPROCEEDINGS{11577581,
  author={Kayano, Kosuke and Koh, Sang-Gyu and Sun, Shiyuan and Hamasuna, Satoshi and Miyasako, Takaaki and Hosokura, Tadasu and Yajima, Takeaki},
  title={A Highly Scalable and Noise-Robust Direct Digital Readout (DDRO) for E-Skin Temperature Sensor Arrays Achieving 12.2 pJ/Sensor and 710 ns/Row},
  abstract={This paper proposes a scalable and noise-robust readout architecture for high-density multi-point e-skin applications, termed Direct Digital Readout (DDRO), which directly reads the binary outputs of phase-transition sensors using digital logic circuits. Conventional readout schemes based on analog sensors and analog-to-digital converters (ADCs) suffer from rapidly degraded signal margin and conversion accuracy as sensor arrays scale up, due to increased wiring noise and parasitic capacitance and resistance. By fully digitizing the signals on the interconnects, the proposed DDRO structurally suppresses noise sensitivity during array expansion and achieves high scalability for large-scale sensor arrays. A prototype system consisting of a flexible 1024-sensor array and a DDRO chip demonstrates a readout latency of 710 ns per row and a readout energy of 12.2 pJ per sensor. The proposed approach enables full-frame readout of all 1024-sensor array within $23 \mu \mathrm{s}$ while consuming 12 nJ.},
  keywords={Image sensors;Arrays;Sensor arrays;Voltage;Noise;Circuits;Energy;Resistance;Printing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577581},
}

@INPROCEEDINGS{11577251,
  author={You, Hyeongyu and Nam, Geonwoo and Cho, Jaehee and Jeong, Minjae and Yu, Jisu and Do, Jungho and Jung, Hakchul and Baek, Sanghoon},
  title={High-Performance 2nm GAA Standard Cell Architecture Exploiting Backside Power Delivery via Dynamic Area Borrowing},
  abstract={Aggressive scaling of standard cells to a 5-track (5T) height in the 2nm GAA node creates a critical performance bottleneck by physically confining the maximum active width $(W_{\text{active}})$. To overcome this limitation, we propose dynamic area borrowing (DAB), a design-technology co-optimization (DTCO) architecture enabled by a backside power delivery (BPD) and direct backside contacts (DBC). By accommodating larger active cells via row-boundary area borrowing, DAB maximizes drive strength within a uniform cell footprint. The proposed DAB achieves a $5.0 {\%}-9.0 {\%}$ cell-level delay reduction and a $9.8 {\%} F_{\max}$ improvement in block-level evaluation on a representative ARM core without area overhead. Ultimately, DAB redefines the performance frontier of logic scaling in sub-2nm nodes, providing an effective solution for next-generation high-performance logic.},
  keywords={Cells (biology);Technology;Architecture;Computer architecture;Design methodology;Libraries;Printing;Very large scale integration;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577251},
}

@INPROCEEDINGS{11577618,
  author={Hiroki, Mizuha and Takeuchi, Tatsuya and Nakamoto, Yuta and Silva, Yhang R. and Yoshimura, Yuki and Hagiwara, Hiroki and Takata, Ryotaro and Hotta, Kaihei and Nishikawa, Rui and Nishimura, Yuji and Yamaguchi, Shingo and Takayama, Ayumi and Nakamura, Ryosuke and Toyoshima, Takahiro and Sakano, Yorito and Oike, Yusuke},
  title={A 2.1-μm Pixel-Pitch CMOS Image Sensor with 65% MTF/35% QE IR Global Shutter and RGB Rolling Shutter Sequential Operation for In-Cabin Applications},
  abstract={In this work, we propose a $2.1-\mu \mathrm{m}$ RGB-IR CMOS image sensor with sequential operation combining rolling shutter (RS) and global-shutter (GS) modes for in-cabin applications. As an RGB sensor, it achieves a dynamic range (DR) of 112 dB at $T_{j}=85^{\circ} \mathrm{C}$, enabling high-quality visible imaging. For the IR sensor, we achieve state-of-the-art characteristics with 65% modulation transfer function (MTF) and 35% infrared quantum efficiency (IR-QE), facilitating gaze detection under IR illumination.},
  keywords={Pixel;Image sensors;Displays;Indexes;Indexing;Printing;Timing;Lighting;Personal digital devices;Signal detection},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577618},
}

@INPROCEEDINGS{11577206,
  author={Seok, Hyun-Gi and Kim, Sinyoung and Jung, Wonjun and Kim, Junhyeong and Park, Eunhye and Kim, Yeongdae and Lee, Jaekeun and Kang, Sumin and Myeong, Jonghoon and Seo, Duyong and Han, Honggul and Son, Hyeonuk and Jang, Junyoung and Kang, Hoon and Ahn, Chiyoung and Sung, Hyukjun and Kim, Wan and Park, Hyun-Chul and Park, Chan-Hong and Kim, Joonsuk},
  title={An IEEE 802.15.4z-Compliant IR-UWB System-on-Chip with 27 dB Self-Interference Cancellation and Reconfigurable TIA for Automotive Radar and Ranging},
  abstract={This work presents an IEEE 802.15.4z-compliant UWB SoC with a TX spillover cancellation enabling shared-antenna fullduplex operation. The proposed PVT-robust FIR filter based SIC achieves 27 dB average rejection $(\sigma=1.4 \text{dB})$, improving the RX NF from 21 to 4 dB. A reconfigurable TIA supports both of low-power ranging and wide bandwidth radar modes using a feed-forward architecture. Child presence detection is demonstrated in a real vehicle using a certified infant dummy and human subjects, including worst-case legroom scenarios.},
  keywords={Silicon carbide;Displays;Indexes;Indexing;Pediatrics;Distance measurement;Radar;Antennas;Gain;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577206},
}

@INPROCEEDINGS{11577286,
  author={Yu, Haochen and Jiang, Yixuan and He, Ruihao and Yu, Hao and Deng, Zihao and Jiang, Hongwu and Huang, Shanshi and Xu, Zefeng},
  title={First Demonstration of High-Precision (15 Bits) Photonic-Electronic Hybrid Compute-in-Memory System Based on FeFET Pockels Photonic Memory},
  abstract={This paper presents a photonic-electronic hybrid high-precision computing-in-memory (CIM) system. By leveraging the cyclic output characteristic of Pockels photonic memory and residual number system (RNS) encoding, the proposed system is closed under multiplication and addition, significantly reducing signal-to-noise ratio (SNR) requirements. The ferroelectric field-effect transistor (FeFET) Pockels photonic memory utilizes the Pockels effect for waveguide modulation and the screening effect for in-memory multiplication. With RNS implemented in this hybrid system, the system achieves up to 15-bit computational precision, showing improvement of up to 42% in inference accuracy on transformer-based model and 10 dB in super-resolution task, compared to conventional analog CIM arrays.},
  keywords={Arrays;In-memory computing;Printing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Memory;Very large scale integration;Accuracy;Modeling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577286},
}

@INPROCEEDINGS{11577336,
  author={Zaffin, S. and Leoncini, M. and Bertolini, A. and Dago, A. and Gasparini, A. and Levantino, S. and Ghioni, M.},
  title={A 0.5W/mm2-Power-Density, 91.6%-Peak-Efficiency, Resonant Dual-Path Interleaved DC-DC Converter},
  abstract={A DC-DC converter is presented that combines dual-path power delivery with resonant capacitor soft charging and interleaved operation to achieve high power density in sub-1V portable power management. The chip, implemented in a $0.18 \mu \mathrm{m}$ BCD technology, is co-designed together with a PCB interposer, enabling vertical stacking of passive components while leveraging the PCB parasitic inductance to realize zerocurrent switching. The converter operates with a 4.0 -to- 5.0 V input voltage and delivers a current up to 7A at a voltage in the 0.6 -to- 1.2 V range, with 91.6% peak power efficiency and 0.5 W/mm2 peak power density.},
  keywords={Current;Converters;Dies;Voltage;Inductors;Renewable Portfolio Standard;Technology;Loading;Printing;Zero current switching},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577336},
}

@INPROCEEDINGS{11577211,
  author={Guo, Yanshu and Li, Heyue and Zhang, Siqi and Shi, Jun and Yin, Shijie and Liu, Qichun and Deng, Ning and Wang, Zhihua and Li, Tiefu and Wang, Guoxing and Zheng, Yuanjin and Jiang, Hanjun},
  title={A Cryo-CMOS Fully-Integrated Superconducting Qubit Reflectometry Readout IC with FCNN-Based Adaptive Drift Mitigation and FIR-DSM-Based Stimulus TX},
  abstract={This work presents a neural-network augmented cryo-CMOS readout IC for superconducting quantum computing. With the FCNN-based qubit state detector, this IC achieves the ability of real-time qubit readout drift monitoring and adaptive drift mitigation. Adopting the FIR-DSM-based stimulus TX technique, the measured TX power is 2.6mW, which is $>1.9 \mathrm{x}$ lower than prior designs. Quadrature digital-IF reflected RX is implemented with stimulus pulses synthesis and reflected signal processing, resulting in a fully-functional readout IC with a lowest power of 10.3mW. Verification with a transmon qubit at 4K, this IC achieves a readout fidelity up to 95.6%.},
  keywords={Integrated circuits;Qubit;Printing;Displays;Indexes;Indexing;Finite impulse response filters;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577211},
}

@INPROCEEDINGS{11577540,
  author={Sheng, C. and Demuynck, S. and Batuk, D. and Ganguly, J. and Peng, A. and Chiarella, T. and Eyben, P. and Schippers, D. and Loo, R. and Choudhury, S. and Dursap, T. and Porret, C. and Di Donato, L. and Huang, H. and Iacovo, S. and Mingardi, A. and Khazaka, R. and Cullen, C. P. and Casey, D. and Sebaai, F. and Gowda, P. Puttarame and Saroj, R. Kumar and Vandooren, A. and Cavalcante, C. and Hosseini, M. and Mitard, J. and Vandersmissen, K. and Jourdan, N. and Reddy, N. and Koo, I. and Sanchez, E. Altamirano and Marquez, A. Sepulveda and Lima, L. P. B. and Horiguchi, N. and Biesemans, S.},
  title={Improved Backside Contacting for CFET},
  abstract={We report on improvements to the integration flow of backside contacted (BSC) monolithic CFET (mCFET) devices, demonstrated by enhanced survival rate (SR) and bottom pFET performance. A new BSC scheme (code name: delta), enabled by frontside-formed bottom dielectric isolation (FS-BDI) under the source/drain (SD), reduces the variability in eSiGe:B volume and reduces the contact resistance to the device. Combined with optimized bonding, extreme wafer thinning, backside-formed BDI (BS-BDI) and BSC etch, pFET SR improves from 45% to 85% versus our previous report.},
  keywords={Displays;Indexes;Indexing;Silicon;Printing;Etching;Strontium;Very large scale integration;Fluid flow;Transmission electron microscopy},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577540},
}

@INPROCEEDINGS{11577295,
  author={Schram, T. and Smets, Q. and Arutchelvan, G. and Yao, C.-H. and Chou, S.A. and Li, M.-Y. and Batuk, D. and Rodrigues, T. and Ghosh, S. and Kumar, P. and Groven, B. and Opdebeeck, A. and Alvarez, D.M. and Jiang, Y. and Sarkar, T. and Kellens, K. and Vrancken, E. and Da Silva, C. R. and Mogultay, C. and Shen, T-H and Faramarzi, V. and Kar, G. S. and de la Rosa, C. J. Lockhart and van Dal, M. and Yen, A. and Radu, I. P. and De Poortere, E.},
  title={First EUV-Enabled Integration Route for 50 nm Pitch N and PMOS Transistors with 2D Materials Channel from a 300 mm Fab},
  abstract={EUV lithography and 300mm fab processing are used to enable an innovative integration approach for transistors with 2D materials channel. The route demonstrates for the first time scaled transistors, as relevant for technology applications, contact pitch down to 50nm, active width down to 75 nm and EOT $\sim 2 \text{nm}$. Quasi-CMOS integration was done by using different channel materials, $\text{MoS}_{2}$ for NMOS and $\text{WSe}_{2}$ for PMOS, side by side on the same 300mm wafer by die/ small wafer transfer. A key achievement is the demonstration of fabprocessed 2D PMOS transistors nearly matching the performance of best lab devices. This solves a critical missing piece for the lab to fab transition of 2D and BEOL CMOS technologies.},
  keywords={Displays;Indexes;Indexing;High-k dielectric materials;Transistors;Materials;Contacts;Printing;Technology;Field effect transistors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577295},
}

@INPROCEEDINGS{11577431,
  author={Ungethüm, Jonathan and Kauffman, John G. and Ortmanns, Maurits},
  title={A 120-MHz BW CT 0-4 MASH DS ADC Employing a 2xTI SAR ADC and a Digital 1-0 MASH DSM DAC in 22nm FDSOI},
  abstract={A continuous-time (CT) 0-4 multi-stage noise shaping (MASH) Delta-Sigma (DS) ADC achieving high linearity without DAC calibration in a 120 MHz bandwidth (BW) is presented. The ADC uses a dual-return-to-zero (DRTZ) DAC with single-ended LSBs and requires a single 0.8 V supply. The prototype fabricated in 22 nm FDSOI operates at 2.4 GHz sampling frequency and achieves 70.2 dB SNDR and 93.3 dB SFDR.},
  keywords={Multi-stage noise shaping;Mashups;Delta-sigma modulation;Printing;Filtering;Finite impulse response filters;Filters;Linearity;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577431},
}

@INPROCEEDINGS{11577349,
  author={Fu, Zih-Sing and Li, Peter Zhi Xuan and Karaman, Sertac and Sze, Vivienne},
  title={Gleanmer: A 6 mW SoC for Real-Time 3D Gaussian Occupancy Mapping},
  abstract={High-fidelity 3D occupancy mapping is essential for many edge-based applications (such as AR/VR and autonomous navigation) but is limited by power constraints. We present Gleanmer, a system on chip (SoC) with an accelerator for GMMap, a 3D occupancy map using Gaussians. Through algorithm-hardware co-optimizations for direct computation and efficient reuse of these compact Gaussians, Gleanmer reduces construction and query energy by up to 63% and 81%, respectively. Approximate computation on Gaussians reduces accelerator area by 38%. Using 16 nm CMOS, Gleanmer processes $640 \times 480$ images in real time beyond 88 fps during map construction and processes over 540 K coordinates per second during map query. To our knowledge, Gleanmer is the first fabricated SoC to achieve real-time 3D occupancy mapping under 6 mW for edge-based applications.},
  keywords={Timing;Printing;Weighted sum model;Construction;Information rates;Technology;Throughput;3D mapping;autonomous navigation;AR/VR},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577349},
}

@INPROCEEDINGS{11577339,
  author={Lin, Ji-Yung and Yang, Yu-Hua and Kükner, Halil and Yang, Sheng and Verschueren, Lynn and Bömmels, Jürgen and Dell'Atti, Francesco and Zografos, Odysseas and Farokhnejad, Anita and Hellings, Geert},
  title={Scaling High Density Designs Towards Angstrom Nodes: BEOL Routability, Pin Accessibility Challenges and Impact of Gear Ratio},
  abstract={A comprehensive study on the design scaling in angstrom nodes is performed on a high-density processor core. The scaling trends foresee the degradation of BEOL routability and pin accessibility over technology nodes. In results, designs in A7 node reach −6% utilization compared to N 2 node, enlarging area by 8% from the expected level. Nevertheless, increasing M1 density with higher gear ratio (GR) is proposed to recover routability. GR $2: 1$ is shown to significantly increase utilization in A7 designs, reducing $14 {\%} / 8 {\%}$ area vs. GR 1:1/3:2 while keeping performance & power impacts within 2%. Thus, GR 2:1 is required to achieve expected area scaling for high-density designs in angstrom nodes.},
  keywords={Design methodology;PIN photodiodes;Pins;Printing;Technology;Displays;Indexes;Indexing;Cells (biology);Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577339},
}

@INPROCEEDINGS{11577521,
  author={Cho, Chen-Yi and Shih, Yu-Ling and Lao, Ming-Yeh and Chen, Yu-An and Lin, Yu-De and Yeh, Po-Chun and Sheu, Shyh-Shyuan and Hou, Tuo-Hung},
  title={Origin and Modeling of the Access-Rate-Dependent Degradation and Dual-Interface Optimization in Ultra-Thin Nanolaminate HZO},
  abstract={Access-rate (AR)-dependent degradation under a noncontinuous cycling (NCC) with hold times between operations is a new showstopper for the practical use of $\text{Hf}_{1-\mathrm{x}} \text{Zr}_{\mathrm{x}} \mathrm{O}_{2}$ (HZO)-based FeRAM. We provide new insights into this critical reliability issue from the following perspectives: (1) reveal strong thickness- and hold-polarity-dependent AR degradation originating from interface property and asymmetry down to the ultrathin thickness of 4 nm, (2) develop a comprehensive physics-based AR degradation model that bridges continuous cycling (CC)-to-NCC behavior based on the interplay between charge trapping and depolarization-field (Edep) -driven redistribution, and (3) demonstrate an optimized symmetric ZHZ tri-layer nanolaminate based on new physics understanding and largely mitigate AR-dependent degradation.},
  keywords={Degradation;Modeling;Argon;Displays;Indexes;Indexing;Printing;Technology;Timing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577521},
}

@INPROCEEDINGS{11577559,
  author={Park, Jongyoun and Jeong, Heejae and Won, Jiwoo and Lee, Junhyeok and Ahn, Chunghyun and Lee, Sangsu and Cho, YoungWoo and Park, Geuntae and Yu, Sangho and Kwon, Hyuk-Jun and Yu, Hyun-Yong},
  title={A High-Performance Heterogeneous 2T0C DRAM with PSLC-Si/IGZO Complementary Gain Cell for Monolithic 3D Leveraging Capacitive Coupling},
  abstract={This study experimentally demonstrates a highperformance monolithic 3D (M3D) integrated 2-transistor-0-capacitor (2T0C) DRAM cell utilizing a complementary gain cell (CGC) with n-IGZO and p-channel patterned seedless laser crystallization (PSLC)-Si. Using PSLC, we achieved a worldrecord grain size of $32.3 \mu \mathrm{m}$ and a hole mobility of $265 \text{cm}^{2} / \text{Vs}$ for the read-transistor (R-Tr). The CGC architecture leverages capacitive coupling (C.C.) to boost the sensing margin (SM) to $\sim 10^{6}$, satisfying the 1k-array criterion $(\text{SM}>10^{4})$ and outperforming conventional 2-nIGZO 2T0C. Simulation confirms an estimated read time of 11.8 ns. These findings establish the M3D CGC 2T0C DRAM as a candidate for highdensity, and high-performance 3D memory solutions that overcome the limitations of conventional architecture.},
  keywords={Cells (biology);Silicon;Arrays;Crystallization;DRAM chips;Printing;Very large scale integration;Indexes;Indexing;Lasers;Monolithic 3D;PSLC;2T0C DRAM;Complementary Gain Cell;Sensing Margin (SM);Mobility},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577559},
}

@INPROCEEDINGS{11577543,
  author={Levy, Cooper S. and Sharma, Jahnavi and Xuan, Zhe and Huang, Duanni and Gao, Junyi and Liu, Songtao and Wu, Xinru and Wang, Xiaoxi and Mondal, Susnata and Krishnamurthy, Sashank and Lake, Dan and Jaussi, James E.},
  title={An 800 Gbps/Fiber Silicon Photonic Microring-Based DWDM Transceiver in an Open-Cavity Package},
  abstract={Silicon photonic (SiPh) micro-ring resonator (MRR) based optical interconnects integrated with XPU/switch packages can enable very high data rates per-fiber through dense wavelength division multiplexing (DWDM). We demonstrate an O-band DWDM link with simultaneous $16-\lambda$ transmission at $50 \text{Gbps} / \lambda$, for an aggregate data-rate of 800 Gbps/fiber, with BER<1e-9. An Intel 22 nm CMOS electronic integrated circuit (EIC) is 3D assembled with an Intel Fab11X photonic IC (PIC) and placed in an open-cavity substrate. The PIC integrates a $16-\lambda$ laser, $\lambda$-interleavers, MRRs for modulation and $\lambda$-demultiplexing, and optical amplification for link margin. The 22nm EIC features several high-speed techniques to push per-$\lambda$ data rate.},
  keywords={Joining processes;Printing;Displays;Indexes;Indexing;Packaging;Textile fibers;Very large scale integration;SiPh transceiver;MRR;Co-packaged optics},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577543},
}

@INPROCEEDINGS{11577216,
  author={Cao, Wei and Inoue, Takayuki and Zhang, Peng and Guo, Jiacen and Yang, Xiang and Dutta, Deepanshu},
  title={Toward Thousands-Layer 3D Nand: Unleashing the Block Size Constraint by Enabling Lateral Sub-Block Mode},
  abstract={Stacking more wordline layers has been the main scaling approach for 3D NAND to achieve higher bit density. However, this approach leads to growing block size, which is becoming a major challenge to maintain the bit density increase rate in the beyond-1000-layer arena. To surmount this obstacle, a novel lateral sub-block mode is demonstrated in this work based on the advanced 3D NAND platform, which allows the large-block size induced bit density loss to be recovered by as much as $80 {\%}-90 {\%}$. This demonstration provides a costefficient pathway for future 3D NAND scaling.},
  keywords={Programming;Windows;Electrons;Personal digital devices;Technology;3D NAND;bit density;sub-block mode;program disturb;pre-charge},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577216},
}

@INPROCEEDINGS{11577496,
  author={Xu, Li and Song, Sanquan and Nedovic, Nikola and Kalogerakis, Georgios and Mehta, Nandish and Rekhi, Angad and Zimmer, Brian and Tell, Stephen G. and Nishi, Yoshinori and Chen, Xi and Lopes, Ward and Lee, Benjamin G. and Greer, Thomas H. and Poulton, John W. and Gray, C. Thomas},
  title={A 0.416-pJ/b, 32-Gb/s 3D-Stacked Optical NRZ Receiver with −18.5-dBm OMA Sensitivity Using Self-Timed Decision Feedback Equalization},
  abstract={This work presents a $32 \text{Gb} / \mathrm{s}$ optical non-return-to-zero (NRZ) receiver with 3D-stacked 7 nm CMOS and 65 nm photonic dies. It uses a low-bandwidth front-end followed by self-timed decision feedback equalization (STDFE). OMA sensitivity for $\text{BER}<10^{-12}$ and PRBS31 is −18.5 dBm. The receiver consumes $0.416 \text{pJ} / \mathrm{b}$ at $32 \text{Gb} / \mathrm{s}$ and occupies $3360 \mu \mathrm{m}^{2}$.},
  keywords={Rails;Clocks;Displays;Indexes;Indexing;Sensitivity;Printing;Design methodology;Joining processes;Bit error rate},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577496},
}

@INPROCEEDINGS{11577227,
  author={Park, Seunghan and Park, Yohwan and Kim, Tae Hyung and Lee, Jinkyu and Kang, Hongjeon and Seo, Youngjae and Kim, Hyungjin and Ha, Sunghyuk and Kim, Dongjun and Choi, Jeongmin and Jung, Jongki and Ro, Jongjin and Park, Youngmin and Lee, Jongho and Choi, Kyuwon and Hong, Dukho and Kim, Jongmoo and Cho, Hyojong and Jeong, MinYong and Ivaniukovich, Aliaksei and Kim, Taejung and Jeong, Jaehun and Lee, Ho and Kim, Hyun-Jo and Yasuda-Masuoka, Yuri and Ku, Ja-Hum},
  title={Ultra Low-Power SRAM Technology on High Performance FinFET Platform for HPC, Mobile, and High-Reliability Applications},
  abstract={Extreme Low-Power FinFET SRAM technology has been developed on the top of the latest advanced high performance 4nm FinFET Technology. The technology offers the worldbest low-leakage SRAM, achieving a $0.52 \times$ bit-cell leakage current compared to the previous FinFET node. Additionally, SRAM $\mathrm{V}_{\min}$ is successfully reduced by 70mV. To attain these advancements, total SRAM transistor design from Fin/SD to Gate stack is performed. As a result, in compiler level, significant leakage reduction, such as 0.35x in standby and 0.31x in retention mode, are achieved, as well as Performance $+50 {\%}$ and Power $-35 {\%}$.},
  keywords={Displays;Indexes;Indexing;SRAM chips;Optimization;Technology;Stacking},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577227},
}

@INPROCEEDINGS{11577632,
  author={Chen, Bin and Fang, Yike and Zhu, Tao and Fang, Yi and Zheng, Yuhang and Pi, Longcheng and Hong, Jingni and Gao, Tianlu and Qiu, Zheng and Wang, Lian and He, Lenian and Yu, Xiaopeng and Ke, Xugang},
  title={A 6.8W 91.3%-Peak-Efficiency Coupled Micro-Inductor-Based Bidirectional Isolated Converter with Tri-State Magnetic Charging for Battery Active Cell Equalization},
  abstract={A coupled micro-inductor (CMI)-based bidirectional isolated converter for battery cell equalization is proposed. With tri-state magnetic charging, the converter operates in BCM, DCM and LRBM modes in a varying load current, with a fsw from 4.2 kHz to 1.25 MHz. With active cell equalization, it supports $\text{CC} / \text{CV}$ balance control with a maximum 1.6 A load current, achieving 99.2% SOC accuracy and 10 mV droop voltage. At $12 \mathrm{V} \mathrm{V}_{\text{IN}}$, peak efficiency is 91.3% in charge state and 90.7% in discharge state respectively.},
  keywords={Cells (biology);Converters;Current;Switches;Loading;Voltage;Batteries;Timing;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577632},
}

@INPROCEEDINGS{11577414,
  author={Jeon, Young-Jun and Lee, Chan-Ho and Jang, Jong-Woo and Hong, Sung-Wan},
  title={A 12 V-to-1V Scalable 2N-Phase Buck Converter Using 0V-Stress Balancer with Shortest $I_{\mathrm{L}}$ Balancing Path for Parallel IC Expansion in xPU Systems},
  abstract={This paper presents a scalable 2 N -phase buck converter using a 0V-stress balancer with the shortest inductor current balancing path for parallel IC expansion in xPU systems. The proposed converter supports arbitrary phase expansion with all-phase interleaving. A prototype was tested using 1, 2, 3, and 4 chips (2,4,6, and 8 phases), and achieves peak efficiencies of 89.2% at 1.0 V and 90.4% at 1.2 V in 2-chip (4-phase) prototype.},
  keywords={Timing;Inductors;Printing;Buck converters;Video recording;Human factors;Measurement units;Stress;Switches},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577414},
}

@INPROCEEDINGS{11577424,
  author={Cheng, Chao-Ching and Chou, Ang-Sheng and Chen, Edward and Li, Ming-Yang and Hsu, Yu-Wei and Cheng, Chia-Chin and Cho, Seong Rae and Liu, Haomin and Mao, Po-Sen and Wu, Wen-Chia and Ku, Shuer and Yun, Wei-Sheng and Chuu, Chih-Piao and Woon, Wei-Yen and Li, Lain-Jong and Tung, Vincent and Wu, Chih-I and Radu, Iuliana and Cao, Min},
  title={Scaling $V_{DD}$ for P-Type 2D-Material Channel Transistor: what Non-Idealities are Still to be Solved},
  abstract={This study investigates the effect of non-ideal factors in WSe2 2Dmaterial channel transistors, including interface traps $(D_{i t})$, contact resistance $(R_{C})$, and band-tail states $(S_{B T})$, on the threshold voltage $(V_{T})$. For achieving the scaled $V_{D D}=0.75 \mathrm{V}$ operation, reduction of multiple non-idealities is required beyond current state: (i) reducing $D_{i t}$ below 1E12 $\text{cm}^{-2} \text{eV}^{-1}$ preserves the position of $V_{T C C}=-0.1 \mathrm{V}$ (constant-current $V_{T}$); (ii) suppressing the $S_{B T}$ through gate dielectric engineering, with scaled EOT below 1 nm, is required for setting correct $V_{T C C}$ and $V_{T G M}$ (transconductance-defined $V_{T}$) positions; (iii) minimizing $R_{C}$ to $100 \Omega-\mu \mathrm{m}$ ensures the $(V_{T G M}-V_{T C C})$ gap below 0.28 V. The study combines these findings and offers insights to design the desired $V_{T}$ positions at scaled $V_{D D}$ for 2D materials.},
  keywords={Current;Displays;Indexes;Indexing;Technology;Printing;Transistors;Contacts;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577424},
}

@INPROCEEDINGS{11577225,
  author={Son, S.-W. and Park, W.-S. and Lee, I.-G. and Choi, S.-M. and Son, S.-P. and Kim, S.-H. and Byeon, J. and Song, M.-K. and Ahn, H.-K. and Shin, D.-H. and Noh, Y.-K. and Kim, S.-K. and Yun, J. and Kim, T. and Kim, T.-W. and Lee, J.-H. and Yang, K. and Kim, D.-H.},
  title={First Demonstration of ${f}_{\max}>{700} \text{GHz}$ in ${L}_{{g}}={45} \text{nm In}_{0.13} {Al}_{0.83} {Ga}_{0.04} {N} / {GaN}$ Hemts for Future 6G Applications},
  abstract={We report InAlGaN/GaN HEMTs with $L_{g}=45 \text{nm}$ that achieve record high-frequency characteristics. This outstanding performance is enabled by the successful integration of selective S/D regrowth and a high-aspect-ratio T-gate process using mix-and-match wafer-level integration. To gain insight into carrier transport and identify the key factors governing such performance, we employed methodologies based on $L_{g}$–scaling driven $g_{m}$ modeling and delay time analysis. The $L_{g}=45 \text{nm}$ device exhibits a combination of $R_{O N}=0.33 \Omega \cdot \text{mm}, g_{m_{-} \max }=1.03 \mathrm{S} / \text{mm}, f_{\max}= 742 \text{GHz}$ and $f_{\text{avg }}=497 \text{GHz}$. To the best of our knowledge, this work represents the first demonstration of $f_{\max}>700 \text{GHz}$ and the highest reported $f_{\text{avg}}$ for any GaN HEMT technology.},
  keywords={Generative adversarial networks;Modeling;Displays;Indexes;Indexing;Technology;HEMTs;Printing;High frequency;Delays},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577225},
}

@INPROCEEDINGS{11577516,
  author={Huang, Yu-Ting and Wu, Xiao-Quan and Chen, Chi-Yu and Chiu, Po-Jui and Cho, Chien-Wei and Chen, Ke-Horng and Peng, Seng-Yu and Tsai, Tsung-Heng and Lin, Ying-His and Lin, Shian-Ru and Tsai, Tsung-Yen},
  title={A Hybrid LDO with Region-Detection and Power-Supply-Rejection-Based Control Achieving High PSR and Fast Transient Response},
  abstract={The proposed hybrid LDO integrates region detection (RD) and gate-edge detection (GED) techniques to optimize the ALDO-DLDO current ratio to break the PSR trade-off. At 10 kHz, the proposed HLDO achieves −49 dB and −40 dB PSR when VDO is 200 mV and 50 mV, respectively, maintaining high PSR up to 10 MHz range. For transient response, GED enables fast settling time; under a 1 mA-200 mA load step, the undershoot is 90 mV with an 8.7 ns settling time, and the overshoot is 92 mV with a 10.2 ns settling time.},
  keywords={Displays;Indexes;Indexing;Timing;Transient analysis;Windows;Signal detection;Current;Loading},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577516},
}

@INPROCEEDINGS{11577402,
  author={Zhang, Chen and Radens, Carl and Bajpai, Utkarsh and Reboh, Shay and Khan, Shahrukh and Deming, Matt and Jain, Nikhil and Lanzillo, Nick and Seshadri, Indira and Sarkar, Debarghya and Mignot, Yann and Shanker, Nirmaan and Sieg, Stuart and Younus, Imran and Akter, Shirin and Liu, Feng and Rana, Uzma and Fan, Susan and Ramachandran, Ravi and Yamashita, Tenko and Guo, Dechao and Bu, Huiming},
  title={Area and Performance of Staggered-Channel Nanostack SRAM Bitcells},
  abstract={A staggered-channel SRAM bitcell design in the Nanostack sequential stacking architecture is presented. We show the role of top-bottom gate merge contact, a unique requirement in sequential stacking, in determining cell height and how the staggered design where top and bottom channels are not aligned helps scaling. We also show for the $1^{\text{st}}$ time in the world the gate merge structure developed on silicon. $>40 {\%}$ cell height reduction versus the state-of-the-art non-stacked cells can be achieved within the current patterning capability. Finally, simulation shows Nanostack bitcell has an improved wordline (WL) performance and comparable bitline (BL) performance compared to non-stacked bitcells.},
  keywords={Cells (biology);Stacking;Displays;Indexes;Indexing;Merging;Contacts;SRAM chips;Technology;Capacitance},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577402},
}

@INPROCEEDINGS{11577592,
  author={Zhang, Kun and Zhou, Hong and Lyu, Qifeng and Zhang, Naiqian and Zhang, Chenrui and Liu, Jianfei and Yao, Yixu and Wang, Chenlu and Zhou, Min and Liu, Zhihong and Huang, Sen and Pei, Yi and Hao, Yue and Zhang, Jincheng},
  title={AlN Buffered K/Ku Bands GaN RF Power HEMTs with in-Situ SiN Silicidation Enabled Low $R_{C}=0.03 \Omega \cdot \text{mm}$ at 500 K and Record High $P_{\text{out}}=25 \mathrm{W}/\text{mm}$},
  abstract={Ku(12-18 GHz)/K(18-26.5 GHz) bands are typically used for radar, satellite communication and navigation et al., which are however limited by maximum output power density (Pout) of RF devices, mainly constrained by low breakdown voltage (BV) and increased high temperature (T) contact resistance (RC). This work reports a record $\mathrm{P}_{\text{out}}=25/24 \mathrm{W}/\text{mm}$ at 18/20 GHz, which is twice of previous highest Pout value of 12 W/mm for Ku/K bands. This breakthrough is realized by combining a thick AIN buffer with enhanced carrier confinement and source field-plate (S-FP) structure for increased BV, and an in-situ SiN layer-assisted Ohmic silicidation enabled low RC of 0.03 $\Omega \cdot \text{mm}$ at $\mathrm{T}=500 \mathrm{K}$. Those results indicate a significant progress for Ku/K bands GaN RF power devices to achieve high-power and high-efficiency RF applications.},
  keywords={Generative adversarial networks;Displays;Printing;Indexes;Indexing;Radio frequency;HEMTs;Recording;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577592},
}

@INPROCEEDINGS{11577534,
  author={Jang, Wonsuk and Kubicka, Christian and Pan, Allen and Smriti, Pullabhatla and Khwa, Win-San and Chang, Meng-Fan and Raina, Priyanka and Tambe, Thierry},
  title={µAgent: A 7nm 404.3mJ/Action Edge SoC for Agentic AI Reasoning with Adaptive Block-Wise Mixed-Format 4-Bit Quantization and Decoupled Access-Execute},
  abstract={$\mu$ Agent is a $4 \text{mm}^{2} 7 \text{nm}$ SoC for on-device agentic AI reasoning with an edge-targeted large language model (LLM), using only 64 MB of off-chip HyperRAM. Its LLM accelerator, $\mu$ Thinker, reduces external memory access via block-wise mixed-format 4-bit quantization with adaptive block/element size. $\mu$ Thinker efficiently couples to the CPU via a coprocessor interface and decoupled access-execute streams, minimizing communication stalls. $\mu$ Agent operates up to 1.22 GHz and achieves $404.3 \text{mJ} /$ Action while outperforming standard quantization formats (INT4/FP4) on navigation tasks.},
  keywords={Quantization (signal);Modeling;Memory;Indexes;Indexing;Large language models;Printing;Displays;Media Access Control;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577534},
}

@INPROCEEDINGS{11577598,
  author={Nooshabadi, Samir and Sarkar, Debjit and Baum, David and Ives, Craig and Hajimiri, Ali},
  title={A Monolithic Optical IQ Coherent Receiver in Unmodified Bulk CMOS},
  abstract={A monolithic optical coherent receiver with quadrature detection is presented for the first time in an unmodified bulk CMOS chip. Networks of optical phase shifters and splitters distribute modulated light across the chip using subtractive photonic waveguides operating at 780 nm, and integrated avalanche photodiodes and transimpedance amplifiers enable balanced detection and amplification in the electronic domain. All components are monolithically integrated in an unmodified 180 nm bulk CMOS process with simple post-processing steps, paving the way for low-cost optoelectronic imaging and sensing systems utilizing coherent detection.},
  keywords={Receivers;Phase shifters;Printing;Photonics;Technology;coherent receiver;monolithic integration;sensing;integrated photonics;bulk CMOS},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577598},
}

@INPROCEEDINGS{11577344,
  author={Polat, Ilker and Overwater, Ramon W.J. and Prabowo, Bagas and Reale, Stefano and Esposti, Davide Degli and Capannelli, Kenji and Rimbach-Russ, Maximilian and Vandersypen, Lieven M.K. and Babaie, Masoud and Sebastiano, Fabio},
  title={Cryo-CMOS Sub-1K 16nm FinFET DAC for Fast Two-Qubit Gates in Spin Qubits},
  abstract={This paper presents a cryo-CMOS DAC for driving two-qubit gates in semiconductor spin qubits. Thanks to a current-integrating coarse/fine architecture implemented in a 16-nm FinFET process, the proposed design generates adiabatic waveforms for very fast (<50 ns) high-fidelity operations, while operating at sub- 1 K temperatures with a small footprint (0.026 mm2) and low power ($275 \mu \mathrm{W}$), thus demonstrating its compatibility with qubit co-integration.},
  keywords={Qubit;Printing;Displays;Indexes;Indexing;Current;Technology;Very large scale integration;cryo-CMOS;spin qubits;quantum computing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577344},
}

@INPROCEEDINGS{11577571,
  author={Morita, Y. and Kawanago, T. and Kamioka, T. and Mitani, Y. and Nabatame, T. and Onaya, T. and Fukata, N. and Jevasuwan, W. and Tsukagoshi, K. and Hoshii, T. and Toprasertpong, K. and Tamura, A. and Kita, K. and Okada, N. and Manabe, K. and Mizubayashi, W. and Ota, H. and Matsukawa, T. and Migita, S.},
  title={Ultra-Scaled High-K Gate Stacks (Cet 0.9 Nm) Enabled by a Low-Thermal-Budget $\left(500^{\circ} \mathrm{C}\right)$ Oxygen-Passivated Interfacial Layer (O-PAS IL)},
  abstract={We propose an oxygen-passivated interfacial layer (O-PAS $I L)$ technology as a novel scheme for forming thin oxides in environments where oxidation and etching coexist, and demonstrate an ultra-thin IL even in low thermal budget (500° C) processes. To introduce an IL of $<0.3 ~\text{nm}$, which is thinner than the native Si oxide films, we optimized the entire process of ultra-thin IL formation and subsequent gate stack formation to avoid unexpected IL increases. Using this novel scheme, a capacitance equivalent thickness of approximately 0.9 nm with highly reliable high-k gate stacks is achieved.},
  keywords={Stacking;High-k dielectric materials;Displays;Indexes;Indexing;Technology;Temperature;Printing;Silicon;Chemicals;oxygen-passivated interfacial layer;silicon oxide;high-k gate stack;low thermal budget},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577571},
}

@INPROCEEDINGS{11577635,
  author={Xu, Yaqian and Chen, Xinyu and Hou, Yuhan and Xu, Jianxiong and You, Hao and Huang, Yu and Liu, Bowen and Hung, Ashley and Richardson, Andrew G. and Genov, Roman and Liu, Xilin},
  title={An in-Ear Sleep Modulation SoC Featuring a CNN–LSTM Accelerator with Long-Kernel Memory Reuse and Runtime Dynamic Quantization},
  abstract={This work presents a 65 nm SoC for closed-loop in-ear sleep modulation. The SoC performs low-noise in-ear EEG sensing, CNN–LSTM-based sleep stage classification, and phase-specific auditory stimulation under 1 mW. A dedicated accelerator is developed, featuring a memory reuse technique to efficiently process long kernels required for low-frequency EEG feature extraction. A runtime dynamic quantization is incorporated, reducing model size by $3.88 \times$ with only a 0.28% loss in accuracy. A sensitivity of 98.3% is achieved for deep sleep detection, enabling effective sleep modulation.},
  keywords={Modeling;Sleep;Quantization (signal);Ear;Electroencephalography;Displays;Indexes;Indexing;System-on-chip;Convolutional neural networks},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577635},
}

@INPROCEEDINGS{11577405,
  author={Lee, Junseok and Hwang, Chanwoong and Seo, Jeongbeom and Choi, Jaehyouk},
  title={A Versatile On-Chip Jitter Measurement Circuit with Dynamic Quantizer-Resolution Adaptation for Arbitrary Clocks Across 1–8GHz and 20–130pspp Jitter},
  abstract={This work presents a versatile on-chip jitter measurement (OCJM) circuit. By employing a dynamic quantizer-resolution adaptation (DQRA) technique that optimizes the quantizer resolution according to the jitter magnitude, the proposed OCJM accurately constructs jitter histograms for arbitrary clocks with wide frequency and jitter variations. Implemented in 28nm CMOS, the prototype uses only 15 quantizers to measure clock jitter across frequencies from 1 to 8 GHz and magnitudes from 20 to $130 \text{ps}_{\text{pp}}$.},
  keywords={Jitter;Measurement;Clocks;Printing;Root mean square;Frequency;Timing;Technology;Very large scale integration;Circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577405},
}

@INPROCEEDINGS{11577353,
  author={Su, Yuan-Chun and Wei, Ting-Hua and Lei, Chenxi and Shi, Sunhao and Hsu, Yu-Wei and Su, Tzu-Chuan and Lee, Sin-Yue and Lin, Hong-De and Chen, Shao-Heng and Chiang, Hung-Li and Lin, Chao-Cheng and Liu, Bo-Heng and Su, Chien-Ying and Ke, Chi-Chung and Chang, Shu-Jui and Wu, Chih-I and Hu, Chenming and Fu, Jui-Han and Tung, Vincent and Lee, Tsung-En},
  title={Enhancement-Mode Monolayer $\text{WSe}_{2} \text{pFETs}$ with Record $\mathrm{I}_{\text{on}}/\mathrm{I}_{\text{off}}$ at Contact Length of 30 nm},
  abstract={We demonstrate enhancement-mode monolayer (1L) WSe 2 pFETs, under aggressive contact-gate pitch (CGP) scaling while maintaining competitive Ion and record high Ion/Ioff ratio of $>10^{8}$. The device performance is improved by transport in single-domain CVD-grown 1 L-WSe 2, controllable UV-ozone $(\mathrm{O}_{3})$ p-doping, and selective contact doping by TeO. At $\mathrm{I}_{\text{off }}=0.3 \text{pA} / \mu \mathrm{m}$ defined at $\mathrm{V}_{\mathrm{G}}=0 \mathrm{V}$, the 1 L-WSe 2 pFET under channel length $\left(\mathrm{L}_{\text{ch}}\right)$ of 50 nm exhibits a record $\mathrm{I}_{\mathrm{D}, \text{Max}}$ of $0.9 \text{mA} / \mu \mathrm{m}$ at $\mathrm{V}_{\mathrm{D}}=-1 \mathrm{V}$, a highest peak transconductance $(\mathrm{G}_{\mathrm{m}})$ of $\sim 570 \mu \mathrm{S} / \mu \mathrm{m}$, a lowest DIBL of $\sim 50 \text{mV} / \mathrm{V}$ and a contact resistance $\left(\mathrm{R}_{\mathrm{C}}\right)$ of $\sim 407 \Omega \cdot \mu \mathrm{m}$. With further aggressive contact length (Lc) scaling, enhancement-mode operation is preserved with an Ion/Ioff $\sim 1.8 \times 10^{8}$ and a transfer length $(\mathrm{L}_{\mathrm{T}})$ below 100 nm. These results validate the scalability of 2D p-channel devices pursuing optimal performance, power, area (PPA) for future CMOS logic technologies.},
  keywords={Printing;Contacts;Displays;Indexes;Indexing;Doping;Technology;Ions;Personal digital devices;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577353},
}

@INPROCEEDINGS{11577630,
  author={Chou, Hung-Chun and Kuk, Song-Hyeon and Zhang, Chengyang and Kwak, Jungyoun and Quezada, Emmanuel and Sarkar, Eknath and Datta, Suman and Yu, Shimeng},
  title={Backside-Compatible Oxide Vertical Channel-All-Around Transistors and Cylindrical Capacitors for On-Chip Voltage Conversion at High Power Density},
  abstract={This work presents monolithic integration of indium-gallium-oxide (IGO) vertical channel-all-around transistors (VCAAT) and vertical cylindrical flying capacitors (VCCaps) for high-efficiency point-of-load (PoL) active backside power delivery network (BSPDN) design at 3 V rating, achieving a low specific on-resistance $(\mathrm{R}_{\text{on.sp}})$ of 7.57 $\mu \Omega \cdot \text{mm}^{2}$ and a high capacitance density of $162 \text{fF} / \mu \mathrm{m}^{2}$. With calibrated device models from experiments, circuit-level simulation shows 80.2% efficiency at high power density (1 $\mathrm{W} / \text{mm}^{2}$) with a proposed 4:1 ladder-based DC-DC converter for 3 V to 0.75 V step-down conversion, improving the power density by 4 times compared to recent works for the active BSPDN at the comparable voltage ratings and efficiency.},
  keywords={Printing;Technology;Capacitors;Transistors;Switching loss;Very large scale integration;Capacitance;Converters;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577630},
}

@INPROCEEDINGS{11577291,
  author={Zhou, Yuejia and Yang, Yuancheng and Chen, Liang and Yu, Mingxiang and Luo, Wenpu and Ning, Zhiyuan and Huang, Weiqin and Xu, Xiaojian and Guo, Jing and Zhu, Runteng and Shao, Hanyong and Xia, Zhiliang and Huo, Zongliang and Tang, Kechao and Huang, Ru},
  title={3D Vertical Fefet Array with Record Endurance (¾1012), Fast Writing (± 2 V, 20 ns), Disturb Immunity, and Kb-Scale Verification for High Density 1T Ram},
  abstract={We report a comprehensively optimized 3D vertical ANDtype ferroelectric FET (FeFET) memory, with highlights below: 1) Record-level key metrics of the 3D cells, including endurance $>10^{12}$, fast write at $\pm 2 ~\mathrm{V} / 20 ~\text{ns}$, immediate read-after-write, and $0.001 \mu ~\mathrm{m}^{2}$ channel area; 2) First demonstration of 3D array reliability, showing disturb immunity with aggressively scaled $40-\text{nm}$ vertical pitch, and error-free $\text{Kb}{-}$ scale readout; 3) Systematic process modulation with in-depth nano-analysis, revealing co-optimization mechanisms related to FE grain and channel oxygen engineering. The proposed 3D FeFETs enable high density 1T RAM, offering a low-cost and high-speed solution for the expanding hot data in AI era.},
  keywords={Arrays;Writing;FeFETs;Displays;Indexes;Indexing;Iron;Optimization;Technology;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577291},
}

@INPROCEEDINGS{11577472,
  author={Kitada, Hideki and Satake, Yoshiaki and Doi, Wataru and Araki, Naoko and Ryoson, Hiroyuki and Chujo, Norio and Funaki, Tatsuya and Yagi, Azusa and Takasaki, Toshiyuki and Yoda, Takashi and Fukuda, Tadashi and Ohba, Takayuki},
  title={High-Density Chiplet Integration using Face-Down COW Processes with Bumpless Interconnects for Heterogeneous 3D Systems},
  abstract={A face-down chip-on-wafer (COW) process for highdensity chiplet integration using via-last bumpless interconnections has been developed. A proprietary “waffle wafer” suppresses warpage and enables a thin CoW structure with low thermal resistance. It was demonstrated that a facedown chip bonding scheme employing a thin SiOC adhesive layer achieves high chip-to-wafer alignment accuracy, enabling the minimum chip-to-chip spacing to be reduced to $10 \mu ~\mathrm{m}$. This reduced chip spacing, together with high-density bumpless interconnections, achieves a fourfold increase in shoreline density. After back grinding and CMP, the total CoW thickness is reduced to less than $50 \mu ~\mathrm{m}$. FEM analysis shows a 30 % reduction in wafer warpage, and thermal analysis shows a 52 % reduction in thermal resistance.},
  keywords={Adhesives;Cows;Bonding;Silicon;Resins;Displays;Indexes;Indexing;Stacking;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577472},
}

@INPROCEEDINGS{11577204,
  author={Fujiwara, Hidehiro and Crafton, Brian and Mori, Haruki and Hung, Je-Min and Zhao, Wei-Chang and LeLe, Ashwin Sanjay and Zhang, Bo and Chuang, Chao-Kai and Ishii, Hiroaki and Lee, Cheng-En and Joshi, Vineet and Peng, Xiaochen and Sun, Xiaoyu and Hsu, Shu-Huan and Liu, Yao-Yi and Hashizume, Takeshi and Hsu, Yu-Hao and Khwa, Win-San and Adham, Saman and Chih, Yu-Der and Chen, Yen-Huei and Liao, Hung-Jen and Akarvardar, Kerem and Chang, Meng-Fan and Chang, Tsung-Yung Jonathan},
  title={A 2nm 234.4 TOPS/W and 511.9 $\text{TOPS}/\text{mm}^{2}$ Digital Computing-in-Memory Compiler with Multiple MAC Units per Weight and Multiple Data Format Support},
  abstract={This paper presents a Compute-in-memory (CIM) compiler featuring multiple data format and multiple MAC units per weight, supporting flexible data format, better utilization and throughput. We implemented various configurations in a test chip with our 2 nm nanosheet technology node and test chip measurement results show $\mathrm{V}_{\text{MIN}}<0.38 \mathrm{V}, 234.4$ TOPS/W at 0.5 V and $511.9 \text{TOPS} / \text{mm}^{2}$ at 1.2 V.},
  keywords={Media Access Control;Program processors;Displays;Indexes;Indexing;Measurement units;In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577204},
}

@INPROCEEDINGS{11577463,
  author={Ambrosi, E. and Ricci, S. and Kuo, C.C. and Song, M.Y. and Wu, C.H. and Lin, C.H. and Lu, W.H. and Hu, C.Y. and He, C.X. and Huang, X.H. and Vaziri, S. and Hsu, C.F. and Lee, H.Y. and Chen, Y.J. and Lin, C.C. and Lo, C.Y. and Lee, H.H. and Chen, G.L. and Hsin, Y.C. and Woon, W.Y. and Wei, J.H. and Li, K.S. and Hou, T.H. and Lin, K.L. and Liu, C.N. and Bao, X.Y.},
  title={Scalable and Stackable 2S1M SOT-MRAM Memory Cell Enabled by Two-Terminal Write and Read SNGCT Chalcogenide Selectors},
  abstract={SOT-MRAM cell size reduction is a key challenge in its conventional 2T1M configuration. An attractive approach is the replacement of 3-terminal Si transistors with 2-terminal BEOL selectors. In this work, we report a 2S1M SOT-MRAM device with write and read threshold selectors based on the SNGCT amorphous chalcogenide. The device prototype structure and write/read operations are demonstrated for the first time. SNGCT selector can supply sufficient current for SOT-MRAM write. Endurance of 1e9 write cycles test-limited is demonstrated, with low error rate. Non-destructive read with stable read current and wide $30 \mu \mathrm{A}$ sense window is obtained.},
  keywords={Writing;Displays;Indexes;Indexing;Current;Memory;Cells (biology);Technology;Transistors;Testing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577463},
}

@INPROCEEDINGS{11577341,
  author={de Oliveira, A. C. and Groenesteijn, J. and Tang, Z. and Jiang, H. and Lötters, J. and Wiegerink, R. and Makinwa, K.},
  title={A MEMS-Based Throughflow Multimodal Sensor Interface IC for Real-Time Fluid Parameter Monitoring},
  abstract={This paper describes a MEMS-based throughflow multimodal sensing system that integrates a Coriolis flow sensor with pressure and temperature sensors to enable simultaneous measurement of mass flow, fluid density, input/output pressure, temperature, and viscosity. Implemented using a single MEMS chip and a CMOS readout ASIC, it achieves state-of-the-art performance with the highest reported resolution and zero stability among MEMS Coriolis flow sensors. Compared to stainless-steel Coriolis sensors, it exhibits $>22 \times$ lower temperature drift, while maintaining relative errors $< \pm 5 {\%}$ for most liquids and gases.},
  keywords={Fluid flow;Microelectromechanical systems;Temperature;Gases;Image sensors;Printing;Multiplexing;Noise;Viscosity;Fluids},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577341},
}

@INPROCEEDINGS{11577306,
  author={Wu, Shaonan and Ma, Ziheng and Yang, Bohan and Wang, Yuanxiao and Yang, Zhiqi and Chen, Weinan and Wang, Hanning and Zhu, Min and Zhang, Aoyang and Liu, Leibo},
  title={A 5GS/s Staggered Working Point Ensemble TRNG with a Stochastic Model Achieving 4064.5 Mbps Entropy-Throughput and 997.6 fJ/Entropy-Bit},
  abstract={This paper presents the first metastability-based true random number generator achieving Gb/s throughput, supported by a provable stochastic entropy model. The proposed staggered working point ensemble architecture employs four entropy source cores with deliberate offset staggering to ensure PVT-resilient operation without real-time tracking. A stochastic model characterizes the entropy generation dynamics, establishing a conservative min-entropy lower bound compliant with international standards such as NIST SP 800-90B and AIS-31. Fabricated in 28 nm CMOS, the proposed design achieves entropy throughput of 4064.5 Mbps at $997.6 \text{fJ} /$ entropy-bit (1.3 V) and 1462 Mbps at $324.1 \text{fJ} /$ entropy-bit $(0.9 \mathrm{V})$. Validation across 40 test chips confirms full compliance with NIST SP 800-90B and AIS-31 suites. The design maintains a min-entropy exceeding 0.77 after 168 hours aging, demonstrates resilience to 60 mVpp power-injection attacks, and achieves 10.08 mV metastable point drift tolerance, confirming robust high-entropy operation against PVT variations.},
  keywords={Entropy;Modeling;Printing;Displays;Indexes;Indexing;NIST;Technology;Testing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577306},
}

@INPROCEEDINGS{11577261,
  author={Park, Yousung and Kim, Hyeong-Joon and Chae, Suyun and Eom, Jeeyeon and Kim, Hyun-Sik},
  title={A 10-Bit Source-Driver IC with Mismatch-Resilient Cross-Point DAC Achieving 1223μm2/Channel and 4.3 mV DVO for Mobile OLED Displays},
  abstract={This paper presents a 10 -bit source-driver IC for OLED displays. The cross-point (XP) DAC enables a compact layout footprint through symmetric centroid-based mismatch resilience. Also, the improved correlated double integration (I-CDI) not only eliminates DAC errors but also auto-zeros amplifier offset with minimal hardware overhead. The SD-IC, fabricated in 180 nm CMOS, achieves a state-of-the-art area ($107.6 \times 11.3 \mu \mathrm{m}^{2}$ /channel) and a 4.3 mV DVO with a $1-\mathrm{H}$ scan time of $1.5 \mu \mathrm{s}$.},
  keywords={Current;Timing;Printing;Integrated circuits;Displays;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577261},
}

@INPROCEEDINGS{11577555,
  author={Li, Mingxuan and Ren, Wenjie and Li, Zhuolin and Ye, Le and Jia, Tianyu},
  title={A $\mathbf{1 2 2. 2} \boldsymbol{\mu} \mathbf{J} /$ Token Reasoning LLM Accelerator with Reinforcement Fine-Tune Featuring Two-Level KV-Cache Compression and Spike-Driven Predictive Update},
  abstract={In this paper, we introduce an accelerator for reasoning LLM with reinforcement learning fine-tune (RLFT) via three key features: 1) two-level KV cache compression with importanceoriented KV evicting and low-rank decomposition; 2) online reward model scoring using min-hash encoding scheme; 3) spike-driven predictive gradient updating on a hybrid tensor forwarding engine using both digital transpose-free PE and compute-in-memory (CIM) macros. The above innovations enable $2.03 \times$ less KV cache, $2.27 \times$ less RM scoring latency and $3.79 \times$ less weight update. Overall, a $122.2 \mu ~\mathrm{J} /$ Token energy efficiency including EMA and 747.2 ms /iteration latency are obtained for Qwen3-4B reasoning and RLFT.},
  keywords={Modeling;Timing;Printing;Large language models;Cognition;Cognitive systems;Very large scale integration;In-memory computing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577555},
}

@INPROCEEDINGS{11577381,
  author={Bonomi, Stefano and Praemassing, Frank and Chiang, Sie Boo and Grollitsch, Werner and Nonis, Roberto},
  title={A Robust, Digital-Friendly, Differential and Distributed Supply Monitor Architecture for Automotive SoC in 28nm},
  abstract={The proposed supply monitor digital architecture is applied in Automotive applications on Sense and Adapt and on State of Health systems. It operates within the core supply domain using core regular devices without additional sensors or analog references. It requires a one-time, one-point calibration at wafer test. It ensures a robust, digital-friendly and easy-tointegrate implementation that satisfy the ASIL safety level and temperature range $-40^{\circ} \mathrm{C}$ to 160 °C of Automotive applications. Fabricated in n 28 the active area is $0.01 \text{mm}^{2}$, power consumption 540 uW. It tracks variations of 217 mV in 1 us, FoM is $2.45 \text{pJ} /$ conv-step., an inaccuracy of 10 mV, after stress and in presence of supply aggressors.},
  keywords={Monitoring;Calibration;Voltage;Temperature;Oscillators;Frequency;Very large scale integration;Printing;Technology;Supply Monitor;Voltage level detector;on-chip voltage sensor;voltage droop detector;digital voltage monitor},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577381},
}

@INPROCEEDINGS{11577568,
  author={Zhu, Zhongyunshen and Yao, Aijia and Sun, Patricia and Jiao, Yixuan and Mohamed, Mohamed and Park, Ji-Hoon and Li, Jingxian and Kong, Jing and Zhu, Jiadi and Palacios, Tomás},
  title={Performance Demonstration of Monolayer MoS2 Transistors at Cryogenic Temperatures Down to 6 K for Ultralow-Power Electronics},
  abstract={The DC and noise characterization of monolayer MoS2 transistors are measured over a wide temperature range from 300 K to 6 K. Temperature-dependent trends in $V_{\mathrm{T}}$, onand off-currents, and subthreshold swing (SS) are analyzed through both individual devices and statistics. At 6 K, the transistors exhibit significantly improved performance, achieving: 1) $\text{SS}_{\min } \approx 22 \text{mV} / \text{dec}$, 2) on/off ratio $>10^{8}$, and 3) twofold enhancement in peak transconductance efficiency compared to 300 K. In addition, MoS2 FETs show strongly suppressed low-frequency noise at cryogenic temperatures, outperforming Si counterparts. A temperature-dependent compact model calibrated to the measurements is employed to simulate MoS2 FETs with ultrathin EOT and channel length down to 18 nm, predicting ultralow-power (ULP) switching and reduced energy-delay product (EDP) relative to scaled Si FETs (planar Si CMOS and FD-SOI). These results highlight the promise of MoS2 for ULP cryogenic electronics.},
  keywords={Temperature;Field effect transistors;Printing;Silicon;Technology;Modeling;Displays;Indexes;Indexing;Noise},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577568},
}

@INPROCEEDINGS{11577356,
  author={Lischke, S. and Heinemann, B. and Steckler, D. and Peczek, A. and Rücker, H. and Mai, C. and Kroh, A. and Marschmeyer, S. and Yamamoto, Y. and Krüger, A. and Korndörfer, F. and Lenke, T. and Kulse, P. and Fursenko, O. and Wolansky, D. and Fraschke, M. and Redd, K. Dorai Swamy and Teply, F. and Simon, S. and Herbel, T. and Huber, R. and Kissinger, D. and Zimmermann, L.},
  title={Monolithic Photonic BiCMOS Technology with 400-GHz SiGe-HBTs and Germanium-Fin Photodiodes},
  abstract={We present a novel monolithically integrated SiGe-photonics technology that combines top-tier SiGe-HBTs with $\mathrm{f}_{\mathrm{t}} / \mathrm{f}_{\max}= 390 / 440 \text{GHz}$ and Ge-fin photodiodes with bandwidths estimated $>200 \text{GHz}$. This ePIC platform is enabled by adapting IHP's SG13G3 SiGe-HBT modules and leveraging Ge-fin photodiode technology. As a proof of concept, we demonstrate a monolithic photonic receiver realized in a development run of this process, achieving electro-optical bandwidth $>110 \text{GHz}$.},
  keywords={Technology;Displays;Indexes;Indexing;Silicon germanium;Bandwidth;Receivers;Printing;Silicon;Heterojunction bipolar transistors;Silicon Photonics;BiCMOS;electronic-photonic integration;SiGe HBT;OE Receiver;Ge photodiode},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577356},
}

@INPROCEEDINGS{11577495,
  author={Moon, Sanghyuck and Huluvallay, Ashfakh and Chung, Hyunwon and Ko, Myeongsu and Jeong, Seokhyeon and Lee, Jungho and Khreishah, Mohammad and Chang, Jeongtaek and Do, Hung and Sutherland, Caitlyn and Kapit, Jason and Nicholson, David and Reinhardt, William and Sylvester, Dennis and Miskin, Mark and Blaauw, David},
  title={A 95.0 dB Dynamic Range Zero-Bias PV Light-to-Digital Converter for Seawater Monitoring with Single Point Calibration},
  abstract={We present a single chip, self-zero-biased light sensor for sea-water analysis for application in a wireless underwater vehicle. The sensor achieves linear irradiance-to-frequency conversion, single point calibration, and light-proportional power consumption. It has a measured dynamic range of $56,500 \times$ with temperature-robust operation in 180 nm CMOS.},
  keywords={Lighting;Displays;Indexes;Indexing;Poles and zeros;Temperature;Distance measurement;Image sensors;Voltage;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577495},
}

@INPROCEEDINGS{11577348,
  author={Aymerich, Joan and Topalli, Gerald and Fernandez, Jose Cisneros and Michans, Javier Cuenca and Jaramillo, Valentina Restrepo and Sawigun, Chutham and Lopez, Carolina Mora},
  title={A Scalable, Unified Current-Mode $\Delta\Sigma$ Redox/PH Readout with Shared Potentiostat and Flicker-Noise Cancellation for High-Density Electrochemical Sensing},
  abstract={This work presents an area-efficient electrochemical-sensing platform based on current-mode delta-sigma modulators (I-DSMs) enabling scalable in-pixel neurochemical sensing. It supports amperometric redox and ISFET-based ion/pH sensing using 1st-order, 1-bit I-DSMs that directly digitize current in sub-0.01-mm2 per-channel footprints. The architecture employs a shared multi-channel potentiostat, an auto-zeroed current DAC suppressing 1/f noise and mismatch, and a switchless back-to-back (B2B) diode mitigating ISFET offset and drift. A prototype in 130-nm CMOS validates the architectures, achieving 100-dB dynamic range (DR) with 12.6-pArms noise for amperometry and 0.016-pH resolution at nW -level power for the ISFET.},
  keywords={Current;Printing;1/f noise},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577348},
}

@INPROCEEDINGS{11577433,
  author={Han, Yong and Lau, Boon Long and Chia, Lai Yee and Lim, Sharon Pei Siang and Ye, Yong Liang and Hsiao, Hsiang Yao and Feng, Huicheng and Tang, Gongyue and Bhattacharya, Surya and Yeo, Yee-Chia},
  title={Record-High Power Dissipation (up to 5kW) Heterogeneous Integration Package with Direct-Chips-Attached Microfluidic Module Enabling TIM-Free Liquid Cooling},
  abstract={A heterogeneous integration (HI) package with direct-chipsattached (DCA) microfluidic cooling module is demonstrated by directly bonding a Si cooler baseplate to multiple chips, achieving a record-high power dissipation of 5 kW for the entire package, including SoCs with power of 4.2 kW and uniform chip heat flux of $360 ~\mathrm{W} / \text{cm}^{2}$. HI packages with multiple test chips were characterized with two DCA configurations: DCA-F with Full baseplate bonded to all chips and DCA-W with Windows to expose backside of chips for direct liquid cooling to eliminate thermal interface material (TIM) for extremely high power dissipation.},
  keywords={Packaging;Bonding;Cooling;Power dissipation;System-on-chip;Displays;Indexes;Indexing;Technology;Modules (abstract algebra);Heterogenous integration;2.5D package;direct bonding;microfluidic cooling;heat dissipation},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577433},
}

@INPROCEEDINGS{11577483,
  author={Lee, Houk and So, Jaehyeon and Hwang, Chanwook and Chung, Woosung and Kim, Kihoon and Lee, Jaemin and Ko, Jonghwan and Choi, Jaehyuk},
  title={All-Digital Event-Based Vision Sensor with Scene Adaptive Power-Saving Pixels and Three-Layer Neural Network for Object Detection},
  abstract={We present an all-digital synchronous event-based vision sensor (EVS) with adaptive power-saving pixels and in-sensor object-of-interest (OOI) extraction. The $200 \times 128$ singlephoton avalanche diode (SPAD) array employs three sceneadaptive power saving (PS) schemes saturation-based (SATPS), temporal (T-PS), and spatial (S-PS) to suppress power consumption under saturation, short-window abrupt changes, and spatial redundancy. A three-layer hybrid spiking/binary neural network generates $8 \times 8$ tile-wise OOI signals to gate informative-event-focused readout. Fabricated in 90 nm, the prototype consumes 9.85 mW at 200 lux, achieving 47.6% pixel- and 21.6% core-power savings, with up to 53.77% pixel saving and 51.4% total saving in composite scenes. The measured throughput is 5.58 kfps and 714 Meps (DAQlimited). Due to IR-drop induced margin loss, real time OOI detection was validated on an FPGA (Dice score= 0.7452).},
  keywords={Pixel;Timing;Single-photon avalanche diodes;Displays;Image sensors;Indexes;Indexing;Tiles},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577483},
}

@INPROCEEDINGS{11577589,
  author={Wang, Weijin and Zhang, Yibei and Tang, Jianshi and Zhang, Qiqi and Wang, Ziruo and Gao, Lei and Xu, Haitao and Su, Yanbo and Li, Jiaming and Hu, Ruofei and Tang, Zhidong and Wang, Kexin and Fan, Yijia and Yuan, Jian and Yao, Peng and Wu, Dong and Deng, Ning and Gao, Bin and Qian, He and Wu, Huaqiang},
  title={Flexible Monolithic 3D Integration of RRAM-based CIM, CNT CMOS Circuits and IGZO FET-based Sensor and Display for Augmented Reality Contact Lenses},
  abstract={Augmented reality (AR) contact lenses emerge as a promising immersive platform offering seamless, eyeintegrated augmented experiences. In this work, for the first time, we present M3D-FAR, a prototype Monolithic 3D integration chip featuring Flexible Augmented Reality contact lenses with three interconnected functional layers on the same flexible substrate: $1^{\text{st}}$ layer of $8 \times 8 \text{Ta}_{2} \mathrm{O}_{5}$-based resistive random-access memory (RRAM) array for digital computing-in-memory (CIM), $2^{\text{nd}}$ layer of carbon nanotube (CNT) CMOS circuits for logic and data interface, and $3^{\text{rd}}$ layer of $\text{InGaZnO}_{\mathrm{x}}$ field-effect transistors (IGZO-FET) for 8×24 photosensor array and display driver circuits. The structural integrity and proper function of the M3D-FAR chip was validated by structural analysis and electrical measurements. Furthermore, system-level benchmark in a typical image-based interactive task shows that the M3D-FAR architecture could achieve $10.45 \times$ speed-up compared to its 2D counterpart and consume $5.39 \times$ lower energy than GPU.},
  keywords={Displays;Arrays;Indexes;Indexing;In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Printing;Lenses},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577589},
}

@INPROCEEDINGS{11577312,
  author={Xu, Zhengqi and Zhao, Zhiyuan and DeLude, Coleman and Romberg, Justin and Flynn, Michael},
  title={An 8-Element 200-MHz Bandwidth Oversampling Digital Slepian Beamformer},
  abstract={We introduce an 8 -element digital Slepian beamforming receiver. The Slepian architecture reduces the number of digital fractional delay filters (FDFs) by at least 4 times. An array of bandpass time-interleaving noise-shaping SAR ADCs provides a 61 dB array SNR, and enables $800 \text{MS} / \mathrm{s}$ multiply and accumulate (MAC) and FDF. Oversampling improves FDF efficiency. Fabricated in 28 nm CMOS, the beamformer supports a 200 MHz baseband bandwidth and consumes only 10.4 mW per beam for 8 beams with an $\text{EVM}_{\text{rms}}$ of −42 dB.},
  keywords={Beams;Media Access Control;Arrays;Delays;Bandwidth;Timing;Noise shaping;Printing;Array signal processing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577312},
}

@INPROCEEDINGS{11577259,
  author={Chen, Zhuo and Ronchi, Nicolò and Izmailov, Roman and Trivedii, Kruti and Subhechha, Subhali and Verreck, Devin and Xiang, Yang and Tang, Hongwei and Van den Bosch, Geert and Belmonte, Attilio and Rosmeulen, Maarten and Afanas'ev, Valeri and Van Houdt, Jan},
  title={Vertically Stacked Five-Word-Line IGZO FeFETs with Dual-Gate-Enabled Stable Erase Toward High-Bandwidth Storage},
  abstract={Electrical erase of hole-scarce IGZO FeFETs so far relies on fringing field by aggressive channel length scaling, which is difficult to reconcile with $\mu \mathrm{m}$-long channel in 3D vertically stacked cells. In this study, we report on IGZO FeFETs with a Dual-Gate (DG) architecture that enables stable $\mu \mathrm{s}$-erase over channel lengths from $0.1 \mu ~\mathrm{m}$ to $10 \mu ~\mathrm{m}$, together with 1e8-cycling endurance. Moreover, for the first time, we demonstrate 3D vertically stacked DG IGZO FeFET strings with 5 word lines, showing robust ferroelectric memory window. The fabricated 3D DG devices achieve fast program $(100 ~\text{ns})$ and erase $(10 \mu ~\mathrm{s})$, providing a low-voltage and highendurance alternative to NAND flash for data staging/offloading-oriented HBS in AI inference.},
  keywords={FeFETs;Memory;Stacking;Iron;Polarization;Switches;Displays;Indexes;Indexing;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577259},
}

@INPROCEEDINGS{11577340,
  author={Shamanna, Manjunath and Wills, M. and Hazra, J. and Saif, M. and Sell, B. and Lin, C-H. and Fischer, K. and Hafez, W. and Grimm, B. and Joshi, S. and Chatterjee, A. and Ramaswamy, R. and Fetzer, E. and Subramaniam, R. and Lustman, T. and Glassberg, J. and Dhar, S. and Wang, X. and Varada, R. and Saha, S. and Mudanai, S. and Sarwar, A. and Wu, T. and Karl, E. and Murugavel, A. and Prakash, S.B. and Markovits, H. and Ranade, P. and Venkataraman, S. and Krishnamoorthy, A. and Doyle, M.},
  title={CPU Cores in GAA with Backside Power: Silicon-Validated Design Insights},
  abstract={This paper presents key design learnings from CPU cores implemented in Gate-All-Around (GAA) transistors with Backside Power Delivery (BSPD), contrasting with FinFET technologies. Silicon data reveals improved translation of transistor improvements to core frequency, especially at low voltages (30% frequency at $\sim 0.5 \mathrm{V})$ because of lower Vt and reduced IR drop. GAA-BSPD designs exhibit altered behavior in frequency sensitivity to Vcc and temperature, while posing MCMM (multi-corner multi-mode) tool challenges. Lower Vt and IR drop expose more of the Local Layout Effects (LLE), necessitating enhanced front-end modeling. As lower Vt provides lesser benefits at high voltage in GAA-BSPD designs, we demonstrate through presilicon analysis that adding coarse-pitch metal layers serves as a low-cost, high-Vcc performance booster, improving power and frequency via reduced capacitance and wiring congestion (lower coupling = fewer Signal Integrity issues).},
  keywords={Displays;Indexes;Indexing;Design methodology;Modeling;Frequency;Silicon;Central Processing Unit;Metals;Transistors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577340},
}

@INPROCEEDINGS{11577450,
  author={Sonawane, Jay and Deng, Sunbin and Lee, Kiseok and Waqar, Faaiq and Zhang, Chengyang and Phadke, Omkar and Datta, Suman and Yu, Shimeng},
  title={FAB Gain Cell Memory: A Folded Asymmetric Boosted Design to Improve Sense Margin for a Refresh-Free Operation},
  abstract={We propose a folded asymmetric boosted 3T gain cell (GC) to enable a refresh-free, high-speed on-chip memory, using amorphous oxide semiconductor (AOS) FETs. An underlapped write FET suppresses write WL coupling, while an overlapped storage/read gating FET enables read WL driven storage node (SN) boosting through a preferential capacitive coupling. This boosting operation shifts the sensing operation out of the near-threshold regime, improving $\mathrm{V}_{\text{TH}}$ variation tolerance. The measurements show a 1.48 V boosted memory window (at $\mathrm{V}_{\text{DD}}=1 \mathrm{V}$) and $>300 \mathrm{s}$ at $85{ }^{\circ} \mathrm{C}$ data retention (3 orders of improvement over conventional 3T GC). The projected 7nm FAB design shows 2.6 ns read delay and satisfies the refresh-free requirement for GPU last-level cache, given maximum data lifetime profiled from AI workloads.},
  keywords={Boosting;Tin;Printing;Writing;Field effect transistors;Timing;Joining processes;Arrays;Couplings;Displays},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577450},
}

@INPROCEEDINGS{11577397,
  author={Kim, Hyoungjun and Chen, Ethan and Chen, Vanessa},
  title={A Hybrid Processing-In-Sensor Architecture With a Computational Mosaic Array and Residual-Enhanced Analog Skip Connections for Robust Color Vision},
  abstract={This paper presents a hybrid Processing-in-Sensor (PIS) architecture for always-on color vision. The proposed sensor employs a Computational Mosaic Array (CMA) that enables 4 b in-pixel convolution while achieving a 55 % reduction in photodiode area. Filter-less color computation is enabled by triple-well photodiodes, and the proposed time-domain median pooling achieves 98.8 % data reduction. A residualenhanced analog skip connection is incorporated to improve robustness against analog mismatch and noise. A $126 \times 126$ CMOS 180nm sensor array consumes $62.08 \mu ~\mathrm{W}$ at 40 fps with iFoM of $97.76 \text{pJ} /$ pixel frame, achieving 97.25 % accuracy on face detection task.},
  keywords={Timing;Pixel;Arrays;Image sensors;Color;Architecture;Computer architecture},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577397},
}

@INPROCEEDINGS{11577297,
  author={Shanker, Nirmaan and Mochizuki, Shogo and Ando, Takashi and Reboh, Shay and Nguyen, Thanh and Sarkar, Debarghya and Cho, Eunsoo and Li, Wai-Kin and Zhou, Huimei and Southwick, Richard and Li, Juntao and Pawar, Anisha and Pujari, Ruturaj and Jamison, Paul and Fan, Su Chen and Peethala, Brown and Jagannathan, Hemanth and Ramachandran, Ravikumar and Yamashita, Tenko and Guo, Dechao and Bu, Huiming},
  title={High-Temperature Resilient SiGe Nanosheet PFET RMG Towards Multi-Tiered Sequential Integration},
  abstract={We demonstrate, for the first time, SiGe nanosheet (NS) replacement-metal-gate (RMG) PFETs with high temperature stability exceeding 900 °C, validated through sequential integration of a top Si NFET over a bottom SiGe PFET. Interfacial layer (IL) regrowth is suppressed via IL optimization and Al-doped work function metal (WFM). We extend the oxygen-vacancy-based Fermi-level pinning theory by showing that both n - and p-type WFMs converge to the same equilibrium oxygen vacancy concentration after the high-temperature budget required for sequential integration. Consequently, $\mathrm{V}_{\mathrm{T}}$ is tuned by the SiGe-Si valence-band offset rather than the WFM and the WFM can be optimized to mitigate IL regrowth. Together with our prior demonstration of high-temperature-stable NFETs [1], this work lays the foundation for multi-tiered sequential integration.},
  keywords={Silicon germanium;Silicon;Stacking;Displays;Indexes;Indexing;Printing;Optimization;Oxygen;Tin},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577297},
}

@INPROCEEDINGS{11577577,
  author={Sarkar, Eknath and Sonawane, J. and Park, H. and Quezada, E. and Lee, K. and Chakraborty, D. and Shin, J. and Waqar, F. G. and Zhang, C. and Lee, H. J. and Tian, M. and McKinstry, S. Trolier and Narayanan, V. and Khan, A. I. and Yu, S. and Datta, Suman},
  title={First Demonstration of Bit-Cost Scalable and BEOL-Compatible Monolithic 4-Tier FeRAM Operating at 125 °C},
  abstract={We report the first experimental demonstration of a four-tier, bit-cost scalable (BiCS), back-end-of-line (BEOL) compatible monolithic 3D 1T1C Ferroelectric Random Access Memory (FeRAM), integrating 5 nm thin HZO ferroelectric capacitors with dual-gate Indium Gallium Oxide (IGO) access transistors. All tiers show uniform switching characteristics with $\mathbf{2} \mathrm{P}_{\mathrm{r}} \approx \mathbf{6 0 - 7 0} \boldsymbol{\mu} \mathbf{C} / \mathbf{c m}^{\mathbf{2}}$ and $\mathbf{2} \mathrm{V}_{\mathrm{C}} \cong \mathbf{1. 6 - 2. 1} \mathrm{V}$. Refresh-free operation at 125 °C makes the technology ideal for monolithic stacking directly atop high-performance, power-intensive compute dies. We demonstrate successful read with write-back operations, $\mathbf{1 0}$-year data retention at $\mathbf{1 2 5}^{\boldsymbol{\circ}} \mathbf{C}$. Benchmarking projections indicate that this BiCS-based approach enables aggressive density scaling, potentially reaching 4.36 Gb/mm2 for a 100-tier stack.},
  keywords={Stacking;Temperature;Arrays;Displays;Indexes;Indexing;Cells (biology);Polarization;Timing;Modeling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577577},
}

@INPROCEEDINGS{11577281,
  author={Lee, Hyun Jae and Waqar, Faaiq and Park, Hyeonwoo and Zhang, Chengyang and Shin, Jaewon and Sarkar, Eknath and Kim, Hwan and Im, Changik and Hong, Min Ji and Ha, Daewon and Khan, Asif I. and Yu, Shimeng and Datta, Suman},
  title={Workload-Derived AC Bias Temperature Instability and Mechanism Contributions in BEOL Oxide Channel DRAM Access Transistors},
  abstract={This work presents a workload-driven bias temperature instability (BTI) modeling framework that translates execution-based DRAM row-access traces (derived from Ramulator) into time-resolved AC-BTI waveforms for back-end-of-line (BEOL) oxide channel FETs. By mapping AC-to-DC BTI degradation within a single time window, threshold voltage $(\mathrm{V}_{\text{th}})$ evolution is tracked without hidden recovery. This enables physics-based identification of BTI mechanisms based on their time-exponents. Our framework resolves workload-dependent relative contributions of competing mechanisms, enabling reliable BTI projection and workload-aware controller design guidance.},
  keywords={Timing;Human factors;Stress;Degradation;Modeling;Displays;Indexes;Indexing;Printing;Evolution (biology)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577281},
}

@INPROCEEDINGS{11577256,
  author={Suzuki, Kunifumi and Sakuma, Kiwamu and Ichihara, Reika and Schlykow, Viktoria and Tokuhira, Hiroki and Tanaka, Rieko and Iguchi, Natsuki and Jike, Takuma and Matsuo, Kazuhiro and Hagishima, Daisuke and Fujiwara, Makoto and Saitoh, Masumi},
  title={Improved Disturb-Free Memory Window, Retention and Endurance in Low-Voltage 3D-FeFETs by Controlling Strain and Trap Properties in Interfacial Layers},
  abstract={A large memory window (MW), with suppressed read disturbance, good retention, and high endurance, was demonstrated in 3D-FeFETs, enabling both QLC and lowlatency applications. Through in-depth charge analysis, we clarified that read disturbance, which is one of the major issues in both QLC and low-latency operations, occurred when discharging is followed by depolarization. Significant suppression of depolarization was achieved by engineering the charge de-trapping rate in both the gate-side and channelside interfacial layers. We also found that thickness control of the gate interfacial layer effectively induced strain in the ferroelectric layer, enhancing remanent polarization. These optimizations enabled 3D-FeFETs to achieve a large MW of 7.8V after $10^{5} \mathrm{P} / \mathrm{E}$ cycles and a disturb-free MW exceeding 6V after 107 disturbances without retention loss, which is sufficient for low-voltage and low-latency NAND.},
  keywords={FeFETs;Low voltage;High-k dielectric materials;Displays;Indexes;Indexing;Polarization;Very large scale integration;Iron;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577256},
}

@INPROCEEDINGS{11577546,
  author={Xie, Ruilong and Brew, Kevin and Chung, Wonkeun and Gluschenkov, Oleg and Lee, Jongjin and Zhang, Chen and Shanker, Nirmaan and Sarkar, Debarghya and Zhang, Haojun and Huang, Huai and Motoyama, Koichi and Kim, Byounghoon and Jang, Sangshin and Kim, WuKang and Picciocca, Dominic and Sulehria, Yasir and Lo, Wei-Shang and Gribelyuk, Michael and Singh, Sarabjot and Shobha, Hosadurga and Carta, Fabio and Johnson, Richard and Reboh, Shay and Mochizuki, Shogo and Milosevic, Erik and Li, Tao and Natarajan, Kishore and Fan, Su Chen and Yamashita, Tenko and Choi, Kisik and Guo, Dechao and Seo, Kang-Ill and Bu, Huiming},
  title={Backside Contact Resistivity Reduction for Nanosheet Technologies Beyond 2nm by Backside Nanosecond Laser Anneal Without Impacting the Frontside Cu BEOL},
  abstract={This paper highlights the challenges and solutions associated with forming backside source/drain (S/D) contact with low contact resistivity (RhoC). The backside nanosecond laser anneal (NLA) process window is identified by thermal simulation and experimental verification of resistance and reliability impact on the frontside Cu-based back-end-of-line (BEOL). Optimal NLA energy dose (ED) is implemented on nanosheet transistors achieving low RhoC backside contact.},
  keywords={Contacts;Displays;Indexes;Indexing;Printing;Very large scale integration;Energy;Technology;Temperature;Resistance},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577546},
}

@INPROCEEDINGS{11577557,
  author={Peng, Yuhang and Mo, Shizhan and Qi, Liang and Sin, Sai-Weng and Martins, Rui P. and Guo, Mingqiang},
  title={A $3.2 \text{GS} / \mathbf{s}^{2}{ }^{\text {nd }}$-Order Noise-Shaping-Pipelined ADC with 400 MHz-BW 69 dB-SNDR Featuring Gain/Quantizer-Embedded Parallel Voltage/Time-Domain Loop Filter},
  abstract={This paper proposes a $3.2 \text{GS} / \mathrm{s} 2^{\text {nd }}$-order error-feedback (EF) Noise-Shaping-Pipelined ADC. Benefiting from the fast and parallel operation of the proposed gain/quantizer-embedded parallel voltage/time-domain loop filter, this work breaks the speed bottleneck of NS-ADC with high efficiency. The operating frequency of the loop filter is increased to more than $3.2 \text{GS} / \mathrm{s}$. Fabricated in 28nm CMOS, this ADC achieves 69 dB SNDR over a 400 Mhz bandwidth (BW) and only consumes 25.8 mW, leading to a 170.9 dB FoMs and a $14 \text{fJ} /$ conv. -step FoMw. The prototype ADC achieves the highest BW among all discrete-time oversampling ADCs and the best $\text{FoM}_{\mathrm{S}} / \text{FoM}_{\mathrm{W}}$ among all oversampling ADCs with BW $>250 \text{MHz}$.},
  keywords={Timing;Gain;Printing;Specific absorption rate;Synthetic aperture radar;Voltage;Filtering;Technology;Filters;Noise shaping},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577557},
}

@INPROCEEDINGS{11577361,
  author={Xing, Kai and Xu, Zi-Xuan and Pan, Xiang-Hui and Zhu, Yan and Martins, Rui P. and Chan, Chi-Hang},
  title={0.144mm2 Fully-Integrated-Onchip Fast-Converging Background Calibrations for 3-Stage 70.5dB-DR CT Pipelined ADC in 28nm CMOS},
  abstract={This paper presents a fully integrated on-chip (FIO) background calibration technique for a continuous-time Pipeline (CTP) ADC. The calibration leverages the split ADC architecture and tunable negative-R (NR) to facilitate a fast-convergence and low-power OTA in the residue amplifying filter (RAF). The introduced digital pre-filters reduce the number of taps in the digital reconstruction filter (DRF) to 6, enabling FIO. The calibration is verified with a 70.5dB DR and 100MHz CTP ADC, which converges within 2E5 samples.},
  keywords={Calibration;Filtering;Printing;Filters;Convergence;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577361},
}

@INPROCEEDINGS{11577570,
  author={Yang, Junjie and Yu, Jingjing and Chang, Hao and Lao, Yunhong and Cui, Jiawei and Yang, Han and Yang, Xuelin and Liu, Xiaosen and Wang, Maojun and Shen, Bo and Wei, Jin},
  title={6.5 kV Enhancement-Mode GaN Monolithic Bidirectional Switch (MBDS) Achieving Record Power Figure of Merit},
  abstract={This work reports 6.5-kV GaN monolithic bidirectional switch featuring symmetric gate termination extensions (GTEMBDS). The introduced GTE effectively modulates the electric field distribution under bidirectional stress to enhance breakdown voltage and to harden stability. Thus, the GTEMBDS with an $L_{\text{GG}}$ of $62 \mu \mathrm{m}$ exhibits symmetric breakdown voltages $(B V \mathrm{s})$ of −7874 V and 7884 V. With a specific ONresistance $(R_{\text{SP}})$ of $25.97 \mathrm{m} \Omega \cdot \text{cm}^{2}$, GTE-MBDS achieves a high figure of merit $(\text{FOM} =B V^{2} / R_{\text{SP}})$ of $2.39 \text{GW} / \text{cm}^{2}$. Both the $B V$ and FOM represent record values among reported MBDS in SiC, GaN and $\text{Ga}_{2} \mathrm{O}_{3}$. Furthermore, for the first time, this work reports the dynamic $R_{\text{ON}}$ performance of GaN MBDS up to $2-\text{kV}$ stress, demonstrating a decent dynamic $R_{\text{ON}} /$ static $R_{\text{ON}}$ ratio of 1.43 after 2-kV stress at $150{}^{\circ} \mathrm{C}$. In addition, negligible conduction degradation was observed after holding the GTE-MBDS for $10^{3} \mathrm{s}$ at 3 kV and 150 °C.},
  keywords={Electric fields;Generative adversarial networks;Human factors;Stress;Printing;Displays;Indexes;Indexing;Breakdown voltage},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577570},
}

@INPROCEEDINGS{11577439,
  author={Bae, Chong-Hwa and Park, Hyeon-Ho and Yoo, Wiman and Oh, Junghwan and Kim, Dong-Hyun and Park, Gang-Bae and Kim, Mungyu and Kwon, Chankeun and Ha, Dongwan and Kim, Jong-Seok},
  title={An 11B Source-Driver IC with Resistor-Resistor-Embedded (RRE) DAC and Multi-Step Offset Calibration Achieving 1723 µm2/Channel and 1.6 mV DVO for 6285-PPI OLED-On-Silicon Displays},
  abstract={This paper presents an 11b source-driver IC for OLED-onSilicon (OLEDoS) displays that achieves small area by using a three-stage resistor-resistor-embedded (RRE) DAC and lowvoltage DAC. The proposed data-dependent current source (D2CS), spare amplifier, R -share logic, and multi-step offset calibration (MOCU) suppress DVO under massive channel operation. In addition, a proposed high-pass-filter-assisted dynamic current source (HPDCS) enables high frame-rate operation. Fabricated in 65 nm CMOS, the proposed SD-IC achieves a channel area of 1,723 µm2, a maximum DVO of 1.6 mV with a 1000 -channel load, and a settling time of 0.69 µs.},
  keywords={Integrated circuits;Timing;Calibration;Current;Displays;Amplifiers;Printing;Loading;Resistors;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577439},
}

@INPROCEEDINGS{11577305,
  author={Ryu, Huije and Lee, Jongwon and Jeon, Sangmin and Jeon, Gwangsik and Ha, Yoonhoo and Lee, Young Min and Kim, Dongmin and Lee, Hyun Mi and Yoo, Joung Eun and Lee, Eun-Kyu and Cho, Eun-Hyoung and Lee, Jaehyoung and Shin, Yongjoon and Yoo, Chanyoung and Lyu, Sungnam and Lee, Seunghun and Hyun, Sangjin and Kim, Yongsung and Hwang, Cheol Seong and Lee, Do-Sun and Byun, Kyung-Eun and Kim, Changhyun},
  title={Atomic Layer Deposition of Epitaxial Semimetal Contacts for 2D Transistors},
  abstract={This work reports 8 -inch wafer-scale epitaxial atomic-layer deposition (ALD) Sb contact for two-dimensional (2D) transistors using intermediate-enhanced ALD (IE-ALD) and epitaxial de-chalcogenation, achieving a record-low ALD contact resistance $\left(\mathrm{R}_{\mathrm{C}}\right)$ of $0.6 \text{kOhm} \cdot \mu \mathrm{m}$ for $\text{MoS}_{2}$. Leveraging ALD conformality, we demonstrated for the first time an epitaxial contact-all-around (C-AA) structure, extending the contact interface beyond conventional planar geometries. Density functional theory (DFT) calculations show that the charge-transfer efficiency of the C-AA structure exceeds that of conventional Sb top-contacts.},
  keywords={Contacts;Displays;Indexes;Indexing;Transistors;Printing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577305},
}

@INPROCEEDINGS{11577208,
  author={Kang, Minyoung and Lee, Dongkwon and Jeong, Sangsu and Shin, Kwanghyun and Jeon, Dongsuk},
  title={A 28nm 2GS/s Remote-Sensing On-Chip Oscilloscope Using Charge-Redistributing Voltage Transfer and Time-Domain Stochastic ADC with 1.6mV Resolution},
  abstract={This paper proposes a high-resolution, multi-point on-chip oscilloscope utilizing time-interleaved distributed sensors to minimize self-induced droop and a shared central processing unit with a stochastic time-domain analog-to-digital converter, combined with fast and power-efficient repeater-less chargeredistributing transmission. Fabricated in 28 nm, the design achieves a high resolution of 1.6 mV at $2 \text{GS} / \mathrm{s}$ over $0.59-1.1 \mathrm{V}$, outperforming prior designs with minimal local sensor power consumption to avoid self-induced VDD droops.},
  keywords={Image sensors;Timing;Design methodology;Printing;Voltage;System-on-chip;Measurement units;Oscilloscopes;Technology;Sensors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577208},
}

@INPROCEEDINGS{11577248,
  author={Lee, Changkyu and Seo, Myunghae and Lim, Jihun and Kim, Sooyeon and Jang, Minho and Park, Jongeun and Cho, KeunYeong and Kim, Jinyoung and Kim, Minkwan and Jo, Yongkun and Kim, YoonSeok and Park, Dami and Park, Gyunha and Song, Jiyoun and Son, Sungmin and Park, Yongsang and Lim, Hajin and Go, Jonghyun and Song, Jaihyuk},
  title={A Fully-Buried Transfer Gate and Polysilicon Wire: Noise Enhancement Technology for CMOS Image Sensors with 2-Layer Pixels},
  abstract={In this paper, we develop a fully-buried transfer gate and polysilicon wire (FBP) structure that significantly improves noise performance in a 2-layer pixel CMOS image sensor. FBP converts all the devices made of poly-Si into fully buried structures and interconnects multiple floating diffusion nodes using buried poly-Si wire, thereby simultaneously reducing process steps and improving random noise. The Conversion Gain (CG) was improved by more than 33% compared to the conventional scheme.},
  keywords={Pixel;Displays;Indexes;Indexing;Wire;Wires;Wiring;Contacts;Gain;Noise;CMOS image sensor;2-layer pixel;fully buried transfer gate;polysilicon wire;noise;conversion gain},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577248},
}

@INPROCEEDINGS{11577387,
  author={Li, Dongze and Sun, Yichi and Deng, Wei and Nie, Xiangyu and Xue, Fuzhi and Jia, Haikun and Zhou, Liangjiang and Wu, Rui and Chi, Baoyong},
  title={A 1.5-to-20.5 GHz Intrinsic-Spurious-Rejection Real-If Dual-Translation Transceiver Chipset Achieving 10-Gb/s 1024-QAM and 5-μs Hopping},
  abstract={This work presents a 1.5-to-20.5 GHz intrinsic-spuriousrejection real-IF dual-translation transceiver (TRX) chipset for agile frequency-hopping (FH) communications (FHC). By processing signals in the real-IF domain, both the transmitter (TX) and receiver (RX) adopt a dual-conversion architecture that fundamentally eliminates I/Q imbalance, achieving inherent sideband and image suppression for superior spectral purity. To enable rapid frequency switching, a fast-hopping PLL is co-designed to generate LO signals for the chipset. Measurement results demonstrate a 10 Gbps data rate with 1024-QAM modulation and a hopping time of $5 \mu \mathrm{s}$. To the authors' knowledge, this is the first complete CMOS TRX designed for fast FHC.},
  keywords={Frequency;Phase locked loops;Transceivers;Displays;Indexes;Indexing;Printing;Spread spectrum communication;Technology;transceiver;frequency-hopping;chipset;IRR;FR3},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577387},
}

@INPROCEEDINGS{11577621,
  author={Xie, Shanshan and Chen, Gregory K. and Knag, Phil C. and Ozturk, Hikmet Seha and Sathe, Visvesh S. and Tokunaga, Carlos and Tschanz, James W.},
  title={Unified Digital Thermal-Voltage Sensor for Thermal Management in Intel 18A/Intel 3},
  abstract={A unified digital thermal and voltage sensor achieves inaccuracies of $1.9^{\circ} \mathrm{C} / 1.3 \text{mV}$ (Intel 3) and $3.1^{\circ} \mathrm{C} / 2.1 \text{mV}$ (Intel 18A) in a hybrid bonded 3DIC DNN processor using a high-volume manufacturing calibration flow. Aging compensation measures always-on and power-gated sensors to generate scaling factors that maintain the sensor's accuracy over its lifetime. RISC-V cores process sensor data to compute real-time thermal and voltage maps for a DNN workload, and thermal throttling response reduces temperature guardbands by maintaining a reference temperature.},
  keywords={Image sensors;Aging;TV;Voltage;Temperature;Dies;Calibration;Technology;Printing;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577621},
}

@INPROCEEDINGS{11577484,
  author={Hung, Tao-Yi and Chu, Li-Wei and Lin, Wun-Jie and Lee, Jam-Wem and Chen, Kuo-Ji},
  title={ESD and Circuit Perfromance DTCO in 2nm CMOS Nanosheet Technology},
  abstract={In this paper, low cap. electro-static discharge (ESD) design-technology co-optimization (DTCO) for high-speed input/output (I/O) circuit are proposed in a 2 nm CMOS nanosheet technology. Several optimization methodologies are introduced and demonstrate to 9 A charged-device model (CDM) robustness with only 100 fF. Moreover, the new design can also suppress the Vclamp to $<3 \mathrm{V}$ which will benefit interface circuit design flexibility.},
  keywords={Electrostatic discharges;Diodes;Thyristors;Clamps;Technology;Metals;Capacitance;Printing;Design methodology;Circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577484},
}

@INPROCEEDINGS{11577627,
  author={Yu, Jingshu and Kim, Suhwan and Krishnamurthy, Harish K and Gong, Minxiang and Ahmed, Zakir K and Weng, Sheldon and Ravichandran, Krishnan and Tschanz, James W and De, Vivek},
  title={A 4.8 V 16nm Stackable Hybrid Fully Integrated Voltage Regulator with in-Package Magnetic Inductors Featuring Automatic Voltage and Current Sharing Between Stacks},
  abstract={A high voltage (4.8 V), high efficiency (85 %), high density $\left(4 ~\mathrm{A} / \text{mm}^{2}\right.$ incl. passives), 16 nm Stackable Hybrid FIVR (SHFIVR) converter operating at $>25 \text{MHz}$ with an in-package magnetic inductor (3.8 nH) is proposed. The SH-FIVR utilizes a series-input and parallel-output configuration with automatic voltage and current sharing to provide a modular solution for AI accelerators. This is the highest input voltage FIVR reported to date with compelling efficiency and density.},
  keywords={Stacking;Voltage;Printing;Displays;Indexes;Indexing;Dies},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577627},
}

@INPROCEEDINGS{11577218,
  author={Kim, Minsung and Kim, Daehong and Kim, Minjae and Kim, Joongyu and Yoo, Byeongwoo and Park, Sung-Yun},
  title={A CMOS Energy Harvesting System Integrating SIDO/DISO Continuously-Scalable-Conversion-Ratio SC Converter and Energy-Recycling BSI Photovoltaics},
  abstract={We present a near-infrared energy harvesting system that integrate a continuously-scalable-conversion-ratio (CSCR) switched-capacitor (SC) converter, backside-illuminated (BSI) CMOS photovoltaics (PVs), a maximum power point tracking (MPPT), and all controls in a single chip. The PVs recycle incident BSI light to enhance photo-collection efficiency ($\eta_{\text{PC}}$) and enable 3-D stacking of energy-reservoir capacitors by optical grating and reflector. The CSCR SC converter alternates between single-input-dual-output and dual-input-single-output with low ripple according to MPP and improves power conversion efficiency ($\eta_{\text{PCE}}$) via adaptive virtual level selection and flying capacitor-split schemes. The system achieves $21 \% \eta_{\text{PC}}$ at low illumination intensity of $90 \mu \mathrm{W}/\text{mm}^{2}$ and 91.1% peak $\eta_{\text{PCE}}$.},
  keywords={Converters;Maximum power point trackers;Printing;Circuits;Capacitors;Switches;Technology;Video recording},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577218},
}

@INPROCEEDINGS{11577526,
  author={Wang, Jingxiang and Zhang, Kaize and Zhao, Xiuyuan and Chen, Hongjiang and Li, Haoyu and Sin, Sai-Weng and Martins, Rui P. and Guo, Mingqiang},
  title={A 19.4mW 2.5GS/s Pipelined-SAR ADC Achieving 60.8dB SNDR Employing a Dual-Zero-Compensation Ring Amplifier},
  abstract={This work presents a dual-zero-compensation ring amplifier, which introduces two left-half-plane (LHF) real zeros to enhance the phase margin. In doing so, the proposed architecture achieves both high open loop gain and stable operation. Integrated into a two-stage pipelined-SAR ADC, the amplifier enables an SNDR of 60.8 dB at a sampling rate of 2.5 GS/s with Nqyuist rate input. This corresponds to a FoMs of 168.9 dB and a FoMw of $8.7 \text{fJ} /$ conversion-step.},
  keywords={Poles and zeros;Amplifiers;Printing;Technology;Gain;Timing;Frequency;Displays;Indexes;Indexing;Analog-to-digital converter (ADC);zeros and poles;Zero-point compensation;SAR-assisted pipeline ADC;Time interleaving SAR ADC},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577526},
}

@INPROCEEDINGS{11577121,
  author={Zhi, Haochang and Xu, Shaojie and Zhou, Kaize and Qian, Zhangrui and Ren, Shengdao and Liu, Tianshu and Li, Jintao and Li, Yun and Shan, Weiwei and Qu, Wanyuan},
  title={A 10-MHz Integrated Voltage Regulator with Cycle-Accurate and Lightweight Predictive Control Achieving 5-mV Off-Chip Droop},
  abstract={This paper presents a $10-\text{MHz}$ integrated voltage regulator featuring cycle-accurate, lightweight predictive control. A bandwidth-matched weighted training scheme selects 78 sparse transition detectors (TDs) that capture only power-delivery-network-shaped (PDN) frequency components. These TDs are used to predict the cycle-accurate core current $(I_{\text{Core}})$; an adaptive PDN emulator with in-situ calibration then maps $I_{\text{Core}}$ to the regulator-relevant load-current envelope $I_{\text{Load}}$ for proactive regulation. Across 18 workloads, the predictor achieves 3.3% normalized root-mean-square error (NRMSE) on $I_{\text{Core}}$, which translates to 1.5% NRMSE on $I_{\text{Load}}$. Fabricated in $28-\text{nm}$ CMOS, the DC-DC prototype supports 0.81-A load steps with $66-\text{ns}$ edges, suppresses on-die second droop from $72-\text{mV}$ to less than $6-\text{mV}$, and reaches 90.1% peak efficiency.},
  keywords={Loading;Regulators;Dies;Bandwidth;Printing;Current;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577121},
}

@INPROCEEDINGS{11577547,
  author={Wu, Yue and Peng, Yatao and Li, Jiawei and Yuan, Fengen and Gong, Wenhua and Yin, Jun and Martins, Rui P. and Mak, Pui-In},
  title={A Compact Magnetically Coupled Dual-Mode Class-F−1 VCO Covering 5.8−9.97 GHz with 196.2 dBc/Hz FoM and 70-320 kHz 1/f3 Corner Without Harmonic Tuning},
  abstract={A wideband dual-mode inverse class-F VCO with intrinsic harmonic self-alignment is presented. A magnetically coupled quad-mode resonator (QMR) enables tuning-free harmonic shaping using a single switching group, without explicit common-mode resonators. Implemented in $65-\text{nm}$ CMOS, the VCO achieves a 52.4% tuning range, FoM of $196.2 \text{dBc} / \text{Hz}$, and $1 / \mathrm{f}^{3}$ PN corners of $70 \sim 320 \text{kHz}$, demonstrating state-of-the-art performance among mode-switching oscillators.},
  keywords={Voltage-controlled oscillators;Tuning;Joining processes;Switches;Printing;Couplings;Displays;Indexes;Indexing;Technology;class-$\mathrm{F}^{-1}$;VCO;mode-switching harmonic-shaping;1/f³ PN corner;Harmonic tuning-free},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577547},
}

@INPROCEEDINGS{11577648,
  author={Lin, Min-Kuan and Liang, Jhih-Yuan and Liu, Ying-Qi and Chen, Wei-Jen and Hsu, Jui-Yu and Wu, Xuan-Hao and Dai, Jie-Ni and Chen, YanJyun and Yu, Bo-Hui and Fan, Zhi-En and Mei, Yi-Ming and Lee, Ming-Hao and Chu, Ming-Wen and Su, Pin and Hu, Chenming and Liu, C. W.},
  title={Interfacial-Layer-Free NCFETs Achieving $\mathbf{2 mV}$ Hysteresis, $\mathbf{27 mV}$ /dec SS, $\mathbf{2 mV/V}$ DIBL, and Record $2088 \mu \mathrm{A} / \boldsymbol{\mu} \mathrm{m}$ Ion at $\mathrm{V}_{\text{DS}}=\mathrm{V}_{\text{ov}}=0.5 \mathrm{V}$},
  abstract={To reduce $\mathrm{V}_{\text{DD}}$, not only a small subthreshold swing (SS) of 27 mV (minimum) and 53 mV (average from Ioff to $\mathrm{V}_{\mathrm{T}}$) $\text{mV} / \text{dec}$ with only 2 mV hysteresis, but also record high $\mathrm{I}_{\text {ON }}$ per footprint ($2088 \mu \mathrm{A} / \mu \mathrm{m}$ @ $\mathrm{V}_{\text{DS}}=\mathrm{V}_{\text{ov}}=0.5 \mathrm{V}$) are achieved by negative capacitance, with low CET (capacitance equivalent thickness) of 0.43 nm and no interfacial layer (IL). IL-free stacked ferroelectrics around $\text{Ge}_{0.95} \text{Si}_{0.05}$ nanosheets accomplish all the above with negligible DIBL ($2 \text{mV} / \mathrm{V}$) and demonstrate a promising path to future low power AI chips.},
  keywords={Stacking;Printing;Displays;Indexes;Indexing;Silicon;Very large scale integration;Hysteresis;Ions;Iron},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577648},
}

@INPROCEEDINGS{11577323,
  author={Xu, Yichen and Al Hossain, Shahreer Ahmed and Zhu, Baoqi and Kim, Suhwan and Krihshnamurthy, Ram K. and Zhang, Xin and Seok, Mingoo},
  title={VSIMO: A DC-DC SIMO-based Current Mismatch Compensator Supporting Per-Output Bidirectional Power Flow for Stacked Voltage Domains Achieving >82% System Efficiency under up to 360-mA Load Mismatch},
  abstract={This paper presents VSIMO, a single-inductor multiple-output (SIMO) compensator for a four-layer stacked-voltage-domain system. It features a novel bidirectional power-flow technique that dynamically configures each output to operate in either supply or sink mode to efficiently compensate current mismatch between domains. The 65-nm VSIMO prototype takes a 2.4-V input and regulates three outputs (0.6, 1.2, 1.8V). It achieves >82% system efficiency under up to 360-mA current mismatch, advancing the maximum current mismatch and system efficiency of stacked-voltage-domain systems.},
  keywords={Current;Voltage;Loading;Stacking;Inductors;Printing;Technology;Very large scale integration;Bidirectional power flow},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577323},
}

@INPROCEEDINGS{11577236,
  author={He, Yuan and Liu, Kaimeng and Tang, Jianshi and Sun, Cong and Chang, Wei and Ma, Chengxiang and Mao, Haotian and Qiao, Huan and Wang, Kun and Zhou, Falong and Xu, Songchun and Shen, Yilin and Zhu, Zhen and Shi, Mingcheng and Zhu, Xurui and Wang, Kun and Ma, Xiangchao and Wu, Dong and Yao, Peng and Gao, Bin and Qian, He and Wu, Huaqiang},
  title={A 4Mb 3Bits/Cell RRAM Macro in 12nm FinFET Technology with the Smallest 0.019μm2 Bit-Cell, 100K-Cycle Endurance and 10 Years Retention up to 125°C},
  abstract={This work presents a Design-Technology Co-Optimization (DTCO) methodology to address the critical challenges of RRAM integration in advanced FinFET technology nodes. By synergistically optimizing the access transistor, RRAM cell and program algorithm, we achieve the most aggressive cell size scaling and exceptional reliability simultaneously. A 4 Mb RRAM macro is successfully demonstrated on a 12 nm FinFET platform features the smallest $0.019 \mu \mathrm{m}^{2}$ bit-cell. It exhibits robust reliability with 100 K cycling endurance and 10-year data retention at 125 °C for 1-bit per cell (SLC) operation. Furthermore, reliable 3-bit per cell (TLC) operation is realized, achieving 109 read-disturb immunity and state-of-the-art 10 year TLC retention at 85 °C. This work provides a viable path for high-density and highly reliable RRAM integration in advanced nodes, significantly accelerating RRAM deployment for future Edge AI applications.},
  keywords={Cells (biology);Resistive RAM;Displays;Indexes;Indexing;Technology;Optimization;Current;Programming;Voltage},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577236},
}

@INPROCEEDINGS{11577345,
  author={Li, Yifu and Wang, Rui and Mei, Yuchao and Sui, Xinyu and Luo, Xu and Wang, Zheng and Shi, Hanwen and Li, Qingbin and Sun, Wenlong and Zhang, Chuanhan and Zhang, Yi and Jin, Jing and Wu, Lin-Sheng and Pang, Jian},
  title={A $\mathbf{1 2 9}$-Gb/s CMOS W-Band Polarization-Modulated Active Relay Transceiver Supporting Concurrent Dual-Polarized Dual-Stream Relay Operation},
  abstract={This paper presents a CMOS W-band polarization-modulated active relay transceiver. The input and output of the proposed relay are reversely-switched between H pol. and V pol. by a 3-GHz polarization-switching clock. With enough TR isolation, a $16 ~\mathrm{T}+16 \mathrm{R}$ relay module in this work can support concurrent dual-stream dual-polarized relay in 64QAM. A maximum relay data rate of $129 ~\text{Gb} / \mathrm{s}$ is also demonstrated.},
  keywords={Polarization;Relays;Printing;Displays;Indexes;Indexing;Streams;Switches;Transceivers;Modules (abstract algebra);relay;polarization-modulated;phased-array;6G},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577345},
}

@INPROCEEDINGS{11577460,
  author={Kim, Geunha and Lee, Sehwan and Seol, Taeryoung and Park, Kyuhyeon and Wie, Jeongyoon and Lee, Minoo and Jeong, Seokhan and Shin, Yeonjae and Lee, Sangkyu and Koo, Byeongwoo and Choi, Michael and Lee, Junghyup},
  title={A 1V Time-Division-Multiplexed 4-Channel 3 ${ }^{\text{rd}}$-Order NS-SAR ADC with 178.8dB FoM $\mathrm{M}_{\text{DR}}$ and $\text{5.8G} {\Omega}$ Input Impedance for Wearable Dry-Contact Biopotentials},
  abstract={This paper presents a time-division-multiplexed 4-channel $3^{\text{rd}}$-order NS-SAR ADC achieving $178.8 \text{dB} \text{FoM}_{\text{DR}}, 5.8 \mathrm{G} \Omega$ input impedance, and a $1.72 \mathrm{V}_{\text{PP}}$ linear input range for multichannel dry-and non-contact biopotential acquisition in wearable applications. Implemented in a $0.18-\mu \mathrm{m}$ CMOS process, the ADC consumes $4.17 \mu \mathrm{W} / \text{ch}$ from a 1 V supply.},
  keywords={Specific absorption rate;Synthetic aperture radar;Time division multiplexing;Timing;Displays;Indexes;Indexing;Printing;Electrocardiography;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577460},
}

@INPROCEEDINGS{11577607,
  author={Yang, Jee-Eun and Hyun, Seung Dam and Sung, Ha-Jun and Kim, Hojung and Lee, Chang Seung and Jung, Kyooho and Kim, Jung-Kyun and Cha, Youngkwan and Bae, Ki Deok and Park, Garam and Lee, Kwang-Hee and Jung, Moonil and Son, Daehyuk and Jang, Younjin and Han, Na-Rae and Hong, Hyerim and Nam, Seung-Geol and Choe, Duk-Hyun and Kim, Sangwook and Heo, Jinseong},
  title={High-Performance Normally-Off IGZO FeFETs with Thermally Stable Ru S/D for Power-Efficient Memory Arrays},
  abstract={We propose a Ru source/drain (S/D) engineering strategy to achieve normally-off IGZO-based ferroelectric FETs (FeFETs) with a positive threshold voltage $(\mathrm{V}_{\text{th}})$. Owing to the high oxide formation energy of Ru, oxygen scavenging from the IGZO channel is suppressed, enabling stable $\mathrm{V}_{\text{th}}$ control under high-temperature annealing. Ru S/D FeFETs demonstrate excellent endurance up to 109 program/erase (PGM/ERS) cycles with maintaining positive $\mathrm{V}_{\text{th}}$. The resulting normally-off FeFETs enable energy-efficient read operation in 3D arrays, reducing read energy by 60% compared to conventional S/D devices.},
  keywords={Arrays;Displays;Indexes;Indexing;FeFETs;Annealing;Electrodes;Tin;Oxygen;Energy},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577607},
}

@INPROCEEDINGS{11577273,
  author={Wang, Ximing and Yu, Jiaao and Chen, Yunjie and Zhang, Haoming and Zhu, Yuyang and Iizuka, Tetsuya},
  title={A 91.9dB-SNDR 100kHz-BW DT $\boldsymbol{\Delta} \boldsymbol{\Sigma}$ ADC Employing Thermal Noise Suppression Techniques with Gain-Switched Dynamic Self-Quenching FIA},
  abstract={This paper presents a $3^{\text {rd }}$-order fully dynamic $\Delta \Sigma$ ADC employing thermal noise suppression (TNS) techniques. By suppressing both the sampling noise and amplifier noise of the discrete-time (DT) integrator, the proposed TNS improves the SNR of the $\Delta \Sigma$ ADC by 3.4 dB. A 2 -stage floating inverter amplifier (FIA) is employed to achieve stable gain for sampling noise cancellation (SNC) as well as high gain for accurate closed-loop operation. In addition, to enhance the output swing range of the FIA while maintaining power efficiency, a dynamic self-quenching FIA (DSQFIA) is proposed. The ADC prototype is fabricated in a 65 nm CMOS process and achieves an SNR of 92.7 dB, an SNDR of 91.9 dB, and a DR of 93.7 dB over a 100 kHz bandwidth. With a power consumption of $199.2 \mu ~\mathrm{W}$, the Schreier figure-of-merit (FoM) of 178.9 dB is achieved.},
  keywords={Noise;Gain;Printing;Amplifiers;Noise reduction;Signal to noise ratio;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577273},
}

@INPROCEEDINGS{11577490,
  author={Ma, R. Matthew and Bao, H. Bruce and Feng, S. Sarah and Liu, Zhiyu and Pei, Yi and Wong, Man Hoi and Yue, C. Patrick},
  title={A 1.58-W/mm2 Extreme-Power-Density Ka-Band GaN PA with Electro-Thermal-Mechanical Co-Design in CMOS+GaN Heterogeneous Integration},
  abstract={This paper presents a comprehensive electro-thermal-mechanical co-design methodology for CMOS+GaN heterogeneous integration, validated using a Ka-band GaN power amplifier (PA) with a record power density of 1.58 W/mm2. To mitigate reliability risks from extreme heat flux, we propose a reliability-aware packaging strategy using an Aluminum Nitride (AlN) substrate. We optimize the Residual Copper (RC) rate to address the trade-off between thermal dissipation and mechanical stress. Fabricated in a 150-nm GaN-on-SiC process, the compact 2.30-mm2 PA chiplet delivers a saturated output power of 35.6 dBm(3.6 W) with a peak power-added efficiency (PAE) of 32.0%. This work demonstrates that the proposed co-design framework ensures system robustness even under aggressive power scaling.},
  keywords={Generative adversarial networks;Dies;Printing;Design methodology;Ka-band;Substrates;Technology;Gain;GaN power amplifier;Ka-band;heterogeneous integration;high power density;electro-thermal-mechanical reliability;co-design},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577490},
}

@INPROCEEDINGS{11577409,
  author={He, Zhen and Wang, Yiqi and Yue, Zhiheng and Wu, Zihan and Hu, Yang and Tu, Fengbin and Yin, Shouyi},
  title={A 28nm 44.15TFLOPS/W and 1.57TFLOPS/mm2 Joint-Alignment Floating-Point CIM Macro with ISO26262 ASIL-D Safety Level for Autonomous Driving},
  abstract={This paper presents a floating-point Computing-in-Memory (FPCIM) macro tailored for AI model acceleration in autonomous driving. It has three features: 1) A joint-alignment CIM structure that performs the exponent-mantissa joint-alignment, reducing 3.97x accuracy loss and 31.24% area efficiency loss. 2) A hybrid XNOR/XOR adder tree (HAT) featuring first-level XNORbased 6T and other-level XOR-based 10T full adders (FA), reducing 71.35% area overhead. 3) A unified all-inclusive Silent Data Corruption (SDC) decoder (UASD) that directly protects final MAC results against SDC, achieving <0.5% SDC rate with only 8.41% area cost and ISO 26262 ASIL-D safety level.},
  keywords={In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Printing;Joints;Media Access Control;Adders;Modeling;Safety},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577409},
}

@INPROCEEDINGS{11577383,
  author={Kang, Donggil and Lee, Shin Hyung and Han, Jae-Hoon and Kim, Jongmin and Ahn, Seok-Geun and Jung, Minhyuk and Jung, Hyun-Chul and Kim, SangHyeon},
  title={Depletion-Mode Iii-V/Si SISCAP Mach-Zehnder Modulator Breaking the Efficiency-Bandwidth Trade-off for Co-Packaged Optics},
  abstract={Design-technology co-optimization in co-packaged optics has become important; designing optical modulators would be a good example because their key figure of merits, such as high bandwidth, efficiency, and thermal robustness, will be impacted by the layout, device structure, etc. This work demonstrates a III–V/Si SISCAP Mach–Zehnder modulator utilizing depletion-mode operation, Franz–Keldysh–assisted modulation, and a traveling-wave electrode design, achieving a modulation efficiency of $0.146 ~\mathrm{V} \cdot ~\text{cm}$ and an electro-optic bandwidth of 26.3 GHz, corresponding to a record optical modulation amplitude (OMA) line.},
  keywords={Modulation;Silicon;Printing;Technology;Design methodology;Bandwidth;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577383},
}

@INPROCEEDINGS{11577538,
  author={Hwang, Yunbeom and Kwon, Yongkeon and Song, Minkyu and Shin, Seongjun and An, Junseo and Park, Jun-Eun},
  title={A Fully Integrated, GBW-Enhanced Tri-Loop, Maximum Ripple Rejection Tracking Analog LDO Achieving Better Than −25.5dB PSR Up to 1GHz and 13ns Settling Time},
  abstract={This paper presents a fully integrated, gain-bandwidth (GBW)-enhanced tri-loop low-dropout regulator (LDO) achieving wideband power-supply rejection (PSR) and fast transient response. The proposed LDO combines a gainenhanced slow loop (SL), a current-mirror-based fast loop (CM-FL), and a regulated shunt-feedback-inverter-based ultrafast loop (RSFI-UFL) to simultaneously enhance PSR and transient performance. An on-chip maximum ripple rejection tracking (MRRT) controller adaptively aligns a notch-like PSR-boosting frequency to suppress the dominant switchingregulator ripple. Fabricated in a $40-\text{nm}$ CMOS process with an on-chip output capacitor of 40 pF, the prototype achieves PSR better than −25.5 dB up to $1 \text{GHz},-52.8 \text{dB}$ at 10 MHz, and a $13-\text{ns}$ droop settling time with $50-\text{mV}$ undershoot for a 0.15–to–$-10-\text{mA}$ load step.},
  keywords={Printing;System-on-chip;Transient analysis;Boosting;Frequency;Loading;Bandwidth;Timing;Transient response},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577538},
}

@INPROCEEDINGS{11577503,
  author={Zhou, Zhiwei and Hu, Tong and Chen, Jia and Li, Jiancong and Fu, Yuyang and Li, Yi and Miao, Xiangshui},
  title={A 40nm 24.85-to-80.59 TFLOPS/W FP8 Computing-in-Memory Macro with Outlier-Aware Hierarchical-Alignment for Edge Transformers},
  abstract={This paper presents a digital Compute-in-Memory (CIM)-based macro tailored for edge Transformer acceleration. It has three features: 1) A Hierarchical Dual-Exponent Alignment scheme that separates outliers from normal values, achieving near-ideal accuracy with minimal overhead. 2) A Sign-Magnitude Input Serial Pipelined Aligner (SMSPA) reduces area and power by 41.1% and 34.1%. 3) A Shift-Concat based Sign-Inverse Adder Tree (SSAT) saves accumulation area and power by 25.9% and 18.2%. The macro achieves $24.85-80.59$ TFLOPS/W in FP8. Measurements demonstrate up to $6.66 \times$ improvements in energy efficiency, compared to state-of-theart post-alignment FP-CIM schemes, while maintaining high accuracy on different tasks.},
  keywords={Technology;In-memory computing;Adders;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Printing;Accuracy;Timing;Trees (botanical)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577503},
}

@INPROCEEDINGS{11577590,
  author={Kim, Joo-Hyun and Eom, Doyoon and Choi, Hyun-Seung and Park, Eunsung and Choi, Woo-Young and Lee, Myung-Jae},
  title={Back-Illuminated CMOS-SPAD with Full-Surround Anode Structure Achieving Sub-50 ps Timing Jitter for High-Precision Physical-AI Sensors},
  abstract={We present a full-surround anode SPAD (FS-SPAD) fabricated in a back-illuminated 90 nm CMOS image sensor (CIS) foundry technology with high-performance timing jitter for short/mid-range dTOF sensors. The FS-SPAD improves carrier transport by co-optimizing the p-epitaxial (p-epi) layer and the anode, which is ease-modification with other non-isolated SPADs. The SPAD achieves a breakdown voltage $(V_{B})$ of 15.8 V and demonstrates a timing jitter of 49 ps (FWHM), a photon detection probability (PDP) of 24.2%, and a normalized dark count rate (nDCR) of $12.57 \text{cps} / \mu \mathrm{m}^{2}$.},
  keywords={Single-photon avalanche diodes;Timing jitter;Technology;Printing;Bismuth;Business intelligence;Very large scale integration;Anodes;LiDAR;SPAD;Timing Jitter;Physical AI;PDP},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577590},
}

@INPROCEEDINGS{11577347,
  author={Jang, Hyeong-Seok and Kim, Munhyeon and Hu, Luhing and Shim, Jaewoo and Kim, Joonyun and Seol, Minsu and Kim, Sang Won},
  title={Device-to-Architecture Co-Design of Monolithic 3D FPGA Using 2D Transistor},
  abstract={This work presents a measurement-driven monolithic 3D (M3D) field-programmable gate arrays (FPGAs) enabled by vertically integrated SRAM using two-dimensional (2D) semiconductor devices. We propose a new FPGA architecture in which the block RAM (BRAM) based on transition metal dichalcogenide (TMD)-channel transistor is monolithically stacked directly above Si CMOS logic blocks. The feasibility of the approach is experimentally validated through integration of logic gates by using MoS2 NMOS and WSe2 PMOS transistors and translated into SPICE models for both circuit-and system-level evaluation. Based on the measured models, a stacked TMD-channel-based BRAM macro is designed for the first time and validated in terms of stability and functionality. When evaluated using Verilog-to-Routing (VTR)-based benchmarks, the proposed approach achieves 59% area reduction and 13% critical path delay improvement over a conventional FPGA. This work demonstrates that M3D memory integration can provide tangible system-level benefits for next-generation FPGA architectures.},
  keywords={Field programmable gate arrays;SRAM chips;Modeling;Memory;Design methodology;Stacking;Architecture;Computer architecture;Silicon;Technology;M3D;2DMs;FPGA;3D SRAM},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577347},
}

@INPROCEEDINGS{11577552,
  author={Yang, Heesoo and Kim, Hyeongjun and Choi, Yurim and Lee, Seungmin and Kam, Dongyun and Jung, Haksoon and Lee, Yongwoo and Kim, Seongju and Kwon, Jimin},
  title={Vertical-Die (V-die) 3.5D Integration for Cool Ultrahigh-Bandwidth Memory Systems},
  abstract={This work explores a 3.5D V-die memory architecture as an alternative integration paradigm, where conventionally fabricated DRAM dies are rotated upright to exploit three-dimensional space at the system level. We assess the feasibility of the V-die concept by benchmarking its achievable bandwidth, capacity scalability, and thermal behavior against state-of-the-art HBM. By standing dies upright to expand exposed surface area and enabling direct liquid cooling between adjacent dies, V-die supports substantially higher thermal design power while unlocking scalable I/O density and capacity beyond conventional HBM.},
  keywords={Dies;Bandwidth;DRAM chips;Memory;Modeling;Technology;Architecture;Computer architecture;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577552},
}

@INPROCEEDINGS{11577422,
  author={Yang, Sheng and Bömmels, Jürgen and Kükner, Halil and Bufler, Fabian M. and Verschueren, Lynn and Mertens, Hans and Vandooren, Anne and Horiguchi, Naoto and Farokhnejad, Anita and Hellings, Geert},
  title={Double-Flip Sequential CFET: Superior 3T Library Efficiency and PPA},
  abstract={Double-flip sequential CFET (sCFET) architecture enables split-gate devices and dense BM0 routing, supporting 3-track standard cells with high library efficiency. Hybrid orientation and asymmetric nanosheet widths in sCFET further optimize device-level PPA, offering scaling potential.},
  keywords={Cells (biology);Printing;Libraries;Layout;Joining processes;Capacitance;Displays;Indexes;Indexing;Optimization},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577422},
}

@INPROCEEDINGS{11577514,
  author={Kikushima, Fumie and Murakami, Yosuke and Aoike, Hideomi and Yoshitaka, Naoya and Yamauchi, Kazuhiro and Hizume, Yuma and Miyachi, Katsunori and Ogura, Tatsuo and Fukumoto, Atsushi and Kaneyama, Junichi and Sasaki, Yusuke and Moriyama, Takumi and Hosoda, Naohiro and Takuma, Shunsuke and Tsutsumi, Masanori and Isogai, Tatsunori and Takeda, Hiroshi},
  title={Deposition Process-Based Charge Trap Layer Segmentation for 3D Flash Memory Achieving Improved Cell Reliability While Maintaining Program/Erase Characteristics},
  abstract={In this study, we propose a 3D flash memory incorporating a pseudo-segmented charge trap layer (CTL) structure formed by a deposition process-based CTL segmentation scheme. By keeping part of the CTL continuous, program slope degradation is suppressed, and the simulated CTL thickness margin-which maintains the program slope and improves cell-to-cell interference (C2C)-is larger than that of fully segmented CTL cells. The demonstrated pseudo-segmented CTL cells achieve a 29% reduction in C2C and a 44% reduction in lateral charge loss (LCL). The word line (WL) pitch scalability for unstressed cells is estimated to be 8 nm for triple-level cells and 10 nm for quadruple-level cells.},
  keywords={Cells (biology);Programming;Displays;Indexes;Indexing;Memory;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577514},
}

@INPROCEEDINGS{11577362,
  author={Kwon, Ohhyuk and Lee, Junyoung and Jung, Jaemin and Yang, Siyoung and Park, Kwangmin and Choi, HanMei and Park, Sejun and Hwang, Hyunsang},
  title={Uniform and Direction-Controllable Metal-Induced Lateral Crystallization for 3D NAND Flash Memory via $\text{NiSi}_{2}(111)$-Oriented Seed Layer Transfer},
  abstract={This paper reports a growth-direction-controllable Metal-Induced Lateral Crystallization (MILC) technique to overcome the self-blocking issue caused by the stochastic collision of randomly oriented whiskers in high-aspect-ratio channels. Utilizing a seed layer transfer process, we effectively suppressed random nucleation and successfully guided MILC whiskers along a predefined orientation. This method guarantees stable and continuous crystallization by minimizing whisker collisions. We validated the proposed technology in a 155-layer 3D NAND structure, demonstrating significant improvements in crystallinity. This work highlights the critical role of whisker directionality and provides essential guidelines for implementing MILC in future 3D NAND architectures.},
  keywords={Crystallization;Seeds (agriculture);Nickel;Silicon;Technology;Displays;High-resolution transmission electron microscopy;Indexes;Indexing;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577362},
}

@INPROCEEDINGS{11577209,
  author={Zhang, Yichen and Liang, Yaogan and Ide, Michihiro and Takamiya, Makoto},
  title={4.5-W 5-V-Input DC-DC Converter with Six Isolated 15-V Outputs Achieving 175-kV/μs CMTI Without Signal Isolators},
  abstract={To reduce the volume of isolated DC-DC converters using bulky transformers and signal isolators for the gate drivers, a compact single input, six isolated output DC-DC converter using a single PCB transformer for both power and signal transfer is proposed. The proposed sensing for TX input power control prevents efficiency degradation even when subjected to large common-mode transient (CMT) without signal isolators. Fabricated in 180nm BCD process, the proposed converter with $>3 \text{kV}$ isolation and $314 \text{mm}^{3}$ per output achieved 67% efficiency and CMTI of $+175 /-167 \text{kV} / \mu \mathrm{s}$ at single 5 V input, six 15 V isolated outputs, and 4.5 W total power.},
  keywords={DC-DC power converters;Converters;Printing;Power control;Transformers;Degradation},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577209},
}

@INPROCEEDINGS{11577436,
  author={Tan, Fei and Berner, Raphael and Zhao, Zhongyu and Xie, Yuhan and Joudi, Amirmahdi and Fu, Yiheng and Sakr, Icare and Collin, Thibault and Rouanne, Vincent and Lorach, Henri and Un, Ka-Fai and Mak, Pui-In and Bloch, Jocelyne and Courtine, Gregoire and Shoaran, Mahsa},
  title={A 64-Channel, Low-Power End-to-End Transformer-Based BCI SoC for Efficient Motion Intention Decoding},
  abstract={Real-time brain-computer interfaces (BCIs) demand fully on-chip neural decoding with tight power, area, and latency budgets. This work presents the first fully-integrated transformer-based BCI SoC that performs energy-efficient motion intention decoding from ECoG signals. The chip integrates a 64-channel analog front-end (AFE) and a distilled, light-weight transformer-based decoder featuring customized 7T-SRAM computing-in-memory (CIM) macros with hybrid sign-magnitude and two's-complement (SM-2C) computation. Fabricated in 65nm, the decoder achieves a 67.8% accuracy on a 6-class upper-limb motion-intention dataset, consuming $47 \mu \mathrm{W}$ in $4.7 \text{mm}^{2}$, while the complete SoC occupies $10.1 \text{mm}^{2}$.},
  keywords={Decoding;In-memory computing;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;System-on-chip;Displays;Indexes;Indexing;Modeling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577436},
}

@INPROCEEDINGS{11577363,
  author={Xiao, Qijing and Yang, Changgui and Sun, Junhong and Wang, Weixiao and Zhang, Yunshan and Hu, Xin and Huang, Kai and Zhao, Bo},
  title={A Cross-Band Wi-Fi/BLE Passive Tag Demonstrating Battery-Free Standard-Mask Communication with Smartphones and Battery-Free AoA Localization},
  abstract={This paper demonstrates a Wi-Fi/BLE passive crystal-less tag achieving battery-free cross-band backscatter communication with smartphones. The proposed cross-band technique suppresses the image component of backscattered signal by more than 32 dB, which eliminates the self-jammer and enables battery-free angle-of-arrival (AoA) localization. Moreover, the polar-modulated pre-distortion mask-shaping technique makes this chip fully compliant with both Wi-Fi and BLE standard masks.},
  keywords={Wireless fidelity;Tagging;Backscatter;Batteries;Smart phones;Printing;Shape;Standards;Displays;Location awareness},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577363},
}

@INPROCEEDINGS{11577644,
  author={Wang, Chun and Yong, Olivia Angel and Liu, Chenxin and Wang, Wenqian and Tian, Anyi and Shehata, Abanob and Kojima, Takumi and Herdian, Hans and Yamazaki, Yudai and Park, Sunghwan and Tang, Minzhe and Xu, Dongfan and Kato, Sena and Zhang, Yuncheng and Kunihiro, Kazuaki and Sakai, Hiroyuki and Okada, Kenichi},
  title={A 240–270 GHz $4 \times 4$ Bi-Directional Phased-Array Transceiver with On-Chip Half-Wavelength-Spaced Array and Ultra-Low Power Consumption in 65-nm CMOS},
  abstract={This paper presents a 300-GHz-band 2D $4 \times 4$ bi-directional phased-array transceiver with on-chip half-wavelength-spaced array and ultra-low power consumption in 65-nm CMOS. Each element comprises a phased shifter, doubler, injection-locked tripler, sub-harmonic mixer, and on-chip dipole antenna, occupying a compact core area of 0.30 mm2. The power consumption of each element is 26 mW. The $4 \times 4$ phased-array features pitches of 0.49 - and 0.50 -wavelength in the E - and H planes, respectively, with measured main-beam scanning angles of $\pm 32^{\circ}$. The single chip achieves a peak EIRP of −17.1 dBm at 256 GHz.},
  keywords={Arrays;Timing;Displays;Indexes;Indexing;Phased arrays;System-on-chip;Printing;Technology;Bismuth;300-GHz-band;2D;bi-directional;phased-array;transceiver;on-chip;half-wavelength-spaced array;ultra-low power consumption},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577644},
}

@INPROCEEDINGS{11577335,
  author={Lu, Jingguang and Zhou, Zuopu and Jiao, Leming and Zheng, Zijie and Xie, Jiawei and Hao, Weibing and Chand, Umesh and Ranjan, Akhil and Chien, Yu-Chieh and Lim, Khee Yong and Liang, Gengchiau and Gong, Xiao},
  title={First Demonstration of Highly-Scaled Trench-Structured Ferroelectric Capacitive Memory with Record-High Capacitive Memory Window and Integrated ITO Sensing FET},
  abstract={A highly-scaled inversion-type FCM is demonstrated with trench structure on silicon and scaled to minimum $0.02 \mu \mathrm{m}^{2}$. The MFS structure combined with high-aspect-ratio trench enables $\mathrm{a}>10 \times$ capacitance ratio and a record-high capacitance difference of $\sim 19 \mu \mathrm{F} / \text{cm}^{2}$. Integrating an ITO sensing FET with FCM, for the first time, we experimentally demonstrate the sensing of individual highly scaled FCM, validating the scalability of this emerging memory.},
  keywords={Capacitance;Memory;Voltage;Displays;Indexes;Indexing;Silicon;Polarization;Technology;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577335},
}

@INPROCEEDINGS{11577498,
  author={Li, Shengman and Petty, Mary Vaughan and Safron, Nathaniel and Wei, Aslan and Natani, Shreyam and Zhong, Donglai and Lee, Sang Young and Wu, Aylee A and Bandaru, Prabhakar and Kummel, Andrew and Radu, Iuliana and Pitner, Gregory and Mitra, Subhasish and Wong, H.-S. Philip},
  title={10-nm-Gate-Length Nanosheet CNFET with Self-Aligned Extension Doping for Ambipolar Leakage Suppression},
  abstract={In this work, we demonstrate a self-aligned nanosheet carbon nanotube FET (CNFET) technology that fundamentally suppresses ambipolar leakage through localized extension doping. Doped extensions between the gate and contacts enable aggressive gate-length scaling down to 10 nm while achieving a high on-current of $1.2 \text{mA} / \mu \mathrm{m}$ and a low off-state current of $10 \text{nA} / \mu \mathrm{m}$ at $V_{\text{DS}}=-0.7 \mathrm{V}$, representing over $10 \times$ leakage reduction compared with prior CNFET reports. Systematic device comparisons reveal that highly doped extensions reduce leakage by $\sim 10 \times$ across both low and high drain bias, mitigate short-channel effects, and maintain high $I_{\max} / I_{\min}$ over more than 5 decades of gate-length scaling. Further, CNT diameter reduction from 1.4 nm to 1.1 nm increases the bandgap, yielding an additional $100 \times$ leakage reduction at $V_{\text{DS}}=-0.7 \mathrm{V}$ and SS of $95 \text{mV} / \text{dec}$.},
  keywords={Doping;Displays;Indexes;Indexing;CNTFETs;Printing;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577498},
}

@INPROCEEDINGS{11577280,
  author={Li, Xiaguang and Yang, Chao and Yang, Shiheng and Du, Sijun and Zeng, Xiaoyang and Chen, Zhiyuan},
  title={A 6.78MHz Fully Integrated Dual-Output Symmetric 1/16-Cycle Regulating Rectifier Achieving 92.57% Efficiency and 3.7 V Voltage Difference},
  abstract={This paper presents a 6.78-MHz fully integrated dual-output symmetric 1/16-cycle regulating rectifier that employs adaptive duty-ratio control and symmetry-based phase scheduling to enable fine-grained intra-cycle regulation with fast transient response and low ripple. In addition, dual-mode regulation, pulse merging, and gate-charge recycling effectively suppress ripple and balance transient performance and overall efficiency. The fabricated chip delivers up to 110 mW with fully integrated output capacitors, achieves a peak receiver efficiency of 92.57%, a maximum output voltage difference of 3.7 V, a 72.5% end-to-end efficiency, and the highest FoM with $>21 \times$ improvement compared to prior work.},
  keywords={Rectifiers;Voltage;Loading;Timing;Technology;Regulation;Transient analysis;Printing;Steady-state},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577280},
}

@INPROCEEDINGS{11577371,
  author={Zhao, Guangshu and Sang, Haoyang and Wang, Chenxi and Wu, Hao and Zhang, Litao and Lin, Ningchao and Ma, Kaixue and Martins, Rui P. and Law, Man-Kay},
  title={A Universal Piezoelectric Energy-Harvesting Interface with Machine Learning-Based Excitation Identification and Cross-Topology MPPT for Diverse Input Vibrations},
  abstract={This work presents the first universal piezoelectric energy harvesting (PEH) interface that achieves machine learning (ML)-based coarse/fine excitation type identification and ML-assisted cross-topology maximum power point tracking (MPPT), capable of selecting the best-matched topology under distinct input excitation types. Moreover, by decomposing prior PEH topologies into a functional control framework, the proposed interface can realize arbitrary PEH topologies. The fabricated interface achieves near-normalized peak output across diverse excitations and a versatility FoM of 7.39, corresponding to a $1.3-2.4 \times$ compared with prior arts.},
  keywords={Topology;Maximum power point trackers;Electric shock;Shock (mechanics);Steady-state;Displays;Indexes;Indexing;Printing;Cams},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577371},
}

@INPROCEEDINGS{11577322,
  author={Ren, Yuqing and Wang, Yuqi and Zhang, Leyu and Song, Wenqing and Blanc, Ludovic and Burg, Andreas},
  title={A $2.35\text{mm}^{2}$ 118.3Gbps 5.14pJ/Bit Dual-Mode LDPC Decoder for 5G/6G},
  abstract={A dual-mode high-throughput LDPC decoder for $5 \mathrm{G} / 6 \mathrm{G}$ is presented. The $2.35 \text{mm}^{2}$ decoder in 16 nm FinFET delivers a peak throughput of 118.3 Gbps with an energy efficiency of $5.14 \text{pJ} /$ bit, supporting up to 10-core parallel 5 G-LDPC decoding as well as spatially-coupled LDPC codes for 6G with code lengths up to 5x of the longest 5G-NR standard codes. Compared with the state-of-the-art, this work achieves 12.4x in peak throughput, 1.7 x in area efficiency, and 2.3 x in energy efficiency. In 6G mode, it further provides up to 1 dB coding gain advantage over 5G-LDPC codes.},
  keywords={Decoding;Parity check codes;5G mobile communication;Information rates;Throughput;Codes;Architecture;Computer architecture;Optimization;Joining processes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577322},
}

@INPROCEEDINGS{11577605,
  author={Zheng, Haofei and Li, Lingqi and Meng, Wanqing and Tu, Yi-Hsin and Li, Chenyang and Ding, Sujuan and Fu, Ziming and Chen, Mingxi and Chi, Dongzhi and Jin, Chuanhong and Liang, Gengchiau and Li, Lain-Jong and Ang, Kah-Wee},
  title={Wafer-Scale Two-Channel Monolayer-MOS ${}_{2}$ Nanosheet Fets with Record-High $I_{\text {on }}>2 ~\text{mA} / \boldsymbol{\mu} \mathrm{m}$ Enabled by Sub-1 NM Cet High- $\kappa$ Integration},
  abstract={Multi-channel Nanosheet FETs (NSFETs) are the definitive architecture for maximizing drive current $(I_{\text{on}})$ within a scaled device footprint. In this work, we demonstrate the first waferscale (2-inch) two-channel (2-ch) $\text{MoS}_{2}$ NSFETs, enabled by a CMOS-compatible, interfacial-layer-free integration of high-к $\text{HfO}_{\mathrm{x}}$ on monolayer $\text{MoS}_{2}$. An aggressively scaled capacitance equivalent thickness (CET) of 0.71 nm is achieved and the bestperforming device exhibits a record-high $I_{\text{on}}>2 ~\text{mA} / \mu \mathrm{m}$ and a SS of $101 \text{mV} / \text{dec}$ at a channel length of 50 nm.},
  keywords={Displays;Indexes;Indexing;Contacts;Printing;Technology;Dielectrics},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577605},
}

@INPROCEEDINGS{11577451,
  author={Cohen, Guy and Stellari, Franco and Kerns, Peter and Ocola, Leonidas and Bruley, John and Gignac, Lynne and Stanic, Vesna and Lavoie, Christian and Marchack, Nathan and Smith, Joshua T. and Narayanan, Vijay and Chen, Ching-Tzu},
  title={Resistivity Scaling of Topological CoSi Wires to Sub-10 nm for Post-Cu Interconnects},
  abstract={We experimentally demonstrate the nanoscale resistivity-scaling behavior of topological conductors using cobalt monosilicide (CoSi) nanowires (NWs) fabricated on 200 mm wafers with CMOS-compatible processes. Both templated near-epitaxial and polycrystalline CoSi NWs are evaluated, with cross-sectional areas down to $35 \text{nm}^{2}(\sim 6 \text{nm}$ diameter). Unlike Cu, which shows a steep resistivity increase below $\sim 20 \text{nm}$ linewidth, templated near-epitaxial CoSi NWs show an exceptional $\sim 80 {\%}$ resistivity reduction when the NW cross-sectional area scales below $\sim 100 \text{nm}^{2}$ as compared to $\mu \mathrm{m}$-scale wires. Furthermore, resistivity of polycrystalline CoSi NWs with random grain orientations also approaches the theoretical CoSi bulk single-crystal resistivity limit when the NW cross-sectional area scales below $\sim 200 \text{nm}^{2}$. These results provide wafer-scale validation that topological conductors can enable interconnect scaling beyond Cu.},
  keywords={Conductivity;Printing;Silicon;Copper;Surfaces;Conductors;Displays;Indexes;Indexing;Annealing;topological conductors;cobalt monosilicide;interconnect scaling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577451},
}

@INPROCEEDINGS{11577269,
  author={Penny, Chris and Frougier, Julien and Antonovich, Belle and Carr, Chris and Chan, Victor and Chen, Zheng and Halle, Scott and Howe, Teresa and Jog, Atharv and Kim, Jeong and Latham, Nick and Lee, Joe and Matham, Shravan and Mamidala, Abhinav and Morillo, Jaime and Wehrman, Matt and Seshadri, Indira and Rankin, Jed and Meli, Luciana},
  title={First Demonstration of a Functional Gate-All-Around Nanosheet Cmos Circuit Using Single Exposure High Na Euv Beol Interconnects},
  abstract={We demonstrate BEOL patterning simplification using Single-Exposure (SE) High Numerical Aperture (NA) EUV with Metal-Oxide Resist (MOR), replacing Low NA EUV Self-Aligned Litho-Etch Litho-Etch (SALELE) multipatterning while achieving superior Health of Line electrical yield. Gate-All-Around (GAA) nanosheet Ring Oscillator (RO) CMOS circuit functionality is demonstrated using SE High NA EUV for BEOL interconnect. Compared with the control SALELE wafers, the High NA EUV wafers were able to demonstrate comparable yield and AC performance in RO circuits.},
  keywords={Displays;Indexes;Indexing;Design methodology;Metals},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577269},
}

@INPROCEEDINGS{11577385,
  author={Zeng, Pengyu and Rezaei, Marziyeh and Sturm, Daniel and Nayak, Asha Rashmi and Li, Scott and Moazeni, Sajjad},
  title={A 0.69-pJ/b 4x80-Gb/s MRM-Based Coherent Optical Transmitter with Time-Multiplexed Thermal Tuning},
  abstract={Co-packaged optics (CPO) is a critical technology for scaling bandwidth density in AI compute clusters. To maximize spectral efficiency and minimize the required number of laser lines, we demonstrate a 4-channel coherent optical transmitter using micro-ring modulators (MRMs) capable of $4 \times 80 \text{Gb} / \mathrm{s}$ QAM-4 modulation. Implemented in GlobalFoundries (GF) 45nm monolithic silicon photonics, the SoC achieves a $320 \text{Gb} / \mathrm{s}$ aggregate data rate on a single wavelength. The design incorporates an on-chip PLL, high-speed clock distribution, and a full time-multiplexed thermal tuning digital control loop. Achieving an energy efficiency of $0.69-\text{pJ} / \mathrm{b}$, our approach can be either deployed as a lower power and latency alternative to PAM-4 or scaled up to QAM-16 for higher data rates in future AI fabrics.},
  keywords={Clocks;Modulation;Quadrature amplitude modulation;Printing;Technology;Lasers;Tuning;co-packaged optics;micro-ring modulators;coherent modulation;QAM;silicon photonics},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577385},
}

@INPROCEEDINGS{11577377,
  author={Wang, Jin and Yang, Zhengke and Chen, Yulong and Zhang, Yufu and Li, Haolong and Peng, Ruijie and Kong, Zhen and Li, Jiamin and Li, Yida and Zhou, Feichi and Lin, Longyang and Ran, Liang and Feng, Xinhe and Lyu, Zhichao and Zhao, Liang},
  title={A Scalable Vision-Language-Action Edge Processor with Token Filtering and Hybrid Processing-Near-Memory for 6.7-ms Perception-To-Action Latency in Robot Control},
  abstract={This work presents a scalable Vision-Language-Action (VLA) edge processor for real-time robot control. A SimHashbased temporal token filtering eliminates redundant visualtoken computation across action steps, while a hybrid RRAMSRAM Processing-Near-Memory engine with compression and dynamic orchestration achieves zero external memory access. A 16-chip module in 55 nm achieves $6.7-\text{ms}$ perception-to-action latency (150 Hz) with 12.74 mJ energy, delivering a $1.87-88.45 \times$ latency reduction over prior art and demonstrating end-to-end VLA inference at the edge.},
  keywords={Modeling;Timing;Displays;Indexes;Indexing;Printing;SRAM chips;Real-time systems;Robots;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577377},
}

@INPROCEEDINGS{11577217,
  author={Kumar, Abhishek and Mirfarshbafan, Seyed Hadi and Castañeda, Oscar and Studer, Christoph},
  title={A 39pJ/b 7.3Gbps 1.3mm2 Multi-Subcarrier Massive MU-MIMO-OFDM Detector Exploiting Beamspace Sparsity and Frequency-Domain Correlation in 22FDX},
  abstract={We present the first multi-subcarrier massive multi-user (MU) multiple-input multiple-output (MIMO) orthogonal frequencydivision multiplexing (OFDM) data detector reported in the open literature. By exploiting the channel's beamspace sparsity and frequency-domain (FD) correlation, we achieve up to $3 \times$ area and power reduction. Our design supports $U=8$ user equipments and $B=64$ basestation antennas, computes soft outputs for QPSK to 256-QAM, and processes 16 subcarriers in parallel. The fabricated 22FDX ASIC has a core cell area of $1.3 \text{mm}^{2}$, consumes 286 mW, and delivers a throughput of 7.3 Gbps at 0.8 V core voltage, achieving best-in-class energy efficiency of 39pJ/b.},
  keywords={Architecture;Computer architecture;MIMO;Technology;Detectors;Timing;Design methodology;Application specific integrated circuits;Interpolation;Information rates},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577217},
}

@INPROCEEDINGS{11577520,
  author={Phadke, Omkar and Mulaosmanovic, Halid and Dünkel, Stefan and Beyer, Sven and Sharda, Janak and Yu, Shimeng},
  title={New Insights into Multi-Level Cell Behavior in FeFET: Localization Effect Aware Write-Verify Scheme},
  abstract={Localization of random ferroelectric (FE) domain distribution and interface trap density $(\mathrm{D}_{\text{IT}})$ in the ferroelectric field effect transistor (FeFET) is identified as a new challenge for enabling robust Multi-Level Cell (MLC) operation. FE localization leads to dynamic dependence of $\mathrm{V}_{\text{TH}}$ on the $\mathrm{V}_{\text{DS}}$, leading to read-out errors using the classical notion of utilizing $\mathrm{V}_{\text{TH}}$ distribution as the criteria for MLC. This work presents a new MLC scheme that utilizes the dynamic drive strength of FeFET, featuring a characteristic time constant $\tau$ to discharge the bitline as a more appropriate MLC criteria. Key contributions include: 1) Experimental statistical characterization of scaled FeFET on 28 nm Foundry platform for classical and new MLC schemes; 2) First report of $\mathrm{D}_{\text{IT}}$ localization that exhibits a “crossover” effect in $\mathrm{I}_{\mathrm{D}}-\mathrm{V}_{\mathrm{G}}$ characteristics; 3) Modelling of FE and $\mathrm{D}_{\text{IT}}$ localization; 4) Validation of the new MLC scheme showing minimized errors across a dynamically varying bitline voltage swing.},
  keywords={Location awareness;Modeling;Steady-state;Iron;Timing;Voltage;Printing;Technology;Writing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577520},
}

@INPROCEEDINGS{11577237,
  author={Lee, M. and Kim, D. S. and Shirodkar, S. and Chu, T. T. H. and Narayan, D. M. and Le, D. N. and Jo, M. and Jeong, J. K. and Ahn, Y. and Kim, J. and Ryu, S. W. and Kim, J.},
  title={First Demonstration of Top-Gated Indium Oxynitride (InOn)-FET with Superior Reliability and Contact Properties ($\mathbf{I}_{\text {on }}=\mathbf{1. 2 ~ m A} / \boldsymbol{\mu} \mathbf{m}, \mathbf{L}_{\mathbf{T}}=\mathbf{1 7 ~ n m}, \boldsymbol{\rho}_{\mathbf{c}}=\mathbf{4} \times \mathbf{1 0}^{-\mathbf{8}} \boldsymbol{\Omega} \cdot \mathbf{c m}^{\mathbf{2}}$)},
  abstract={This work presents InN-derived indium oxynitride (InON) as a contact-efficient, reliability-improved In-based oxide channel for back-end-of-line (BEOL)-compatible FETs. Topgated (TG) devices deliver an on-current ($\mathrm{I}_{\text{on}}$) as high as 1.2 $\text{mA} / \mu \mathrm{m}$. With Ni contacts, the devices achieve an ultra-low specific contact resistivity ($\rho_{\mathrm{c}}$) of $4 \times 10^{-8} \Omega \cdot ~\text{cm}^{2}$ (contact resistance, $\mathrm{R}_{\mathrm{c}}=0.015 \Omega \cdot ~\text{cm}$) and a short transfer length ($\mathrm{L}_{\mathrm{T}}$) of 17 nm, enabling potential contact scaling with minimal contact-induced series resistance. The InON devices further exhibit improved threshold voltage ($\mathrm{V}_{\text {th }}$) stability under bias stress compared with $\text{In}_{2} \mathrm{O}_{3}$-based counterparts.},
  keywords={Contacts;Printing;Displays;Indexes;Indexing;Very large scale integration;Human factors;Stress;Personal digital devices;Nickel},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577237},
}

@INPROCEEDINGS{11577626,
  author={Liao, Hong and Yang, Xiaoxu and Chen, Minghao and Li, Yuqian and Qiu, Lei and Mercier, Patrick and Meng, Miao},
  title={A Sub-μW VCO-Based Direct Digitization Front-End with an Auto-Ranging Technique Achieving 1.8 NEF and 182.3 FoMDR for Energy-Efficient Neural Recording},
  abstract={This work presents a sub-$\mu \mathrm{W}$ VCO-based direct-digitization neural recording front-end with an auto-ranging technique, featuring ultra-low power consumption, compact chip area, wide dynamic range (DR), and low input-referred noise (IRN). This front-end achieves high-fidelity neural signal acquisition by employing a low-noise VCO-based quantization core to form a high-resolution quantization window while largeamplitude, linearity-insensitive artifacts can be recorded by seamlessly and dynamically shifting the quantization window via the proposed auto-ranging quantizer. Fabricated in a 65 nm CMOS process with $0.035 \text{mm}^{2}$ active area. The proposed IC achieves 82.2 dB DR and $42 \text{nV} / \text{NHz}$ IRN across a 10 kHz signal bandwidth (BW), while consuming $0.97 \mu \mathrm{W}$ from a 0.8 V supply, resulting in a 1.8 NEF and $182.3 \text{FoM}_{\text{DR}}$.},
  keywords={Quantization (signal);Distance measurement;Medical services;Voltage-controlled oscillators;Printing;Noise;Automatic repeat request;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577626},
}

@INPROCEEDINGS{11577262,
  author={Kirtania, Sharadindu Gopal and Park, Hyeonwoo and Quezada, E. and Zhang, C. and Yu, Shimeng and Khan, Asif and Datta, Suman},
  title={The Thermal Paradox of Oxygen Vacancies: Screening vs. Depolarization Setting the Retention in W-Doped Indium Oxide FEFETs},
  abstract={This study investigates the physical mechanisms governing retention in W-doped indium oxide (IWO) FEFETs. The devices achieve record 7-day real-time retention at 25 ° C and 85 ° C, but exhibit pronounced retention loss in the PRG/LVT state at 125° C. A comparative investigation of MFM and MFSM capacitor test structures isolates the dominant bottleneck as the depolarization field (EDep), which emerges from finite charge screening in the amorphous-oxide semiconductor (AOS) channel and its limited conduction-band density of states (DoS). Temperature-dependent measurements further show that thermally activated electron emission from donor-like oxygen vacancies can initially enhance screening, yet at higher temperature it increases the population of ionized $\mathrm{V}_{\mathrm{O}}{}^{2+}$, strengthens EDep, and accelerates depolarization-driven polarization back-switching. Finally, this work benchmarks state-of-the-art AOS FEFETs using retention, memory window (MW), and current window (CW) metrics, and extracts devicelevel design rules for improving thermal reliability in scaled AOS-based non-volatile memories.},
  keywords={Printing;Temperature;Electrons;FeFETs;Polarization;Switches;Back;Limiting;Technology;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577262},
}

@INPROCEEDINGS{11577531,
  author={Ge, Huanyu and Jia, Haikun and Deng, Wei and Chi, Baoyong},
  title={A 45.3-To-53.9-GHz Circular-Dual-Core Series-Resonance-Harmonic-Extraction VCO Featuring Common-Mode Noise-Diversion Technique Achieving -112.5 dBc/Hz Phase Noise, Average 199.1/203.9 dBc/Hz FoMA/FoMTA and 0.8 dB Variation at 1-MHz Offset},
  abstract={This paper presents a 45.3-to-53.9-GHz series-resonance harmonic-extraction VCO. It utilizes a circular dual-core topology for Q-enhancement and incorporates a commonmode noise-diversion technique for lower phase noise and 1/f3 corner. Fabricated in 65-nm CMOS, the VCO achieves a phase noise of −112.5 to −111.6 dBc/Hz at 1 MHz offset across the 17.3% tuning range. The design yields an average FoMA/FoMTA of 199.1/203.9 dBc/Hz with a variation of less than 0.8 dB, representing the state-of-the-art for oscillators running above 30-GHz with a 2- to- 3-dB lead over prior art.},
  keywords={Noise;Voltage-controlled oscillators;Printing;Frequency;Phase noise},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577531},
}

@INPROCEEDINGS{11577376,
  author={Lee, Jangseop and Hwang, Seungkwon and Kim, Dongmin and Jung, Laeyong and Seo, Yoori and Park, Yu Bin and Park, Byeongjin and Kang, Seongmo and Kim, Yonghun and Lee, Tae Hoon and Hwang, Hyunsang},
  title={Ultra-Low Drift (4 mV/dec.) and Excellent Write Endurance (> 3×1010) in Heterostructure Te-Based Selector-Only Memory (SOM) with 2D WS2 Interlayer},
  abstract={We report a heterostructured Te-based selectoronly memory (SOM) utilizing a $\text{WS}_{2}$ van der Waals interlayer on nanoscale W plugs. By engineering a dangling-bond-free interface, we successfully controlled interface trap dynamics to enable efficient carrier injection. This architecture notably reduced forming voltage and suppressed drift characteristics (4 mV/dec.). Furthermore, the interlayer served as a robust diffusion barrier, enabling enhanced endurance exceeding 1010 cycles. Multiscale simulations clarify the defect-modulated switching mechanism driving this performance enhancement.},
  keywords={Self-organizing feature maps;Writing;Bonding;Memory;Printing;Displays;Indexes;Indexing;Switches;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577376},
}

@INPROCEEDINGS{11577586,
  author={Liao, Fuxi and Zhu, Zhengyong and Yang, Guanhua and Zhang, Xuanming and Liu, Menggan and Chen, Kaifei and Lu, Wendong and Li, Zihan and Mao, Naide and Kang, Bok-Moon and Shi, Jinghong and Jin, Meichen and Liu, Chang and Liang, Jing and Wang, Gui-Lei and Lu, Congyan and Yue, Jinshan and Wang, Lingfei and Wang, Jiawei and Geng, Di and Lu, Nianduan and Zhao, Chao and Nathan, Arokia and Li, Ling and Liu, Ming},
  title={Highly Stackable 3D DRAM of Dual-Gate IGZO 2T0C with Record 3 Bits/Cell and 400s Data Retention},
  abstract={For the first time, we experimentally demonstrated a highly stackable multibit 3D DRAM with dual-gate IGZO 2T0C. Contrary to typical 3D vertical BL 1T1C, the applicable current sensing for this 2T0C helps to eliminate BL-to-BL coupling issue, thus enable exploitation of vertical WL to reduce fabrication challenge in 3D integration. Moreover, by using RWL as gate instead of S/D control, this dual-gate 2T0C offers more reliable read control and avoid current accumulation in RWL (IR drop issue) as encountered in single-gate 2T0C. The fabricated dual-gate read transistor in all 4-tier cells exhibit high Ion of $12 \mu \mathrm{A} / \mu \mathrm{m} {@} \mathrm{V}_{\text{TH}}+1 \mathrm{V}$ and low SS of $102 \text{mV} / \text{dec}$. Excellent device stability of 80 mV PBTI and −30 mV NBTI are obtained at 85 °C. First multibit 3D DRAM is demonstrated with record 3 bits/cell, as well as long data retention (400s) and high write speed (10 ns). This work paves the forward way toward high-density and low-power 3D DRAM application.},
  keywords={DRAM chips;Displays;Indexes;Indexing;Cells (biology);Current;Printing;Timing;Tin;Fabrication},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577586},
}

@INPROCEEDINGS{11577270,
  author={Martin, S. and Jahan, C. and Blanc, R. and Persson, G. and Grimaud, F. and Louro, M. and Hosier, L. and Giovannelli, N. and Monniez, T. and Boniface, G. and Glorieux, O. and Boixaderas, C. and Roman, A. and Oujanba, M. and Bedjaoui, M. and Mercier, J. and Minoret, S. and Euvrard, C. and Sturm, J. and Candegabe, C. and Kerdiles, S. and Comboroure, C. and Guyez, E. and Pocas, S. and Ly, D. and Martinie, S. and Beilliard, Y. and Pares, G. and Bernard-Granger, F. and Coignus, J. and Bernier, N. and Billoint, O. and Andrieu, F. and Grenouillet, L.},
  title={Engineering 3D HZO Ferroelectric Capacitors to Scale Down 22nm Embedded FeRAM},
  abstract={This paper demonstrates 22nm FeRAM arrays featuring for the first time at this node 3D HZO ferroelectric capacitors (FeCap), BEOL-integrated with 2 different schemes. Array functionality with gaussian bit distributions is reported down to $0.047 \mu \mathrm{m}^{2}$ 1T-1C bitcell at 1.3V with bitcells featuring a logic transistor and a $0.0078 \mu \mathrm{m}^{2}$ footprint 3D FeCap with an aspect ratio (AR) of about $4: 1$. To improve further both MW and density, 17:1 AR 7nm HZO 3D FeCaps with $0.0028 \mu \mathrm{m}^{2}$ footprint are demonstrated with measured remanent polarization 2.Pr of $1100 \mu \mathrm{C} / \text{cm}^{2}$ (normalized by footprint) at 1.5V and wake-up free behavior in agreement with a $\sim 80 {\%}$ orthorhombic phase fraction as measured by precession electron diffraction (PED). These results pave the way to ultradense embedded FeRAM at nodes below 22nm.},
  keywords={Displays;Indexes;Indexing;Arrays;Argon;Printing;Voltage;Technology;Tin;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577270},
}

@INPROCEEDINGS{11577229,
  author={Jain, Vikram and Genc, Hasan Nazim and Hooper, Coleman and Nguyen, Minh and Kumar, Rahul and Kumar, Rohan and Wang, Di and Anderson, Kevin and Chi, Yufeng and Dong, Shengjun Kris and Nikiforov, Dima and Zhou, Bob and Nikolić, Borivoje and Shao, Yakun Sophia},
  title={Sirius: A Dual-Chiplet System for Multimodal Embodied AI with Heterogeneous RVV Cores, Dense and Sparse Accelerators},
  abstract={Sirius is a dual-chiplet system targeting multimodal embodied AI on resource-constrained platforms. It integrates heterogeneous RISC-V Vector (RVV) cores with dense and sparse accelerators to efficiently execute diverse workloads, including transformers, vision backbones, and robotics pipelines. Sirius addresses deployment challenges through three innovations: (1) support for diverse non-uniform quantization schemes via programmable LUTs and outlieraware dense and sparse (D+S) decomposition, (2) a logically shared, physically distributed scratchpad memory system enabling kernel fusion and heterogeneous streaming, and (3) chiplet-based disaggregation using a custom interconnect. Fabricated in Intel16, Sirius delivers up to 2.24 TFLOPS/W for dense GeMM, 7.11 TFLOPS/W for SpMV, and achieves end-to-end 16 tokens/sec at 23 mJ/token on Qwen2.5-0.5B SLM, and 0.97 TFLOPS/W for robotics perception.},
  keywords={Indexes;Indexing;Displays;Single-photon avalanche diodes;Printing;Table lookup;Memory},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577229},
}

@INPROCEEDINGS{11577651,
  author={Chen, Wangbo and Lopez-Ruiz, Jose R and McCommons, Patrick and Leonardo, Noah and Becker, Jill and Park, Sung-Yun and Flynn, Michael P and Yoon, Euisik},
  title={An 83.5dB DR, ${74}\text{pA}_{\text{RMS}}$ Neurotransmitter Sensor Interface with Drift Correction},
  abstract={State-of-the-art neurotransmitter sensors use fast-scan cyclic-voltammetry (FSCV) to achieve high sensitivity and selectivity. The main challenge in FSCV is the need for high dynamic range (DR) and a low noise floor. We address this challenge by introducing a dynamic template-tracking sensor interface which takes advantage of the quasi-repetitive characteristics in non-faradaic (NF) currents. The prototype has a DR of 83.5 dB, a $73.8 \text{pA}_{\text{RMS}}$ noise floor, and is resilient to sensor drift. This work reports the highest DR and maintains simplicity of a one-working-electrode/channel setup.},
  keywords={Current;Image sensors;Noise;Printing;Electrodes;Displays;Distance measurement;Indexes;Indexing;Sensors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577651},
}

@INPROCEEDINGS{11577499,
  author={Xu, Yichen and Wan, Rentao and Li, Mao and Wang, Zhaoqing and Kim, Suhwan and Krihshnamurthy, Ram K. and Zhang, Xin and Seok, Mingoo},
  title={A 1-to-1050-mA DLDO with Rising-Edge Computational Control and Load-Dependent Feedback Achieving 46-mV/ns DVS Rate and 0.15-Ps FoM},
  abstract={This brief presents a $1 \text{mA}-1050 \text{mA}$ computational DLDO for modern SoCs that achieves fast load transient, high efficiency, and fast DVS. A rising-edge computation enables accurate load prediction with only $1 \text{nF} \mathrm{C}_{\text{out}}$, while a load-dependent feedback maintains low ripple across a wide load range. Reusing the computation hardware for DVS improves the DVS rate by $4.6 \times$. Fabricated in $28-\text{nm}$ CMOS, the DLDO achieves 0.15 ps FoM, $46.2 \text{mV} / \text{ns}$ DVS, $<17 \text{mV}$ ripple, and 99.98% peak current efficiency.},
  keywords={Loading;Printing;Timing;Current;Transient analysis;Voltage;Table lookup;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577499},
}

@INPROCEEDINGS{11577296,
  author={Wiedemer, J. A. and Bennett, D. and Clinton, E. and Huang, C.-Y. and Galatage, R. and Qayyum, M. F. and Gudmundsson, V. and Ryu, H. and Chebiam, R. V. and Thomas, N. K. and Buragohain, P. and Morrow, P. and Agrawal, A. and Michaelos, T. and Nahm, R. and Briggs, N. and Kohen, D. and Vyatskikh, A. and Goodwin, S. and Ghose, S. and Zussblatt, N. and Huang, Y. and Unluer, D. and Beasley, M. and Tan, J. M. and Tan, L. H. and Elkins, M. and Cekli, S. and Hermann, R. and Shoer, L. and Qader, M. Abd El and Desai, U. and Edwards, T. and Prasad, P. and Armstrong, J. and Ghosh, M. and Liao, Y.-A. and Kapinus, V. and Dixit, D. and Tran, P. and Cheong, K. L. and Fatehi, A. and Oni, A. A. and Franco, N. and Krist, B. J. and Shi, Q. and Agrawal, S. and Krishnamoorthy, A. and Wu, T.-H. and Sridhar, S. and Leon, A. S. and Metz, M. V. and Torres, J. and Sung, S.-H. and Dewey, G. and Schenker, R. and Kobrinsky, M. J. and Radosavljević, M.},
  title={Demonstration of CFET Inverters on Si (110) with 2X2 RibbonFETs at 45nm Gate Pitch with PowerVia and Direct Backside Contacts},
  abstract={Complimentary Field-Effect Transistor (CFET) technology is considered a key path to continuing scaling in the semiconductor industry beyond RibbonFET. In this work, we demonstrate fully integrated monolithic CFET inverters at contacted poly pitch (CPP) of 45 nm. Stacked RibbonFET transistors on Si (110) substrate with 2 NMOS and 2 PMOS ribbons (2X2) are integrated with backside power via, direct backside contacts (BSCON), and an epi-epi via (EEV) intraconnect. A vertical nanoribbon depopulation process is demonstrated to eliminate the effects of parasitic transistors without requiring a splitgate process. Additionally, we demonstrate hybrid PMOS Si (110) on NMOS Si (100) stack with middle dielectric isolation (MDI) less than 10 nm to enable power, performance, and area (PPA) improvement. Cell PPA analysis for $2 \times 2$ ribbon stack shows significant frequency benefit compared to $1 \times 1$.},
  keywords={Displays;Indexes;Indexing;Silicon;Printing;Stacking;Technology;Transmission electron microscopy;Transistors;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577296},
}

@INPROCEEDINGS{11577593,
  author={Li, Xiaopeng and Wu, Chaoming and Trinh, Duy Hieu and Dou, Xiaoyu and Wu, Jixuan and Shi, Wei and Li, Xinming and Ji, Ning and Zhang, Zhilun and Zhang, Dong and Chen, Jiezhi and Gong, Xiao},
  title={Record-Thin $(\sim 2 ~\text{nm})$ Wakeup-Free Hzo Ferroelectric Mfm Via Atomic Layer Etching (Ale): Grain Size Enlargement and Ferroelectric Phase Engineering},
  abstract={In this work, we report the world's thinnest $2 ~\text{nm} \text{Hf}_{\mathrm{x}} \text{Zr}_{1-\mathrm{x}} \mathrm{O}_{2}$ (HZO) metal-ferroelectric-metal (MFM) capacitor, achieving $2 \operatorname{Pr}$ of $\sim 20 \mu \mathrm{C} / \text{cm}^{2}$ at 0.65 V, wakeup-free operation, ultra-low leakage, and a record-high $\mathrm{E}_{\text{BD}}$ of $\sim 11.3 \text{MV} / \text{cm}$. This breakthrough is enabled by a series of process innovations, highlighted as follows: (1) A novel Atomic Layer Etching (ALE)-based grain size enlargement and ferroelectric (FE) phase engineering approach is proposed and demonstrated, overcoming the physically-intrinsic grain size limitation in ultra-thin (sub-2.5 nm) HZO films. (2) A novel Fluorine Treatment (F treat.) is introduced to repair oxygen vacancies (Vo) for further performance enhancement. This work pushes the frontier of FE memory scaling and significantly enhances the competitiveness of FE memory as the mainstream next-generation ultra-low power memories.},
  keywords={Printing;Iron;Grain size;Films;Motion pictures;Very large scale integration;Displays;Indexes;Indexing;Switches},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577593},
}

@INPROCEEDINGS{11577260,
  author={Song, Suyang and Jang, Taekwang},
  title={Class-D LC Oscillator-Based Capacitively Isolated DC-DC Converters with False-Mode Prevention Technique Achieving 91.3% and 43.3% Peak-Efficiencies},
  abstract={This paper presents two capacitively isolated DC-DC converters that significantly improve efficiency compared to the state of the art (SoTA). A highly integrated version (IC+ offchip LC) achieves 91.3% efficiency (23% higher than SoTA) and 9.8 mA/mm2 current density. A fully integrated version achieves 43.3% efficiency (36.3% higher than SoTA) and 61 mA/mm2 current density. They employ Class-D oscillators as both inverters and rectifiers to minimize switching loss. A charge-injection pair with PLL corrects false-mode oscillation caused by flying inductors and helps stabilize the converter in heavy load conditions.},
  keywords={Current;Inductors;Oscillators;Capacitors;Printing;Converters;Switches;Loading},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577260},
}

@INPROCEEDINGS{11577447,
  author={O'Toole, Martin and DePoortere, Etienne and Chiou, Tsann-Bim and Tabery, Cyrus and Decoster, Stefan and Carballo, Victor M.Blanco and Layunta, Alejandro Berdonces and DeWachter, Bart and Das, Shubhankar and Camerotto, Elisabeth and Chen, Zhengtao and Hellin, David and De Silva, Anuja and Jurczak, Gosia},
  title={High Yield Sub 20 nm Ru Direct Metal Etch Enabled by Single-Exposure 0.55NA EUV and dry MOR Technology},
  abstract={To enable continued BEOL scaling below 20 nm, Ru Direct Metal Etch (DME) integration has been proposed as an alternative to Cu damascene due to its lower resistivity. However, at these extremely aggressive pitches, the demands on lithography and patterning yield become increasingly critical. In this work, we demonstrate a simplified singleexposure 0.55 NA EUV dark-field patterning approach using metal-oxide dry photo resist (MOR) and dry development for Ru DME. Compared to multi-patterning schemes, the proposed flow eliminates pitch walk and reduces hard-mask complexity. Electrical yield is evaluated using large-area serpentine and fork structures for sensitive detection of line breaks and bridges. Under optimized conditions, dies show no electrically detectable line breaks or bridges for 20 nm pitch structures. The aggregate evaluated line length exceeds 1 m per die, and preliminary results indicate feasibility at 18 nm pitch. These results establish a viable path toward HVM (high-volume manufacturing) of sub-20 nm Ru DME interconnects.},
  keywords={Dies;Indexes;Indexing;Displays;Printing;Resistance;Design methodology;Aluminum;Metals;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577447},
}

@INPROCEEDINGS{11577596,
  author={Li, Xinming and Ji, Ning and Jiao, Leming and Tong, Yi and Liu, Gan and Wu, Chaoming and Hieu, Trinh Duy and Zhang, Zhilun and Sun, Jiawei and Ni, Kai and Liang, Gengchiau and Sun, Chen and Zhang, Dong and Gong, Xiao},
  title={BEOL-Compatible Oxide Semiconductor Twin-Gate FeFET Achieving a Record-High Memory Window of 25.4 V and a Near-Ideal Memory Window-to-Operation Voltage Ratio of 1.88},
  abstract={We report, for the first time, an innovative twin-gate (TG) architecture combined with a meticulously designed interlayer demonstrated in BEOL-compatible oxide-semiconductor FeFETs (OS-FeFETs) with channel length $\left(L_{\text{CH}}\right)$ as small as 30 nm. This design introduces multiple degrees of freedom in optimizing voltage distribution across the gate stack, leading to record-breaking performance. Specifically, a record-high memory window (MW) of 25.4 V among all reported FeFETs is achieved at an operation voltage ($V_{\text{op}}$) of 13.5 V, corresponding to a record-high $\text{MW}/V_{\text{op}}$ ratio of 1.88 that approaches the theoretical limit. Moreover, our devices maintain MW exceeding 15 V after 107 cycles, effectively alleviating the long-standing trade-off between large MW and endurance in FeFETs.},
  keywords={Printing;Voltage;Memory;Displays;Indexes;Indexing;Very large scale integration;Aluminum;Windows;FeFETs},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577596},
}

@INPROCEEDINGS{11577502,
  author={Feng, Yang and Wang, Xiaolin and He, Yaoyu and Lu, Jingguang and Jiao, Leming and Li, Hanjie and Xie, Jiawei and Zhang, Zhilun and Zhang, Dong and Li, Xiaopeng and Shi, Wei and Zheng, Zijie and Sun, Chen and Chand, Umesh and Ranjan, Akhil and Yu-Chieh, Chien and Wu, Jixuan and Chen, Jiezhi and Gong, Xiao},
  title={Record $2 P_{r}$ (>38 μC/cm2 at 0.5 V,>28 μC/cm2 at 0.4 V) of 3D MFM Capacitors Enabled by 3 Nm HZO and ALD-TiN Orientation Engineering},
  abstract={For the first time, we propose and demonstrate orientation (texture) engineering of ALD-TiN electrodes as an effective approach to enhance the remnant polarization ($2 P_{\mathrm{r}}$) in ultra-thin 3 nm HZO layers. By optimizing the N/(Ti+N) ratio during ALD-TiN deposition to increase the fraction of (111)-oriented TiN, we promote ferroelectricity in HZO without introducing additional process steps or integration complexity. As a result, our planar capacitors with a fully ALD-deposited TiN/HZO/TiN stack exhibit $2 P_{\mathrm{r}}>36 \mu \mathrm{C} / \text{cm}^{2}$ at an ultra-low operation voltage ($V_{\text {op }}$) of 0.5 V. Compatible with 3D structures, this approach is successfully extended to the first experimentally demonstrated 3 nm HZO-based 3D ferroelectric MFM capacitors. The devices deliver a $2 P_{\mathrm{r}}>38 \mu \mathrm{C} / \text{cm}^{2}$ at $V_{\text {op }}$ of 0.5 V, setting a new benchmark for 3D MFM capacitors. Importantly, a record-high $2 P_{\mathrm{r}} / V_{\text {op }}$ ratio exceeding 75 is achieved in HZO layers with a physical thickness of $\leq 3 ~\text{nm}$. Even at a reduced $V_{\text {op }}$ of 0.4 V, the devices continue to meet the IRDS $2 P_{\mathrm{r}}$ target $\left(\geq 26.5 \mu \mathrm{C} / \text{cm}^{2}\right)$. This work establishes an ultra-low voltage route toward high-density 3D ferroelectric memory technologies.},
  keywords={Tin;Capacitors;Displays;Indexes;Indexing;Electrodes;Titanium;Crystallization;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577502},
}

@INPROCEEDINGS{11577493,
  author={Bizindavyi, J. and Popovici, M.I. and Demir, E.C. and Maqsood, W. and Subramanian, S. and Kim, G. and Pavel, A. and Ronchi, N. and Belmonte, A. and Van Houdt, J.},
  title={Interfacial Engineering of Scaled HZO in 3D-Trench BEOL-Compatible FeCAPs for High Endurance (≥1013 cy.) and 2 PR(>40 μ C/cm2) at Low (≥1.3 V) Operating Bias},
  abstract={Scaling the operating bias (Vop) of ferroelectric capacitors (FeCAPs) without degrading the remnant polarization 2 PR is a critical challenge, as it is increasingly difficult to crystallize and stabilize the orthorhombic (o) phase when scaling hafnium zirconium oxide (HZO). In this work, we demonstrate 300 mm 3D-trench BEOL-compatible FeCAPs with excellent 2 PR($>40 \mu \mathrm{C}/\text{cm}^{2}$) and endurance (≥ 1 e 13 cy.) at low VOP(1.3 V) in scaled (5 nm) HZO by seed interfacial engineering. We show that this is achieved through an effective reduction of the crystallite nucleation barriers during HZO deposition on the seed layer, enabling efficient crystallization and transition of non-FE phases into the FE o-phase.},
  keywords={Crystallization;Seeds (agriculture);Printing;Iron;Very large scale integration;Displays;Indexes;Indexing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577493},
}

@INPROCEEDINGS{11577334,
  author={Sun, Lei and Gao, Tingting and Xu, Lin and Wang, Kai and Banerjee, Kaustav and Chai, Yang and Li, Lain-Jong and Li, Xuefei},
  title={First Demonstration of CVD Monolayer $\text{WSe}^{2}$ PFETs with Ultra-Short Channel Length of 16 nm: Achieving Record $\mathrm{I}_{\text{on}}$ of $1532 \mu \mathrm{A} / \mu \mathrm{m}$ at $\mathrm{V}_{\text{ds}}=-1 \mathrm{V}$ and Ballistic Efficiency of 81%},
  abstract={In this work, we report an oxygen p-doping and full contact structure to reduce the contact resistance $(\mathrm{R}_{\mathrm{c}})$ of monolayer p-type tungsten diselenide $(\text{WSe}_{2})$ and demonstrate high-performance ptype WSe ${ }_{2}$ field-effect transistors (FETs) with a scaled channel length $\left(\mathrm{L}_{\text{ch}}\right)$ of 16 nm. The controllable oxygen doping and the full contact structure greatly increase the contact quality. The co-optimized $\mathrm{R}_{\mathrm{c}}$ is as low as $352 \Omega \cdot \mu \mathrm{m}$ at 4.2 K, which is ∼two times lower than that of the control sample with top contact. Consequently, $16-\text{nm}$-channel $\text{WSe}_{2}$ pFETs deliver a record saturation current of $1532 \mu \mathrm{A} / \mu \mathrm{m}$ at a drain voltage of −1.0 V and a ballistic ratio of 81% at room temperature. This work presents a major breakthrough in p-type twodimensional (2D) transistors in terms of contact optimization and device performance, filling the research gap in 2D p-type transistors.},
  keywords={Contacts;Printing;Transistors;Doping;Current;Oxygen;Technology;Temperature;Very large scale integration;Displays},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577334},
}

@INPROCEEDINGS{11577418,
  author={Arimura, H. and Lukose, L. and Stiers, J. and Brus, S. and Franco, J. and Lai, J. G. and Chroud, M. Ben and Cavalcante, C. and Chiarella, T. and Vaesen, I. and Conard, T. and Bejide, M. and Mitard, J. and Kim, M. S. and Demuynck, S. and Lima, L. P. B. and Biesemans, S. and Horiguchi, N.},
  title={Dipole Material-Independent Carrier Mobility in Dipole-First nMOS Gate Stack and Introduction of Multi-Vt Patterning-Tolerant Dipole-Middle Integration for NS/CFET},
  abstract={We report on an evaluation of dipole-first nMOS gate stack, and a new dipole multi-Vt gate stack scheme, called dipole-middle. On planar RMG nFET using dipole-first gate stack, we find a strong, shifter material- and stack-independent correlation among Dit, carrier mobility and Vtlin, indicating that mobility cannot be maintained unless Tinv is increased. Moreover, the shifter patterning on SiO2 IL introduces damage in the dipole-first scheme. Thus, a novel dipole-middle scheme has been introduced, which protects IL during the patterning, while allowing to reduce drive-in thermal budget. EWF/Vt reduction of MOSCAP/single nanosheet (NS) nFET are demonstrated with LaOx dipole-middle stack using low temperature lock-in anneal. This could provide a large benefit in dual dipole integration for multi-Vt CFET devices.},
  keywords={Stacking;Displays;Indexes;Indexing;Annealing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577418},
}

@INPROCEEDINGS{11577647,
  author={Ko, Minkyu and Joo, Bomin and Kang, Byeonggon and Wi, Unbok and Kim, Jieun and Lee, Dalhee and Kim, Changbeom and Kim, Hayoung and Baek, Sanghoon and Kong, Bai-Sun},
  title={A 20T Low-Power Single-Phase Full-Static Contention-Free Flip-Flop with Interlatch Transistor Sharing},
  abstract={This paper proposes an area-efficient single-phase contention-free flip-flop (FF) with inter-latch transistor sharing. The flip-flop reduces the area by reconfiguring the primary and secondary latches of $\mathrm{C}^{2}$ MOS FF to share transistors. It has lower DQ latency due to a shorter setup time, resulting from fewer logic stages in the input setup path. It can also provide robust operation with a static contention-free structure. The proposed FF is fabricated in a $28-\text{nm}$ process. The measurement results show that the proposed FF achieves reductions of up to 23.3 % and 17.7 % in layout area and DQ latency, respectively. In terms of power-delay-area product (PDAP), the proposed FF achieves up to 35.2 % improvement among low-power FFs. It can also ensure reliable operation at supply voltages as low as 0.3 V, thanks to its fully static contention-free operation.},
  keywords={Printing;Displays;Indexes;Indexing;Latches;Transistors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577647},
}

@INPROCEEDINGS{11577365,
  author={Kamioka, Takefumi and Nabatame, Toshihide and Matsukawa, Hiroyuki and Kawanago, Takamasa and Morita, Yukinori and Toprasertpong, Kasidit and Mitani, Yuichiro and Onaya, Takashi and Fukata, Naoki and Jevasuwan, Wipakorn and Tsukagoshi, Kazuhito and Hoshii, Takuya and Tamura, Atsushi and Kita, Koji and Okada, Naoya and Manabe, Kenzou and Mizubayashi, Wataru and Ota, Hiroyuki and Matsukawa, Takashi and Migita, Shinji.},
  title={Mitigating Intrinsic Fixed-Charge-Induced $\mathrm{V}_{\text{f b}}$ Fluctuation Using a “Neutral $\text{TiO}_{2}$ Dipole” Layer},
  abstract={Conventional dipole engineering with $\text{La}_{2} \mathrm{O}_{3}$ and $\text{Al}_{2} \mathrm{O}_{3}$ enables $V_{\text{th}}$ modulation but suffers from increased fixed charges and limited controllability of small $\mathrm{V}_{\text{fb}}$ shifts, particularly when sub-monolayer dipole layers form non-uniform distributions. This study first demonstrates that these intrinsic fixed charges in metal-oxide/ $\text{SiO}_{2}$ stacks lead to $\mathrm{V}_{\text{fb}}$ variability-not previously recognized as a major source -, which leads to hinder precise $\mathrm{V}_{\text{th}}$ tuning. In this work, we introduce a “neutral dipole” (ND) concept based on $\text{TiO}_{2}$, which produces no measurable dipole-induced $\mathrm{V}_{\text{fb}}$ shift on $\text{SiO}_{2}$. When combined with $\text{La}_{2} \mathrm{O}_{3}$ or $\text{Al}_{2} \mathrm{O}_{3}$, the resulting mixed dipole layers (LTO/ATO) provide small, well-controlled $\mathrm{V}_{\text{fb}}$ modulation with minimal CET penalty. The ND approach also suppresses device-to-device $\mathrm{V}_{\text{fb}}$ fluctuation. These findings show that ND engineering effectively addresses intrinsic fixed-charge issues and enables more precise $\mathrm{V}_{\text{th}}$ control for future transistor technologies.},
  keywords={Displays;Indexes;Indexing;Aluminum;Fluctuations;High-k dielectric materials;Technology;Very large scale integration;high-k gate stack;dipole;fixed charge;local potential fluctuation;statistical variation},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577365},
}

@INPROCEEDINGS{11577556,
  author={Gierlach, Adam and Lee, Hyemin S. and Yildirim, Deniz Umut and Traverso, Giovanni and Chandrakasan, Anantha P.},
  title={GMINI: Gut Modulating Neural Interface Chip for Closed-Loop Non-Invasive Therapies},
  abstract={Current ingestible devices are limited by high power usage and slow sensor readouts, limiting awareness and functionality. Our Gut Modulating Neural Interface chip known as GMINI leverages gastric neural signals to provide faster, more effective therapies such as electrical stimulation of the gut in one package - with an 8 channel neural recorder, adaptively duty cycling slow wave tracker, behavior detection ML accelerator, and programmable current stimulator. With real-time adaptive thresholding, we achieve a 48% improvement in tracking the slow wave period, enabling adaptive duty cycling and more effective electrical stimulation therapy synchronized with the gut. Our gastric signaloptimized CNN accelerator consumes the lowest energy ($0.266 \mu \mathrm{J} /$ class) among comparable workloads to efficiently determine patient behaviors. This enables ingestible devices to stay active longer and trigger intelligently depending on the patient's needs.},
  keywords={Printing;Technology;Modeling},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577556},
}

@INPROCEEDINGS{11577231,
  author={Xu, Wenting and Wang, Jinfan and Lu, Li and Lin, Feng and Zhang, Yuzhen and Huang, Tingrui and Wu, Wangran and Shi, Runxiao and Sun, Weifeng},
  title={An Upper-Tier ESD Protection Scheme Using Parallel-Electrode ITO TFTs for Monolithic-3D Heterogeneous Integration Achieving >3000V HBM Tolerance},
  abstract={A monolithic 3D (M3D) heterogeneous integration architecture with three stacked tiers is presented, integrating bottom-tier Si SRAM, middle-tier IGZO DRAM, and an upper-tier ITO thin-film transistor (TFT)-based electrostatic discharge (ESD) protection layer. A parallel-electrode ITO TFT structure is introduced to enhance voltage uniformity under ESD stress, increasing the breakdown current from 0.6 A to 1.38 A under transmission-line-pulse (TLP) testing. Based on the ESD-hardened devices, an upper-tier diode-connected TFT ESD scheme protects underlying silicon transistors, achieving $>3000 \mathrm{V}$ human-body-model (HBM) tolerance. This performance satisfies industrial Class 2 ESD requirements while eliminating silicon area overhead.},
  keywords={Thin film transistors;Electrostatic discharge protection;Electrostatic discharges;Silicon;Printing;Human factors;Stress;Displays;Indexes;Indexing;M3D;ESD protection;TFT;TLP;HBM},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577231},
}

@INPROCEEDINGS{11577400,
  author={Xu, Dongfan and Gu, Haiyun and Tang, Minzhe and Liu, Yuxuan and Ren, Ziyuan and Chen, Yilun and Fan, Minghao and Li, Duo and Li, Zheng and Zhang, Yi and Zhang, Daxu and Liu, Zezheng and Wang, Chun and Kato, Sena and Yamazaki, Yudai and Sakai, Hiroyuki and Zhang, Yuncheng and Kunihiro, Kazuaki and Okada, Kenichi},
  title={A Reconfigurable 24−28GHz Time-Division Full-Duplex Transceiver with 59dB Self-Interference Rejection Over 400MHz},
  abstract={This work presents a reconfigurable $24-28 \text{GHz}$ timedivision (TD) full-duplex (FD) transceiver in 65nm CMOS. It supports at least 400MHz bandwidth with up to 59dB selfinterference (SI) rejection, achieved by isolating TX/RX in time domain without an extra SI cancellation (SIC) path. The proposed architecture overcomes SIC bandwidth limits and allows switching to half-duplex (HD). The OTA measurements verify 400MHz 64QAM OFDM FD and HD operations, offering a low-complexity mm-Wave FD solution.},
  keywords={Silicon;Displays;Indexes;Indexing;Silicon carbide;Printing;Transceivers;Timing;Gain;Switches;time-division;full-duplex;SI rejection},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577400},
}

@INPROCEEDINGS{11577560,
  author={Chong, Euhan and Pike, Jacob and Goh, Tae Young and Nikjah, Reza and Berton, David and Madeira, Paul and Akbari, Masoume and Bourget, Christian and Tran, Vinh Tuan and Nguyen, Tung and Aouini, Sadok and Gharan, Shahab Oveis and Ben-Hamida, Naim},
  title={A 1.39pJ/bit 224Gb/s PAM-4 Long-Reach SerDes Receiver in 3nm FinFET},
  abstract={This work presents a $1.39 \text{pJ} / \text{bit} 224 \text{Gb} / \mathrm{s}$ PAM-4 DSP-based Serdes receiver fabricated in 3 nm FinFET technology, achieving a BER of $3 \mathrm{e}-7$ over a 38 dB channel.},
  keywords={Clocks;Indexes;Indexing;Displays;Printing;Ranking (statistics);Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577560},
}

@INPROCEEDINGS{11577638,
  author={Lee, Mingyu and Kim, Hyungju and Lee, Wonseob and Song, Hyeonwon and Moon, Seong-Mo and Chang, Dongpil and Hong, Songcheol and Lee, Seungchan and Park, Jinseok},
  title={An Ultra-Compact 4-Element 4-Beam Q-Band Multibeamformer IC with IQ Pre-Weighted Phase Shifter for VLEO SATCOM},
  abstract={This work proposes a compact Q-band TX/RX-configurable multibeamformer IC for very low Earth orbit(VLEO) SATCOM. The proposed IQ pre-weighted multi-beam phase shifter (PS) and small cell power dividers provide a compact chip area and low coupling errors. Additionally, the proposed analog linearizer compensates for both AM-AM and AM-PM distortions with a low insertion loss. The IC is fabricated using 65 nm CMOS process, achieving low area/element/beam of 0.48 mm2. Across all 16 channels, measured P1 dB exceeds 18.2 dBm with AM-PM distortion below 2.8°. The measured RMS phase and gain errors are below 2° and 0.3 dB, respectively.},
  keywords={Beams;Gain;Integrated circuits;Joining processes;Printing;Couplings;Displays;Indexes;Indexing;Power dividers},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577638},
}

@INPROCEEDINGS{11577561,
  author={Han, Sangkuk and Choi, Wonjae and Chung, Jaewon and Jang, Haesoo and Park, Kyungwook and Lim, Sangmyun and Park, Soyoung and Jeong, Sangwoo and Kim, Hanbyul and Park, Yong Joo and Ahn, Jinho and Choi, Changhwan},
  title={Effective Dipole Strength Modulation Using Imprinted Gadolinium Dipole (IGD) Layer to Achieve Fine $\mathrm{V}_{\mathrm{t}}$ Tunability for Low Thermal Budget CFET Devices},
  abstract={We investigate dipole-first (DF) gate stacks using rare-earth oxides (REOs) to enable scalable multi-Vt options for advanced logic CFET devices. $\text{LaO}_{\mathrm{x}}$ and $\text{GdO}_{\mathrm{x}}$ DF stacks are systematically compared in terms of dipole strength, interface quality, trap charge density, and gate leakage. $\text{LaO}_{\mathrm{x}}$ exhibits strong dipole behavior, resulting in a $\mathrm{V}_{\mathrm{t}}$ reduction of $\sim 155 \text{mV} /$ cycle. $\text{GdO}_{\mathrm{x}}$ shows a moderate dipole effect with a negative Vt shift of $\sim 80 \text{mV} /$ cycle. However, the 1 cycledALD of $\text{GdO}_{\mathrm{x}}$ induced an excessively strong dipole, leading to an abrupt $\mathrm{V}_{\mathrm{t}}$ modulation. Based on this behavior, an imprinted Gd dipole (IGD) gate stack is designed to further modulate the effective dipole strength of a subsequent $\text{LaO}_{\mathrm{x}}$ DF stack. The proposed IGD scheme achieves a fine Vt tunability of $\sim 40 \text{mV} /$ cycle with negligible EOT penalty. In addition, the IGD stack reduces the effective trap density by 92% and suppresses gate leakage current by more than one order of magnitude compared to the conventional $\text{LaO}_{\mathrm{x}}$ DF stack.},
  keywords={Stacking;Displays;Indexes;Indexing;Technology;Very large scale integration;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577561},
}

@INPROCEEDINGS{11577432,
  author={Wang, Chenlu and Sun, Sihan and Zhou, Hong and Zhu, Yao and Zhang, Xiaodong and Peng, Guoliang and Zhou, Min and Zhang, Kun and Zhang, Tao and Zhang, Chunfu and Liu, Zhihong and Hao, Yue and Zhang, Jincheng},
  title={First Demonstration of Ga2O3 Reverse Blocking Transistors with BV2/Ron,sp Figure-of-Merit Over 1 GW/cm2 and Dual Blocking of 8 kV by Double Super-Junction Design},
  abstract={This work reports the first demonstration of reverse blocking $\mathrm{n}-\text{Ga}_{2} \mathrm{O}_{3}$ transistor by constructing $\mathrm{p}-\text{NiO}/\mathrm{n}-\text{Ga}_{2} \mathrm{O}_{3}$ double super-junction (DSJ) MOS junction-FETs (DSJ-MOSJFETs). The DSJ-MOSJFET is beneficial for boosting on-state performance, leading to a large gate swing of 9.5 V and low specific on-resistance ($\mathrm{R}_{\text{on}, \text{sp}}$) of $5.67 \mathrm{m} \Omega \cdot \text{cm}^{2}$. Meanwhile, DSJ technique also enhanced the breakdown voltage (BV) under the charge balance condition, resulting in a BV of 2.4 kV at gate-to-p-NiO spacing (LGP) of $4 \mu \mathrm{m}$. Thus, the average electric field (EAV) is pushed to be 6.1 MV/cm and the $\text{BV}^{2}/\mathrm{R}_{\text{on, sp}}$ power-figure of merit (P-FOM) is yielded to be over 1 GW/cm2. The repeated measurement and stress tests with both shift in VTH less than 0.1 V illustrate the strong stability for this work. Combined with the both forward and reverse BV delivered to be $>8 \text{kV}$, this work shows the great promise for future high-power and high-voltage power conversion applications.},
  keywords={Gallium;Displays;Printing;Timing;Transistors;Indexes;Indexing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577432},
}

@INPROCEEDINGS{11577391,
  author={Chen, Anlan and Huang, Xingyu and Sakai, Kota and Takuya, Saraya and Hiramoto, Toshiro and Uenuma, Mutsunori and Takahashi, Takanori and Uraoka, Yukiharu and Kobayashi, Masaharu},
  title={Experimental Study on Carrier Transport in Amorphous and Poly InGaOx FETs – Hall Measurement, Temperature Dependence, Velocity Saturation},
  abstract={We have systematically investigated low-field carrier transport in amorphous and poly oxide semiconductor (OS), InGaOx (IGO) FETs by employing Hall measurement for strict separation of carrier concentration (Ns) and mobility. High mobility OS FETs exhibit distinct temperature dependence at low and high carrier concentration. Poly IGO FETs show more phonon-limited scattering behavior than amorphous IGO FETs. We also investigated high-field carrier transport with short channel FETs. Velocity saturation behavior is obtained even with parasitic resistance correction, which determines the device performance for scaling OS FETs. These findings are essential for physics-based device modeling of scaled OS FETs.},
  keywords={Field effect transistors;Temperature;Printing;Temperature dependence;Scattering;Very large scale integration;Measurement;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577391},
}

@INPROCEEDINGS{11577475,
  author={Yeap, Geoffrey and Wang, M. and Lin, S.S. and Lee, C.M. and Hsu, D. and Wu, I.W. and Cheng, Y.S. and Tseng, Y.C. and Huang, P.Y. and Chen, H.Y. and Huang, P.H. and Wang, P.W. and Hung, P. and Lin, Y.K. and Chang, C.F. and Kao, C.Y. and Chen, L.G. and Tsai, C.F. and Liao, K.F. and JangJian, P.C. and Chen, M.K. and Fu, C.F. and Lin, C.N. and Liu, K.N. and Lee, C.C. and Tang, Y.H. and Ting, C.Y. and Chiu, T.H. and Huang, H.C. and Huang, K.B. and Wu, C.L. and Tsai, C.P. and Su, Y.H. and Yang, K.N. and Lee, C.W. and Lee, J.H. and Cheng, K.L. and Lee, T.L. and Liu, C.M. and Chan, C.T. and Yeh, C.C. and Wang, H. and Lin, P.Y. and Sun, S.H. and Lin, C.P. and Peng, Y.C. and Shang, H.L. and Lin, H.C. and Chang, J. and Chen, X.M. and Lin, H.T. and Chen, K.W. and Lu, L.C. and Ku, Y. and Jang, S.M.},
  title={A16 Angstrom-Class CMOS Technology Featuring Enhanced Nanosheet Transistors with Super Power Rail (Backside Direct Contact Power Delivery) for AI and HPC Applications},
  abstract={We successfully developed and qualified A16 platform technology, industry-first angstrom-class CMOS technology platform featuring Super Power Rail (SPR). TSMC's SPR is an innovative backside power delivery solution incorporating a novel backside direct contact scheme that preserves N2P gate density and NanoFlex design-technology co-optimization for maximum product design benefits (Fig.1). Compared with N2P (performance-enhanced N 2), A16 provides a further $8 \% \sim 10 \%$ faster speed at power, or $15 \% \sim 20 \%$ power improvement and additional $8 \% \sim 10 \%$ chip density gain. A16 is most suitable for AI/HPC products with complex signal routes and dense power delivery network. Mass production is slated for Q4'26.},
  keywords={Displays;Indexes;Indexing;Surface plasmon resonance;Technology;Contacts;Optimization;SRAM chips},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577475},
}

@INPROCEEDINGS{11577257,
  author={Alla, Vamsi Krishna and Smith, Alan and Huang, Tyrone and Kaganov, Alexander and Jung, Wonjun and Steffen, Michael},
  title={Architecture Partitioning and Optimization in the Era of Chiplet Computing},
  abstract={Traditional transistor scaling is slowing while AI/HPC workloads demand rapidly increasing compute throughput and memory bandwidth. This gap shifts scaling emphasis to system-level innovation through chiplet partitioning and advanced packaging. We present a taxonomy of 2.5 D, 3D, and hybrid integration, and discuss chiplet design considerations including architectural partitioning, die-to-die PHY selection, power delivery, thermal management, and cross-die verification. The AMD Instinct ™ MI355X GPU serves as a case study, employing eight 3D hybrid-bonded TSMC N3P accelerator complex dies on two merged TSMC N6 I/O dies with 12-high HBM3E via a 2.5D silicon interposer. MI355X delivers $1.9 \times$ peak compute and $1.5 \times$ HBM bandwidth and capacity versus MI300X within the same form factor.},
  keywords={Dies;Timing;Packaging;Bandwidth;Optimization;Architecture;Computer architecture;Printing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577257},
}

@INPROCEEDINGS{11577440,
  author={Huang, Qijing and Jiang, Wenqi and Kozyrakis, Christos and Clemons, Jason},
  title={Enabling the Robotic Revolution: Bridging Performance Gap Between Present and Future},
  abstract={The robotics industry has reached an inflection point due to the recent advancements of robotics foundation models which enable general-purpose action generation in various physical environments. However, a significant performance gap remains between these models and the constraints of edge hardware. This paper characterizes the foundation models for robotics and analyzes the hardware bottlenecks across three critical dimensions: model architecture diversity, real-time latency constraints, power and thermal limits. By analyzing state-of-the-art models like Physical Intelligence's $\pi 0$, NVIDIA GR00T N1.6, and NVIDIA DreamZero on modern platforms, we demonstrate that achieving the desired frequency for smooth and responsive humanoid dexterity under stringent conditions necessitates an $8.3 \times$ increase in compute throughput, a $19.7 \times$ leap in memory bandwidth and a shift toward $4 \times$ higher power efficiency for untethered operations. We conclude by calling on the VLSI community to help provide the innovations needed to move from research prototypes to ubiquitous, reliable humanoid deployment.},
  keywords={Modeling;Timing;Humanoid robots;Memory;Robots;Foundation models;Frequency;Bandwidth;Hardware;Architecture},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577440},
}

@INPROCEEDINGS{11577485,
  author={Martiel, Simon and Javadi-Abhari, Ali},
  title={Detecting Quantum Errors with Hardware-Efficient Checks},
  abstract={Assertions are used extensively in programming to check for program bugs or runtime errors. In quantum computers, runtime errors are many orders of magnitude more likely, making it critical to detect such errors. The problem is exacerbated due to several factors: direct observation of the quantum state destroys it, and the process of detecting errors can itself introduce extra errors. Here, we introduce methods for efficiently detecting errors in quantum circuits by leveraging spacetime codes. These checks introduce little additional error and can be tailored to the underlying quantum hardware, including its qubit connectivity graph and dominant sources of noise. We show the practicality of the approach by successfully preparing maximally entangled states on 50 logical qubits. Such error detection methods form a viable bridge between near-term error mitigation and longer-term error correction in quantum computers.},
  keywords={Qubit;Circuits;Noise;Signal detection;Hardware;Timing;Computers;Printing;Quantum;assertions;error detection;compilation},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577485},
}

@INPROCEEDINGS{11577350,
  author={Fan, A. and Iyer, A. and Tan, A. and Cusmai, B. and Ramanna, C. and Song, C. and Zhu, C. and Lo, H. and Teo, J-H. and Wang, J-Q. and Prakash, K-K. Ravi and Choi, M. and Shivashankar, N. and Balakrishnan, S. and Chen, S. and Jafarlou, S. and Mahdavi, S. and Ray, S. and Yu, S. and Gurumoorthy, V. and Neo, W-Y. and Wang, Y. and Sun, Z. and Wang, Z. and Abidin, C. and Jantzi, S. and Chang, K.},
  title={A 3-nm FinFET CMOS PAM-4 Retimer for $\mathbf{8 0 0 - Gb} / \mathbf{s}$ and $\mathbf{1. 6 - T b} / \mathbf{s}$ Optical Modules},
  abstract={This work presents a PAM-4 retimer implemented in $3-\text{nm}$ FinFET CMOS for operation beyond 100 GBd per lane. The design integrates DAC-based transmitters and ADC-based receivers operating up to $115 \text{GS} / \mathrm{s}$. The line-side transmitter employs digital pre-distortion, FIR pre-emphasis, and an optimized high-swing output stage to mitigate parasiticinduced distortion and group-delay variation. The receiver incorporates a wideband analog front end followed by a track-and-hold and a time-interleaved SAR ADC. Measured results demonstrate a 115 GBd PAM-4 eye with approximately 3Vpp differential swing, RLM = 0.983, and TDECQ = 0.91.},
  keywords={Displays;Indexes;Indexing;Receivers;Bandwidth;Transmitters;Dies;Delays;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577350},
}

@INPROCEEDINGS{11577471,
  author={Karl, Eric and Agrawal, Shishir P. and Prakash, Som Bangalore and Choi, Seung-June and Fischer, Kevin J. and Jiang, Lei and Pantuso, Daniel and Subramaniam, Ramesh K. and Wang, Xiaofei and Wang, Xinning and Wu, Tai-Hsuan},
  title={Backside Power: Enabling Energy-Efficient Performance on Advanced Node Designs},
  abstract={Backside power delivery network (BS-PDN) decouples signal routing from power delivery, reducing interconnect scaling cost/complexity. Key benefits include 11% routed area reduction and 10 × dynamic droop reduction, enabling $5-6 {\%}$ frequency uplift or $>15 {\%}$ dynamic power reduction vs. comparable frontside interconnect technology.},
  keywords={Technology;Routing;Displays;Indexes;Indexing;Metals;Stacking;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577471},
}

@INPROCEEDINGS{11577241,
  author={Chang, Jim and Jiang, Zhe-Wei and Tam, King-Ho and Lee, Yun-Han and Lu, Lee-Chung},
  title={3DIC Design Methodology for High-Performance Computing},
  abstract={The escalating requirements of contemporary workloads, such as high-performance computing, artificial intelligence, data center operations, and cloud computing have necessitated an IC design paradigm shift from the SoC architecture to the more sophisticated multi-die 3D integrated system architecture. This work examines the various design methodology advancements critical for the successful implementation of the state-of-the-art 3DIC integration.},
  keywords={Design methodology;Dies;Modeling;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577241},
}

@INPROCEEDINGS{11577595,
  author={Eki, Ryoji and Kato, Takaaki and Cavinato, Valentina and Politis, Agis and Isler, Stefan},
  title={Integrated Imaging Solutions for Robotic Navigation and Manipulation: Visual-Inertial SLAM and Neuromorphic Tactile Sensing},
  abstract={This paper presents imaging solutions for robotic Navigation and Manipulation. For Navigation, we demonstrate enhanced Simultaneous Localization and Mapping (SLAM) technology achieving centimeter-level accuracy for precise localization. For Manipulation, we introduce an Event-based Vision Sensor (EVS) based tactile sensor utilizing neuromorphic vision for high-precision marker tracking with low latency and power consumption. We propose a 3D-stacked CMOS sensor integrating EVS with on-chip AI processing, achieving reduced data volume and compact size for robotic applications.},
  keywords={Technology;Printing;Simultaneous localization and mapping;Tracking;Image sensors;Cameras;Synchronization;Visualization;Tactile sensors;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577595},
}

@INPROCEEDINGS{11577289,
  author={Matsuo, Shinji and Hiraki, Tatsurou and Minotani, Tadashi and Aihara, Takuma and Fujii, Takuro and Maeda, Yoshiho and Yamaoka, Suguru and Shikama, Yoshiya and Sato, Norio and Sato, Tomonari},
  title={Membrane III-V Photonic Devices on Silicon Photonics Platform for Short-Distance Optical Interconnections},
  abstract={We have developed a membrane III-V electro-absorption modulator (EAM) integrated with a DFB laser on a silicon photonics platform. The membrane structure reduces the junction capacitance, enabling a $3-\text{dB}$ bandwidth exceeding 67 GHz and 150 -Gbit/s NRZ operation. We also propose and demonstrate an optical chiplet using a membrane EAM array. By integrating substrate-embedded CMOS drivers, the optical chiplet achieves $64-\text{Gbit} / \mathrm{s}$ PAM4 modulation with an energy cost of $0.75 \text{pJ} /$ bit.},
  keywords={Biomembranes;Electro-absorption modulators;Arrays;Technology;Modulation;Silicon;Substrates;Lasers;Displays;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577289},
}

@INPROCEEDINGS{11577430,
  author={Liao, S. and Yang, L. and You, W.X. and Wu, T.Y. and Chiu, T.K. and Huang, J.C. and Elphick, K. and Yang, K.F. and Sha, C.H. and Wang, G.R. and Jhang, J.H. and Cheng, Y.R. and Shieh, M.F. and Chang, C.M. and Chen, H.M. and Jeng, P.R. and Chang, S.Y. and Yeh, M.H. and Chang, W. and Jang, S.M. and Cao, M.},
  title={CFET Demonstration for Future Logic and SRAM Technology},
  abstract={The Complementary Field-Effect Transistor (CFET) architecture offers a pathway for extending Moore's Law beyond state-of-the-art nanosheet CMOS scaling. This paper reviews our prior CFET device demonstrations on $300-\text{mm}$ silicon, progressing from nFET-on-pFET stacked transistors to 101-stage ring oscillators and the world's most compact 6T SRAM bit-cells. In this work, we further present two key milestones: first, doubling number of stacked nanosheets to boost ring oscillator frequency by $+15 {\%}$; and second, enabling multi-Vt integration capability through dipole patterning approaches, achieving six distinct Vt values ($3-\text{Vtn}$ and $3-\text{Vtp}$) with a $160 \text{mV} / 120 \text{mV}$ span range for N/P FETs on the same wafer.},
  keywords={Displays;Indexes;Indexing;Technology;Printing;Architecture;Computer architecture;Contacts;Transistors;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577430},
}

@INPROCEEDINGS{11577645,
  author={Nakajima, Takashi and Takeda, Kenta and Noiri, Akito and Kobayashi, Takashi and Camenzind, Leon C. and Sekiguchi, Tomonori and Kanno, Yusuke and Wachi, Yusuke and Norimatsu, Takayasu and Tsuchiya, Ryuta and Mizuno, Hiroyuki and Tarucha, Seigo},
  title={Developing a Quantum Computer with Electrically Driven Spin Qubits},
  abstract={This paper presents the implementation of spin qubits in silicon and the status of development toward scalable quantum computers. High-fidelity control of up to ten qubits is demonstrated in an array of quantum dots fabricated on a $\text{Si}/\text{SiGe}$ quantum well (QW) wafer. Key requirements for maintaining qubit fidelities include material stacks, gate geometry, control electronics, and signal integrity. We discuss our efforts for scaling up the silicon qubit system to realize a practical quantum computer.},
  keywords={Qubit;Quantum dots;Silicon;Displays;Indexes;Indexing;Spinning;Printing;Circuits;Spin qubits;silicon quantum computing;quantum dots;spin qubits;cryogenic circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577645},
}

@INPROCEEDINGS{11577464,
  author={Katsumata, Ryota and Maeda, Seiji and Inohara, Masahiro and Inoue, Hirofumi},
  title={3D Flash Memory Technology for the AI Era},
  abstract={Generative AI's widespread use relies on Large Language Models (LLMs) and significant data storage supported by Solid State Drives (SSDs). Key optimizations for 3D flash memory involve balancing latency, parallelism, and bandwidth. Technologies such as molybdenum word lines and tungsten bit lines with an air-gap improve latency. Packaging advancements, including vertical wire bonding, redistribution layer (RDL), and through-silicon via (TSV), enhance interface speed and power delivery, which are crucial for handling large AI model data and enabling rapid data access.},
  keywords={Memory;Wire;Wires;Wiring;Bonding;Technology;Flash memories;Dies;Retrieval augmented generation;Packaging},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577464},
}

@INPROCEEDINGS{11577576,
  author={Hwang, Yeontaek and Moon, Jongkyu and Yang, Juheon and Harr, Kyoungmoo and Jang, Minseok and Choi, Jinwoo and Lee, Jaesik},
  title={High Bandwidth Memory 4 (HBM4) Package Development Challenges},
  abstract={We report package development challenges associated with High Bandwidth Memory 4(HBM4) using Mechanical Test Vehicle 4 (MTV4): achieving 12-layer stacking and investigating stress interaction between HBM and advanced packaging technologies that have been used for Logic and HBM integration. Material and process innovations overcome challenges, such as die warpage and gap fill, caused by decreasing die thickness and reducing gap height. Micro-bump joint integrity for entire 12-layer stacks after reliability confirmed with daisy chain resistance and Confocal Scanning Acoustic Microscopy (C-SAM) analysis. The results indicated that test vehicle achieved void-free and high micro-bump integrity. Package interaction study is conducted with thermo-mechanical simulation methodology using identical floor plan. Higher stress is observed both at the HBM stacks (base die & core die) and at extremely lowk (ELK) layer when assembling on advanced substrate due to high coefficient of thermal expansion (CTE) mismatch. ELK stress at advanced substrate was as high as 2.5 x compared to Silicon interposer technology.},
  keywords={Packaging;Dies;Technology;Silicon;Human factors;Stress;Substrates;Bridges;Simulation;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577576},
}

@INPROCEEDINGS{11577266,
  author={Chu, Seung Wan and Cheon, Junho and Cho, Jinsun and Doh, Eunhyup and Han, Jungmin and Hong, Seung Bum and Kim, Choong-ki and Kim, Daeik and Kim, Jin Ar and Kim, Sunghyun and Kim, Yongtaik and Kum, Kyongsoo and Kwon, Sein and Lee, DongJae and Lee, Dong Ryeol and Lee, Junghak and Park, Eunshil and Park, Jongbum and Shin, Dong Hee and Shin, Eunji and Song, Jino and Sung, Minchul and Yoo, Wansik and Hwang, JeongTae and Kim, Seungbum and Jang, Kyoungchul and Park, Joodong and Cho, Youngmann and Cha, Seonyong},
  title={Electrical Characteristics of the 4F2 Vertical Gate (VG) DRAM integrated with Bit Line Shielding (BLS) and Back Gate (BG) Transistor},
  abstract={This paper reports the electrical characteristics of $4 ~\mathrm{F}^{2}$ vertical gate (VG) DRAM such as data retention and sensing capability. The proposed VG DRAM incorporates key technologies including bit-line shielding (BLS) to suppress coupling noise and shared back gate (BG) structure to enhance threshold voltage (Vth) control and passing gate effect. Diethinning technology is also introduced to support reliable circuit operation in wafer-bonded structure. Measured results demonstrate the feasibility of $4 ~\mathrm{F}^{2}$ VG DRAM architecture providing a viable development path toward competitive future DRAM products.},
  keywords={Displays;Indexes;Indexing;Cells (biology);DRAM chips;Transistors;Technology;Circuits;Noise;Very large scale integration;4F2 DRAM;vertical gate cell transistor;bit-line shielding;back gate},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577266},
}

@INPROCEEDINGS{11577214,
  author={Ramaswamy, N. and Calderoni, A. and Mocuta, D. and Daycock, D. and Karda, K. and Singh, A. and Sreeramaneni, R.},
  title={Intelligence Accelerated: Memory Innovations to Power the AI Era},
  abstract={Artificial intelligence is driving exponential growth in computation, data transfer, and energy consumption. As model sizes surpass the trillion-parameter threshold and reasoning workloads increase demands on bandwidth and latency, memory has emerged as the central constraint for advanced AI systems rather than compute resources. Meeting these exponential requirements necessitates coordinated advancements in memory technologies—such as DRAM and NAND, high-bandwidth memory, and packaging solutions including hybrid bonding, fine-pitch die-to-die interconnects, and vertically stacked memory architectures. Breakthroughs in materials science, sophisticated physics-based modeling, wafer bonding, and advanced metrology solutions are essential for rapid progress. The integration of emerging non-volatile memories and CXL-enabled expansion frameworks further supports heterogeneous and composable memory systems tailored for large-scale AI. This work summarizes key device, packaging, energy-efficiency, and memory innovations needed for future AI workloads.},
  keywords={Memory;DRAM chips;Artificial intelligence;Technology;Arrays;Bandwidth;Dies;Bonding;Packaging;Optimization;Artificial intelligence (AI);DRAM scaling;high-bandwidth memory (HBM);Emerging memory;energyefficient computing;Advanced Packaging},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577214},
}

@INPROCEEDINGS{11577572,
  author={Morris, Daniel H. and Vaidynathan, Kaushik and Ho, C. Richard},
  title={Building the Engine of AI: From Foundational VLSI Technologies to System-Scale Impact},
  abstract={AI is reshaping our lives. New models demonstrate increasing levels of intelligence in applications ranging from entertainment to productivity to scientific discovery. This impact is profound and accelerating, but the frontier-scale training and inference-demands this creates is placing unprecedented stress on every layer of hardware systems. For AI to serve all of humanity, we must solve these hardware challenges at scale to overcome bottlenecks in compute, memory bandwidth, connectivity, and physical datacenter infrastructure. Progress will not come from transistor scaling alone; it will require advances in circuits and technologies for memory integration, low-power interconnect, power delivery, thermals, and advanced packaging. These innovations must be co-optimized within a coherent system architecture. Only through holistic, system-level innovation—paired with disciplined execution—can we achieve the Perf/Watt and Perf/TCO improvements needed to make AI's benefits broadly accessible.},
  keywords={Modeling;Artificial intelligence;Hardware;Memory;Design methodology;Technology;Timing;Bandwidth;Dies;Limiting;LLM;AGI;AI Accelerator;Datacenter},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577572},
}

@INPROCEEDINGS{11577212,
  author={Mitano, Yoshinobu},
  title={Meeting AI Demand Through Equipment Innovation and AI-Driven Manufacturing: Progress and Challenges},
  abstract={Our industry has grown together with the evolution of semiconductor manufacturing equipment. Driven by the rise of AI and its prospects, the role of semiconductors continues to expand, and equipment has become even more critical. At the same time, it is increasingly important to apply AI to equipment technologies and fab operations themselves. In this talk, we will present our efforts on both fronts. We will show how new equipment and process technologies contribute to the advancement of AI systems toward higher performance with lower power consumption, and how we are using AI in equipment and fab technology. We will outline current progress, challenges, and next steps, emphasizing the importance of industry-wide collaboration. By addressing these two sides together, we aim to show how the semiconductor industry can meet the needs of AI today and in the future. We will also discuss reductions in energy use in semiconductor manufacturing.},
  keywords={Technology;Artificial intelligence;Printing;Dies;Etching;Modeling;Technological innovation;Manufacturing;Optimization;Tools},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577212},
}

@INPROCEEDINGS{11577449,
  author={Lu, Lee-Chung},
  title={Advancing Package and System Integration for Next-Generation AI},
  abstract={Advanced 2.5 D and 3.5 D packages have emerged as the pivotal technology for next-generation AI system scaling to meet demanding performance, bandwidth, and power efficiency requirements. The architectural paradigm shift from 2D System-on-Chip to 3.5D integrations introduces profound challenges in advanced packaging technology and system-level design. This paper identifies three primary drivers contributing to the exceptional performance increase and rapid growth of artificial intelligence: (1) continuous semiconductor technology advancements enabling significant compute and bandwidth scaling; (2) critical thermal, power delivery, and bandwidth optimization techniques for robust system design; and (3) pivotal 3DIC design methodology innovations and ecosystem collaboration facilitating the realization of complex systems.},
  keywords={Technology;Dies;Design methodology;Packaging;Optimization;Bandwidth;Artificial intelligence;Stacking;High performance computing;Transistors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577449},
}
