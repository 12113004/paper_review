  month={June},}@INPROCEEDINGS{11577413,
  author={Cho, Dongseok and Choi, Hyun-Seung and Park, Injun and Na, Yoondeok and Yang, Seonghun and Yang, Minkyoung and Youn, Yerin and Cheon, Jimin and Lee, Myung-Jae and Chae, Youngcheol},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A SPAD-Based iToF Flash LiDAR Sensor with a Coarse-Fine Operation Scheme Robust Against Strong Background Light}, 
  year={2026},
  volume={},
