  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 75nW BJT-Based Temperature Sensor with ±0.1°C Inaccuracy from −40°C to 85°C}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper describes a BJT-based temperature sensor that combines a dual-mode front-end (DMFE), and a low-power switched capacitor (SC) $\Delta \Sigma$ modulator with a 10-tap FIR-DAC. After a low-cost 1-point trim, it achieves $\pm 0.1^{\circ} \mathrm{C}(3 \sigma)$ inaccuracy from $-40^{\circ} \mathrm{C}$ to 85 °C while dissipating only 75 nW. This is $3 \times$ lower than prior precision BJT-based sensors, and $2-3 \times$ more accurate than prior low-power MOS-based sensors.},
  keywords={Timing;Printing;Image sensors;Modulation;Temperature;Technology;Sensors},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577631},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577554,
