  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 209 ∼ 245GHz CMOS Spectroscopic Transmitter with DTC-Based 4FSK Baseline Elimination and Phase-Offset Calibrated SSPLL for Chip-Scale Molecular Clocks}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a CMOS spectroscopic transmitter probing the 231.061 GHz rotational spectra of OCS gas molecules for chip-scale molecular clocks (CSMC). It adopts 4FSK modulation through a DTC FSK modulator to mitigate the baseline tilting of gas cell with negligible SNR penalty. A $104.4 \sim 122.4 \text{GHz}$ integer-$N$ sub-sampling PLL (SSPLL, $N=36$) reduces the phase noise (PN) for high SNR. Phase offset calibration ensures robust locking of SSPLL under PVT variation. A $5.8 \sim 6.8 \text{GHz}$ fractional-$N$ sampling PLL (SPLL) drives the SSPLL. Fabricated on $65-\text{nm}$ bulk CMOS, it achieves a measured PN of $-79.2 \text{dBc} / \text{Hz} {@} 2 f_{m}=100 \text{kHz}$ offset, and 86.9 fs jitter at $f_{0}=231.061 \text{GHz}$, consuming $P_{D C}=73 \text{mW}$. The measured 4FSK dispersion curve records a SNR of 85.7 dB with only 1.9 dB SNR penalty. After the CSMC locking, ADEV of $3.7 \times 10^{-10} {@} \tau=1 \mathrm{s}$, and ADEV of $3.4 \times 10^{-11} {@} \tau=10^{3} \mathrm{s}$ are measured.},
  keywords={Modulation;Timing;Signal to noise ratio;Frequency;Calibration;Technology;chip-scale molecular clock;CMOS spectrometer;4FSK modulation;DTC;phase offset calibration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577512},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577238,
  author={Gong, Jiang and He, Long and Jang, Taekwang},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 5.7-6.8GHz Capacitively-Coupled Series-Assisted Parallel-Resonance VCO Achieving −148.8 dBc/Hz PN, 193.5 FoM, and 202.0 FoMA at 10MHz Offset}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a capacitively-coupled series-assisted parallel-resonance (CSA-PR) VCO that achieves ultra-low phase noise with high power and area efficiency. By capacitively coupling a parallel LC tank with low-impedance auxiliary elements, the design provides passive voltage gain and waveform shaping to reduce both thermal and flicker noise. The tunable tank impedance enables flexible trade-offs between power and noise. Fabricated in $22-\text{nm}$ FDSOI CMOS, the single-core VCO achieves $-148.8 \text{dBc} / \text{Hz}$ phase noise and $193.5 \text{dBc} / \text{Hz}$ FoM at 10 MHz offset while consuming 11.8 mW in a $0.14 \text{mm}^{2}$ area.},
  keywords={Voltage-controlled oscillators;Impedance;Printing;Noise;Joining processes;Strontium;Technology;Oscillators},
