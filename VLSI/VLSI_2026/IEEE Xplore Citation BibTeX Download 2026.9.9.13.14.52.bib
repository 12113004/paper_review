  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.0257 mm2, 1.16 µW, Mask-Efficient KWS SoC with Hybrid Cap-ROM-IMC/SRAM-NMC and Transfer Learning for Flexible Multi-Keyword Recognition}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Scaling always-on keyword spotting (KWS) system to larger vocabularies increases model size, driving higher memory and compute demands that push SoCs $>100 \mu \mathrm{W}$, with significant off-chip loading energy and area overhead. This work presents the first KWS SoC featuring a hybrid Cap-ROM-based in-memory computing (Cap-ROM-IMC)/5T-SRAM-based near-memory computing (SRAM-NMC) architecture with a transfer-learning based model supporting 20 keywords. Fabricated in 28 nm, the SoC achieves 92.1% accuracy on GSCD-v2 with the lowest reported power $(1.16 \mu \mathrm{W})$ and highest ROM memory density $(2372.6 \text{KB} / \text{mm}^{2})$ among prior arts.},
  keywords={Modeling;Read only memory;SRAM chips;In-memory computing;Memory;System-on-chip;Printing;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577523},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577511,
  author={Vitale, Nicholas and McDermott, Mark and Zare, Davood and Hassibi, Arjang and Lee, Tom},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Filter-Free Time-Gated Fluorescence CMOS Biochip with Fast Thermal Cycling for PoC DNA Testing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A 16 × 24 time-gated fluorescence CMOS biosensor array is presented for nucleic acid analysis. Time-interleaved measurement of excitation and fluorescence emission enables each pixel to achieve 9.9 fA input-referred fluorescence photocurrent sensitivity, 129 dB detection dynamic range, and $>133 \text{dB}$ suppression of combined excitation and autofluorescence background, eliminating the need for an optical emission filter. Integrated on-chip heating with passive cooling supports thermocycling with heating and cooling rates exceeding $18{ }^{\circ} \mathrm{C} / \mathrm{s}$, as well as precision melt-curve analysis for immobilized DNA probes on pixel.},
  keywords={Timing;Arrays;Fluorescence;DNA;Pixel;Signal detection;Printing;Filtering;Light emitting diodes;Technology;Fluorescence;biosensors;CMOS biochip;molecular diagnostics;pinned photodiodes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577511},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577481,
  author={Fan, Minghao and Chen, Yilun and Li, Zheng and Ren, Ziyuan and Tang, Minzhe and Liu, Junqing and Liu, Yuxuan and XU, Dongfan and Liu, Zezheng and Yamazaki, Yudai and Kato, Sena and Kunihiro, Kazuaki and Sakai, Hiroyuki and Zhang, Yuncheng and Okada, Kenichi},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 57-71-GHz CMOS Phased-Array Transceiver with Aperture-Tuning Antenna Achieving 47.9-62.2% EIRP Efficiency Improvement}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a $60-\text{GHz}$ aperture-tuning antenna and transceiver for wide frequency coverage in the 5G NR FR2-2 n263 band. Distributed tuners reconfigure the radiation to enable mode-dependent operation, achieving frequencyselective EIRP enhancement under narrow instantaneous bandwidth operation. Fabricated in $65-\text{nm}$ CMOS, a dualpolarized transceiver with switchless antenna-port modeseparated TX/RX operation is implemented. The proposed design achieves measured TX EIRP improvements of $62.2 {\%} (2.1 \text{dB})$ at 57 GHz and $47.9 {\%}(1.7 \text{dB})$ at 71 GHz without additional power consumption. Using a customized OFDM waveform with $14-\text{GHz}$ frequency coverage, a maximum data rate of $56 \text{Gb} / \mathrm{s}$ is demonstrated with 16-QAM modulation.},
  keywords={Tuning;Apertures;Antennas;Tuners;Displays;Indexes;Indexing;Frequency;Impedance;Printing;Aperture-tuning antenna;high data rate;phased-array;mm-wave;5G NR FR2-2},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577481},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577442,
  author={Nam, Sang-Yun and Kim, Won-Gyu and Lee, Jaeseung and Yang, Jun-Hyeok and Hong, Sung-Wan},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Scalable Distributed Digital LDO Achieving Fast and Accurate Current Balancing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a scalable distributed digital LDO (SDDLDO) achieving fast and accurate current balancing for advanced SoCs. The proposed design utilizes a group-based balancing technique, reducing calibration steps to $\log _{4}{ }^{\mathrm{N}}$, which is much faster than conventional approaches. In addition, a compact analog current sensor enables high-accuracy sensing. The prototype achieves a convergence time of $134.6 \mu \mathrm{s}$ with a 5.2% error rate, proving its practicality for large-scale.},
  keywords={Current;Calibration;Design methodology;Timing;Cells (biology);Measurement units;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577442},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577411,
  author={Gambhir, M. and Mostafa, A. and Chu, F. and Guo, Z. and Hasan, M. and Hassan, A. and Hsiao, E. and Li, Z. and Liu, P. and Lu, F. and Singh, M. and Su, Y.-P. and Visani, D. and Zhou, D. and Wang, H. and Chang, K. and Chen, R. and Lu, K.-M. and Su, Y.-P. and Lahiri, A. and Ramakrishna, P. and Shukla, U. and Singh, A. and Shannon, M.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 2.05pJ/bit, 212.5Gbps DSP Based Transceiver with 55dB Reach in 3nm FinFET}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents 212.5Gbps ultra-long reach PAM4 transceiver implemented in 3nm FinFET technology. 4-lane transceiver achieves pre-FEC BER of 2e-7 for 54.7dB bumpbump loss and 4e-9 for 49.5dB loss. Per-lane analog power efficiency at 212.5Gbps is 2.05pJ/bit which represents the lowest power as well as the longest reach published for this data rate. DAC current-mode driver-based transmitter achieves SNDR of 36dB, RLM of 0.97 and rms jitter of 50fs.},
  keywords={Displays;Indexes;Indexing;Clocks;Transceivers;Phase locked loops;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577411},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577465,
  author={Lee, Chang-Young and Park, Young-Seok and Park, Hyeon-Jin and Shin, Dong-Hak and Park, Keon-Woo and Yoon, Se-Ryeong and Lee, Dong-Kyu and Kim, Min-Soo and Sung, Gi-Jong and Kang, Kyu-Chang and Kim, Sang-Yun and Yoon, Hyun-Chul and Won, Bok-Yeon and Nam, In-Cheol and Seo, Young-Hun and Bae, Seung-Jun and Sohn, Young-Soo and Hwang, Sang-Jun},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Dual-Phase Offset Compensation and Conditional Latch Gating for a Fully Singleended Dram Core Data-Line Architecture Operating at 0.75 V}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper proposes a fully single-ended DRAM core dataline architecture for low-power operation and improved backend routing efficiency. And also, this paper proposes a dual-phase offset compensation (DPOC) scheme to prevent charge transfer (CT) gain degradation caused by overcompensation, along with a conditional latch gating (CLG) technique to suppress CSL-induced latch disturb under low supply voltage. The proposed design was implemented in a test chip fabricated using a $10-\text{nm}$–class DRAM process. At 0.75 V operation, the proposed scheme achieves a 99.4% reduction in fail bit count (FBC) compared to the case without CLG, while reducing IDD0 current by 27%.},
  keywords={Displays;Indexes;Indexing;Architecture;Computer architecture;Printing;DRAM chips;Current;Voltage;Switches},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577465},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577338,
  author={Deng, Huanshihong and Fu, Yiheng and Safari, Negin and Huang, Cong and Tan, Fei and Shoaran, Mahsa},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={TARNA: A 1.18-μW/Channel Topology-Aware Residual Recurrent CIM Processor for Zero-Shot Seizure Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Zero-shot seizure detection avoids patient-specific training but remains challenging under strict power constraints and patient variability. This work presents TARNA, a topologyaware recurrent network accelerator implemented as an ultra-low-power computing-in-memory (CIM) zero-shot seizure detector. TARNA combines graph convolutions with masked residual recurrent updates to eliminate nonlinear gating, while a sparsity-aware CIM macro further reduces energy. Fabricated in $65-\text{nm}$ CMOS, TARNA achieves 100 % zeroshot event-based sensitivity and a $0.048 / \text{hr}$ false-alarm rate on the CHB-MIT dataset, and an AUROC of 0.88 on the TUSZ dataset, operating at the lowest reported power of $22.5 \mu ~\mathrm{W}$.},
  keywords={Modeling;Poles and zeros;Printing;In-memory computing;Signal detection;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Energy;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577338},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577316,
  author={Kao, Chen-Chien and Wei, Tianyu and Tang, Wei and Zhang, Zhengya},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A $5.69 ~\text{mm}^{2} 6.22 \text{Gbps}$ User-Correlation-Based Hybrid Detector for $\mathbf{1 0 2 4 \times 6 4}$ Massive MIMO Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a massive multi-user MIMO (MU-MIMO) detector for next-generation wireless systems. The $5.69 ~\text{mm}^{2}$ detector employs user grouping and hybrid detection, leveraging a mixed-precision architecture to achieve a $6.22 ~\text{Gb} / \mathrm{s}$ throughput with 1259 mW. The chip supports the largest configuration to date, with 1024 base station (BS) antennas and 64 users using 256-QAM. Compared to the state of the art, the chip achieves up to $16.1 \times$ higher area efficiency and up to $8.4 \times$ lower normalized energy.},
  keywords={Signal detection;Correlation;Detectors;MIMO;Printing;Complexity theory;Indexes;Indexing;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577316},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577423,
  author={Han, Seunghee and Kim, Seokman and Han, Sanghyun and Kim, Younghwan and Kim, Joo-Young},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.06pJ/b Current-Conveyor-Based Current-Domain Transceiver with DC-Balanced Multi-Transmission-Line PAM Symbol Encoding}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a current-domain transceiver using DC-balanced PAM symbol encoding across multiple transmission lines (TLs). By minimizing TL voltage swing to a few millivolts and transmitting information through controlled TL currents using an RX-side current conveyor (CC), the proposed architecture significantly reduces switching power and circuit area. The symbol encoding constrains a constant aggregate PAM level across a TL group, thereby reducing data-dependent simultaneous switching noise (SSN). CC-based current mirroring and ordering-based decoding remove the need for resistive I-V conversion and reference thresholds. A 4-TL PAM-4 group prototype fabricated in 14 nm CMOS achieves 22.9 Gb/s/ pin data rate with 0.006 mm2 silicon area per TL and 0.06 pJ/b energy efficiency. Limited by the CC current-feedback response rather than RC time constants, the proposed transceiver is expected to scale favorably with advanced technology nodes.},
  keywords={Current;Transceivers;Symbols;Voltage;Technology;Printing;Very large scale integration;Energy efficiency},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577423},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577412,
  author={Ichihara, Reika and Kamiyama, Akinori and Kosaka, Takao and Tokuhira, Hiroki and Saito, Nobuyoshi and Toda, Masaya and Matsuo, Kazuhiro and Haga, Ken-ichi and Hamai, Takamasa and Kabuyanagi, Shoichi and Tsukamoto, Takayuki and Kajita, Akihiro and Saitoh, Masumi and Fujii, Shosuke},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Hydrogen Overflow as a Novel Negative Vth Shift Mechanism in PBTI Universal to Planar and Vertical IGZO FETs}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We identified novel Positive-Bias-Temperature-Instability (PBTI) mechanism in InGaZnO (IGZO) gate stack by separating multiple PBTI factors using in-depth $C-V$ analysis and atomistic calculations. Besides well-known electron ($\mathrm{e}^{-}$) trapping and donor generation, hydrogen overflow followed by proton accumulation in the gate insulator was found to play a critical role in negative $V_{\text{th}}$ shift of PBTI for the first time. This mechanism was also verified with scaled vertical channel transistors, demonstrating over 10 years of lifetime via process optimization based on a solid understanding of PBTI.},
  keywords={Human factors;Stress;Insulators;Displays;Indexes;Indexing;Timing;Optimization;Printing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577412},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577394,
  author={Li, Yanqing and Bao, Yunjiao and Shi, Mingcheng and Liu, Shuang and Wang, Feixiong and Ding, Yi and Liu, Xiying and Yang, Yanyu and Wei, Yanzhao and Zhang, Yadong and Xu, Gaobo and Zhang, Zhaohao and Wang, Yuyan and Huang, Heyi and Tang, Jianshi and Yin, Huaxiang and Wang, Xiaolei and Ye, Tianchun},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Monolithic 3D Integration of Stacked IGZO/Si Memtransistor-Based 2T0c Gain Cell for Attention Computation and CFET SRAM-DCIM With Multiple Spectral CNT-Sensors for End-To-End Vision Transformers (Vits) on Edge AI}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We demonstrate the first memtransistor-based gain-cell (MGC) compute-in-memory device implemented in a monolithic three-dimensional (M3D) chip integrating Si, IGZO, and CNTs technologies. Beyond logics, Si transistors employing dopantsegregation exhibit memtransistor characteristics suitable for memory applications. By vertically stacking an IGZO access transistor on the low-thermal-budget-Si (LT-Si) read memtransistor, an innovative hybrid 2T0C gain cell is realized, enabling low-voltage programmable multistate and stable CIM operation. The device is structurally matched with DEtection TRansformer (DETR) vision transformers, where persistent key-value (K/V) tensors of the frame are stored in memtransistors and dynamic object queries are parallelly pipelined into the storage nodes. Combined with CFET SRAM-DCIM and on-chip multiple spectral CNT-sensor, this end-to-end Q/K/V-aware device-algorithm co-design achieves an $8.93 \times$ energy-efficiency improvement over the baseline, highlighting the potential of M-GC CIM and DCIM for edge vision transformers (ViTs).},
  keywords={Silicon;Displays;Indexes;Indexing;In-memory computing;SRAM chips;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577394},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577584,
  author={Singh, A. and Abdi, D. and Weckx, P. and Singh, A. and Sharma, A. and Biswas, D. and Garcia-Redondo, F.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Backside Split-VDD Write-Assist Driven SRAM Macro Scaling in Nanosheet-Era}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={SRAM's scaling at advanced CMOS nodes requires robust write-assist schemes to ensure reliable write operations. This reliance becomes even more critical due to aggressive voltage scaling at advanced CMOS nodes for $\mathrm{V}_{\min}$ applications. This work leverages the backside routing offered in A14 nanosheet technology to enable backside split-VDD implementation without impacting bitcell footprint scaling. This technique offers enhanced writability without requiring self-timed circuits or large capacitors used in conventional negativebitline write-assist. The proposed approach supports up to 512 rows per bitline and delivers a 40% improvement in write energy along with macro level area savings of 12% area per IO column, compared to these conventional assist schemes. The proposed design enables robust SRAM operation at 0.7 V and delivers 100 mV improvement in bitcell write trip point and 200 fJ write energy per bit for 512 rows per bitline with 86% array efficiency and $44.9 \text{Mb} / \text{mm}^{2}$ density for 512 × 256 subarray.},
  keywords={Writing;Arrays;Technology;Very large scale integration;Cells (biology);Printing;SRAM chips;Circuits;Rails;Conferences},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577584},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577369,
  author={Zhang, Yuncheng and Li, Duo and Zhang, Zihang and Sakai, Hiroyuki and Kunihiro, Kazuaki and Okada, Kenichi},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Switched Inductor-Capacitor Power Amplifier Supporting 100MHz 256-QAM}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a switched inductor-capacitor power amplifier (SLCPA) that enhances power efficiency. By inserting inductors into the capacitor array, the proposed SLCPA suppresses capacitor charging currents, mitigating switching loss, and improving efficiency. A prototype fabricated in 65 nm CMOS shows a $1.29 \times$ efficiency improvement over typical Class-B efficiency at $6-\text{dB}$ PBO. This design supports up to $100 \text{MSymbol} / \mathrm{s}$ 256-QAM operation without digital predistortion (DPD).},
  keywords={Printing;Capacitors;Quadrature amplitude modulation;Frequency;Inductors;Technology;Current},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577369},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577519,
  author={Zhao, Biqi Rebekah and Chou, Alexander and Lee, Changuk and Pandey, Aviral and Pinkenburg, Jade and Murray, Liz and Gopalan, Karthik and Liu, Chunlei and Lustig, Michael and Muller, Rikky},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Wireless Pressure Sensor Implant with MRI-Encoded Data Uplink}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a wireless implantable pressure sensor using active MRI-based uplink for simultaneous sensing and localization. The system integrates a MEMS pressure transducer with a $2 \times 1 ~\text{mm}^{2} 28 ~\text{nm}$ IC powered by a 1 MHz inductive link. Data uplink is performed by actively modulating MR image voxels using an on-chip micro-coil. A 12-bit $1^{\text {st }}$-order CT $\Sigma \Delta$ ADC digitizes pressure data at $375 \mu ~\mathrm{W}$. In-scanner tests show 15 % modulation depth at $56 \mu ~\mathrm{W}$.},
  keywords={Uplink;Magnetic resonance imaging;Implants;Coils;Modulation;Radio frequency;Current;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577519},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577258,
  author={Li, Nealson and Liu, Che-Kai and Ellis, Zachary J. and Talley, Connor and Noh, Young-Seok and Patino-Sosa, Kevin and Sathe, Visvesh and Raychowdhury, Arijit},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Event-Gaze: A 28nm 441μs-Latency 12.88mW SoC for Sparse-Event-Based Dynamic Eye Tracking and Gaze Estimation in XR}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper introduces Event-Gaze, an eye-tracking and gaze-estimation SoC that natively processes asynchronous, sparse event-camera data. Using an algorithm-hardware code-sign approach, the system performs graph construction from the event stream and leverages dedicated Graph Neural Network (GNN) and Transformer accelerators to enable eye tracking and gaze estimation, respectively. Fabricated in 28 nm CMOS, the SoC achieves 1.12° accuracy with $441 \mu$ s latency while consuming 12.88 mW. Compared to baseline solutions, the proposed SoC demonstrates a $1.8 \times$ latency reduction and a 15% improvement in system power efficiency.},
  keywords={Estimation;Engines;Timing;Eyes;Printing;Algorithms;Cameras;Displays;Indexes;Indexing},
