  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3200×2880, 120Hz OLED Display Driver IC with Miller-Charge Cancellation (MCC) Achieving a $\text{13.3V} {/} {\mu}\mathrm{s}$ Slew Rate Under Worst-Case Full-Channel Load}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 2880-channel 10b driver IC for $3200 \times 2880120 \text{Hz}$ OLED displays. Miller-charge cancellation boosts the slew rate (SR) by $3.3 \times$ without static power, while a fast-slew input method relieves dynamic loading. Fabricated in 28 nm CMOS, the $10 \mu \mathrm{m}$-pitch chip attains a worst-case SR of $13.3 \mathrm{V} / \mu \mathrm{s}\left(\sigma_{\text{SR}}=7.5 {\%}\right)$ under full-channel transitions, improving color fidelity and uniformity on a 6.9-inch OLED.},
  keywords={Strontium;Displays;Organic light emitting diodes;Printing;Timing;Amplifiers;Loading},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577333},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577359,
