  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 144Gbps D-Band Dual-Polarized MIMO High-Density Phased-Array Transceiver in 65nm CMOS for 6G UE}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents the world's first D-band dual-polarized (DP) multi-input and multi-output (MIMO) phased-array transceiver targeting 6G user equipment (UE), fabricated in a 65 nm CMOS process. The proposed transceiver achieves a maximum data rate of 144 Gbps. Each IC integrates 4 vertical (V) and 4 horizontal (H) polarized TRX elements in a compact layout, resulting in power consumption per element of 124 mW in TX and 90 mW in RX. Furthermore, the transceiver is embedded within a high-power-density antenna-in-package (AiP) module, enabling long-distance single-stream communication up to 50 meters.},
  keywords={Arrays;Phased arrays;Displays;Indexes;Indexing;MIMO;Transceivers;Printing;Measurement;Integrated circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577332},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577279,
  author={Hwang, Donghoon and Jeon, Jaeho and Kim, Gwangsik and Kim, Seong Kwang and Min, Jiwoo and Kim, Hyunsoo and Moon, Byungho and Kim, Jina and Her, Jeongeun and Jeong, Kyutae and Park, Seongbin and Han, Soobin and Yoon, Hyeji and Seo, Jaehun and Ha, Younsu and Shaji, Sandra and Kumar, Aravindh and Park, Tae-Hoi and Kwon, Donghoon and Lee, Junghan and Lee, Byounghoon and Ha, Seungmo and Lee, Sang-Moon and Lee, Do-Sun and Shin, Heonjong and Lee, Wonchang and Jung, Youngchai and Simka, Harsono and Lee, Seung Hun and Park, Sang Wuk and Kwon, Wookhyun and Hyun, Sangjin and Kim, Ilryong and Song, Jaihyuk},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of 3D Stacked Fets at Gate Pitch of 42 nm Featuring Triple Stacked Nanosheet Channels for Advanced Logic Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We first present the industrial implement technology of three-dimensional stacked field effect transistors (3DSFETs) at gate pitch of 42 nm and triple-stacked nanosheet channels for n - and p-FETs, respectively. This paper provides a comprehensive overview of the key technologies required for the industrial production of 3DSFETs. Notable advancements include an epitaxial growth process that suppresses channel defect density and the incorporation of epitaxial layers with three distinct Ge contents to precisely form the middle dielectric isolation (MDI). Following the successful implementation of these essential technologies, we evaluate the electrical characteristics and discuss prospects for future logic applications.},
  keywords={Displays;Indexes;Indexing;Field effect transistors;Technology;Stacking;Optimization;Epitaxial growth;Printing;Silicon},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577279},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577252,
