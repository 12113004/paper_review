  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of Metal Interconnect At-Resolution Stitching with 0.55NA EUV Lithography for A10 Node and Beyond}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We report the first comprehensive assessment of at-resolution stitching for BEOL interconnects using 0.55NA EUV lithography, a key enabler for continued transistor scaling. With 0.55NA anamorphic optics limiting the maximum field size, at-resolution stitching is being considered to extend the field size for large chip applications. Based on experimental characterizations complemented by simulations, we demonstrate similar electrical performance and reliability for at-stitch and in-field interconnects down to metal pitch 24 nm, supporting future BEOL integration with 0.55 NA EUV lithography.},
  keywords={Printing;Displays;Indexes;Indexing;Resistance;Testing;Simulation;BEOL;interconnect;at-resolution stitching;0.55NA EUVL;electrical characterization;reliability tests},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577359},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577370,
  author={Yoon, Junghyun and Lu, Zhaonan and Lim, Yong and Tan, Zhichao and Chae, Youngcheol},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 1MHz-BW 90.1dB-SNDR CT Zoom ADC with Mismatch Error Shaping Preserving Full-Scale Input Range}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a high-resolution, CT zoom ADC with mismatch error shaping (MES) technique. While conventional MES techniques often reduce the maximum stable amplitude (MSA), the proposed ADC preserves the full-scale input range through a partial-feedback coarse $\Delta\Sigma\mathrm{M}$. To reduce the MES implementation overhead, bitwise subtraction technique is introduced. A tri-level RDAC with a dummy DAC enhances HD3 by 15.5dB by suppressing signal-dependent reference modulation. Fabricated in a 65nm CMOS, it achieves 104.8dB SFDR, 90.1dB SNDR, and 92.5dB DR in a BW of 1MHz, while consuming only 1.7mW. This corresponds to a state-of-the-art FoM of 180.2dB.},
  keywords={Printing;Distance measurement;Sigma-delta modulation;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577370},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577396,
