  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 28-GHz Quadrature LO-Phase-Shifting Digital Wave-Locked Loop (WLL) Achieving 57.2-fsrms Jitter, -80.6-dBc Spurref, and 0.59-μs Near-Integer Lock Time}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We propose a $28-\text{GHz}$ digital wave-locked loop (WLL) achieving ultra-low jitter, low reference spurs, and rapid lock time, with integrated LO phase-shifting (LO-PS) for mm -wave MIMO phased arrays. A waveform detector, using I/Q sampling and arctangent-based phase estimation (PEU) provides full- $2 \pi$ monotonic detection with high resolution. Fabricated in $28-\text{nm}$ CMOS, the WLL achieves $57.2-\text{fs} \text{rms}$ jitter and $-80.6-\text{dBc}$ reference spur at 27.375 GHz. A full 360° LO-PS range with 2.8° resolution is demonstrated, along with fast $\pm 1.5-\text{GHz}$ frequency hopping and sub $-0.59-\mu \mathrm{s}$ lock time (<74 reference cycles).},
  keywords={Printing;Distance measurement;Waves;Wireless Access in Vehicular Environments;Jitter;Timing;Frequency},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577587},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577588,
  author={Lee, Jaehoon and Min, Yeji and Sim, Jae-Yoon},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Floating-Inverter Integrator LDO Achieving Near-Zero Line Regulation via Parasitic-Synthesized Supply-Tracking Offset}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents an analog LDO achieving near-zero line regulation $(<50 \mu \mathrm{V} / \mathrm{V})$. The proposed architecture harnesses the intrinsic parasitic effect-traditionally considered a source of error-within a Floating-Inverter Integrator (FII). By operating the FII under an asymmetric loop configuration, this parasitic-induced charge is converted into a deterministic supply-tracking offset. This offset effectively synthesizes the reference modulation required to neutralize supply disturbances, bypassing the fundamental limitations of finite loop gain with negligible hardware overhead. Implemented in 40 nm CMOS, the LDO demonstrates a $50 \mu \mathrm{V} / \mathrm{V}$ line regulation and $>70 \text{dB}$ PSR, confirming that the parasitic-converted offset enables robust regulation comparable to infinite-gain systems.},
  keywords={Regulation;Gain;Loading;Frequency;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577588},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577518,
