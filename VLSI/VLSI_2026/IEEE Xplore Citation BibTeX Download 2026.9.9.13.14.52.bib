  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Intel 18A-P CMOS Technology Enhancement Featuring Advanced RibbonFET (GAA) Transistors and PowerVia for High-Performance Computing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Intel 18A-P is a performance-enhanced, RibbonFET gate-all-around (GAA) transistor technology with backside power delivery through PowerVia. Relative to Intel 18A [1], Intel 18A-P offers over 18% lower power at iso-performance, or over 9% performance gain at iso-power. This improvement is achieved through newly added technology features, transistor performance enhancement, interconnect enhancement and design technology co-optimizations (DTCO). Added features in Intel 18A-P include additional logic VT pairs, skew corner tightening, new low power devices in both high-density (HD) and high-performance (HP) libraries and performanceimproved HP devices in both libraries. In addition, Intel 18AP offers reduced thermal resistance for improved heat conduction.},
  keywords={Displays;Indexes;Indexing;Transistors;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577455},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577386,
  author={Kim, Jeongho and Park, Donghyun and Kang, Hyeri and Jeong, Minhyeok and Seo, Donguk and Lee, Kyungjun and Lee, Yoonmyung},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.511 pJ/Bit Data-Independent and Post-Processing-Free 6T-SRAM-Based TRNG Exploiting Differential Bit-Line Leakage}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 6T SRAM-based true random number generator (TRNG) that achieves the lowest reported energy among memory-based TRNGs while enabling dataindependent operation without disturbing stored data. Fabricated in 28 nm CMOS, the TRNG exploits differential bit-line leakage to eliminate post-processing and achieves $0.511 \text{pJ} /$ bit at 0.7 V while passing NIST tests. To the best of our knowledge, it is the first memory-based TRNG demonstrating fully data-independent operation, with only 2.85% energy variation across data patterns. The proposed architecture is fully compatible with conventional 6T SRAM arrays without requiring any modification to the memory cell.},
  keywords={SRAM chips;Energy;Memory;Arrays;Printing;Entropy;Very large scale integration;Noise;Design methodology;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577386},
