  author={Han, Jeehoon and Sim, Jaeryong and Kang, Seogoo and Jun, Junghoon and Park, Jihwan and Kim, Donghwan and Yu, Changyeon and Lim, Jongho and Choi, Yusik and Kim, Changmin and Yoon, Jisoo and Kim, Seonghwan and Jang, Jaehoon and Song, Jaihyuk},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Demonstration of Cell Multi-Bonding (CMB) Technology for Future Vertical NAND Over $\mathbf{1} \mathbf{k}$-Layer}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={For the first time, 900 -layer class VNAND integration was implemented by bonding two 450 -layer cell wafers. The cell wafer with a large warpage could be successfully supported in the upper chuck through an appropriate warpage design during bonding process, and the alignment deterioration that occurs in bonding between cell wafers with large warpage was also solved by applying new overlay correction technology. In addition, normal cell operation characteristics were verified based on the newly introduced the bit-line (BL) and word-line (WL) structure that can drastically improve the power consumption and chip size.},
  keywords={Cells (biology);Bonding;Displays;Indexes;Indexing;Technology},
