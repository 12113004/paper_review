  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 4.32uW/Ch 256-Channel Neural Probe Integrating In-Situ ADC and Stimulation for Closed-Loop DBS}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a 256-channel neural probe for closedloop DBS with per-channel low-power in-situ dual-looposcillator ADCs. Two operating modes are supported: neural recording with baseline stabilization and stimulation with synchronous monitoring. The $0.0010 \text{mm}^{2} /$ channel probe consumes $4.32 \mu \mathrm{W} /$ channel and achieves $3.68 \mu$ Vrms input-referred noise over a 10 kHz bandwidth. The area-energy efficiency FoM ($0.21 \text{fJ} \cdot \text{mm}^{2} /$ step) and NEF (2.69) represent state-of-the-art performance.},
  keywords={Recording;Timing;Probes;Printing;Displays;Indexes;Indexing;Oscillators;Architecture;Computer architecture;active neural probe;analog-to-digital (A/D) conversion;biomedical sensor;implantable biomedical device;multielectrode arrays;microelectrodes;neural recording},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577533},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577378,
