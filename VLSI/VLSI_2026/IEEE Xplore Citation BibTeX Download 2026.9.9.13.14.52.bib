@INPROCEEDINGS{11577610,
  author={Kim, Changjoo and Park, Sooho and Shim, Minkyun and Lee, Woojin and Kim, Hyunjin and Seo, Donghwi and Lee, Jaeuk and Kim, Chulwoo},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An 8Bit 4.8GS/s 10.9fJ/Conv.-Step TI-SAR ADC with 4Bit/3Cycle Ping-Pong Architecture and Data-Driven Zero-Overhead Background Calibration}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 4-channel $4.8 \text{GS} / \mathrm{s} 8$ bit timeinterleaved SAR ADC in 14 nm FinFET that overcomes the throughput limitations of conventional ping-pong architectures. While traditional ping-pong schemes are limited to 1bit/cycle, the proposed $4 \text{bit} / 3$ cycle architecture utilizes a background-calibrated time reference using forbidden-code detection to accelerate conversion speed. Uniquely, the design features a data-driven zero-overhead background offset calibration scheme that exploits idle cycles identified during conversion, eliminating the throughput penalty of dedicated calibration phases. The ADC achieves $\text{FoM}_{\mathrm{w}}$ of $10.9 \text{fJ} /$ conversion-step, demonstrating the best energy efficiency among state-of-the-art ADCs operating above $3 \text{GS} / \mathrm{s}$.},
  keywords={Timing;Calibration;Printing;Specific absorption rate;Synthetic aperture radar;Architecture;Computer architecture;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577610},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577583,
  author={Nian, Cheng and Mo, Xiaorui and Zhang, Jiaqi and Peng, Jiaying and Farrukh, Fasih Ud Din and Li, Yifan and Jia, Wen and Chen, Fei and Lu, Liang and Zhang, Chun},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Uni4D: A 12nm 0.16mJ/Frame 4D Gaussian Spatial Video Rendering Processor with Unified Deformation and On-Chip Hierarchical Sorting}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Uni4D is a $12-\text{nm}$ spatial video rendering processor for real-time 3D/4D Gaussian splatting with $0.16-0.52 \text{mJ} /$ frame energy. A unified deformation engine (UniMAC) combines Hex-plane sampling with MLP-based deformation, while K-plane Weights Segmentation (KWS) factorizes 3D indexing to reduce K-plane buffer area by 84%. A non-blocking key-value pair (KVP) generation engine and a hierarchical radix sorting engine jointly pipeline tile-based preprocessing and on-chip sorting, cutting Gaussian box-bounding latency by 76% and external memory access by 93.8%. Fabricated in $12-\text{nm}$ CMOS, Uni4D renders dynamic Gaussian scenes at up to 232 fps, achieving more than an order-of-magnitude lower energy than prior NeRF/3DGS processors.},
  keywords={Sorting;Planing;Rendering (computer graphics);Tiles;Indexes;Indexing;Deformation;System-on-chip;Displays;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577583},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577466,
  author={Mitarai, Yuki and Kawano, Masaya and Huang, Hung-Chih and Fukushima, Takafumi and Kuroda, Tadahiro and Hamada, Mototsugu and Kosuge, Atsutake},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={3D Orthogonal Die Stacking Technology for DRAM-on-GPU Integration Using Contactless Die-to-Die Interface}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Massive orthogonal stacking assembly of IC (MOSAIC) technology was demonstrated to overcome thermal limitations in 3D memory-on-GPU configurations. By stacking memory dies orthogonally to the GPU, heat is dissipated effectively, enabling twice the memory capacity. A contactless die-to-die interface, achieving up to $4 \text{Gbps} / \text{ch}$ in a prototype, mitigates assembly challenges, enabling TSV-free 3D integration.},
  keywords={Dies;Graphics processing units;Memory;Coils;Stacking;Printing;Technology;Timing;Assembly;Modeling;Advanced packaging;3D integration;contactless interface},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577466},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577379,
  author={Lyu, Haoran and Chen, Yulong and Li, Humiao and Yang, Zhengke and Liao, Wang and Li, Jiamin and Lin, Longyang},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Full-MWPM Surface Code Decoder with On-the-Fly Weight Computation and Cross-Platform Adaptability Achieving 1.9×10-6 LER and 20.8-ns Decode Time at 4K}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A cryo-CMOS surface code decoder supporting full minimum-weight perfect matching (MWPM) up to distance-21 is presented. The design employs on-the-fly weight computation to reduce weight memory area by $989 \times$, a parallel matching engine for full MWPM, and lock-pair-based speed tuning for cross-platform speed adaptability. The $40-\text{nm}$ test chip achieves a logical error rate of $1.9 \times 10^{-6}$ with a 20.8 ns decode time at 4K, providing a $3.3 \times$ to $612 \times$ speedup over prior art while consuming 2.46nJ per decode.},
  keywords={Decoding;Timing;Codes;Surfaces;Printing;Qubit;Technology;QEC;surface code;MWPM;cryo-CMOS},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577379},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577321,
  author={Chung, Hyunwon and Senta, Parin and Yu, Jason and Fang, Yukun and Abillama, Pierre and Chen, Kuan-Yu and Dreslinski, Ronald and Blaauw, David and Kim, Hun-Seok},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 248.5 $\text{GFLOPS}/\text{mm}^{2}$, 1.67 TFLOPS/W Streaming Processor with Hardware-Level Scheduling for Advanced Spectrum Sensing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a fast-programmable streaming processor for spectrum sensing in dynamic RF environments. To respond to rapidly changing RF channels, the 2D array of 77 processing elements is tightly integrated with a light-weight kernel launcher that achieves 10 ns array reconfiguration without host-CPU intervention. The processor is able to analyze multiple heterogeneous signals/channels in highly dynamic conditions and achieves a compute density of 248.5 GFLOPS $/ \text{mm}^{2}$ and an energy efficiency of 1.67 TFLOPS/W.},
  keywords={Kernel;Arrays;Memory;Timing;Very large scale integration;Printing;Displays;Indexes;Indexing;Measurement units},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577321},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577215,
  author={Hsieh, Yi-Yen and Chang, En-Jui and Teng, Chieh-Fang and Huang, Po-Hua and Kuo, Hsien-Kai and Chou, Hsing-Chang and Yang, Kai-Siang and Ou, Shiyi and Huang, Chiao-Chun and Xue, Cheng-Xin and Hung, Wei-Ting and Wan, Zhe and Lin, Hung-Wei and Jedhe, Gajanan and Chu, Yi-Chen and Chang, Tun-Yi and Chou, Chia-Hsien and Lee, Kun-Geng and Wang, Perry H. and Deshpande, Chetan and Liang, Jenwei and Lin, Chien-Hung and Lin, Tsung-Yao and Jou, Yucheun Kevin},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={TinyNPU: A3nm 0.06-134.36 μJ/Token DCIM-Based Ultra Low Power NPU for Always-On Reasoning on Wearables}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Tiny neural processing unit (TinyNPU) is the first commercial $3-\text{nm}$ DCIM NPU for ultra-low-power always-on reasoning (AoR) in wearables. By co-optimizing the DCIM architecture, an L1-efficient composite flow, and softwarehardware (SW-HW) co-optimized scheduling, it delivers 1.47 TOPS with 512 8-bit MACs and 256 KB on-chip memory. Measurement results show up to 10 days of battery life on smart glasses and $31.8 \times$ less energy on Transformer models vs. state-of-the-art works, enabling efficient next-generation AoR.},
  keywords={Displays;Indexes;Indexing;Modeling;Printing;Fluid flow;Timing;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577215},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577372,
  author={Huo, Yong and Cao, Yuefeng and Zhang, Minglei and Zhu, Yan and Martins, Rui. P. and Chan, Chi-Hang},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 14b 500MS/s Pipelined-SAR ADC with Loop-Unrolled Correlated Level Shifting and Rapid Sequential Sampling}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a $14 ~\mathrm{b} 500 \text{MS} / \mathrm{s}$ PipelinedSAR ADC, which features the loop-unrolled correlated level shifting (LU-CLS) and rapid sequential sampling (RSS) to enable a swift, accurate and PVT-robust residue amplification at wideband inputs. The ADC achieves 70.12 dB SNDR at the Nyquist input and consumes 7.6 mW, leading to 175.3 dB FoMs.},
  keywords={Printing;Timing;Gain;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577372},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577438,
  author={Hao, Weibing and Xie, Jiawei and Jiao, Leming and Lu, Jingguang and Sun, Chen and Wang, Yuxuan and Ni, Kai and Liang, Gengchiau and Gong, Xiao},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Breaking Mobility–${V}_{\text{th}}-{R}_{\text{sd}}$ Trade-off in Oxide Semiconductor FETs: Novel p-NiO Junction Engineering}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={For the first time, junction engineering using a p-type NiO capping layer is implemented in ITO FETs, simultaneously enabling a significant positive threshold voltage $(V_{\text{th}})$ for enhancement-mode operation, preservation of channel mobility $(\mu_{\text{eff}})$, and reduction of source/drain series resistance $(R_{\text{SD}})$, capabilities that are unattainable through conventional channel thickness $(T_{\text{CH}})$ engineering. By modulating the carrier concentration of p-type NiO, a 2 V positive shift in $V_{\text{th}}$ is achieved together with a field-effect mobility of 34 $\text{cm}^{2} / \mathrm{V} \cdot \mathrm{s}$ and a $1.5 \times$ enhancement in on-state current $(I_{\text{ON}})$ in long-channel devices $\left(L_{\text{CH}}=10 \mu \mathrm{m}\right)$. Enhancement-mode operation is also realized in shortchannel devices $(L_{\text{CH}}=150 \text{nm})$, delivering a $V_{\text{th}}$ of 0.6 V and a $2.9 \times$ improvement in $I_{\text{ON}}$ compared with control devices, owing to the combined benefits of mobility preservation and $R_{\text{SD}}$ reduction. Moreover, relative to devices without NiO, the proposed devices exhibit a much lower subthreshold swing of $28 \text{mV} / \text{dec}$ at 77 K, along with excellent wafer-scale uniformity.},
  keywords={Printing;Very large scale integration;Field effect transistors;Displays;Junctions;Indexes;Indexing;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577438},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577277,
  author={Hou, Yaoru and Xiao, Zhihua and Wu, Xuezhao and Wang, Shuyu and Zhu, Zheng and Wu, Di and Wang, Jiayong and Li, Yuesheng and Cai, Hao and Shao, Qiming},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 28nm CMOS-Integrated VCMA-MTJ Dual-Function Macro for Deterministic In-Memory Computing Synapses and Stochastic Poisson Neurons in Hybrid Vision}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Unlike current-driven spintronic devices, Voltage-Controlled Magnetic Anisotropy (VCMA) Magnetic Tunnel Junctions (MTJs) utilize electric-field-induced switching to overcome energy bottlenecks and enable tunable stochastic behavior. This work presents a 28 nm CMOS-integrated VCMA-MTJ dual-function macro that employs a single spintronic device to support both deterministic and stochastic neuromorphic primitives. The integrated VCMA-MTJs function as deterministic in-memory-computing (IMC) synapses for signed-weight storage and array-level MAC operations, while their voltage-tunable probabilistic switching enables the implementation of stochastic Poisson neurons. The fabricated macro is validated in a hybrid ANN/SNN hardware platform for frame-event hybrid vision detection, achieving 92.5% inference accuracy and 411 TOPS/W energy efficiency. These results demonstrate the potential of VCMA-MTJ devices as a promising solution for low-power, high-accuracy neuromorphic computing.},
  keywords={Modeling;Printing;Technology;Arrays;In-memory computing;Displays;Indexes;Indexing;Switches;Neurons},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577277},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577250,
  author={Kalogerakis, Georgios and Song, Sanquan and Xu, Li and Mehta, Nandish and Rekhi, Angad and Nedovic, Nikola and Lee, Benjamin G. and Zimmer, Brian and Tell, Steve and Nishi, Yoshinori and Chen, Xi and Lopes, Ward and Greer, Trey and Gray, C. Thomas},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A $\mathbf{3 2 G b} / \mathbf{s}$ Optical Receiver Utilizing a Differential TIA with $- 1 7. 3 d B m$ Sensitivity in a 3D-Stacked Silicon Photonics Platform}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a $32 ~\text{Gb} / \mathrm{s}$ optical receiver that utilizes a differential transimpedance amplifier (TIA) from a single supply in a 3D-stacked silicon photonics (SiPh) platform. The receiver sensitivity (in terms of Optical Modulation Amplitude or OMA) at the photodiode (PD) is -17.3 dBm and -18.9 dBm at $32 ~\text{Gb} / \mathrm{s}$ and $28 ~\text{Gb} / \mathrm{s}$, respectively. The energy efficiency at $32 ~\text{Gb} / \mathrm{s}$ is $0.484 \text{pJ} / \mathrm{b}$. The receiver consists of a 7 nm FinFET CMOS electronic IC (EIC) stacked on top of a 65 nm silicon photonics IC (PIC) via $\text{Cu}-\text{Cu}$ hybrid bonding.},
  keywords={Cathodes;Receivers;Displays;Indexes;Indexing;Sensitivity;Personal digital devices;Printing;Circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577250},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577364,
  author={Kim, Jongwha and Jo, Yongwoo and Min, Seongyun and Chun, Juntak and Shin, Yuhwan and Song, Hyunjun and Kwak, Seohyeon and Park, Kwanseo and Choi, Jaehyouk},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 16.8-33.6 Gb/s, 0.93pJ/b Direct-Frequency-Tracking Digital CDR with an SSC Profile Replicator for Per-Lane Data-Rate Variation and High Jitter Tolerance Under Deep SSC}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a direct frequency-tracking (DFT) CDR that supports flexible per-lane data rates and improves jitter tolerance (JTOL) under deep spread-spectrum clocking (SSC). A $\Delta \Sigma \mathrm{M}-{}$ based fractional-$N$ PLL directly tracks frequency offset, while an SSC profile replicator (SSC-PR) eliminates SSC-induced phase error in a type-II loop. The proposed CDR in 28 nm CMOS demonstrates wide data-rate flexibility from 16.8 to 33.6 Gb/s and improved JTOL under up to 7000 ppm SSC. Operating at 0.7 V without power-hungry phase interpolators (PIs), the highly digital CDR achieves an excellent energy efficiency of 0.93 \pJ/b.},
  keywords={Frequency;Printing;Jitter;Discrete Fourier transforms;Phase locked loops;Tracking;Displays;Indexes;Indexing;Clocks},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577364},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577392,
  author={Seo, Donguk and Choi, Youjin and Kim, Mingyu and Kim, Heeyeon and Lee, Kyungjun and Kim, Jaerok and Kim, Donggyu and Han, Shin and Lee, Yoonmyung},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 16 Mb 28 nm FD-SOI STT-MRAM Achieving 2.0 ns Read Access Time at 0.9 V via a PVT-Variation-Tolerant Dual-Reference Sensing Scheme}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A 16 Mb STT-MRAM is presented in 28 nm FD-SOI. To address PVT-induced read margin degradation, a read interface combines a dual-reference sense amplifier (DRSA) with an array-adaptive dual-reference (AADR) scheme. This technique extends the read window by tracking local resistance variations. The proposed sensing scheme expands the normalized zero-BER read window by $2.00 \times, 2.34 \times$, and $2.62 \times$ compared to a conventional scheme at $-40^{\circ} \mathrm{C}, 25^{\circ} \mathrm{C}$, and $125{ }^{\circ} \mathrm{C}$, respectively. The chip achieves a 2.0 ns read access time at $0.9 \mathrm{V} / 25^{\circ} \mathrm{C}$ and 3.3 ns at 125 °C with $\text{BER}=0$.},
  keywords={Arrays;Timing;Printing;Bit error rate;Very large scale integration;Displays;Indexes;Indexing;Cells (biology);Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577392},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577415,
  author={Li, Mengyu and Yang, Xiaolin and Rodriguez, Alejandro Lopez and Duckert, Bastien and Neutens, Pieter and Jaramillo, Valentina Restrepo and Coppejans, Phillippe and Lopez, Carolina Mora},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 300-Channel Photometry Neural Probe with In-Pixel Adaptive-Noise $\boldsymbol{\Delta} \boldsymbol{\Sigma}$ Modulators Achieving $\mathbf{1 6. 8 ~ f A} / \sqrt{ } \mathbf{H z}$ Noise for High-Sensitivity Fluorescence Recording}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a 300 -channel photometry neural probe with in-pixel readout for scalable, high-resolution fluorescence sensing. Each channel integrates an on-chip photodiode and a $\Delta \Sigma$-based adaptive-noise readout with serialized data transfer. By exploiting a duty-cycled unipolar current DAC (IDAC) with a passive integrator, the readout achieves an adaptive noise floor with a compact implementation. The input-referred noise decreases at lower signal levels, enabling an 88.7 dB dynamic range which is 12 dB higher than the peak SNR. The system achieves an ultra-low noise floor of $16.8 \text{fA} / \sqrt{ } \text{Hz}$ while consuming 70 nW per channel. Each channel occupies $0.0015 ~\text{mm}^{2}$ with a $25 \mu ~\mathrm{m}$ pitch, supporting high-spatialresolution neural recording along the probe shank.},
  keywords={Noise;Photometry;Probes;Printing;Current;Signal to noise ratio;Personal digital devices;Pixel;Displays;Fluorescence},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577415},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577228,
  author={Xie, Wenao and Li, Zhongqi and Chen, Jiaer and Yoo, Jerald and Yoo, Hoi-Jun},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Silicon-Oracle (Soracle): A Multi-Modal Autoregressive Model Accelerator for Context-Aware Assistance on Mobile Platform}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents Soracle, a multi-modal autoregressive (AR) model accelerator for context-aware assistance. It integrates a mixed-precision exponent-tracked LUT-counter MAC unit and a row-broadcast/column-unicast AR core for EMA-free, headlocal attention execution. Weight storage and transfer overhead are further reduced by slice-shared $\log _{2}$-partition quantization and bandwidth-aligned, stride-adaptive streaming. Soracle also reduces redundant token computation via exponent-aligned dominant-token extraction and dominance-trackable attention process. Fabricated in 28 nm FDSOI with a die area of 20.25 $\text{mm}^{2}$, Soracle achieves state-of-the-art $83.93 \text{mJ} /$ frame energy consumption and $0.671 \mathrm{s} /$ frame image generation speed.},
  keywords={Argon;Printing;Modeling;Image processing;Image synthesis;Timing;Media Access Control;Technology;Measurement units;Broadcasting},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577228},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577619,
  author={Kim, Jung-Kyun and Yoo, Sijung and Jo, Sanghyun and Hyun, Seung Dam and Park, Yoonsang and Kim, Taek Jung and Kim, Kihong and Song, Kyung Mee and Kim, Donghoon and Jung, Kyooho and Yang, Jee-Eun and Jang, Younjin and Han, Na-Rae and Chae, Byeong Gyu and Won, Jung Yeon and Lee, Hyangsook and Heo, Jinseong and Kim, Yongsung and Kim, Sangwook and Choe, Duk-Hyun},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Elucidating the Role of Channel Materials and Interlayers in Ferroelectric NAND}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Oxide-semiconductor (OS) channels are being actively explored for ferroelectric NAND (FeNAND), but their impact relative to Si channels remains poorly understood under fully identical device conditions. Here, we systematically compare Si - and OS-channel FeNAND devices, explicitly isolating the channel-induced effects within an identical top-gated structure and process. We find that OS channels exhibit a strongly asymmetric switching behavior, leading to a reduction of the memory window by more than half and its complete confinement to the negative $\mathrm{V}_{\text{th}}$ regime. We further show that introducing a high-$k$ channel interlayer (Ch.IL) effectively recovers the degraded memory window. Moreover, the Ch.IL is found to be essential for ensuring stable operation in OS-channel FeNAND. These results highlight critical design considerations for channel and interlayer engineering in FeNAND devices.},
  keywords={Displays;Indexes;Indexing;Silicon;Polarization;Materials;Printing;Very large scale integration;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577619},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577594,
  author={Liu, Szu-Lin and Lien, Bei-Shing and Lai, Wie-Lin and Lu, Yi-Chen and Jen, Ching-Lin and Peng, Yung-Chow and Hsieh, Kenny Cheng-Hsiang},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.75V, 1.43%-Inaccuracy 4T MOS-Based Voltage Reference in $251 \mu \mathrm{m}^{2}$ Area}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 4-transistor (4T) MOS-based voltage reference in a 3 nm FinFET node. By using single threshold voltage (VTH) design and identifying the temperature-slope correlation between the required CTAT voltage and the nMOS-VTH, this voltage reference achieves a $3 \sigma$-inaccuracy of 1.43% and a temperature coefficient (TC) of 42.7 ppm/° C from a 0.75 V -supply. The whole circuit consumes $12 \mu \mathrm{W}$ power and only occupies area of $251 \mu \mathrm{m}^{2}$.},
  keywords={Voltage;Temperature;Design methodology;Printing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577594},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577617,
  author={Kim, Seungbin and Jeong, Hoichang and Kim, Dongwook and Kim, Jiwon and Lee, Kyuho Jason},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={HCNP: A 70.2 TOPS/W Hybrid CIM-NPU Processor with In-Streaming Processing for Energy-Efficient CNN/Transformer Acceleration in HMD}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents HCNP, an energy-efficient hybrid CIMNPU processor designed to accelerate diverse DNN topologies under strict power constraints of head-mounted display (HMD) platforms. Unifying CIM and NPU architectures through instreaming processing enables layer fusion (LF), reducing offchip access by 79.7%. NPU core co-designed with runtime KV cache eviction (RKVe) reduces 79.8% memory footprint and 32.1% computation. Optimizing flexible-route network-onchip (FR-NoC) and single-column-multiple-output (SCMO) architectures facilitates hierarchical inter-/intra-core dataflow strategy, maximizing 81.8% CIM utilization. Fabricated in 28 nm CMOS technology, HCNP achieves 70.2 TOPS/W, reducing energy consumption by 32.3% and 93.6% compared to CIM [7] for mobile-targeted CNNs (MCNNs) and NPU [8] for large language models (LLMs), respectively.},
  keywords={Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;In-memory computing;Large language models;Printing;Architecture;Computer architecture;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577617},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577497,
  author={Gu, Zhiwen and Pham, Hieu and Le, Hanh-Phuc},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 48V-5V Coupled-Inductor Middle-Switched-Capacitor Hybrid GaN Converter Achieving 156µH Equivalent Inductance and 30mA Ripple}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a middle-switched-capacitor (MSC) hybrid converter that employs coupling between the input and output planar inductor to achieve ideally ripple-free currents at the output, and a synchronous L-C path to also achieve the same at the input. Implemented in a $0.5-\mu \mathrm{m}$ GaN-on-Silicon process, the $8.58-\text{mm}^{2}$ MSC converter prototype achieves 30 mA output current ripple and 160 mA input current ripple, amounting to 48.8 X and 9.5 X ripple reduction, respectively.},
  keywords={Current;Inductors;Converters;Joining processes;Switches;Printing;Steady-state;Voltage;Capacitors;Topology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577497},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577611,
  author={Song, Y. S. and Park, K. D. and Lee, W. and Lee, K. and Yang, H. M. and Koo, B. J. and Jang, G. and Lee, C. H. and Park, W. H. and Park, J. H. and Wu, Z. and Oh, S. C. and Park, K. M. and Lee, S. H. and Yoon, S. J. and Kim, T. Y. and Lee, S. H. and Shim, M. and Kim, D. S. and Ko, S. P. and Ha, D. and Ahn, S. J. and Song, J. H.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Decoupling Dual Degradation Pathways in OTS Endurance for High-Reliability Selector-Only Memory}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We reveal two distinct degradation pathways for Ovonic threshold switch endurance: irreversible threshold voltage broadening from fatigue-driven elemental loss and partially reversible probabilistic reset-misread caused by filament instability. Their opposite stress dependences establish a unified framework validated by multi-scale experiments and simulations. Guided by this model, composition and bias co-optimization suppress both modes, achieving $>10^{8}$-cycle endurance in a fully integrated $14-\text{nm}$ Selector-only memory.},
  keywords={Displays;Indexes;Indexing;Degradation;Fatigue;Optimization;Stress;Writing;Cells (biology);Human factors},
