  title={4nm FinFET CMOS Logic Embedded 1T Contact RRAM}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={An ultra-high density 4nm FinFET CMOS logic embedded 1T Contact RRAM (CRRAM) is firstly developed in advanced TSMC 4 nm FinFET CMOS logic platform with a small unit size of $0.0103 \mu \mathrm{m}^{2}/\text{cell}$ for high performance SOC applications. The new 4 nm FinFET 1T CRRAM consists of one 4 nm n-type FinFET core device in serial of an innovated contact TMO to form the FinFET CRRAM cells. The Ti based oxynitride TMO served as a memristive storage is fabricated by FinFET contact Ti silicidation and ALD ILD processes. Besides, the ultra-high density 4 nm FinFET 1T CRRAM is fully compatible with 4 nm CMOS logic FinFET platform without extra mask and process, and the specific FinFET contact TMO structure can be adapted to next generations of CMOS FinFET and NSFET technology platforms. Furthermore, the firstly developed 4 nm FinFET 1T CRRAM exhibits quite stable and high performance operations with good reliability and high scalability, which are leading the high density 4 nm FinFET CMOS logic embedded 1T CRRAM to be a promising embedded memory solution in the future of HPC, AI, and SoC applications.},
  keywords={Contacts;Technology;Logic;Cells (biology);Memory;Resistive RAM;Arrays;RRAM;FinFET;Embedded;Contact;Memory;TMO},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577518},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577388,
  author={Kale, Saurabh and Wicht, Bernhard},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 48 V, 25 W, 6.78 MHz Self-Starting Class-D WPT Transmitter with Self-Biasing and Autonomous Clocking Achieving 91% Peak DC-DC Efficiency}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a self-sustained Class-D wireless power transmitter operating without auxiliary supplies or level shifting. High-side bias is generated using dual-edge capacitor charge harvesting, reducing the required harvesting capacitance, while switch-node voltage sensing is used for autonomous clock recovery eliminating cross-domain gate control. A dedicated startup mechanism initializes operation from rest, enabling entire operation solely with a DC bus voltage and a single clock input. Implemented with a monolithic control stage driving a discrete GaN half-bridge, the system delivers 25 W at 6.78 MHz from 48 V with 91 % DC-DC efficiency over 40 mm transfer distance.},
  keywords={Clocks;Printing;Capacitors;Transmitters;Timing;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577388},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577308,
  author={Ding, Cong and Gao, Mingxiang and Zhao, Shaokang and Kuster, Niels and Tajalli, Armin and Shoaran, Mahsa},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 50-mm2 Crystal-Free Bidirectional WPDT System with Carrier-Reuse Clocking for Implantable Neural Interfaces}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Neural implants require compact and energy-efficient wireless power and data transfer (WPDT) while avoiding reliance on costly on-board clock sources. This work presents a crystal-free, full-duplex WPDT link that reuses a 500-MHz power carrier as the sole system clock for synchronized downlink and uplink telemetry. A clock-data recovery (CDR)-less coherent ASK downlink achieves 5 Mb/s, while maintaining uninterrupted power transfer through a 6-mm implant loop. The recovered 500-MHz carrier also wirelessly locks a fast-settling UWB PLL, enabling a duty-cycled uplink supporting 5-500Mb/s. Burst-mode operation enables data-rate-scalable uplink power, ranging from 0.23 mW at 5 Mb/s to 4.93 mW at 500 Mb/s, and extends the uplink range to 40 cm using an on-chip antenna. The complete system, including the loop antenna and chip, occupies 50 mm2.},
  keywords={Uplink;Printing;Distance measurement;Downlink;Phase locked loops;Timing;Joining processes;Clocks;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577308},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577435,
  author={Jung, H. and Son, M. and Chung, W. and Shim, J. and Kim, Y. and Yang, J. and Sato, H. and Noh, S. and Kim, D.S. and Choi, J. and Kwon, H. and Ji, N. Y. and Lee, K. and Park, J. and Kim, C. and Kim, W. K. and Jung, J. and Park, J.-H. and Han, S. H. and Lee, B. and Kang, G. and Ko, S. and Hyun, S. and Ahn, S. J. and Song, J. H.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Automotive-Grade 5 nm Embedded MRAM with Robust Read Margin from −40°C to 150°C via Co-Optimized MTJ and Integration}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We demonstrate the first 5 nm embedded MRAM (eMRAM) with 2T1R cell architecture that meets automotive-grade reliability requirements. By implementing a co-optimized process flow, we simultaneously enhanced key device metrics: tunneling magnetoresistance (TMR) by 15%, breakdown voltage by 15%, and suppressed bitline leakage current by over >6 orders of magnitude, significantly improving device reliability and scalability. The device shows no hard failures in both read and write operations, maintains robust read margin across $-40^{\circ} \mathrm{C}$ to 150 °C, and meets the automotive grade raw bit error rate (BER) requirement. This work enables 5 nm eMRAM for automotive SoCs targeting AEC-Q100-level reliability, overcoming key scaling challenges in photolithography, dielectric integrity, and inter-cell leakage.},
  keywords={Displays;Indexes;Indexing;Tunneling magnetoresistance;Optimization;Cells (biology);Automotive engineering;Resistance;Technology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577435},
