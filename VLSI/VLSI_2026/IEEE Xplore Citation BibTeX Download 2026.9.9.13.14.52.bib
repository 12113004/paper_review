  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Single Exposure 137 dB Dynamic Range CMOS Image Sensor with Low Dielectric Absorption Image Lag}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a 2897 × 1877 CMOS image sensor with a $3.0 \mu \mathrm{m}$ pixel pitch. The proposed sensor achieves a 137 dB single-exposure dynamic range (SEDR) at 85 °C and a 28 dB junction SNR at 105 °C. The sensor employs a sub-pixel architecture with 3D-MIM technology and includes a function to reduce the dielectric-absorption image lag. The combination of high dynamic range and reduced dielectric-absorption image lag makes the sensor well-suited for automotive applications.},
  keywords={Pixel;Image sensors;Timing;Displays;Indexes;Indexing;Dielectrics;Technology;Absorption;Distance measurement},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577396},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577473,
  author={Abdi, D. and Singh, A. and Weckx, P. and Sharma, A. and Boemmels, J. and Yang, S. and Verschueren, L. and Hellings, G.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={5T+1 CFET SRAM with Dual-Bitline-Per-Cell-Height Enabling Differential Readout and 12.5% Area Reduction}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents the 5T+1 CFET SRAM, a 5Tfootprint bitcell exploiting vertical $\mathrm{n} / \mathrm{p}$ stacking to integrate a transmission-gate access device without area penalty. A dual-bitline-per-cell-height architecture is proposed to enable differential sensing using the bitline of an unselected cell as a reference. The bitcell integrates a split–$\mathrm{V}_{\text{DD}}$ in-bitcell writeassist to improve writability without impacting bitcell footprint. DTCO evaluation shows 12.5% smaller bitcell than 6T CFET, $7-15 {\%}$ faster write, and 21% standby leakage reduction, while maintaining comparable RSNM and $>150 \text{mV}$ five-percentile HSNM for unselected cells during write under split–$\mathrm{V}_{\text{DD}}$.},
  keywords={SRAM chips;Writing;Cells (biology);Printing;Stacking;Arrays;Technology;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577473},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577620,
  author={Kanchwala, Mustafa and Xu, Jianxiong and Abdolrazzaghi, Mohammad and Kim, Wonjune and O'Leary, Gerard and Huang, Yu and Ma, Junyu and Filho, Jose Sales and Nag, Sudip and Cai, Hanfeng and Deng, Qiaosong and Deng, Weian and Mutyala, Anush and Kumaresan, Theeban and Ren, Shidu and Lim, Chae and Movahed, Mandana and Moradi, Homeira and Eleftheriades, George and Valiante, Taufik A. and Robinson, Jacob T. and Genov, Roman},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Split-Inference Intracortical Interface IC for Battery-Free mm-Scale Magnetoelectrically Powered Brain Implants}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a brain-interfacing IC that enables depth-scalable edge inference within the tight form factor and energy budget of a minimally invasive, battery-free implant. A $181-\text{dB}$ FoM noise-shaping SAR ADC with an LNA is shared across 20 of 32 recording electrodes. On-chip inference combines boosted decision-stump spike classification with first-layer spiking- and deep-neural-network (SNN/DNN) inference, reducing the output data rate by up to $16,732 \times$. An event-based body-coupled communication (BCC) TX streams intermediate activations to a wearable device for remaininglayer execution. The communication and computation energy costs are 1.23 nW and 53 nW per input, respectively, enabling wireless powering by a mm -scale magnetoelectric film.},
  keywords={Displays;Indexes;Indexing;Printing;Timing;Joining processes;Biological tissues;Technology;Integrated circuits},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577620},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577634,
  author={Dutta, Ananya and Peer, Akshit and Siddiqui, Saima and Bunyan, Jonathan and Feng, Weijie and Huang, YuWen and Jezewski, Christopher and Jordan, Robert and Kalita, Abinasha and Kevek, Joshua and Khora, Emmannuel and Krist, Brian and Mehta, Nikhil and Metz, Matthew and Seidel, Robert and Shih, En-Min and Sukrittanon, Supanee and Kobrinsky, Mauro},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Performance Improvement from Subtractive Ruthenium Interconnects with Airgap}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={Subtractive ruthenium (sRu) interconnects have shown great promise for future interconnect pitch scaling, especially for pitch ≤ 22 nm. In this publication, we first demonstrate R&D results from a fully functional sRu and airgap (AG) interconnect architecture integrated with RibbonFET devices on an advanced R&D test vehicle. Implementation of sRu interconnects with airgaps resulted in approximately 2% ring oscillator frequency improvement at matched leakage, as compared to a damascene Cu reference, primarily driven by a significant line-to-line capacitance reduction. Airgap is shown to enable up to a 35% reduction of line-to-line capacitance. We also identified opportunities to improve via resistance by up to 50% for both upper and lower vias.},
  keywords={Air gaps;Displays;Silver;Indexes;Indexing;Copper;Metals;Technology;Capacitance;Kelvin},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577634},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577393,
  author={Lin, Hong-De and Su, Yuan-Chun and Su, Tzu-Chuan and Ambrosi, Elia and Wu, Cheng-Hsien and Kuo, Cheng-Chen and Chang, Chih-Yu and Chiang, Hung-Li and Wei, Ting-Hua and Hsu, Yu-Wei and Huang, Ching-Shuan and Lee, Sin-Yue and Chang, Wei-Ning and Fu, Jui-Han and Tung, Vincent and Sun, Jack Y.-C. and Hu, Chenming and Wu, Chih-I and Lin, Chao-Cheng and Hou, Tuo-Hung and Bao, Xinyu and Lee, Tsung-En},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of Heterogeneous n-IGZO/p-WSe2 Integration as a Power-Performance Area Booster for BEOL Complementary Gain-Cell Memory}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents the first demonstration of a BEOL-compatible complementary two-transistor gain cell (2T GC) memory, featuring a heterogeneous integration of an oxide semiconductor (OS) nFET as the write transistor and a 2D-material pFET as the read transistor. At a scaled channel length $\left(\mathrm{L}_{\text{CH}}\right)$ of 50 nm and width $\left(\mathrm{W}_{\text{CH}}\right)$ below 100 nm, both n-IGZO and p-WSe ${ }_{2}$ FETs exhibit large $\mathrm{I}_{\text{on }} / \mathrm{I}_{\text{off }}\left(>10^{8}\right)$, leading to the record-high read current $(\mathrm{I}_{\text{RBL }} \sim 22 \mu \mathrm{A})$ and $\mathrm{I}_{\text{RBL margin}}$ of $1.5 \times 10^{5}$ for high-speed read operation. Though aggressive cell size scaling increases the challenge of capacitive coupling, the counter-coupling inherited from the NP-GC effectively reduces the coupling-induced voltage drop at the storage node by $\sim 0.57 \times$ during the read operation. The read margin $(\mathrm{V}_{\text{margin}})$ is enhanced by $\sim 1.52 \times$ through the optimization of the proposed n-OS/p-2D 2T GC structure. This design provides a scalable pathway toward high-density multilayered cache memory stacked on advanced CMOS technology.},
  keywords={Couplings;Joining processes;Timing;Displays;Indexes;Indexing;Tin;Printing;Modeling;Cells (biology)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577393},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577604,
  author={Bader, Samuel J. and Vora, Heli and Chen, Po-Han and Jha, Saket and Frolov, Dimitri and Khandelwal, Isha and Jayaprakash, Shreyas S. and Koirala, Pratik and Oni, Adedapo and Beumer, Michael and Golani, Prafful and Zubair, Ahmad and Hoff, Thomas and Vyatskikh, Andrey and Radosavljevic, Marko and Rangaswamy, Jagdish and Momson, Ibukunoluwa and Yu, Qiang and Rami, Said and Sarkar, Soumen and Le, Hanh-Phuc and Then, Han Wui},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 300mm Monolithic GaN MOSHEMT and Si pMOS Technology Demonstrating Energy-Efficient Multi-Thousand-Gate Digital Logic for Power Management}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work demonstrates multi-thousand-gate, standard-cellbased digital circuits realized in a monolithic GaN nMOS and Si pMOS process. First, we report a 32 -bit simplex serialperipheral interface for configuring on-chip designs. Second, we report a record power-delay-product of $6.2 \text{aJ} /$ stage for a 7213-stage ring oscillator (>3 orders more efficient than GaN DCFL). These circuits show that “GaN+Si” technology expands the viable scale of monolithically-integrated controls for GaN power delivery and RF applications.},
  keywords={Generative adversarial networks;Printing;Displays;Indexes;Indexing;Silicon;Inverters;Technology;Delays;Design methodology},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577604},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577346,
  author={Lee, Donggun and Song, Kyoungseok and Rhee, Sangho and Kim, Tae Wook},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3.25-Gb/S 0.74-pJ/bit IR-UWB Transmitter Using Edge-Reference Differential Phase Shift Keying (ER-DPSK)}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a high-data-rate, low-power impulse-radio ultra-wideband (IR-UWB) transmitter employing edge-reference differential phase-shift keying (ER-DPSK). ER-DPSK uses the rising edge of each pulse as an inherent phase reference and encodes data in the phase difference between adjacent pulses. ER-DPSK eliminates the need for power-hungry phase-locked loops (PLLs) and preamble-based synchronization. ER-DPSK is compatible with pulse-position modulation (PPM), pulse-width modulation (PWM), and frequency-shift keying (FSK), enabling high-order hybrid modulation. The transmitter achieves 3.25 Gb/s with an energy efficiency of 0.74 pJ/bit. To the best of our knowledge, this is the first IR-UWB transmitter to reach the 3-Gb/s class while breaking the 1-pJ/ bit energy-efficiency barrier.},
  keywords={Erbium;Phase shift keying;Modulation;Synchronization;Phase locked loops;Pulse width modulation;Transmitters;Timing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577346},
