  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 50M Pixels 1.22μm Pitch Pixel Image Sensor with 100dB Single Exposure Dynamic Range by Triple Conversion Gain and LOFIC}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents the world's smallest $1.22 \mu \mathrm{m}$ pixel pitch, 50-megapixel triple conversion gain sensor with a low read noise of $0.73 \mathrm{e}^{-} \text{rms}$, a high full well capacity of $250 \text{ke}^{-}$ and single exposure dynamic range of 100 dB. To achieve this, a new pixel architecture is introduced that incorporates a transfer-gate-type LOFIC and separates the reset and source-follower drains.},
  keywords={Pixel;Gain;Image sensors;Displays;Indexes;Indexing;Technology;Personal digital devices;Noise;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577575},
  ISSN={2158-9682},
