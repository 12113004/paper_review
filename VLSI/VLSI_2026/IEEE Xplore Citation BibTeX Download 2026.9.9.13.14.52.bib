  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 256-Channel, 32-Interconnect, 1.25-NEF, in Vitro and In Vivo Neural Interface With Auto-Calibrated Input Impedance Boosting and on-Chip Spike Detection for Flexible Capacitive Microelectrode Array}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a capacitive neural interface for 256 -channel simultaneous recording with 32 interconnects. Fabricated in a $22-\text{nm}$ CMOS, the prototype is evaluated using two flexible capacitive microelectrode arrays (MEAs) for in vitro and in vivo applications. To the authors' best knowledge, this is the first to demonstrate in vivo or in vitro measurement of the series-parallel amplifiers (SPA). The proposed system achieves a noise efficiency factor (NEF) of 1.25 and 0.81, measured with and without the ADC, respectively, which are the lowest among the AFEs reporting in vivo or in vitro results.},
  keywords={Printing;Displays;Indexes;Indexing;Noise;In vivo;Capacitance;Recording;Technology;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577263},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577314,
  author={Lin, Qiuyang and Sijbers, Wim and Hu, Yixiong and Beamish, Eric and Botermans, Wouter and Lopez, Carolina Mora and Van Helleputte, Nick},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 16-Channel 97pArms 1MHz Bandwidth IC for Solid State Nanopore Sequencing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={A fully integrated 16-channel nanopore interface IC fabricated in $0.13 \mu \mathrm{m}$ CMOS is presented. The design achieves $20 \mathrm{M} \Omega$ transimpedance gain, 1MHz bandwidth, and $97 \text{pA}_{\text{rms}}$ noise at 1.7mW per channel, and demonstrates reliable parallel detection of labeled DNA translocation events using solid-state nanopores.},
  keywords={Noise;Labeling;Gain;Root mean square;Resistors;Printing;Equalizers;Current;DNA;Feedback},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577314},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577631,
