  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 12-Bit 4-GS/s ADC with PLL-Based Sub-Ranging RO-TDC}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper proposes a PVT-robust sub-ranging ring oscillator-based time-to-digital converter (SSRO-TDC) with phase-locked loop (PLL), integrated into a $12 \mathrm{b} 4-\text{GS} / \mathrm{s}$ timeinterleaved pipelined ADC as a backend. With frequency multiplication by PLL, the proposed background-running subranging RO (SRRO) is shared among TI channels, enhancing time resolution and PVT robustness and improving power efficiency. The proposed offset calibration algorithm suppresses the time offset in SRRO. Measurement result shows an SNDR of 58.5 dB at Nyquist frequency with $\text{FoM}_{\mathrm{W}}$ of $15.94 \text{fJ} /$ conv.-step.},
  keywords={Phase locked loops;Timing;Distance measurement;Technology;Calibration;Printing;Titanium;Frequency;Displays;Indexes},
