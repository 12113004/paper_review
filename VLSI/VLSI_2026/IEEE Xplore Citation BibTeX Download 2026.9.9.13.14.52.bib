  pages={1-3},
  abstract={We present SPECTRA, an LLM accelerator that supports speculative decoding (SD) [1] via prefill/decode/verify phase-wise reconfigurable flip-flop buffers (RFLB). With no accuracy loss, SPECTRA achieves ~4.1×/3.8×/3.7× and ~7.7×/7.9×/ 7.3× reductions in external memory access (EMA)/energy/latency, over micro-scaling (MX) INT8 [2] and FP16 baseline models.},
  keywords={Decoding;Printing;Timing;Modeling;Table lookup;Accuracy;Arrays;Quantization (signal);Energy;Indexes},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577608},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577374,
  author={Morein, S. and Mahji, P. and Gilmore, W. and Lu, C.-L. and Lin, S.C. and Chuang, C.H. and Sung, C.F. and Chen, C.H. and Huang, C.W. and Chang, Y.L. and Chang, S.-Z. and Liu, Chris and Hcueh, HN and Yeh, Hamy and Chen, PT and Chen, Wenliang},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Multiple-Wafer (9-Layer), Extreme Thin ($3 \mu ~\mathrm{m}$-Si per Stack) and Innovative Fusion-Bonded Via-In-One Architecture for High Bandwidth 3D Memory}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={An innovative and cost effective multiple-wafer via-in-one TSV architecture implementing into 3D high bandwidth DRAM cube has been demonstrated. Every BEoL routing layer in the 8 -stacked cube directly links to the TSV bus for providing better signal and power integrity is reported. Custom DRAM wafers with via-in-one TSV could reduce power consumption during data movement ($<0.7 \text{pJ} /$ bit). Comparing to stacking memory by hybrid bonding and typical TSV, the ultra-thin $(3 \mu ~\mathrm{m})$ Si substrate of each stacked memory, the directly link of metal routing to TSV, and the embedding via-in-one TSV into oxide trench slot ($10 \times 85 \mu ~\mathrm{m}^{2}$ per area) in the structure provide better signal integrity and minimum transferring path in-between power and signal during the high speed data transfer. Consistence of normalized resistance for each via-in-one TSV and contact ring ($<10 \%$ variation) test describes the good quality of interconnection. The O-type contact ring (Metal to TSV) is decided because of 40 % contact resistance lower than C-type one. Functional validation of 8 stack DRAM $(0.95 ~\mathrm{V}-1.2 ~\mathrm{V})$ on one Logic and successful reliability testing confirm its robustness. This architecture can offer exceptional memory bandwidth $\left(\sim 0.25 ~\text{Tb} / \mathrm{s} / \text{mm}^{2}\right)$ at low data transfer power ($<0.35 ~\mathrm{W} / \text{mm}^{2}$), presenting a completing solution for memory-intensive workloads in AI and HPC.},
  keywords={DRAM chips;Through-silicon vias;Stacking;Memory;Indexes;Indexing;Displays;Contacts;Logic;Silicon},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577374},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577332,
