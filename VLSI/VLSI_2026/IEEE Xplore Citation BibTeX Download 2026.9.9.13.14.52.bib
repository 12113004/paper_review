  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Specter: 376 fps 2.67 nJ/Pixel 4DGS Processor for Spatiotemporal Reconstruction with Contribution-Ordered Rendering and Deformation-Aware Modeling}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents Specter, the first 4D Gaussian Splatting (4DGS) processor for spatiotemporal reconstruction (STR). Specter reduces redundant external memory access (EMA) and computation with (i) opacity/shape-aware bound tightening for accurate Gaussian-to-tile allocation, (ii) contribution-ordered rendering with hierarchical skip of non-contributing operations, (iii) hash-based deformation detection to skip modeling of non-deformed tiles. Fabricated in 28nm CMOS technology, Specter occupies 12.96 mm2 die area and achieves up to 376 fps at 2.67 nJ/pixel for rendering and up to 112.3 iterations/s for modeling.},
  keywords={Modeling;Pixel;Tiles;Rendering (computer graphics);Printing;Timing;Displays;Indexes;Indexing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577601},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577253,
  author={Shigetoshi, T. and Zhao, P. and Witters, L. and Georgieva, V. and Montero, D. and Saroj, R. K. and Gowda, P. P. and Altantzis, T. and Shen, T. H. and Jourdan, N. and Kenens, B. and Vrancken, E. and Maes, J. W. and Vos, J. De and Beyer, G. and Beyne, E. and Tokei, Z. and Shimizu, K. and Kagawa, Y.},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={High-Density Backside Connectivity with Remaining Bulk Silicon Substrate Using Self-Aligned Local Backside Dielectric Isolation for Frontside Active}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={We demonstrate a Local Backside Dielectric Isolation (Local-BDI) process that enables nanoscale Via-last Through Silicon Vias (VL-TSV) overlap with the Active region, thereby overcoming design constraints in conventional approaches. Robust dielectric isolation of TSVs was confirmed across various layouts, without compromising backside-to-frontside connectivity. Compared to prior work, the Local-BDI increases the VL-TSV overlay window by threefold and, when TSVs are used as lines, reduces line resistance by over 50 % compared to Buried Power Rail (BPR) at an equivalent footprint. This approach offers a solution for high-density backside connections with remaining bulk silicon.},
  keywords={Through-silicon vias;Displays;Indexes;Indexing;Silicon;Filling;Resistance;Very large scale integration;Printing},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577253},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577623,
