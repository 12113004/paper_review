  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 90.6 pJ/pixel 1280×800 65 fps cm-Scale Fully Integrated Video Encoder System Utilizing a 2×2 Microlens Array}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents a compact $(31.5 \times 10.7 \times 4 \text{mm}^{3})$ video encoder system with a commercial imager, flash, a custom 2×2 microlens array, and an image signal processing (ISP) chip using novel 2×2 intra-frame compression. Leveraging the subframe redundancies inherent to the microlens array, the system achieves $>59 \times$ compression with $>32 \text{dB}$ PSNR. With this, the ISP chip fabricated in 28nm CMOS attains 90.6 pJ/pixel energy efficiency at 1280×800, 65fps video stream.},
  keywords={Timing;Arrays;Displays;Indexes;Indexing;Videos;Pixel;Printing;Energy;Modules (abstract algebra)},
  doi={10.1109/VLSITechnologyandCir65830.2026.11577285},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11577327,
  author={Hwang, Jung-Hye and Hong, Kieop and Kang, Jubin and Kim, Jong-Beom and Hong, Yunji and Kim, Seong-Jin},
  booktitle={2026 IEEE/JSAP Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3.86 TOPS/W TTFS-Based Neuromorphic Image Sensor Featuring Clocked-Recharging SPAD Pixels and Sub-Pixel-Array-Level Processing}, 
  year={2026},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a neuromorphic SPAD image sensor that features in-sensor computation using a spiking neural network (SNN). Clocked-recharging (CR) SPAD pixels inherently encode light intensity into a time-to-first-spike (TTFS) format, enabling sparse, low-latency computation. An 8b exponential counter at each pixel captures spike timing, while a low-power analog counter with a CDAC implements TTFS-based weighted integrate-and-fire (IF) operation. The proposed 3 × 3 sub-pixel-array (SPA) convolution architecture maximizes insensor parallelism and achieves high throughput. The prototype sensor, fabricated in a $110-\text{nm}$ CMOS process, consumes 5.1 mW at 6.67 kfps, achieving a FoM of 2.6 $\text{pJ} / \text{pixel} \cdot \text{fps} \cdot$ filter and an energy efficiency of 3.86 TOPS/W. Using the extracted $1^{\text{st}}$-layer feature maps (FMs) and a software-based fully connected (FC) layer, a face detection accuracy of 91.5% is achieved.},
  keywords={Timing;Pixel;Image sensors;Radiation detectors;Filtering;Filters;Arrays;Printing;Single-photon avalanche diodes;Architecture;clocked recharging SPAD;neuromorphic image sensor;time-to-first-spike;processing-in-sensor (PIS)},
