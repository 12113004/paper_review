@INPROCEEDINGS{11075014,
  author={Shimada, S. and Otake, Y. and Suzuki, J. and Magori, A. and Kurata, K. and Matsui, T. and Tsuchida, R. and Okazaki, M. and Yokochi, K. and Iwase, T. and Takase, H. and Koga, F. and Ogi, J. and Maeda, H. and Moriyama, K. and Honda, H. and Fujisawa, K. and Miura, T. and Koketsu, H. and Wakano, T.},
  title={A Back-Illuminated 10 μm-Pitch SPAD Depth Sensor with 42.5% PDE at 940 nm using an Optimized Doping Design},
  abstract={We present a novel single-photon avalanche diode (SPAD) pixel array designed for accurate distance measurement with a high photon detection efficiency (PDE). This study was conducted with a SPAD depth sensor of 10 μm-pitch with the back-illuminated (BI) structure on a 300 mm CMOS platform. To enhance PDE, we optimized the multiplication region design to increase the triggering probability for the Geiger mode, achieving a 92.9% with 3 V excess bias. Additionally, by introducing new doping, enabling a more efficient charge collection, we have achieved a 98.8% charge collection efficiency. Consequently, in the Si-type SPAD technology, we achieve the world's highest PDE of 42.5% at 940 nm.},
  keywords={Temperature measurement;Histograms;Simulation;Wavelength measurement;Fitting;Doping;Very large scale integration;Optical imaging;Optical sensors;Single-photon avalanche diodes},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075014},
}

@INPROCEEDINGS{11075125,
  author={Park, Hyeonwoo and Kirtania, Sharadindu G. and Sarkar, E. and Chakraborty, D. and Zhang, C. and Lee, H-J and Shin, J. and Yu, Shimeng and Khan, Asif and Kim, H. and Im, C. and Hong, M. J. and Ha, D. and Datta, Suman},
  title={Demonstration of Tungsten-doped Indium Oxide MOSFETs with 3 Angstrom EOT, Improved Stability and High on-Current},
  abstract={This study demonstrates improved performance and reliability in back-end-of-line (BEOL)-compatible amorphous oxide semiconductor (AOS) MOSFETs. Employing Hf O2-ZrO2-HfO2 (HZH) laminated gate dielectric, we achieved a high on-state current $(\mathrm{I}_{\text{ON}})$ of 244 $\mu \mathrm{A}/\mu \mathrm{m}$ for devices with a 50 nm channel length, operating at $\mathrm{V}_{\text{OV}}=1.5\mathrm{V}$ and $\mathrm{v}_{\text{DS}}=1\mathrm{V}$. Crucially, these devices exhibited exceptional bias stress stability, with a minimal threshold voltage shift of only 10 mV under high stress of $\mathrm{V}_{\text{stress}}=1\mathrm{V}$. The HZH gate stack enhanced charge confinement, minimized subgap density of states, and suppressed both positive and negative bias instabilities. This work establishes a new milestone for EOT scaling in BEOL-compatible AOS MOSFETs, paving the way for improved charge transport, enhanced stability, and the development of reliable 3D-integrated circuits.},
  keywords={Performance evaluation;MOSFET;Oxygen;Very large scale integration;Logic gates;NIST;Threshold voltage;Circuit stability;Integrated circuit reliability;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075125},
}

@INPROCEEDINGS{11075167,
  author={Chou, Ang-Sheng and Lin, Yu-Tung and Li, Ming-Yang and Mao, Po-Sen and Hsu, Ching-Hao and Chou, Sui-An and Hsu, Yu-Wei and Ku, Shuer and Arutchelvan, Goutham and Yun, Wei-Sheng and Hsu, Chen-Feng and Wu, Wen-Chia and Hung, Terry Y. T. and Li, Meng-Zhan and Heh, Dawei and Ho, Po-Hsun and Chiu, Ying-Zhan and Vellianitis, Georgios and van Dal, Mark and Chang, Wen-Hao and Wu, Chih-I and Cheng, Chao-Ching and Radu, Iuliana and Cao, Min},
  title={Performance Step-Up in PMOS with Monolayer WSe2 Channel},
  abstract={This study makes monolayer (1L) tungsten diselenide (WSe2) more competitive as a scaled p-channel candidate. We address performance constraints related to channel, dielectric, and contact while reducing device-to-device variability. Back-gated PMOS with 1L-WSe2 channel and effective oxide thickness (EOT) of 1.2 nm reaches ON-current of 400 µA/µm at VDS of -1 V, with subthreshold swing of 72 mV /decade, ON/OFF ratio of 7 orders, nearly hysteresis-free, while operating in enhancement-mode. Furthermore, passivation allowing for air stability is implemented without performance degradation. This is achieved without the use of materials that are not compatible with wet processing. We identify contact resistance and specifically the need for gate-voltage-independent contact resistance as the main next step for improving device performance.},
  keywords={Performance evaluation;Surface resistance;Tungsten;Voltage;Doping;Logic gates;Very large scale integration;Contact resistance;Hysteresis;Passivation},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075167},
}

@INPROCEEDINGS{11075032,
  author={Lee, Raeyoung and Park, Sejun and Seo, Yujeong and Kim, Joon and Jung, Jinah and Yeo, Jeongyoon and Ahn, Youngsoo and Kim, Hyung Joon and Kim, YongLae and Lee, Junghwan and Lee, Dongsik and Park, Jonghyun and Kim, Wandong and Lee, Byoungil and Noh, Kyungyoon and Hong, Seungwan and Hur, Sung Hoi},
  title={Highly Scalable and Reliable Cell Characteristics for 1Tb 9Th Generation 3D-NAND Flash Memory},
  abstract={A pioneering 9th-generation 3D-NAND flash memory has been successfully developed, offering highly reliable cell characteristics and achieving the smallest unit cell volume in the industry. To achieve higher bit density, the cell area has been aggressively scaled down in both vertical and lateral dimensions, resulting in a remarkable 50 % improvement in bit density compared to the 8th generation. Cell characteristic degradations and reliability concerns due to the extreme scaling were effectively mitigated using state-of the-art ONO material engineering and process innovations. This work establishes a new benchmark for scalable and reliable 3D-NAND flash memory solutions.},
  keywords={Industries;Degradation;Technological innovation;Materials reliability;Very large scale integration;Benchmark testing;Reliability engineering;Reliability;Flash memories;Integrated circuit reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075032},
}

@INPROCEEDINGS{11074854,
  author={Chiang, Katherine H. and Ho, Yen-Chung and Chuang, Ming-Yen and Chang, Chih-Yu and Kao, Yun-Feng and Yang, Hsin-Yi and Huang, Chien-Hua and Chien, Yu-Jen and Wu, Yin-Hao and Liu, Yi-Ching and Noguchi, Hiroki and Wu, Cheng-Jun and Lee, Wai-Kit and Chou, Chen-Han and Liao, Pei-Jean and Chiu, Yu-Chien and Cheng, Ya-Yun and Lin, Yu-Ming and Wang, Yih and Chang, Jonathan and Lin, Chung-Te and Cao, Min},
  title={Integration of 0.75 V VDD Oxide-Semiconductor 1T1C Memory with Advanced Logic for an Ultra-Low-Power Low-Latency Cache Solution},
  abstract={We successfully demonstrated the monolithic integration of a BEOL memory with advanced logic. The memory array is completely embedded in the BEOL, featuring an oxidesemiconductor channel selector and a low-temperature process capacitor. Yield and reliability were verified on a memory test chip operating at $0.75 \mathrm{V} \mathrm{V}_{\text{DD}}$, with active energy lower than $0.5 \text{pJ} / \mathrm{b}$ and a random cycle time of less than 8 ns, achieving retention exceeding 128 ms and endurance surpassing 1014 cycles at 85° C. This advanced logic-compatible BEOL memory technology offers a customizable, ultra-low-power, low-latency cache solution with a higher density than SRAM.},
  keywords={Scalability;Memory management;Capacitors;Random access memory;Monolithic integrated circuits;Low power electronics;Very large scale integration;Logic;Low latency communication;Integrated circuit reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074854},
}

@INPROCEEDINGS{11075020,
  author={Zhao, Shi and Xu, Zefeng and Yang, Jie and Li, Yue and Zamburg, Evgeny and Nagarajan, Radhakrishnan and Thean, Aaron Voon-Yew},
  title={A 2-Transistor-1-Modulator (2T1m) Electronic-Photonic Hybrid Memory Architecture for Deep Neural Network Cim and Very Large-Scale Transformers},
  abstract={Compute in-memory (CIM) architecture offers the promise to address the data movement efficiency in data-abundant computing, especially for deep neural networks. However, their array scalability is inevitably limited by IR losses with increasing error accumulation due to the increasing wire resistance as arrays grow in size. In this work, we propose a two-transistor-one-modulator (2T1M) electro-optic memory array with an optical bitline (BL) that circumvents the BL IR loss and capacitive loading issue. In each cell, dotproducts, performed by FeFET memories operated in sub-threshold region, are summed through phase modulation of an optical signal. We apply an ultra-lowloss compact lithium niobate on insulator (LNOI) photonic modulator to realize the energy-efficient electro-optic translation. The photonic waveguide BL read-out is achieved through pairs of shared Mach-Zender Interferometers (MZI) to maximize column layout efficiency. By eliminating IR loss on the BL, we can enable up to 3750 kb array size and achieve up to 45 % inference accuracy improvement on a large-scale ALBERT transformer model compared to conventional CIM arrays.},
  keywords={Optical losses;Phased arrays;Accuracy;Microprocessors;Computer architecture;Voltage;Optical modulation;FeFETs;Photonics;Power transformer insulation},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075020},
}

@INPROCEEDINGS{11074860,
  author={Wang, Yuxuan and Xie, Jiawei and Zhang, Zhilun and Zhou, Zuopu and Zhang, Dong and Sun, Chen and Han, Kaizhen and Zheng, Zijie and Shi, Wei and Kang, Yuye and Chen, Xuanqi and Zheng, Gerui and Shao, Rui and Gong, Xiao},
  title={BEOL-Compatible ITO FET with Ultra-Short Channel Length of 5 nm},
  abstract={For the first time, a novel drain in-situ shadowing mask (DISM) technique has been proposed for ultra-short channel (USC) transistor fabrication. This technique enables the realization of an ITO FET with the shortest channel length ($L_{\text{ch}}$) of 5 nm among all oxide semiconductor (OS) FETs, achieving a record-high maximum transconductance ($G_{\mathrm{m}, \max }$) of $1104 \mu ~\mathrm{S} / \mu \mathrm{m}$ among all ITO FETs, and a high maximum drain current ($I_{\mathrm{D}, \max }$) of $2061 \mu ~\mathrm{A} / \mu \mathrm{m}$. The absence of off-state tunneling in such an USC ITO FET has been confirmed via both experimental and simulation results. Furthermore, the 5 nm $L_{\text {ch }}$ device performs a $S S$ as low as $34.5 \text{mV} /$ decade at 6 K, disclosing a tiny glimpse into the full potential of cryogenic USC ITO FETs.},
  keywords={Performance evaluation;Electrodes;Fabrication;Three-dimensional displays;Field effect transistors;Indium tin oxide;Very large scale integration;Tunneling;Silicon;Shadow mapping},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074860},
}

@INPROCEEDINGS{11074814,
  author={Liu, Gan and Kong, Qiwen and Lu, Jingguang and Li, Xinming and Sun, Chen and Zhang, Dong and Wang, Xiaolin and Liang, Gengchiau and Gong, Xiao},
  title={A Generalizable Tri-Layer Design Framework for Enhancing OSFET Reliability},
  abstract={In this work, we propose a Tri-Layer structure design methodology to systematically enhance the reliability performance of oxide semiconductor (OS) FETs, applicable across various OSFET technologies. This approach addresses longstanding reliability challenges of positive and negative bias temperature instability (P/NBTI) in a comprehensive and simultaneous manner. The Tri-Layer incorporates a top layer and a passivation layer, each with distinct roles: the top layer functions as a hydrogen (H) reservoir, mitigating H effect and alleviating quantum confinement effects (QCE) through bandgap relaxation, while the passivation layer acts as an H barrier, preventing H diffusion from the ambient environment. The independent tunability of these layers allows for material property optimization, improving reliability without sacrificing electrical performance. To validate this methodology, we fabricated In-Ga-Zn-Sn-O (IGZTO) Tri-Layer FETs, achieving a record-low threshold voltage change ($\Delta V_{\text {th }}$) per oxide electric field ($E_{\text{OX}}$) of $0.009 ~\mathrm{V} \cdot ~\text{cm} / \text{MV}$ at high temperature ($T$) of 360 K with stress time of 700 s under NBTI condition.},
  keywords={Negative bias temperature instability;Photonic band gap;Thermal variables control;Field effect transistors;Very large scale integration;Reliability engineering;Time measurement;Reliability;Stress;Passivation},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074814},
}

@INPROCEEDINGS{11074845,
  author={Dong, Zuoyuan and Wang, Zirui and Wang, Hongbo and Li, Xiaomei and Luo, Chen and Huang, Jialu and Li, Lan and Huang, Zepeng and Sun, Zixuan and Liu, Yue-Yang and Wu, Xing and Wang, Runsheng},
  title={Towards Understanding Cryogenic Reliability in FinFETs Under Hot Carrier Stress: New Findings on Ge Migration, and Impacts of Tail States Evolution},
  abstract={In this paper, we present a systematic study of cryogenic reliability in FinFETs under hot carrier stress down to 10K. Our findings reveal that the traditional view of hot carrier degradation (HCD)-induced Vth shift is no longer sufficient to explain device behavior at such low temperatures. For the first time, an additional ΔVth under HCD stress has been identified in PMOS, attributed to Ge migration from SiGe S/D into the Si channel. This migration reduces band tail states, as uncovered through advanced physical characterizations (TEM/EDS/EELS) and ab initio calculations. These results provide strong physical evidence linking Ge migration to Va. shift at cryogenic temperatures, highlighting the need for cryogenic reliability models to incorporate atomic-scale Ge migration effects.},
  keywords={Systematics;Cryogenics;Hot carriers;Very large scale integration;Germanium;FinFETs;Silicon;Integrated circuit reliability;Stress;Silicon germanium},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074845},
}

@INPROCEEDINGS{11074983,
  author={Lin, Chieh-Hsin and Chang, Wei and Lin, Wei-Hwa and Chang, Ching-Yun and Lin, Wun-Jie and Lee, Jam-Wem and Chen, Ko-Ji and Song, Ming-Hsiang and Chih, Yue-Der and Wang, Eric and Chang, Jonathan and King, Ya-Chin and Lin, Chrong Jung},
  title={High Resolution Well-Plasma Detection Device in 16Nm Cmos Finfet Process},
  abstract={This paper presents a firstly developed FinFET well plasma charge detection device in 16 nm FinFET CMOS logic process. The device can precisely record the plasma-induced FinFET well charges from BEOL plasma processes, also to detect the charge polarization and quantification in plasma steps. A novel differential pair-structure is further implemented to detect the charging damages from well-to-well interference in dynamic plasma processes. The detection devices aid in understanding the transient well-plasma charging mechanism and quantifying the well plasma damages of FinFET gate dielectric from BEOL process steps. It surely provides an accurate monitoring and optimizing solution of the well plasma induced charges on the whole 12-inch wafer in 16nm FinFET technologies and beyond.},
  keywords={Accuracy;Interference;Very large scale integration;Logic gates;FinFETs;Plasmas;Dielectrics;Logic;Transient analysis;Monitoring},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074983},
}

@INPROCEEDINGS{11075161,
  author={Chou, Tao and Shen, He-Wen and Lai, Yu-Sheng and Tseng, Chia-Wei and Chang, Fang-Yu and Lin, Hsin-Cheng and Yao, Ching-Wang and Liu, C. W.},
  title={Unified Physics-Based CFET Thermal SPICE Considering BEOL, Substrate, and BSPDN Using Adiabatic Cones},
  abstract={For the first time, we present the physics-based thermal SPICE of the split-gate complementary FET (CFET). The passage of heat forms the cone/column-shaped adiabatic surfaces from the transistor level to BEOL and the backside, where can be power delivery network (BSPDN) or substrate. The temperature ($\Delta\mathrm{T}$ relative to the heat sink) of CFET is 2.2 times higher than the non-stacked nanosheet (NS). n-on-p CFET can alleviate temperature by 2°C compared to p-on-n CFET due to the higher thermal resistance $(\mathrm{R}_{\text{th}})$ of SiGe:B S/D than Si:P S/D. The same physical model is used for each level (devices, BEOL, substrate, and BSPDN) and is represented by Cauer ladders.},
  keywords={Heating systems;Transient response;Accuracy;Thermal resistance;Very large scale integration;SPICE;Thermal conductivity;Finite element analysis;Heat sinks;Substrates},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075161},
}

@INPROCEEDINGS{11074842,
  author={Kang, Yuye and Han, Kaizhen and Chen, Xuanqi and Zheng, Zijie and Kong, Qiwen and Liu, Gan and Jiao, Leming and Zhang, Zhilun and Zhou, Zuopu and Chen, Yue and Xie, Jiawei and Xu, Ying and Wang, Yuxuan and Zhang, Dong and Feng, Yang and Gong, Xiao},
  title={Uncovering True DIBL in Oxide-Semiconductor FETs: Impact of Negative Bias Stress and its Significance in 2T0C DRAM Retention},
  abstract={In this study, we demonstrate the majority of drain-induced barrier lowering (DIBL) effects observed in BEOL-compatible oxide semiconductor FETs (OSFETs) may not represent the true DIBL phenomenon. For the first time, we reveal that these effects are instead caused by the negative threshold voltage shift $(\Delta V_{\text{TH}})$ induced by negative bias stress (NBS) during gate voltage sweeping. This insight helps explain the discrepancy between experimental and theoretical retention in OSFET -based DRAMs. Our findings are further substantiated by a significant improvement in retention performance for OSFET -based 2T0C DRAM at 77 K, where both DIBL and the NBS-induced $\Delta V_{\text{TH}}$ are suppressed. Additionally, for a 2T0C DRAM using OSFETs with a channel length $(L_{\text{CH}})$ of 80 nm, negligible data loss was observed after 1000 seconds of data holding.},
  keywords={Performance evaluation;Semiconductor device measurement;Field effect transistors;Random access memory;Cryogenics;Very large scale integration;NIST;Threshold voltage;Stress;Stress measurement},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074842},
}

@INPROCEEDINGS{11075153,
  author={Shih, Pin-Hsuan and Lin, Wei-Hwa and Chih, Yue-Der and Wang, Eric and Chang, Jonathan and King, Ya-Chin and Lin, Chrong Jung},
  title={High Density 7nm FinFET Dielectric RRAM in Embedded Memory Applications},
  abstract={A high density FinFET Dielectric RRAM (FIND RRAM) is firstly developed in fully compatible 7nm FinFET CMOS logic process without additional masks or process steps. The high density embedded 7nm FIND RRAM cell has a unit cell area of 0.063um2, which consists of a 7nm nFinFET (WL) in series of a tiny high-K gate dielectric resistive switch node. The 7nm embedded HfO2-based FIND RRAM performs very excellent metrics in high-speed operation, stable readout window, and superior reliability in endurance and retention. Besides, the NOR-type array arrangement has superior disturb window and overwriting immunity for various embedded IP configurations. Moreover, the highly scalable embedded FIND RRAM cell can be further adapted to 5nm and beyond for boosting the memory density, performance, and operation voltages, which all lead the 7nm FinFET RRAM technology to be a promising FinFET memory solution in advanced embedded applications.},
  keywords={Three-dimensional displays;Switches;Very large scale integration;Lead;FinFETs;Dielectrics;Reliability;Logic;Voltage control;Stress;RRAM;FinFET technology;embedded;CPODE},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075153},
}

@INPROCEEDINGS{11075209,
  author={Ma, Cailian and Sun, Wenxuan and Nie, Long and Li, Yao and Wu, Yue and Fan, Zichen and Tang, Weiye and Zhang, Kaiping and Liu, Yu and Zhao, Shengjie and Zhang, Peiwen and Zhang, Shuaidi and Xu, Xiaoxin and Zhang, Feng and Liu, Ming},
  title={First Implementation of Monolithic Integrated Cim with 1Mb Ultra-High-Density 8-Layer 3D VRRAM, Achieving High Computing Density ($204.8 \text{GOPs} / \text{mm}^{2}$) and FoM ($\mathbf{2. 1 3} \times \mathbf{1 0}^{\mathbf{6}} \text{GOPS}^{\mathbf{2}} / \mathbf{W} / \text{mm}^{\mathbf{2}}$) for Efficient Scientific Computing},
  abstract={This work firstly implemented the Monolithic Integration of ultra-high density 1 Mb 8-layer 3D Vertical RRAM based Computing-In-Memory chip (MI-3DCIM) for efficient scientific computing. The 3D VRRAM performs in-situ matrix-vector multiplication (MVM) and transmits data to underlying computational circuits via the BEOL metal interconnects, which is embedded with the on-chip processor, enabling a fully monolithic SoC. Benefiting from the reduced latency and energy consumption, the MI-3DCIM exhibits ultra-high computational density ($204.8 \text{GOPS} / \text{mm}^{2}$), high energy efficiency (10.4 TOPS/W) and superior Figure of Merit ($2.13 \times 10^{6} \text{GOPS}^{2} / \mathrm{W} / \text{mm}^{2}$). This novel 3DCIM chip greatly enhances the capability for complex tasks.},
  keywords={Resistance;Semiconductor device measurement;Three-dimensional displays;Voltage measurement;Scientific computing;Measurement uncertainty;Very large scale integration;Energy efficiency;Pressure measurement;Electrical resistance measurement},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075209},
}

@INPROCEEDINGS{11075013,
  author={Narducci, D. and Garcia-Redondo, F. and Verschueren, L. and Carpenter, R. and Piao, X. and Chatterjee, J. and Monteiro, M. G. and Palomino, A. and Jossart, N. and Wostyn, K. and Bardon, M. G. and Hellings, G. and Kar, G.S. and Rao, S.},
  title={High Density, High Speed STT-MRAM N7 Macros: Material and DTCO Exploration},
  abstract={As SRAM density stalls and process costs rise, Spin Transfer Torque (STT)-MRAM offers a compelling embedded alternative, though hampered by slow writes and limited bitcell gain owing to high write currents. To address this challenge, we present a novel synthetic antiferromagnet (SAF)-based magnetic tunnel junction (MTJ) capable of 1 ppm error-free operation at 5 ns write and 150 uA on 45 nm eCD devices. We further demonstrate reliable switching at 30 nm CD for Iwrite of approximately 30 uA. The DTCO optimizes N7 process and bitcell design, enabling 5 ns, 0.8 p.J/bit macro writes. With a 0.013 um2 bitcell - iso A14/A10 nodes SRAM area, this approach bridges the density and performance gap in advanced technology nodes.},
  keywords={Performance evaluation;Torque;Costs;Random access memory;Switches;Very large scale integration;Error-free operations;Reliability;Junctions;Magnetic tunneling;SAF;STT-MRAM;DTCO},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075013},
}

@INPROCEEDINGS{11075129,
  author={Lee, Yuan-Jen and Cheng, Chun-Tai and Huang, Jian-Cheng and Huang, Kuo-Feng and Lin, Bo-Hung and Lin, Brian and Tseng, K.C. and Jinnai, Butsurin and Tsai, Ming-Han and Jiang, Meng-Ru and Ong, Yi Ching and Chen, Yu-Sheng and Tsai, Chun-Yang and Huang, K.C. and Liu, C.C. and Lee, Ming-Lun and Lin, Ku-Feng and Shih, Yi-Chun and Yuh, Perng-Fei and Chiang, Tien-Wei and You, Wen-Chun and Chien, Eric and Wang, Roger and Wang, Allen Y.J. and Wang, Yih and Chuang, Harry},
  title={Demonstration of Embedded MRAM with Sub-50 nm MTJ for RAM-Like and MCU Applications},
  abstract={We present the scalability of the MTJ critical dimension (CD) to sub-50 nm on test vehicles at the 16 nm technology node. Using fast-write MTJ films, we demonstrate a high endurance of lE14 cycles with a high-speed 20 ns write pulse width and a sub-ppm bit error rate without ECC for RAM-like applications. With high data retention MTJ films, we achieve 20-year data retention above 150°C and lE6 cycles endurance for MCU applications. This MTJ CD scaling is designed to be compatible with small bitcell, making it suitable for the 5 nm technology node.},
  keywords={Films;Scalability;Bit error rate;Very large scale integration;Error correction codes;MRAM;22 nm;16 nm;5 nm;technology node;STT-MRAM;RAM-like;MCU},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075129},
}

@INPROCEEDINGS{11074941,
  author={Yu, Jie and Zhu, Zheng and Lee, Albert and Huang, Xiaohan and Zhang, Yule and Li, Yu and Shen, Kaiwen and Gao, Yifan and Wei, Yingfen and Jiang, Hao and Zhang, Xumeng and Wang, Ming and Wu, Di and Chen, Xianzhe and Liu, Qi and Liu, Ming},
  title={96-Kb Voltage-Controlled-Magnetic-Anisotropy MRAM for In-Situ Reservoir Computing with High Endurance ($\geq 10^{12}$), Sub-Ns Operation (0.3 Ns) and Ultralow Power Consumption (40 fJ)},
  abstract={Voltage-Controlled Magnetic Anisotropy (VCMA) Magnetic Random Access Memory (MRAM) offers ultrafast operation with high endurance, making it an ideal platform for edge computing applications such as reservoir computing (RC). We propose a $96-\text{Kb}$ VCMA-MRAM-based RC system for temporal data processing, leveraging sub-nanosecond switching (0.3 ns), ultra-high endurance ($>10^{12}$ cycles), and in-situ training. The RC system demonstrates high recognition accuracy (97.8%) for tasks like voice recognition while achieving energy efficiency (40 fJ per input). These results establish a Si-platform-friendly architecture for scalable and efficient RC implementations.},
  keywords={Training;Resistance;Neurons;Reservoir computing;Integrated circuit interconnections;Switches;Speech recognition;Very large scale integration;Data processing;Vectors;VCMA-MRAM;reservoir computing;high endurance;sub nanosecond;low power},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074941},
}

@INPROCEEDINGS{11074832,
  author={Zhan, Shijie and Kaneko, Kishou and Wang, Heng and Kang, Lu and Li, Yang and Cui, Wei and Lu, Shiheng and Zhao, Wanpeng and Wang, Yuqi and Yin, Yibiao and Shao, Yuan and Lin, Zebin and Cui, Xiaojuan and Wu, Ying and Xu, Jeffrey},
  title={A Monolithic Dual-Layer Pixel Design with BEOL IGZO Transistors Featuring High Dual Conversion Gain Ratio and Scaled Pixel Size for Future Image Sensors},
  abstract={A novel monolithic dual-layer pixel design based on BEOL InGaZnO (IGZO) transistors (Tr) is proposed. By moving the pixel Trs to BEOL, the proposed design enables the double pixel size scaling down to 0.5 um and also a large dual conversion gain (DCG) ratio $\sim 10: 1$ due to reduced parasitic capacitance and large Tr area. Device reliability and noise performance of IGZO Trs for pixel applications were studied comprehensively. Remarkable positive bias temperature instability (PBTI) with $\mathrm{V}_{\text{TH}}$ shift within 30 mV after 1 ks stress under gate fields of $2-6 \text{MV} / \text{cm}$ and temperatures of $25-95^{\circ} \mathrm{C}$ is achieved for IGZO Trs with $\text{Lg}=65 \text{nm}$. Low 1/f noise, 10 times lower than reported short-channel IGZO Trs and comparable to Si Trs at 45 nm node, is also demonstrated for the scaled IGZO Trs. Our results open up opportunities for future image sensors based on BEOL IGZO technology.},
  keywords={Image sensors;Wafer bonding;Temperature sensors;Performance evaluation;Very large scale integration;Logic gates;Silicon;Transistors;Stress;Parasitic capacitance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074832},
}

@INPROCEEDINGS{11075035,
  author={Hong, Jongwoo and Lee, Shinho and Yun, Yangjae and Kwon, Seokjin and Park, Inyong and Park, Seonuk and Jo, Jaepil and Mun, Sang-Eun and Park, Hyunsung and Roh, Sookyoung and Ahn, Sungmo and Yun, Seokho and Lee, Beomsuk and Joe, In-Sung and Kim, Sung-In and Go, Jonghyun and Song, Jaihyuk},
  title={Adaptive Metasurface Microlens Array for Ultra-Wide-Angle CMOS Image Sensors},
  abstract={Demand for higher-resolution CMOS image sensors for mobile camera accelerated pixel scaling into sub-micron size. Micro-lens (ML) array, which plays a crucial role of collecting photons and phase-detection auto-focus, its performance degraded as the ML size became comparable to the visible wavelength. This gets worse with ML aberration and increasing light incident angle in ultra-wide-angle image sensors. We propose a metasurface microlens (MML) replacing the conventional spherical ML, employing adaptive design tailored to varying chief ray angle (CRA) across the entire image sensor. We implemented this MML using 0.5 μm pixel prototype, and demonstrated 35% auto-focus contrast ratio enhancement and 49% sub-color-channel difference improvement without any quantum efficiency degradation.},
  keywords={Image edge detection;Adaptive arrays;CMOS image sensors;Very large scale integration;Metasurfaces;Photodiodes;Electric fields;Microoptics;Lenses;Sensor arrays;CMOS image sensor;microlens;metasurface},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075035},
}

@INPROCEEDINGS{11074925,
  author={Kim, Joo-Hyun and Eom, Doyoon and Park, Eunsung and Son, Doohee and Choi, Woo-Young and Lee, Myung-Jae},
  title={Back-Illuminated U-Shape p-i-n SPAD with High PDE and Broad Spectral Response Fabricated in 110nm CIS Foundry Technology},
  abstract={We present a novel U-shape p-i-n SPAD (U-SPAD) and demonstrate the device performance using a back-illuminated (BI) 110 nm CIS foundry technology. The proposed SPAD is designed for outstanding broad spectral response, achieving photon detection efficiency (PDE) of 23.4 % at $940 \text{nm}, 73.8 {\%}$ at 700 nm, and 50 % at 475 nm, dark count rate (DCR) of about $21.6 \text{cps} / \mu \mathrm{m}^{2}$, about 210 ps timing jitter, and 0.3 % afterpulsing probability (APP) at 21.5 V breakdown voltage and 1.6 V excess voltage. While high-performance SPADs generally require an optimized custom process, the proposed U-SPAD achieves high performance in a standard foundry process without any process modification.},
  keywords={Temperature measurement;Timing jitter;PIN photodiodes;Simulation;Wavelength measurement;Very large scale integration;Foundries;Time-domain analysis;Standards;Single-photon avalanche diodes;CIS;Foundry;LiDAR;PDE;SPAD;ToF-PET},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074925},
}

@INPROCEEDINGS{11075016,
  author={Park, Eunsung and Park, Hyo-Sung and Choi, Hyun-Seung and Kim, Joo-Hyun and Eom, Doyoon and Kim, Eo-Jin and Yook, Seyoung and Son, Doo-Hee and Lee, Hanseung and Jang, Jaehyung and Kim, Kyung-Do and Kim, Jongchae and Choi, Woo-Young and Lee, Myung-Jae},
  title={Optimization of a 3.5 μm Pitch 3D-Stacked Back-Illuminated SPAD in 40 nm CIS Technology: Achieving 37% PDP at 940 nm},
  abstract={We report on a 3.5 μm pitch 3D-stacked back-illuminated single-photon avalanche diode (SPAD) based on 40 nm CIS technology. The SPAD is optimized to achieve superior photon detection probability (PDP) through doping optimization, enabling it to reach a PDP of 37% at 940 nm.},
  keywords={Doping;Very large scale integration;Optimization;Single-photon avalanche diodes;Photonics},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075016},
}

@INPROCEEDINGS{11075065,
  author={Lee, Seunghyun and Son, Minhee and Seo, Sungyoung and Cho, Sunghyuck and Jin, Young-Gu and Oh, Youngsun and Song, Seunghyun and Lee, Seok-Ha and Han, DaeHan and Kim, Daeho and Kim, Minsik and Hwang, Il-Pyeong and Jeong, Youngkyun and Kim, Daeyun and Keel, Min-Sun and Ko, Juhyun and Park, Howoo and Lee, Kyungho},
  title={A 1.2Mp 2.8 um 4-tap Indirect Time-of-Flight Sensor with 42% Quantum Efficiency at 940 nm Wavelength with Enhanced Angular Response},
  abstract={A 2.8 um 4-tap Indirect Time-of-Flight Sensor with 42% Quantum Efficiency (QE) at 940nm wavelength is presented in 1.2Mp. SiO grid is used for 6%p higher 940nm QE than tungsten grid. We also used 3×3 multiple small lenses per unit pixel to enhance angular response. The dark noise can cause depth accuracy degradation especially under dim received light from far object, therefore we optimized n-type photodiode implantation under higher annealing temperature, which showed dark noise reduction, and achieved demodulation contrast of 92% under 100 MHz demodulation frequency with 940nm VCSEL. Overall depth resolution is under 10mm at 0.3~ 1.2m range without wiggling calibration.},
  keywords={Temperature measurement;Noise;Optical device fabrication;Optical variables measurement;Optical imaging;Optical sensors;Optical scattering;Optical noise;Vertical cavity surface emitting lasers;Lenses;Time-of-Flight;CMOS imager;depth sensor;near-infrared;quantum efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075065},
}

@INPROCEEDINGS{11075104,
  author={Witters, L. and Van Huylenbroeck, S. and Kang, S. and Zhao, P. and Chew, S-A. and D'havé, K. and Iacovo, S. and Stucchi, M. and Zhang, B. and Dewilde, S. and Montero, D. and Chukka, R. and Vandersmissen, K. and Heylen, N. and Jourdan, N. and Maes, J.W. and Bana, H. and Zhu, C. and De Vos, J. and Beyer, G. and Beyne, E.},
  title={High-Density Wafer Level Connectivity Using Frontside Hybrid Bonding at 250nm Pitch and Backside Through-Dielectric Vias at 120nm Pitch After Extreme Wafer Thinning},
  abstract={This study presents the latest advancements in high-density wafer-level connectivity. We achieve face-to-face hybrid bonding at 250nm pitch. Access from the wafer backside is demonstrated through extreme wafer thinning beyond the shallow trench isolation floor and through dielectric via connections at 120nm pitch. Additionally, we examine the impact of guided wafer to wafer bonding, necessary for tight pitch hybrid bonding, on subsequent backside lithography overlay corrections, paving the way for combining high-density wafer front and backside connectivity.},
  keywords={Resistance;Lithography;Stacking;Symbols;Very large scale integration;Solids;Silicon;Bonding;Floors;Silicon germanium},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075104},
}

@INPROCEEDINGS{11075050,
  author={Calderoni, A. and Chavan, A. and Ettisserry, D. P. and Liao, A. and Balakrishnan, M. and Hollander, M. and Mariani, M. and Karda, K. and Jerry, M. and Fischer, M. and Mills, D. and Cook, B. and Chhajed, S. and Zahurak, J. and Ramaswamy, N.},
  title={Voltage Reduction (1.4V) and Array Scaling (41nm) of Ferroelectric NVDRAM for Low-Power and High-Density Applications},
  abstract={We present a second generation of scaled Ferroelectric NVDRAM [1] with a reduced x- and y-direction pitch (41nm), a thinner ferroelectric stack (5nm) and a lower array operating voltage (Read/Write at 1.4V). We present full chip array data, showing a >250mV window at −4σ after 1E10 cycles. This is the densest 1T1C ferroelectric technology with such high performance. Multiple material and electrical challenges were addressed to ensure performance was maintained at reduced dimensions.},
  keywords={Resistance;Power demand;Ruthenium;Voltage;Switches;Very large scale integration;Tin;Silicon;Arrays;Optimization;NVDRAM;ferroelectric memory;reliability;fatigue;retention;scaling},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075050},
}

@INPROCEEDINGS{11074932,
  author={Chen, Anlan and Park, Ki-woong and Sakai, Kota and Hwang, Sunbin and Huang, Xingyu and Saraya, Takuya and Hiramoto, Toshiro and Takahashi, Takanori and Uenuma, Mutsunori and Uraoka, Yukiharu and Kobayashi, Masaharu},
  title={A Gate-All-Around Nanosheet Oxide Semiconductor Transistor by Selective Crystallization of InGaOx for Performance and Reliability Enhancement},
  abstract={We have demonstrated performance enhancement of polycrystalline InOx FET by Ga-doping in ALD process & anneal with mobility of $81 ~\text{cm}^{2}/\text{Vs}$, novel selective crystallization technique for the InGaOx in an oxide semiconductor (OS) stack, and process integration & device operation of a gate-allaround nanosheet (GAA NS) InGaOx (IGO) FET, for the first time. An evidence of quantum confinement in NS OS is experimentally obtained. Bias-stress reliability is significantly improved by GAA NS FET. This work will provide a direction for high-performance OS FETs toward LSI applications.},
  keywords={Performance evaluation;Annealing;Field effect transistors;Gallium arsenide;Potential well;Crystallization;Very large scale integration;Logic gates;Nanoscale devices;Integrated circuit reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074932},
}

@INPROCEEDINGS{11075105,
  author={Tang, Nan and Yu, Guihai and Shi, Ao and Li, Kexun and Li, Jiaqi and Yang, Haozhang and Xiao, Yi and Wu, Lianliang and Zhou, Zheng and Liu, Lifeng and Liu, Xiaoyan and Kang, Jinfeng and Huang, Peng},
  title={First Demonstration of 1T FDSOI-Based >1000fps Image Sensor with In-pixel Computing},
  abstract={In this work, we first demonstrate a $128\times 128$ image sensor based on 1T 22nm FDSOI pixel, which leverages the deep depletion region under buried oxide (BOX) for optical sensing. Key features include: (1) extremely high photosensitivity of $5\times 10^{5}$ A/W is achieved thanks to the amplifying effect of the FET; (2) photosensitivity can be tuned by gate/drain voltage, enabling in-pixel computing capability in 1T structure; (3) the chip can achieve >1000 fps imaging and feature extraction utilizing the in-pixel processing capability and the proposed exposure/sampling/readout uncoupled pipeline design.},
  keywords={Image sensors;Semiconductor device measurement;Simulation;Pipelines;Field effect transistors;Imaging;Silicon-on-insulator;Very large scale integration;Feature extraction;Optical sensors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075105},
}

@INPROCEEDINGS{11074853,
  author={Sun, Yiming and Li, Hao and Yu, Fangzhou and Zhao, Jie and Li, Yue and Zhang, Yu and Zhang, Min and Jia, Xiufeng and Huan, Yahuan and Wu, Jialu and Zhang, Tianle and Wang, Zhenlei and Shao, Minghao and Su, Diqing and Du, Kai and Zhu, Jiuyun and Song, Juncun and Zhang, Heng and Lyu, Hangbing and Xu, Jeffrey},
  title={1T1C 3D HZO FeRAM with High Retention (>125 °C) and High Endurance (>1E13) for Embedded Nonvolatile Memory Application},
  abstract={We present a high-performance 3D FeRAM test chip with hafnium zirconium oxide (HZO) materials for advanced embedded nonvolatile memory (eNVM) applications. This FeRAM achieves array-level endurance exceeding > 1013 cycles, robust data retention over 10 years at 125°C, and stable high-temperature operation. A novel stack design with defect shielding layers (DSL) on both sides of the HZO film effectively suppresses fatigue, imprint, and pinch phenomena, which are common challenges in ferroelectric memories. A 32Mb 1T1C FeRAM test chip was developed by integrating the high-performance ferroelectric capacitor (FeCAP) with a 7-nm HZO film into a 3D trench structure on a 40nm CMOS platform. The memory array demonstrates a memory window of approximately 340 mV at -5.2σ(0.1ppm), maintaining above 200 mV after 1011 writes/1013 reads, and 125°C baking operation. These results highlight the significant potential of this eFeRAM to replace eFlash in industrial-level eNVM applications, offering enhanced performance and reliability.},
  keywords={Three-dimensional displays;Zirconium;Nonvolatile memory;Ferroelectric films;Random access memory;Very large scale integration;Reliability;DSL;Arrays;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074853},
}

@INPROCEEDINGS{11075026,
  author={Zhou, Yun and Venugopal, Priya and Verschueren, Lynn and Cousins, Jack and Brunion, Moritz and Lin, Ji-Yung and Kükner, Halil and Naeim, Mohamed and Stassar, Mathias and Farokhnejad, Anita and Zografos, Odysseas and Bardon, Marie Garcia and Myers, James and Ryckaert, Julien and Hellings, Geert},
  title={Backside Power Delivery for Power Switched Designs in 2nm CMOS: IR Drop and Block-Level Power-Performance-Area Benefits},
  abstract={We evaluate block-level power-performance-area benefits of backside power delivery networks (BSPDNs) in power switched designs, using Through Silicon Via in the Middle of Line (TSVM) in an N2 (2nm) nanosheet technology. We use an industrial processor design, representative of mobile computing, to compare the BSPDN implementations to traditional frontside power delivery networks (FSPDNs), in both always-on and power switched implementations. BSPDNs benefit both domains, reducing IR drop and enabling smaller block-level area at iso-performance conditions. FSPDNs consume significant routing resources to ensure an acceptable IR drop, especially in power switched designs employing local PDN assists to achieve the target IR drop. Moving PDN to the backside frees up resources, resulting in smaller area for both power switched (-14%) and always-on (17%) domains. BSPDN enables the use of $2 \times$ fewer power switches, achieving an additional 9% area reduction.},
  keywords={Rails;Wires;Power system dynamics;Metals;Switches;Very large scale integration;Routing;Silicon;Mobile computing;Switching circuits;Backside power delivery;power switch;TSVM;2 nm nanosheet;block-level PPA},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075026},
}

@INPROCEEDINGS{11074801,
  author={Lee, J. and Lee, S. and Lee, S. and Ahn, Y. and Kim, M. and Cho, G. and Song, S. C. and Roh, U. and Cai, M. and Greenlaw, D. and Molloy, S. and Lim, S.-K. and Baek, R.-H.},
  title={A Novel Backside Signal Inter/Intra-Cell Routing Method Beyond Backside Power for Angstrom Nodes},
  abstract={For the first time, we investigate a power-performancearea (PPA) benefit of novel backside (BS) signal (BSS) routing using BS gate/source-drain contact targeting the Angstrom node. INVx1 with BS-pin has a smaller miller capacitance ($\mathrm{C}_{\text{miller }}$) and shows $3.0 \sim 3.3 {\%}$ higher ring oscillator (RO) frequency at isopower by BSS inter-cell routing. Even without BS-pin, standard cells can improve frontside (FS) routing congestion and an energydelay product (EDP) by using BSS intra-cell routing. BSS intracell routing based chip has a larger IR drop, but it is mitigated when the $\mu\text{Bump}$ pitch is small. The BSS intra-cell routing based chip shows an $8.61 \sim 9.46 {\%}$ lower power delay product (PDP).},
  keywords={Ring oscillators;Simulation;Layout;Metals;Vegetation;Very large scale integration;Logic gates;Routing;Pins;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074801},
}

@INPROCEEDINGS{11074885,
  author={Jeong, Jaeyong and Lee, Chan Jik and Rheem, Nahyun and Suh, Yoon-Je and Kim, Bong Ho and Kim, Joon Pyo and Kim, Sanghyeon},
  title={Heterogeneous 3D Integration of Low-Voltage E/D-Mode GaN HEMTs on CMOS Chip for Efficient On-Chip Voltage Regulation in Active Power Delivery Networks},
  abstract={In this work, we present and experimentally demonstrate the heterogeneous 3D integration of low-voltage (LV) E/D-mode GaN power devices on a CMOS chip for a vertically integrated active power delivery network (PDN). Our LV E/D-mode GaN power devices show record-low on-resistance ($R_{\text {on }}$) of 2.78/1.85 $\Omega \cdot \text{mm}$ and record-high frequency capability ($f_{\mathrm{T}}$) of $84 / 68 \text{GHz}$ along with breakdown voltage $\left(V_{\text{BD}}\right)>12 ~\mathrm{V}$ among power devices for active PDN. Furthermore, we innovated by introducing a scaled AlGaN buffer thickness to the direct heat spreading layer, enabling more efficient heat dissipation. This approach reduces thermal resistance ($R_{\text {TH }}$) by 13.5 % compared to using only heat-spreading layer bonding techniques.},
  keywords={Heating systems;Low voltage;Three-dimensional displays;HEMTs;Very large scale integration;Transmission line measurements;System-on-chip;MODFETs;Bonding;Voltage control},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074885},
}

@INPROCEEDINGS{11074928,
  author={Sun, Xichen and Wang, Xuliang and Chen, Renwei and Men, Xuchen and Jiang, Junmin and Wang, Yan and Liu, Xiaosen},
  title={A 10W 3.8-5V Input IVR Chiplet with 93%-Peak-Efficiency and 3.2A/mm2 Density Featuring Wide Load Range and Adaptive Ganging for 2.5D/3D Vertical Power Delivery},
  abstract={A monolithic Flying Capacitor Integrated Voltage Regulator (FCIVR) chiplet is proposed to supply wide load range while incorporating adaptive ganging capabilities for $2.5 \mathrm{D} / 3 \mathrm{D}{-}$ ICs. It offers four ganging modes catering to scalable PDNs. The triple-loop regulation enables twodimensional V-F droop saving for drastic di/dt events and provides autonomous handshake driving for efficient conversion. By leveraging ML-driven circuit & RDL physical optimization, combined with ultra-thin interposer integration to minimize form factor and parasitics, the proposed VPD technology achieves 10 A max current, $3.2 ~\mathrm{A} / \text{mm}^{2}$ density, 93 % peak efficiency and 32 ns FoM.},
  keywords={Regulators;Chiplets;Capacitors;Very large scale integration;Regulation;Hybrid power systems;Voltage control;Optimization;Hybrid Power Converter;Chiplet;2.5D/3D Integration;Vertical Power Delivery;Ganging},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074928},
}

@INPROCEEDINGS{11074804,
  author={Sarkar, Debjit and Baum, David and Hajimiri, Ali},
  title={Monolithic Optical Clock Distribution in Bulk CMOS Using I-Beam Waveguides},
  abstract={Optical clock distribution is presented for the first time in an unmodified bulk CMOS chip. An H-tree distributes the signal using I-beam photonic waveguides operating at 780 nm, and avalanche photodiodes and transimpedance amplifiers bring the signal back to the electronic domain. All components are monolithically integrated on a 180nm bulk CMOS chip. The Ibeam waveguides are also demonstrated in 22nm FDSOI CMOS technology without process modifications or design rule violations, making it the most advanced commercial process to monolithically demonstrate photonic waveguiding.},
  keywords={Integrated optics;Optical interconnections;Optical design;Stimulated emission;Silicon-on-insulator;Very large scale integration;Optical amplifiers;Optical waveguides;Photonics;Clocks;clock distribution;photonics;photonic waveguide;monolithic integration;optical interconnect;H-tree;CMOS},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074804},
}

@INPROCEEDINGS{11074976,
  author={Davis, John and Kyriazidis, Georgios and Hu, Yaowen and Warner, Hana and Zhu, Xinrui and Magalhaes, Leticia and Modisette, Melinda and Lippok, Norman and Yang, Kiyoul and Vakoc, Benjamin and Lončar, Marko and Hills, Gage},
  title={Digital-To-Optical Converters (DOCs) With Improved Nonlinearity for Energy-Efficient Optical Data Transmission},
  abstract={Digital-to-Optical Converters (DOCs) convert digital electrical signals directly to analog optical signals, eliminating the need for Digital-to-Analog Converters (DACs) in Electro-Optic (EO) modulators, for applications in energy-efficient data communication. However, nonlinearity in DOCs degrades Symbol Error Rate (SER), power, and bandwidth. We present Engineered-Segment Length (ESL) $D O C$ circuits that achieve strictly better trade-offs in Integral Non-Linearity (INL), Differential Non-Linearity (DNL), SER, and optical power vs. state-of-the-art DOC circuits. We experimentally demonstrate DOCs in heterogeneously integrated Si CMOS and Thin-Film Lithium Niobate (TFLN). Our measured ESL DOCs improve Root-Mean-Square (RMS) INL from 1.04 to 0.14 Least-Significant Bits (LSBs) and RMS Differential Non-Linearity (DNL) from 0.42 to 0.10 LSBs.},
  keywords={Codes;Optical device fabrication;Linearity;Electro-optic modulators;Optical variables measurement;Very large scale integration;Adaptive optics;Optical transmitters;Optical modulation;High-speed optical techniques},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074976},
}

@INPROCEEDINGS{11075034,
  author={Park, Juhyuk and Kim, Hokwon and Kim, Yongil and Baek, Woojin and Lee, Shin Hyung and Kim, Hyunsu and Geum, Daemyeong and Kim, Joon Pyo and Jeong, Jaeyong and Kim, Sanghyeon},
  title={High-Performance Monolithic 3D Integrated Red μLEDoS Display for AR/VR},
  abstract={The monolithic 3D (M3D) integration of Si CMOS integrated circuits (IC) and $\mu \text{LEDs}$ is essential for high-resolution AR/VR displays. In this work, we successfully demonstrated a red $\mu \text{LEDoS}$ display of 1700 PPI and a $640 \times 480$ resolution based on the M3D process. The phosphide red $\mu \text{LED}$ devices exhibited excellent color performance as unit pixels. Notably, with high pixel yield achieved through a low-temperature process below 300° C and a metal mesh structure mitigating IR drop issues, we successfully implemented high-quality imaging driven by real-time HDMI inputs using 8-bit grayscale. This study plays an essential role in advancing M3D $\mu \text{LEDoS}$ next-generation display.},
  keywords={Temperature measurement;Scanning electron microscopy;Three-dimensional displays;Power measurement;Image resolution;Image color analysis;Gray-scale;Very large scale integration;Silicon;Current density},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075034},
}

@INPROCEEDINGS{11074859,
  author={Wang, Xiaochen and Ning, Hao and Lin, Jiangming and Xie, Yongliang and He, Youshui and Ma, Yuan and Bodepudi, Srikrishna Chanakya and Yu, Bin and Xu, Yang},
  title={A Heterogeneous CMOS Chip Monolithically Integrating Monolayer MoS2 for Enhanced NUV Detection: A Scalable Platform Leveraging 2D Materials to Complement and Surpass Silicon},
  abstract={A gap persists between the remarkable properties of 2D materials and their realization in chips, demanding integration strategies that unlock 2D-CMOS complementarity to surpass silicon. We present a 2D-CMOS heterogeneous chip and this approach demonstrates a paradigm that combines the properties of 2D materials with the established advantages of CMOS as a large-scale chip foundation. Our chip seamlessly integrates the intrinsic properties of monolayer $\text{MoS}_{2}$, particularly high-gain and low-noise, enabling superior nearultraviolet performance over mainstream silicon-based chips. This integration complements and transcends the limitations of silicon chips. Our chip achieves a 257 % quantum efficiency at 375 nm and a detectivity ($\mathrm{D}^{\ast}$) exceeding 1013 Jones under weak illumination, maintaining an effective signal-to-noise ratio (SNR) of 3 dB at 0.4 pW ultra-low light intensity. Compared to state-of-the-art 2D-materials integration, our design reduces fabrication complexity, enhances scalability, and achieves a high degree of CMOS integration, yielding substantial performance improvements. These results establish a scalable integration platform, bridging the gap between emerging materials and practical chip implementations.},
  keywords={Fabrication;Scalability;Lighting;Very large scale integration;Silicon;Complexity theory;Sulfur;Molybdenum;Next generation networking;Signal to noise ratio},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074859},
}

@INPROCEEDINGS{11075005,
  author={Hashimoto, Susumu and Nakatsuka, Keisuke and Hizume, Yuma and Takeda, Hiroshi and Kurusu, Takashi and Sakata, Koichi and Yoshida, Shuji and Arai, Shinya and Okina, Teruo and Sekine, Katsuyuki},
  title={A Schottky Junction as a Hole Injector for Enhancing Erase Operation of 3D Flash Memory in CMOS Directly Bonded to Array (CBA) Era with Over 1,000 Word Lines},
  abstract={This paper presents an innovative structure for 3D flash memory, integrating a Schottky junction into source and channel (CNL) contacts in the CMOS Directly Bonded to Array (CBA) architecture. This structure achieves over 1,000 times more holes than the conventional gate-induced drain leakage (GIDL) method for erasing cells. This breakthrough overcomes the limitations of word line (WL) stacking caused by insufficient hole current in future 3D flash memory.},
  keywords={Three-dimensional displays;Voltage measurement;C-band;Stacking;Metals;Computer architecture;Very large scale integration;Flash memories;Junctions;Current density},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075005},
}

@INPROCEEDINGS{11075197,
  author={Kwon, Ohhyuk and Lee, Sunhyeong and Seo, Jongseon and Han, Geonhui and Kim, Dongmin and Park, Sejun and Lee, Junyoung and Park, Kwangmin and Yang, Siyoung and Choi, HanMei and Lee, Woosung and Hwang, Hyunsang},
  title={Low-Temperature NiSi Formation via Microwave Annealing for Stable Metal-Induced Lateral Crystallization in 3D NAND Flash Memory},
  abstract={This study introduces a novel Metal-Induced Lateral Crystallization (MILC) method, enhanced by a low-temperature pre-Microwave Annealing (MWA) step, for 3D NAND flash memory. Conventional MILC faces uneven growth due to simultaneous nucleation and grain growth, worsened in confined Si channels because crystalline Si (c-Si) whiskers with Ni silicide nodule fronts block each other during directional growth, limiting the availability of Ni for crystallization. Therefore, we conduct a pre-MWA step to promote the formation of NiSi while suppressing MILC progression caused by the transformation into $\text{NiSi}_{2}$, resulting in synchronized MILC growth during the subsequent annealing step. This method ensures stable MILC in 3D NAND flash memory, offering reliable approach for advanced memory technologies.},
  keywords={Annealing;Three-dimensional displays;Nickel alloys;Silicides;Microscopy;Crystallization;Very large scale integration;Silicon;Flash memories;Electrons},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075197},
}

@INPROCEEDINGS{11074815,
  author={Sharma, P. and Florent, K. and Resnati, D. and Mauri, A. and Yue, J. and Ahn, J. and Fayrushin, A. and Camerlenghi, E. and Fantini, P. and Goda, A. and Kim, T. and Hill, R.},
  title={Wide Memory Window and Steep ISPP Slope (13.2 V and 2.7) of an Aggressively Scaled 3D Ferroelectric NAND (Fenand) Cell for lt;30\text{nm}$ Tier Pitch Scaling},
  abstract={This study demonstrates a maximum memory window (MW) of 13.2 V and an average ISPP slope of 2.7, achieving the bestreported performance obtained in vertical Gate-All-Around (GAA) 3D FeNAND architecture. The device features a 20 nm gate length ($\mathrm{L}_{\mathrm{G}}$) and a 42 nm layer pitch. These achievements were made possible through significant innovations in gate stack engineering. The roles of channel interlayer (CIL) and ferroelectric (FE) switching, identified as primary limiters for optimal MW and reliability, are examined through precise tunneling current and trap emission probability calculations. Retention and endurance characteristics were measured with a large MW of $>8 ~\mathrm{V}$. The trade-offs between the initial MW and reliability are discussed. The higher slope of 2.7 enables $\sim 30 \%$ tier pitch scaling, paving the way for sub-30 nm tier pitch.},
  keywords={Technological innovation;Three-dimensional displays;Microprocessors;Gallium arsenide;Computer architecture;Switches;Logic gates;Very large scale integration;Tunneling;Integrated circuit reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074815},
}

@INPROCEEDINGS{11074820,
  author={Zhou, Yuejia and Zhu, Runteng and Luo, Wenpu and Xu, Xiaojian and Qi, Siyuan and Ning, Zhiyuan and Chen, Liang and Shao, Hanyong and Tang, Kechao and Huang, Ru},
  title={3D NOR-Type FeFETs with Record Endurance of 1011, Fast Erase of 50 ns, and Immediate Read-After-Write for In-Memory Learning},
  abstract={In this work, we experimentally demonstrate a 3D NOR-type FeFET (FeNOR) array based on ALD IGO channel. With a scaled channel area down to $0.007 \mu m^{2}$, the 3D FeNOR achieves a record endurance of 1011 cycles, 50 ns erase speed, immediate read-after-write, and minimal layer-to-layer variations. Comprehensive analysis unveils the mechanism of endurance degradation and optimization strategies. Based on multi-domain TCAD simulations, the improvement of erase speed is well-fitted with experiments and mainly attributed to blocking of percolation paths. The good density, reliability and speed make the 3D FeNOR promising for next-generation AI applications, especially in-memory learning.},
  keywords={Degradation;Three-dimensional displays;Very large scale integration;Energy efficiency;Artificial intelligence;Integrated circuit reliability;FeFETs;Optimization;Next generation networking},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074820},
}

@INPROCEEDINGS{11075156,
  author={Cavalcante, C. and Demuynck, S. and Sheng, C. and Batuk, D. and Hosseini, M. and Peng, A. and Stiers, K. and Vandooren, A. and Mertens, H. and Chiarella, T. and Arimura, H. and Mitard, J. and Georgieva, V. and Puliyalil, H. and Marquez, A. Sepulveda and Chistiakova, M. and Peter, A. and Kimura, Y. and Sebaai, F. and Gowda, P. Puttarame and Lai, J. G. and Arslanova, A. and Reddy, N. and Mingardi, A. and Sarkar, S. Kumar and Saroj, R. Kumar and Choudhury, S. and Alvarez, D. and Sarkar, T. and Koo, I. Gyo and Sanchez, E. Altamirano and Subramanian, S. and Lima, L. P. B. and Horiguchi, N. and Biesemans, S.},
  title={Monolithic CFET Flow Improvements Integrating Cover Spacer and Dual-WF RMG},
  abstract={We report on various modifications made to our monolithic-CFET process flow resulting in significant improvements in drive current and CMOS survival rate (SR) (from 5% to 30%). We share our implementation of dual Work Function Metal (WFM) vertical patterning using carbon-based soft mask inside the gate trench integrating TiN and TiAl metals. The quality of the Source-Drain (SD) junctions are improved by implementation of a sacrificial Cover Spacer (CSP) using a vertically patterned sidewall ALD hardmask (HM) covering top device Si channel. Contact pattern placement accuracy is improved at tight gate pitch using a low stress film. pFET via resistance benefit from implementing a dedicated tungsten oxide (WOx) wet etch step. Finally, we discuss ideas with potential for further pFET SR improvements by re-engineering the bottom junction (BJ) and BackSide Contact (BSC) formation involving impact of backside formed bottom dielectric isolation (BS-BDI).},
  keywords={Silicon compounds;Accuracy;Loading;Tungsten;Logic gates;Tin;Very large scale integration;Oxidation;Junctions;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075156},
}

@INPROCEEDINGS{11074866,
  author={Reboh, S. and Zhang, C. and Yamashita, T. and Li, W. K. and Xie, R. and Ando, T. and Bajpai, U. and Mazza, J. and Lanzillo, N. and Cho, E. and Zhou, H. and Strane, J. and Miller, E. and Satterlee, J. and Fan, S. and Sulehria, Y. and Sankarapandian, M. and Mochizuki, S. and Shanker, N. and Johnson, R. and Chu, A. and Khan, S. and Malley, M. and Tseng, W.-T. and Pujari, R. and Stuckert, E. and Tierney, L. and Li, J. and Belyansky, M. and Nasseri, M. and Putnam, N. and Hubbard, A. and Durrant, D. and Fulham, J. and Canaperi, D. and Skordas, S. and Seo, S.-C. and Gluschenkov, O. and Sherony, M. and Wang, J. and Zhu, Y. and Arnold, J. and Wynne, J. and Meli, L. and Peethala, B. and Zhang, J. and Tolbert, J. and Dechene, D. and Shahidi, G. and Edelstein, D. and Ramachandran, R. and Guo, D. and Narayanan, V. and Felix, N. and Standaert, T. and Jagannathan, H. and Sohn, D.-K. and Bu, H. and Khare, M.},
  title={NanoStack Transistor Architecture for CMOS 7A Node and Beyond},
  abstract={NanoStack is a sequential stacking CMOS transistor architecture featuring flexible placement of top and bottom nanosheet channels, thermally stable bottom FET gate stack, thin dielectric bonding and more. We project NanoStack with 4-track base cells to deliver $\sim$ 50% area scaling, $\sim$ 50% iso-power performance improvement or $\sim$ 70% iso-performance power reduction with respect to the 2nm node, fulfilling fundamental requirements for a competitive multi-node CMOS architecture beyond nanosheet. We demonstrate here for the first time a manufacturable sequential integration of multi-channel nanosheet-on-nanosheet NanoStack CMOS featuring ultra-scaled vertical inter-FET isolation.},
  keywords={Scalability;Stacking;Field effect transistors;Very large scale integration;Logic gates;CMOS technology;Dielectrics;Bonding;Thermal stability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074866},
}

@INPROCEEDINGS{11075188,
  author={Wu, Heng and Bu, Weihai and Ge, Yandong and Chu, Yanbang and Sun, Jiacheng and Jin, Jianxiang and Wu, Yongqin and Ren, Ye and Zhou, Falong and Zhang, Lijie and Wu, Jack and Li, Ming and Kang, Jin and Wang, Runsheng and Zhang, Xin and Huang, Ru},
  title={First Experimental Demonstration of Dual-Sided N/P FETs in Filp FET (FFET) on 300 mm Wafers for Stacked Transistor Technology in Sub-1nm Nodes},
  abstract={For the first time, dual-sided devices in Flip FET (FEET) were successfully demonstrated on 300 mm wafers, on which the FFET's unique back-to-back stacking of frontside (FS) NFET and backside (BS) PFET were realized. A series of key process modules including wafer bonding, substrate thinning, channel profile optimization, litho overlay correction and BS performance tuning were successfully developed. As a result, FS NFET after flipping behaved well and decent BS PFET (LG of 30 nm, SS of 73.1 mV/dec, DIBL of 24 mV and on-off ratio of 107) was achieved, comparable to the FS NFET. Thanks to the separated processes on each side of the wafer, this work further validates the outstanding features of FFET: natural split-gate, good multi- Vr tunablity (~ 500 m V) and better process margin without challenging high aspect ratio vertical patterning as required by CFET. Moreover, dual-sided CMOS was also realized, proving the excellent extendibility of FFET. With the great benefits in process-friendliness, design flexibility and scalability as compared with CFET, FFET is validated to be a crucial candidate for logic nodes beyond 1 nm.},
  keywords={Wafer bonding;Performance evaluation;Three-dimensional displays;Scalability;Field effect transistors;Stacking;Very large scale integration;Split gate flash memory cells;Tuning;Substrates},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075188},
}

@INPROCEEDINGS{11074914,
  author={Huang, Bo-Wei and Liu, Ying-Qi and Yao, Ching-Wang and Chen, Wei-Jen and Lin, Min-Kuan and Lin, Xin-Yuan and Cheng, Chun-Yi and Huang, Yi and Lin, Ding-Wei and Lu, Chih-Hsuan and Tsai, Tsung-Han and Liu, C. W.},
  title={First Demonstration of Monolithic 3-Tier Nanosheet Transistor Stacking with Split Gate Featuring Tri-State Inverter/Half Sram Functionalities},
  abstract={Monolithic three-tier transistor stackings with GeSi nanosheets, split gate, and multiple pn layer isolation are demonstrated for the first time. The split-gate process enables one common-gate CFET and one nFET underneath to achieve 6T STAM design with 3T footprint. The functionalities of tristate inverters and half-SRAM (1PD/1PU/1PG) of monolithic three-tier transistor stacking are successfully demonstrated.},
  keywords={Stacking;Logic gates;Very large scale integration;Split gate flash memory cells;Inverters;Transistors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074914},
}

@INPROCEEDINGS{11074900,
  author={Ito, Kosuke and Takenaka, Mitsuru and Takagi, Shinichi and Toprasertpong, Kasidit},
  title={Revealing Wake-Up Mechanism in Ultra-Thin Ferroelectric Hzo: Domain De-Pinning Triggered by Oxygen Vacancy Annihilation Exhibiting Optimal Wake-Up Frequency},
  abstract={We present a new comprehensive model describing wake-up mechanism in ferroelectric $\text{Hf}_{0.5} \text{Zr}_{0.5} \mathrm{O}_{2}$ (HZO), a key challenge in reducing operating voltage with sub- 6 nm films. Strong frequency and temperature dependences suggest that thermally-activated oxygen migration driven by electric-field cycling annihilates vacancies and results in domain de-pinning. It is found that oxygens inside HZO films exhibit dispersive transport rather than conventional drift-diffusion transport. Our insight reveals that fast wake-up can be achieved at the optimum frequency that matches with the oxygen migration oscillation frequency.},
  keywords={Temperature measurement;Temperature dependence;Time-frequency analysis;Temperature;Oxygen;Films;Electric variables measurement;Very large scale integration;Electric fields;Dispersion},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074900},
}

@INPROCEEDINGS{11074816,
  author={Feng, Yang and Wang, Xiaolin and He, Yaoyu and Kang, Yuye and Zhang, Dong and Shi, Wei and Zheng, Zijie and Jiao, Leming and Zhou, Zuopu and Sun, Chen and Ni, Kai and Wu, Jixuan and Chen, Jiezhi and Gong, Xiao},
  title={Record-High $\mathbf{Pr}\left(2 \mathbf{Pr}>\mathbf{40} \mu \mathbf{C} / \mathbf{cm}^{2}\right)$ in 3 nm (Physical) Ferroelectric HZO Annealed at $\mathbf{450}^{\circ}\mathbf{C}$: High-T (85 °C) Electrical Cycling and Oxygen Vacancy Engineering},
  abstract={A remarkable improvement in remnant polarization (2Pr), from below $5 \mu \mathrm{C} / \text{cm}^{2}$ to over $40 \mu \mathrm{C} / \text{cm}^{2}$, has been achieved in an ultra-thin 3 nm (physical) ferroelectric (FE) HZO layer annealed at $450^{\circ} \mathrm{C}$, facilitated by increased oxygen vacancies ($\text{Vo} / \text{Vo}^{2+}$) and high-temperature electrical cycling (HTEC) at $85{ }^{\circ} \mathrm{C}$. Notably, this enhancement persists upon returning to room temperature (RT). Systematic characterization attributes the record-high 2 Pr in the 3 nm HZO layer to a $\text{Vo} / \text{Vo}^{2+}$-assisted phase transition from initially dominant tetragonal (t)-phase to FE orthorhombic (o)-phase. First-principles calculations reveal that the increased $\text{Vo}^{2+}$ during HTEC is crucial for driving the t-to-o phase transition, shifting the free energies of the t- and o-phases, and ultimately stabilizing the o-phase over the t-phase. Our work unlocks new opportunities for optimizing ultra-thin FE layers with a low thermal budget, laying the foundation for the next-generation of FE memory devices.},
  keywords={Visualization;Annealing;Systematics;Films;Simulated annealing;Very large scale integration;Benchmark testing;Iron;Stability analysis;Thermal stability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074816},
}

@INPROCEEDINGS{11074899,
  author={Wu, C.-H. and Chang, C.-H. and Tseng, Y.-M. and Lin, T.-Y. and Kao, K.-H. and Su, C.-J. and Hu, V. P.-H.},
  title={Innovative Nb Electrode Engineering for Ultra-Low-Voltage ($\mathrm{V}_{\text {op }}=0.8\mathrm{V}$) Ferroelectric Memory With Record-High Energy Efficiency: Applications in Selector-Free Feram and Neuromorphic Computing},
  abstract={BEOL-compatible $5-\text{nm} \quad \text{Hf}_{0.5} \text{Zr}_{0.5} \mathrm{O}_{2}$ (HZO) ferroelectric (FE) devices achieve a record-breaking energy efficiency 2Pr-to-operation voltage ($\mathrm{V}_{\text {op }}$) of 43, delivering 2Pr of $34.4 \mu \mathrm{C} / \text{cm}^{2}$ at an ultra-low $\mathrm{V}_{\text {op }}$ of $\pm 0.8\mathrm{V}$, through Nb metal engineering. The Nb approach demonstrates remarkable reliability with an only $4.5 \% 2 \text{Pr}$ loss after 10 years at 85° C and an estimated 10.8 % degradation over 1015 operation cycles. Furthermore, the Nb -integrated selector-free FeRAM exhibits nearly disturbance-free performance (1%), and outstanding potential for neuromorphic computing, characterized by superior linearity and a highly symmetric factor.},
  keywords={Performance evaluation;Degradation;Tensile stress;Nonvolatile memory;Ferroelectric films;Random access memory;Tin;Very large scale integration;Iron;Energy efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074899},
}

@INPROCEEDINGS{11074906,
  author={Liang, Jhih-Yuan and Chen, Yu-Rui and Chen, Guan-Hua and Chen, Yun-Wen and Chen, Yu-An and Yu, Bo-Hui and Chen, Yan-Jyun and Liu, C. W.},
  title={Stacked AFE-Like/FE HZO (4.5nm) to Achieve 0.75V Operating Voltage and Record Endurance Exceeding 7E12 Using Water Quenching and TiN Top Electrodes},
  abstract={Ultra-low operating voltage ($\mathrm{V}_{\text {op}}$) and highly reliable metal-ferroelectric-metal (MFM) capacitors utilizing stacked AFE-like(A-L)/FE with water quenching are demonstrated. The stacked $\mathrm{A}-\mathrm{L} / \text{FE}$ has 22 % reduction in $2 \mathrm{V}_{\mathrm{c}}$ (1.4 V) in major loops than our previously reported $\beta-\mathrm{W} / \text{FE} / \beta-\mathrm{W}$ [1] with the same thickness of 4.5 nm and the similar $2 \mathrm{P}_{\mathrm{r}}\left(57 \text{vs} 58 \mu \mathrm{C} / \text{cm}^{2}\right)$. Water quenching further decreases $14 \% 2 \mathrm{V}_{c}(1.2 \mathrm{V})$ due to the smaller grain size than slow cooling. The TiN top electrode is used to preserve A-L in the stacked structure after wake-up. With $0.75 \mathrm{V} \mathrm{V}_{\text {op}}$ in minor loops, the TiN/A-L/FE/$\beta-\mathrm{W}$-W capacitor with water quenching reaches record fatigue-free endurance exceeding 7E12 cycles with 2 $\mathrm{P}_{\mathrm{r}}$ of $30 \mu \mathrm{C} / \text{cm}^{2}$.},
  keywords={Electrodes;Grain boundaries;Cooling;Capacitors;Superlattices;Voltage;Transforms;Tin;Very large scale integration;Reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074906},
}

@INPROCEEDINGS{11074960,
  author={Zhao, Xuanyu and Yu, Jie and Li, Yu and Wang, Yiwei and Cao, Fansen and Cheng, Yan and Wei, Yingfen and Jiang, Hao and Liu, Qi and Liu, Ming},
  title={First Demonstration of Annealing-Free RT-Prepared AlScN Film with Large Polarization ($2 \mathrm{P}_{\mathrm{r}}>300 \mu \mathrm{C} / \text{cm}^{2}$) and Ultra-Sharp $\mathrm{E}_{\mathrm{c}}$ Distribution for 0T1C FeRAM},
  abstract={Selector-free 0T1C FeRAM requires ferroelectric (FE) films with high polarization ($2 P_{\mathrm{r}}$) and sharp coercive field ($E_{\mathrm{c}}$) distribution. In this work, we present the first demonstration of a 1kb 0T1C FeRAM based on the optimized AlScN FE film, through electrode engineering and interface optimization. An annealing-free room-temperature (RT)-prepared AlScN epitaxial film with high-quality (001) orientation is achieved, resulting in a large $2 P_{\mathrm{r}}>300 \mu \mathrm{C} / \text{cm}^{2}$ and an ultra-sharp $E_{\mathrm{c}}$ distribution (record $\alpha$ of 0.045). The sharp $E_{\mathrm{c}}$ allows superior disturb immunity under the $\mathrm{V}_{\text{dd}} / 2$ read scheme for array operations, even at an elevated 300°C. Furthermore, our circuit model proposes that the optimized AlScN FE film can support much larger array size compared to other ferroelectrics, thanks to its enhanced $2 P_{\mathrm{r}}$ and sharper $E_{\mathrm{c}}$ distribution. This work underscores the great potential of AlScN-based FE films for high-capacity emerging memory technologies.},
  keywords={Electrodes;Annealing;Nonvolatile memory;Ferroelectric films;Films;Random access memory;Very large scale integration;Iron;Integrated circuit reliability;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074960},
}

@INPROCEEDINGS{11075200,
  author={Chiang, Tsung-Che and Chang, Yu-Ching and Huang, Chi-Ruei and Hsu, Chung-Hsuan and Liu, Po-Tsun},
  title={First Demonstration of BEOL-Compatible ALD-Deposited 2 nm-Thick Indium-Tungsten-Tin-Oxide (IWTO) TFTs with Superior Short-Channel Electrical Characteristics: Achieving Enhancement-Mode $\mathrm{V}_{\text{TH }}, \mathrm{I}_{\text{ON } / \text{OFF }}>10^{{10}}$, SS ~ 63.3 mV/dec},
  abstract={This work successfully demonstrates ALD-derived ultra-thin amorphous indium-tungsten-tin-oxide (a-IWTO) TFTs with a channel thickness ($\mathrm{T}_{\text{CH}}$) of 2 nm. Two distinct a-IWTO compositions were systematically investigated, resulting in devices with exceptional electrical performance including a high on/off current ratio ($\mathrm{I}_{\text{ON}} / \mathrm{I}_{\text{OFF}}$) exceeding 1010, a low subthreshold swing (SS) of $63.3 \text{mV} / \text{dec}$, a small DIBL of $37.8 \text{mV} / \mathrm{V}$, enhancement-mode operation, and negligible $\mathrm{V}_{\text{TH}}$ roll-off following oxygen annealing at a short channel length of 70 nm. These results demonstrate the competitive performance of IWTO TFTs compared to state-of-the-art amorphous oxide semiconductor devices.},
  keywords={Performance evaluation;Annealing;Voltage measurement;Current measurement;Indium tin oxide;Very large scale integration;NIST;Electric variables;Ions;Circuit stability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075200},
}

@INPROCEEDINGS{11074862,
  author={Takahashi, Takanori and Hoshii, Takuya and Tsuruma, Yuki and Sunagawa, Misa and Tomai, Shigekazu and Park, Jongho and Tamamoto, Hiroki and Kakushima, Kuniyuki and Uraoka, Yukiharu},
  title={ALD Polycrystalline Ga-Doped In2O3 (Poly-IGO) Nanosheet Exceeding Intrinsic Mobility of 120 cm2/Vs for Process-Friendly BEOL-Compatible FET Application},
  abstract={We have evaluated ALD polycrystalline Ga-doped In2O3 (poly-IGO) nanosheets and investigated their thickness scaling and electron transport properties through FET operation. Ga-doping to In2O3 enhances the FET performance as well as patterning properties. A 5-nm-thick poly-IGO showed a high mobility of 120 cm2/Vs with a low contact resistivity of 9.2 × 10−7 Ωcm2. The poly-IGO exhibited excellent thickness scaling down to ~3 nm keeping the intrinsic mobility of 100 cm2/Vs. The mobility of poly-IGO is predominantly degraded by tensile lattice strain. A strain-free lattice structure obtained with thin channel (< 10 nm) ALD poly-IGO nanosheets are advantageous for 3D-integrated devices.},
  keywords={Field effect transistors;Lattices;Very large scale integration;Conductivity;Nanoscale devices;Strain;Electrons},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074862},
}

@INPROCEEDINGS{11074856,
  author={Lin, Jian-Yu and Niu, Chang and Lin, Zehao and Liu, Chang and Lu, Juanjuan and Wang, Haiyan and Ye, Peide D.},
  title={Critical Role of Quantum Confinement on Transfer Length in Achieving High-Performance In2O3 Transistors with Ultra-Scaled Contacted Gate Pitch},
  abstract={In this work, for the first time, we study the contact length $\left(\mathrm{L}_{\mathrm{C}}\right)$ and contacted gate pitch (CGP) scaling in ultrathin $\text{In}_{2} \mathrm{O}_{3}$ field-effect transistors (FETs). A large 53 % decrease in transfer length ($\mathrm{L}_{\mathrm{T}}$) from 76 to 36 nm can be observed by increasing the $\text{In}_{2} \mathrm{O}_{3}$ channel thickness ($\mathrm{T}_{\text{ch}}$) from 1.2 nm to 2.0 nm, which can be understood by the positive-to-negative Schottky barrier height ($\Phi_{\text{SB}}$) transition modulated by the quantum confinement (QC) effect in $\text{In}_{2} \mathrm{O}_{3}$ channel. Leveraging the record-low $\mathrm{L}_{\mathrm{T}}$ of 36 nm optimized by the QC, $2.0 \text{nm} \text{In}_{2} \mathrm{O}_{3}$ FETs demonstrate a record-low contact resistance ($\mathrm{R}_{\mathrm{C}}$) of $140 \Omega \cdot \mu$ m and a record-high maximum drain current ($\mathrm{I}_{\mathrm{D}, \max}$) of $1.57 \text{mA} / \mu \mathrm{m}$ at ultrascaled CGP of 80 nm among all reported oxide semiconductor FETs with CGP scaling.},
  keywords={Field effect transistors;Schottky barriers;Potential well;Very large scale integration;Logic gates;Benchmark testing;Contact resistance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074856},
}

@INPROCEEDINGS{11075080,
  author={Wu, Yu-Shan and Liu, Yuan-Ming and Sung, Hsien-Ming and Ma, Rong-Wei and Gracia, Johannes and Fujiwara, Hidenari and Lu, Kuan-Wei and Liu, C. W.},
  title={First Demonstration of 2-floor GAA In2O3 Nanosheet FET Enabled by TiN Sacrificial Layers and Fluorine Passivation},
  abstract={The true two-floor stacked PEALD (plasma-enhanced atomic layer deposition) In2O3 gate-all-around (GAA) nanosheet (NS) FET is demonstrated for the first time by the novel metallic sacrificial layers (MSLs, TiN). MSLs connect stacked S/D and form n+ region to improve contact resistance. Channel release by SF6 can shift $\mathrm{V}_{\mathrm{T}}$ positively by passivating oxygen vacancy (Vo) defects. The gate stack is deposited all at once by ALD to realize the GAA structure. The process temperatures are below 300°C with the back-end-of-line (BEOL) compatibility. The two-floor GAA NSFET achieve high drive current $(\mathrm{I}_{\text{on}})$ of $146\mu \mathrm{A}/\mu \mathrm{m} {@} \mathrm{V}_{\text{OV}}=\mathrm{V}_{\text{DS}}=1\mathrm{V},\ \mathrm{I}_{\text{on}}/\mathrm{I}_{\text{off}} > 10^{7}$, and high stability of positive bias stress (PBS) with the VT shift as small as 60mV at $\mathrm{V}_{\text{OV}}=3.6\mathrm{V}$ for 1000sec. Furthermore, adding IGZO into In2O3 channels achieves a positive VT of 1.6V with $\mathrm{I}_{\text{on}}$ of $77\mu \mathrm{A}/\mu \mathrm{m}$ at $\mathrm{V}_{\text{OV}}=\mathrm{V}_{\text{DS}}=1\mathrm{V}$. The stacked NS architecture enables oxide semiconductor (OS) FETs to overcome $\mathrm{I}_{\text{on}}$ limitations due to low mobility.},
  keywords={Three-dimensional displays;Gallium arsenide;Fluorine;Sulfur hexafluoride;Tin;Logic gates;Very large scale integration;Nickel;Plasma temperature;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075080},
}

@INPROCEEDINGS{11074938,
  author={Yang, Junjie and Liu, Sihang and Yu, Jingjing and Cui, Jiawei and Chang, Hao and Li, Teng and Lao, Yunhong and Yang, Xuelin and Liu, Xiaosen and Wang, Maojun and Shen, Bo and Wei, Jin},
  title={3-KV GaN Smart Power Integration Platform for High-Power-Density Conversion Systems Using Charge-Balanced Superjunction Technology},
  abstract={This work reports a 3-kV smart GaN power integration platform on sapphire substrate based on charge-balanced superjunction (SJ) technology. The platform provides a variety of low-voltage (LV) components for controlling/driving circuitry, including resistors, capacitor, LV enhancementmode HEMT (LV E-HEMT), depletion-mode transistor (LV D-HEMT), LV-rectifier. For high-voltage (HV) power loop circuitry, the platform provides 3-kV E-mode surperjunction HEMT (HV SJ-HEMT) and superjunction rectifier (HV SJrectifier). The proposed SJ structure leads to a 1.6 times enhancement in breakdown voltage ($B V$) and a lower specific ON-resistance ($R_{\text{SP}}$). The $3-\text{kV}$ HV devices present a $B V>6.5$ kV, leaving a large operation margin. The figure of merit ($\text{FOM}=B V^{2} / R_{\text{SP}}$) of HV devices is among the best in literature.},
  keywords={Resistors;Low voltage;Capacitors;Rectifiers;High-voltage techniques;Very large scale integration;Transistors;Substrates;D-HEMTs},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074938},
}

@INPROCEEDINGS{11074887,
  author={Ma, Jie and Gu, Yong and Zhao, Mengyao and Nie, Tianchun and Wei, Jiaxing and Li, Sheng and Huang, Runhua and Bai, Song and Liu, Siyang and Sun, Weifeng and Zhang, Long},
  title={Improving Irradiation Reliability of 4H-SiC 1200V LDMOS and 20V CMOS Logic Circuits with Leakage Current Blocking Technology},
  abstract={Replacing silicon large-scale integrated circuits (ICs) with silicon carbide (SiC) large-scale ICs can significantly enhance the radiation hardness of power electronic systems. High voltage lateral diffused metal oxide semiconductor (LDMOS) and low-voltage CMOS logic circuits are the two key elements that make up large-scale power ICs. It is found in this work that the positive charge traps generated after Total Ionizing Dose (TID) irradiation induce unexpected leakage paths, resulting in premature breakdown of LDMOS and degraded output voltage swing of logic circuits, while for Single-Event (SE) irradiation, increased leakage current leads to the latch up, and then device/circuit failure. An economical reinforcement technology with floating $\mathrm{N}+/ \mathrm{P}+$ rings and $\mathrm{P}+$ strips is proposed. Breakdown voltage ($B V$) of the SiC LDMOS with the reinforcement technology can be increased from 692 V to 1250 V at TID $=300 \text{kGy}$. For reinforced logic circuit with full voltage swing, $\times 3$ and $\times 1.44$ improvements in TID and SE irradiation endurances can be obtained, respectively, enabling robust operation in aerospace and nuclear applications.},
  keywords={Radiation effects;Three-dimensional displays;Silicon carbide;Current measurement;Logic circuits;High-voltage techniques;Logic gates;Very large scale integration;Ions;Leakage currents;4H-SiC;circuit;irradiation;reliability;leakage},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074887},
}

@INPROCEEDINGS{11075139,
  author={Alian, Alireza and Yadav, Sachin and ElKashlan, Rana and Sibaja-Hernandez, Arturo and Yu, Hao and Banerjee, Sourish and O'Sullivan, Barry and Esfeh, Babak Kazemi and Peralagu, Uthayasankaran and Parvais, Bertrand and Collaert, Nadine},
  title={High Power/PAE (27.8dBm/66%) Emode GaN-on-Si MOSHEMTs for 5V FR3 UE Annlications},
  abstract={Enhancement mode (Emode) GaN MOSHEMTs with high-polarization charge density barriers (AlN, InAlN) and regrown source/drain are investigated for low-voltage 6G FR3 power amplifiers. We demonstrate high output power and PAE of $\sim 27.8\text{dBm}(\sim \text{lW}/\text{mm})$ and 66%, respectively, at 13GHz for 115 nm gate length Emode MOSHEMTs using an InAlN top barrier and an AlGaN/cGaN composite back barrier (BB). Furthermore, a record low total contact resistance of 0.024 $\Omega$. mm is demonstrated by incorporating highly n-doped selectively regrown (In)GaN layers on GaN channel, which, according to TCAD simulations, can further boost the output power to $2\mathrm{W}/\text{mm}$.},
  keywords={Resistance;Radio frequency;Low voltage;Power amplifiers;Very large scale integration;Contact resistance;Wide band gap semiconductors;III-V semiconductor materials;Power generation;Aluminum nitride},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075139},
}

@INPROCEEDINGS{11074924,
  author={Tsai, C.Y. and Liu, S.F. and Hsuen, J.H. and Lin, Brian and Hsieh, C.R. and Chan, C.W. and Chang, C.Y. and Huang, Y.C. and Yang, Julien and Wu, J.J. and Chen, Y.W. and Chang, M.F. and Chih, Y.D. and Chu, W.T. and Huang, K.C. and Chuang, Harry},
  title={A CMOS-Compatible 12nm 8Mb MLC RRAM Enabling Producible 2-Bit Per Cell for High Energy Efficiency Compute-In-Memory in Edge AI Applications},
  abstract={A 12nm 2-bit per cell RRAM, featuring co-optimization across circuit design, write algorithms, and memristor engineering, demonstrates remarkable 10K-cycle endurance and $85^{\circ} \mathrm{C} / 10 \text{yr}$ retention on physical 8-megabit arrays, exhibiting superior inference accuracy in compute-in-memory applications. Notably, the intrinsic RRAM cells present 1Bcycle endurance and $125^{\circ} \mathrm{C} / 10 \text{yr}$ retention capability. Achieving this requires precise tuning of the oxygen and vacancy density in the memristor through circuit design and write algorithms, and accounts for the vacancy formationrecombination energy by adjusting memristor property in each storage state. This innovation paves the way for edge artificial intelligence (AI) processors to utilize a simple RRAM solution for firmware storage and high energy efficiency AI computing in application-specific-integrated-circuits (ASIC).},
  keywords={Accuracy;Memristors;Edge AI;Speech recognition;Very large scale integration;In-memory computing;Inference algorithms;Energy efficiency;Circuit synthesis;Optimization;RRAM;12nm;multi-level-cell;embedded;memristor;reliability;edge AI;compute-in-memory},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074924},
}

@INPROCEEDINGS{11074870,
  author={Ban, S. and Kim, M. and Park, N. and Park, J. and Yeon, J. and Yun, D. and Park, T. and Oh, S. and Lee, B. and Lee, W. and Do, G. and Bae, Y. and Kim, J. and Park, U. and Yeo, I. and Bae, J. and Kang, M. and Hwang, S. and Ahn, D. and Jung, G. and Lim, J. and Sung, Y. and Lee, J. and Yim, S. and Lee, M. and Park, M. and Kim, T. and Choi, A. and Park, G. and Chung, S. and Tak, Y. and Ko, J. and Han, J. and Chae, S. and Kim, S. G. and Yi, J. and Cho, Y. and Cha, S.},
  title={Achieving Outstanding Endurance (>107) in Large-Array Two-Deck 16 Nm SOM Through Process, Structure, and Design Strategies for Emerging SCM Applications},
  abstract={We successfully demonstrated a two-deck structure selectoronly memory (SOM) based on a 16 nm half-pitch, achieving endurance exceeding 107 cycles at raw bit error rate (RBER) 200 ppm through process, structure, and design strategies. Our findings reveal that SOM endurance is not only influenced by process factors such as dual functional material (DFM) and encapsulation but also strongly depends on the spike charge. This underscores the importance of both spike charge suppression and process optimizations to enhance SOM performance.},
  keywords={Encapsulation;Resistance;Spectroscopy;Three-dimensional displays;Transmission electron microscopy;Voltage;Very large scale integration;X-ray imaging;Surface treatment;Electrons;selector-only memory;endurance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074870},
}

@INPROCEEDINGS{11075063,
  author={Park, J. H. and Lee, C. H. and Park, W. H. and Park, K. D. and Song, S. J. and Eun, S. H. and Park, Y. J. and Lee, K. W. and Park, I. M. and Wu, Z. and Oh, S. C. and Yoon, H. C. and Kim, S. K. and Park, K. M. and Lee, S. H. and Park, S. W. and Hyun, S. J. and Song, Y. J. and Ahn, S. J. and Song, J. H.},
  title={Scalable Fabrication and Demonstration of the First Fully Integrated 14nm 2-Stack SOM (Selector Only Memory) Device},
  abstract={This study successfully demonstrates the fabrication and operation of the first fully integrated 14nm 2-stack SOM (Selector Only Memory) devices with a 1-Gb main cell array. A read window over 750mV is achieved across all decks and all cell characteristics are maintained up to the 14nm node with the advanced processes, providing the scalability of SOM device. Furthermore, comprehensive reliability evaluations is conducted, confirming the feasibility of the mass production.},
  keywords={Fabrication;Degradation;Mass production;Electric potential;Systematics;Scalability;Failure analysis;Voltage;Very large scale integration;Reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075063},
}

@INPROCEEDINGS{11075112,
  author={Seo, Yoori and Kim, Dongmin and Jung, Laeyong and Lee, Jangseop and Kwon, Ohhyuk and Baek, Chanhwi and Park, Yu Bin and Lee, Tae Hoon and Hwang, Hyunsang},
  title={Multi-Stack InTe Selector-Only Memory (SOM) Achieving Ultra-Low Power Operation $(\mathbf{10}\ \boldsymbol{\mu} \mathbf{A})$ and Excellent Endurance ($\sim \mathbf{10}^{\mathbf{10}}$ cycles)},
  abstract={We present an innovative In-Te based selector-only memory (SOM) featuring a multi-stack architecture that significantly boosts power efficiency and reliability. Through XPS, Raman spectroscopy and DFT simulation, we clarified how optimized In-Te bonding and trap engineering enable successful SOM operation while reducing write current $(\mathrm{I}_{\text{write}})$ to an ultra-low $10\ \mu \mathrm{A}$. This approach also resulted in a sufficient memory window (MW ~ 1 V), minimized variability, and achieved excellent endurance ($-10^{10}$ cycles).},
  keywords={Performance evaluation;Electron traps;Voltage measurement;Discrete Fourier transforms;Memory management;Random access memory;Switches;Very large scale integration;Structural engineering;Bonding},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075112},
}

@INPROCEEDINGS{11074807,
  author={Choi, Minwoo and Sung, Ha-Jun and Park, Jongbong and Koo, Bonwon and Moon, Junhyuk and Yang, Wooyoung and Park, Yongyoung and Ham, Yongnam and Lee, Chang Seung and Chae, Hwasung and Wu, Zhe and Lee, Jabin and Kim, Chungman and Yang, Kiyeon and Kang, Youngjae},
  title={Differences in Operational Mechanisms of As- and Sb-Based Selector Only Memory for Emerging 3DXP Architecture},
  abstract={Selector Only Memory (SOM) exhibits unique polaritydependent $\mathrm{V}_{\text {th }}$ shift characteristics, but their origins are still unclear. In this study, we investigated the operation mechanisms of group 15 elements, such as As and Sb, which contribute to the amorphous stability. For this purpose, GeAsSeIn and GeSbSeIn SOM devices were fabricated on 12-inch wafer. The I-V analysis confirmed distinct conduction mechanisms between the materials, and Sb-related trap states result in a larger memory window (2.1V) and low $\mathrm{V}_{\text {th }}$ drift ($4 \text{mV} / \text{dec}$) compared to As-based SOM devices. TEM analysis revealed the local atomic distribution, showing high RDE properties ($>60 \mathrm{G}$) for both As and Sb-based SOM devices, despite Sb migration during the initial cycle. Also, photonic IV based trap profile measurement and DFT calculations were performed to identify the origin of the trap states. These results demonstrate that SOM exhibits diverse operational mechanisms, emphasizing the need for fundamental analysis for each material.},
  keywords={Atomic measurements;Correlation;Discrete Fourier transforms;Computer architecture;Very large scale integration;Market research;Threshold voltage;Stability analysis;Bonding;Photonics},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074807},
}

@INPROCEEDINGS{11075202,
  author={Jaikissoon, M. and Buragohain, P. and Mortelmans, W. and Oguz, K. and Rogan, C. and Lux, J. and Kitamura, A. and Engel, C. and Vreeland, R.F. and Barnett, H. and Brooks, Z. and Harlson, S. and Pinnepalli, S.S.K. and Gillispie, E. and Toku, K. and Wilson, T. and Oni, A. and Penumatcha, A. V. and Dorow, C.J. and Kavrik, M. and Kozhakhmetov, A. and Maxey, K. and Arefin, N. and Kevek, J. and Tronic, T. and Metz, M. and Clendenning, S.B. and O'Brien, K.P. and Avci, U.},
  title={Record PMOS WSe2 GAA Performance Using Contact Planarization, and Systematic Exploration of Manufacturable, High-Yield Contacts},
  abstract={Two-dimensional (2D) transition metal dichalcogenides (TMDs) hold significant promise for both front-end-of-line (FEOL) and back-end-of-line (BEOL) applications. Here, we report new approaches to contact formation in global back gate 2D PMOS transistors using a manufacturable physical vapor deposition (PVD) sputtering process. We present a systematic study of novel sputtered contacts ($\text{Sb} / \text{Pt}, \text{Sb}_{2} \text{Te}_{3}$, $\text{Bi}_{2} \text{Te}_{3}$) to multilayer $\text{WSe}_{2}$ and through statistical analysis we discover trends of increasing performance with Pt thickness and post-metal anneal. Optimized conditions give $\mathrm{R}_{\mathrm{C}}$ down to $1.3 \mathrm{k} \Omega. \mu \mathrm{m}$ at $\mathrm{N}(\text{inv})=1 \mathrm{e} 13 \text{cm}^{-2}$ and $\mathrm{I}_{\mathrm{d}, \max }=212 \mu \mathrm{A} / \mu \mathrm{m}$ at $\mathrm{V}_{\mathrm{d}} =-1 \mathrm{V}$, the highest performance to date using sputtered contacts. Further, we pioneer a new approach to contact-first gate-allaround (GAA) schemes through contact planarization using chemical mechanical polishing (CMP). This first-of-kind CMP flow demonstrates significant performance gains over non-CMP contacts ($4 \times$). CMP Ru contacts to monolayer $\text{WSe}_{2}$ GAA devices achieve record drive currents $>600 \mu \mathrm{A} / \mu \mathrm{m}$ and $\text{SS}=132 \text{mV} / \text{dec}$.},
  keywords={Performance evaluation;Systematics;Planarization;Statistical analysis;Two-dimensional displays;Gallium arsenide;Very large scale integration;Logic gates;Transition metal dichalcogenides;Sputtering;2D FET;TMD;$\text{WSe}_{2}$;CMP;GAA},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075202},
}

@INPROCEEDINGS{11075219,
  author={Xu, Ying and Sun, Yiyuan and Zhou, Zuopu and Zheng, Zijie and Luo, Sheng and Sun, Chen and Kang, Yuye and Ni, Kai and Liang, Gengchiau and Gong, Xiao},
  title={First Demonstration of BEOL-Compatible Co-Sputter Deposited $\text{Te}_{1-x} \text{Se}_{x}$ p-FETs Enabling 3D Stackable Oxide Semiconductor CFET, DRAM, and First CFET-Structured SRAM},
  abstract={We report the world's first BEOL-compatible p-type Tellurium ${ }_{0.8}$ Selenium $_{0.2}\left(\text{Te}_{0.8} \text{Se}_{0.2}\right)$ FETs with aggressively-scaled channel length ($L_{\text{ch}}$) of 50 nm, achieved through Te-Se co-sputtering for bandgap tuning and performance improvement. Our $\text{Te}_{0.8} \text{Se}_{0.2}$ FETs exhibit outstanding performance, including a mobility of $24 \text{cm}^{2} / \mathrm{V} \cdot \mathrm{s}$, an $I_{\text {on }} / I_{\text {off }}$ ratio $>10^{4}$, and a $S S$ of $\sim 300 \text{mV} /$ Dec., all among the best. This device has enabled the realization of 3D stackable IGZO/ $\text{Te}_{0.8} \text{Se}_{0.2}$ DRAM with excellent retention over 1000 s and short channel IGZO/Te ${ }_{0.8} \text{Se}_{0.2}$ CFET, achieving a gain of 38 at $V_{\text{DD}}=2.5$ V. Based on this CFET, we further experimentally demonstrated the world's first stacked oxide semiconductors CMOS SRAM with 4T footprint.},
  keywords={Performance evaluation;Temperature dependence;Temperature distribution;Three-dimensional displays;Annealing;Photonic band gap;Field effect transistors;Random access memory;Very large scale integration;Tuning},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075219},
}

@INPROCEEDINGS{11074883,
  author={Chiu, Kuan-Hsiang and Wu, Wen-Chia and Huang, Han-Yi and Chih, Jia-Hao and Chang, Yu-Cheng and Wang, Sung-Tsun and Chen, His-Yu and Lin, Chiung-Yuan and Lien, Der-Hsien and Hu, Chenming and Chien, Chao-Hsin},
  title={Homo-Channel WSe2 n/pFETs with High Performance and On/Off Ratio Using Tunable Doping},
  abstract={Achieving symmetric $\mathrm{n} / \text{pFETs}$ with high current densities and matched threshold voltages in a single 2D channel material is crucial for homo-channel CMOS integration and the realization of 3D monolithic applications. This work introduces novel n-doping using aluminum nitride (AlN) and p -doping using molybdenum oxide ($\text{MoO}_{\mathrm{x}}$) on CVD-grown monolayer tungsten diselenide ($1 ~\mathrm{L}-\text{WSe}_{2}$), achieving record-high electron current ($\sim 230 \mu ~\mathrm{A} / \mu \mathrm{m}$ at $\mathrm{V}_{\text{DS}}=1 ~\mathrm{V}$) with lowest contact resistance ($\sim 1 \mathrm{k} \Omega \cdot \mu \mathrm{m}$) and one of the best reported hole currents ($>400 \mu ~\mathrm{A} / \mu \mathrm{m}$ at $\mathrm{V}_{\text{DS}}=-1 ~\mathrm{V}$), both in enhancement mode. AlN/MoO ${ }_{x}$ doping enables tunable doping strength with on/off ratio ($>10^{6}$) and well-matched $\mathrm{V}_{\text{TH}}$ for n - and pFETs. This work demonstrates high gain ($>25 ~\mathrm{V} / \mathrm{V}$ at $\mathrm{V}_{\text{DD}}=1.5 ~\mathrm{V}$) and the potential of $\text{WSe}_{2}$ for mono-channel CMOS technology.},
  keywords={Tungsten;Doping;Very large scale integration;Charge carrier processes;Contact resistance;CMOS technology;Threshold voltage;III-V semiconductor materials;Current density;Aluminum nitride},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074883},
}

@INPROCEEDINGS{11074843,
  author={Safron, Nathaniel and Chiu, Hsin-Yuan and Chao, Tzu-Ang and Liu, Leo and Passlack, Matthias and Gilardi, Carlo and Azizi, Amin and Zhong, Donglai and Wu, Jui-Jen and Natani, Shreyam and Kummel, Andrew and Li, Shengman and Mitra, Subhasish and Chien, Chao-Hsin and Wong, H.-S. Philip and Chang, Marvin M.-F. and Pitner, Gregory and Radu, Iuliana and Cao, Min},
  title={$1000 \times$ Lower Leakage in High-Performance Carbon Nanotube Nanosheet Fets},
  abstract={This work reports a Carbon Nanotube (CNT) Nanosheet PFET with record performance ($I_{\text{MAX}}=0.9 \text{mA} / \mu \mathrm{m}$), leakage ($I_{\text{MIN}}$ of $20 \text{pA} / \mu \mathrm{m}$), and sub- $V_{\mathrm{T}}$ slope of $93 \text{mV} / \text{dec}$ at -0.5 V $V_{\text{DS.}}$ This result is attributed to a larger electronic bandgap which simultaneously suppresses leakage by $\sim 1000 \times$ and improves sub- $V_{\mathrm{T}}$ slope from 150 to $93 \text{mV} / \text{dec}$ at $V_{\text{DS}}=-0.5 \mathrm{V}$. Using planar single-CNT and network CNT FETs, we demonstrate feasibility of performance-matched NFET and PFET with larger bandgap. The future practical application of CNT electronics will be enabled by gate stack optimization and suppressed variation, for which key trends and targets are investigated by SRAM yield analysis.},
  keywords={Photonic band gap;Random access memory;Materials reliability;Carbon nanotubes;Very large scale integration;Logic gates;Market research;Nanoscale devices;Nanostructured materials;Optimization;1D Channel;Carbon Nanotube;Low Dimensional Material;Transistor;MOSFET;Nanosheet;SRAM;Band Gap},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074843},
}

@INPROCEEDINGS{11074931,
  author={Hu, Luhing and Shim, Jaewoo and Kim, Joonyun and Jang, Hyeong-Seok and Park, Baekwon and Kim, Sang Won},
  title={Wafer-Scale Monolithic 3D Integration of CMOS Logic Gates Based on 2D Materials},
  abstract={Monolithic three-dimensional (M3D) integration offers a promising path to enhance transistor density and energy efficiency in next-generation electronics. In this work, we explore the 8 -inch wafer-scale integration of complementary metal-oxide-semiconductor (CMOS) logic gates, including inverters, and NAND gates using two-dimensional materials (2DMs), specifically molybdenum disulfide $\left(\text{MoS}_{2}\right)$ and tungsten diselenide ($\text{WSe}_{2}$). By vertically stacking $\text{MoS}_{2}$-based N-channel MOS (NMOS) and WSe ${ }_{2}$-based P-channel MOS (PMOS) field-effect transistors (FETs), we demonstrate a high-performance CMOS inverter with a voltage gain of 60 at a Vdd of 2 V.},
  keywords={Stacking;Tungsten;Voltage;Logic gates;Very large scale integration;CMOS technology;Inverters;Wafer scale integration;Three-dimensional integrated circuits;Next generation networking;M3D;2DMs;PMOS;logic gate},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074931},
}

@INPROCEEDINGS{11075096,
  author={Jeon, Intak and Lim, Hanjin and Kim, Seon Yong and Sur, Yeahan and Kim, Jin Soak and Lee, Yongbin and Choi, Jayun and Hong, Yaejin and Ahn, Sehyoung and Jung, Chang Hwa and Chung, Eunae and Goh, Youngin and Lee, Kilho and Kim, Wanki and Kwon, Hyucknam and Park, Sung-Wook and Kwon, Daewoong and Jeon, Jongwook and Lee, Seung Hun and Ha, Daewon and Ahn, Su Jin and Hyun, Sangjin and Song, Jaihyuk},
  title={Designing Robust Interfaces of HZO Module (>1012 at 85 °C) with High Sensing Margin (>300 mV) for ≤1.1 V 1T-1F with Common Plate Line and 1T-nF FeRAM},
  abstract={Energy-efficient AI will be realized in conjunction with ferroelectric nT-mF in the near future. First, we present a ferroelectric module solution that is equipped with Pr-boosted HZO (2Pr $54\ \mu \mathrm{C}/\text{cm}^{2}$) and universally improved ILs for FE, MPB and AFE. The films show high write/read endurance cycles ($> 10^{12}$ at 85 °C). Second, we implement the solution into 1T-1F with a common plate line and 1T-nF FeRAM. We confirm sufficiently high sensing margins (≥300 mV).},
  keywords={Nonvolatile memory;Ferroelectric films;Films;Capacitors;Random access memory;Very large scale integration;Tin;Iron;Sensors;Timing;Common plate line;1T-1F;1T-nF;HZO},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075096},
}

@INPROCEEDINGS{11074964,
  author={Deng, Shan and Howe, John and Ma, Sizhe and Tauki, Sadik Yasir and Zhao, Zijian and Duan, Jiahui and Lee, YuShan and Qin, Yixin and Joshi, Rajiv and Kampfe, Thomas and Gong, Xiao and Narayanan, Vijaykrishnan and Ni, Kai},
  title={Vertical 2T-nC FeRAM Demonstration: BEOL Read Transistor for 4F2 Memory Strings and Two-Terminal Selector Design for Polarization Disturb Mitigation},
  abstract={In this work, we demonstrate a vertical 2T-nC FeRAM with a back-end-of-line (BEOL) read transistor ($T_{\mathrm{R}}$) for $4 \mathrm{F}^{2}$ string and propose a selector design to mitigate polarization disturb in passive capacitor crossbar arrays. Key contributions include: 1) successful integration and operation composed of a Si MOSFET write transistor ($T_{\mathrm{W}}$), 3-layer cylindrical ferroelectric capacitors, and Si-doped $\text{In}_{2} \mathrm{O}_{3}$ BEOL $T_{\mathrm{R}}$, demonstrating the feasibility of $4 \mathrm{F}^{2} 2 \mathrm{T}-\text{nC}$ string; 2) introducing nonlinearity into the capacitor stack to suppress ferroelectric voltage drop under inhibition biases while maintaining sufficient write voltage, reducing disturbance; 3)modeling and experimental validation of inserting a metalsemiconductor (a-Si)-metal (MSM) selector into the capacitor in mitigating the disturb, particularly achieving 9x reduction of disturb after $10^{6}$ cycles in the $V_{\mathrm{W}} / 2$ scheme.},
  keywords={MOSFET;Nonvolatile memory;Ferroelectric films;Prevention and mitigation;Capacitors;Random access memory;Voltage;Very large scale integration;Silicon;Transistors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074964},
}

@INPROCEEDINGS{11075099,
  author={Siddiqui, S. A. and Chang, S.-C. and Neumann, C. and Alpizar, B. Granados and Rajeeva, B. Bangalore and Lin, C.-C. and Choe, G. and Krist, B. and Augustus, A. and Metz, M. and Kavalieros, J. and Avci, U.},
  title={FeRAM Capacitor with Novel Low-Power, Non-destructive and High Endurance Read operation for High-density Embedded Memory},
  abstract={For the first time, advanced CMOS compatible HZO-based FeRAM trench capacitors, are demonstrated with non-destructive read (R) endurance $> 10^{4}$ cycles at elevated temperature (85°C) after single write (W). This ensures continuous R between refresh cycles and eliminates rewrite after every R, leading to further reduction in both latency and energy of R operation, over FeRAM with destructive R. Compared to published non-destructive read operation (NDRO) scheme, a higher R bias of 0.8V is used to obtain $> 28\times$ memory window (MW) boost [1], [2], which originates from high-charge response from domain walls (DWs) due to partial polarization switching. Furthermore, 5yr lifetime at elevated temperature is extrapolated under R/W-intensive NDRO, while low-frequency W access (or refresh) is identified as the worst-case scenario. Finally, a tight distribution of functional bits with NDRO in FeRAM capacitor array across 300mm wafer is demonstrated, showing that integrating low-voltage FE capacitors with proposed novel NDRO scheme has great performance potential for next-generation low-power, high-speed, dense embedded memory.},
  keywords={Low voltage;Nonvolatile memory;Ferroelectric films;Capacitors;Random access memory;Switches;Very large scale integration;Iron;Next generation networking},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075099},
}

@INPROCEEDINGS{11075182,
  author={Kim, Giuk and Lee, Sangho and Choi, Hyojun and Kim, Hoon and Shin, Seokjoong and Park, Sanghyun and Seo, Kwangyou and Kim, Kwangsoo and Kim, Wanki and Ha, Daewon and Ahn, Jinho and Jeon, Sanghun},
  title={Exploring FeFET Degradation Mechanisms: Mid-Interlayer as a Viable Solution for Stable Retention, Disturb Immunity, and Low Vth Variation},
  abstract={This study experimentally investigates the unexplored dynamics of retention loss, disturbance, and $\mathrm{V}_{\text{th}}$ instability in MIFIS FeFETs, featuring a metal-gate interlayer (G.IL)-ferroelectric (FE)-channel interlayer (Ch.IL)-Si stack. To prevent undesired decoupling of polarization $(P)$ and trapped charges during performance degradation, a mid-interlayer (mid-IL) within the FE layer is proposed. The optimized mid-IL (i) stabilizes the FE phase in the $\overline{\mathrm{H}}\text{fZrO}_{\mathrm{x}}$ (HZO) film, (ii) acts as an energy barrier in the gate stack to suppress trapped charge loss toward the channel, and (iii) mitigates channel percolation issues caused by the polymorphic and polycrystalline nature of FE films. These improvements enable an advanced gate stack design with reduced operation voltage $(V_{\text{PGM}}/V_{\text{ERS}}:17/$ - 14 V), a wide memory window (MW: 10.5 V), stable TLC retention (F $\Delta \text{MW}\sim-6$ % after 10 years at 85°C), disturb immunity $(\Delta V_{\text{th}}=0$ after 104 cycles at 12 V), and low $V_{\text{th}}$ variation (54% $\Delta V_{i\mathrm{h}}$ reduction).},
  keywords={Degradation;Voltage;Very large scale integration;Logic gates;Iron;FeFETs;Energy barrier},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075182},
}

@INPROCEEDINGS{11075003,
  author={Jana, K. and Kang, J. and Liu, S. and Athena, F.F. and Huang, C.-H. and Tang, Y. and Chen, H.J.-Y. and Saini, B. and Hartanto, J. and Bennett, R.K.A. and Persson, A.O.E. and Li, S. and Neilson, K. and Lee, Y.-M. and Leitherer, K. and Nomura, K. and McIntyre, P.C. and Pop, E. and Wong, H.-S.P.},
  title={Key to Low Supply Voltage: Transition Region of Oxide Semiconductor Transistors},
  abstract={We study the voltage transition region (TR) from sub- to above-threshold of field-effect transistors (FETs) and characterize its width ($\mathrm{V}_{\text{TR}}$) which informs how much the supply voltage ($\mathrm{V}_{\text{DD}}$) can be reduced. The TR is significant in amorphous oxide semiconductor field-effect transistors (OSFETs) because the shallow traps in amorphous OS channels lead to large $\mathrm{V}_{\text {TR }}$. We introduce a $\mathrm{V}_{\text {TR }}$ extraction scheme and identify four main sources of shallow traps (ST) in amorphous OSFETs. We design experiments to individually evaluate their impact on $\mathrm{V}_{\text {TR }}$ and successfully devise four OSFET process/design knobs to minimize V TR. Our analysis is then extended to other prominent FETs in the literature, with crystalline channel FETs showing $\mathrm{V}_{\text{TR}}<80 \text{mV}$, in contrast to amorphous OSFETs with $\mathrm{V}_{\text {TR }}$ ranging from 160 mV to as high as 1.1 V, highlighting that $\mathrm{V}_{\text{TR}}$ in amorphous OSFETs is a critical challenge that must be addressed.},
  keywords={Analytical models;Scalability;Field effect transistors;Voltage;Very large scale integration;Silicon;Mathematical models;Stability analysis;Filling;Integrated circuit modeling},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075003},
}

@INPROCEEDINGS{11075017,
  author={Tang, Baoshan and Chen, Xuanqi and Wan, Ruyue and Yu, Zhi Gen and Hooda, Sonu and Wang, Wenhui and Fang, Zihang and Wan, Quanzhen and Sivan, Maheswari and Zamburg, Evgeny and Zhang, Yong-Wei and Gong, Xiao and Thean, Aaron V.-Y},
  title={First Demonstration of Fluorine-Treated IGZO FETs with Record-Low Positive Bias Temperature Instability $\left(\left\vert \Delta V_{\text{TH}}\right\vert<44 \text{mV}\right)$ at an Elevated Temperature (395 K)},
  abstract={We present here the reliability enhancement of BEOL-compatible ITO-enhanced fluorine-treated IGZO transistors (IGZO:F FETs). The IGZO FETs exhibit a record-low $\left\vert \Delta V_{\text{TH}}\right\vert$ of 43.7 mV at an elevated temperature of 395 K under a high oxide electric field ($E_{\text{OX}}$) of 4 $\text{MV} / \text{cm}$ for 1 ks, while maintaining excellent electrical performance. For the first time, we propose an atomic-level mechanism that explains how fluorine doping modulates migration barrier and path of hydrogen $(\mathrm{H})$ that contributes to enhanced reliability in oxide FETs.},
  keywords={Temperature measurement;Field effect transistors;Semiconductor device reliability;Doping;Logic gates;Very large scale integration;Surface roughness;Plasmas;Plasma temperature;Surface treatment},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075017},
}

@INPROCEEDINGS{11075061,
  author={Li, Xufan and Gu, Chen and Yu, Tong and Zhao, Yue and Chen, Chuanke and Zhang, Chunyu and Bai, Ziheng and Duan, Xinlv and Li, Weiwei and Liao, Tianhao and Hu, Shundong and You, Nannan and Wang, Jiayi and Chen, Rui and Wu, Zhicheng and Lu, Nianduan and Wang, Jiawei and Yang, Guanhua and Wang, Lingfei and Geng, Di and Li, Ling and Liu, Ming},
  title={First Demonstration of Atomic-Interlayer-Tuning Driven by First Principles Calculations and Atomic Layer Deposition Towards High Thermal Stable BEOL IGZO-FETs with SS=62mV/dec, PBTI < 7mV@ 3MV/cm and 353K},
  abstract={In this work, first principles calculations, combining AIMD and static calculation are incorporated in the ALD co-designing of IGZO-FETs for the first time, providing in-depth study into the defect kinetics. With emulation of ALD, the optimized IGZO-FETs with outstanding stability up to 500°C is achieved: (1) Sub-0.5nm ALD InO interlayer strengthens the PBTI stability by 51 times @3.5MV/cm, from ${\Delta} V_{\text{th}}=+174.1 \text{mV}$ (5.7V−1) to 3.4mV (294.1V−1). (2) PBTI = +6.9 mV; (3) 12.1mV @ +3MV/cm and 393K; (4) Endurance > 1011 cycle with AC $V_{\mathrm{g},\text{bias}} \sim 2.8 \mathrm{V}$. The first-principles assisted experimental design is practically powerful for oxide FETs with multi-elements and complicated processing methods, and accelerating path-finding of Back-End-of-Line (BEOL) thermal stability enhancement.},
  keywords={Negative bias temperature instability;Thermal variables control;Field effect transistors;Random access memory;Metals;Very large scale integration;Stability analysis;Dielectrics;Reliability;Thermal stability;IGZO;Back-End-of-Line;2TOC DRAM},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075061},
}

@INPROCEEDINGS{11075056,
  author={Lin, Zhiyu and Kang, Lu and Zhang, Yi and Lu, Shiheng and Cui, Tianning and Zheng, Liankai and Zhao, Jinxiu and Li, Xiuyan and Zhao, Xin and Wu, Ying and Xu, Jeffrey and Si, Mengwei},
  title={First Direct Observation of Two Different Hydrogen-Related Processes Corresponding to the Negative VTH Shift Under PBTI Stress in IGZO Transistors by Pd Hydrogen Spillover},
  abstract={In this work, we propose a new method to characterize the impact of hydrogen (H) on the positive bias temperature instability (PBTI) degradation of IGZO transistors by the spillover of H through Pd electrodes. In this method, the incorporation of H into IGZO channel can be controlled by the H concentration in the test chamber and the location of Pd electrodes. As a result, for the first time, we identify two different negative threshold voltage (VTH) shift mechanisms on the same IGZO transistor, where both mechanisms are clarified to be originated from Hrelated defects. It is understood that different atomic bonding configurations of H might contribute to the different negative VTH shift components. The IGZO transistors in this work exhibit a record low PBTI ∣ΔVTH∣ of 18.4 mV at 1 ks under a stress electrical field (Eox) of 6 MV/cm and a high temperature of 150°C by an optimized process to suppress vacancy defects and H.},
  keywords={Electrodes;Temperature measurement;Degradation;Temperature dependence;Temperature;Very large scale integration;Nickel;Transistors;Bonding;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075056},
}

@INPROCEEDINGS{11075029,
  author={Nguyen, S. and Huang, H. and Jog, A. and Shoudy, M. and Lanzillo, N. and Luedders, K. and Cabrera, T. and Yao, Y. and Metzler, D. and Meagher, C. and Mignot, Y. and Nogami, T. and Silvestre, M. and Simon, A. and Wangoh, L. and Motoyama, K. and Penny, C. and Edelstein, D. and Choi, K. and Ghosh, S. and Narayanan, V. and Dutta, A. and Choi, S.},
  title={Novel Advanced Low-k Dielectric for 2 nm and Beyond Cu and Post Cu Dual Damascene BEOL Interconnect Technologies},
  abstract={A novel class of mechanically and electrically robust advanced low-k (ALK) dielectrics has been developed. These have far lower plasma-induced damage (PID), excellent builtin Cu oxidation and diffusion barrier performance, and fundamentally more reliable TDDB. One ALK recipe has been fully evaluated as the next generation low-k interlevel dielectric (ILD) for 2 nm and beyond Cu and post Cu dual damascene BEOL1. The dense ALK ($\mathrm{k}=3.2$) and lightly porous ALK ($\mathrm{k}=2.8-3.0$) films have high modulus ($\mathrm{E} \sim 15-33 \text{GPa}$), from $\sim 1 / 2$ to $\sim 1 / 10$ the PID of typical dense SiCOH ($\mathrm{k} \sim 2.7$ 3.2) or pSiCOH ($\mathrm{k} \sim 2.4-2.55$). The ALK Cu and $\mathrm{O}_{2}$ diffusion barrier properties enable further scaling of metal barriers, to increase Cu line volumes, reducing $\mathrm{R}, \text{RC}$ while actually improving TDDB and EM. This is confirmed for 2 nm node Cu dual damascene1 and future subtractive Ru/airgap scheme9.},
  keywords={Films;Metals;Integrated circuit interconnections;Materials reliability;Very large scale integration;Oxidation;Dielectrics;Integrated circuit reliability;Next generation networking;Chemicals;Novel ILD dielectrics;Cu dual damascene;BEOL;TDDB;diffusion barrier scaling;C-rich low-k dielectric},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075029},
}

@INPROCEEDINGS{11075093,
  author={Thareja, Gaurav and Mema, Albi and Qu, Ge and Giuliani, Nicola and Cornigli, Davide and Tanaka, Takahisa and Piccinini, Enrico and Wang, Xingye and Palmieri, Andrea and Barkam, Swetha and Jamieson, Monika and Xie, Bo and You, Shi and Sharma, Shashank and Wu, Yongneng and Gage, Max and Wu, Zhiyuan and Shaviv, Roey and Nardi, Federico and Haverty, Michael and Spuller, Mathew and Ng, Ben and Tam, Norman and Jansen, Alexander and Lo, Andy and Chen, Zhebo and Mungai, Francis Kanyiri and Deshpande, Sameer and Ren, He and Tang, Jianshe and Naik, Mehul and Kesapragada, Sree and Lang, Chi-I and Muthukrishnan, Shankar and Brown, Brian and Tada, Munehiro and Lee, Joung Joo and Xia, Li Qun and Berkens, Maarten and Larcher, Luca and Kashefizadeh, Keyvan and Amrouch, Hussam and Tang, Xianmin},
  title={BEOL Interconnects for 2nm Technology Node and Beyond},
  abstract={We present novel back-end-of-line (BEOL) copper interconnect integration for advanced technology nodes using low-k dielectric dep, binary liner metal gapfill process, radical assisted annealing, chemical mechanical planarization (CMP) and selective metal cap. Unit process and metrology data, electrical tests, Time Dependent Dielectric Breakdown (TDDB) reliability, Electromigration (EM) reliability and circuit simulations confirm significant power-performance-area (PPA) gains for 2nm technology node and beyond.},
  keywords={Annealing;Integrated circuit interconnections;AI accelerators;Very large scale integration;Mathematical models;Libraries;Dielectrics;Timing;Stress;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075093},
}

@INPROCEEDINGS{11074838,
  author={Van Der Veen, Marleen H. and Pattanaik, G. and Hakamata, T. and Otsuki, Y. and Negreira, A. Romo and Mayersky, J. and Yu, K. and Yonezawa, R. and Suzuki, H. and Clark, R. and Mandal, A. Kumar and Farokhnejad, A. and Jourdan, N. and Marien, P. and Murdoch, G. and Struyf, H. and Marquez, A. Sepulveda and Park, S. and Swerts, J. and Tőkei, Z.},
  title={Selective Deposition and Ruthenium Superfill Exploration Beyond A10 Node Interconnects},
  abstract={We demonstrate that selective Ru CVD can enable multilayer semi-damascene (SD) interconnects -at the critical metal levels in A10 node and below. In ring oscillator simulations, it is shown that Ru SD flows can benefit from barrierless Ru vias. The Ru CVD has excellent selectivity towards low-k 3.0 in MP21 vias. When Ru vias are combined with Cu wires, the MP24 chain resistance is lower compared to barrierless dual damascene (DD) Ru. Furthermore, we applied Ru superfill CVD in a low-k DD test vehicle at MP21-MP26. The Ru superfill does not induce line bending in $\text{SiO}_{2}$ or in MP21 low-k lines due to its bottom-up growth nature. The Ru superfill resistance scaling down to $\sim 70 \text{nm}^{2}$ is confirmed with the physical area. The selective and superfill Ru CVD are enablers of multilayer SD Ru interconnects for future nodes.},
  keywords={Resistance;Ring oscillators;Ruthenium;Wires;Integrated circuit interconnections;Metals;Very large scale integration;Bending;Nonhomogeneous media},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074838},
}

@INPROCEEDINGS{11075060,
  author={Lee, Sohyeon and Lee, Se Hoon and Choi, Howon and Woo, Byoungwook and Kim, Dong-Kyu and Lee, Jeongmin and Heo, Yun Jin and Kim, Eunhye and Park, Sejun and Hong, Seungwan and Hur, Sunghoi},
  title={Effects of Adjacent Floating Metal Interconnect Through Plasma-Induced Coupling},
  abstract={3D NAND memories have been developed by increasing cell stack height, which accompanies strong plasma energy to achieve high aspect ratio. Plasma-induced current causes high bias voltage stress during the fabrication, finally leading to gate oxide breakdown or wafer arcing [1]. Although plasma damage has been studied for a long time, the effects of the floating metal interconnects during the plasma charging processes have been less concerned. This study aims for completeness of layout design guidelines for metal interconnects by presenting various cases of electromigration (EM) failure and suggesting a new index of plasma-induced damage (PID), which can prevent unexpected changes or failures in electrical properties under plasma charging environments.},
  keywords={Couplings;Plasma properties;Three-dimensional displays;Design methodology;Integrated circuit interconnections;Metals;Very large scale integration;Logic gates;Reliability;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075060},
}

@INPROCEEDINGS{11074922,
  author={Athena, F. F. and Kang, J. and Passlack, M. and Safron, N. and Dede, D. and Jana, K. and Saini, B. and Wang, X. and Liu, S. and Hartanto, J. and Boneh, E. and Chen, H. J.-Y. and Huang, C.-H. and Lin, Q. and Zhong, D. and Leitherer, K. and McIntyre, P. C. and Pitner, G. and Radu, I. P. and Wong, H.-S. P.},
  title={Orthogonal $\mathbf{V}_{\mathbf{T}}$ Tuning for Oxide Semiconductor 2T Gain Cell Enabled by Interface Dipole Engineering},
  abstract={We demonstrate interface engineering (eng.) of the gate dielectric as an independent knob to tune the threshold voltage $(V_T)$ of Oxide Semiconductor (OS) FETs for twotransistor (2T) gain-cell memories (GC). By leveraging Interface Dipole (ID) eng. for Indium-Tungsten-Oxide (IWO) FETs, we achieve a $\sim 450-500 \text{mV} V_T$ increase compared to the standard $\text{HfO}_2$ (STD), maintaining this $\Delta V_T$ from 8°C to cryogenic temperatures. ID engineered (ID engd.) GCs exhibit good reliability, showing a ~60 mV shift under worst-case DC positive-bias stress (PBS) at 85°C. This approach is demonstrated across other OS such as Indium-Oxide, Indium-Tin-Oxide, and Indium-Gallium-Zinc-Oxide and at short channel lengths (sub-100 nm). Finally, simulations indicate that ID $V_T$ tuning reduces GC refresh energy by $\sim 50,000 \times$ compared to STD, enabling energy-efficient GC.},
  keywords={Fermi level;Field effect transistors;Cryogenics;Logic gates;Very large scale integration;Energy efficiency;Timing;Tuning;Stress;Electrons},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074922},
}

@INPROCEEDINGS{11075095,
  author={Wei, Y. and Yao, J. and Wang, Y. and Zhang, Q. and Yang, S. and Cao, L. and Li, Q. and Zhang, X. and Zhang, Y. and Yang, H. and Li, J. and Yin, H. and Wang, X. and Luo, J.},
  title={First Demonstration of 9N+9P Complete Dipole Multi-VTs CMOS Integration with Atomic Interfacial Dipole Buffer Layer Technique in GAA NSFETs},
  abstract={For the first time, we reported one complete dipole CMOS integration with atomic interfacial dipole buffer layer (AIDBL) technique for WFM-free multi- $\mathrm{V}_{\mathrm{T}}$ modulation technology. With novel dual dipole-first integration process, various dipole tuning and AIDBL linear $\mathrm{V}_{\mathrm{T}}$ modulation capabilities, the experimental CMOS integration on GAA NSFETs were successfully established and the devices achieved symmetric 9N+9P level multi- $\mathrm{V}_{\mathrm{T}}\mathrm{s}$ within ~800 mV, which providing one promising method to effectively reduce challenging $\mathrm{T}_{\text{sus}}$ space for WFM filling and then enhance the transistor driving performance for future transistor technology.},
  keywords={Buffer layers;Atomic layer deposition;Thermal variables control;Gallium arsenide;Field effect transistors;Modulation;Very large scale integration;CMOS technology;Filling;Tuning},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075095},
}

@INPROCEEDINGS{11075025,
  author={Arimura, H. and Lukose, L. and Ganguly, J. and Franco, J. and Mertens, H. and Stiers, J. and Lai, J. G. and Mehta, A. and Bejide, M. and Kim, M. S. and Horiguchi, N.},
  title={Shifter Materials and Stack Explorations for $V_{t}$ Fine-Tunable Dual Dipole Multi-$V_{t}$ Gate Stacks Compatible with Low Thermal Budget CFET},
  abstract={We report ALD processes, shifter stack and materials for dual dipole multi-$\mathrm{V}_{\mathrm{t}}$ gate stacks having a $\mathrm{V}_{\mathrm{t}}$ fine tunability and compatibility with a low thermal budget RMG. EOT penalty of dipole-first stack is mitigated by the choice of ALD oxidant, q-time control and the use of a less hygroscopic shifter material. Based on the observed impact of silicate formation on La dipole magnitude and reported dipole models, fine tunable $\mathrm{n} / \mathrm{p}$-type dipole gate stacks are demonstrated via (a) buffer $\text{HfO}_{\mathrm{x}}$ and (b) $\text{HfO}_{2}$ and $\text{ZrO}_{2}$ high- $k$ shifters.},
  keywords={Density measurement;Modulation;MOS capacitors;Process control;Hafnium;Logic gates;Very large scale integration;Standards;Thickness measurement;Ellipsometry},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075025},
}

@INPROCEEDINGS{11075072,
  author={Park, Jongyoun and Jeong, Heejae and Park, Euyjin and Park, Geuntae and Ahn, Chung-hyun and Lee, Sangsu and Won, Jiwoo and Kwon, Hyuk-Jun and Yu, Hyun-Yong},
  title={High-Performance Monolithic 3D CMOS Enabled by Orientation-Aligned Seedless Laser Crystallization and Ultra-Shallow Laser Activation},
  abstract={In this study, we demonstrate PSLC Si-based CMOS devices on the M3D top layer using a seedless crystallization process. Laser crystallization forms single-orientation Si channels ($25\ \mu \mathrm{m}$ grain size), enhancing carrier mobility. Laser S/D activation achieves low contact resistivity $(\sim 10^{-8} \Omega\cdot \text{cm}^{2})$ below 400 °C, meeting M3D constraints. PSLC-Si CMOS devices exhibit $\mathrm{I}_{\text{ON}}/\mathrm{I}_{\text{OFF}} > 10^{8}$ with high $\mu_{\text{FE},\mathrm{e}}(521 \text{cm}^{2}/\mathrm{V}\cdot \mathrm{s})$ and $\mu_{\text{FE},\mathrm{h}}(163\ \text{cm}^{2}/\mathrm{V}\cdot \mathrm{s})$. CMOS inverters show clear switching transitions, confirming feasibility for M3D logic applications. These results validate the potential of a fully laser-based process for M3D-integrated logic devices. Keyword: Monolithic 3D (M3D), Patterned Seedless Laser-Crystallization (PSLC), Si, Laser activation, Mobility},
  keywords={Fabrication;Three-dimensional displays;Fast Fourier transforms;Crystallization;Voltage;Conductivity;Benchmark testing;Silicon;Inverters;Laser transitions},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075072},
}

@INPROCEEDINGS{11075009,
  author={Rassoul, N. and Labbate, L. A. and Eneman, G. and Fantini, A. and Ritzenthaler, R. and Prado, J. Loyo and Loo, R. and Devulder, W. and Dupuy, E. and Peissker, T. and Pacco, A. and Raut, H. K. and Eyben, P. and Canga, E. and Rosseel, E. and Sharma, A. and Oh, H. and Rawal, Y. and Beggiato, M. and Kim, J. and Jiang, Y. and Milenin, A. P. and Subhechha, S. and Mitard, J. and Crotti, D. and Lee, I. and Belmonte, A. and Kar, G. S.},
  title={Process Insights into 3D-DRAM with Vertical Bit Line and Scalable GAA Transistor},
  abstract={A novel 3D-DRAM integration flow with vertical bit line and gate-all-around (GAA) transistor is successfully demonstrated. The process modules are thoroughly described along with the challenges and optimization. The morphological integrity and electrical functionality of GAA select transistors with monocrystalline Si channel are demonstrated. TCAD modeling predicts scaling possibilities with this architecture, corroborating its suitability for future DRAM implementation.},
  keywords={Solid modeling;Three-dimensional displays;Gallium arsenide;Capacitors;Random access memory;Logic gates;Very large scale integration;Silicon;Semiconductor process modeling;Transistors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075009},
}

@INPROCEEDINGS{11074867,
  author={Ha, D. and Lee, Y. and Moon, K.J. and Lee, S. and Yoo, K. and Lee, W. and Yoo, S. and Cho, M.H. and Kim, S.N. and Terai, M. and Kim, M. and Bae, J.H. and Park, S. and Lee, S.M. and Hong, M. and Sim, K. and Im, C. and Hong, S. and Sung, C. and Kim, H. and Kim, K. and Cho, H. and Byeon, S. and Shin, I. and Chae, J. and Tak, Y.S and Yoon, H. and Kim, S. and Jeong, S. and Park, K. and Lee, S.H. and Park, S.W. and Yun, P.S. and Hyun, S. and Ahn, S. J. and Song, J.H.},
  title={High Performance and Reliable 4F2 IGZO Vertical Channel Transistor (VCT) with Extremely Low Contact Resistance and 10 year BTI lifetime for sub-10nm DRAM},
  abstract={For the first time, we present experimental demonstration of a high-performance and highly reliable IGZO vertical channel transistor (VCT). It exhibits excellent leakage current $(< 0.1 \text{aA}/\mu \mathrm{m})$ and switching characteristics $(98\ \text{mV}/\text{dec})$ with VT of -0.13V at $85^{\circ}\mathrm{C}$. Furthermore, it provides a symmetric ION of 49.5 $\mu \mathrm{A}/\mu \mathrm{m}$ at VDD = 1.5 V which is sufficient for DRAM $\text{read}/\text{write}$ operations of data “0” & “1”, primarily due to the enhanced mobility and extremely low storage contact (BC) resistivity $(\rho_{\mathrm{c}},\ 3.4\times 10^{-7}\Omega\cdot \text{cm}^{2})$. To best of our know ledge, this represents the best $\rho_{\mathrm{c}}$ reported for an IGZO transistor with physical dimension below 10 nm. In addition, comprehensive analysis of temperature dependence reveals differences in ION, compared to conventional BCAT. In addition, its wafer level reliability (WLR) assessment indicates that stable DRAM operation c an be guaranteed longer than 10 years, inc luding static NBTI, dynamic PBTI and TDDB. This is due to proper $Y$ controlled hydrogen $(H)$ & oxygen vacanc $\mathrm{y}(\mathrm{V}_{0})\mathrm{c}$ oncentration inside IGZO channel, interfaces, and interlayer dielectrics. Measured negligible floating body effects (FBE) and self-heating effect (SHE) suggests $4\mathrm{F}^{2}$ IGZO VCT can be an excellent candidate to sustain DRAM scaling trajectory.},
  keywords={Negative bias temperature instability;Temperature dependence;Thermal variables control;Random access memory;Switches;Very large scale integration;Ions;Trajectory;Transistors;Integrated circuit reliability;IGZO;VCT;Contact;NBTI;PBTI;FBE;SHE},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074867},
}

@INPROCEEDINGS{11074913,
  author={Kamiyama, Akinori and Kabuyanagi, Shoichi and Toda, Masaya and Okada, Tomoharu and Hasegawa, Satoshi and Hamai, Takamasa and Watanabe, Ibuki and Sato, Shino and Matsuo, Kazuhiro and Kasahara, Yusuke and Ariyoshi, Keiko and Haga, Ken-ichi and Ikeda, Keiji and Kajita, Akihiro and Tsukamoto, Takayuki and Fujii, Shosuke},
  title={First Thorough Assessment of Time-Dependent Dielectric Breakdown in Sub-25 nm Gate-All-Around Vertical Ingazno Transistor for 4F2 DRAM Application},
  abstract={Degradation mechanisms of scaled InGaZnO vertical channel transistors (VCTs) below $25-\text{nm}$ diameter were intensively investigated for the first time. We quantified the effects of hole curvature, hole roughness and process damage on the breakdown property, and identified main cause for reliability degradation. By process optimization dedicated to the vertical gate-all-around (GAA) structure, we achieved the time-dependent dielectric breakdown (TDDB) lifetime of $>10$ years, comparable to an intrinsic stochastic dielectric breakdown lifetime, making it promising for future reliable $4 ~\mathrm{F}^{2}$ DRAM application.},
  keywords={Degradation;Gallium arsenide;Random access memory;Stochastic processes;Logic gates;Very large scale integration;Dielectric breakdown;Transistors;Electric fields;Integrated circuit reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074913},
}

@INPROCEEDINGS{11075145,
  author={Chen, Wei-Chen and Lue, Hang-Ting and Lin, Yu-Tang and Wang, Keh-Chung and Lu, Chih-Yuan},
  title={A Recall-free 3D Stackable nvDRAM Built Upon Gate-Controlled Thyristor},
  abstract={We introduce a novel and compact gate-controlled thyristor (GCT) based 3D stackable non-volatile DRAM (nvDRAM) that features recall-free operation. Unlike typical nvDRAM, which relies on separate SONOS cells for NVM operation, our design incorporates an ONO charge trapping layer within the gate dielectric of the central main gate in a three-word line (3-WL) GCT architecture. This innovation enables the “store” in nvDRAM to be carried out through self-boosting. Thanks to the unique properties of GCT, which integrates NVM and DRAM components within the same device, the “store” effectively serves as the “recall”, eliminating the need for an additional “recall”. This results in faster boot times and reduced power consumption during startup. This novel nvDRAM holds significant potential to achieve rapid data backup and boot-up, positioning it as a promising alternative to persistent memory.},
  keywords={SONOS devices;Thyristors;Technological innovation;Three-dimensional displays;Power demand;Nonvolatile memory;Stacking;Random access memory;Logic gates;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075145},
}

@INPROCEEDINGS{11075066,
  author={Park, Joodong and Cha, Junhwe and Cho, Jin Sun and Chu, Seung Wan and Hyun, Chansun and Kim, Daeik and Kim, Ildo and Kim, Jiwoo and Kwon, Sein and Lee, Junghak and Lee, Seung Cheol and Myung, Ju Hyun and Song, Jino and Sung, Minchul and Kang, Jiho and Chung, Suock and Kim, Kyunghoon and Kim, Seungbum and Kim, Seon Soon and Kim, Seiyon and Lee, Sunghoon and Cho, Youngmann and Cha, Seonyong},
  title={4F2 DRAM Integration with Vertical Gate (VG) Cell Transistor and Peri-Under-Cell (PUC) Architecture},
  abstract={Process integration of 4F2 DRAM array with peri-under-cell (PUC) architecture has been successfully demonstrated for the first time, employing vertical gate (VG) cell transistor and wafer bonding process. Fusion wafer bonding and inter-wafer contact techniques enabled wafer-to-wafer integration to provide robust electrical connections between cell and peripheral circuit wafers. Compared to conventional 2D DRAM, superior control over threshold voltage is achieved from back gate bias in VG cell transistor. Precise junction engineering by thermal annealing optimizes cell transistor performance.},
  keywords={Wafer bonding;Microprocessors;Contacts;Random access memory;Computer architecture;Logic gates;Very large scale integration;Transistors;Junctions;Bonding;4F2 DRAM;vertical gate cell transistor;fusion bonding;peri-under-cell},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075066},
}

@INPROCEEDINGS{11074799,
  author={Ren, Haoxiang and Guo, Ziyi and Yang, Ben and Sahoo, Krutikesh and Sundaram, Naarendharan Meenakshi and Chen, Zoe and Singh, Shrikant and Fisher, Timothy S. and Yang, Chih-Kong Ken and Razavi, Behzad and Vaisband, Boris and Iyer, Subramanian S.},
  title={Power Delivery for Scaled-Out Chiplet-Based Wafer-Scale Systems with $8{\mu}\mathrm{m}$ Cu-Cu Bond Pitch on Active SI-Interconnect Fabric Substrate},
  abstract={Wafer-Scale chiplet-based systems allow for condensing an entire data center rack into a single advanced substrate. However, power delivery and thermal management remain challenging. We demonstrate a heterogeneously integrated voltage converter partitioned into two parts – a local utility chiplet and an active Silicon-Interconnect Fabric (Si-IF) substrate for large chiplet-based systems with a power density of 562 W/cm3, and a two-phase cooling thermal solution. These advances can be applied to a variety of power and thermal architectures for wafer-scale systems, paving the way for the development of high-performance computing (HPC) and large language model (LLM) applications that overcome the limitations of interposer and 3D packaging technologies.},
  keywords={Power system measurements;Three-dimensional displays;Density measurement;Chiplets;Voltage;Very large scale integration;Thermal management;Solids;Fabrics;Substrates;power delivery;wafer-scale systems;chiplet;integrated voltage converter;heterogeneous integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074799},
}

@INPROCEEDINGS{11074786,
  author={Lu, Yinan and Pressl, Benedikt and Zheng, Ke and Jiang, Liu and Wang, Ying W and Kostner, Hannes and Scanlan, Chris and Hung, Raymond and Bazizi, El Mehdi},
  title={Investigation of Post-Bonding Die Stretching in Die-to-Wafer Hybrid Bonding},
  abstract={Low-temperature, high-accuracy die-to-wafer (D2W) hybrid bonding is increasingly employed to enable high bandwidth, high performance, and low power consumption packaged devices [1]. It is crucial to minimize overlay errors to achieve high electrical yield and package performance. A physics-based model is developed to replicate the dynamics of bonding propagation and post-bond die stretching. The simulation results are compared to experiment. The initial die warpage, bonding energy and pedestal design are optimized to achieve target die stretching specifications.},
  keywords={Semiconductor device modeling;Wafer bonding;Performance evaluation;Strips;Shape;Atmospheric modeling;Very large scale integration;Aerodynamics;Bonding;Substrates},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074786},
}

@INPROCEEDINGS{11074821,
  author={Lu, C.-L. and Chang, Hankel C.-H. and Lin, Y.-C. and Ni, P.-R. and Chuang, C.-H. and Henck, H. and Chuang, C.-Y. and Lin, S.-C. and Huang, H.-S. and Chiu, L.-H. and Sun, Y.-C. and Shih, K.-Y. and Radu, I. and Nguyen, Bich-Yen and Chang, S.-Z.},
  title={Novel Ultra-Thin Transistor Layer Transfer (TLT) Technology for Demonstrating Wafer-Level nm-Scale 3-Layer Stacking to Enable Multi-Tier Transistors and Backside PDN of a 3D Vertical FET Architecture},
  abstract={A new wafer-level transistor layer transfer (TLT) technology based on Smart Cut ${}^{\text{TM}}$ and IR laser release processing is reported to target on nm-scale ultra-thin multi-tier stacking. This innovation demonstrated 3-layer stacking with minimum Si thickness less than 300 nm and layer-to-layer isolation dielectric thinner than 40 nm under low thermal budget ($<350^{\circ} \mathrm{C}$) for the $1^{\text{st}}$ time. This TLT stack shows good wafer warpage ($<60 \mu \mathrm{m}$) and small total thickness variation ($<2 \text{nm}$) across wafer. Moreover, it was further hybrid bonded with a Si wafer (4-layer wafer stack in total) to reveal the possibility of functional SoC integration. An integration flow with the TLT technology as backbone is proposed to enable a 3D vertical FET structure composited multi-tier transistor-stacking, backside PDN integration, and cascaded contact plug formation.},
  keywords={Technological innovation;Three-dimensional displays;Stacking;Field effect transistors;Very large scale integration;Nonhomogeneous media;Silicon;Dielectrics;Laser beam cutting;Plugs;Transistor layer transfer technology;wafer-level;nm-scale;multi-tier transistors;backside power delivery network;3D vertical FET architecture},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074821},
}

@INPROCEEDINGS{11075225,
  author={Zheng, Gerui and Li, Hanjie and Huang, Liyan and Xie, Jiawei and Zheng, Zijie and Xie, Hanlin and Wang, Yuxuan and Chen, Xuanqi and Gu, Wenhua and Ng, Geok Ing and Gong, Xiao},
  title={First Demonstration of 3D Monolithic-Integrated BEOL OSFETs on GaN HEMTs: CEO-GaN},
  abstract={For the first time, we propose and demonstrate an innovative 3D monolithic Cascode Enhancement-mode (E-mode) Oxide semiconductor-integrated GaN (CEO-GaN) technology, featuring BEOL-compatible top-gate indium-tin-oxide (TG-ITO) FETs on GaN HEMTs and MISHEMTs on Si. Our device exhibits outstanding electrical performance, achieving E-mode operation, a high drain current $\left(I_{\mathrm{D}}\right)$ of $1090 \text{mA} / \text{mm}$, a high breakdown voltage (BV) of 603 V, and stable performance up to 350 K.},
  keywords={Performance evaluation;Semiconductor device measurement;Temperature distribution;Three-dimensional displays;Indium tin oxide;Monolithic integrated circuits;HEMTs;Very large scale integration;Logic gates;MODFETs;GaN;HEMT;E-mode;ITO;monolithic integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075225},
}

@INPROCEEDINGS{11075021,
  author={Verschueren, Lynn and Eneman, Geert and Yang, Sheng and Bömmels, Jürgen and Matagne, Philippe and Cahueñas, Katty Beltrán and Sharma, Arvind and Abdi, Dawit and Mertens, Hans and Mirabelli, Gioele and Hellings, Geert},
  title={Extending the Gate-All-Around (GAA) Era to the A10 Node: Outer Wall Forksheet Enabling Full Channel Strain and Superior Gate Control},
  abstract={Outer wall forksheet device architecture enables further scaling of gate-all-around (GAA) technologies, while maintaining full channel control through Omega-gate, and full $\mathrm{s} / \mathrm{d}$ stress efficacy. The presented wall-last approach allows for a continuous crystal template during epi growth, enabling full channel stress. Furthermore, the wider wall reduces process complexity and enables omega gate through wall etch back, effectively creating a GAA channel, increasing electrostatic control, and boosting on-current by 27 % compared to tri-gate forksheet architecture.},
  keywords={Fabrication;Three-dimensional displays;Gallium arsenide;Random access memory;Process control;Logic gates;Very large scale integration;Back;Complexity theory;Stress;DTCO;forksheet;nanosheet;GAA},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075021},
}

@INPROCEEDINGS{11075033,
  author={Abdi, D. and Hellings, G. and Boemmels, J. and G-Redondo, F. and Verschueren, L. and Sharma, A. and Kükner, H. and G-Bardon, M. and Ryckaert, J.},
  title={SRAM Scaling Opportunities Below .01 \mu ~\mathrm{m}^{2}$ Using Double-Row CFET Architecture with Wordline-Folded Bitcell Design for Performance Optimization},
  abstract={This work presents a DTCO exploration that enables SRAM scaling below $0.01 \mu ~\mathrm{m}^{2}$ in CFET nodes, achieving over 50% scaling compared to the A14 nanosheet node. It focuses on simplifying SRAM bitcell internal routing in CFET architecture, identifying process integration modules required for a compact CFET bitcell, and proposing design approaches to optimize performance. The DTCO study demonstrates that designing two bitcells together in a wordline-folded configuration, compared to bitcells without WL-folding, improves performance by $2 \times$, enhances write margin by 162 mV, and enables a standard cell-like layout.},
  keywords={Layout;Random access memory;Very large scale integration;Routing;FinFETs;Delays;Logic;Standards;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075033},
}

@INPROCEEDINGS{11074822,
  author={Peng, Wanyue and Lu, Haoran and Jiang, Jingru and Guo, Rui and Sun, Jiacheng and Jin, Jianxiang and Cheng, Yuji and Zhou, Shengcheng and Xu, Ziqiao and Lan, Chuan and Chu, Yanbang and Jiang, Xun and Teng, Feiyu and Li, Ming and Lin, Yibo and Wang, Xinwei and Wang, Runsheng and Wu, Heng and Huang, Ru},
  title={PPA Scaling of Flip FET Technology Down to A2 Node Enabled by Architecture Innovations: Self-Aligned Gate, 2T Design with Embedded Power Rail and Ultra-Stacked 4-Tier Transistors},
  abstract={In this work, we carried out a critical examination of Flip FET (FFET) technology from process innovation to circuit design for nodes from A14 to A2. The Fully-aligned FFET (F3ET) featuring self-aligned (SA) FS and BS gates was experimentally demonstrated, with common gate (CG) & split gate (SG) on fins and multi-stack Nanosheets. The Forksheet-based F3ET (F4ET) with embedded Power Rail (ePR) was proposed to reduce the cell height (CH) to 2T. With ultra-stacked 4-tier transistors, the Complementary FET (CFET) based FFET (CFFET) shows further area scaling potential. Comprehensive Power-Performance-Area (PPA) evaluation was conducted on both circuit- and block-level. DTCO knobs were also carefully studied on the A7 F3ET ${}_{\text{NS}}$ and A5 F4ET and improved the RO frequency (HP) by 11.3 % and 6.2 % at iso-leakage respectively. A3 HP F4ET outperforms A14 HP Fin-based FFET (FFET ${}_{\text{Fin}}$) by 38.9% at iso-power @ $\mathrm{V}_{\text{dd}}=0.7 \mathrm{V}. \mathrm{P}$ R results on 32-bit RISC-V cores shows 44.9% (HP) / 49.8% (HD) area scaling and 20.0 % (HP) / 27.9% (HD) frequency improvement from A14 to A5. SRAM scaling down to A2 was also studied in a $256 \times 256$ array.},
  keywords={Rails;Technological innovation;Scalability;Microprocessors;Field effect transistors;Random access memory;Computer architecture;Logic gates;Very large scale integration;Logic},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074822},
}

@INPROCEEDINGS{11075018,
  author={Liu, Y. and Chu, Y. and Wang, Y. and Xu, Z. and Zhang, J. and Sun, F. and Lu, H. and Wang, Z. and Li, L. and Zhang, L. and Wu, J. and Wu, Y. and Liu, S. and He, X. and Liu, T. and Xu, M. and Ren, P. and Ji, Z. and Wu, X. and Zhang, L. and Bu, W. and Kang, J. and Zhang, J. and Li, M. and Wang, R. and Wu, H. and Huang, R.},
  title={First Demonstration of Symmetric Dual-Sided Vertical FET (DSVFET) for Energy Efficient Computing (EEC): From Processes and Devices to Circuits},
  abstract={For the first time, we proposed and demonstrated the symmetric dual-sided vertical FET (DSVFET) experimentally. The DSVFET not only inherits low leakage, drive voltage and parasitic benefits from the standard VFET but also features unique dual-sided S/Ds with smaller footprint and better symmetry, perfectly suiting the energy efficient computing. A series of new processes and DTCO methods were developed to study the device structure, performance and circuit design. DSVFET with aggressive contact gate pitch (CGP) of 50 nm and $\text{Lg}_{\mathrm{g}}$ of 19 nm was realized. DSVFET was also validated with nearly symmetric behaviors ($\Delta \mathrm{C}_{\text{eff }} \& \Delta$ delay $<3 {\%}$) and $38 \% / 60 {\%}$ lower power than FinFET for 2 nanosheets (2NS) and 1NS design at iso-frequency based on ring oscillator (RO) simulation respectively. A RISC-V core was used for block level evaluation and 17.4% lower energy, 15% lower energy delay product (EDP) and 39.8% smaller areas were identified for the 1NS DSVFET with PowerVia (PV). DSVFET has proved to be a great candidate for future's EEC.},
  keywords={Ring oscillators;Performance evaluation;Field effect transistors;Voltage;Very large scale integration;Logic gates;FinFETs;Energy efficient computing;Delays;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075018},
}

@INPROCEEDINGS{11075207,
  author={Li, H.J. and Chang, K.P. and Chen, C.E. and Lin, Y.T. and Huang, C.C. and Wang, Y.W. and Chen, W.F. and Chen, H.Y. and Hsieh, C.R. and Ya, Z.H. and Wang, H.H. and Ting, Y.W. and Tseng, K.C. and Tsai, Z. M. and Huang, K.C. and Chuang, Harry},
  title={Compact, Low-Loss, Cost-Effective, CMOS Embedded RF Switch Solution Achieving DC-100GHz True-Time Delay Phase Shifter by Phase Change Material},
  abstract={The study presents phase change material (PCM) RF switch (RFS) in single pole double throw (SPDT), demonstrating insertion loss (IL) of $>-1.6 \text{dB}$ and isolation (ISO) of $<-34 \text{dB}$ for wideband across 10 GHz to 100 GHz. The low-loss and series-only PCM SPDT is further embedded with delay lines to demonstrate a 3-bit true-time delay (TTD) phase shifter, exhibiting superior performances in $<1.03 \text{dB}$ and $<1.28 \text{ps}$ RMS amplitude and group delay errors. This is the BEOL technology and can be the embedded CMOS solutions, offering advantages in high performances (Ron*Coff<12fs), cost-effective (Bulk Si substate) and small area (Series-only SPDT) to Silicon-on-Insulator (SOI) CMOS RF switch.},
  keywords={Phase change materials;Radio frequency;ISO;Phase shifters;Switches;CMOS technology;Delays;Millimeter wave communication;Substrates;Switching circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075207},
}

@INPROCEEDINGS{11074889,
  author={Zhou, Hong and Zhang, Kun and Hong, Peiyan and Zhou, Min and Gao, Guangjie and Xiang, Mingjie and Liu, Zhihong and Li, Xuefei and Si, Mengwei and Hao, Yue and Zhang, Jincheng},
  title={First Demonstration of Top T-Gate Beol-Compatible Indium-Oxide RF Transistors with Record Maximum Oscillation Frequency of 70 GHz},
  abstract={This work reports the first demonstration of back-end-of-line (BEOL)-compatible $\text{In}_{2} \mathrm{O}_{3}$ RF FETs on SiC substrate with a top T-gate architecture. The high thermal conductivity ($k_{\mathrm{T}}$) SiC can alleviate self-heating effect (SHE) so that a high drain bias ($\mathrm{V}_{\text{DS}}$) is applicable and the T-gate can help to reduce gate resistance ($\mathrm{R}_{\mathrm{g}}$), both increases maximum oscillation frequency $\left(\mathrm{f}_{\text {max }}\right)$. Benefiting from a high top-gate field-effect mobility ($\mu_{\text{FE}}$) of $120 ~\text{cm}^{2} / \text{Vs}$, record $\mathrm{f}_{\text {max }}$ of 70 GHz and cut-off frequency ($\mathrm{f}_{\mathrm{T}}$) $\times$ gate length ($\mathrm{L}_{\mathrm{G}}$) of $5.1 \text{GHz} \cdot \mu \mathrm{m}$ are simultaneously achieved, where the $f_{\text {max }}$ is more than 4 times of prior best reported value of BEOL-compatible oxide FETs. Combining with a high top-gate $\mathrm{I}_{\mathrm{D}, \max }=2.28 ~\mathrm{A} / \text{mm}$ and $\mathrm{g}_{\mathrm{m}, \max }\ =1.1 ~\mathrm{S} / \text{mm}$, as well as a low $\text{SS}=80 \text{mV} / \text{dec}$ and $\text{DIBL}=60\ \text{mV} / \mathrm{V}$, atomic-layer-deposited (ALD) $\text{In}_{2} \mathrm{O}_{3}$ transistors show their great promise for BEOL-compatible RF applications.},
  keywords={Radio frequency;Silicon carbide;Thermal resistance;Field effect transistors;Logic gates;Very large scale integration;Thermal conductivity;Substrates;Oscillators;Electrons},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074889},
}

@INPROCEEDINGS{11075154,
  author={Ferraris, Alberto and Cha, Eunjung and Olziersky, Antonis and Sousa, Marilyne and Han, Hung-Chi and Charbon, Edoardo and Moselund, Kirsten and Zota, Cezar},
  title={Scaled-Footprint Ultra-Low Power Cryogenic InGaAs/InP HEMTs with Record-High Combination of Low-Noise and High-Frequency Performance},
  abstract={In this work we demonstrate cryogenic $\text{In}_{\mathrm{x}}\text{Ga}_{1-\mathrm{x}}\text{As}/\text{InP}$ HEMTs with highly scaled gate footprints, down to $380 \times 40\ \text{nm}^{2}$ for a single gate finger, and investigate the impact of footprint scaling on device performance. The 80% In channel devices show $f_{\mathrm{T}}=622$ GHz and $f_{\text{MAX}}=733$ GHz together with a noise indication factor $\sqrt{I_{\mathrm{D}}}/g_{\mathrm{m}}=0.17 \sqrt{\mathrm{V}\cdot\text{mm}/\mathrm{S}}$ at 4 K, which is a record-high combination of high-frequency and low-noise performance. The performance is enabled by heterostructure engineering, resulting in ultra-low $R_{\text{ON}}=250\ \Omega\cdot\mu \mathrm{m}$ together with a minimum subthreshold swing SS < 10 mV/decade. These results show that cryogenic III-V HEMT technology can provide excellent performance at scaled footprints for readout in future high-density quantum systems.},
  keywords={Performance evaluation;Temperature;Fingers;Noise;Cryogenics;HEMTs;Logic gates;Transistors;MODFETs;Transconductance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075154},
}

@INPROCEEDINGS{11074877,
  author={Son, S.-W. and Yu, M.-S. and Son, S.-P. and Lee, I.-G. and Park, W.-S. and Yoo, J.-H. and Kim, SK. and Yun, J. and Kim, T. and Grahn, J. and Pourkabirian, A. and Sobis, P. and Kwon, H.-M. and Kim, T.-W. and Lee, J.-H. and Yang, K. and Kim, D.-H.},
  title={Cryogenic $\text{In}_{0.8} \text{Ga}_{0.2} \text{As}$ Quantum-Well High-Electron Mobility Transistors from Lowpower Quantum Computing to Tera-Hz Applications},
  abstract={We present cryogenic $\text{In}_{0.8} \text{Ga}_{0.2} \text{As}$ QW HEMTs with a gate length $\left(L_{g}\right)$ of 35 nm, achieving a record combination of low-power and high-frequency performance. A meticulous modeling of source resistance $\left(R_{s}\right)$ incorporating ballistic channel resistance ($\left.R_{\text {ball }}\right)$ - provides key insights for advancing low-power quantum computing and terahertz (THz) applications. At 4 K, the fabricated device exhibits exceptional performance metrics, including a minimum subthreshold-swing $\left(S_{\min }\right)$ of $4.41 \text{mV} / \text{dec}$., a $g_{m_{-} \max }$ of $2.49 \text{mS} / \mu \mathrm{m}$, and the highest record $f_{T}$ of 813 GHz, with an average gain-bandwidth product ($f_{\text {avg }}$) of 810 GHz. These results stem from a tightly controlled gate-recess process, minimizing the side length ($L_{\text {side }}$) to below 20 nm. Delay-time analysis indicates further THz performance can be achieved by scaled $L_{g}$ below 20 nm and reducing fringing gate capacitance ($C_{\mathrm{g}\_\text{fringe }}$) by 20 %. This work demonstrates the potential of cryogenic $\text{In}_{0.8} \text{Ga}_{0.2}$ As QW HEMTs to revolutionize quantum computing and THz electronics},
  keywords={Resistance;Radio frequency;Quantum computing;Cryogenics;HEMTs;Logic gates;Very large scale integration;Frequency measurement;Reliability;MODFETs},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074877},
}

@INPROCEEDINGS{11075062,
  author={Jeong, Jaeyong and Lim, Jeong-Taek and Suh, Yoon-Je and Rheem, Nahyun and Lee, Chan Jik and Kim, Bong Ho and Kim, Joon Pyo and Kim, Jongmin and Lee, Jongwon and Kim, Choul-Young and Kim, Sanghyeon},
  title={Fully Heterogeneous and Monolithic 3D Integrated RF Platform with III-V HEMTs on Si CMOS for Next-Generation Wireless Communication Systems},
  abstract={In this work, we demonstrate a fully heterogeneous and monolithic 3D (HM3D) integrated RF platform, in which RF circuits are stacked on digital/analog circuits by co-integrating III-V HEMT technology and Si CMOS at the same chip. For a not only high-performance but also cost-effective and industrial-feasible approach, RF active components utilize InGaAs HEMTs, digital/analog active components are based on Si FEOL, while Si BEOL-based passive devices are shared across both. The InGaAs HEMTs are monolithically integrated on industry-standard Si CMOS, achieving record-high RF performance among M3D RF transistors. The top-tier LNA with 12.2 dB gain and 3.6 dB noise at 26.5 GHz demonstrates superior RF performance. The bottom-tier mixer and Op-Amp provide a valid analog/digital signal process without any degradation caused by the HM3D integration process.},
  keywords={Radio frequency;Performance evaluation;Wireless communication;Three-dimensional displays;HEMTs;Very large scale integration;CMOS technology;Silicon;Indium gallium arsenide;Transistors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075062},
}

@INPROCEEDINGS{11074880,
  author={Sreeramaneni, Raghu and Yang, Lingming and Chang, Raymond and Gajera, Nevil},
  title={High Bandwidth Memory for AI},
  abstract={High-Bandwidth-Memory (HBM) technology is powering the accelerated computing and GPUs behind the AI revolution. This paper discusses the important role HBM architecture, performance, power, capacity, and RAS play in AI hardware. We will compare the HBM memory architecture with more traditional compute memory such as DDR5 focusing on Micron Technology's industry-leading HBM3E. We will end with a look towards the future technology innovations that will be essential to deliver continued HBM scaling.},
  keywords={Technological innovation;Micrometers;Three-dimensional displays;Memory architecture;Random access memory;Multichip modules;Bandwidth;Very large scale integration;Artificial intelligence;Through-silicon vias;Bandwidth;Power;Memory;RAS;AI;DRAM;HBM;Heterogeneous Integration;TSV;3D;2.5D;Packaging},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074880},
}

@INPROCEEDINGS{11075223,
  author={Han, Shinhee and Oh, Joosung and Lee, Tae-Young and Park, Jaehyeon and Kazutaka, Yamane and Chung, Yongseok and Yang, Gwangseok and Lee, Kangmoon and Hwang, Sohee and Kang, Gyuseong and Shin, Hyun-Jin and Nam, Kyung-Tae and Son, Jaesung and Seo, Boyoung and Suh, Kiseok and Kim, Younghyun and Jeong, Junho and Ko, Seungpil and Yeom, Kyongsik and Park, Jinha and Park, Jeong-Heon and Lee, Kangho and Ku, Ja-Hum},
  title={Emerging Embedded Non-Volatile Memories Beyond 28nm in AI Era},
  abstract={Embedded Non-Volatile Memory (eNVM) is a crucial technology in various applications such as Micro Controller Units (MCUs), Data Center and Edge AI. Due to the scaling limitations of eFlash and the demand for high-performance and energy efficiency, emerging eNVM technologies such as MRAM, RRAM, and PCM are being developed below 28 nm. These emerging eNVMs have their own strengths and weaknesses, and they are expected to complement each other and coexist in the market. In this paper, we review the characteristics of these emerging eNVMs and market positioning. We also discuss our progress in eNVM solutions.},
  keywords={Phase change materials;Data centers;Nonvolatile memory;Reviews;Edge AI;Very large scale integration;Energy efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075223},
}

@INPROCEEDINGS{11074962,
  author={Gao, Yi and Wang, Zongwei and Bao, Lin and Zhang, Haisu and Sun, Jingwei and Xie, Ruiqing and Liang, Ling and Cai, Yimao},
  title={A Hybrid Monolithic 3D Integration of 2T0C DRAM and RRAM Chip for High-Precision In-Memory Point Cloud Acceleration with Ultra-Fine-Grained Dataflow},
  abstract={In this work, we propose the hybrid monolithic 3D (H-M3D) computing-in-memory (CIM) accelerator to address the challenges of frequent data granularity in existing point cloud acceleration on edge devices. By integrating and orchestrating high-precision 2T0C DRAM CIM and RRAM CIM for Euclidean distance (L2D) and matrix-vector multiplication (MVM) operations, we achieve efficient feature computation and refine the dataflow granularity to individual points, enabling high-speed data transmission. The proposed M3D-CIM point cloud system demonstrates $1.51 \times$ speedup and $2.56 \times$ enhancement in energy efficiency, providing a novel solution for point cloud acceleration on edge devices.},
  keywords={Point cloud compression;Three-dimensional displays;Random access memory;Prototypes;Euclidean distance;Very large scale integration;In-memory computing;Common Information Model (computing);Energy efficiency;Three-dimensional integrated circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074962},
}

@INPROCEEDINGS{11074955,
  author={Koo, Won-Tae and Lee, Sangmin and Lee, Hyung Dong and Kim, Kayoung and Lee, Jae-Gil and Lee, Min Yong and Kim, Chanbae and Lee, Junghun and Jang, Ilsik and Kim, Youngmo and Oh, Seungyeol and Lee, Woocheol and Chae, Sujin and Cho, Ho Jin and Choi, Hyejung and Kim, Soo Gil and Lee, Seho and Yi, Jaeyun and Cho, Youngman and Cha, Seon Yong},
  title={224 Tops/W-Level Analog Computation in Memory Cell Using Hybrid Ferroelectric Tunnel Junction Having Enhanced on-State Conductance},
  abstract={Here, we demonstrate hybrid ferroelectric tunnel junctions (H-FTJs) that combine ferroelectric and resistive switching for analog computation in memory. The key of H-FTJs lies in the modulation of the effective tunneling thickness by the control of oxygen vacancy-based unconnected filaments in $\text{HfZrO}_{2}$. The H-FTJs exhibited high on-state conductance $\left(1.6 \times 10^{3}\right. \mathrm{S} / \text{cm}^{2}$) and on/off ratios $(32,000)$ compared to recent studies on $\text{HfZrO}_{2}$-based FTJs. We also fully integrated one-transistor-one-(H-FTJ) cross-bar arrays, and confirmed their analog multiply-accumulate operations (accuracy 91.9%) with high energy efficiency (224.4 TOPS/W) for inference tasks.},
  keywords={Accuracy;Memory management;Fitting;Switches;Very large scale integration;Tunneling;Ions;Energy efficiency;Arrays;Junctions},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074955},
}

@INPROCEEDINGS{11075146,
  author={Chang, Chih-Hao and Shen, P.C. and Chang, V.S. and Lai, K.T. and Liang, C.S. and Wu, B.F. and Lin, T.C. and Ng, J.A. and Chen, C.Y. and Lin, C.J. and Lu, J.H. and Su, F.H. and Tsao, C.P. and Li, C.T. and Chen, Y.H. and Hsieh, C.H. and Tseng, Y.H. and Chen, P.N. and Lee, T.L. and Chen, R. and Chang, M.C. and Huang, K.B. and Chui, C.O. and Chen, K.S. and Chen, C.C. and Ku, Y. and Jang, S.M. and Wu, S.-Y.},
  title={Assessment on Nanosheet Transistor Variants Beyond 2nm Node},
  abstract={Nanosheet (NSH) transistor benefits from its gate-all-around nature and the freedom to reduce channel thickness without pattern collapse as in FinFET to achieve the required SCE for $\mathrm{L}_{\mathrm{g}}$ scaling. The possibility of stacking extra channel layers to increase effective channel width and the improved immunity to gate extension effect provide NSH and its variant forksheet (FSH) with a distinct advantage in aggressive cell height $(\text{CH})$ scaling. NSH is thus the next architecture adopted before complementary field-effect transistor (CFET) is ready. This paper explores the issues encountered in CH scaling and potential integration strategies to advance NSH and FSH beyond 2 nm node.},
  keywords={Microprocessors;Stacking;Computer architecture;Very large scale integration;Logic gates;FinFETs;Dielectrics;Transistors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075146},
}

@INPROCEEDINGS{11074796,
  author={Lin, Chung-Hsun and Greene, Brian and Li, Hai and Kim, Raseong and Kavalieros, Jack and Ghani, Tahir},
  title={Beyond RibbonFET: Energy Efficiency Innovations to Drive Technology and Design for the Next Decade},
  abstract={As the semiconductor industry adopts major technology advances of RibbonFET and Backside Power, innovation continues unabated to build upon these breakthroughs and drive ever more performance, energy efficiency, and area scaling well into the future. Transistor geometry, materials, and connectivity improvements dominate near-term silicon roadmaps, but incorporation of new transistor physics to enable sub-0.3V operating voltages will be needed once the classical Gate-All-Around (GAA) era reaches full maturity.},
  keywords={Geometry;Technological innovation;Gallium arsenide;Electronics industry;Very large scale integration;Logic gates;Energy efficiency;Silicon;Transistors;Physics},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074796},
}

@INPROCEEDINGS{11074874,
  author={Ha, Daewon and Park, J. and Park, J. and Han, S. and Yeon, D. and Kim, M. and Park, S. and Yun, J. and Hwang, K. and Park, J. and Yang, J. and Lee, S. and Jeong, J.W. and Yun, C. and Bae, J. and Huh, D. and Choi, H. and Baik, S. and Ji, S. and Park, H. and Seo, J. and Koo, J. and Choi, Y. and Yoon, H. and Kim, A. and Son, S. and Han, S. and Lee, S. and Kim, G. and Han, S. and Lee, S.H. and Park, S.W. and Hyun, S. and Ahn, S.J. and Song, J.H.},
  title={3D Stacked FET (3DSFET) Logic and SRAM Technology Featuring Single Diffusion Break (SDB) and Back Side Interconnect (BSI) at 48 nm CPP for Advanced Mobile and High Performance Computing (HPC) Applications},
  abstract={For the first time, we report experimental demonstration of highly scalable 3D stacked FET (3DSFET) logic with single diffusion break (SDB) and SRAM bit-cell at 48 nm CPP. Key features include nFET gate-all-around multi-bridge channel (GAA MBCFET ${ }^{\text {TM }}$) vertically stacked on pFET GAA MBCFET ${ }^{\text{TM}}$ for reducing logic standard cell height by $>50 \%$, SDB for reducing logic block area without pitch scaling by $>10 \%$, self-aligned direct backside contact (SA-DBC) and back side interconnects (BSI) for power and signal lines with relaxed metal pitch, compared to our 3 nm node. Moreover, it can provide $>55 \%$ smaller SRAM bit-cell with read static noise margin (SNMR) & write margin (WRM) of $180 \& 250 \text{mV}, 60\ \& 50 \text{mV}$ for $\mathrm{V}_{\text{DD}}=0.7$ and 0.3 V, respectively. At the same time, SRAM bit-cell leakage decreases by 15.4 % at 125° C with unique structural benefits to fully suppress leakage current such as sub-nanosheet, n-p isolation, GIDL and junctions.},
  keywords={Three-dimensional displays;Gallium arsenide;Field effect transistors;Noise;Random access memory;Integrated circuit interconnections;Logic gates;Very large scale integration;Logic;Standards;3DSFET;SDB;SA-DBC;BSI;SRAM;GAA},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074874},
}

@INPROCEEDINGS{11075052,
  author={Hung, S. and Mochizuki, S. and Pal, A. and He, X. and Zhao, C. and Bazizi, E. M. and Zhou, H. and Li, J. and Tariq, A. and Gasasira, A. and Chen, V. and Chen, H. and Londono-Calderon, A. and Peethala, B. and Anekal, P. and Loubet, N. and Colombeau, B. and Haran, B.},
  title={Compressive Diffusion Break Stressor for Gate-All-Around Nanosheet pFET Transistor Performance Improvement},
  abstract={In this work, we have developed a compressive SiN (c-SiN) diffusion break (DB) dielectric stressor for gate-all-around nanosheet (GAA-NS) transistor to improve the pFET device and reduce intrinsic nFET/pFET performance offset in this technology. A significant amount of stress in short channel (SC) Si pFET devices is induced through DB gate replacement using compressive SiN (c-SiN) with customized treatment. We report an additional stress in SC NS pFET devices post channel release of ∼700MPa induced by cSiN DB stressors, leading to a corresponding Ieff-Ioff performance benefit of 25% on pFET logic devices at scaled CPP with no degradation of the short channel effects and reliability. As expected, the improvement is greater as the devices are closer to the c-SiN DB stressor with a strong dependence on the active length.},
  keywords={Performance evaluation;Degradation;Resistance;Thermal variables control;Gallium arsenide;Modulation;Logic gates;Very large scale integration;Silicon;Transistors;Gate-All-Around;Stress;Diffusion Break},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075052},
}

@INPROCEEDINGS{11074897,
  author={Mori, Haruki and Hung, J-M. and Zhao, W-C. and Khare, K. and Crafton, B. and Ishii, H. and Lee, C-E. and Peng, X. and Sun, X. and Fujino, Y. and Tsen, C-J. and Joshi, V. and Chuang, C-K. and Hashizume, T. and Lee, C-F. and Chou, T-L. and Akarvardar, K. and Adham, S. and Wang, Y. and Fujiwara, H. and Chih, Y-D. and Chen, Y-H. and Liao, H-J. and Chang, T-Y. Jonathan},
  title={A 3nm 125 Tops/W-29 TFLOPS/W, 90 TOPS/mm2-17 TFLOPS/mm2 SRAM-Based INT8 and FP16 Digital-CIM Compiler with Multi-Weight Update/Cycle},
  abstract={This paper presents a DCIM compiler supporting INT8 and FP16 formats, offering configuration flexibility, high accuracy, and high area/power efficiency. Our 3nm test chip is fully validated and exhibits 124.6 TOPS/W at 0.5V and 90.2 TOPS/ $\text{mm}^{2}$ at 1.1 V for INT8 DCIM, and 28.6 TFLOPS/W at 0.5V and 17.4 TFLOPS $/ \text{mm}^{2}$ at 1.1V for FP16 DCIM, respectively.},
  keywords={Accuracy;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074897},
}

@INPROCEEDINGS{11074927,
  author={Fu, Haotian and Zheng, Hongzhao and Zhou, Yue and Wen, Xianshan and Chen, Yize and Ren, Hongwei and Lin, Xiaopeng and Zong, Zhirui and Wu, Lianbo and Cheng, Bojun},
  title={NeuC-CIM: A 1.3pJ/SOP Neuromorphic Charge-Domain Compute-in-Memory Macro for Spiking Neural Network},
  abstract={This work presents NeuC-CIM, an energy efficient neuromorphic compute-in-memory macro. The proposed multi-bit charge-domain synapse and the event-triggered spiking neuron enables efficient, DC-current free operation. Moreover, the capacity extension module and neuron cyclic calibration scheme are proposed to reduce the nonlinearity and mismatch-induced accuracy loss in analog synapse and neuron circuits. The effectiveness of NeuC-CIM is verified in silicon with various neuromorphic tasks, showing a state-of-the-art $1.3 \text{pJ}/\text{SOP}$ energy efficiency with comparable accuracy.},
  keywords={Accuracy;Neuromorphic engineering;Event detection;Neurons;Spiking neural networks;In-memory computing;Energy efficiency;Silicon;Calibration;Synapses;Neuromorphic Computing;Compute-In-Memory;Charge-sharing;Spiking neural networks},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074927},
}

@INPROCEEDINGS{11074939,
  author={Wang, Yiqi and He, Zhen and Wu, Zihan and Guo, Ruiqi and Yan, Longke and Han, Huiming and Wang, Yang and Wei, Shaojun and Hu, Yang and Tu, Fengbin and Yin, Shouyi},
  title={LLM-CIM: A 28nm 126.7TOPS/W Input-LUT-Based Digital CIM Macro with Reconfigurable Matrix Multiplication and Nonlinear Operation Modes for LLMs},
  abstract={This paper presents a Digital Computing-in-Memory (DCIM) macro tailored for Large Language Model (LLM) acceleration, named LLM-CIM. It has three key features: 1) A Maximum Reuse-Oriented Input-LUT (MRIL) CIM reduces compute logic area and power by 40.7 % and 37.9 %. 2) An Outlier Aggregation-based Reordering Unit (OARU) saves $1.68 \sim 1.72\mathrm{x}$ CIM computation time. 3) A Normalized-Domain Computation Converter (NDCC) improves resource utilization to $95.6 \sim 98.7 \%$. LLM-CIM achieves 126.7TOPS/W energy efficiency on LLaMA2-7B, with up to $5.36 x$ energy saving over SOTA CIMs.},
  keywords={Large language models;Energy conservation;Very large scale integration;In-memory computing;Common Information Model (computing);Energy efficiency;Resource management;Logic;Common Information Model (electricity);Matrix converters},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074939},
}

@INPROCEEDINGS{11074989,
  author={Kim, Jaeyeong and Sim, Jae-Yoon},
  title={An 8K-Spin Ising Machine IC with Reconfigurable Many-Body Spin Interactions and Limitless Multichip Extension},
  abstract={This work presents an Ising machine chip featuring 8K spins and up to 31 reconfigurable two- and three-body interactions for each spin. The proposed architecture supports building a larger system with limitless 1-dimensional extension, where multiple chips are connected in a chain by a serial interface while each chip is processing in parallel. The proposed Ising machine, implemented in 28nm CMOS, is verified in a system including four chips. Tested on 3SAT problems with 32,760 variables, the system achieves the largest problem capacity at both the chip level and the system level.},
  keywords={Architecture;Buildings;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074989},
}

@INPROCEEDINGS{11075071,
  author={Wu, Yihao and Bae, Jooyoung and Shim, Chaeyun and Kim, Bongjin},
  title={m-Zephyr: A Digital In-Memory Ising Chip with 240 Spins Featuring Enhanced Connectivity Based on a Modified 3D Zephyr Topology},
  abstract={We present a digital in-memory Ising computing chip with a modified 3D Zephyr topology implemented using a 65nm CMOS technology. This design features cross-dimensional connectivity with 24 interactions per spin for the efficient mapping of complex combinatorial optimization problems to the Ising hardware. The proposed Ising chip with enhanced spin connectivity outperforms prior works in terms of reconfigurability, allowing the Ising chip to solve more difficult problems with complicated topologies and higher dimensions, but minimizing hardware mapping overhead. $24\times 7$ -bit precision coefficients are stored in memory and used to compute spin interactions, minimizing energy consumption and computing latency while ensuring accuracy with fully digital and high precision computing. Measured results show $> 100\times$ speedup than the baseline algorithm while finding better optimal solutions with lower Mean Ising Hamiltonian values.},
  keywords={Semiconductor device measurement;Energy consumption;Three-dimensional displays;Accuracy;Memory management;Very large scale integration;CMOS technology;Hardware;Topology;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075071},
}

@INPROCEEDINGS{11074812,
  author={Tang, Minzhe and Zhang, Yi and Xu, Dongfan and Liu, Yuxuan and Li, Zheng and Chen, Yilun and Fan, Minghao and Ren, Ziyuan and Pang, Jian and Xu, Dingxin and Liu, Chenxin and Zhang, Yuncheng and Sakai, Hiroyuki and Kunihiro, Kazuaki and Shirane, Atsushi and Okada, Kenichi},
  title={A Ka-Band 8-Stream Phased-Array Receiver with Time-Hopping Blocker Rejection for 6G Applications},
  abstract={This work proposes an area-efficient Ka-band non-uniform time-hopping (TH) phased array receiver that supports up to eight streams using only eight RF elements. By reusing RF signal paths for different streams through fast stream switching, the design significantly reduces chip area. Additionally, the proposed non-uniform TH technique mitigates blocker issues caused by switching harmonics through dithering. A prototype fabricated in 65nm CMOS demonstrates $4 \times 4$ MIMO signal reception in OTA measurements for both horizontal and vertical polarization, achieving a total data rate of 38.4 Gbps with a 42.9 dB improvement in blocker tolerance.},
  keywords={6G mobile communication;Radio frequency;Semiconductor device measurement;RF signals;Prototypes;Switches;Receivers;Very large scale integration;Ka-band;Streams;non-uniform time-hopping;blocker aliasing rejection;phased-array;Ka-band;MIMO;6G},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074812},
}

@INPROCEEDINGS{11074817,
  author={Bhat, Anoop Narayan and Allebes, Erwin and Bechthum, Elbert and Xu, Zule and Van Den Heuvel, Johan and Van Zeijl, Paul and Mateman, Paul and Van Der Ven, Stan and Eskiyerli, Murat and Traferro, Stefano and Soussi, Mohieddine El and Farsaei, Amirashkan and Tiurin, Evgenii and Zhou, Meiyi and Gamage, Sahan and Sheikh, Alireza and Boer, Pepijn and Petrov, Igor and Govers, Jochem and Visser, Huib and Hijdra, Martijn and Shantharam, Sharada Prasad and Marques, Ivo and Ramachandra, Gururaja Kasanadi and Baykal, Yunus and Ding, Kaijie and Li, Ran and Boora, Aasish and Vis, Peter and Konijnenburg, Mario and Breeschoten, Arjan and Liu, Yao-Hong and Zhang, Peng},
  title={An IEEE802.15.4ab/a/z Compatible IR-UWB 2TRX with Dual-Antenna Full-Duplex 1x3 SIMO Radar Sensing and Aliasing Suppressing Semi-Synchronous TX},
  abstract={This work presents an 802.15.4ab/a/z compatible IR-UWB 2TRX highlighting a full-duplex-based radar and a semisynchronous TX. The matching and isolation techniques proposed in the electrical-balance-duplexer (EBD)-based fullduplex RF front-end (FE) enable state-of-the-art (SoTA) shortdistance radar performance at $1.7\times$ smaller form factor. An asynchronous first-order-hold (FoH) switched-capacitor power amplifier (SCPA) with a delay-locked-loop (DLL)-based calibration is proposed in the TX. This pushes the aliasing sidelobes to 5dB lower compared to the SoTA.},
  keywords={Radio frequency;IEEE 802.15 Standard;Power amplifiers;Radar;Full-duplex system;Switches;Very large scale integration;Iron;Sensors;Calibration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074817},
}

@INPROCEEDINGS{11074846,
  author={Yuasa, Keito and Date, Shu and Kato, Sena and Ide, Michihiro and Tomura, Takashi and Okada, Kenichi and Shirane, Atsushi},
  title={A Triple-Band Transceiver for Formation Flying Satellite Communication with Dual Circular Polarized Wireless Power and LO Transfer},
  abstract={In this paper, we propose a triple-band transceiver that integrates wireless power transmission (WPT) and satellite communications for low earth orbit (LEO) satellite formation flights, utilizing 24 GHz for LO signaling and dual-polarization WPT, eliminating the internal PLL and solar cells thus significantly reducing power consumption and mass. 65 nm CMOS flip chip mounted ICs in a 4×8 phased array evaluation module demonstrated 3.8mW generated power (2x improvement over single polarization) with dual polarization. In satellite communication relay operation, simultaneous 19/29 GHz communications were achieved with 16 APSK modulation and seamless 5 GHz IF conversion. These innovations solve the energy bottleneck and relay operation.},
  keywords={Wireless communication;Technological innovation;Satellites;Power demand;Low earth orbit satellites;Very large scale integration;Transceivers;Wireless power transmission;Relays;Satellite communications;Triple-band transceiver;WPT;Dual circular polarization;LEO satellite formation flight},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074846},
}

@INPROCEEDINGS{11075165,
  author={Bae, Jae-Heung and Youn, Seong-Jun and Myung, Ju-Yeon and Kim, Min-Ju and Kim, Jeonghun and Lee, Jeheon and Kang, Donghwi and Sharma, N. and Dong, S. and Choi, W. S. and Paek, Ji-Seon},
  title={A Digital Envelope Tracking RF Power Amplifier Achieving 400MHz Channel Bandwidth and 91.9% Efficiency for Upper-Mid Band Extreme Massive MIMO 6G Communications},
  abstract={This paper presents a digital envelope tracking supply modulator for upper-mid band extreme massive MIMO 6G communications. The designed series-switches DET IC consists of Buck, SCVD and level selection switches. Cell sliced switches and a power mode selector were applied to improve power back off efficiency. The designed DET IC achieved 91.9% of the peak power efficiency. The DET PA saved larger than 100mW of DC power consumption compared to 5V-fixed-voltage PA for 200MHz RF signal, and it achieved 2.81% EVM and -36.8dBc ACLR at the output power of 17dBm with NR 400MHz.},
  keywords={6G mobile communication;Radio frequency;Power demand;RF signals;Power amplifiers;Modulation;Massive MIMO;Bandwidth;Very large scale integration;Power generation},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075165},
}

@INPROCEEDINGS{11074894,
  author={Privitera, Marco and Ruiyuan, Yang and Ali, Karim and Ballo, Andrea and Grasso, Alfio Dario and Alioto, Massimo},
  title={Sub-$\mu \mathrm{W}$ Battery- and Crystal-Free Tag Featuring 802.11ba/b-Compliant Wake-Up Receiver, Backscattered Transmitter and 3D Localization},
  abstract={A sub-$\mu \mathrm{W}$ tag is introduced for battery-less operation, reusing 2-tone incident wave for 1) RF harvesting, 2) IM2 extraction of WiFi-compliant clock, 3) 802.11ba wake-up receiver, 4) WiFi 802.11b backscattered transmitter, 5) 3D localization via signal strength. Smart label demonstration for fulfillment centers shows cm-range accuracy in 180 nm.},
  keywords={Location awareness;Wireless communication;Radio frequency;Three-dimensional displays;Transmitters;Receivers;Very large scale integration;Wireless fidelity;Clocks;Backscatter;wireless;tag;battery-less;wake-up;backscattering},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074894},
}

@INPROCEEDINGS{11074934,
  author={Guo, Aofei and Peng, Wenyu and Yang, Yunzhe and Hu, Xiao and Muratore, Dante and Du, Sijun},
  title={A Fully Integrated Sc Converter Hybridizing Dickson and Continuously-Scalable-Conversion-Ratio Topologies with a Wide Bipolar Vcr Range for Energy Harvesting},
  abstract={This paper proposes a fully integrated hybrid Dickson and continuously-scalable-conversion-ratio (CSCR) converter for bipolar-input thermoelectric energy harvesting (TEH). This is the first reported fully integrated converter achieving dualpolarity operation with an extended voltage conversion ratio (VCR) range, thanks to the 4-rail CSCR topology and the reconfigurable hybrid Dickson-CSCR architecture. The TEH interface system is fabricated in a $180-\text{nm}$ BCD process, achieving above 75 % efficiency for VCR ranging from -6.48 to -2.55 and from 2.55 to 6.67 with a 1.2 V regulated output.},
  keywords={Very large scale integration;Distance measurement;Topology;Energy harvesting;Video recording},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074934},
}

@INPROCEEDINGS{11074895,
  author={Jung, Woojoong and Lee, Hyung-Min and Le, Hanh-Phuc},
  title={A Reconfigurable Multi-Level AC-DC/DC-DC Ocean Energy Harvester IC Achieving 77.7% End-to-End Power Efficiency for Triboelectric Nanogenerators},
  abstract={The proposed integrated ocean energy harvester IC combines a multi-level bias-flip (BF) topology for improved BF efficiency with a high-voltage multi-level full-bridge active rectifier, providing reconfigurability between AC-DC rectification and DC-DC conversion with a single inductor while reducing power stage losses. The proposed reconfigurable multi-level (RML) AC-DC/DC-DC energy harvester IC achieves a peak end-to-end (E2E) power efficiency of 77.7%, a wide $P_{\text {EXT }}(\sim 2 ~\text{mW})$, and an outstanding FoM of 6.63x while supporting input frequency ($f_{\text {TENG }}$) range of $1-50 ~\text{Hz}$.},
  keywords={Oceans;Nanogenerators;Rectifiers;High-voltage techniques;Very large scale integration;Topology;Triboelectricity;Inductors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074895},
}

@INPROCEEDINGS{11075023,
  author={Li, Xiaguang and Du, Sijun and Zeng, Xiaoyang and Chen, Zhiyuan},
  title={A Globally Optimized 3-D MPPT System for Dual-Band RF Energy Harvesting with Collaborative Source Reconfiguration},
  abstract={This paper presents a globally optimized RF energy harvesting system leveraging the novel concepts of 3-D maximum power point tracking (MPPT) and collaborative source reconfiguration, achieving high MPPT accuracy and wide input power range. The 3-D MPPT is realized by coordinating energy source, optimizing the rectifier output and regulating the rectifier stages. By integrating a multi-level regulating DC-DC converter with a reconfigurable rectifier, the system enables synchronized and collaborative energy harvesting from dual-band RF sources. The fabricated chip demonstrates a peak end-to-end efficiency of 71 %, a sensitivity of −24.1 dBm, and the wide high-PCE input power ranges of 15.5 dB and 20.5 dB at 433 MHz and 900 MHz, respectively.},
  keywords={Maximum power point trackers;Radio frequency;Three-dimensional displays;Sensitivity;Rectifiers;Collaboration;Dual band;Very large scale integration;Energy harvesting;Synchronization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075023},
}

@INPROCEEDINGS{11074836,
  author={Cho, Joo-Mi and Choi, Hyeon-Ji and Park, Hyo-Jin and Han, Jaeho and Yun, Kwang-Seok and Im, Jong-Pil and Hong, Sung-Wan},
  title={2,771% Triple-Source Ground-Symmetric Pile-Up Resonant Energy Harvester},
  abstract={This paper presents a triple-source ground-symmetric pile-up resonant (TGPR) harvester which extracts energy from a piezoelectric transducer (PZT), a photovoltaic (PV) cell, and a thermoelectric generator (TEG). While the circuit cannot exceed a maximum allowable voltage of the transistor ($\mathrm{V}_{\max}$), the voltage amplitude across the PZT can reach up to $2 \mathrm{V}_{\max}$ owing to the ground-symmetric structure. As a result, the TGPR harvester generates $887 \mu \mathrm{W}$ of power from the PZT, achieving a $2,771 \%$ improvement in power extraction.},
  keywords={Photovoltaic systems;Piezoelectric transducers;RLC circuits;Voltage;Very large scale integration;Generators;Transistors;Lead zirconate titanate},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074836},
}

@INPROCEEDINGS{11074969,
  author={Aoyagi, Yumito and Yabuuchi, Makoto and Tanaka, Tomotaka and Mizutani, Kazuto and Hamada, Masaya and Ishii, Yuichiro and Nii, Koji and Zhou, Mark and Liu, J.C. and Huang, Chien-Yu and Peng, Kang-Hui and Hsu, Yu-Hao and Wang, Isabel and Cheng, Hong-Chen and Liao, Hung-Jen and Chang, Tsung-Yung Jonathan},
  title={A 3nm FinFET 563kbit 35.5Mbit/mm2 Dual-Rail SRAM with 3.89pJ/Access High Energy Efficient andμW/Mbit 1-Cycle Latency Low-Leakage Mode},
  abstract={This paper presents a Single-port high-density (HD) 6T SRAM for mobile application. The macro uses eXtended Dual Rail (XDR) architecture and two proposed techniques. The Delaying-Write-WL (DeWL) technique resolves the problem of contention between the cell and the write-driver (WDRV). The 1-cycle latency low-leakage mode (1-CLM) enables to turn off all BL pre-chargers during no operation (NOP). A 3-nm FinFET test chip can achieve the reduction of 17 % in active energy and 10 % in stand-by leakage by these techniques.},
  keywords={Rails;Microprocessors;Energy resolution;Random access memory;Computer architecture;Very large scale integration;FinFETs;Energy efficiency;Mobile applications;Single-port;high-density;SRAM;3-nm FinFET;Dual Rail;Low power;Energy efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074969},
}

@INPROCEEDINGS{11074981,
  author={Joshi, Rajiv and Davis, John and Fredeman, Gregory and Yavoich, Brian and Srinivasan, Uma and Hayes, Russell and Pelella, Antonio and Chen, Zhiying and Bunce, Paul and Lee, Dongho and Cervantes, Ismael and Tverskoy, Genadi and Leu, Derek and Pille, Juergen and Huott, Bill and Kim, Steve},
  title={A 6+ Ghz 128 Kb Multi-Port L1 Cache Using Ground Rule Clean 10T Bitcells in 5Nm Technology},
  abstract={A $6+$ GHz multi-port 10T Ground Rule Clean (GRC) compact Cache is implemented in the recently announced IBM Telum II processor [1]. It features a Multi port design (2 Read and 1 Write) with fine grain banked architecture minimizing read and write collisions. The design is functional across various corner conditions without read and write assist circuits.},
  keywords={Degradation;Semiconductor device measurement;System performance;Computer architecture;Very large scale integration;SRAM cells;Stability analysis;Hardware;Frequency measurement;Circuit stability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074981},
}

@INPROCEEDINGS{11074810,
  author={Watanabe, Ryota and Kojima, Hidemitsu and Uno, Kazumasa and Otsubo, Hiromasa and Chu, Ted and Cheng, Hong-Chen and Nii, Koji and Wang, Yih and Chang, Tsung-Yung Jonathan},
  title={A 13.8% Speed-Enhanced 1T Mask ROM by Algorithmically Signed Program Data on 3-nm Fin-FET Logic CMOS},
  abstract={We have proposed an algorithmically signed mask ROM, where a sign column is attached to an original ROM bitcell array. By selecting appropriate sign bits for given data, ‘1’-bit ratio to be programed for each column can be constrained within a narrow range, which profoundly mitigates tradeoff between read access time and read margin. SPICE simulations and silicon measurement for a 1.8-Mbit signed ROM on 3-nm Fin-FET logic CMOS demonstrate improvement in read access time by 12.7% and 13.8%, respectively.},
  keywords={Semiconductor device modeling;Histograms;Codes;Voltage;Very large scale integration;SPICE;Time measurement;Logic;Arrays;Read only memory},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074810},
}

@INPROCEEDINGS{11074884,
  author={Pilo, Harold and Arora, Manish and Garg, Anurag and Jia, Jianjun and Lai, Chien-An and Lo, Zack and Chawla, Kavita and Kumar, Jinesh},
  title={A 37.8Mb/mm2 Sram in Intel 18A Technology Featuring a Resistive Supply-Line Write Scheme and Write-Assist with Parallel Boost Injection},
  abstract={A high-density, SRAM-based Register File (RF) has been demonstrated in Intel 18A Technology [1] featuring RibbonFET GAA transistors and a Back Side Power Delivery Network (BSDPN). The RF is optimized for high density and array efficiency and achieves a density of $37.8 \text{Mb} / \text{mm}^{2}$, the highest density reported to date for an RF. It is implemented with a conventional Bitline (BL), two-bank memory architecture and it can be used as the SRAM workhorse for most SoC applications with maximum bit-count of 262 Kb.},
  keywords={Radio frequency;Memory architecture;Gallium arsenide;Random access memory;Very large scale integration;Registers;Transistors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074884},
}

@INPROCEEDINGS{11075147,
  author={Zhao, Zhiyuan and Chen, Hsiang-Wen and Song, Seungheun and Kang, Taewook and Flynn, Michael},
  title={A Calibration-Free 175MHz Bandwidth 60dB SNDR 6th-Order Bandpass Cascaded Time-Interleaved Noise-Shaping SAR ADC with Optimum Zero Placement},
  abstract={A new Cascaded Time-Interleaved (CaTI) Noise-Shaping (NS) SAR ADC combines high-order cascaded NS and new TI bandwidth enhancement techniques to break the bandwidth limitation of NS SAR. The prototype provides 60dB SNDR and 77.5dB SFDR over a 175MHz bandwidth without any calibration, occupies only 0.02mm2, and consumes 3.38mW at 1.4GS/s. With an FoMs of 167dB, CaTI NS SAR is a robust and more efficient alternative to conventional TI NS SAR. The prototype has the highest bandwidth of any NS SAR.},
  keywords={Prototypes;Bandwidth;Very large scale integration;Filtering theory;Noise shaping;Calibration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075147},
}

@INPROCEEDINGS{11074991,
  author={Javvaji, Sundeep and Breems, Lucien and Bolatkale, Muhammed and Bajoria, Shagun and Rutten, Robert and Makinwa, Kofi},
  title={A 4GHz 2b 5th Order Continuous-Time $\boldsymbol{\Delta} \boldsymbol{\Sigma}$ Modulator with –100.1dBc THD and 122DBFS SFDR in 100MHz BW},
  abstract={This work presents a continuous-time $\Delta \Sigma$ modulator (CTDSM) with a novel $5^{\text {th }}$ order noise transfer function (NTF) that increases in-band SQNR by $\sim 9.5 ~\text{dB}$ compared to conventional NTFs. This allows its sampling frequency to be reduced, enabling the use of a 2b SAR quantizer, which dissipates less power than a conventional $2 b$ flash quantizer and does not require power-hungry digital offset calibration. Furthermore, its $1^{\text {st }}$ integrator is based on a single energyefficient inverter, whose limited DC gain is absorbed by the rest of the loop filter. While sampling at 4 GHz, the resulting CTDSM achieves -100.1 dBc THD, 74.5 dB SNDR over a 100 MHz BW and consumes 49.5 mW. This results in 5.6 dB higher energy-efficiency than CTDSMs with similar BW and linearity.},
  keywords={Frequency modulation;Noise;Transfer functions;Linearity;Very large scale integration;Inverters;Energy efficiency;Calibration;Gain},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074991},
}

@INPROCEEDINGS{11075106,
  author={Takenaka, Ritaro and Kano, Sota and Iizuka, Tetsuya},
  title={A 76.5-dB Dynamic-Range 8-bit 100-MS/s Variable-Range SAR ADC},
  abstract={This work presents an 8-bit 100 MS/s SAR ADC with a 35 dB variable input range. The range tunability is realized by fully passive switched-capacitor-based circuits integrated with CDAC. Programmable capacitive dividers that narrow down the full-scale range of the CDAC and capacitor stacking circuits that amplify the input signal without an active amplifier are used in combination to achieve a wide tunable input range. Fabricated in 65nm CMOS, the proposed ADC consumes up to 0.599 mW at 100 MS/s and achieves 48.7 dB SNDR and 65.6 dB SFDR with Nyquist input. SNDR remains > 40 dB over the input signal amplitude ranges from -35 to 0 dBFS, which leads to a 76.5 dB dynamic range, yielding a Schreier FoM of 185.7 dB.},
  keywords={Stacking;Capacitors;Very large scale integration;Dynamic range;Switching circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075106},
}

@INPROCEEDINGS{11075067,
  author={Lin, Zhenghan and Nikolić, Borivoje},
  title={A 4-Element Baseband Charge-Domain Beamformer Integrated into 9-bit SAR ADC Achieving 32dB Spatial Notch with 52.1mW},
  abstract={This work presents a $4\times 4$ fully passive charge-domain configurable beamformer integrated into 9-bit SAR ADCs in Intel 16 process, which operates up to 500MHz, achieving over 33dB spatial notch with 52.1mW per RX element. 1-degree resolution, energy-efficient switched-capacitor phase shifters with on-chip calibration ability are implemented using existing circuits in SAR ADC, realizing beamforming with only 15% area and 5% power overhead.},
  keywords={Baseband;Array signal processing;Phase shifters;Energy resolution;Very large scale integration;Energy efficiency;System-on-chip;Calibration;Spatial resolution;Switching circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075067},
}

@INPROCEEDINGS{11074898,
  author={Seo, Min-Woong and Choi, Yong-Suk and Lee, Sanggwon and Ito, Masamichi and Bae, Daehee and Shim, Yeongseok and Cho, Gihwan and Koo, Si-Gyoung and Byun, Sung-Jae and Kwon, Hyukbin and Kim, Suksan and Kim, KwanSik and Lee, Youna and Kim, Bumjun and Jeong, Jaehun and Sugihara, Hiroyuki and Han, Su-Hyun and Park, Sangsu and Kim, Yongjun and Shim, Heesung and Kim, Seung-Sik and Lee, Jae-kyu and Go, Jonghyun and Song, Jaihyuk},
  title={A 1.22 e-rms Temporal Random Noise, 110 dB High Dynamic Range, 2.988 \mu\mathrm{m}$ Pixel-Pitch 3-Stacked Digital Pixel Sensor with On-Chip HDR Merger},
  abstract={This paper presents the world's smallest $2.988 \mu ~\mathrm{m}$ pixel pitch, 3-megapixel (Mp) 3-stacked digital pixel sensor (DPS) with a low temporal random noise (RN) of 1.22 e-rms and a high dynamic range (HDR) of 110 dB in global-shutter operation mode for various applications. To achieve the low RN and HDR performances, a pixel-parallel analog-to-digital converter (P-ADC) architecture with a narrow noise bandwidth (BW) and split photodiode (PD) structure with the signal chopping operation for LED flicker mitigation (LFM) are utilized for the developed DPS, respectively. Especially, a 3 -stacked structure has been adopted for the small form factor of DPS and enhancing the on-chip image signal processing capability.},
  keywords={Fluctuations;Corporate acquisitions;Prevention and mitigation;Noise;Bandwidth;Very large scale integration;Light emitting diodes;System-on-chip;High dynamic range;Photodiodes},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074898},
}

@INPROCEEDINGS{11074825,
  author={Sato, M. and Akebono, S. and Yasuoka, K. and Kato, E. and Tsuruta, M. and Takano, C. and Ota, K. and Haraguchi, K. and Watanabe, M. and Fujii, G. and Yamanaka, K. and Yasuda, K. and Minami, S. and Hanzawa, K. and Matsuda, K. and Kato, A. and Ueno, Y.},
  title={A 0.8\mu\mathrm{m}$ 32Mpixel Always-On CMOS Image Sensor with Windmill-Pattern Edge Extraction and On-Chip DNN},
  abstract={This paper presents a CMOS image sensor (CIS) that integrates two operation modes: a high-resolution viewing mode with $0.8 \mu \mathrm{m}$ 32Mpixels and a low-power always-on object recognition mode consuming 2.67 mW at 10 fps. The CIS features a unique windmill-pattern analog edge extraction circuit that is resilient to illumination variations. An on-chip DNN processor was implemented alongside a compact algorithm with only 12 KB for coefficients and 48 KB for working memory. The design incorporates separate circuit areas for high-speed viewing and low-power sensing modes, thereby ensuring optimal performance and energy efficiency.},
  keywords={Hands;Image edge detection;Heuristic algorithms;Lighting;Very large scale integration;CMOS image sensors;Feature extraction;System-on-chip;Sensors;Object recognition},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074825},
}

@INPROCEEDINGS{11074974,
  author={Kim, Hyoungjun and Kim, Jonghyun and Chen, Ethan and Chen, Vanessa},
  title={A Multispectral Vision Sensor with Embedded Convolutional Neural Network Using Programmable Fractional Weights and nMOS-Only PWM Pixels},
  abstract={This paper presents a multispectral vision sensor integrating convolutional neural network (CNN) for color-based vision tasks. The sensor utilizes fractional convolution (Conv) weights with a resolution of 0.1 using weighted exposure control for precise adjustments. It features 5b fully connected (FC) weights enabled by an analog multiply-and-accumulate (MAC) unit, optimizing both area and energy efficiency. The proposed nMOS-only PWM pixel improves the fill factor by 30.6% compared to prior works. A $258 \times 129$ CMOS 180 nm sensor array consumes $137.5 \mu ~\mathrm{W}$ at 20 fps per channel with iFoM of $206.6 \text{pJ} /$ pixel $\cdot$ frame, achieving 90.9% and 89.6% accuracy on diverse detection tasks.},
  keywords={Accuracy;Fill factor (solar cell);Convolution;Energy resolution;Vision sensors;Very large scale integration;Pulse width modulation;Energy efficiency;Convolutional neural networks;Sensor arrays},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074974},
}

@INPROCEEDINGS{11074844,
  author={Keel, Min-Sun and Kim, Kyung-Min and Seo, Haneol and Park, Seok-Yong and Lee, Mira and Kim, Donghyun and Jo, Jeonga and Woo, Jonghyuk and Jang, Youngtae and Heo, Jinkyeong and Lim, Jungwook and Yoo, Dongsuk and Park, Soeun and Oh, Youngsun and Jeong, Youngkyun and Kim, Bumsuk and Lee, Kyungho and Ko, Juhyun and Lee, Haechang and Lee, Jesuk},
  title={A 12-Mpixel Automotive Image Sensor with 137-dB Single-Exposure Dynamic Range and 0.55-Electron Read Noise by Oversampling-Based Noise Reduction},
  abstract={A 12-Mpixel CMOS image sensor is presented, with a single-exposure dynamic range of 137 dB and read noise of $0.55 \mathrm{e}^{-}$ at $\text{Tj} 85^{\circ} \mathrm{C}$ for automotive applications. A sub-pixel structure is adopted with a high-density in-pixel capacitor for dynamic range expansion. Optimal oversampling and high analog gain with the proposed readout scheme are employed, to reduce read noise. ADC bit resolutions of the readout modes are reconfigured, to support noise reduction in a given readout time. The chip consumes only 676 mW at 30 -fps full readout.},
  keywords={Image resolution;Noise;Noise reduction;Capacitors;Automotive applications;Dynamic range;Very large scale integration;CMOS image sensors;Gain},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074844},
}

@INPROCEEDINGS{11074902,
  author={Liu, Han and Qi, Nan and Li, Ang and Zhu, Minye and Xiong, Yongliang and Wu, Ruoyu and Xie, Yujun and Qu, Yang and Zhong, Chenyang and Li, Guike and Li, Ming and Liu, Liyuan},
  title={A ${4} \times \text{112-Gb}/\mathrm{s}$, 3.51-pJ/Bit Monolithically Integrated Silicon-Photonic Transceiver for High-Density Co-Packaged Optics},
  abstract={A $4 \times 112-\text{Gb} / \mathrm{s}$ Si-photonic (SiPh) transceiver (O-TRX) for co-packaged optics (CPO) is presented in $45-\text{nm}$ SOI CMOS. By monolithically integrating electronic circuits and photonic devices on one chip, high bandwidth density and high power efficiency is achieved. A high-swing open-drain driver is codesigned with the traveling-wave Mach-Zehnder Modulator (MZM) to reach high speed at low power. A compact-size inverter-based trans-impedance amplifier (TIA) is cooptimized with the photodetector (PD). Multi-node inductive peaking is employed to extend bandwidth while maintaining a linear phase delay. The O-TRX loopback is demonstrated at $112-\text{Gb} / \mathrm{s} /$ lane under PAM-4 modulation. Measurement results show the OTX achieves $224-\text{Gb} / \mathrm{s} / \text{mm}$ bandwidth density with $2.36-\text{pJ} /$ bit power efficiency, while the ORX attains $299 \text{Gb} / \mathrm{s} / \text{mm}$ density with $1.15-\text{pJ} /$ bit efficiency.},
  keywords={Mach-Zehnder interferometers;Integrated optics;Power measurement;Modulation;Bandwidth;Very large scale integration;Transceivers;Photodetectors;Optical amplifiers;Photonics;monolithic;silicon-photonic;driver;TIA;optical transceiver;CPO;MZM},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074902},
}

@INPROCEEDINGS{11075053,
  author={Vandersand, James and Melek, Didem Turker and Geary, Kevin and BS, Prakash and Jain, Shashi and Bothra, Basant and Sarkar, Pyare and Sabharwal, Pawan and Navinkumar, R and Chang, Ken},
  title={A 0.52pJ/bit 0.448Tbps/mm UCIe Standard Package Die-to-Die Transceiver with Low-Latency TX Clock Alignment in 3nm FinFET},
  abstract={This work presents a UCIe SP compliant die-to-die wireline transceiver developed in a 3nm CMOS process node. Each 16-lane module operates at 16Gbps/pin yielding a 0.448Tbps/mm beachfront bandwidth while only consuming 0.52pJ/bit. A TX clock alignment scheme implements clock domain crossing to reduce the FDI-to-FDI latency to 4.0ns. With a 25mm organic substrate channel, an aggregate 0.372UI eye opening at BER of le-15 and 0.108UI at BER of le-27 is measured at 16Gbps/pin operation. A background maintenance mode improves the aggregate eye width by up to 0.156UI across +5% to −5% voltage and −40C to 125C temperature drift.},
  keywords={Temperature measurement;Aggregates;Very large scale integration;FinFETs;Transceivers;Maintenance;Low latency communication;Substrates;Standards;Clocks},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075053},
}

@INPROCEEDINGS{11074882,
  author={Zimmer, Brian and Tell, Stephen G. and Gray, C. Thomas},
  title={A 77 fJ/Bit 8 Gbps Low-Latency Self-Timed Die-to-Die Link for 2.5D and 3D Interconnect in 3nm},
  abstract={This work presents a self-timed die-to-die link that serializes 4 data bits per pin for 2.5D or 3D interconnects using a standard adaptive digital clock and voltage supply. The link achieves 8 Gbps of per-pin bandwidth with a latency of 1 cycle, energy efficiency of $77 \text{fJ} / \mathrm{b}$, and bandwidth density of $44 \text{Tbps} / \text{mm}^{2}$ at 0.7 V. The link was implemented on a testchip as side-by-side transmitter and receiver macros connected with on-chip wires in a 3 nm process.},
  keywords={Three-dimensional displays;Transmitters;Wires;Interconnected systems;Bandwidth;Voltage;Receivers;Very large scale integration;System-on-chip;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074882},
}

@INPROCEEDINGS{11075116,
  author={Javadi, Ramin and Lin, Xiaohui and Anand, Tejasvi},
  title={A 3.2pJ/b 0.068pJ/b/dB 25Gb/s NRZ Wireline Transceiver with 3-Tap FFE and Random Forest Classification for Compensating 47dB Loss in 16nm FinFET},
  abstract={An energy efficient (0.068pJ/b/dB) NRZ wireline transceiver is presented that leverages 3-tap FFE in the transmitter and feature extraction with classification in the receiver for compensating 30dB to 47dB channel loss with BER<10-11. The proposed random forest classifier learns long-reach channel characteristics enabling the transceiver to achieve 3.2pJ/b at 25Gb/s for compensating 47dB loss.},
  keywords={Transmitters;Receivers;Very large scale integration;Propagation losses;FinFETs;Feature extraction;Transceivers;Energy efficiency;Optical signal processing;Random forests;random forest;classification;wireline},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075116},
}

@INPROCEEDINGS{11075070,
  author={Chung, KuyYoun and Kim, Yubin and Shin, DongArm and Cho, SeongHwan},
  title={A 12-Gb/s Single-Ended Transmitter with Echo-Canceling FFE for Multi-Drop Bus in 28Nm CMOS},
  abstract={This paper presents a 12-Gb/s single-ended transmitter (TX) with echo-canceling feed-forward equalizer (FFE) to eliminate reflections in a multi-drop bus. The TX achieves a bit-errorrate (BER) below 10−12 and maintains its performance across various multi-drop channels with stub lengths ranging from 8 cm to 12 cm. The TX achieves an energy efficiency of 1.52 pJ/b and occupies $0.01 \text{mm}^{2}$ of active area in 28 nm CMOS.},
  keywords={Echo cancellers;Transmitters;Equalizers;Very large scale integration;CMOS technology;Reflection;Energy efficiency;Distance measurement;multi-drop bus;memory interface;reflection;TX Introduction},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075070},
}

@INPROCEEDINGS{11074782,
  author={Takenaka, Ritaro and Iizuka, Tetsuya},
  title={An 11.9-ENOB 560-MS/s Subranging ADC Employing Amplifier-Switching Architecture with Multi-Threshold Comparators},
  abstract={This paper proposes a 14-bit 560-MS/s ADC, which employs an amplifier-switching subranging architecture. The proposed architecture enables both high-speed and high-resolution without requiring accurate amplifiers. A multi-threshold comparator with time-latch stages is proposed to achieve 16-level decisions with a single input pair, which reduces its input-referred noise with low power consumption. Fabricated in 28nm CMOS, this work achieves 72.14 dB SNDR at Nyquist input and consumes 9.76 mW at 560 MS/s, which leads to 176.7 dB Schreier FoM.},
  keywords={Power demand;Accuracy;Noise;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074782},
}

@INPROCEEDINGS{11075030,
  author={Ghahramani, Mohammad Mahdi and Kaile, Srujan Kumar and Park, Gijin and Zhu, Yuanming and Yi, Il-Min and Hoyos, Sebastian and Palermo, Samuel},
  title={A 46GS/s 7-Bit Time-Interleaved Time-Domain ADC with Synthesizable Unit ADCs in 16nm FinFET},
  abstract={A 7-bit 16-way time-interleaved time-domain analog-todigital converter (TDADC) is presented with unit ADCs synthesized using Verilog code and fully-automated standard digital place-and-route techniques. The proposed design introduces capacitor-based distortion compensation in the voltage-to-time converter and employs a novel 3-input time comparator with implicit phase interpolation in the fine time-to-digital converter to reduce power and area. Fabricated in 16 nm FinFET, the proposed ADC operates at $46 \text{GS} / \mathrm{s}$, achieves $78 \text{fJ} /$ conv.-step at Nyquist, has 20.1 GHz 3 dB input bandwidth, and occupies $0.085 ~\text{mm}^{2}$ area.},
  keywords={Interpolation;Codes;Bandwidth;Very large scale integration;FinFETs;Time-domain analysis;Hardware design languages;Standards;Phase distortion},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075030},
}

@INPROCEEDINGS{11074891,
  author={Rui, Buhui and Pan, Xianghui and Lu, Yao and Zhu, Yan and Martins, R. P. and Chan, Chi-Hang},
  title={A Single-Channel 14B 3GS/s Pipelined ADC in 28nm Technology},
  abstract={This article presents a negative-delayed-input (NDI)-assisted Pipelined ADC (Pipe), which considerably shrinks the critical path by enabling concurrent quantization in all stages. The single-channel (1-CH) 14b ADC runs at 3GS/s and achieves 62.3 dB SNDR and 81.1 dB SFDR at Nyquist input after uneven-spaced (UE) PWL function INL calibration.},
  keywords={Quantization (signal);Very large scale integration;Calibration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074891},
}

@INPROCEEDINGS{11074876,
  author={Li, Haoyu and Zhang, Kaize and Qi, Liang and Sin, Sai-Weng and Martins, Rui P. and Guo, Mingqiang},
  title={A PVT-Robust $\text{16GS}/\mathrm{s} 4 \times \text{TI}$ Time-Domain ADC with Vernier-Based Multipath Flash TDC Achieving $25.7 \text{fJ} / \mathrm{c}-\mathrm{s}$ FoM in 28nm CMOS},
  abstract={A 4-way 16GS/s two-step time-domain ADC with Vernierbased multipath Flash TDC architecture is reported. Benefiting from the proposed Vernier-based Multipath $\mathrm{T}_{\text {LSB }}$ Generator (VMTG) and the inherently tracking delay cells, this design achieves PVT robustness for time step ratios and gain between the two stages. Fabricated in 28 nm CMOS, this ADC achieves 35.3 dB SNDR and 51.2 dB SFDR with a Nyquist input at $16 \text{GS} / \mathrm{s}$ and it consumes 19.6 mW power, leading to a $25.7 \text{fJ} /$ conv.-step Walden FoM.},
  keywords={Very large scale integration;CMOS technology;Robustness;Generators;Delays;Time-domain analysis;Gain},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074876},
}

@INPROCEEDINGS{11074912,
  author={Rustom, Michella and Farhadian, Alireza and Nguyen, Thanh Dat and Moghaddam, Mahta and Sideris, Constantine},
  title={Frequency-Division Multiplexed Magnetic Induction Based Wireless Wearable Sensor Network for Real-Time Motion Tracking},
  abstract={A network of wearable, wireless sensor nodes is proposed for 3D real-time motion tracking using frequency-division-multiplexed magnetic induction (MI) to extract spatial information based on measured node-to-node coupling. A custom MI transceiver chip is designed and fabricated in 180nm CMOS, which drives a wearable coil and measures tones transmitted by other nodes concurrently in full-duplex. Practical experiments are demonstrated on a 3D-printed double-joint leg model and a human subject, demonstrating fully wireless MI-based motion tracking for the first time.},
  keywords={Wireless communication;Wireless sensor networks;Semiconductor device measurement;Three-dimensional displays;Tracking;Very large scale integration;Real-time systems;Transceivers;Frequency measurement;Wearable sensors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074912},
}

@INPROCEEDINGS{11074909,
  author={Choi, Kyu-Jin and Kim, ByungJun and Sim, Jae-Yoon},
  title={A 10.42μW/Ch. PPG Sensor with a Zoomed Sampling Based on Velocity of Blood Flow},
  abstract={This work presents a 10.42μW/Ch. PPG sensor with a zoomed sampling based on blood flow velocity. The proposed sensor achieves a 53% reduction in overall power consumption while maintaining heart rate (HR) and blood oxygen saturation ($\text{SpO}_{2}$) accuracy with errors of 0.73bpm and 0.53%, respectively, showing robustness even under changes of 30bpm in HR and 6% in $\text{SpO}_{2}$.},
  keywords={Heart rate;Power demand;Accuracy;Very large scale integration;Robustness;Blood;Blood flow},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074909},
}

@INPROCEEDINGS{11074978,
  author={Alea, Mark Daniel and Rosa, Maria Atalaia and Nowicki, Yari and Dandekar, Mohit and Myny, Kris and Gielen, Georges},
  title={DERMIS: A Flexible Fully-Integrated $\mathbf{6 0 0} \bm{\mu} \mathbf{m}$-Resolution Per-Taxel Slip-to-Spikes Tactile Sensor Readout on A-IGZO TFT for Large-Area High-Density Electronic Skins},
  abstract={This work is the first demonstration of a flexible fullyintegrated tactile sensor readout ASIC with 1) per-taxel eventbased readout on a large-area unipolar amorphous indium gallium zinc oxide (a-IGZO) thin-film transistor (TFT) technology; 2) enabling the integration of differential capacitive sensors with state-of-art $600 \mu ~\mathrm{m}$ pitch for high-spatial-resolution shear and normal force sensing; 3) allowing the direct acquisition of crucial grasp-state-dependent parameters (e.g., slip); while 4) achieving state-of-the-art performance compared to both prior TFT-based readouts ($F O M_{w}=4 n J / c-s; 0.6 f_{\text {RMS }}$ resolution) and tactile sensors.},
  keywords={Tactile sensors;Systems architecture;Very large scale integration;Dermis;Thin film transistors;Sensors;System-on-chip;Spatial resolution;Power harmonic filters;Next generation networking},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074978},
}

@INPROCEEDINGS{11074980,
  author={Wen, Ziyuan and Cong, Rongqing and Zhu, Hanlin and Zhang, Jiaao and Xie, Chong and Yang, Kaiyuan},
  title={A 28Nm Online Spike Sorting Processor Based on Multi-Channel Template Matching},
  abstract={This paper presents a multi-channel template matchingbased online spike sorting (OSS) processor to sort low SNR units while maintaining low area, high efficiency, and constant latency for brain-computer interface (BCI), through softwarehardware co-design that exploits principles in neuroscience. It achieves 61.5% sorting accuracy with a min. unit SNR of 4 and stable sorting and visual decoding performance over 15 days in our visual response processing (VRP) experiment on a mouse.},
  keywords={Visualization;Neuroscience;Accuracy;Very large scale integration;Brain-computer interfaces;Decoding;Sorting;Signal to noise ratio},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074980},
}

@INPROCEEDINGS{11075064,
  author={Chen, Yong-Tai and Chiu, Yen-Ting and Lee, Yu-Chou and Lu, Po-Yen and Lee, Mu-Hsien and Chen, Jia-Syuan and Ho, Kuan-Hsien and Liao, Hong-Chuan and Chen, Chieh-Cheng and Huang, Chao-Tsung},
  title={CATTUS: A 4K-UHD 30FPS Deep Image Processor for Channel Attention Equipped U-Net Acceleration in 16nm FinFET},
  abstract={This paper presents CATTUS, the first deep image processor to integrate U-Net acceleration with channel attention, enabling high-quality image deblurring on mobile devices. It achieves throughput of 4K-UHD 30fps with 4.4 TOPS/W of energy efficiency. The processor realizes image reconstruction on challenging tasks such as deblurring with three key features: 1) pyramid layer fusion (PLF) for efficient U-net acceleration, 2) skip tunneling that minimizes external memory access (EMA) by optimizing skip connections, 3) lookahead channel attention (LCA) to reduce EMA for aggregating global information. Fabricated in 16nm FinFET technology, CATTUS delivers a 1.53× throughput improvement and 82% EMA reduction compared to baseline implementation, demonstrating real-time imaging across multiple applications.},
  keywords={Memory management;Imaging;Very large scale integration;Tunneling;Throughput;FinFETs;Real-time systems;Mobile handsets;Energy efficiency;Image reconstruction},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075064},
}

@INPROCEEDINGS{11075220,
  author={Kim, Soyeon and Kwon, Hankyul and Lee, Jingu and Moon, Youngjin and Lee, Hongseok and Ryu, Junha and Kalzhan, Zhamaliddin and Kim, Sangyeob and Jo, Wooyoung and Yoo, Hoi-Jun},
  title={Nuvpu: A $\mathbf{4. 8} \boldsymbol{\sim} \mathbf{9. 6} \sim \mathbf{m J} /$ Frame Progressive NTT-Based Unified Video Processor for Stable Video Streaming and Processing with Neural Video Codec},
  abstract={This paper presents NuVPU, a unified neural video processor that supports both streaming and post-processing with $4.8 \sim 9.6 \text{mJ} /$ frame of energy efficiency. The Selective Convolution-mode Neural Engine (SCNE) adaptively selects either space or NTT convolution domain to increase throughput by $1.69 \sim 3.35 \times$. A Progressive NTT Unit (PNTU) lowers computation by 44.8 % and memory overheads by 80 % during domain changes. A Frequency-aware Compressor (FAC) and Adaptive Tile Scheduler (ATS) reduce the external memory access (EMA) of warping-based frame reuse by 81.3 %. NuVPU in 28nm CMOS process achieves \36.9 TOPS/W on UVG benchmark which is $9.2 \sim 2.3 \times$ higher than previous video processors.},
  keywords={Convolutional codes;Convolution;Streaming media;Very large scale integration;Benchmark testing;Throughput;CMOS process;Energy efficiency;Video codecs;Engines},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075220},
}

@INPROCEEDINGS{11074827,
  author={Song, Chang Eun and Xu, Weihong and Fan, Keming and Jain, Soumil and Hota, Gopabandhu and Yang, Haichao and Liu, Leo and Akarvardar, Kerem and Chang, Meng-Fan and Diaz, Carlos H. and Cauwenberghs, Gert and Rosing, Tajana and Kang, Mingu},
  title={Clo-HDnn: A 4.66 TFLOPS/W and 3.78 TOPS/W Continual On-Device Learning Accelerator with Energy-Efficient Hyperdimensional Computing via Progressive Search},
  abstract={Clo-HDnn is an on-device learning (ODL) accelerator designed for emerging continual learning (CL) tasks. CloHDnn integrates hyperdimensional computing (HDC) along with low-cost Kronecker HD Encoder and weight clustering feature extraction (WCFE) to optimize accuracy and efficiency. Clo-HDnn adopts gradient-free CL to efficiently update and store the learned knowledge in the form of class hypervectors. Its dual-mode operation enables bypassing costly feature extraction for simpler datasets, while progressive search reduces complexity by up to 61 % by encoding and comparing only partial query hypervectors. Achieving 4.66 TFLOPS/W (FE) and 3.78 TOPS/W (classifier), Clo-HDnn delivers $7.77 \times$ and $4.85 \times$ higher energy efficiency compared to SOTA ODL accelerators.},
  keywords={Continuing education;Accuracy;Very large scale integration;Feature extraction;Energy efficiency;Iron;Encoding;Complexity theory},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074827},
}

@INPROCEEDINGS{11075176,
  author={Zhu, Junkang and Kim, Minsik and Lu, Cheng-Hsun and Tang, Wei and Wei, Tianyu and Zhang, Zhengya},
  title={EVA: A 16mm2 1.54TFLOPS Tiled-Based Accelerator for Evolvable Edge Computing},
  abstract={EVA is an accelerator designed for evolvable edge computing applications. It integrates programmable processing array tiles (A-Tiles) for performance and utilization, and RISC-V CPU tiles (C-Tiles) for control and quick reconfiguration at a 100ns timescale. EVA features a versatile interconnect fabric, a distributed memory system, and flexible mapping. A 16mm2 EVA test chip achieves a throughput of 1.54TFLOPS (FP16) at 0.9V and a peak energy efficiency of 708GFLOPS/W at 0.49V, demonstrating high compute density and efficiency for diverse workloads.},
  keywords={Process control;Integrated circuit interconnections;Very large scale integration;Parallel processing;Throughput;Fabrics;Energy efficiency;Central Processing Unit;Edge computing},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075176},
}

@INPROCEEDINGS{11075163,
  author={Kim, Seah and Zhao, Jerry and Hsiao, Roger and Chi, Yufeng and Iyer, Vighnesh and Jain, Vikram and Nikolić, Borivoje and Shao, Yakun Sophia},
  title={MAVERIC: A 16nm 72 FPS, 10 mJ/Frame Heterogeneous Robotics SoC with 4 Cores and 13 INT8/FP32 Accelerators},
  abstract={MAVERIC is a 4 core, 13 INT8/FP32 accelerator unit (AU) 16mm2 SoC in Intel 16, for ML and robotics applications. 3D reconstruction (3DRecon) robotics application combines depth estimation (DE) and simultaneous localization and mapping (SLAM) for perception tasks, posing compute demand, accelerator integration, and scheduling challenges. MAVERIC operates at up to 1 GHz and achieves 8 TOPS/W peak energy efficiency (Eeff). It supports loop closure (LC) and delivers 10 mJ/frame and 72 FPS at the end-to-end DE and SLAM.},
  keywords={Maximum likelihood estimation;Gold;Simultaneous localization and mapping;Three-dimensional displays;Processor scheduling;Depth measurement;Very large scale integration;Energy efficiency;Robots},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075163},
}

@INPROCEEDINGS{11075196,
  author={Chen, Luyang and Ye, Dawei},
  title={A $\mathbf{0.06}\mathbf{mm}^{\mathbf{2}}$ 27.5-to-30GHz Series Resonance VCO with Magnetic Mutual Resistance Achieving 207.2dBc/Hz $\mathbf{FoM}_{\mathbf{A}}$ at 10MHz Offset},
  abstract={This paper proposes a series resonance voltage-controlled oscillator (SR-VCO) with magnetic mutual resistance (MMR) for the mm-wave band. The SR-VCO utilizes a single transformer to implement the LC tank. By manipulating the phase shift of current flow in the primary and secondary coils of the transformer, two resistive impedances, referred to as MMR, are generated. MMR enhances the tank impedance, resulting in reduced power consumption. Since MMR arises from magnetic coupling and does not dissipate energy, it preserves the quality factor $(Q)$ of the LC tank while suppressing MOSFET-induced noise, which is a dominant contributor to phase noise at mm-wave frequency. The proposed SR-VCO is fabricated in a 65nm CMOS process. The measured phase noise (PN) is -120.1dBc/Hz at 1MHz offset, with a power consumption of 46mW. The prototype occupies $0.06\text{mm}^{2}$ and achieves a $\text{FoM}_{\mathrm{A}}$ of 207.2dBc/Hz at 10MHz offset.},
  keywords={Resistance;Phase noise;Q-factor;Power demand;Power measurement;Phase measurement;Voltage-controlled oscillators;Magnetic resonance;Prototypes;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075196},
}

@INPROCEEDINGS{11074803,
  author={Ou, Tincheng and Hu, Kunpeng and Xu, Hao and Gu, Junjie and Wang, Yizhuo and Bi, Junyan and He, Wenpeng and Xu, Zhiwei and Law, Man-Kay and Yan, Na},
  title={A 0.06mm2 14.7-to-20.2GHz Quad-Core VCO Enabled by the Folded Circular Transformer Achieving 201.1dBc/Hz FoMT and 203.4dBc/Hz FoMA},
  abstract={This paper proposes a quad-core oscillator utilizing a folded circular transformer that utilizes both magnetic and electric coupling for core synchronization, greatly reducing the area and phase noise penalty of quad-core VCOs. Moreover, the proposed transformer simultaneously enhances common-mode and differential-mode quality factors. Fabricated in 28nm CMOS, the proposed VCO covers 14.7-to-20.2GHz (31.5%) within an area of $0.06 \text{mm}^{2}$ while consuming 5.3mW power. It achieves FoMA and FoMT@10MHz offset frequency of 203.4 and 201.1dBc/Hz at 15.8GHz.},
  keywords={Q-factor;Phase noise;Couplings;Voltage-controlled oscillators;Very large scale integration;Transformer cores;Transformers;Synchronization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074803},
}

@INPROCEEDINGS{11075175,
  author={Islam, Rakibul and Shi, Ji and Abdelrahman, Ahmed and Kim, Jintark and Elmeligy, Karim and Li, Yongxin and Selim, Mohamed O. and Yan, Jie and Younis, Mohamed B. and Xia, Ruhao and Aly, Mohamed S. and Khalil, Mahmoud A. and Hegazi, Ahmed E. and Kwon, Hyun-Keun and Vukasin, Gabrielle and Saxena, Saurabh and Kenny, Thomas W. and Bahl, Gaurav and Hanumolu, Pavan Kumar},
  title={A 1 ppb MEMS Oscillator Achieving -90 dBc/Hz at 10 Hz Offset Enabled by 5 M $\Omega$ TIA and 360° Phase Shifter},
  abstract={This paper presents a fully integrated MEMS oscillator incorporating a low-noise high gain TIA, tunable phase shifter, and drive control circuit. It is fabricated in 65 nm CMOS and features a 115–134 $\text{dB}\Omega, 81\text{fA}/\sqrt{\text{Hz}}$ TIA, a 360° phase shifter, and a 10mV - 200 mV drive control circuit. Leveraging a high Q electrostatic MEMS resonator, the oscillator achieves -90 dBc/Hz phase noise at a 10Hz offset.},
  keywords={Micromechanical devices;Phase noise;Phase shifters;Very large scale integration;Electrostatics},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075175},
}

@INPROCEEDINGS{11074963,
  author={Wang, Xuye and Zhu, Yingjie and Qian, Xihui and Zhao, Jian and Li, Yida and Wang, Guoxing and Li, Jiamin and Lin, Longyang},
  title={A 425pW, 0.3V, 32kHz Crystal Oscillator in 22nm FDSOI with Adaptive Pulse Injection and Amplitude Regulation Across −40°C to 125°C},
  abstract={This paper presents a sub-nW, single-supply crystal oscillator (XO) based on pulse injection at fundamental frequency. The integrated ZVD-based adaptive slicer enables accurate pulse injection timing against PVT variations at 162pW. The discrete PWA-based amplitude regulation enables oscillation amplitude regulation, reducing driver power to 93pW. The 22nm test chip shows a 3.7ppb Allan deviation floor at 425pW and $0.016\ \text{mm}^{2}$, with an operating temperature range from $-40^{\circ} \mathrm{C}$ to 125° C.},
  keywords={Temperature distribution;Accuracy;Silicon-on-insulator;Crystals;Very large scale integration;Regulation;Timing;Oscillators;Floors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074963},
}

@INPROCEEDINGS{11075173,
  author={Wang, Xin and Wang, Zixuan and Lei, Ka-Meng and Wang, Shanhu and Yao, Jiafei and Cai, Zhikuang and Mak, Pui-In and Guo, Yufeng},
  title={A 24-MHz Crystal Oscillator with 6.9-µs Startup Time and 2% Injection- $\Delta$ F Tolerance Using Phase-Interpolator-Assisted Synchronized Injection},
  abstract={This article presents a 24-MHz fast startup crystal oscillator with a phase-interpolator-assisted synchronized injection technique. This technique ensures the phase consistency between the injection source and the crystal resonance even with a 2% injection-ΔF. Additionally, a differential peak detection technique is proposed to detect the phase error incurred by $\Delta F$, shortening the auxiliary non-injection period to merely 4 cycles. Fabricated in a 40-nm CMOS process, the proposed XO achieves a $6.9-\mu \mathrm{s}$ startup time (166 cycles) and a 4.8-nJ startup energy with 2% injection inaccuracy when tested with a 24 MHz off-chip crystal.},
  keywords={Crystals;Very large scale integration;CMOS process;Resonance;Synchronization;Oscillators},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075173},
}

@INPROCEEDINGS{11075168,
  author={Moeneclaey, Bart and Lambrecht, Joris and Parisi, Angelo and Van Kerrebrouck, Joris and Coudyzer, Gertjan and Kankuppe, Anirudh and Martens, Ewout and Craninckx, Jan and Ossieur, Peter},
  title={A 7-Bit 150-GSa/s DAC in 5nm FinFET CMOS},
  abstract={We present a 7-bit wireline source-series terminated (SST) digital-to-analog converter (DAC) in 5nm FinFET CMOS. The number of unit cells is reduced by employing SST cells with relative weight 1 and 4. From an eight-phase clock, each unit cell creates clock pulses which are in turn used to control the three-stage 8: 1 multiplexer. At 150 GSa/s, the ENOB was measured to be 4.1bit for a 72.8GHz sinewave. The DAC consumes 621mW from a 0.9V and 0.96V supply. Eye diagrams of 150Gbit/s non-return to zero modulation and 300Gb/s P AM-4 are measured, pre-equalized using a 10-tap feedforward equalizer.},
  keywords={Multiplexing;Transmitters;Equalizers;Digital-analog conversion;Modulation;Very large scale integration;FinFETs;CMOS technology;Clocks;DAC;wireline;transmitter;P AM-4;FinFET;SST},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075168},
}

@INPROCEEDINGS{11074855,
  author={Kundu, Sandipan and Kim, Jihwan and Nguyen, Khoa Minh and Kim, Hyung-Seok and Shin, Dong Seok and Kim, Stephen and Yu, Kai and Clark, Matthew and Wali, Priya and Teles, Afonso and Saba, Rushdy and O'Mahony, Frank and Balankutty, Ajay},
  title={A 128Gb/s 0.67pJ/b PAM-4 Transmitter in 18A with RibbonFET and PowerVia},
  abstract={A fully integrated 128Gb/s DAC based transmitter designed for long-reach wireline applications in 18A CMOS process with RibbonFET, PowerVia and backside power delivery network is presented. Design optimization to utilize the lower leakage and faster RibbonFETs for improved energy efficiency and layout techniques to utilize backside power layer for inductor and clock distribution are demonstrated. The TX achieves the best energy efficiency of 0.67pJ/bit (0.75pJ/bit with the PLL) and smallest area reported while meeting key electrical compliance specifications for PAM -4 standards highlighting the continued benefits from CMOS scaling for wire line applications.},
  keywords={Transmitters;Layout;Production;Ethernet;Very large scale integration;Energy efficiency;Wire;Phase locked loops;Inductors;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074855},
}

@INPROCEEDINGS{11074826,
  author={Codega, N. and Asero, C. and Burgos, D.L. Herbas and Di Pasquo, A. and Nani, C. and Albano, D. and Monaco, E. and Giunco, F. and Martinelli, F. and Gira, G. and Fabiano, I. and Garampazzi, M. and Sosio, M. and Davoodi, M. and Ghittori, N. and Miral, N. Nadisha and Dadash, S. and Cyrusian, S. and Karam, V. and De Bernardinis, F. and Riani, J. and Parker, K. and Pascale, P. and Rossi, P. and Temporiti, E. and Scouten, S. and Mukherjee, T. and Jantzi, S. and Tse, L. and Chang, K.},
  title={A Monolithic $\mathbf{400Gbps}$ Electro-Optical Retimer with Integrated TIA and Class-AB Silicon-Photonics/VCSEL Driver in 5nm FinFET},
  abstract={In this paper we present a $4 \times 100 \text{Gb} / \mathrm{s}$ PAM4 electro-optical retimer with integrated TIA and driver realized in 5 nm FinFET technology. The focus of the paper is on the fully integrated line side electro-optical interfaces, targeting MMF (multi-mode fiber) as well as SMF (single-mode fiber) applications. In the line RX (LRX), with integrated TIA, a BER floor of 1E-11 and an average sensitivity of -9 dBm at a $\text{BER}=2.4 \mathrm{E}-4$ is achieved at 53.125 GBd. For the line TX (LTX), the integrated Silicon Photonics (SiPho) driver delivers 4Vpp to external Mach-Zehnder Modulators (MZM), while the integrated Vertical-Cavity Surface-Emitting Laser (VCSEL) driver delivers 9mApp to external VCSELs.},
  keywords={Mach-Zehnder interferometers;Sensitivity;Very large scale integration;Lasers and electrooptics;Electro-optic modulators;FinFETs;Silicon photonics;Vertical cavity surface emitting lasers;Electro-optical waveguides;Floors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074826},
}

@INPROCEEDINGS{11074881,
  author={Kwon, Kibaek and Roh, Hyungdong and Kim, Kihong and Noh, Dongin and Lim, Woongtaek and Park, Joonkyung and Lim, Dokyung and Jang, Dohun and Lim, Punghwan and Do, Jaehong and Yim, Subin and Lim, Dong-Hyuk and Yoo, Byoung-Joo and Choi, Michael and Rhew, Hyo-Gyuem and Shin, Jongshin},
  title={A 212.5Gb/s Pam-4 Receiver With Mutual Inductive Coupled Gm-Tia in 4nm Finfet},
  abstract={This paper presents a $212.5 ~\text{Gb} / \mathrm{s}$ PAM- 4 receiver (RX) in 4 nm FinFET. The receiver features a hybrid continuous time linear equalizer (CTLE) with stability enhanced commonmode feedback (CMFB), Gm-TIA amplifier with mutual inductive coupling, and clock distribution network using standing wave driver. The receiver occupies $0.56 ~\text{mm}^{2}$ and achieves a BER of $5.81 \mathrm{e}-6$ at 212.5Gbps, with a total insertion loss of 40dB at 53.125GHz.},
  keywords={Equalizers;Receivers;Insertion loss;Distribution networks;Very large scale integration;FinFETs;Inductive coupling;Circuit stability;Clocks;SerDes;Receiver;Gm-TIA;Inductive coupling},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074881},
}

@INPROCEEDINGS{11074819,
  author={Liu, P. and Hassan, A. and Kaushik, A. and Mostafa, A. and Yang, C. and Prabakaran, D. and Zhou, D. and Visani, D. and Hsiao, E. and Lu, F. and Chu, F. and Cui, G. and Yan, H. and Gu, J. and Zang, J. and Mohammad, K. and Jiang, L. and Gambhir, M. and Singh, M. and Kulkarni, P. and Ramakrishna, P. and Ho, R. and Xu, S. and Sivakumar, S. and Han, X. and Yang, X. and Adal, Z. and Guo, Z. and Li, Z. and Yan, Z. and Yu, Z. and Wang, H. and Chang, K.},
  title={A 128Gb/s ADC/DAC Based PAM-4 Transceiver with >45dB Reach in 3nm FinFET},
  abstract={This work presents a low-power and high-performance long reach transceiver suitable for AI data centers and cloud computing. This ADC/DAC based transceiver is implemented in 3nm FinFET, capable of equalizing >45dB channel loss @128Gbps achieving BER < 2e-8, compatible with PCIE GEN-7 data rate. Analog power of the transceiver is as low as 1.89pJ/b, and the total power efficiency is 4.1 pJ/b.},
  keywords={Data centers;Cloud computing;Voltage;Very large scale integration;FinFETs;Transceivers;Phase locked loops;Artificial intelligence;Vehicles;Wireline Transceiver;CLTE;Track & Hold;Voltage Mode Driver;PLL},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074819},
}

@INPROCEEDINGS{11075108,
  author={Kim, Jung-Hoon and Lim, Sukbin and Cha, Junseo and Moon, Seungjae and Seo, Dongjin and Lee, Hunjong and Kim, Jongho and Lee, Jinwon and Kim, Joo-Young},
  title={Adelia: A 4nm LLM Accelerator with Streamlined Dataflow and Dual-Mode Parallelization for Efficient Generative AI Inference},
  abstract={This paper presents Adelia, an efficient inference chip for large language models (LLMs) featuring a streamlined data-flow and dual-mode parallelization. The streamlined dataflow directly connects the external memory to Adelia's LLM-optimized compute engine with matched bandwidth, achieving an effective memory bandwidth usage of up to 91%. The systolic path between multiple engines facilitates data reuse to enhance computational power without compromising efficiency. Adelia dynamically transitions between context mode, which distributes the long context of a single request to optimize latency, and batch mode, which processes inputs from different requests to prioritize throughput based on the runtime status. Adelia is fabricated in 4nm technology and occupies $5.28\text{mm}^{2}$ in die area. Compared to the H100 GPU, it achieves 1.59x and 2.51x greater memory bandwidth efficiency and throughput efficiency, respectively, across various models.},
  keywords={Runtime;Spectral efficiency;Large language models;Memory management;Graphics processing units;Bandwidth;Very large scale integration;Throughput;Integrated circuit modeling;Engines},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075108},
}

@INPROCEEDINGS{11075113,
  author={Fan, Zichen and Zhang, Qirui and Abillama, Pierre and Shoori, Sara and Lee, Jungho and Tseng, Chien-Wei and Meng, Wei and Kim, Hun-Seok and Blaauw, David and Sylvester, Dennis},
  title={A 22nm 25.08TOPS/W Multi-Task Transformer Accelerator with Mixed Precision Structured Sparsity and Two-Stage Task-Adaptive Power Management},
  abstract={This paper presents the first silicon implementation of a transformer accelerator that executes multiple tasks simultaneously, improving per-task efficiency. It applies structured sparsity, multi-precision computation, and a two stage DVFS mechanism yielding highest reported efficiency per task.},
  keywords={Power system management;Very large scale integration;Transformers;Multitasking;Silicon;Computational efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075113},
}

@INPROCEEDINGS{11075114,
  author={Mun, HanGyeol and Meng, Jian and Hu, Xiaofeng and Liao, Yuan and Seo, Jae-sun},
  title={ASAP: A 28nm Transformer Training Accelerator with Alternating Sparsity and Asymmetrical Microscaling Floating-Point Precision},
  abstract={This paper presents a new Transformer training accelerator, ASAP, which supports alternating sparsity and asymmetrical precision, preserving accuracy while efficiently handling both dense and sparse weights. A reconfigurable pipeline SIMD (RP-SIMD) architecture is proposed to efficiently support special functions. ASAP achieves 26.6 TOPS/W energy efficiency and 2.9 TOPS performance, surpassing state-of-the-art works by 2.02-to-5.07× in training energy-efficiency.},
  keywords={Training;Accuracy;Single instruction multiple data;Pipelines;Very large scale integration;Transformers;Energy efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075114},
}

@INPROCEEDINGS{11074779,
  author={Zhang, Shuyuan and Chen, Xizhu and Peng, Cheng and Yang, Huazhong and Liu, Yongpan and Jia, Hongyang},
  title={A 94Hz Inference and 7.4mJ/Epoch Fine-Tune Edge SoC for Diffusion-Based Robot Manipulation with Speculation and Disturbance Enhancement},
  abstract={We present an edge SoC for diffusion-transformer-based action generation (DiTAG) in robot manipulation featuring both low-latency inference and high-fidelity on-device finetune. The substantial challenges of their edge acceleration are overcome by a speculative parallel inference and disturbanceenhanced low-bit fine-tune architecture. The 28nm prototype integrating the quad-core accelerator with CPU shows 10.6ms inference, $36.8 \times$ better than an edge GPU, with 7.88TOPS/W system energy efficiency, and $7.4 \text{mJ} /$ epoch on-device finetune with minimal accuracy loss at normal voltage.},
  keywords={Accuracy;Prototypes;Graphics processing units;Voltage;Very large scale integration;Energy efficiency;Central Processing Unit;Low latency communication;Robots},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074779},
}

@INPROCEEDINGS{11075090,
  author={Mormul, Yevhenii and Nguyen, Viet and Staszewski, Robert Bogdan},
  title={A Pipelined-SAR-TDC with Time-Domain Noise-Shaping Self-Calibration},
  abstract={We introduce a new architecture of a pipelined SAR time-to-digital converter (TDC) operating at 800 MS/s. To overcome the problem of high nonlinearity and performance variability in prior art, a time-domain noise-shaping (NS) self-calibration technique is proposed. It boosts SFDR by 20 dB achieving 55 dB, yielding the best-in-class 96% bit-utilization (ENOB/NOB) and $\text{FoM}_{\mathrm{w}}$ of 40 fJ/conv-step. Measurements across supply variations and multiple ICs validate the efficacy of the proposed approach.},
  keywords={Art;Very large scale integration;Noise shaping;Time-domain analysis},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075090},
}

@INPROCEEDINGS{11074903,
  author={Cents, Remon and Bindra, Harijot Singh and De Vree, Henk and Nauta, Bram},
  title={A 0.5-0.8V 10-85 MS/s 12-Bit SAR ADC in 22nm FDSOI Utilizing an Inverter-Based Comparator Architecture},
  abstract={A low-noise high-speed inverter-based comparator architecture integrated within a SAR ADC is proposed, enabling the ADC to operate down to 0.5 V supply at a state-of-the-art Nyquist rate of $10 \text{MS} / \mathrm{s}$, while still achieving 9.5 ENOB and a Walden FoM of $2.0 \text{fJ} /$ conv - step. At its typical supply of 0.8 V, the ADC demonstrates 9.9 ENOB at a Nyquist rate of $85 \text{MS} / \mathrm{s}$, with a Walden FoM of $3.6 \text{fJ} /$ conv-step.},
  keywords={Silicon-on-insulator;Very large scale integration;Inverters;SAR ADC;inverter OTA;IoT;Comparator},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074903},
}

@INPROCEEDINGS{11074920,
  author={Jeong, Hyun-Woo and Lee, Chan-Ho and Nam, Sang-Yun and Hong, Sung-Wan},
  title={A ${G}_{\mathrm{m}}$-Boosted 3-Stage Amplifier with Gain-Enhancing Feedforward Path for $\mathrm{C}_{\mathrm{L}}$ of 40-160nF},
  abstract={This paper proposes a 3-stage amplifier designed to drive a load capacitor ($\mathrm{C}_{\mathrm{L}}$) exceeding 100 nF. To ensure stability with a large $\mathrm{C}_{\mathrm{L}}$ while achieving high DC gain and sufficient gainbandwidth (GBW), this amplifier uses a transconductance ($G_{\mathrm{m}}$) boosting cell and a gain-enhancing feedforward path (GE-FFP). As a result, the amplifier achieves DC gain $>130 \text{dB}$, GBW of 1.47 MHz, and phase margin (PM) of 51° when driving $\mathrm{C}_{\mathrm{L}}$ of 160 nF. The chip was fabricated in a 28 nm CMOS process.},
  keywords={Capacitors;Very large scale integration;CMOS process;Boosting;Circuit stability;Transconductance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074920},
}

@INPROCEEDINGS{11074806,
  author={Cho, Jeong-Hyun and Kim, Hyun-Sik},
  title={A Boosted 3.5W, -81.6dB THD+N, 92.6% Total Efficiency, Battery-Powered Class-D Audio Amplifier with True-Zero-Switching Achieving Quiescent Current of 0.9mA},
  abstract={This paper presents a battery-powered Class-D audio amplifier (CDA). The single-stage topology boosts the output to up to $2 \times$ of the battery voltage using a flying capacitor directly mounted on the die. The true-zero-switching (TZS) minimizes quiescent current to 0.9mA. Fabricated in a 180nm, the chip achieves a peak efficiency of 92.6% with a maximum power of 3.56W. A peak THD+N of −81.6dB at 1kHz was measured.},
  keywords={Semiconductor device measurement;Current measurement;Capacitors;Very large scale integration;Battery charge measurement;Topology;Batteries},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074806},
}

@INPROCEEDINGS{11075221,
  author={Jeon, Taejune and Kang, Kyungmin and Yun, Soohyun and Yoon, Seokho and Kim, Byeongseol and Bae, Joonsung and Chae, Youngcheol},
  title={A Fully Balanced Biphasic Neurostimulator with Body-Coupled Powering and Full-Duplex Communication Via Baseband Load Shift Keying},
  abstract={This paper presents a wireless biphasic neurostimulator that exploits body-coupled powering and full-duplex communication, achieving precise stimulation with real-time feedback. Simultaneous wireless power and data transmission can be achieved with a baseband load shift keying. A fully balanced biphasic stimulation can be achieved, whose current is applied using flying capacitors and current regulators, and the residual charge after biphasic stimulation becomes extremely small. Implemented in a 65 nm CMOS, the prototype IC achieves a downlink BER of $1.8 \times 10^{-4}$, an uplink BER of $< 3 \times 10^{-5}$, and a residual charge of 0.22 nC at a depth of 40 mm in porcine tissue.},
  keywords={Wireless communication;Baseband;Regulators;Prototypes;Full-duplex system;Very large scale integration;Downlink;Real-time systems;Data communication;Uplink},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075221},
}

@INPROCEEDINGS{11075159,
  author={Zhou, Meiyi and Xin, Haoming and van Wegberg, Roland and Langereis, Geert and Lopez, Carolina Mora and Konijnenburg, Mario and Van Helleputte, Nick},
  title={A Flexible HV Stimulator ASIC with Stimulus-Synchronized Charge Balancing and Embedded CM Regulation for Implantable Peripheral Nerve Stimulation},
  abstract={We present a flexible HV stimulator ASIC for implantable peripheral nerve stimulation applications. Innovative charge balancing techniques are introduced to support diverse stimulation current waveforms, achieving state-of-the-art performance. Fabricated in 130-nm BCD technology, the ASIC has been fully validated through saline characterizations.},
  keywords={Very large scale integration;Regulation},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075159},
}

@INPROCEEDINGS{11075081,
  author={Dandekar, Mohit and Myny, Kris},
  title={An N-Type-Only a-IGZO Thin-Film-Transistor Based Nyquist-Rate 8-bit CDAC+SAR ADC Consuming 1.7mW at 32ksps and Achieving 44dB SNDR},
  abstract={This paper presents an 8-bit SAR-ADC design implemented using n-type-only a-IGZO devices in a TFT-on-foil technology. The ADC operates at a sampling rate of 32ksps, consuming 1.7mW, and achieves an SNDR of 44dB, resulting in a $\text{FOM}_{\mathrm{W}}$ of 410 pJ/c.s. This performance surpasses the current state-of-the-art thin-film designs by approximately 50x, closing the gap between thin-film and Silicon design space, making all TFT flexible bioelectronic sensors feasible. The high sampling rate and accuracy allow for the digitization of signals directly on a flexible biomedical sensor, providing a digital output resistant to noise and interference.},
  keywords={Semiconductor device measurement;Histograms;Voltage measurement;Power measurement;Measurement uncertainty;Biomedical measurement;Very large scale integration;Silicon;Time measurement;Frequency measurement;a-IGZO;thin-film-transistor;flexible-electronics;SAR-ADC;bio-electronics},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075081},
}

@INPROCEEDINGS{11075124,
  author={Lee, Dongyoon and Cheon, Song-I and Choi, Dong-Hwi and Cho, Yoonsang and Park, Seonghyun and Santos, Christopher and Cho, Hyungjoo and Ha, Sohmyung and Je, Minkyu},
  title={A 16-QAM-Based Multi-Node BCC System with Bias-Electrode-Free Multi-Channel ExG Readout ICs},
  abstract={We present a system for multi-node body channel communication (BCC) integrated with multi-channel ExG readout ICs. By utilizing time-multiplexing for BCC communication and ExG measurement, the system minimizes interference between the BCC signal and the ExG readout IC, enabling the measurement of EEG, which requires ultra-low noise, along with EOG, EMG, and ECG signals. Moreover, eliminating the bias electrode increases BCC signal amplitude by 60%, allowing 16-QAM communication at 8Mbps even under time-multiplexing operation. To guarantee the robustness of communication, the system adaptively switches to OOK modulation in cases of significant body channel loss. Additionally, the system employs a multi-channel least-mean-square (LMS) filter and a DC servo loop (DSL) to effectively address channel mismatches and differential artifacts.},
  keywords={Electrooculography;Noise;Modulation;Interference;Very large scale integration;Robustness;Electromyography;Electroencephalography;Noise measurement;Servomotors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075124},
}

@INPROCEEDINGS{11075152,
  author={Miura, Noriyuki and Monta, Kazuki and Wadatsumi, Takuya and Shiomi, Jun and Hiraga, Yukihito and Sugawara, Takeshi and Nagata, Makoto},
  title={A High-Order Masking with Load-Delay-Equalized WDDL for Provable Side-Channel Security},
  abstract={A custom WDDL is proposed for provably secure high-order masking. XOR/AND used in WDDL are designed by symmetric Pass Transistor Logic (PTL) to suppress data dependency in power/delay. A self-retimer is introduced to avoid accumulation of inter-stage power/delay variations due to unbalanced layout and routings. Those custom circuit techniques reduce data-dependent information leakage and non-ideal leakage due to unwanted coupling through supply and ground for proven high-order side-channel security.},
  keywords={Couplings;Layout;Very large scale integration;Information leakage;Security;Transistors;Logic},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075152},
}

@INPROCEEDINGS{11075211,
  author={Lee, Jaehoon and Lee, Jongmi and Youn, Yelim and Lim, Yong and Hong, Dongyeon and Kang, Bogyeong and Yoo, Sangmin and Sim, Jae-Yoon},
  title={A 1.7 pJ/bit 10 MHz Calibration-Free PVT Variation and Mismatch Tolerant Latch-Based True Random Number Generator in 4 nm FinFET},
  abstract={This paper presents a calibration-free, latch-based true random number generator (TRNG). The entropy source, a ring structure formed with two inverters and two capacitors connected in series, systematically cancels the offset caused by device mismatches and parasitic capacitances while amplifying the device noise. By combining four entropy sources with XOR operations, the proposed TRNG achieves qualified randomness without additional noise or calibration. The proposed TRNG, fabricated in a core area of $1679 \mu \mathrm{m}^{2}$ using a 4 nm FinFET process, demonstrates robust operation across 80 samples, covering standard process corners(SS, TT, FF) and a wide supply ($0.75 \mathrm{V}-0.95 \mathrm{V}$) and temperature ($-40^{\circ} \mathrm{C}$ to 85° C) range. Validations on NIST SP 800-22 and NIST SP $800-90 \mathrm{B}$ while supply noise of up to 200 mV is being injected highlight its robustness against external perturbations. The TRNG, with an energy efficiency of $1.7 \text{pJ} /$ bit at 0.75 V, reveals its suitability for low-power applications.},
  keywords={Structural rings;Temperature distribution;Noise;Very large scale integration;NIST;FinFETs;Generators;Entropy;Robustness;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075211},
}

@INPROCEEDINGS{11075120,
  author={Li, Mao and Huang, Paul Xuanyuanliang and Park, Jaehan and Mathew, Sanu K. and De, Vivek and Seok, Mingoo},
  title={GUARD: A Fully-Digital TDC-Based Clock and Voltage Glitch Detector with On-Demand Protection in a 28nm CMOS},
  abstract={We present GUARD, a clock and voltage glitch detector with on-demand protection using clock gating, supporting clock frequency up to 1.2GHz. It achieves 100% detection and protection accuracy on a victim MCU under glitch attacks of different profiles as small as 100ps, robustly across -40-125°C and 0.6-1.1V. GUARD can also differentiate normal IR drops from real glitch attacks to prevent unnecessary protection overhead. It consumes $2958\mu\mathrm{m}^{2}$ and 0.874mW/100MHz.},
  keywords={Accuracy;Hardware security;Voltage;Detectors;Very large scale integration;CMOS technology;Circuit faults;Protection;Clocks;hardware security;fault injection attack;clock and voltage glitch attack;attack detection;attack protection},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075120},
}

@INPROCEEDINGS{11074813,
  author={Wang, Tianqi and Qu, Hao and Fang, Qiang and Alioto, Massimo},
  title={Online Learning-Based Countermeasure Against Power Analysis Attacks},
  abstract={An online learning-based countermeasure against power analysis attacks is presented. The proposed countermeasure digitizes power and learns on chip, training a power compensation machine learning model. For the first time, this enhances security in a die-specific manner (e.g., adaptation to mismatch) and over time (e.g., adaptation to aging). On-chip learning avoids disastrous ($18,000 \times$ worse) aging-induced security deterioration, achieving billion-scale MTD.},
  keywords={Training;Adaptation models;Hardware security;Machine learning;Very large scale integration;Aging;System-on-chip;Integrated circuit modeling;side-channel;machine learning;hardware security},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074813},
}

@INPROCEEDINGS{11075215,
  author={Um, Soyeon and Ha, Sangwoo and Whang, Sunjoo and Kim, Minsung and Kim, Byeongcheol and Kim, Sangjin and Ryu, Junha and Jeong, Chaeyun and Sohn, Kyomin and Yoo, Hoi-Jun},
  title={Dial: An Energy-Efficient Dram in-Memory Computing Accelerator with Compact Partial Product Lut and Twisted Differential Adc},
  abstract={This paper presents DIAL, an energy-efficient DRAM inmemory computing accelerator with partial product LUTbased architecture for advanced tasks. The compact LUT reduces 53% of the LUT area and 45% of power by eliminating extended zeros. The twisted differential ADC reduces ADC area by 37 % and power by 45 % through comparators sharing and improves CSNR by using a 2.3fF computation capacitor and increasing ADC resolution by $3 \times$. The dual-mode sense amplifier reduces 33% of LUT power by adjusting operation modes based on data patterns. Fabricated in 28 nm CMOS technology, DIAL occupies a $20.25 \text{mm}^{2}$ die area and achieves 55.4 TFLOPS/W energy efficiency on the GPT-2 benchmark, demonstrating a $4.1 \times$ higher efficiency than prior IMC designs.},
  keywords={Quantization (signal);Energy resolution;Capacitors;Random access memory;Computer architecture;Very large scale integration;In-memory computing;CMOS technology;Energy efficiency;Table lookup;DRAM;In-Memory Computing (IMC);look-up table (LUT);non-uniform quantization (NUQ)},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075215},
}

@INPROCEEDINGS{11074985,
  author={Hsu, Hung-Hsi and Khwa, Win-San and Wen, Tai-Hao and Hsu, Wei-Ting and Chang, Yu-Chen and Lu, Hsin-Yin and Wen, Hua-Jin and Chen, Chang-Yuan and Huang, Yen-Che and Wu, Chih-Ling and Wu, Ping-Sheng and Ho, Mon-Shu and Lo, Chung-Chuan and Liu, Ren-Shuo and Hsieh, Chih-Cheng and Tang, Kea-Tiong and Teng, Shih-Hsin and Chih, Yu-Der and Chang, Tsung-Yung Jonathan and Chang, Meng-Fan},
  title={A 22nm 41.8TFLOPS/W AI-Edge Transformer/CNN Nonvolatile-Processor Using QKV-Softmax-Layer-Fused Hybrid ReRAM-CIM and Concurrent-Transpose/Non-Transpose SRAM-CIM},
  abstract={Tiny AI-edge devices use nvCIM for power-off weight storage and active-mode computation, enabling high energy efficiency (EF) and low power-on latency. While tiny Transformer models offer higher accuracy than CNNs, they pose significant challenges for homogeneous nvCIM architectures due to attention-based operations that require dynamic matrix multiplications (MM), where both inputs and weights are generated on-the-fly. This paper presents a hybrid ReRAM-CIM and SRAM-CIM nvProcessor optimized for Transformer and CNN models, featuring a CIM-friendly layerfused flow. Fabricated in a 22 nm process, the proposed nvProcessor achieves 41.8 TFLOPS/W (system), 55.2 TFLOPS/W (macro) and 74.48% ImageNet accuracy, enabling high EF and accuracy with tiny (Mb-level) models.},
  keywords={Accuracy;Nonvolatile memory;Computational modeling;Computer architecture;Very large scale integration;Transformers;In-memory computing;Energy efficiency;Computational efficiency;Integrated circuit modeling;multiply-and-accumulation (MAC);nonvolatile memory (NVM);nonvolatile compute-in-memory (nvCIM)},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074985},
}

@INPROCEEDINGS{11075101,
  author={Wu, Zihan and Wang, Yiqi and He, Zhen and Yang, Bohan and Wang, Yang and Wei, Shaojun and Hu, Yang and Tu, Fengbin and Yin, Shouyi},
  title={CELLA: A 28nm Compute-Memory Co-Optimized Real-Time Digital CIM-Based Edge LLM Accelerator with 1.78ms-Response in Prefill and 31.32 Token/s in Decoding},
  abstract={This work presents a digital Compute-in-memory (CIM)-based Edge LLM Accelerator CELLA with Compute-Memory co-optimization for Prefill-Decoding phases: 1) Prefill is compute-bound and CIM works in MAC-mode. A puzzle-shaped input scheduling unit (PISU) reassembles input into an interlocking pattern, reducing $2.82\times$ TTFT. 2) Decoding is memory-bound and CIM works in CAM-mode. (a) For static parameters, non-uniform quantization multiply-accumulation (NUQ-MAC) is processed in CIM with majority-first index searcher (MFIS), saving $4.89\times$ TPOT. (b) For dynamic KV cache, only important KV is fetched by hash-based cache filter (HCF), saving $4.13\times$ TPOT. It reaches 1.78ms-response and 31.32token/s, speeding up $2.53\sim 9.74\times$ than state-of-the-art accelerators and edge GPU.},
  keywords={Quantization (signal);Processor scheduling;Graphics processing units;Very large scale integration;In-memory computing;Dynamic scheduling;Real-time systems;Common Information Model (computing);Decoding;Indexes},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075101},
}

@INPROCEEDINGS{11074791,
  author={Bhattacharya, Tinish and Kwon, Dongseok and Hutchinson, George Higgins and Zhang, Xiangyi and Rozada, Ignacio and Strukov, Dmitri},
  title={A Fully Integrated Mixed-Signal Compute-In-Memory Accelerator for Solving Arbitrary Order Boolean Satisfiability Problems},
  abstract={This paper presents a mixed-signal In-Memory Computing (IMC) accelerator with $256 \times 128$ 10T bi-directional SRAM array in 55 nm CMOS process, for solving arbitrary-order KBoolean Satisfiability (K-SAT) problems. It achieves nearly an order of magnitude faster solution times compared to other single-variable update ASIC solvers on uniform random 3-SAT problems, while outperforming all other solvers by $10 \div 200 \times$ on the studied higher-order K-SAT problems, relevant to cryptography applications.},
  keywords={Random access memory;Bidirectional control;Very large scale integration;In-memory computing;CMOS process;Cryptography},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074791},
}

@INPROCEEDINGS{11075128,
  author={Nam, Sang-Yun and Park, Hyeonho and Kim, Won-Gyu and Hong, Sung-Wan},
  title={A 0.087 fs FOM Current-mirror-based Analog-assisted Digital LDO with Vo Ripple Optimization},
  abstract={This paper proposes a current-mirror based analog-assisted (CBAA) digital low-dropout regulator (DLDO) that achieves a fast transient response and output voltage $(\mathrm{V}_{\mathrm{O}})$ ripple optimization. It features less than 1 $\text{mVV}_{\mathrm{O}}$ ripple at 200 mA load current $(\mathrm{I}_{\mathrm{L}})$ and 106 mV undershoot in load transition. Fabricated using 28 nm CMOS process, the CBAA DLDO shows a superior figure-of-merit (FOM) of 0.087 fs among low input voltage $(\mathrm{V}_{\text{IN}})$ DLDOs.},
  keywords={Transient response;Regulators;Very large scale integration;CMOS process;Voltage control;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075128},
}

@INPROCEEDINGS{11075031,
  author={Dong, Yanchi and Liu, Xueping and Jing, Yiqi and Huang, Ru and Ye, Le and Jia, Tianyu},
  title={Distributed Power Management for 22nm AI Processor with Event-Driven Exponential Dual-Loop LDOs and Online Sparsity-Aware Droop Mitigation},
  abstract={A distributed power management solution is presented for a 22 nm digital compute-in-memory (DCIM) based AI processor featuring distributed dual-loop digital LDOs with event-driven exponential control for fast response, online learning-based sparsity-aware droop mitigation, and workload-driven current balance scheme among LDOs. The work demos the promising opportunity of deploying distributed management for robust and efficient AI computing, where the above techniques lead to $>71.6 \%$ droop reduction for diverse AI workloads and up to 33.3 % energy saving or 22.5 % performance improvement.},
  keywords={Prevention and mitigation;Power system management;Energy conservation;Process control;Very large scale integration;In-memory computing;Artificial intelligence;Distributed management},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075031},
}

@INPROCEEDINGS{11075218,
  author={Ahmed, Zakir and Kim, Suhwan and Do, Huong T and Krishnamurthy, Harish K and Ravichandran, Krishnan and Tschanz, James W and De, Vivek},
  title={A Fully Integrated Buck Voltage Regulator in 16nm with in-Package Air Core Inductor Featuring Digital Computational Control for Fast Transient Responses},
  abstract={This paper presents a fully integrated buck voltage regulator in 16 nm CMOS with in-package air-core inductors. A digital computational non-linear controller is proposed demonstrating 20 ns response time with 25 mV droop at $1 \mathrm{A} / 0.4 \text{ns}$ load step.},
  keywords={Transient response;Regulators;Very large scale integration;Time factors;Voltage control;Inductors;Transient analysis;Digital computation controller;buck regulator;fast transient response;non-linear controller},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075218},
}

@INPROCEEDINGS{11074847,
  author={Chen, Chun-Yuan and Lee, Cheng-Ying and Chen, Ke-Horng and Zheng, Kuo-Lin and Lin, Ying-Hsi and Lin, Shian-Ru and Tsai, Tsung-Yen},
  title={An 85.6%-Efficiency Supply Modulator with Auxiliary Bidirectional Power for 200MHz 5G NR Applications},
  abstract={To meet high bandwidth and wide output range requirements while achieving high efficiency in 5G envelope tracking (ET), the proposed Auxiliary Bidirectional Power (ABP) supply modulator recycles excessive energy to the auxiliary capacitor (CAUX) and optimizes the linear amplifier's supply voltage via droop mechanism combined with the adaptive voltage supply, achieving peak efficiency of 85.6%. The measured PA output spectrum shows -38.97dBc/-38.34dBc ACLR at NR 200MHz 26dBm},
  keywords={Power measurement;5G mobile communication;Capacitors;Modulation;Bandwidth;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074847},
}

@INPROCEEDINGS{11075162,
  author={Cho, Mun-Jung and Shin, Changsik and Lee, Seung-Ju and Kim, Jong-Hun and Jeong, Yeon-Woo and Kim, Min-Sik and Kim, Myeong-Ho and Jeon, Hyuntak and Shin, Se-Un},
  title={A 90–260 $\mathrm{V}_{\text{AC}}$ Isolated Offline Single-Stage Single-Transformer-Winding Multiple-Output (STWMO) RGBW LED Driver with <0.7% Current Variation and Dimmable Current-Regulated Error-Based Control},
  abstract={This paper proposes an isolated offline single-stage single-transformer-winding multiple-output (STWMO) RGBW LED driver optimized for mood lighting systems. The proposed design reduces external components and system volume by utilizing a single transformer winding for multiple outputs. A cross-side error-sum feedback circuit (CS-ESFC) ensures precise and independent current regulation. Additionally, a switched-capacitor amplitude modulation (SC-AM) circuit addresses cross-regulation issues, maintaining stability during color and brightness adjustments. The driver achieves a peak efficiency of 90.45% with a current variation under 0.7% across a wide input voltage range of 90 to 260 VAC, offering a compact and cost-effective solution for RGBW LED drivers.},
  keywords={Current control;Mood;Feedback circuits;Windings;Lighting;Color;Very large scale integration;Light emitting diodes;Circuit stability;Switching circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075162},
}

@INPROCEEDINGS{11075069,
  author={Hong, Feifan and Chen, Jiawen and Guan, Pingda and Kumar, Sayan and Staszewski, Robert B. and Siriburanon, Teerachot},
  title={A 24.5-to-45.2-GHz Dual-Injection Clock Multiplier with Folded-Inductor-Based Magnetic-Flux Cancellation Achieving 32.83-fsrms Jitter and 0.037-mm2 Core Area},
  abstract={We present an injection-locked clock multiplier (ILCM) with an ultra-wide frequency tuning range (TR) and low-jitter, employing a compact folded-inductor-based magnetic-flux cancellation technique. An LC-series dual-mode quadrature ring oscillator (QRO) is co-designed with an edge-combining frequency doubler in mm-wave bands to simultaneously extend the TR and lower the phase noise. Leveraging the differential time-alignment technique, the proposed design achieves an exceptionally large loop bandwidth $(\mathrm{f}_{\text{BW}})$. Fabricated in 28-nm, $\text{HPC}+\text{CMOS}$, the QRO provides a 59.46% TR (12.25-22.6 GHz), while the doubler's output delivers a frequency range of 24.5 to 45.23 GHz. Occupying a tiny core area of 0.037 mm2, the proposed ILCM achieves a measured rms jitter of 32.83 fs at 39.5 GHz.},
  keywords={Ring oscillators;Phase noise;Magnetic cores;Area measurement;Bandwidth;Very large scale integration;Jitter;Tuning;Magnetic circuits;Clocks},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075069},
}

@INPROCEEDINGS{11074790,
  author={Zhang, Ningyuan and Zhang, Sihao and Wu, Chuancheng and Wang, Yixiao and Liu, Junhua and Liao, Huailin},
  title={A Calibration-Free Adpll with < -80 dBc Fractional Spur Based on Pseudo-Random Phase Modulation},
  abstract={This work presented a fractional-N digital PLL that leveraged pseudo-random phase modulation and demodulation technique to mitigate fractional spurs. By decoupling the periodicity of control words from the non-linearity of the digital phase interpolator (DPI), the fractional spurs induced by DPI non-linearity were effectively suppressed. The digital PLL fabricated in 40nm CMOS, demonstrated fractional spurs below noise floor at near-integer channels.},
  keywords={Phase modulation;Noise;Very large scale integration;Phase locked loops;Floors;Demodulation;Low-spur;ADPLL;DPI;Fractional-N},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074790},
}

@INPROCEEDINGS{11074797,
  author={Khongprasongsiri, Chawin and Kumar, Sayan and Sawakewang, Patchara and Staszewski, Robert Bogdan and Siriburanon, Teerachot},
  title={A 31.5-36 GHz Low-Spur Gain-Boosting Charge-Sharing Locking PLL with 54fs Jitter},
  abstract={We propose a gain-boosting (GB) charge-sharing locking (CSL) PLL that achieves both ultra-low jitter and low reference spur. The GB-CSL mechanism reads the charge residue of CSL via an ADC, amplifies it digitally, and precharges it back via a DAC with a small charge-sharing capacitor Cshare coupled to the LC-tank. This significantly enhances the PLL bandwidth $f_{\text{BW}}$, resulting in low rms jitter while minimizing load modulation to the LC-tank. Implemented in 28-nm CMOS, the $\sim 33-\text{GHz}$ PLL achieves 54 fs rms jitter and a low reference spur of -66 dBc, while consuming 14 mW.},
  keywords={Capacitors;Modulation;Bandwidth;Jitter;Very large scale integration;Phase locked loops},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074797},
}

@INPROCEEDINGS{11075148,
  author={Xu, Zule and Allebes, Erwin and Mateman, Paul and van den Heuvel, Johan and van der Ven, Stan and Traferro, Stefano and Kumar, Ashish and Li, Ran and Nagata, Shun and Bunsen, Keigo and Matsumoto, Tomohiro and Konijnenburg, Mario},
  title={A 2.3–15.8-GHz 8-Phase Injection-Ripple-Filtered Multi-Ring-Coupled DCO Enabling a Wideband Digital PLL},
  abstract={A high-frequency wide-range 8-phase DCO with inherent injection ripple filtering is proposed and incorporated into a wideband digital PLL. The DCO in prototype PLL achieves 2.3–15.8GHz frequency range. With the multiplication factor of 260, the PLL achieves 3–15.5GHz wideband output, −59dBc far-off injection spur at 10GHz output, and −260dB FoMN.},
  keywords={Filtering;Injection-locked oscillators;Prototypes;Very large scale integration;Phase locked loops;Wideband;8-phase oscillator;injection locking;injection ripple filtering;ring-oscillator-based PLL},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075148},
}

@INPROCEEDINGS{11075038,
  author={Ma, Heng and Zhang, Huajun and Berkhout, Marco and Fan, Qinwen},
  title={A -87.2 dB THD+N 89.1 dB DR Fully-Integrated Shunt-Resistor-Based In-Line Current Sensor with up to 2 MHz 14.4 V PWM Rejection},
  abstract={This paper presents a cost-effective, fully-integrated shunt-resistor-based in-line current sensor offering high linearity and effective PWM rejection for audio applications. To mitigate the on-chip shunt resistor self-heating, which could severely compromise the linearity of the current sensor, a thermal compensation method is proposed and improves the THD+N by up to 23.6 dB. A floating Gm stage is proposed to reject highfrequency high-voltage (HV) PWM signals at the audio amplifier switching node. Implemented in a 180 nm BCD process, the prototype achieves a peak THD + N of −87.2 dB and a DR of 89.1 dB with up to 2 MHz, 14.4 V PWM rejection,},
  keywords={Resistors;Thermal resistance;Linearity;Prototypes;Switches;High-voltage techniques;Pulse width modulation;Very large scale integration;Thermal sensors;System-on-chip},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075038},
}

@INPROCEEDINGS{11074984,
  author={Chen, Yekan and Dong, Jiaqi and Zhang, Qi and Wang, Yinan and Zhao, Bo and Luo, Yuxuan},
  title={A 131-dBSPL AOP 66.3-dB SNR 105.7-$\mu$ A-Standby All-Dynamic Digital Microphone with Self-Clocked Interference-Resilient Acoustic Activity Detection},
  abstract={This paper presents a 103.3dB-dynamic-range all-dynamic digital CMOS-MEMS microphone with internal acoustic activity detection (AAD). A voltage-boosting dynamic analog front end (VB-DAFE) is proposed to allow linear scaling of supply current with operating frequency and extend dynamic range (DR) under 1.8 V system supply. Besides, an event driven (ED) zoom analog-to-digital converter (zoom-ADC) is proposed to handle large output swing from the VB-DAFE. The VB DAFE and zoom-ADC allow the system to operate in an all dynamic manner, enabling scalable power with operating frequency, suitable for ED operations. Under a 1.8 V supply, this work achieves an acoustic overload point (AOP) of 131 dBSPL, a signal-to-noise (SNR) of 66.3 dB and a standby current of $105.7 \mu ~\mathrm{A}$ with internal self-clocked interference resilient AAD.},
  keywords={Interference;Very large scale integration;Dynamic range;Acoustics;Voltage control;Analog-digital conversion;Signal to noise ratio;Microphones},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074984},
}

@INPROCEEDINGS{11075155,
  author={Pan, Shuliang and Yu, Wei-Han and Tan, Fei and Li, Jixuan and Un, Ka-Fai and Martins, Rui P. and Mak, Pui-In},
  title={A $5.2\mu \mathrm{W}$, 2-to-8-Channel Scalable, Speaker-Tracking Microphone Array Featuring a CNN-Defined AFE},
  abstract={This paper describes a smart microphone array with speaker-tracking capability to enhance the output voice signal-to-noise ratio (SNR). The speaker verification (SV) module identifies the target speaker in both near and far fields and intelligently adjusts the beamforming direction-of-arrival (DoA) and the analog front-end (AFE) gain for a better output voice SNR. The system chip in 28nm process is bonded with a capacitive micro-electro-mechanical system (MEMS) microphone, and it integrates an in-sensor-computing channel that can arbitrarily scale between 2 to 8, to realize a small form-factor DoA. With also our energy-efficient delay and sum (DAS) and SV circuit techniques, the system chip consumes only $5.2\mu \mathrm{W}$.},
  keywords={Micromechanical devices;Microelectromechanical systems;Array signal processing;Very large scale integration;Microphone arrays;Energy efficiency;Delays;Signal to noise ratio},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075155},
}

@INPROCEEDINGS{11074858,
  author={Ghiasi, Hesam Omdeh and Arjmandpour, Sina and Jang, Taekwang},
  title={A 33aFrms34pF Base Capacitance, 192fF Input Range 500kHz Sampling Frequencycapacitancetovoltage Converter using a Resonant LC Bridge},
  abstract={This paper presents a resonant LC bridge to enhance the performance of the capacitancetovoltage converterCVCby leveraging its passive gain to improve resolution and power consumptionThe proposed CVC achieves $1.56 \text{mV} / \text{fF}$ gain $33.1 \text{aF}_{\text{rms}}$ resolution at 500 kHz sampling rate while consuming $2.85 \mu \mathrm{W}$ with 3.4 pF base capacitanceequivalent to $3.24 \text{fJ} /$ conversionstep WaldenFoMFoMwand 179.12 dB Schreier FoMFoMs},
  keywords={Bridge circuits;Resonant frequency;Very large scale integration;Capacitance;Frequency conversion;Gain},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074858},
}
