@INPROCEEDINGS{11075140,
  author={Youn, Woongro and Youn, Donghyun and Seong, Hoyong and Ha, Sohmyung and Je, Minkyu},
  title={A Temperature-Insensitive Period-Modulation CDC with DLL-Based Comparator Delay Compensation Achieving 53.5ppm/°C without Calibration},
  abstract={This paper presents a temperature-insensitive period-modulation (PM) capacitance-to-digital converter (CDC) with a delay-locked-loop (DLL) based compensation alleviating temperature-dependent comparator delays. Moreover, a half-period alternate-sampling technique is proposed to track the comparator offset and mitigate its variation in a swing-boosted front-end. Our 180nm CMOS prototype achieves 53.5ppm/°C output variation over -40 to 85°C without any calibration or external clock. The conversion achieves the best $\text{FoM}_{\mathrm{w}}$ of 6.0pJ/conv.step among temperature-insensitive PM CDCs.},
  keywords={Prototypes;Very large scale integration;Capacitance;Delays;Calibration;Clocks},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075140},
}

@INPROCEEDINGS{11075036,
  author={Qiu, Siyuan and Song, Xiaoyi and Song, Xiangjie and Zhou, Changchun and Song, Xiaoyan and Yang, Jie and Wang, Wenjin and Yang, Yuchao and Jiao, Hailong},
  title={PANDA: A 3.178 TOPS/W Reconfigurable Seizure Prediction ANd Detection Neural Network Accelerator for Epilepsy Monitoring},
  abstract={PANDA, a reconfigurable seizure prediction and detection neural network accelerator, is presented. A lightweight twostage seizure monitoring framework with temporal neural network splitting is proposed to be deployed on PANDA. Channel first-output stationary dataflow with zero activation skipping and weight cache with statistical information are employed for higher energy efficiency. A flexible instruction set is defined to make PANDA highly configurable. For seizure monitoring, PANDA achieves up to 99% sensitivity, 0.43/h false alarm rate (FAR), and 3.178 TOPS/W energy efficiency.},
  keywords={Sensitivity;Instruction sets;Neural networks;Epilepsy;Very large scale integration;Energy efficiency;Monitoring},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075036},
}

@INPROCEEDINGS{11074961,
  author={Huang, Xiaohua and Yassin, Hoda and Alcazar, Beatriz Lafuente and Akhoundi, Arash and Muratore, Dante G.},
  title={A Closed-Loop Neuromodulation Chipset with 0.0009\text{mm}^{2}-0.36 \mu \mathrm{W}/\text{Ch}$ Recording Frontend and ${0.075} \mathrm{m m}^{\mathrm{2}}-\mathrm{6.76}{\mu}\mathrm{W}$ Seizure Classification Backend},
  abstract={This work presents a closed-loop neuromodulation chipset, integrating 64 analog frontends (AFEs) featuring a novel IDAC-embedded OTA, a lightweight feature extraction unit, a Sparse Projection Oblique Randomer Forest (SPORF) classifier, and 4 high-voltage (HV) compliant current stimulators. Each AFE occupies $0.0009 \text{mm}^{2}$ and consumes $0.36 \mu \mathrm{W}$, the smallest area and lowest power reported to date for ECoG recording ($\text{BW} \leq 1 \text{kHz}$). Verified with CHB-MIT [1] and ETHZ [2] databases, the digital backend (DBE) occupies $0.075 \text{mm}^{2}$, consumes $6.76 \mu \mathrm{W}$ and achieves event-based sensitivity and specificity of $94.93 \% / 98.58 \%$ and $99.55 \% / 99.97 \%$, respectively, in patient-specific scenarios.},
  keywords={Event detection;Databases;High-voltage techniques;Forestry;Very large scale integration;Sensitivity and specificity;Feature extraction;Recording;Neuromodulation},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074961},
}

@INPROCEEDINGS{11074982,
  author={Lukito, Vincent and Choi, Edward and Lee, Seoyoung and Koo, Jimin and Chang, Ik-Joon and Ha, Sohmyung and Je, Minkyu},
  title={A No-Patient-Data Seizure Classifier Soc for Real-Time Classification of Seven Seizure Types Using Feature Fusion and Near-Memory Computing},
  abstract={The proposed multi-seizure-type classifier (MSTC) SoC is the first on-chip classification of multiple seizure types, integrating frequency-based feature fusion (FF) and digital ternary near memory computing (NMC) to achieve a classification accuracy of 91.63 % with $24.72 \mu ~\mathrm{s}$ computational latency. The MSTC SoC is also the first true zero-shot seizure detection system requiring no patient data for retraining, achieving 93.07 % sensitivity and 94.23 % specificity.},
  keywords={Sensitivity;Accuracy;Very large scale integration;Real-time systems;System-on-chip},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074982},
}

@INPROCEEDINGS{11075022,
  author={Alex, Daney and Yadav, Amitabh and Joo, Jieun and Shin, Uisub and Afzal, Arshia and Liu, Jinhan and Diehl, Geoffrey and Widge, Alik S. and Shoaran, Mahsa},
  title={A 32-Channel 196-$\boldsymbol{\mu} \mathbf{W}$ Logarithmic SoC for Brain Network Connectivity Extraction and Adaptive Psychiatric Symptom Classification},
  abstract={This paper presents a 32-channel brain-computer interface SoC for closed-loop deep-brain stimulation in psychiatric disorders. The SoC integrates a 32-channel analog front-end, an efficient logarithmic feature extraction engine, a neural additive model classifier with online update, and a multimode stimulation controller. Fabricated in 65 nm CMOS, the $5.46 ~\text{mm}^{2}$ SoC consumes $6.14 \mu ~\mathrm{W} /$ channel, enabling accurate, low-power, and adaptive detection of psychiatric states.},
  keywords={Semiconductor device modeling;Adaptation models;Additives;Adaptive systems;Accuracy;Very large scale integration;Feature extraction;Brain modeling;Brain-computer interfaces;Engines},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075022},
}

@INPROCEEDINGS{11075019,
  author={Shin, Sangmin and Sin, Jaehyung and Lee, Jisoo and Kwon, Gyutae and Lee, Sangseok and Lee, Kun Jae and Ki, Sewon and An, Hyojoon and Kim, Mijoung and Bang, Hoonjin and Jung, Jonghoon and Baek, Sanghoon},
  title={A 2Nm Gate-All-Around 128Kb Anti-Fuse One-Time Programmable Memory Featuring Dynamic Bit-Line and Sense-Amplifier Offset Cancellation},
  abstract={Decreasing read sensing margin in non-volatile memory (NVM) has become a major challenge in the advanced nodes due to the device down-scaling, lower VDD, and higher gate leakage. We propose a dynamic bit-line (BL) and sense amplifier (SA) offset cancellation read scheme for an anti-fuse one-time programmable (OTP) memory with canceling both offset simultaneously to increase read sensing margin. We fabricated a CMOS logic-compatible 2 nm gate-all-around (GAA) process, 128 Kb anti-fuse OTP for the first time and is silicon-proved with 100 % yield.},
  keywords={Nonvolatile memory;Gallium arsenide;Very large scale integration;Logic gates;Sensors;Gate leakage},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075019},
}

@INPROCEEDINGS{11075045,
  author={Chen, Z and Sanne, A and Ma, R and Chang, Y-F and Hutchins, S A and Hasan, M M and Kulkarni, S H and Karl, E A},
  title={GAA Backside-Power eFuse with 0.72um2 Bitcell, 1.59V Field Program, On-Demand Read and 1.8V Standby},
  abstract={A 4Kb eFuse IP featuring the smallest 0.72um2 bit cell is presented in the first Gate All Around (GAA) and backside power delivery 18A class process. A low leakage integrated power switch is developed to support an always-ON 1.8V rail with power sequence independent nominal and 1.8V rails. The IP enables 1.59V charge-pump-free in-field programming and 0.58V 1e9 cycles for on-demand read from −40°C to 125°C with a raw bit fail rate <3 DPM (defect per million), achieving 100% post-repair die yield with up to one billion bits per die.},
  keywords={Rails;Gallium arsenide;Stacking;Voltage;Switches;Programming;Very large scale integration;IP networks;Tuning;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075045},
}

@INPROCEEDINGS{11074954,
  author={Park, Kyeonghwan and Jeong, Jichull and Park, Seung-Jin and Lee, Doobock and Lee, Seunghoon and Kang, Soonku and Kang, Youngmin and Ko, Soomin and Kim, Yongjin and Boo, Jun-Ho and Lee, Mingyu and Lee, Eunsang and Cha, Geoeun and Kim, Youngmin and Lee, Jisun and Kang, Seungwan and Cho, Inbok and Lee, Minjae and Kim, Yongmin and Go, Seol-Jun and Jung, Moon-Ki and Kim, Kisung and Lee, Eung Suk and Jo, Youngmin and Park, Jung-June and Yoon, Chiweon and Kwak, Myoungbo and Oh, Hwaseok and Won, Soonjae},
  title={A 4.2 Gb/S $5^{\text {th }}$ Generation F-Chip of Toggle 5.1 Specification With All-Path Speed Boosting Scheme and Sca Protocol for High Density Nand Flash Applications},
  abstract={This paper introduces a $4.2 ~\text{Gb} / \mathrm{s} 5^{\text {th }}$ generation F-chip operating at a 1.1 V supply voltage. To achieve high-speed performance even in high-capacity memory packages, a speed boosting scheme is proposed to ensure optimal write and read performance. This scheme includes technologies for correcting the duty cycle, offset and skew of DQ and DQS signals. To mitigate leakage in the devices, a power gating technique with whole of chip is also introduced. Also, a SCA converter design is presented to overcome command speed bottlenecks for improvement of I/O efficiency. This proposed work achieves a 37 % reduction in energy/bit, with a 1.4 x speed improvement, and a 92 % reduction in standby current through power gating.},
  keywords={Performance evaluation;Protocols;Voltage;Very large scale integration;Boosting;Capacitance;Timing;Flash memories;buffer chip;speed boosting scheme;power gating;SCA protocol;high-density NAND flash},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074954},
}

@INPROCEEDINGS{11075037,
  author={Santo, Kohei and Nakayama, Masayoshi and Mochida, Reiji and Suwa, Hitoshi and Tamura, Motoki and Mangyo, Atsuo and Nii, Koji and Lin, Yu-Cheng and Wang, C.F. and Tsai, Wu-Chin and Chih, Y.D. and Chang, Tsung-Yung Jonathan},
  title={A Prototype 16Mbit RRAM on 55nm BCD with 56% Compact-Area Wordline Driver and Constant Write-Current Scheme for Automotive 150°C Operation},
  abstract={A prototype 16Mbit embedded RRAM macro is implemented on 55nm BCD technology targeting automotive applications. This macro implements a compact wordline driver (WLDRV) circuit using thin oxide 1.2V core MOSs and thick oxide 5V MOS devices reducing area without speed penalty. To support automotive 150°C operation, it also uses master and local current limiters and local write drivers with wide-range temperature compensation. It realizes constant cell current anywhere on a die and stable operation at 150° C. The macro density is 2.56Mbit/mm2 and operation at 150°C with 1K endurance has been achieved.},
  keywords={Automotive applications;Prototypes;Very large scale integration;Current limiters;MOS devices;Driver circuits;RRAM;Automotive;WLDRV;Current limiter},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075037},
}

@INPROCEEDINGS{11074835,
  author={Chang, Jeongtaek and Lee, Jungho and Shen, Yi and Yun, Sangbu and Zhang, Qirui and Sylvester, Dennis and Kim, Hun-Seok and Blaauw, David},
  title={A 0.71nJ, 1.53GS/s Throughput 256-FFT Using Floating Point Analog Computation},
  abstract={We propose a 256-point FFT engine using the first analog floating point implementation. The proposed method encodes the mantissa value with both voltage and pulse width and a digital 4-bit exponent. It features automatic calibration to cancel process variation and attains precision and dynamic range equivalent to 12.3 bit digital fixed point. Implemented in 22 nm CMOS, the chip demonstrates the first reported sub-nJ energy/FFT (0.71 nJ) at a high throughput of $1.53 \text{GS} / \mathrm{s}$.},
  keywords={Voltage;Very large scale integration;Dynamic range;Throughput;Calibration;Engines},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074835},
}

@INPROCEEDINGS{11075164,
  author={Bejarano-Carbó, Andrea and Tseng, Chien-Wei and Komma, Demba and Abillama, Pierre and Fan, Zichen and Sylvester, Dennis and Kim, Hun-Seok and Blaauw, David},
  title={An OFDMA Baseband Processor Enabling $165\mu \mathrm{W}$ Long-Range IoT Localization},
  abstract={We present an OFDMA baseband localization processor fabricated in 22nm, co-designed with a low-power, crystal-less narrowband RF receiver chip that efficiently estimates the channel frequency response in real-time for localization. The localization processor consumes 1.52/2.04mW for 2/3D localization processing, and duty-cycles the RF receiver achieving 247nW standby power. The combined system achieves a localization distance of 430m, a 4.3× improvement over state-of-the-art, while maintaining comparable accuracy. We deploy this system in a $1\times 2.8$ cm IoT localization tag with $165\mu \mathrm{W}$ average power at 0.1 Hz location acquisition rate.},
  keywords={Location awareness;Radio frequency;Baseband;Accuracy;Channel estimation;Receivers;Very large scale integration;Real-time systems;Frequency response;Narrowband},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075164},
}

@INPROCEEDINGS{11075179,
  author={Lu, Jiahao and Liu, Dongsheng and Zhang, Jiaming and Huang, Tianze and Li, Kai and Wu, Cheng and Chen, Lei and Hu, Ang and Luo, Zhixiang and Zou, Xuecheng},
  title={A 28nm 84.9KOPS 1.82µJ/op RISC-V Crypto-SoC with Primitive-Based Deep-Coupling Unified Post-Quantum Engine},
  abstract={This paper presents the first RISC-V cryptographic System-on-Chip (SoC) that supports the latest NIST-released Federal Information Processing Standards (FIPS) for post-quantum cryptographic (PQC). It has three key features: 1) RV-dedicated deep-coupling post-quantum engine with dual-rail parallel scheduling. 2) Vectorized instruction-driven computational workflow. 3) Primitive-based fine-grained operator design for multi-scheme reconstruction. The proposed crypto-SoC achieves a throughput of 84.9KOPS and an energy efficiency of 1.82µJ/op in 28nm, demonstrating 1.22-5.84x and 2.41-4.68x improvements in throughput and energy efficiency, respectively, compared to the state-of-the-art design.},
  keywords={Processor scheduling;Information processing;Very large scale integration;Throughput;Energy efficiency;System-on-chip;Cryptography;Engines;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075179},
}

@INPROCEEDINGS{11074811,
  author={Chiou, Bo-Cheng and Lin, Chih-Sheng and Ho, Yun-Ting and Lin, Yu-Hui and Wu, I-Ta and Tseng, Kuo-Hua and Lai, Chih-Ming and Mei, Peng-I and Li, Sih-Han and Chang, Shan-Ming and Sheu, Shyh-Shyuan and Lo, Wei-Chung and Chang, Shih-Chieh and Hou, Tuo-Hung},
  title={Enabling Privacy-Preserving Collective Intelligence: A Twin In-Memory Encryption/Processing Macro Featuring Group Differential Privacy and Spatial-Temporal Ensemble},
  abstract={Privacy protection is a critical concern in AI, particularly in collective AI systems such as AIoT networks and federated learning. To address correlation attacks involving multiple data sources, this study presents a 22 nm twin in-memory encryption/processing (TIME) macro that integrates group differential privacy (GDP) and spatial/temporal ensemble (STE) techniques. This design enables efficient privacy protection while maintaining high accuracy, achieving 82% prediction accuracy for federated vital signs monitoring at a privacy protection strength of 2.3. With a 1Mb capacity, the system delivers a 10.49 TOPS throughput and achieves an energy efficiency of 5827 TOPS/W, highlighting its strong potential for privacy-preserving collective AI applications.},
  keywords={Privacy;Accuracy;Correlation;Economic indicators;Gaussian noise;Very large scale integration;Energy efficiency;Protection;Artificial intelligence;Monitoring},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074811},
}

@INPROCEEDINGS{11075224,
  author={Rivero-Cortazar, Aitor and Aymerich, Joan and Shaikh, Sohail Faizan and Lodi, Andrea and Raducanu, Bogdan and Gielen, Georges and Lopez, Carolina Mora},
  title={An Active Silicon Perforated Mea for Seamless 3D Organoid Interfacing with Low-Noise, Scalable Multimodal Electrophysiology},
  abstract={We present the first active silicon perforated MEA for 3D organoid interfacing, integrating CMOS electronics for lownoise, high-resolution recording, stimulation, and impedance spectroscopy (EIS) across 7 modalities. The MEA, fabricated in 130 nm CMOS technology, features a scalable 256 -island mesh with multiplexed operation, achieving low input-referred noise ($9.1 \pm 1.5 \mu \mathrm{V}_{\text {rms }}, 300 \text{Hz}-10 \text{kHz}$) and low power ($11.3 \mu \mathrm{W}$ per island). In vitro tests with cardiomyocytes demonstrate accurate recordings, network propagation mapping, and intracellular recordings via voltage stimulation. This perforated MEA offers unparalleled functionality and scalability for advancing organ-on-chip research.},
  keywords={Multiplexing;Spectroscopy;Three-dimensional displays;Organoids;Scalability;Noise;Voltage;Very large scale integration;Silicon;Recording},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075224},
}

@INPROCEEDINGS{11075123,
  author={Lee, Sanghoon and Yoon, Junghyun and Jeon, Taejune and Ahn, Danbi and Yun, Soohyun and Kim, Hee Young and Bae, Joonsung and Chae, Youngcheol},
  title={A 10kHz-BW, 86.7dB-SNDR, 176.8dB-FoM, LNA-Embedded CT $\mathbf{\Delta}\mathbf{\Sigma}$ ADC for Closed-Loop Neural Recording},
  abstract={This paper presents an LNA-embedded CT $\Delta\Sigma$ ADC for closed-loop neural recording. The frontend LNA is embedded in the loop filter of $\Delta\Sigma$ ADC to achieve low input-referred noise (IRN) and high tolerance to stimulation artifacts. A 25-level feedback RDAC is realized with a 12-tap tri-level FIR-DAC and helps to linearize the LNA, resulting in high linearity over a wide input range. The FIR-DAC's delay is compensated by a novel feedforward compensation scheme to maintain loop stability. The DC-coupled LNA is chopped at a low frequency (~100kHz) and provides high input impedance, low offset, and low $1/f$ noise without suffering from chopper artifacts. Implemented in a 65nm CMOS process, the ADC achieves an IRN of 62.5nV/√Hz, 86.7dB SNDR, 87.5dB DR, and 97.9dB SFDR, while consuming only $11.8\mu \mathrm{W}$ in a 10kHz bandwidth. This corresponds to the state-of-the-art FoM of 176.8dB.},
  keywords={Linearity;Bandwidth;Very large scale integration;Choppers (circuits);CMOS process;Recording;Delays;Circuit stability;1/f noise;Impedance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075123},
}

@INPROCEEDINGS{11075121,
  author={Wang, Wei and Su, Yumin and Zou, Yiwei and Liao, Huan-Cheng and Chang, Yonghee and Yang, Kaiyuan},
  title={38kbps Multi-Access Magnetoelectric Backscatter Communication with Non-Interrupted WPT for a Network of Miniature Wireless Bio-Implants},
  abstract={This paper presents a time division multi-access (TDMA) magnetoelectric (ME) backscatter communication scheme exploiting the 2nd resonant frequency of the ME transducer, achieving 1) simultaneous ME uplink and wireless power transfer (WPT) with 38kbps data rate and 0.57nJ/bit energy, doubling the data rate compared to existing ME uplink schemes; 2) A WPT self-interference canceller (SIC), along with an “8” shaped RX coil, reducing interference between TX and RX by 70 dB, assisting backscatter uplink with 7E-6 BER.},
  keywords={Wireless communication;Time division multiple access;Interference cancellation;Transducers;Magnetoelectric effects;Magnetic resonance;Wireless power transfer;Very large scale integration;Uplink;Backscatter},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075121},
}

@INPROCEEDINGS{11075058,
  author={Kustin, John and Kang, Taewook and Song, Seungheun and Naveed, Yahya and Flynn, Michael P.},
  title={128-Channel Multi-Chip Acoustic Hologram Generator},
  abstract={An ASIC combines a numerically controlled oscillator with reconfigurable amplitude and phase control of 16 channels to synthesize acoustic holograms with a phased array of ultrasonic transmitters. Multiple chiplets operate synchronously to drive arbitrarily many channels. A scalable digital delay line technique, leveraging on-chip SRAM and single-bit noise-shaped bitstreams, realizes area-efficient, high-density, and high-resolution true-time-delay phase shifts. The prototype system employs 8 chiplets to drive a 128-element array for hologram generation.},
  keywords={Phased arrays;Transmitters;Chiplets;Random access memory;Prototypes;Phase control;Very large scale integration;Acoustic arrays;Acoustics;System-on-chip},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075058},
}

@INPROCEEDINGS{11074831,
  author={Rossoni, M. and Moleri, R. and Rizzini, D. Lodi and Salvi, P. and Gallucci, S. and Castoro, G. and Tesolin, F. and Lacaita, A. L. and Dartizio, S. M. and Levantino, S.},
  title={A Fractional-N Digital-PLL Based on a Power-Gated Ring-Oscillator and a Frequency-Stabilizing Loop Achieving 74fs Jitter Under $3 \text{mV}_{\text{pp}}$ Supply Ripple},
  abstract={A 10 GHz fractional-N digital PLL with a power-gated ring-oscillator (PGRO) to reduce digital-to-time converter (DTC) range and a PGRO-frequency-stabilizing loop to mitigate supply sensitivity is presented. The PLL achieves 74 fs and 81 fs rms jitter, when a $3 \text{mV}_{\text{pp}}$ sinusoid and a $2.5 \text{mV}_{\text{rms}}$ white noise are superimposed to the PGRO supply, respectively.},
  keywords={Frequency locked loops;Sensitivity;Very large scale integration;Jitter;White noise;Phase locked loops},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074831},
}

@INPROCEEDINGS{11075214,
  author={Fagotti, D. and Dartizio, S. M. and Tesolin, F. and Moleri, R. and Trotta, G. R. and Rossoni, M. and Gallucci, S. and Salvi, P. and Castoro, G. and Rizzini, D. Lodi and Lacaita, A. L. and Levantino, S.},
  title={A 58.9fs-Jitter Fractional-N Digital PLL Using a Double-Edge Variable-Slope DTC},
  abstract={This work presents a fractional-N digital PLL achieving low-jitter by leveraging the combination of a XOR frequencydoubler and a power-efficient double-edge variable-slope digital-to-time converter (DTC). The prototype demonstrates 58.9fs jitter and -61.8 dBc fractional spur at 9.25 GHz, with 18.3 mW power and 125 MHz input reference frequency.},
  keywords={Prototypes;Very large scale integration;Jitter;Frequency conversion;Phase locked loops},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075214},
}

@INPROCEEDINGS{11075194,
  author={Huang, Zhiqiang and Kong, Shuangfeng and Chen, Fengjun},
  title={A 6.4GHz Fractional-N PLL with 96.6fsrms Jitter and -257.4dB FoM},
  abstract={This paper presents a 6.4GHz DTC-based fractional-N sampling PLL with 96.6 fsrms jitter -65dBc fractional spurs and -257.4dB FoM. A gated-LMS-based calibration technique is used for both DTC gain and nonlinearity background calibration, eliminating the need for an auxiliary DTC to reduce power consumption and minimize calibration errors. Additionally, an SPD is designed to double the sign-comparison accuracy, further reducing calibration errors in DTC calibration.},
  keywords={Power demand;Accuracy;Very large scale integration;Jitter;Logic gates;Calibration;Phase locked loops;Fractional N;PLL;DTC;nonlinearity calibration;gain calibration;DSM},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075194},
}

@INPROCEEDINGS{11075118,
  author={Jung, Jaehong and Lee, Eunseok and Han, Donghyeon and Wang, Jinchen and Chandrakasan, Anantha P. and Han, Ruonan},
  title={A 55.8-to-64.2GHz, $58.3\text{fs}_{\text{rms}}$ -Jitter, $-250.2\text{dB-FoM}_{\mathrm{J}}$ Fractional-N Cascaded PLL in 28nm CMOS},
  abstract={We present a V-band fractional-N cascaded PLL achieving the integrated jitter of $58.3\text{fs}_{\text{rms}}$ and $\text{FoM}_{\mathrm{J}}$ of-250.2dB. A fully differential voltage domain quantization (Q)-noise cancellation of the 1st-stage reference sampling PLL suppresses the Q-noise of the delta-sigma modulator $(\Delta\Sigma \mathrm{M})$ with <0.92LSB INL and <0.08mV resolution while only consuming 0.62mW. The 2nd-stage sub-sampling PLL features a 0.82mW switched capacitor frequency-to-voltage converter-based FLL, addressing a harmonic lock issue without a power-hungry mmWave frequency divider. Its frequency re-acquisition time is within $0.42\mu \mathrm{s}$.},
  keywords={Time-frequency analysis;Frequency modulation;Quantization (signal);Voltage;Switches;Very large scale integration;Power system harmonics;Frequency conversion;Phase locked loops;Millimeter wave communication},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075118},
}

@INPROCEEDINGS{11075089,
  author={Shi, Jiahao and Mu, Xuchu and Ma, Qiaobo and Jiang, Yang and Martins, Rui and Mak, Pui-In},
  title={A 9.1mW All-5V-CMOS Series-Capacitor AC-DC Converter with CF Reallocation Operations for 85-230VRMS Mains Achieving 85.6% Efficiency at 858mW/cm3 Density},
  abstract={This work presents an efficient switched-capacitor (SC) AC-DC converter for IoT systems powered by mains in $120 V_{\text{RMS}}/230 V_{\text{RMS}}$ standards. To eliminate using high-voltage (HV) silicon devices to preserve conversion efficiency and reduce cost, we propose a series-capacitor single-stage AC-DC structure with a fine-grained SC pre-regulation network and active source detaching function, which achieves rectifier conduction loss reduction, output conduction duty extension, and output ripple reduction. At the same, the pre-regulation flying capacitors $(C_{\mathrm{F}})$ can be reallocated to be in parallel to $C_{\text{OUT}}$ dynamically according to load conditions, further improving the output ripple and enhancing total capacitance utilization. Fabricated in a 180-nm process using all 5-V CMOS transistors, the converter supplies an output $(V_{\text{OUT}})$ of 2.6~5V from an $85\sim 230V_{\text{RMS}}$ input $(V_{\text{IN}})$. It outputs a maximum power of 9.11mW with 85.6% efficiency and $858\text{mW}/\text{cm}^{3}$ overall system power density.},
  keywords={Silicon devices;Power system measurements;Density measurement;Rectifiers;Switches;High-voltage techniques;Very large scale integration;Transistors;Standards;Periodic structures},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075089},
}

@INPROCEEDINGS{11074872,
  author={Ji, Yichao and Cheng, Lin},
  title={A 16-24V to 1-1.8V 1.187W/mm3-Power-Density Hybrid DC-DC Converter Featuring Inductor Current in $\Sigma$-Fibonacci Region for Unmanned Aerial Vehicle Applications},
  abstract={This paper presents a $16-24 ~\mathrm{V}$-input $1-1.8 ~\mathrm{V}$-output $3 / 2$-phase hybrid DC-DC converter for powering point-of-load systems in unmanned aerial vehicles. The converter minimizes inductor DC resistance and AC resistance losses by reducing inductor current into the $\Sigma$-Fibonacci region, enabling the use of a compact inductor. This region corresponds to the minimum achievable inductor current with flying capacitors fully utilized. Fabricated in a $0.18 \mu ~\mathrm{m}$ BCD process, the converter achieves a 93.9 % peak efficiency and a $1.187 ~\mathrm{W} / \text{mm}^{3}$ power density.},
  keywords={Resistance;Power system measurements;Density measurement;Capacitors;DC-DC power converters;Very large scale integration;Autonomous aerial vehicles;Inductors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074872},
}

@INPROCEEDINGS{11074992,
  author={Lee, Seung-Ju and Jeong, Yeon-Woo and Kim, Jong-Hun and Cho, Mun-Jung and Kim, Min-Sik and Kim, Myeong-Ho and Shin, Se-Un},
  title={A 94.1%-Efficiency Flying-Capacitor-Shared 2-Inductor 3-Level Boost Converter with Simultaneous VCF and IL Balance Achieving <0.92%-VCF and <0.22%-IL Error},
  abstract={In this paper, a flying-capacitor-shared 2-inductor 3-level boost converter ($C_{\mathrm{F}}-2 ~\mathrm{L} 3 \text{LV}$) is presented. A unified imbalance calibration technique (UICT) is proposed to achieve $V_{\text {CF }}$ and $I_{\mathrm{L}}$ balance, simultaneously. The $C_{\mathrm{F}}$-2L3LV with UICT features a wide operating range that are not constrained by duty-cycle ($D$) and conversion ratio (CR) limitations, while maintaining the voltage stress on all switches at $0.5 V_{\text {o. }}$ The test chip, fabricated using a 180 nm CMOS process, achieves simultaneous $V_{\text{CF}}$ and $I_{\mathrm{L}}$ balancing with balancing errors of less than 0.92% and 0.22%, respectively, under a 0.2Ω resistance mismatch. A peak efficiency was measured at 94.1%.},
  keywords={Resistance;Semiconductor device measurement;Very large scale integration;CMOS process;Calibration;Electrical resistance measurement;Stress},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074992},
}

@INPROCEEDINGS{11075046,
  author={Yang, Yunzhe and Peng, Wenyu and Huang, Mo and Du, Sijun},
  title={Matryoshka CSCR: A Reconfigurable Matryoshka-Stacked Continuous-Scalable-Conversion-Ratio Switched-Capacitor DC-DC Converter with 0.1-to-1.7V Input},
  abstract={This paper presents a reconfigurable continuous-scalable-conversion-ratio (CSCR) switched-capacitor DC-DC boost converter, named Matryoshka CSCR converter, for energy harvesting (EH) applications. With 6 split-input CSCR cores adaptively stacked like Matryoshka dolls, the structure significantly extends the voltage conversion ratio (VCR) range with small M and N numbers. The chip was fabricated in a 180nm process. It covers 0.1-1.7 V input for a 1.8-V output and achieves 88.6% peak efficiency and 23.8mW peak power.},
  keywords={Voltage;Switches;DC-DC power converters;Very large scale integration;Energy harvesting;Video recording;Switching circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075046},
}

@INPROCEEDINGS{11074800,
  author={Ota, Y. and Sekine, H. and Morimoto, K. and Endo, W. and Sasago, T. and Abdelghafar, A. and Mikajiri, S. and Isoda, N. and Kobayashi, D. and Shinohara, M. and Mikami, K. and Inoue, K. and Yasui, H. and Tojima, K. and Niwa, M. and Omodani, S. and Chida, K. and Uehira, K. and Itano, T. and Inui, F. and Iwata, J. and Ohmura, M. and Matsuno, Y. and Sakurai, K. and Ichikawa, T.},
  title={2/3-Inch 2.1Megapixel Spad Image Sensor with 156dB Single-Shot Dynamic Range and Led Flicker Mitigation Based on Weighted Photon Counting Technique},
  abstract={We present a 2/3-inch 2.1Mpixel 3D backside-illuminated SPAD image sensor for automotive applications. Newly proposed pixel architecture based on weighted photon counting technique achieves 156dB single-shot dynamic range with LED flicker mitigation. Read noise-free operation with seamless global shutter ensures robust image capture of distant targets under 0.1lux lighting conditions. Intra-frame nondestructive readout enables acquisition of short exposure frames with reduced motion blur, in parallel with long exposure frame acquisition.},
  keywords={Image sensors;Fluctuations;Three-dimensional displays;Prevention and mitigation;Lighting;Very large scale integration;Dynamic range;Light emitting diodes;Single-photon avalanche diodes;Photonics},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074800},
}

@INPROCEEDINGS{11075078,
  author={Yui, Tatsuya and Hanzawa, Katsuhiko and Hosoya, Masahiro and Liu, Yuqing and Yasufuku, Tadashi and Tanaka, Yoshinori and Tashiro, Yoshiaki and Tumewu, Albert and Yamane, Masataka and Shibata, Masatoshi and Sakada, Toshiki and Akatsuka, Kazuhisa and Matsushita, Yudai and Yamada, Koki and Mori, Kouji and Toyoshima, Takahiro and Sakano, Yorito and Kumagai, Oichi and Tsunoji, Kenichi and Takahashi, Masayuki},
  title={A 25M Points/s Back-Illuminated Stacked SPAD Direct Time-of-Flight Depth Sensor with Equivalent Time Sampling for Automotive LiDAR},
  abstract={This paper presents technologies at Single Photon Avalanche Diode (SPAD) direct Time-of-flight (ToF) depth sensor and Light Detection and Ranging (LiDAR). Method of readout by under-pixel differential comparator and the threshold control can select either to prioritize distance accuracy or acquisition of reflectance information. The equivalent time sampling (ETS) at 3 GHz improves depth accuracy. Furthermore, subsequent 250MHz re-sampling and the depth information extraction pipeline relaxes the operation frequency maintaining the depth accuracy and approximately 98% data size reduction. Sensor delivers distance measurement for 520 effective macro pixels with 0.05° vertical angular resolution at 120° horizontal Field of View (FoV) and 20fps, resulting in 25M points/s (pts/s) ranging data and detection of 25cm object at 250m.},
  keywords={Reflectivity;Laser radar;Accuracy;Three-dimensional displays;Pipelines;Very large scale integration;Information retrieval;Distance measurement;Single-photon avalanche diodes;Automotive engineering;LiDAR;3D ranging systems;Direct ToF;SPAD;Point rate;Automotive},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075078},
}

@INPROCEEDINGS{11075180,
  author={Cheng, Quan and Li, Qiufeng and Yang, Zhengke and Kong, Zhen and Niu, Gaoqiang and Liang, Yuan and Li, Jiamin and Park, Jeong Hoan and Liao, Wang and Awano, Hiromitsu and Sato, Takashi and Lin, Longyang and Hashimoto, Masanori},
  title={A Radiation-Hardened Neuromorphic Imager with Self-Healing Spiking Pixels and Unified Spiking Neural Network for Space Robotics},
  abstract={A radiation-hardened neuromorphic imager prototype is developed for space exploration, featuring a fully spike-based neuromorphic vision system architecture, in-pixel self-healing against radiation-induced damage, and integrated unified spiking neural network (USNN) with adaptive neurons and synapses and contrast enhancement at low-contrast conditions. Self-healing reduces dark current by 6.25× at 14kGy cumulative dose, recovering recognition accuracy by 27.8%. USNN consumes 0.0529 pj/SOP at 5,000 events/s.},
  keywords={Neuromorphics;Machine vision;Neurons;Systems architecture;Prototypes;Spiking neural networks;Dark current;Space exploration;Synapses;Robots},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075180},
}

@INPROCEEDINGS{11074998,
  author={Duarte, David and Li, You and Ayers, James},
  title={A 320μm2 Minimum Guard-Band Metal Resistor-Based Temperature Sensor with +/-1.4°C Inaccuracy in 18A RibbonFet CMOS with PowerVia},
  abstract={A temperature sensor with a $320 \mu \mathrm{m}^{2}$ metal resistor-based sensing element is implemented in 18A RibbonFET CMOS with back side power delivery (or PowerVia). The design supports remote sensing at any location along the metal stack, which minimizes guard bands by enabling hot-spot to sensing element distances that are $<10 \text{um}$. The 20.5us conversion time supports sensing at multiple locations within a 1ms window. The design achieves $+/-1.4^{\circ} \mathrm{C}$ inaccuracy, which is the lowest among resistor-based sensors in sub-22nm nodes.},
  keywords={Temperature sensors;Metals;Very large scale integration;CMOS technology;Sensors;Remote sensing},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074998},
}

@INPROCEEDINGS{11074823,
  author={Yamazaki, Yudai and Park, Sunghwan and Uchino, Takaya and Liu, Chenxin and Sakamaki, Jun and Morishita, Yohei and Egami, Akihiro and Hasaba, Ryosuke and Takahashi, Ken and Abe, Tomoki and Murata, Tomohiro and Nakagawa, Yoichi and Tomura, Takashi and Taneda, Hiroshi and Murayama, Kei and Tsukahara, Makoto and Ota, Hiroko and Nakabayashi, Yoko and Wang, Chun and Herdian, Hans and Zhang, Yi and Li, Zheng and Wang, Wenqian and Huang, Hongye and Xu, Dingxin and Kato, Sena and Ide, Michihiro and Zhang, Yuncheng and Sakai, Hiroyuki and Kunihiro, Kazuaki and Shirane, Atsushi and Takinami, Koji and Okada, Kenichi},
  title={A 150 GHz High-Power-Density Phased-Array Transceiver in 65nm CMOS for 6G UE Module},
  abstract={This paper proposes a high-power-density 150 GHz phased-array transceiver designed for 6G user equipment (UE) modules, utilizing $65-\text{nm}$ CMOS technology. An 8 -element AiP module using two transceiver ICs operates in the 142-164 GHz frequency range, achieving an EIRP of 26 dBm and a maximum data rate of 56 Gbps. The power consumption per element is 150 mW in TX mode and 93 mW in RX mode.},
  keywords={6G mobile communication;Phased arrays;Power demand;Injection-locked oscillators;Very large scale integration;CMOS technology;Transceivers;Arrays;6G;UE;D-band;phased array transceiver;injection locking},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074823},
}

@INPROCEEDINGS{11074869,
  author={Wang, Chun and Yong, Olivia Angel and Herdian, Hans and Wang, Wenqian and Shehata, Abanob and da Gomez, Carrel and Liu, Chenxin and Yamazaki, Yudai and Kunihiro, Kazuaki and Sakai, Hiroyuki and Zhang, Yuncheng and Shirane, Atsushi and Okada, Kenichi},
  title={A 52Gb/S 8.9Dbm EIRP 300Ghz-Band Amplifier-Last Outphasing Transmitter with Path Mismatch Calibration in 65nm CMOS},
  abstract={This paper presents a 300 GHz-band amplifier-last outphasing transmitter with path mismatch calibration in 65nm CMOS. The transmitter integrates two independent sub-THz LO generation chains to calibrate the mismatch between two paths in the outphasing topology. After the calibration, the proposed transmitter achieves a minimum EIRP of 5.0dBm over a frequency range from 237GHz to 250GHz, with a maximum of 8.9dBm EIRP at 246GHz. It supports a data rate of 52Gb/s in 16QAM, with a communication distance of 9cm.},
  keywords={Transmitters;Very large scale integration;CMOS technology;Calibration;Topology;300 GHz-band;amplifier-last;outphasing transmitter;path mismatch calibration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074869},
}

@INPROCEEDINGS{11074785,
  author={Deng, Juncheng and Li, Aodi and Li, Junlin and Tao, Weichen and Yang, Shaoqi and Zhang, Zhongjun and Yang, Yuhao and Cheng, Xin and Lin, Fujiang and Staszewski, Robert Bogdan and Lou, Liheng and Hu, Yizhe},
  title={A 0.184mm2 $W$-Band Single-RTWO-Based Subharmonic RX Achieving 3.72 dB-NF and I/Q Mismatch < 0.8° in 22 nm CMOS},
  abstract={We present a $W$-band sub-harmonic IQ receiver (RX) featuring a single rotary traveling-wave oscillator (RTWO) integrated with an ADPLL. It addresses key challenges in conventional mmwave direct-conversion RXs: LO generation and distribution with poor phase noise (PN), IQ mismatch, high power consumption, large area, and high dc offset. RTWO multimodes are suppressed via asymmetric capacitance in the crossover of the Möbius ring. Fabricated in 22 nm CMOS, the RX demonstrates a 3.72 dB noise figure (NF), IQ mismatch $<0.8^{\circ}$ using a bundle-based calibration. It occupies a tiny area of $0.184 \text{mm}^{2}$ and has a total power consumption of 56.7 mW, including the ADPLL.},
  keywords={Phase noise;Noise figure;Power demand;Receivers;Very large scale integration;Capacitance;CMOS technology;Calibration;Millimeter wave communication},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074785},
}

@INPROCEEDINGS{11075138,
  author={Hassan, Youssef O. and Oveisi, Mohammad and Wang, Zisong and Heydari, Payam},
  title={A CMOS Antenna-to-Bits 230-mW 120-Gbps F-band Receiver with Analog-Domain 64QAM Detection and Extraction},
  abstract={The design and implementation of a fully integrated CMOS antenna-to-bits 100 - 140 GHz receiver (RX) realizing 64QAM demodulation in analog-domain is presented. A sequential asynchronous QAM demodulation method is proposed that allows symbol detection, recovery, and extraction at 120-Gbps data rate at remarkably low power consumption. Fabricated in a 22-nm FDSOI CMOS process, this 100-140-GHz CMOS RX exhibits a measured maximum conversion gain of 32 dB and a minimum noise figure (NF) of 9.5 dB. A data rate of 120 Gbps is wirelessly measured at 15-cm distance with the received 64QAM signal being directly demodulated on-chip at a bit-error rate (BER) of 10−2. The measured RX sensitivity at this BER is -32 dBm. The prototype occupies 2.5 × 3mm2 of die area, including PADs and test circuits and consumes a total dc power of 230 m W.},
  keywords={Sensitivity;Power demand;Quadrature amplitude modulation;Receiving antennas;Symbols;Silicon-on-insulator;Prototypes;Very large scale integration;System-on-chip;Demodulation;6G;FutureG;mm-wave;RF-64QAM;sub-THz;receiver},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075138},
}

@INPROCEEDINGS{11075000,
  author={Chen, Po-Jen and Chiou, Ren-Hao and Yang, Chia-Hsiang},
  title={A 142Mw 6.4Gbps Massive MU-MIMO RSMA Detector for Next-Generation Communication Systems},
  abstract={This work presents the first rate-splitting multiple access (RSMA) detector for massive multiuser multi-input, multioutput (MU-MIMO) systems. The proposed detector supports $256 \times 32$ MIMO configuration with up to 256-QAM modulation. A polar decoder with a code length of 128 bits is included for error correction. The iterative detection architecture reduces the latency by 98 %. The chip achieves a maximal throughput of 6.4 Gbps with 142 mW power at 200 MHz. Compared to the state-of-the-art space-division multiple access (SDMA) detectors, this work achieves 3.3 -to- $3.6 \times$ higher throughput and 2.0 -to- $4.5 \times$ higher energy efficiency, in addition to the better error performance in correlated channels.},
  keywords={Modulation;Detectors;Very large scale integration;Throughput;Energy efficiency;Error correction codes;Multiaccess communication;Iterative methods;Next generation networking;Iterative decoding},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075000},
}

@INPROCEEDINGS{11075198,
  author={Lu, Cheng-Hsun and Tang, Wei and Zhang, Zhengya},
  title={A 6.2mm2 56.6Gbps 18.2pJ/b oFEC Decoder for Optical Communications},
  abstract={A complete 5-core iteration-unfolded open forward error correction (oFEC) decoder is presented. The $6.2 \text{mm}^{2}$ decoder adopts a bit-level parallel architecture with transpose reordering to achieve 56.6 Gbps at $18.2 \text{pJ} / \mathrm{b}$, surpassing the state-of-the-art by 2.8 x in throughput, 4.8 x in energy efficiency, and $6.5 x$ in area efficiency. An efficient list-64 decoding enhances error correction with a pre-FEC BER of up to 2 %.},
  keywords={Very large scale integration;Forward error correction;Throughput;Optical fiber communication;Energy efficiency;Decoding;Parallel architectures},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075198},
}

@INPROCEEDINGS{11075041,
  author={Jain, Vikram and Grubb, Daniel and Zhao, Jerry and Anderson, Kevin and Ho, Ken T and Chi, Yufeng and Schwarz, Ella and Asanović, Krste and Shao, Yakun Sophia and Nikolić, Borivoje},
  title={Cygnus: A 1 GHz Heterogeneous Octa-Core RISC-V Vector Processor for DSP},
  abstract={We introduce Cygnus, an energy-efficient octa-core RISC-V vector processor compliant with the RVV 1.0 specification targeting digital signal processing (DSP) applications. This chiplet features dynamic instruction scheduling with short vector lengths at the vector core level and a big/little architecture with tightly-coupled memory at the SoC level, facilitating efficient streaming data flow across cores. Cygnus demonstrates a high average utilization of 90% across GEMM and CONV kernels, achieving leading energy efficiencies of 414 GOPS/W for INT8 GEMM and 109 GFLOPS/W for FP32 GEMM. In a representative computer vision kernel implementing denoising using a non-local means algorithm, the chiplet delivers a latency of 3.7 ms with an energy consumption of 518 μJ/ frame.},
  keywords={Processor scheduling;Chiplets;Signal processing algorithms;Digital signal processing;Very large scale integration;Dynamic scheduling;Vectors;Energy efficiency;Vector processors;Kernel},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075041},
}

@INPROCEEDINGS{11074933,
  author={Shi, Man and Fang, Chao and Jiang, Weijie and Jain, Vikram and Joseph, Antony and Dehaene, Wim and Verhelst, Marian},
  title={A 16NM 550-1320 BTOPS/W NPU Exploiting Training-Free Structured Bit-Level Sparsity and Dynamic Dataflow Processing},
  abstract={To jointly achieve aggressive weight compression as well as high compute utilization for neural and transformer workloads, this chip implements a sparse NN processor exploiting structured bit-level sparsity and dynamic dataflows. Without a need for costly network retraining, the chip achieves an energy efficiency of 550-1320 BTOPS/W, realizing an up to x6.82 efficiency improvement compared to the SotA.},
  keywords={Artificial neural networks;Very large scale integration;Transformers;Energy efficiency},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074933},
}

@INPROCEEDINGS{11075183,
  author={Ray, Subhajit and Frank, David and Bulzacchelli, John and Sadhu, Bodhisatwa and Tien, Kevin and Yeck, Mark and Lukashov, Stanislav and Baks, Chris and Timmerwilke, John and Robertazzi, Raphael and Underwood, Devin and Gaucher, Brian and Friedman, Daniel},
  title={A 5.6-100K, 128ppm/K Cryo-CMOS Current Reference},
  abstract={The first CMOS current reference with a measured temperature coefficient across cryogenic temperatures is reported. Implemented in a 14nm FinFET technology, occupying 0.14mm2, and drawing 38uA from a 1.4V supply, the reference uses mutual compensation between a MOSFET gate-source voltage and thin-film resistance—a circuit technique that improves as cryogenic temperatures are approached—to achieve a temperature coefficient of 128ppm/K over 5.6-100K, as averaged over 5 dice from 3 wafers. The cryogenic supply sensitivity, at 0.06%/V, is 6x lower than the lowest reported among cryo-CMOS references, either current or voltage. Finally, cryogenic low-frequency noise is measured for the first time among cryo-CMOS references, either current or voltage.},
  keywords={Temperature sensors;Voltage measurement;Sensitivity;Current measurement;Low frequency noise;Cryogenics;Very large scale integration;Logic gates;Time measurement;Noise measurement},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075183},
}

@INPROCEEDINGS{11074957,
  author={Yuan, Fengen and Su, Hao and Zou, Yating and Peng, Yatao and Yin, Jun and Yan, Fei and Charbon, Edoardo and Martins, Rui P. and Mak, Pui-In},
  title={A CRYO-CMOS RF-DAC Based Super-Heterodyne Transmitter for Superconducting Qubit Control},
  abstract={Multiple Qubits should be manipulated to perform practical quantum computing, which requires a broad frequency range for the qubit control chip. We present a 4 K cryo-CMOS quantum control chip featuring a Mixing (MIX)/ Non-return-to-zero (NRZ) mode radio frequency digital to analog converter (RF-DAC) and an up-conversion mixer. By opting for Mixing Mode RF-DAC and a mixer for two-stage frequency up-conversion instead of direct-conversion or other methods, our controller can achieve a wider modulated frequency range and lower power consumption.},
  keywords={Frequency modulation;Power demand;Digital-analog conversion;Qubit;Radio transmitters;Very large scale integration;Optical signal processing;Frequency control;Mixers;cryo-CMOS;transmon qubits;quantum computing},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074957},
}

@INPROCEEDINGS{11074904,
  author={Huang, Wenqiang and Guo, Yanshu and Tian, Tian and Liu, Qichun and Wei, Guo and Liu, Xuanyan and Li, Tiefu and Jia, Wen and Zheng, Yuanjin and Wang, Zhihua and Jiang, Hanjun},
  title={A Cryogenic ${1.08mW}$/Qubit Fully-Integrated 4-Channel Frequency-Division-Multiplexing Transmon Qubit State Readout ASIC in 28nm Bulk CMOS},
  abstract={In this paper, we propose a cryogenic fully-integrated 4channel Frequency-Division-Multiplexing (FDM) transmon qubit state readout ASIC, with a power consumption of $4.32 \text{mW}(1.08 \text{mW} /$ qubit). To the author's knowledge, it achieves the lowest power consumption compared to other qubit state readout receiver. By adopting ultra-narrow band zero-IF topology aided by 18-tap Analog Finite Impulse Response low pass filter (AFIR-LPF) with 40 dB stop-band rejection, the chip is able to detect four qubits simultaneously in our test system and achieves at least 92 % readout fidelity in four qubits FDM readout measurement.},
  keywords={Semiconductor device measurement;Power demand;Qubit;Low-pass filters;Cryogenics;Receivers;Very large scale integration;CMOS technology;Topology;Frequency division multiplexing;cryo-CMOS;quantum computing;FDM qubit readout;fully-integrated qubit readout},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074904},
}

@INPROCEEDINGS{11075187,
  author={Fuketa, Hiroshi and Akita, Ippei and Ishikawa, Tomohiro and Koike, Hanpei and Mori, Takahiro},
  title={0.25 mW/qubit, 5.7-7.5 GHz Cryogenic CMOS Microwave Signal Selector Using Dual-Stage Injection-Locked Oscillator for Frequency-Multiplexed Qubit Control},
  abstract={Cryogenic CMOS (cryo-CMOS) quantum bit (qubit) control circuits are expected to overcome the interconnect complexity problem in large-scale quantum computers. However, since each qubit has a unique frequency for control, many power-hungry oscillators are needed to generate the frequencies at the cryogenic temperature stage of a refrigerator. In this paper, to remove the oscillators from the refrigerator, we propose a cryo-CMOS signal selector consisting of two injection-locked oscillators that extract the specified frequency tone for qubit control from the multi-tone microwave signal. This can realize an efficient frequency-multiplexed qubit control system with 1/30 power consumption of the conventional systems.},
  keywords={Computers;Injection-locked oscillators;Qubit;Cryogenics;Very large scale integration;Microwave circuits;Control systems;Microwave oscillators;Temperature control;Frequency control},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075187},
}

@INPROCEEDINGS{11074852,
  author={Gruber, Moritz and Eversmann, Björn and Liao, Lei and Brederlow, Ralf},
  title={A Fully Integrated Bipolar 1.8Vpp-to-41Vpp 450kHz Switched-Capacitor MEMS-Driver with a Power Reduction Factor of 16.3},
  abstract={This work presents a fully integrated bipolar switched-capacitor driver for ultrasonic Micro-Electro-Mechanical Systems (MEMS) transducers, capable of generating boosted amplitude modulated signals from a low supply voltage. The proposed architecture consists of a bipolar series-parallel charge pump (SP-CP) that generates positive and negative single-ended output voltages. This almost doubles the peak-to-peak output voltage and the power reduction factor compared to conventional unipolar SP-CPs. The bipolar SP-CP achieves better stage utilization, saving up to 50% in number of stages.},
  keywords={Micromechanical devices;Microelectromechanical systems;Charge pumps;Transducers;Voltage;Switches;Very large scale integration;Acoustics;Switching circuits},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074852},
}

@INPROCEEDINGS{11074824,
  author={Cao, Wenfei and Zhong, Longjie and Jian, Wenxiu and Wang, Ling and Zhu, Zhangming},
  title={A $22 \mu \mathrm{g} /\sqrt{} \text{Hz}$ Noise Floor, $1.6 \text{mg} /\mathrm{g}^{2}$ VRC, High Efficiency MEMS Capacitive Accelerometer Using High-Voltage Orthogonal Excitation Technique},
  abstract={This work presents a high-voltage orthogonal excitation (HVOE) based readout circuit for MEMS capacitive accelerometer. The proposed interface IC is fabricated in $0.18 \mu \mathrm{m}$ BCD process, achieving a low noise floor of $22 \mu \mathrm{g} / \sqrt{} \text{Hz}$ with low vibration rectification error (VRE) evaluated by vibration rectification coefficient (VRC) $\left(1.6 \text{mg} / \mathrm{g}^{2}\right)$ and high efficiency evaluated by FoM (4.58pJ). Compared to state-of-the-art low noise MEMS accelerometers, this work improves the VRC and the FoM by 40x and 11.6x, respectively.},
  keywords={Micromechanical devices;Accelerometers;Vibrations;Noise;High-voltage techniques;Very large scale integration;Floors},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074824},
}

@INPROCEEDINGS{11075049,
  author={Liu, Liheng and Qu, Tianxiang and Pan, Qinjing and Li, Dan and Guo, Gan and Hong, Zhiliang and Xu, Jiawei},
  title={A 560μW 6fA/√Hz 146dB-DR Ultrasensitive Current Readout Circuit for PWM-Dimming-Tolerant Under-Display Ambient Light Sensor},
  abstract={This paper presents an ultra-low-noise, power-efficient, and PWM-dimming-tolerant photocurrent readout circuit for under-display ambient light sensors (ALS). To achieve a pA resolution, a transimpedance amplifier (TIA) with a feedback diode is used to provide GΩ resistance and input current noise of 6fA/√Hz. To resolve instability and noise folding with low power, the TIA utilizes a signal-dependent auto-tracking zero for frequency compensation, and a low-pass filter to suppress high frequency current noise. To accurately extract ambient light from the interference of PWM dimming, the readout can operate in an under-sampling mode to remove the interference through algorithm. Fabricated in a 180nm CMOS technology, this work achieves best-in-class resolution of 0.36pApp and 146dB DR in a readout time of 0.84ms, reaching an excellent FoM-DR of 206.3dB. ALS optical measurement with PWM dimming interference has been successfully demonstrated.},
  keywords={Resistance;Noise;Low-pass filters;Interference;Very large scale integration;Pulse width modulation;Optical variables measurement;Sensors;Photoconductivity;Signal resolution},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075049},
}

@INPROCEEDINGS{11075171,
  author={Choi, Seung Hun and An, Jun Yeol and Ahn, Jaewoong and Lee, Jae-Youl and Kim, Si-Woo and Lee, Hyung-Min and Choi, Yoon-Kyung},
  title={A Hybrid Touch Sensing AFE with Common-CVQ (Currents, Voltages, and Charges) Subtraction to Improve Display Noise Immunity for Large Sensing Load up to 820pF},
  abstract={Flexible on-cell touch OLED displays face significant display noise challenges due to large parasitic capacitance $(C_{P})$. To address the limitations of conventional methods, this paper proposes improved common-current subtraction (CCS) incorporating common-voltage subtraction (CVS) and common-charge subtraction (CQS) techniques. CVS enhances SNR by up to 6.72 dB in self-capacitance (SC) sensing and 6.33 dB in mutual capacitance (MC) sensing, while CQS increases the operational load capacity from 390 pF to 820 pF. Fabricated in 65 nm CMOS, the proposed AFE achieves a twofold improvement in input dynamic range (DR) and consistent performance under display noise (D-noise) injection.},
  keywords={Very large scale integration;Organic light emitting diodes;Dynamic range;Sensors;Faces;Signal to noise ratio;Parasitic capacitance},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075171},
}

@INPROCEEDINGS{11075015,
  author={Wang, Zongnan and Luo, Haoyang and Bao, Rongjia and Jie, Lu and Tang, Xiyuan},
  title={An 88.8dB-SNDR 6-MS/s Pipelined SAR ADC with A Closed-Loop Dynamic Amplifier Featuring Highly-Linear Full-Scale Output Swing},
  abstract={This paper presents a pipelined SAR ADC with a two-stage closed-loop residue amplifier (RA). The proposed RA incorporates a floating gm-ratio-based amplifier (FGA) as the first stage and a charge-pump-assisted cascoded floating inverter amplifier (CP-FIA) as the output stage. It enables fast-slewing, energy-efficient, robust, and highly-linear amplification, with a THD of <-100 dB at full-scale output swing. A system-level chopping-assisted auto-zero (AZ) is adopted to eliminate the RA's flicker noise and offset without additional thermal noise penalty. The prototype achieves 88.8dB SNDR at 6MS/s, demonstrating the best FoMs of 183dB among ADCs with >5MS/s conversion rate.},
  keywords={Charge pumps;Prototypes;Very large scale integration;Thermal noise;Inverters;Energy efficiency;1/f noise},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075015},
}

@INPROCEEDINGS{11075130,
  author={Yoon, Junghyun and Chae, Youngcheol},
  title={A 91.2dB-SNDR 250kHz-BW CT Zoom ADC Achieving a 6-Bit Linear Zoom-in with Interstage LPF and 1.5-Bit DAC},
  abstract={This paper presents a continuous time (CT) zoom ADC that achieves a 6-bit linear zoom-in with an interstage LPF and an intrinsically linear 1.5-bit DAC. By using the interstage LPF, the shaped residue signal of the coarse $\Delta\Sigma \mathrm{M}$ is properly filtered, enabling 6-bit linear zoom-in, boosting the SQNR by $> 36\text{dH}$. Fabricated in 28nm CMOS process, the ADC consumes only $392\mu \mathrm{W}$ while achieving 101.F 4dB SFDR, 91 2dB SNDR, and 92. 7dH DR in a signal bandwidth of 250kHz. This corresponds to a state-of-the-art FoM of 180. 7dB.},
  keywords={Maximum likelihood detection;Nonlinear filters;Bandwidth;Very large scale integration;CMOS process;Boosting},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075130},
}

@INPROCEEDINGS{11075144,
  author={Wang, Xing and Zhang, Zhishuai and Zhong, Yi and Sun, Nan and Jie, Lu},
  title={A 0.0035mm286dB-SNR 1.25MHz-BW Noise-Shaping SAR ADC Enabling kT/C Noise Shaping},
  abstract={This paper proposes a 13-bit 2nd-order noise-shaping SAR (NS-SAR) ADC with a novel kT/C noise shaping technique. It achieves 85.8dB SNDR with a 40MHz sampling rate and an oversampling ratio (OSR) of 16. Its input sampling capacitance is merely 0.3 pF, occupying an area of 0.0035 mm2 in a 28nm CMOS technology. It is the smallest among all published ADCs exceeding 70dB SNDR.},
  keywords={Very large scale integration;Capacitance;CMOS technology;Noise shaping},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075144},
}

@INPROCEEDINGS{11074988,
  author={Xing, Chaoyang and Zhong, Yi and Sun, Nan and Jie, Lu},
  title={A 94.4dB-SNDR 500kHz-BW Multi-Rate MASH 0-1-0 ADC with Easy-to-Drive Capacitive Input and Deadband-Embedded Gm-C Loop Filter},
  abstract={This work proposes a multi-rate MASH 0-1-0 ADC consisting of an 8b oversampled SAR ADC, a 1b incremental CTDSM, and a 12b Nyquist SAR ADC to achieve high SQNR with high efficiency. A coupling capacitive input network is introduced to ease the ADC driving. A high linearity $\mathrm{G}_{\mathrm{m}}-\mathrm{C}$ integrator adopting low-noise deadband operation is used for high efficiency and high SNR. The prototype ADC achieves 94.4 dB SNDR over a 500 kHz bandwidth, consuming only 793 uW of power, and resulting in a $\text{FoMs}_{\mathrm{s}}$ of 182.3 dB.},
  keywords={Multi-stage noise shaping;Couplings;Prototypes;Linearity;Bandwidth;Very large scale integration;Signal to noise ratio},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074988},
}

@INPROCEEDINGS{11075190,
  author={Song, Seungheun and Kang, Taewook and Knowlton, Alexander and Lee, Seungjong and Flynn, Michael P.},
  title={An NS-SAR Quantizer-Based Pipeline Incremental Delta-Sigma ADC Using a Current-Regulated Floating Ring Amplifier and Two-Phase Miller Negative-C},
  abstract={A pipeline incremental ADC (IADC) leverages a 6-bit noise-shaping SAR quantizer for high SQNR at low OSR. A pipeline IADC structure enables continuous sampling and concurrent stage processing, improving bandwidth. Delay-free integrators and residue amplification enhance signal accumulation, boosting SQNR. A current-regulated floating ring amplifier (CURE FLORA) halves power consumption, while a two-phase Miller Negative-C technique mitigates integrator gain errors. Implemented in 28-nm CMOS, the prototype achieves an SNDR of 80.1 dB, SFDR of 97.2 dB, at 80 MS/s over a 5 MHz bandwidth. With a power consumption of 1.85 mW, the Walden FoM and Schreier SNDR FoM of 22.4 fJ/conversion-step and 174.4 dB, respectively.},
  keywords={Power demand;Pipelines;Flora;Prototypes;Bandwidth;Very large scale integration;Boosting;Noise shaping;Gain},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075190},
}

@INPROCEEDINGS{11075133,
  author={Yao, Yuan and Tian, Fengshi and He, Jingyu and Ki, Wing-Hung and Tsui, Chi-Ying and Cheng, Kwang-Ting and Liu, Yang},
  title={A 6.78 MHz Multiple-Transmitter Wireless Power Transfer System with Integrated Coupling Coefficient Sensor},
  abstract={A 6.78 MHz multiple-transmitter wireless power transfer (WPT) system with integrated coupling coefficient magnetic and polarity sensor is proposed to achieve misalignment-free WPT. Compared to conventional systems, the perpendicular WPT efficiency increased 212x from 0.3% to 63.7%, with the load power increased from 0.3mW to 2W.},
  keywords={Couplings;Wireless power transfer;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075133},
}

@INPROCEEDINGS{11074848,
  author={Lee, Heejun and Yoo, Junsang and Lee, Jiho and Lee, Kyoungho and Lim, Wonseob and Yi, Sang-Hwa and Kim, Hyun-Sik},
  title={A Multi-Rectenna, Single-Output, Power Combine-and-Regulate Boost Converter for 5.8GHz Wireless Power Receiver Achieving 3.1W Over 50m-Distance},
  abstract={This paper presents a multi-input single-output power combine-and-regulate (MISO-PCR) converter chip for a 5.8GHz WPT receiver (Rx). The MISO-PCR simultaneously collects, combines, and converts the multiple power from 30 GaAs rectennas into a single regulated output (28V). Fabricated in a 180nm BCD, the chip enables the Rx system—paired with a beamforming Tx—to deliver a 3.1 W power at a 50m distance.},
  keywords={Rectennas;Array signal processing;Gallium arsenide;Receivers;Very large scale integration;MISO},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074848},
}

@INPROCEEDINGS{11074871,
  author={Lee, Junhyuck and Kim, Yemin and Kim, Dongrim and Kang, Dongil and Song, Minsoo and Lee, Byunghun},
  title={A Wireless Power and Synchronized Full-Duplex Data Transceiver IC with 400 Kbps Bidirectional Data Rate Using a Single Inductive Link for Low-Power Systems},
  abstract={This paper presents a wireless power and synchronized fullduplex data transceiver (WPSFDT) system using a single inductive link. This system employs TRX synchronization (TRXS) for synchronized data recovery (SynDR) of both offduration shift keying (ODSK) downlink and short-pulse load shift keying (SP-LSK) uplink. The envelope hold scheme ensures robust full-duplex (FD) data telemetry by mitigating self-interference (SI) caused by uplink data transmission. Measured results demonstrate that the proposed system achieves, for the first time, 400 kbps synchronized FD data transmission using a single inductive link through TRXS without any additional components for frequency separation.},
  keywords={Wireless communication;Time-frequency analysis;Full-duplex system;Very large scale integration;Transceivers;Time measurement;Frequency measurement;Synchronization;Telemetry;Uplink},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074871},
}

@INPROCEEDINGS{11075222,
  author={Chu, Peng and Hua, Siqin and Gao, Yutian and Hu, Qiaoyu and Sokolovskij, Robert and Wang, Qing and Yu, Hongyu and Gao, Yuan},
  title={A Dual-Mode Direct-Drive D-GaN Driver with Reused Inductor and Power Switches for Negative Voltage Generation and Gate Energy Recycling},
  abstract={This paper presents a dual-mode direct-drive driver for depletion-mode GaN (D-GaN) power transistors, integrating negative voltage generation and gate energy recycling with reused inductors and switches. D-GaN devices offer superior reliability and gate voltage swing but require complex drive schemes and incur significant gate driving losses in high-power, high-frequency applications. The proposed driver combines an inverting buck-boost converter with a resonant gate driver, operating in resonant direct-drive (RDD) mode for efficient gate energy recycling at high frequencies and conventional direct-drive (CDD) mode for adjustable slew rate control. Fabricated in a $0.18 \mu \mathrm{m}$ HV BCD process, the driver achieves a gate charging efficiency of 93 % and reduces power consumption by up to 40 % in RDD mode.},
  keywords={Power demand;Switches;Logic gates;Very large scale integration;Power transistors;Gate drivers;Recycling;High frequency;Inductors;Integrated circuit reliability},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075222},
}

@INPROCEEDINGS{11075044,
  author={Kocon, Walter and Bian, Yusheng and Giewont, Ken and Letavic, Ted},
  title={Key Technologies and Performance Aspects for Electrical and Optical Interconnects},
  abstract={High-Performance Computing (HPC) modules and their ever-increasing data bandwidth require conversion of electrical signals to photons. We present the next generation to Occamy [1] electrical only HPC system to include optical interconnects addressing bandwidth, manufacturing scalability, and power efficiency challenges in future data center systems. As datacenter HPC modules rapidly transition to electrical/optical interconnects, GlobalFoundries has developed a compatible electrical to optical interconnect advanced packaging solution with its partner ecosystem. In this paper, we provide an overview of some of the advances in integration and characterization of electro/optical modules and discuss trends of current and future combined electrical and optical interconnects. Key performance aspects and features include high power low-loss edge couplers, best-in-class high-speed micro-ring modulators, Mach-Zehnder modulators, and photodetectors. GlobalFoundries' next generation FotonixTM (45SPCLO) technology was created as a high performance electro-optical interconnect platform with monolithic integration of Photonics and RF class CMOS devices on the same die as integrated V-grooves for fiber attachment solutions and Through Silicon Vias (TSVs) for advanced packaging high speed electrical connections.},
  keywords={Performance evaluation;Optical interconnections;Integrated circuit interconnections;Couplers;Bandwidth;Very large scale integration;Packaging;Through-silicon vias;Next generation networking;Electro-optical waveguides;High-performance silicon photonics modules;electro-optical interconnects;edge couplers;optical I/O;TSV},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075044},
}

@INPROCEEDINGS{11075048,
  author={Kikuchi, Katsuya and Araga, Yuuki and Nakagawa, Hiroshi and Watanabe, Naoya},
  title={3D Interconnect Technology for Superconducting Quantum Devices},
  abstract={This paper introduces the results of research and development into 3D interconnect technology for the large-scale integration of superconducting quantum devices. We will introduce bump connections using superconducting materials and direct bonding technology.},
  keywords={Temperature measurement;Superconducting devices;Semiconductor device measurement;Superconducting materials;Quantum computing;Electrical resistance measurement;Wire;Bonding;Plasma temperature;Substrates},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075048},
}

@INPROCEEDINGS{11075126,
  author={Budhkar, Prerna and Srinivasa, Srivatsa Rangachar and Sciulli, Mirco and Murali, Gauthaman and Kuttappa, Ragh and Aseron, Paolo and Nguyen, Trang and Honkote, Vinayak and Karnik, Tanay},
  title={1.536TB/s/mm2 Bandwidth Scalable Attention Accelerator with 22.5GOPS Throughput High Speed SoftMax for Quantized Transformers in Intel 3},
  abstract={This work presents a novel hardware accelerator utilizing <3µm pitch 3D Cu-Cu Hybrid bonding interconnect (HBI) technology and specifically designed to efficiently execute Multi Head Attention (MHA) of encoder transformer models, particularly focusing on integer BERT. Transformers have become the dominant architecture for natural language processing (NLP) tasks. We present an accelerator addressing the loss due to low precision model by incorporating specialized hardware optimizations to the quantizer and SoftMax engine. Extremely Wide and variable SRAM/logic Bandwidth for GEMM parallelism including dynamic transpose logic and high speed 2-Pass SoftMax in conjunction offers 22.5GOPS. The Intel 3 prototype with a 3D footprint of 1.2mm2 achieves 25668 Attention/s with no accuracy loss while running I-BERT.},
  keywords={Solid modeling;Three-dimensional displays;Prototypes;Bandwidth;Very large scale integration;Parallel processing;Transformers;Throughput;Natural language processing;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075126},
}

@INPROCEEDINGS{11075134,
  author={Mishra, P. and Balamurugan, G. and Aggarwal, A. and Lazovsky, D. and Yasotharan, H. and Eachempatti, H. and Park, K.M. and Hossain, M. and Staffaroni, M. and Thakur, P. and Winterbottom, P. and Virk, P. and Goyal, P.K. and Nagulapalli, R. and Yazdani, R. and Forey, S. and Sahni, S. and Ramachandra, S. and Vats, S. and Yu, S. and Jeon, S. and Hariwan, S. and Younis, W.},
  title={A 3D-Integrated 56 Gb/s Silicon Photonic Transceiver with 5nm CMOS Electronics for Optical Compute Interconnects},
  abstract={This work presents a hybrid-integrated silicon photonic $(\text{SiPh})$ transceiver suitable for realizing chiplet-based optical $\mathrm{I}/\mathrm{O}$ in future $\text{AI}/\text{ML}$ ASIC packages. The transceiver die stack consist of two ICs: a $\text{SiP}\overline{\mathrm{h}}$ IC (PIC) with compact, thermally stable electro-absorption modulators (EAMs), and a 5 nm CMOS electronic IC (EIC) with 56 Gb /s NRZ SerDes and optical interface circuits. A stacked CMOS EAM driver delivers 1.8 Vpp modulation voltage, achieving 3.5 dB extinction ratio. Transmit equalization and inductive peaking help accommodate sub-Nyquist RX analog front-end bandwidth, thereby reducing additive thermal noise from RX electronics. The complete 56 Gb $/\mathrm{s}$ NRZ optical link consisting of the fiber-attached 3D SiPh transceiver and an external packaged light engine achieves BER $< 10^{-9}$ with $< -10.7\text{dBm}$ RX OMA while dissipating 2.8 $\text{pJ}/\text{bit}$. The transceiver electronics consumes only 0.09 $\text{mm}^{\overline{2}}$ area, delivering more than 600 Gb $/\mathrm{s}/\text{mm}^{2}$ areal bandwidth density.},
  keywords={Optical fibers;Integrated optics;Electro-absorption modulators;Bandwidth;Very large scale integration;Silicon photonics;Electronic packaging thermal management;Transceivers;Optical modulation;Optical signal processing},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075134},
}

@INPROCEEDINGS{11075074,
  author={Chou, Vincent Wen-Shen and Chuang, Yung-Hsu and Yang, Yu-Tao and Huang, Chun-Yen and Tai, Susan Shu-Chin and Peng, Yung-Chow and Hsieh, Kenny Cheng-Hsiang},
  title={Analog Cells and Their DTCO Impact on Advanced Node CMOS Analog/Mixed-Signal Circuits},
  abstract={Analog Cells are selected size transistors with optimized cell heights, easy abuttable placement, and pre-drawn structured layouts. Analog Cell Design and Technology Co-Optimization (DTCO) achieves better Performance/Power/Area (PPA) with ~10% analog IP area shrinkage and ~50% layout effort reduction. We also provide an Analog ECO Cell (AEC) flow to enable efficient circuit revision by changing only backend metal layers to reduce turnaround time and mask cost. Based on analog cell-to-cell mapping for both schematic and layout, it also enables easy node-to-node migration through the Analog Design Migration (ADM) flow with 2X productivity enhancement. TSMC introduced silicon-proven analog cells in 2018 at the N5 node, now offered in all advanced finFET (N16 to N3) and new nanosheet nodes with successful customer adoption.},
  keywords={Structural rings;Productivity;Training;Layout;Very large scale integration;FinFETs;Silicon;IP networks;Transistors;Standards;Analog Cell;DTCO;PPA;CMOS;IP;stackgate;finfet;AEC;ADM;Simulation to Silicon (S2S)},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075074},
}

@INPROCEEDINGS{11074818,
  author={Deng, Jie and Sharma, Deepak and Yuan, Jun and Wang, Hao and Wang, Xiao-Yong and Lim, Bruce and Jung, Chulmin and Cheng, Jason and Gao, Yandong and Rasouli, Hadi and Kauffman, Anatoly and Chiang, Yuming and Denduluri, Raghava and Nallapati, Giri and Chidambaram, PR. Chidi},
  title={Enhancing Power-Performance-Area Scaling of Std-Cell, SRAM, and Analog Designs Through Design-Technology Co-Optimization},
  abstract={This paper shows how advanced semiconductor scaling, constrained by physical and performance limits, continues to achieve Power-Performance-Area (PPA) improvements through Design-Technology Co-Optimization (DTCO). By optimizing process, design (standard cells, SRAM, analog), and product KPIs, next-generation SoCs maintain gains despite shrinking nodes.},
  keywords={Resistance;Process design;Technological innovation;Random access memory;Very large scale integration;Windows;Wire;Standards;Optimization;Next generation networking},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074818},
}

@INPROCEEDINGS{11074879,
  author={Subramani, Kumar and Sengupta, Rwik and Loden, Matthew and Rahman, Ardasheir and Dechene, Dan and Chu, Albert},
  title={Backside Routing Enablement Considerations for Advanced Node GAA Devices},
  abstract={Backside routing is an innovative feature offered by several foundries in Gate-All-Around (GAA) nodes at 3nm and beyond. In this paper, we will discuss the considerations for digital design implementation to use the backside layers most efficiently for maximizing PPA (Power Performance Area). The considerations involve choosing the right strategies for technology definition and implementation flow for power, clock and specific signals that can benefit from backside routing.},
  keywords={Performance evaluation;Gallium arsenide;Very large scale integration;Logic gates;Routing;Foundries;Clocks},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074879},
}

@INPROCEEDINGS{11075051,
  author={Park, Min Chul and Chae, Usuk and Kim, Sangyeon and Kim, Yeji and Kwon, Segab and Lee, Sungyeop and Lee, Ji-Hye and Shin, Byungchul and Jang, Hyunjae and Kim, Namjae and Kim, SeongRyeol and Park, Hong-Hyun and Kim, Jaehwan and Kang, Jae-Hyun and Kim, Yoon-Suk and Kim, Young-Gu and Jeong, Changwook and Jeon, Joong-Won and Kim, Dae Sin},
  title={Realistic and Scalable TCAD for Yield-Aware Full-Chip DTCO},
  abstract={Recent advances in AI-based virtual metrology and physics-based modeling have accelerated the realization of digital twins, enabling comprehensive analysis. In this paper, we propose a methodology to evaluate chip-level defect probabilities and thermal bottlenecks, followed by a physical layout optimization strategy. Our framework integrates multi-environment virtual metrology with a neural-network-based 3D real-time TCAD model, enabling the analysis of billions of geometries and thermal hotspots for simultaneous yield and performance optimization. Validated on a modest HPC cluster, our full-chip simulation completes in under an hour. This study extends the role of TCAD from device-level analysis to chip-level design, linking performance and yield interactions and establishing a new milestone in the DTCO paradigm.},
  keywords={Training;Performance evaluation;Analytical models;Three-dimensional displays;Layout;Artificial neural networks;Metrology;Topology;Thermal analysis;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075051},
}

@INPROCEEDINGS{11074937,
  author={Jang, Hyunjae and Ma, Boo Soo and Kim, Satbyul and Lee, Ji-Hye and Myung, Sanghoon and Lee, Young-Joo and Huh, In and Kim, SeongRyeol and Park, Min Chul and Jeong, Narae and Kim, Sung Jin and Kim, Young-Gu and Kim, Dae Sin},
  title={Design-Aware Full-Chip Warpage Modeling for STCO: Bridging Reliability and Design for a New Era of Advanced Systems},
  abstract={A novel design-aware warpage modeling methodology overcomes formidable computational barriers in full-chip layout simulation. By integrating representative volume element (RVE) analysis with AI-driven pattern clustering, this method enables efficient finite element method (FEM) simulations while capturing intricate BEOL design impacts. Validated by strong agreement with measured chip warpage across diverse temperatures conditions, the model reveals how mechanical property distributions drive warpage behavior. Demonstrated in system-technology co-optimization (STCO) for high bandwidth memory (HBM), it supports micro-bump ($\mu$bump) and power delivery network (PDN) designs, achieving up to 13% warpage reduction without sacrificing performance. This scalable solution provides critical insights into balancing mechanical reliability and performance, paving the way for advanced semiconductor systems.},
  keywords={Temperature measurement;Layout;Metals;Pattern clustering;Mathematical models;Finite element analysis;Integrated circuit modeling;Standards;Bars;Periodic structures},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074937},
}

@INPROCEEDINGS{11074878,
  author={Kleveland, Bendik and Ferolito, Phil and Morrison, Mike and Scherer, Alisa},
  title={Wafer-Scale Integration for AI – The Holy Grail?},
  abstract={This paper presents motivation, challenges, and solutions to productize a wafer-scale integration (WSI) die for artificial intelligence (AI) applications. In a similar way GPUs are better suited than CPUs for AI applications, the Cerebras (CBS) WSI is even better suited to solve large problems. The solutions presented include large on-chip memory, tightly coupled vertical power delivery, a mesochronous clocking scheme, and a thorough in-system test and burn-in methodology.},
  keywords={Fasteners;Very large scale integration;Silicon;Wafer scale integration;System-on-chip;Artificial intelligence;Voltage control;Engines;Stress;Testing},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074878},
}

@INPROCEEDINGS{11074875,
  author={Shi, Zhan and Wang, Yan and Diao, Minggang and Wu, Wenyu and Su, Zongming and Li, Xiangku and Niu, Rui and Zang, Hui and Song, Kunpeng and Yu, Yun and Lin, Huimin and He, Jun and Liu, Hu and Xia, Jing and Liao, Heng},
  title={Design Considerations for LLM Inference in Data Centers: Chip and Interconnect},
  abstract={This paper presents a cost-efficient chip prototype optimized for large language model (LLM) inference. We identify four key specifications – computational FLOPs (flops), memory bandwidth (bw), memory capacity (cap), and interconnect latency –and introduce two ratios (bw/cap and flops/ bw) to guide chip design. Through an analysis of LLM inference workflows, we show that memory bandwidth is critical for LLM decoding, while memory capacity and computational FLOPs are less important than in training. Based on these insights, we systematically propose a design with reduced memory capacity, increased bandwidth, and an interconnect topology design principle optimized for both interconnect latency and bandwidth.},
  keywords={Training;Network topology;Large language models;Memory management;Integrated circuit interconnections;Prototypes;Bandwidth;Very large scale integration;Topology;Decoding;LLM inference;P-D disaggregation;network topology},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074875},
}

@INPROCEEDINGS{11074829,
  author={Ho, Chia-Tung and Gong, Jing and Bai, Yunsheng and Deng, Chenhui and Ren, Haoxing and Khailany, Brucek},
  title={Marco: Configurable Graph-Based Task Solving and Multi-AI Agents Framework for Hardware Design},
  abstract={Hardware design presents numerous challenges stemming from its complexity and advancing technologies. These challenges result in longer turn-around-time (TAT) for optimizing performance, power, area, and cost (PPAC) during synthesis, verification, physical design, and reliability loops. Large Language Models (LLMs) have shown remarkable capacity to comprehend and generate natural language at a massive scale, leading to many potential applications and benefits across various domains. Successful LLM-based agents for hardware design can drastically reduce TAT, leading to faster product cycles, lower costs, improved design reliability and reduced risk of costly errors. In this work, we propose a unified framework, Marco, that integrates configurable graph-based task solving with multi-modality and multi-AI agents for chip design by leveraging the natural language and reasoning abilities with collaborative toolkits. Lastly, we demonstrate promising performance, productivity, and efficiency of LLM agents by leveraging the Marco framework on layout optimization, Verilog/design rule checker (DRC) coding, and timing analysis tasks.},
  keywords={Costs;Natural languages;Layout;Collaboration;Very large scale integration;Reliability engineering;Hardware;Timing;Hardware design languages;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074829},
}

@INPROCEEDINGS{11075103,
  author={Li, Chi-Yu and Shyu, Yi-Fan and Yang, Chia-Hsiang},
  title={An 157TOPS/W Transformer Learning Processor Supporting Forward Pass Only with Zeroth-Order Optimization},
  abstract={This work presents the first Transformer learning processor that supports forward pass only with zeroth-order optimization. By applying uniform perturbation, sign-based weight gradient generation, and exponential ternary speculation, the training complexity is reduced by up to 96%. By employing parallel processing, tiled-based bitmask generation, and workload scheduling, the latency is reduced by up to 96%. Fabricated in 40-nm CMOS, the chip achieves a max energy efficiency of 157TOPS/W, outperforming prior backpropagation-based Transformer learning processors by 1.6-to-7.6×.},
  keywords={Training;Processor scheduling;Perturbation methods;Very large scale integration;Parallel processing;Transformers;Energy efficiency;Complexity theory;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075103},
}

@INPROCEEDINGS{11074789,
  author={Pallo, M. and D'Agostino, S. and Piccoli, M. and Bonnet, D. and Castellani, N. and Piccolboni, G. and Iftakher, M. A. and Nodin, J.-F. and Andrieu, F. and Querlioz, D. and Molas, G. and Hutin, L. and Vianello, E.},
  title={On Chip Customized Learning on Resistive Memory Technology for Secure Edge AI},
  abstract={This paper presents the first experimental demonstration of few-shot on-chip training on an in-memory computing resistive memory (ReRAM) platform. We use the Model-Agnostic Meta-Learning (MAML) algorithm to reduce training iterations and associated ReRAM conductance updates by orders of magnitude. Through co-optimization of device programming conditions and the algorithm, we achieve $>97 {\%}$ accuracy on the Omniglot dataset after just five training iterations (i.e., ReRAM programming operations) while improving device retention at 150°C.},
  keywords={Training;Accuracy;Training data;Edge AI;Programming;Very large scale integration;In-memory computing;System-on-chip;Iterative methods;Character recognition},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074789},
}

@INPROCEEDINGS{11075100,
  author={Cha, Seon Yong},
  title={Driving Innovation in DRAM Technology — Towards a Sustainable Future},
  abstract={Since the introduction of the 6F2 Buried Gate Scheme in the early 2010s, DRAM technology has been continuously scaled down to 10nm class technology. Beyond 10nm, however, the evolution of DRAM technology has reached an inflection point where it is difficult to build scalable platforms using existing cell schemes and necessary to change DRAM cell schemes. In response to the inflection point, this paper will review how cell schemes will change to ensure a scalable platform and can innovate in a way that delivers value of DRAM in the future.},
  keywords={Economics;Technological innovation;Uncertainty;Reviews;Ecosystems;Electronics industry;Random access memory;Companies;Very large scale integration;Logic gates},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075100},
}

@INPROCEEDINGS{11074833,
  author={Chen, John Y.},
  title={Innovate VLSI for AI Growth},
  abstract={AI is built on VLSI by the amazing Moore's law which is ended, but we need VLSI more than ever in AI era. So, what's next? It's innovation, innovate from materials, devices, modules to systems. This speech presents the progress of VLSI from the past decade and highlights the most complicated VLSI chip today. Innovation is easier said than done. What are the criteria and barriers for success and the leadership needed to cultivate innovation? The speaker's career has lived through the relationship between VLSI and AI, their similarity, synergism and reinforcement that accelerates their thriving growth. With AI taking away routine and complicated tasks, the author answers the question of what young people should be doing. While AI is becoming such a powerful tool, the leaders and engineers must help to grow ethics and morality for the mankind.},
  keywords={Semiconductor device modeling;Technological innovation;Leadership;Ethics;Engineering profession;Moore's Law;Very large scale integration;Artificial intelligence},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074833},
}

@INPROCEEDINGS{11074926,
  author={Loh, Kou-Hung Lawrence},
  title={Enabling Generative AI: Innovations and Challenges in Semiconductor Design Technologies},
  abstract={In recent years, Generative AI has transformed a wide range of domains, from everyday applications to cutting-edge scientific research. This rapid advancement has driven a substantial increase in the demand for computing, connectivity, communication, and memory/data storage across data centers, infrastructure, and edge devices. As a result, there has been a notable surge in industrial investment in “hard tech,” encompassing advanced materials, packaging, and semiconductor process technologies. These investments are aimed at developing next-generation hardware accelerators, both wired and wireless connectivity solutions, and heterogeneous integration at the chip and system levels, all underpinned by significant research and development efforts. In this paper, we will explore the latest technologies and address the challenges involved in creating high-performance computing and high-speed connectivity solutions, with a particular focus on energy efficiencies to enable Generative AI. We will also examine issues related to power distribution and other engineering complexities that arise in these advanced systems. Our discussion will highlight the critical role of technological challenges and innovations in ensuring the longterm sustainability and continued progress of these technologies in the decades ahead.},
  keywords={Wireless communication;Technological innovation;Data centers;Generative AI;Power distribution;Very large scale integration;Energy efficiency;Sustainable development;Voltage control;Investment},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074926},
}

@INPROCEEDINGS{11075169,
  author={Cremonesi, Alessandro},
  title={The Evolution of Edge AI: Contextual Awareness and Generative Intelligence},
  abstract={We are witnessing a rapid transition from traditional AI to generative AI in the cloud. This is driving increased demands in the high-performance computing domain. However, to support this shift sustainably, edge AI technologies are advancing, including hardware accelerators (NPU) in microcontrollers and disruptive technologies like in-memory and neuromorphic computing. These developments, along with optimized large language models, enable more efficient. AI and generative AI solutions for edge products. Contextual awareness has profound transformative potential for AI for edge devices. Advanced sensing technologies and generative AI will revolutionize interactions with the world, allowing AI to adapt based on localized experiences and migrate seamlessly across devices. These innovations will drive the future of technology, making it more cognitive, generative, and interactive, ultimately leading to smarter, more connected and more sustainable solutions.},
  keywords={Technological innovation;Generative AI;Neuromorphic engineering;Large language models;High performance computing;Edge AI;Very large scale integration;In-memory computing;Intelligent sensors;Hardware acceleration;Edge AI;contextual awareness;sustainable AI;smart sensors;in-memory computing and LLMs},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075169},
}

@INPROCEEDINGS{11075006,
  author={Fischer, K. and Abboud, F. and Aggarwal, R. and Amin, P. and Anand, S. and Asoro, M. and Atay, C. and Auth, C. and Aykol, M. and Badmaev, A. and Bains, B. and Beckwitt, K. and Bell, J. and Bellah, M. and Bhawe, D. and Birdsall, J. and Blanton, W. and Bondi, J. and Bowonder, A. and Brooks, J. and Buehler, M. and Burgess, S. and Byon, K. and Casillas, D. and Chakraborty, S. and Chan, T. and Charue-bakker, S. and Chatterjee, A. and Chin, S. and Choi, C.J. and Collins, D. and Crum, D. and Danon, A. and Das, N. and Das, R. and Dhar, A. and Ehlert, R. and Elfick, P. and Freeman, G. and Ganesan, K. and Ghani, T. and Ghostine, R. and Golonzka, O. and Greene, B. and Greve, H. and Grimm, W. and Guerrero, J. and Guha, B. and Guo, Z. and Gupta, P. and Hafez, W. and Han, C.W. and Harris, D. and Hattendorf, M. and Havelia, S. and Hicks, J. and Ho, I. and Wang, X. and Horsch, M. and Hsu, W. and Hu, L. and Jaloviar, S. and Jamieson, A. and Joushaghani, A. and Kamysbayev, V. and Karl, E. and Kelgeri, S. and Kelleher, A. and Kim, A. and Kirby, S. and Klopcic, S. and Knudsen, J. and Kobaku, S. and Kobrinsky, M. and Kothari, H. and Lawrence, D. and Leib, J. and Lin, C-H. and Lin, C-Y. and Lin, C. and Malyavanatham, G. and Mandal, S. and Mandal, S. and Mani, S. and Marinkovic, B. and Matsubayashi, A. and Mckenna, E. and Mehandru, R. and Mehta, J. and Mehta, N. and Meister, S. and Mishra, V. and Mistry, K. and Moore, A. and Mudanai, S. and Murugavel, A. and Natarajan, S. and Paik, S. and Panchamgam, S. and Pantuso, D. and Paredes, I. and Park, K. and Parker, J. and Parks, B. and Patel, R. and Patil, S. and Paul, P.K. and Perkins, J. and Pipes, L. and Prasad, C. and Prince, M. and Puls, C. and Rahman, F. and Rajamani, S. and Ramaswamy, R. and Rossow, S. and Russell, R. and Saadat, O. and Sabih, O. and Samant, S. and Sarkar, B. and Schulman, D. and Sharma, M. and Sharma, N. and Shim, H. and Singh, C. and Sinha, P. and Smith, A. and Somaia, S. and Sriram, M. and Staus, C. and Steigerwald, J. and Stoeger, J. and Strutt, N. and Su, C-Y. and Tanaka, A. and Thakurta, D. and Towner, D. and Von Haartmann, M. and Wallace, C. and Wang, B. and Ward, C. and Weybright, M. and Wu, T-H. and Xu, G. and Yadav, M. and Zavestoski, J. and Zhang, Z. and Zhou, S. and Sell, B.},
  title={Intel 18A Platform Technology Featuring RibbonFET (GAA) and PowerVia for Advanced High-Performance Computing},
  abstract={An advanced Intel 18A technology featuring RibbonFET and PowerVia provides over 30% density scaling and a full node of performance improvement compared to Intel 3. Intel 18A achieved 18%/25% performance (0.75V/1.1V) at iso-power over Intel 3 through an industry-first combination and optimization of advanced interconnects, a Gate-All-Around (GAA) transistor architecture, backside power, and design co-optimization. Intel 18A offers high-performance (HP) and high-density (HD) libraries with full-featured technology design capabilities and enhanced design ease of use.},
  keywords={High performance computing;Gallium arsenide;Integrated circuit interconnections;Computer architecture;Very large scale integration;Logic gates;Libraries;Transistors;Optimization},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075006},
