  author={Cha, Seon Yong},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Driving Innovation in DRAM Technology — Towards a Sustainable Future}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Since the introduction of the 6F2 Buried Gate Scheme in the early 2010s, DRAM technology has been continuously scaled down to 10nm class technology. Beyond 10nm, however, the evolution of DRAM technology has reached an inflection point where it is difficult to build scalable platforms using existing cell schemes and necessary to change DRAM cell schemes. In response to the inflection point, this paper will review how cell schemes will change to ensure a scalable platform and can innovate in a way that delivers value of DRAM in the future.},
  keywords={Economics;Technological innovation;Uncertainty;Reviews;Ecosystems;Electronics industry;Random access memory;Companies;Very large scale integration;Logic gates},
