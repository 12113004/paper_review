  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 142Mw 6.4Gbps Massive MU-MIMO RSMA Detector for Next-Generation Communication Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={This work presents the first rate-splitting multiple access (RSMA) detector for massive multiuser multi-input, multioutput (MU-MIMO) systems. The proposed detector supports $256 \times 32$ MIMO configuration with up to 256-QAM modulation. A polar decoder with a code length of 128 bits is included for error correction. The iterative detection architecture reduces the latency by 98 %. The chip achieves a maximal throughput of 6.4 Gbps with 142 mW power at 200 MHz. Compared to the state-of-the-art space-division multiple access (SDMA) detectors, this work achieves 3.3 -to- $3.6 \times$ higher throughput and 2.0 -to- $4.5 \times$ higher energy efficiency, in addition to the better error performance in correlated channels.},
  keywords={Modulation;Detectors;Very large scale integration;Throughput;Energy efficiency;Error correction codes;Multiaccess communication;Iterative methods;Next generation networking;Iterative decoding},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075000},
