  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Prototype 16Mbit RRAM on 55nm BCD with 56% Compact-Area Wordline Driver and Constant Write-Current Scheme for Automotive 150°C Operation}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={A prototype 16Mbit embedded RRAM macro is implemented on 55nm BCD technology targeting automotive applications. This macro implements a compact wordline driver (WLDRV) circuit using thin oxide 1.2V core MOSs and thick oxide 5V MOS devices reducing area without speed penalty. To support automotive 150°C operation, it also uses master and local current limiters and local write drivers with wide-range temperature compensation. It realizes constant cell current anywhere on a die and stable operation at 150° C. The macro density is 2.56Mbit/mm2 and operation at 150°C with 1K endurance has been achieved.},
  keywords={Automotive applications;Prototypes;Very large scale integration;Current limiters;MOS devices;Driver circuits;RRAM;Automotive;WLDRV;Current limiter},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075037},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11074835,
  author={Chang, Jeongtaek and Lee, Jungho and Shen, Yi and Yun, Sangbu and Zhang, Qirui and Sylvester, Dennis and Kim, Hun-Seok and Blaauw, David},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.71nJ, 1.53GS/s Throughput 256-FFT Using Floating Point Analog Computation}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={We propose a 256-point FFT engine using the first analog floating point implementation. The proposed method encodes the mantissa value with both voltage and pulse width and a digital 4-bit exponent. It features automatic calibration to cancel process variation and attains precision and dynamic range equivalent to 12.3 bit digital fixed point. Implemented in 22 nm CMOS, the chip demonstrates the first reported sub-nJ energy/FFT (0.71 nJ) at a high throughput of $1.53 \text{GS} / \mathrm{s}$.},
  keywords={Voltage;Very large scale integration;Dynamic range;Throughput;Calibration;Engines},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074835},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11075164,
  author={Bejarano-Carbó, Andrea and Tseng, Chien-Wei and Komma, Demba and Abillama, Pierre and Fan, Zichen and Sylvester, Dennis and Kim, Hun-Seok and Blaauw, David},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An OFDMA Baseband Processor Enabling $165\mu \mathrm{W}$ Long-Range IoT Localization}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={We present an OFDMA baseband localization processor fabricated in 22nm, co-designed with a low-power, crystal-less narrowband RF receiver chip that efficiently estimates the channel frequency response in real-time for localization. The localization processor consumes 1.52/2.04mW for 2/3D localization processing, and duty-cycles the RF receiver achieving 247nW standby power. The combined system achieves a localization distance of 430m, a 4.3× improvement over state-of-the-art, while maintaining comparable accuracy. We deploy this system in a $1\times 2.8$ cm IoT localization tag with $165\mu \mathrm{W}$ average power at 0.1 Hz location acquisition rate.},
  keywords={Location awareness;Radio frequency;Baseband;Accuracy;Channel estimation;Receivers;Very large scale integration;Real-time systems;Frequency response;Narrowband},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075164},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11075179,
  author={Lu, Jiahao and Liu, Dongsheng and Zhang, Jiaming and Huang, Tianze and Li, Kai and Wu, Cheng and Chen, Lei and Hu, Ang and Luo, Zhixiang and Zou, Xuecheng},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 28nm 84.9KOPS 1.82µJ/op RISC-V Crypto-SoC with Primitive-Based Deep-Coupling Unified Post-Quantum Engine}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents the first RISC-V cryptographic System-on-Chip (SoC) that supports the latest NIST-released Federal Information Processing Standards (FIPS) for post-quantum cryptographic (PQC). It has three key features: 1) RV-dedicated deep-coupling post-quantum engine with dual-rail parallel scheduling. 2) Vectorized instruction-driven computational workflow. 3) Primitive-based fine-grained operator design for multi-scheme reconstruction. The proposed crypto-SoC achieves a throughput of 84.9KOPS and an energy efficiency of 1.82µJ/op in 28nm, demonstrating 1.22-5.84x and 2.41-4.68x improvements in throughput and energy efficiency, respectively, compared to the state-of-the-art design.},
  keywords={Processor scheduling;Information processing;Very large scale integration;Throughput;Energy efficiency;System-on-chip;Cryptography;Engines;Standards},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075179},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11074811,
  author={Chiou, Bo-Cheng and Lin, Chih-Sheng and Ho, Yun-Ting and Lin, Yu-Hui and Wu, I-Ta and Tseng, Kuo-Hua and Lai, Chih-Ming and Mei, Peng-I and Li, Sih-Han and Chang, Shan-Ming and Sheu, Shyh-Shyuan and Lo, Wei-Chung and Chang, Shih-Chieh and Hou, Tuo-Hung},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Enabling Privacy-Preserving Collective Intelligence: A Twin In-Memory Encryption/Processing Macro Featuring Group Differential Privacy and Spatial-Temporal Ensemble}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={Privacy protection is a critical concern in AI, particularly in collective AI systems such as AIoT networks and federated learning. To address correlation attacks involving multiple data sources, this study presents a 22 nm twin in-memory encryption/processing (TIME) macro that integrates group differential privacy (GDP) and spatial/temporal ensemble (STE) techniques. This design enables efficient privacy protection while maintaining high accuracy, achieving 82% prediction accuracy for federated vital signs monitoring at a privacy protection strength of 2.3. With a 1Mb capacity, the system delivers a 10.49 TOPS throughput and achieves an energy efficiency of 5827 TOPS/W, highlighting its strong potential for privacy-preserving collective AI applications.},
  keywords={Privacy;Accuracy;Correlation;Economic indicators;Gaussian noise;Very large scale integration;Energy efficiency;Protection;Artificial intelligence;Monitoring},
  doi={10.23919/VLSITechnologyandCir65189.2025.11074811},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11075224,
