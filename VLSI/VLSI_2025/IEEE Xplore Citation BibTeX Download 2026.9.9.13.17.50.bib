@INPROCEEDINGS{11075140,
  author={Youn, Woongro and Youn, Donghyun and Seong, Hoyong and Ha, Sohmyung and Je, Minkyu},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Temperature-Insensitive Period-Modulation CDC with DLL-Based Comparator Delay Compensation Achieving 53.5ppm/°C without Calibration}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a temperature-insensitive period-modulation (PM) capacitance-to-digital converter (CDC) with a delay-locked-loop (DLL) based compensation alleviating temperature-dependent comparator delays. Moreover, a half-period alternate-sampling technique is proposed to track the comparator offset and mitigate its variation in a swing-boosted front-end. Our 180nm CMOS prototype achieves 53.5ppm/°C output variation over -40 to 85°C without any calibration or external clock. The conversion achieves the best $\text{FoM}_{\mathrm{w}}$ of 6.0pJ/conv.step among temperature-insensitive PM CDCs.},
  keywords={Prototypes;Very large scale integration;Capacitance;Delays;Calibration;Clocks},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075140},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{11075036,
  author={Qiu, Siyuan and Song, Xiaoyi and Song, Xiangjie and Zhou, Changchun and Song, Xiaoyan and Yang, Jie and Wang, Wenjin and Yang, Yuchao and Jiao, Hailong},
  booktitle={2025 Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={PANDA: A 3.178 TOPS/W Reconfigurable Seizure Prediction ANd Detection Neural Network Accelerator for Epilepsy Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={PANDA, a reconfigurable seizure prediction and detection neural network accelerator, is presented. A lightweight twostage seizure monitoring framework with temporal neural network splitting is proposed to be deployed on PANDA. Channel first-output stationary dataflow with zero activation skipping and weight cache with statistical information are employed for higher energy efficiency. A flexible instruction set is defined to make PANDA highly configurable. For seizure monitoring, PANDA achieves up to 99% sensitivity, 0.43/h false alarm rate (FAR), and 3.178 TOPS/W energy efficiency.},
  keywords={Sensitivity;Instruction sets;Neural networks;Epilepsy;Very large scale integration;Energy efficiency;Monitoring},
  doi={10.23919/VLSITechnologyandCir65189.2025.11075036},
  ISSN={2158-9682},
