  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Stochastic Analog SAT Solver in 65nm CMOS Achieving $\mathbf{6.6}\mathbf{\mu}\mathbf{s}$ Average Solution Time with 100% Solvability for Hard 3-SAT Problems}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a stochastic analog SAT solver, featuring a fast open-loop architecture with continuous-time self-loopback pull-up switches, a discrete-time scrambling scheme, and a cost-efficient hybrid random code generator. The SAT prototype in 65nm CMOS achieves orders of magnitude improvement in speed and energy efficiency compared to prior ASIC (digital and analog) SAT solvers.},
  keywords={Codes;Prototypes;Very large scale integration;CMOS technology;Hybrid power systems;Generators;Energy efficiency;SAT;COP;analog;accelerator;stochastic;CMOS},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631503},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631550,
  author={Yang, Jee-Eun and Jang, Younjin and Han, Na-Rae and Sung, Ha-Jun and Kim, Jung-kyun and Cha, Youngkwan and Lee, Kwang-Hee and Jung, Kyooho and Jung, Moonil and Lee, Wonsok and Cho, Min Hee and Kim, Sangwook},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A-IGZO FETs with High Current and Remarkable Stability for Vertical Channel Transistor(VCT) / 3D DRAM Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We report the a-IGZO channel FET exhibited high Ion ($22\mu \mathrm{A}/\mu \mathrm{m}$ with $\mathrm{V}_{\text{GS}}=\mathrm{V}_{\text{th}}+1\mathrm{V}$ and $\mathrm{V}_{\text{DS}}=1\mathrm{V}$) and excellent NBTI characteristics ($\Delta \mathrm{V}_{\text{th}} < 1\ \text{mV}$ at 3 MV/cm, 85 °C). In order to realize such a high performance device, there are several considerations, one of which is finding the optimal composition that increases mobility and keeps device reliability characteristics stable, and the next is to understand the effects of various process conditions on channel behavior and effectively suppress oxygen vacancies (Vo) while lowering hydrogen (H) concentration. Specifically, we tried to apply an interlayer to contact metal, reduced the H in the bottom oxide, and finally optimized the condition of a gate oxide (Gox) process and O2 treatment method that could efficiently minimize defect states in the device.},
  keywords={Negative bias temperature instability;Performance evaluation;Three-dimensional displays;Thermal variables control;Random access memory;Metals;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631550},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631373,
  author={Liu, Juzheng and Shabra, Ayman and Ho, Stacy and Manganaro, Gabriele and Shuo- Wei Chen, Mike},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 16GS/s 10b Time-domain ADC using Pipelined-SAR TDC with Delay Variability Compensation and Background Calibration Achieving 153.8dB FoM in 4nm CMOS}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The paper presents a direct-RF sampling time-domain ADC achieving 16GS/s 10-bit conversion using merely 4x time-interleaving in 4nm. A redundancy-based TDC delay variability compensation scheme, a background delay offset calibration scheme, and a bottom-plate sampling VTC structure are proposed to achieve high SNR and linearity. The ADC achieves a 55.93dB SFDR and a 44.48dB SNDR at Nyquist with 94.2m W power consumption and $8000\text{um}^{2}$ active area, leading to a state-of-the-art 153.8dB Schreier FoM.},
  keywords={Power demand;Linearity;Very large scale integration;CMOS technology;Delays;Calibration;Time-domain analysis},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631373},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631482,
  author={Min, Kyunghwan and Jin, Jahoon and Lee, Soo-Min and Ju, Sodam and Yook, Jisu and Lee, Jihoon and Hong, Yunji and Park, Sung-Sik and Kim, Sang-Ho and Lee, Jongwoo and Ko, Hyungjong},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 20Gb/s/pin Single-Ended PAM-4 Transceiver with Pre/Post-Channel Switching Jitter Compensation and DQS-Driven Biasing for Low-Power Memory Interfaces}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a 20Gb/s/pin single-ended PAM-4 transceiver with advanced switching jitter compensation (SWJC) technique. The SWJC operates independently of equalization, hence further improving timing margin from 0.26UI to 0.39UI at a Ie-I2 BER. The proposed pre-channel SWJC at a transmitter side minimizes switching jitter (SWJ) of middle eye, modulating the transitions of top and bottom eyes in a beneficial way for SWJC at a receiver side. Ultimately, along with the proposed SWJC technique, the timing margins improved by SWJC at a receiver side are further increased, having overheads only 1.6% in power and 0.22% in area.},
  keywords={Transmitters;Switches;Receivers;Jitter;Very large scale integration;Transceivers;Timing;single-ended;PAM-4 transceiver;switching jitter compensation;amplifier biasing;memory interface},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631482},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631328,
  author={Shuto, Yusuke and Okuno, Jun and Yonai, Tsubasa and Ono, Ryo and Reinig, Peter and Lederer, Maximilian and Seidel, Konrad and Alcala, Ruben and Mikolajick, Thomas and Schroeder, Uwe and Umebayashi, Taku and Akiyama, Kentaro},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={HZO-based Nonvolatile SRAM Array with 100% Bit Recall Yield and Sufficient Retention Time at 85°C}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={For the first time, a 16-Kbit nonvolatile SRAM (NVSRAM) array based on a metal/ferroelectric/metal capacitor using a sub-10-nm-thick HfZrOx (HZO) layer has been experimentally demonstrated to obtain 100% bit yield. This capacitor is formed using the same integration process as that of a previously developed ferroelectric random-access memory (FeRAM) array on the same wafer. Its sequential operations of nonvolatile data store (Store), cutoff of power supply (power-gating: PG), and data recall (Recall) are completely executed employing a robust Recall sequence, achieving 100%-bit recall after a 200-s PG period at 85 ° C even with sufficiently low operation voltage. The results indicate that our HZO-based NVSRAM and FeRAM hybrid memory system can provide ultra-low power advantages in a System-on-Chip for Internet of Things edge computing.},
  keywords={Program processors;Nonvolatile memory;Ferroelectric films;Capacitors;Random access memory;Voltage;Very large scale integration;hafnium oxide;ferroelectric capacitor;power-gating;nonvolatile SRAM},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631328},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631456,
  author={Myung, Sanghoon and Shin, Donggwan and Kim, Kyeyeop and Choi, Yunji and Kang, Gijae and Han, Songyi and Jeong, Jaehoon and Kim, Dae Sin},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A New Industry Standard Compact Model Integrating TCAD Into SPICE}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a complete neural compact model (NCM) that can be used in industry for the first time. This supports not only the features of the standard PDK but also the new features that can vary the process conditions in SPICE such as TCAD simulation. Hence, we dub this “Technology Design Kit (TDK)” to distinguish it from standard PDK. With TDK, we enhanced AC performance by 5% and reduces the optimization time by 45,000 times compared to traditional DTCO. TDK will be a new industry standard for the emerging devices in the future.},
  keywords={Industries;Performance evaluation;Very large scale integration;SPICE;Standards;Optimization},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631456},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631419,
  author={Chua, Adelson and Pandey, Aviral and Kaveh, Ryan and Alamouti, Sina Faraji and Doong, Justin and Muller, Rikky},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={SPIRIT: A Seizure Prediction SoC with a 17.2nJ/cls Unsupervised Online-Learning Classifier and Zoom Analog Frontends}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents SPIRIT, an SoC integrating an unsupervised online-learning seizure prediction classifier with eight $14.4\mu \mathrm{W},\ 0.057\text{mm}^{2},\ 90.5\text{dB}$ dynamic range, Zoom Analog Frontends. SPIRIT achieves, on average, 97.5%/96.2% sensitivity/specificity, predicting seizures an average of 8.4 minutes before they occur. Its classifier consumes $17.2\mu \mathrm{W}$ and occupies 0.14mm2, the lowest reported for a prediction classifier by $> 134\mathrm{x}$ in power and $> 5\mathrm{x}$ in area.},
  keywords={Tracking loops;Semiconductor device measurement;Sensitivity;Memory management;Very large scale integration;Prediction algorithms;Feature extraction;machine learning;unsupervised online learning;seizure prediction;tinyML;Zoom ADC;neural recording},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631419},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631446,
  author={Teh, Chen Kong and Bi, Te and Ito, Shuichi and Kurihara, Takashi},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={730-790mA/mm2 48V-to-1V Integrated Hybrid DC-DC Converters Based on a Star-Delta Switching Network with 5x/8x Duty Expansion}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present 48V-to-1V non-isolated dc-dc converters with up to 790mA/mm2 current density and 88% peak efficiency, realized by a star-delta topology providing 5x and 8x duty expansion with only 3 and 4 Cfly, respectively. Despite multiple internal connects, line/load transient responses are comparable to the conventional buck converter. A gate driver with a capacitive reducing scheme is proposed for reducing 87% capacitance.},
  keywords={Buck converters;Very large scale integration;Gate drivers;Capacitance;Topology;Transient analysis;Current density},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631446},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631421,
  author={Chen, Chi-Yu and Wang, Tz-Wun and Chiu, Po-Jui and Hung, Sheng-Hsi and Go, Chang-Lin and Wu, Xiao-Quan and Huang, Yu-Ting and Chen, Ke-Horng and Zeng, Kuo-Lin and Lin, Ying-Hsi and Lin, Shian-Ru and Tsai, Tsung-Yen},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Monolithic GaN-based Gate Driver for LLC-SRC with Three-Phase Startup Clamping Achieving 23.2μA IQ and 98.6% Peak Efficiency}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={To meet Energy Star and 80 Plus Titanium standards, the proposed hybrid gate driver reduces the quiescent current (IQ) to 23.2μA by reducing GaN leakage current. The proposed auto-precharge (APC) technique can reduce the leakage current (ILKG) in standby mode from a few milliamperes to 60.4μA, resulting in an efficiency greater than 92% at the entire output load. In addition, soft-start clamping (SSC) technique reduces the peak voltage from 2.51kVto 620V, safely reducing power consumption during soft-start. As a result, the LLC converter achieves a peak efficiency of 98.6%.},
  keywords={Power demand;Stars;Voltage;Very large scale integration;Titanium;Gate drivers;Leakage currents},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631421},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631514,
  author={Chiu, Po-Jui and Wang, Tz-Wun and Chen, Chi-Yu and Hung, Sheng-Hsi and Huang, Yu-Ting and Wu, Xiao-Quan and Chen, Ke-Horng and Zheng, Kuo-Lin and Li, Chih-Chen},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 15.4ppm/○C GaN-based Voltage Reference with Process-Variation-Immunity and High PSR for EV Power Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The proposed GaN-based voltage reference (VREF) generator (VRG) has a low temperature coefficient (TC) of $15.4\text{ppm}/{}^{\circ}\mathrm{C}$, a small deviation of VREF at different process corners with a standard deviation of 0.22%, a great line sensitivity of 0.0023%/V, and a great power-supply rejection (PSR) of -187dB and -114dB at 100Hz and 50MHz, respectively. The proportional-to-absolute-temperature (PTAT) IG of enhancement-mode GaN (eGaN) can optimize TC. Eliminating the IG of depletion-mode GaN (dGaN) and using multiple stacked composite dGaN can improve line regulation and PSR. All performance is achieved with a low power consumption of $10.9\mu \mathrm{W}$.},
  keywords={Temperature sensors;Sensitivity;Power demand;Very large scale integration;Regulation;Generators;Power systems},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631514},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631424,
  author={Morimoto, K. and Isoda, N. and Sekine, H. and Sasago, T. and Maehashi, Y. and Mikajiri, S. and Tojima, K. and Shinohara, M. and Abdelghafar, A. and Tsuchiya, H. and Inoue, K. and Omodani, S. and Chida, K. and Ehara, A. and Iwata, J. and Itano, T. and Matsuno, Y. and Sakurai, K. and Ichikawa, T.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={3D-Stacked 1Megapixel Time-Gated SPAD Image Sensor with 2D Interactive Gating Network for Image Alignment-Free Sensor Fusion}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a 5μm-pitch, 3D-BSI 1Mpixel time-gated SPAD image sensor with 2D interactive gating network, enabling image alignment-free sensor fusion. The SPAD image sensor operates at 1,310fps for global shutter 2D imaging, and event vision sensing with 0.76ms temporal resolution under 0.02lux. Range-gated imaging result demonstrates a feasibility of robust imaging under harsh environments. The proposed gating network architecture enables background suppression in 3D depth measurement under 50klux ambient light.},
  keywords={Image sensors;Three-dimensional displays;Image resolution;Very large scale integration;Sensor fusion;Network architecture;Sensors},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631424},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631534,
  author={Yoo, Sijung and Kim, Donghoon and Choe, Duk-Hyun and Lee, Hyun Jae and Lee, Yunseong and Jo, Sanghyun and Park, Yoonsang and Kim, Ki Hong and Jung, Kyooho and Jung, Moonil and Lee, Kwang-Hee and Yang, Jee-Eun and Kim, Sangwook and Nam, Seung-Geol},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Highly Enhanced Memory Window of 17.8V in Ferroelectric FET with IGZO Channel via Introduction of Intermediate Oxygen-Deficient Channel and Gate Interlayer}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We demonstrated a novel Ferroelectric Field-Effect Transistor (FeFET) with an IGZO channel, featuring a record-high memory window (MW) of up to 17.8V. A significant advancement is achieved by two strategies. Firstly, the introduction of an intermediate oxygen-deficient channel, which offers sufficient depletion charge to ensure full-loop polarization switching. Secondly, inserting a thin gate interlayer (G.IL), which further increases the MW by the contribution of injected charge through G.IL. With a sub-12nm gate stack thickness and an operation voltage below 15V, the device exhibits promising potential for high-density, low-power non-volatile memory applications.},
  keywords={Electric potential;Nonvolatile memory;Voltage;Switches;Logic gates;Very large scale integration;Energy efficiency},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631534},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631370,
  author={Kim, Junsoo and Lee, Hyun Jung and Jang, Sung Ho and Lee, Jun Bum and Kim, Il Gweon and Oh, Jeonghoon and Park, Jemin and Song, Jaihyuk},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Metal Dual Work-Function Gate (MDWG) for the Continuous Scaling of DRAM Cell Transistors}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The current dual work function gate (DWFG), utilizing Poly Si, which is applied as a standard in conventional DRAM products, is facing the issue of an exponential increase in word line (WL) resistance. For the continuous scale-down of DRAM cell transistors, we have demonstrated, for the first time, a metal dual work function gate (MDWG) by replacing n+ Poly Si with an Oxide/La (Lanthanum) /TiN structure in a fully integrated 1z-nm 16Gb DRAM. We confirmed a 40% improvement in retention time without an increase in WL resistance compared to the cell transistors with a single work function gate (SWFG).},
  keywords={Resistance;Random access memory;Logic gates;Very large scale integration;Tin;Silicon;Lanthanum},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631370},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631331,
  author={Park, Sungjin and Shin, Kwanghyun and Lee, Dongkwon and Kang, Minyoung and Lee, Sunwoo and Park, Youngmin and Seok, Mingoo and Jeon, Dongsuk},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 5.6µW 10-Keyword End-to-End Keyword Spotting System Using Passive-Averaging SAR ADC and Sign-Exponent-Only Layer Fusion with 92.7% Accuracy}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a 10-keyword end-to-end keyword spotting (KWS) system. Passive averaging effectively improves the analog front-end (AFE) SNR with a small power overhead of 20nW. A sign-exponent-only layer fusion scheme reduces the model size and multiplication power overhead by 63.5% and 29.8%, respectively, maintaining the KWS accuracy. Fabricated in 65nm CMOS, the design provides the highest accuracy of 92.7% and the lowest power consumption of 5. 6Jl W compared to prior arts aimed at 10 keywords.},
  keywords={Semiconductor device modeling;Accuracy;Power demand;Art;Very large scale integration;Signal to noise ratio},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631331},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631484,
  author={Yang, Jiyue and Graening, Alexander and Romaszkan, Wojciech and Jacob, Vinod K. and Gupta, Puneet and Pamarti, Sudhakar},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 278-514M Event/s ADC-Less Stochastic Compute-In-Memory Convolution Accelerator for Event Camera}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a Compute-In-Memory (CIM) convolution accelerator for object tracking applications using event camera, which is a new imaging technology that significantly improves latency and dynamic range over conventional cameras. Previous works proposed an efficient ADC-Iess Stochastic CIM for deep learning but need to store $2^{\mathrm{N}}$ stochastic bits for an n-bit number. We propose to store binary numbers in memory and convert them to stochastic bits by in-situ Stochastic Number Generators on the fly, which reduce the storage requirement by >10x. The CIM macro embeds 32 tiny MAC units per weight and uses an early termination technique to skip unnecessary computation of zeros. The accelerator achieves energy efficiency of 485 TOPS/Wand throughput of 278–514 Mevent/s. The proposed SCIM macro can also be used to accelerate convolution in most deep learning applications.},
  keywords={Deep learning;Convolution;Very large scale integration;In-memory computing;Cameras;Throughput;Energy efficiency;Compute-In-Memory Accelerator;Event Camera},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631484},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631517,
  author={Lu, Tsung-Che and Fu, Chin-Ming and Wang, Wei-Hsiang and Kuo, Fred and Chang, Chih-Hsien and Hsieh, Kenny and Tam, King-Ho and Huang, Tze-Chiang and Chen, Tom and Wong, Mei and Changchien, Wei-Pin and Lee, Frank},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An On-Chip Current-Sink-Free Adaptive-Timing Power Impedance Measurement (PIM) Unit for 3D-IC in 5nm FinFET Technology}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents a power impedance measurement (PIM) architecture for the 3D-IC platform with high-performance computing (HPC) applications. Proposed current-sink-free architecture improves stimulus current capacity without area overhead. Another adaptive-timing scheme saves 50% testing time. The PIM IP has been fabricated in 5nm FinFET process with TSMC-SoIC® technology for characterization of an embedded ARM® core. Compared to state-of-the-art works, the 3.6-A stimulus current yields 116x improvement while the 0.006 mm2 core area achieves 79% reduction.},
  keywords={Impedance measurement;High performance computing;Computer architecture;Very large scale integration;FinFETs;System-on-chip;IP networks},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631517},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631535,
  author={Derksen, Sander and Demarets, Maël and Piqué, Gerard Villar and Sebastiano, Fabio},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.9V Rail-to-Rail Ultra-Low-Power Fully Integrated Clock Generator Achieving 23fJ/Cycle in 28nm CMOS}, 
  year={2024},
  volume={},
