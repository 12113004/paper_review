  title={A 56-Gb/s 17-mW NRZ Receiver in 0.018 mm2}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={An NRZ receiver incorporates new architecture and circuit techniques to achieve a low power and area consumption. Realized in 28-nm CMOS technology, the full-rate RX operates at 56 Gb/s with a bit error rate less than 10−12 for a channel loss of over 25 dB at 28 GHz.},
  keywords={Bit error rate;Receivers;Very large scale integration;CMOS technology;Optical signal processing;NRZ;wireline;receiver;low-power},
