  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Novel Phase Change Material RF Switch with 16nm Technology to Achieve Low Voltage and Low Ron*Coff for mmWave}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present an enhanced phase change material (PCMe) RF switch (RFS) to achieve an impressive Ron*Coff of 11.6fs and operates below 1.8V. The PCMe material has low-resistivity that exhibits 40% insertion loss (IL) improvement compared to Ge50Te50, which is greater than -0.5dB, and isolation (ISO) less than -28dB at 30GHz. The switch operates 100 million cycles at -40C and 125C with stable Ron, and the transistor underneath is unaffected after RESET/SET 10Mc operations.},
  keywords={Radio frequency;Phase change materials;Low voltage;ISO;Switches;Insertion loss;Very large scale integration},
