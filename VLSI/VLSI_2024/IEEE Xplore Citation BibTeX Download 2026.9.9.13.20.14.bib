  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631528,
  author={Zhang, Qiaochu and Su, Shiyu and Biswas, Baishakhi Rani and Gupta, Sandeep and Chen, Mike Shuo-Wei},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Synthesizable 10-bit Stochastic TDC Using Common-Mode Time Dithering and Passive Approximate Adder with 0.012mm2 Active Area in 12nm FinFET}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents 10-bit fully synthesizable stochastic TDC (STDC) design with common-mode time dithering and passive approximate adder for lowering implementation cost while maintaining a high linearity. Two STDC prototypes in 12nm FinFET are implemented with conventional adder and passive approximate adder, respectively. STDC prototypes achieve energy efficiency of ∼160dB, while the one using passive approximation adder achieves area efficiency of $19.1\mu \mathrm{m}^{2}/\text{step}$.},
  keywords={Costs;Prototypes;Linearity;Very large scale integration;FinFETs;Energy efficiency;Adders;Synthesizable;TDC;DTC;stochastic;FinFET},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631528},
