  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A uW Output Power, >100V, Single-Capacitor Switched DC-DC Up/Down Converter}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents a switched capacitor high voltage (HV) DC-DC converter with a single off-chip flying capacitor (SOF) for uW current draw applications. This converter is capable of up-conversion as well as down-conversion using the same ladder. It achieves efficiency of 62% in up-conversion mode (175V output) and 43% in down-conversion mode (184V input). Up-conversion efficiency is 16× higher than state-of-the-art converters with> 100V output and nA output load.},
  keywords={Capacitors;Switches;High-voltage techniques;DC-DC power converters;Very large scale integration;Power generation;Switching circuits},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631439},
  ISSN={2158-9682},
