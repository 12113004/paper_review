  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={EOT Scaling Via 300mm MX2 Dry Transfer - Steps Toward a Manufacturable Process Development and Device Integration}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We demonstrate a low-temperature automation-compatible, and reproducible 300mm MX2 dry transfer process. We have successfully transferred 300mm WS2 in a repeatable process flow with >99.5% morphological yield. In-FAB integrated transistors fabricated via this route have >99% electrical yield on best wafers and is comparable to that obtained from analogous direct-grown WS2 integrated wafers. Further, we also demonstrate back-EOT scaling down to 2nm that is otherwise out of scope via high temperature direct growth. This transfer process facilitates a viable route to implement scaled MX2 devices for FEOL CFET, and BEOL active circuits.},
  keywords={Field effect transistors;Logic gates;Very large scale integration;Tin;Optical imaging;Dielectrics;Epitaxial growth},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631364},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631529,
  author={Paulin, Gianna and Scheffler, Paul and Benz, Thomas and Cavalcante, Matheus and Fischer, Tim and Eggimann, Manuel and Zhang, Yichao and Wistoff, Nils and Bertaccini, Luca and Colagrande, Luca and Ottavi, Gianmarco and Gürkaynak, Frank K. and Rossi, Davide and Benini, Luca},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Occamy: A 432-Core 28.1 DP-GFLOP/s/W 83% FPU Utilization Dual-Chiplet, Dual-HBM2E RISC-V-Based Accelerator for Stencil and Sparse Linear Algebra Computations with 8-to-64-bit Floating-Point Support in 12nm FinFET}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present Occamy, a 432-core RISC-V dual-chiplet 2.5D system for efficient sparse linear algebra and stencil computations on FP64 and narrow (32-, 16-, 8-bit) SIMD FP data. Occamy features 48 clusters of RISC-V cores with custom extensions, two 64-bit host cores, and a latency-tolerant multi-chiplet interconnect and memory system with 32 GiB of HBM2E. It achieves leading-edge utilization on stencils (83%), sparse-dense (42 %), and sparse-sparse (49 %) matrix multiply.},
  keywords={Single instruction multiple data;Integrated circuit interconnections;Linear algebra;Very large scale integration;FinFETs;Computational efficiency;Sparse matrices;2.5D Integration;Chiplet;Interposer;General Sparse Acceleration;Stencil Acceleration;Multi-Precision},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631529},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631311,
  author={Tang, Chen and Lin, Xinyuan and Huang, Zongle and Sun, Wenyu and Jia, Hongyang and Liu, Yongpan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 28nm 4.35TOPS/mm2 Transformer Accelerator with Basis-vector Based Ultra Storage Compression, Decomposed Computation and Unified LUT-Assisted Cores}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The area-efficient Transformer accelerator exploiting matrix redundancy is presented with four features: 1) A proposed basis-vector decomposition sparing 25.5x model storage for Transformer like Bert-Base, allowing full on-chip inference on devices with about 13MB memory like smartphones, at only 1.28% accuracy loss. 2) An area-efficient self-programming LUT-assisted computing cell by result prefetch; 3) A unified task-insensitive core supporting fast decomposed computing, resulting in a remarkable 73% energy saving; 4) A NoC design facilitating hybrid data reuse to reduce communication. It achieves 4.35 $\text{TOPS} /\text{mm}^{2}$ dense area efficiency, 4 times than the state-of-the-art counterpart at same fabrication level. It also demonstrates 213%-429% higher overall energy efficiency.},
  keywords={Fabrication;Prefetching;Redundancy;Very large scale integration;Transformer cores;Transformers;System-on-chip},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631311},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631416,
  author={Huang, Zhiqiang and Chen, Fengjun and Kong, Shuangfeng},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 5GHz Fractional-N PLL with 97fsrms Jitter and -255.3dB FoM}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={By employing a binary-search-based DTC nonlinearity calibration technique with an auxiliary-DTC-based TDC, a 5GHz fractional-N PLL with a 100MHz reference is proposed to achieve a calibration time of 8.7us for DTC nonlinearity correction. With the DTC nonlinearity calibration, a gated LMS-based DTC gain calibration with DSM-1, and a tree-like DTC to reduce DTC's delay and jitter, the proposed PLL measures −62dBc in-band fractional spurs and an integrated jitter of 97fs with 3.15mW power consumption, resulting in a FoM of −255.3dB.},
  keywords={Power measurement;Power demand;Jitter;Very large scale integration;Logic gates;Gain measurement;Calibration;Fractional N;PLL;DTC;binary search;nonlinearity calibration;gated LMS calibration;gain calibration;DSM;tree like DTC},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631416},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631466,
  author={Lee, Jaeho and Lee, Kyongsu and Sim, Jae-Yoon and Lee, Seon-Kyoo},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 246-fJ/b 13.3-Tb/s/mm Single-Ended Current-Mode Transceiver with Crosstalk Cancellation for Shield-Less Short-Reach Interconnect}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a 20-Gb/s/line current-mode transceiver for dense short-reach on-chip interconnect. The transceiver achieves a systematic crosstalk cancellation (XTC) by balancing the crosstalk induced by capacitive and inductive coupling. As a receiver frontend, a current-sensing amplifier is designed with an optimum input resistance value for XTC. Without any additional circuits for XTC and equalization, the transceiver implemented in a 40nm CMOS technology shows an energy efficiency of 246fJ/b and an edge bandwidth density of I3.3Tb/s/mm, even with shield-less $1.5-\mu \mathrm{m}$ pitch and I-mm length channels.},
  keywords={Resistance;Systematics;Integrated circuit interconnections;Crosstalk;Receivers;Very large scale integration;Transceivers;current-mode signaling;short-reach interconnect;single-ended transceiver;crosstalk cancellation},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631466},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631486,
  author={Park, Dongjun and Roh, Heesung and Lee, Seon-Kyoo and Sim, Jae-Yoon},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A $94\text{fs}_{\text{rms}}$-Jitter and −249.3dB FoM 4.0GHz Ring-Oscillator-Based MDLL with Background Calibration of Phase Offset and Injection Slope Mismatch}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a ring oscillator (RO)-based multiplying delay- locked loop (MDLL) with frequency and slope detector (FSD) that can control both the oscillation frequency and the injection signal slope. By comparing characteristics of two consecutive transitions of the RO before and after the injection, the FSD distinguishes the cause of error, i.e., mismatch in period or slope. Hence, it can individually drive two loops; 1) for locking the steady-state frequency of the RO and 2) for matching the transition slope of the reference edge to that of the internal node of the RO. As the proposed FSD efficiently mitigates each jitter source, the chip, implemented in 40nm CMOS, shows an integrated rms jitter of $94\text{fs}_{\mathrm{r}\mathrm{m}\mathrm{s}}$ at 4GHz, achieving a FoM of -249.3dB.},
  keywords={Ring oscillators;Frequency locked loops;Detectors;Very large scale integration;Jitter;Steady-state;Calibration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631486},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631409,
  author={Han, Sicheng and Wang, Yun and Li, Yunhao and Zuo, Wen and Li, Wei and Lin, Yue and Xu, Hongtao},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 140-Gbps 1-to-21-GHz Ultra-Wideband LNA Achieving 1.95-to-3-dB NF Using Gm-Assisted-Feedback Noise Suppression Technique in 40nm Bulk CMOS}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents an ultra-wideband low-noise amplifier (LNA) with gm-assisted-feedback noise suppression technique for ultra-wideband RF front-end. Compared to the traditional resistive feedback wideband LNAs, the proposed LNA blocks the noise current from the feedback resistor with a simple additional gm-cell, thus achieving a lower overall NF. A source coupling transformer is also utilized to maintain a wideband flat gain. Fabricated in a 40-nm bulk CMOS process, the LNA prototype achieves a measured bandwidth of 1-to-21-GHz, NF of 1.95-to-3-dB, S21 of 20.6-to-22.4-dB, while consuming 21.6 mA from a 1.2 V power supply. It reports the lowest and the flattest NF among the recent-published bulk CMOS ultra-wideband LNAs, it also supports ultra-wideband modulation signal with a date rate of 140 Gbps.},
  keywords={Resistors;Radio frequency;Power supplies;Noise reduction;Prototypes;Very large scale integration;Transformers},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631409},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631538,
  author={Pan, Qinjing and Luo, Qi and Qu, Tianxiang and Liu, Liheng and Li, Xiao and Chen, Min and Hong, Zhiliang and Xu, Jiawei},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 97.3dB SNR Bioimpedance AFE with −84dB THD Segmented-${\Delta\Sigma \mathrm{M}}$ Sinusoidal Current Generator and Passing-Through Instrumentation Amplifier}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a high-precision bioimpedance (BioZ) analog front-end (AFE) to detect changes in tissue electrical properties as prognostic indicators for heart failure, cancer, and chronic pulmonary disease. To increase the BioZ measurement accuracy, a low-distortion sinusoidal current generator (CG) is proposed. It utilizes a lookup table (LUT) with segmented delta-sigma modulator ($\Delta\Sigma \mathrm{M}$) for efficient bits extension of the IDAC, and a current amplifier (CA) to isolate the IDAC from dynamic load (e.g., BioZ, electrode impedance, and parasitic capacitors) without nonlinearity penalty. The BioZ readout proposes a pass-through IA (PT-IA) to optimize the noise performance for large and complex BioZ. Manufactured in a $0.18\mu \mathrm{m}$ CMOS process, the overall AFE, including the CG and readout, achieves −84dB THD, 97.3dB SNR ($\text{BW}=4\text{Hz}$), and $0.57\mathrm{m}\Omega/\sqrt{}\text{Hz}$ sensitivity at 1Hz, while the CG and readout consume $86.7-196.5\mu \mathrm{W}$ and $54.8\mu \mathrm{W}$, respectively. Impedance cardiography (ICG) has been successfully demonstrated with dry electrodes.},
  keywords={Electrodes;Sensitivity;Pulmonary diseases;Instruments;Bioimpedance;Very large scale integration;Generators},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631538},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631491,
  author={Toprak-Deniz, Zeynep and Dickson, Timothy O. and Cochet, Martin and Proesel, Jonathan and Bulzacchelli, John F. and Ainspan, Herschel and Brändli, Matthias and Morf, Thomas and Beakes, Michael and Meghelli, Mounir},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.88pJ/bit 112Gb/s PAM4 Transmitter with $1\mathrm{V}_{\text{ppd}}$ Output Swing and 5-Tap Analog FFE in 7nm FinFET CMOS}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A 0.88pJ/bit 112Gb/s PAM4 transmitter is reported in 7nm FinFET CMOS with 1V ppd output amplitude. The quarter-rate TX architecture implements a 5-tap analog FFE using tap extension circuitry, which permits higher FFE tap count than conventional quarter-rate architectures without requiring complex clocking. A key feature of the FFE construction is the use of fully re-assignable CML driver segments among FFE taps, which allows a reduced number of segments for lower capacitance and higher driver bandwidth.},
  keywords={Transmitters;Bandwidth;Very large scale integration;FinFETs;Capacitance;electrical transmitter;CML;analog FFE;PAM},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631491},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631376,
  author={Cheng, H. Y. and Liu, Z. L. and Majumdar, A. and Grun, A. and Ray, A. and Su, J. and Rasch, M. J. and Carta, F. and Gignac, L. and Lavoie, C. and Cheng, C.W. and Sky, M. Bright and Lung, H. L.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={State-Independent Low Resistance Drift SiSbTe Phase Change Memory for Analog In-Memory Computing Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We developed a phase-change memory (PCM), with SiSbTe material, that showed state-independent resistance drift (v~0.04) at 65°C over the entire analog conductance range. We evaluated this PCM for In Memory Compute (IMC) applications simulating the performance of BERT model with the IBM Analog Hardware Acceleration Kit (AIHWKit). Drift and data retention are dependent on the amount of A-type dopant into SiSbTe materials. Finding a trade-off between the two is important to deliver a balanced material that can tackle IMC workload without losing in performance. The fabricated SiSbTe PCM devices maintain the BERT accuracy (<2% loss) for more than 7 days at 65°C and pass the data retention at 85 °C/48hrs demonstrating a great balance between the two metrics.},
  keywords={Phase change materials;Resistance;Performance evaluation;Accuracy;Computational modeling;Very large scale integration;In-memory computing},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631376},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631525,
  author={Tanaka, Tomotaka and Ishii, Yuichiro and Yabuuchi, Makoto and Aoyagi, Yumito and Hamada, Masaya and Mizutani, Kazuto and Nii, Koji and Fujiwara, Hidehiro and Wang, Isabel and Cheng, Hong-Chen and Liao, Hung-Jen and Chang, Tsung-Yung Jonathan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3nm Fin-FET 19.87-Mbit/mm2 2RW Pseudo Dual-Port 6T SRAM with High-R Wire Tracking and Sequential Access Aware Dynamic Power Reduction}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A 2-read/write (2RW) pseudo dual-port (PDP) 6T SRAM is developed on 3nm Fin-FET technology. To improve performance, high-R wire tracking is introduced to adjust between margin, obtaining the optimum speed over various sign-off conditions. In addition, to reduce the dynamic power, the pre-charge control circuits are newly proposed to be aware of the 1st and 2nd sequential accesses. Meaningless bitline pre-charges for the 2nd access are eliminated in either all columns or se lected columns, reducing the dynamic power in bitlines by up to 43 %. The fabricated 288-kbit 2RW PDP SRAM macro achieves the highest world record of 19.87 Mbit/mm2 bit-density thanks to PDP design.},
  keywords={Random access memory;Very large scale integration;Wire;3nm;PDP;2RW;SRAM;dynamic power;bit-density},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631525},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631496,
  author={Hwang, Hyun-chul and Kim, Min-su and Lee, Dae-seong and Kim, Yong-geol and Kim, Byung-su and Kang, Kun-hyuk},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An Area-Efficient True Single-Phase Clocked and Conditional Capture Flip-Flop for Ultra-Low-Power Operations in 7nm Fin-FET Process}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this paper, we propose a new ultra low-power flip-flop circuit structure that supports true single phase clock operation and conditional capture characteristics. Simulation results based on 7nm Fin-FET process shows 63% power reduction while reducing cell area by 7%, compared to the conventional transmission-gate flip-flop. Silicon measure based on a test chip shows successful operation even at 0.33V, proving its structural robustness near sub-threshold region.},
  keywords={Semiconductor device measurement;Simulation;Very large scale integration;Silicon;Robustness;Flip-flops;Periodic structures;Flip-Flop;Contention-free;Area-efficient;TSPC;Conditional capture;Low-power;Path-sharing},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631496},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631441,
  author={Zhao, P. and Witters, L. and Jourdain, A. and Stucchi, M. and Jourdan, N. and Maes, J.W. and Bana, H. and Zhu, C. and Chukka, R. and Sebaai, F. and Vandersmissen, K. and Heylen, N. and Montero, D. and Wang, S. and D'Have, K. and Schleicher, F. and De Vos, J. and Beyer, G. and Miller, A. and Beyne, E.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Backside Power Delivery with relaxed overlay for backside patterning using extreme wafer thinning and Molybdenum-filled slit nano Through Silicon Vias}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Long slit nano Through Silicon Vias (nTSV) are used for high density connections between frontside (FS)-patterned Burried Power Rails (BPR) and orthogonally patterned metal rails on the wafer backside (BS). The length of the slits can be tuned to relax overlay requirements for BS patterning that are typically stringent due to wafer grid distortions in bonding. Extreme wafer thinning stopping on 10nm Sio.75Geo.25 etch stop layer (ESL) is enabled using an optimized thinning sequence. For the first time, low resistance barrier-free Molybdenum (Mo)-filled nTSVs are demonstrated, confirming the potential for further scaling compared to TiN/W filled counterparts.},
  keywords={Resistance;Rails;Kelvin;Tin;Very large scale integration;Silicon;Filling},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631441},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631530,
  author={Subramanian, Sushil and Mladenov, Todor M and Schaal, Simon and Patra, Bishnu and Lampert, Lester and Robinson, Nancy K and Roberts, Jeanette and Pellerano, Stefano},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Scalable mK Cryo-CMOS Demultiplexer Chip for Voltage Biasing and High-Speed Control of Silicon Qubit Gates}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Large-scale silicon qubit control requires closer integration of control electronics to qubits at the mK stage of the dilution refrigerator to address the wiring bottleneck. We present a mK demultiplexer chip that uses only two input analog voltages and digital control signals, to provide both DC bias and high-speed voltage pulsing for up to 64 qubit terminals. Integrated with a foundry qubit chip on the same PCB and controlled by a 4 K cryo-CMOS controller, mK cryogenic measurements show multi-terminal characterization of a qubit device.},
  keywords={Wiring;Digital control;Semiconductor device measurement;Qubit;Cryogenics;Very large scale integration;Logic gates;cryo-CMOS;spin qubits;quantum computing},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631530},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631386,
  author={Lee, Feng-Min and Tseng, Po-Hao and Lin, Yu-Yu and Lin, Yu-Hsuan and Weng, Wei-Lun and Lin, Nei-Chih and Sung, Po-Jung and Wu, Chien-Ting and Yang, Chih-Chao and Wu, Wen-Fa and Shen, Chang-Hong and Hou, Tuo-Hung and Lee, Ming-Hsiu and Hsieh, Kuang-Yeu and Wang, Keh-Chung and Lu, Chih-Yuan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Bit-Cost-Scalable 3D DRAM Architecture and Unit Cell First Demonstrated with Integrated Gate-Around and Channel-Around IGZO FETs}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Novel 3D DRAM architectures with 2T0C IGZO gain cell and bit-cost-scalable 3D array process are proposed and demonstrated for the first time. The unit cell is composed of one gate-around (GA) FET and one channel-around (CA) FET to form the 2T0C memory device, where the GA FET and CA FET serve as the write transistor and the read transistor for the DRAM cell, respectively. To verify the possibility of this 3D stacking architecture, we demonstrate the GA IGZO FET by top metal gate with IGZO channel structure, and the CA IGZO FET by bottom IGZO gate with IGZO channel. The integrated 2T0C 3D DRAM memory cell shows excellent device characteristics with>180 second data retention time and endures>1000 second DC stress on the write and read transistors w/o memory window closure. The proposed backend-of-line compact 2T0C DRAM cell features small footprint, bit-cost scalable 3D array, fast write/read, and good reliability, which is promising for future high density embedded memory applications.},
  keywords={Three-dimensional displays;Microprocessors;Field effect transistors;Stacking;Random access memory;Computer architecture;Logic gates},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631386},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631443,
  author={Wang, Yiqi and He, Zhen and Zhao, Chenggang and Wu, Zihan and Gao, Mingyu and Han, Huiming and Wei, Shaojun and Hu, Yang and Tu, Fengbin and Yin, Shouyi},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={ETCIM: An Error-Tolerant Digital-CIM Processor with Redundancy-Free Repair and Run-Time MAC and Cell Error Correction}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents an Error-Tolerant digital Computing-in-Memory (CIM) processor ETCIM. It has three key features to solve the hard error correction overhead, soft error correction incompatibility and latency problem of traditional methods on digital CIM: 1) A Fault-Adaptive CIM Initializer (FACI) and input feeder reduce the hard error repair overhead by up to 8.47x power and 18.16x area savings. 2) A Block-wise ECC (BW-ECC) CIM suits digital CIM's structure and corrects soft multiply-accumulation (MAC) errors; 3) A Progressive Cell Error Corrector (PCEC) hides soft cell error correction latency during computation, reducing the total latency by up to 96.8%.},
  keywords={Very large scale integration;Maintenance engineering;In-memory computing;Common Information Model (computing);Error correction;Error correction codes;Common Information Model (electricity)},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631443},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631322,
  author={Qin, Yubin and Wang, Yang and Yang, Xiaolong and Zhao, Zhiren and Wei, Shaojun and Hu, Yang and Yin, Shouyi},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 52.01 TFLOPS/W Diffusion Model Processor with Inter-Time-Step Convolution-Attention-Redundancy Elimination and Bipolar Floating-Point Multiplication}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper proposes an energy-efficient diffusion model processor exploiting inter-time-step computation redundancy. It has three features: 1) a semantic-segment sparse convolution engine removes 88.5% of duplicated convolution layer (CL) computations. 2) a resemble trivial attention exponent inheritance design improves attention layer (AL) computation efficiency by 16.7×. 3) a bipolar floating-point multiplier saves 25.4% multiplication effort by avoiding ineffective mantissa multiplication for both CL and AL. It achieves a peak efficiency of 52.01TFLOPS/W, and reduces energy by 23.14× and 3.94× compared to state-of-the-art CL and AL processors.},
  keywords={Convolution;Redundancy;Very large scale integration;Diffusion models;Energy efficiency;Computational efficiency;Integrated circuit modeling;diffusion model;deep learning accelerator;VLSI},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631322},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631408,
  author={You, De-Qi and Khwa, Win-San and Wu, Jui-Jen and Jhang, Chuan-Jia and Lin, Guan-Yi and Chen, Po-Jung and Chiu, Ting-Chien and Chen, Fang-Yi and Lee, Andrew and Hung, Yu-Cheng and Lo, Chung-Chuan and Liu, Ren-Shuo and Hsieh, Chih-Cheng and Tang, Kea-Tiong and Chih, Yu-Der and Chang, Tsung-Yung Jonathan and Chang, Meng-Fan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 22nm Nonvolatile AI-Edge Processor with 21.4TFLOPS/W using 47.25Mb Lossless-Compressed-Computing STT-MRAM Near-Memory-Compute Macro}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Battery-powered AI-edge processors require short wakeup-to-response latency (TWR) and high energy efficiency (EF) for accurate real-time inference. This necessitates high-capacity nvCIM macros to store floating-point (FP) neural network (NN) data (e.g., BF16) and perform MAC operations with short latency (TCD) and high EF. This paper presents an STT - MRAM nvCIM macro with lossless compression computation, a near-far aware readout scheme, and system-level CIM-friendly hybrid weight mapping. The proposed 22nm nonvolatile processor (nvProcessor) with 47.25-Mb STT-MRAM nvCIM achieved high EF (21.4TFLOPS/W), short $\mathrm{T}_{\text{WR}}(428.58\mu \mathrm{s})$, and high macro-level EF (27.6TFLOPS/W). Keywords: multiply-and-accumulate (MAC), nonvolatile memory (NVM), nonvolatile compute-in-memory (nvCIM)},
  keywords={Program processors;Accuracy;Nonvolatile memory;Artificial neural networks;Very large scale integration;In-memory computing;Real-time systems},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631408},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631360,
  author={Ko, Jung-Soo and Shearer, Alex and Lee, Sol and Neilson, Kathryn and Jaikissoon, Marc and Kim, Kwanpyo and Bent, Stacey and Saraswat, Krishna and Pop, Eric},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Achieving 1-nm-Scale Equivalent Oxide Thickness Top Gate Dielectric on Monolayer Transition Metal Dichalcogenide Transistors with CMOS-Friendly Approaches}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Two-dimensional (2D) transition metal dichalco-genides (TMDs) are promising for future nanoscale transistors, but reducing their gate dielectric equivalent oxide thickness (EOT) remains a key challenge. Here, we report ultrathin top-gate dielectrics on monolayer (1L) TMDs using industry-com-patible approaches, achieving 1-nm-scale EOT. We show atomic layer deposition (ALD) of HfO2 on both 1L Mos2 and WSe2 using Si seed, realizing 0.9 nm EOT with subthreshold swing SS≈ 70 mV/dec, low leakage, and negligible hysteresis on Mos2. We also demonstrate direct ALD of ultrathin alumina (AlOx) on 1L Mos2 with good uniformity and quality by engi-neering the precursor. Combining our findings, we show that the threshold voltage ($V_{T}$) can be controlled by the thickness of the interfacial dielectric layer on the 2D transistor channel.},
  keywords={Two-dimensional displays;Field effect transistors;Very large scale integration;Logic gates;Silicon;Dielectrics;Sulfur},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631360},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631542,
  author={Koo, Byeongwoo and Do, Sunghan and Lee, Sangkyu and Nam, Sangpil and Shin, Heewook and Im, Saemin and Shin, Hyochul and Lee, Sungno and Park, Junsang and Lee, Jungho and Cho, Youngjae and Choi, Michael and Shin, Jongshin},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 12-bit 16GS/s Single-Channel RF-DAC with Hybrid Segmentation for Digital Back-Off and Code-Dependent Free Switch Driver Achieving −85dBc IMD3 in 5nm FinFET}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents a single-channel 12-bit 16GS/s RF current steering DAC in a 5nm FinFET process. To achieve high dynamic performance without noise degradation, hybrid segmentation architecture is implemented with 0.0046mm2 small area. A novel pre-discharge switch drivers remove data dependency of switching without dynamic element matching (DEM) technique. The prototype DAC shows −85dBc IMD3 and −163dBFS/Hz noise spectral density. The power dissipation is 486mW at 16GS/s sampling with 7.1GHz output frequency.},
  keywords={Radio frequency;Degradation;Noise;Prototypes;Switches;Very large scale integration;FinFETs;DAC;hybrid;segmentation;RF;switch driver;data dependent;dynamic element matching},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631542},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631314,
  author={Park, Junsang and Park, Jinwoo and Hong, Jaemin and Park, Sunjae and Lee, Dongsuk and Lee, Sungno and Shin, Hyochul and Lee, Kyunghoon and Koo, Byeongwoo and Cho, Youngjae and Choi, Michael and Shin, Jongshin},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 12-bit 10GS/s Time-Interleaved SAR ADC with Even/Odd Channel-Correlated Absolute Error-Based Over-Nyquist Timing-Skew Calibration in 5nm FinFET}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents an over-Nyquist 12-bit 10GS/s time-interleaved (TI) ADC with a background timing-skew calibration. An absolute error-based auto-correlation algorithm enables calibration of time skew for both the first and second Nyquist inputs, while an even and odd channel-based auto-correlation algorithm requires only three calibration steps. A prototype 10GS/s ADC in 5nm FinFET achieves a SNDR of 50.2dB and 46.2dB at input frequencies of 5GHz and 9GHz, respectively. The ADC consumes 386mW resulting in a $\text{FoM}_{\text{Walden}}$ and $\text{FoM}_{\text{Schreier}}$ of 146.0fJ/c-s. and 151.3dB, respectively.},
  keywords={Prototypes;Very large scale integration;FinFETs;Calibration;SAR ADC;time interleaving;timing skew;calibration and auto-correlation},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631314},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631330,
  author={Lagos, J. and Renukaswamy, P. and Markulic, N. and Martens, E. and Craninckx, J.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Single-Channel, 1-GS/s, 10.91-ENOB, 81-dB SFDR, 9.2-fJ/conv.-step, Ringamp-Based Pipelined ADC with Background Calibration in 16nm CMOS}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a single-channel ADC that exploits muti-bit pipelined stages based on ring amplification to simultaneously achieve high linearity, bandwidth, and power efficiency. A very-wide tuning range comparator is introduced in the stage quantizers, which not only enables multi-bit quantization but is also leveraged for the injection of dither to calibrate DAC mismatch and inter-stage gain in the background. Implemented in a 16nm FinFET process, it achieves 10.91 ENOB and 81 dB SFDR at 1 GS/s, consuming 17.8 mW from a 0.9 V supply, resulting in a Walden FoM of 9.2 fJ/conv.-step.},
  keywords={Quantization (signal);Linearity;Bandwidth;Very large scale integration;FinFETs;CMOS technology;Calibration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631330},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631449,
  author={Xie, Ruilong and Hong, Wonhyuk and Zhang, Chen and Lee, Jongjin and Brew, Kevin and Johnson, Richard and Lanzillo, Nicholas and Shobha, Hosadurga and Kim, Taesun and Park, Panjae and Mochizuki, Shogo and Saraf, Iqbal and Park, Chanro and Zhuang, Lei and Osborn, Clifford and Li, Wai Kin and Liu, Feng and Sankarapandian, Muthumanickam and Yang, Chung Ju and Li, Juntao and Tierney, Lukas and Pujari, Ruturaj and Sulehria, Yasir and Song, Yuncheng and Zhou, Huimei and Wang, Miaomiao and Belyansky, Michael and Ghosh, Somnath and Zhang, Haojun and Motoyama, Koichi and Sarkar, Debarghya and Kim, Wukang and Chu, Albert and Li, Tao and Carta, Fabio and Gluschenkov, Oleg and Oh, Joongsuk and Malley, Matthew and Chu, Pinlei and Nguyen, Son and Luedders, Katherine and Lee, Joe and Khan, Shahrukh and Chowdhury, Prabudhya Roy and Huang, Huai and Shadman, Abir and Sieg, Stuart and Dechene, Daniel and Edelstein, Daniel and Arnold, John and Yamashita, Tenko and Choi, Kisik and Seo, Kang-ill and Guo, Dechao and Bu, Huiming},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Backside Power Distribution for Nanosheet Technologies Beyond 2nm}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper examines various approaches for integrating backside power distribution network (BSPDN) with nanosheet transistor technologies. Deep Trench Via (DTV) based BSPDN schemes, except for Shifted Frontside Via Backside Power rail (SFVBP), do not offer cell level scaling benefits, but via resistance of SFVBP could remain a bottleneck. Direct Backside Contact (DBC) based schemes offer best cell level scaling. A novel self-aligned backside contact (SABC) scheme integrated with nanosheet transistors is demonstrated with immunity to misalignments in backside contact formation. The structure exhibits good device characteristics and satisfactory reliability.},
  keywords={Rails;Resistance;Power supplies;Power distribution;Voltage;Very large scale integration;Logic gates},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631449},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631367,
  author={Li, S. and Javvaji, S. and Pecanins-Martinez, V. and Aydin, E. and van Veldhoven, R. and Makinwa, K.A.A.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Beyond-the-rail Audio CTΔΣM with a Passive Input Stage and 99.2dB SNDR}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a 3rd order continuous-time delta-sigma modulator (CT Δ ΣM) for audio applications. Its loop filter efficiently realizes complex conjugate NTF zeros by combining a passive RC filter and a Gm-C based resonator. The latter is built around a capacitively-coupled chopper OTA, which enables a beyond-the-rail input range. Implemented in 65nm CMOS, the proposed CT Δ ΣM achieves 99.2dB SNDR and 100dB DR in a 24kHz BW while consuming only 80.7µW. This results in a state-of-the-art Schreier FoMsNDR of 184dB.},
  keywords={Passive filters;Resonator filters;Very large scale integration;Choppers (circuits);Delta-sigma modulation},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631367},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631454,
  author={Hsia, Chu-En and Chang, Chin-Ho and Chen, Yung-Shun and Lai, Po-Yu and Jen, Ching Lin and Peng, Yung-Chow and Li, Shenggao},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Current Mirrors with Tapered Stacked-Gates for Area Saving or Noise Improvement in 3nm FinFET Process}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A tapered stacked-gates device offers the advantages of saving area and reducing noise and mismatch, and it is universally applicable to many circuits. The proposed current-mirror design in bandgap reference (BGR) and current control oscillator (ICO) circuits use tapered stacked-gates for current mirror. Different numbers of transistors are used in the stacked stages, which reduces the number of source-side transistors and results in a 24% area reduction while maintaining the same mismatch and noise performance according to experimental result. In addition, using the same number of devices, this design can achieve better performance with almost 45% noise and 28% mismatch reduction in simulation. Overall, this non-formal stacked-gates transistor circuit design shows promising potential for analog circuit applications.},
  keywords={Performance evaluation;Current mirrors;Photonic band gap;Noise;Process control;Very large scale integration;Logic gates;Bandgap voltage reference;Current control oscillator;Noise;Mismatch;Stack gate;MOS array layout and Current mirror},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631454},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631553,
  author={Roh, Heesung and Yoo, Hyun Jin and Yoo, Si-Youl and Pyen, Seung Hee and Jeon, Cheonhoo and Sim, Jae-Yoon},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Smart Contact Lens System with 433MHz Wireless Power and Data Transfer at a Modulation Index Down to 0.02%}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a wireless power and data transfer system for a low modulation index (MI) of smart contact lens (SCL). Two chips, Reader and Transponder, co-optimized in a full chain of 433MHz system enable data communication even at an MI of 0.02%. The bit error rate (BER) at 0.1% MI is less than $4\times 10^{-6}$, representing an improvement over 250 times compared to the previous best. The full system was verified in vitro and in vivo with a live rabbit.},
  keywords={Wireless communication;Rabbits;In vivo;Bit error rate;Modulation;Very large scale integration;Data transfer},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631553},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631329,
  author={Jeong, Dongchan and Kim, Seungkwon and Park, Seulki and Lee, Sang Hyeon and Masuoka, Sada-aki and Choi, Byungha and Min, Shincheol and Lee, Sanghoon and Lee, Minseong and Sohn, Chang-Woo and Jeong, Jaehun and Yasuda-Masuoka, Yuri and Ku, Ja-Hum},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Product Performance Aware 3rd Generation GAA Platform Transistor Design with Extreme Small Local Layout Effect and Transistor Variation}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A product performance aware 3rd generation MBCFET™ (SF2) is revealed to maximize Gate-All-Around benefit fully by introducing unique epitaxial and integration process, which overcomes the scaling and GAA structure conflict with a product gain. The product major narrow NS Tr was boosted by N/PFET +29/+46%, as well as a wide NS Tr +11/+23%. In addition, through Tr global variation reduction by 26% from FinFET, a product leakage distribution was significantly scaled by ~50%. The process can enable another level of DTCO collaboration in MBCFET™ for the future technology.},
  keywords={Gallium arsenide;Layout;Collaboration;Very large scale integration;Logic gates;FinFETs;Epitaxial growth},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631329},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631481,
  author={Nam, Kyeongtae and Kim, Jaehyuk and Lee, Dongil and Kang, Kyuchang and Kim, Sangyun and Lee, Changyoung and Yoon, Hyunchul and Kim, Donggeon and Won, Bokyeon and Song, Jaejoon and Nam, Incheol and Seo, Young-Hun and Ihm, Jeong-Don and Yoo, Changsik and Hwang, Sangjoon},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An Offset-Compensated Charge-Transfer Pre-Sensing Bit-Line Sense-Amplifier for Low-Voltage DRAM}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A bit line sense amplifier (BLSA) with offset compensated charge transfer pre-sensing (OC-CTPS) scheme is implemented using 14nm DRAM process. The offset compensation (OC) is operated by diode connection without additional size overhead for BLSA. Average fail bit rate (FBR) attributed to a mismatch of charge transfer transistor is reduced by 94 % after performing OC. Furthermore, OC-CTPS BLSA accomplishes a 3sigma window, representing the FBR under 3sigma (=0.1349%) over charge transfer time $(\mathrm{t}_{\text{CT}})$. The 3sigma window has widths of 250 ps and 500 ps at temperatures of -25°C and 100°C, respectively, without changing voltages for charge transfer. Moreover, our approach ensures robust and stable sensing even at operating voltages as low as 0.75 V, compared to conventional OC BLSA.},
  keywords={Temperature sensors;Low voltage;Bit rate;Random access memory;Very large scale integration;Sensors;Charge transfer},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631481},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631485,
  author={Kim, Jeongmyeong and Park, Changjoo and Jung, Wanyeong},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.6-1 V $\mathrm{V}_{\text{IN}}$ Soft-Switching Low Dropout Regulator with 31.3 A/mm2 Current Density, 99.99% Current Efficiency, and 2.04 fs FoM}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a soft-switching LDO, which takes advantages of analog and digital LDOs. A soft quantizer enables smooth switching of power FETs like an analog LDO. Inverter-based buffers provide rail-to-rail output voltages to power FETs like a digital LDO and offer fast transient response using a push-pull structure even with a small dropout voltage $(\mathrm{V}_{\mathrm{D}\mathrm{O}})$ of 50 mV. A test chip fabricated in a 65 nm CMOS process achieves a high current density of 31.3 A/mm2 at 1 V $\mathrm{V}_{\text{IN}}$, a current efficiency of 99.99% at 0.6 V $\mathrm{V}_{\text{IN}}$, and a fast transient response of a 102 m V voltage droop at a 90 mA/4 ns load condition with a 0.6 V $\mathrm{V}_{\text{IN}}$.},
  keywords={Transient response;Regulators;Field effect transistors;Switches;Very large scale integration;CMOS process;Current density},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631485},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631321,
  author={Kim, Jae-Hyun and Park, Yousung and Kwon, Doyoung and Kim, Dong-Kyu and Park, Sung-Chun and Lee, Yongjae and Lee, Jung-Bong and Kim, Hyun-Sik},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 96.4%-Efficiency Single-Duty-Cycled Buck-Boost Converter Achieving 1.9mV Ripple and 2.1mV Mode-Change Fluctuation for Mobile OLED Displays}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a single-duty-cycled buck-boost (SDC-BB) converter for powering mobile OLEDs. Its features include a low output ripple and the ability to seamlessly cover all conversion ratios using a single duty-cycle $(D)$, effectively suppressing output fluctuations during transitions between boost and buck modes. In its implementation, the flying capacitor is reused for the gate drives, thereby eliminating bootstrap overhead, and an adaptive ramp generator is incorporated to enhance immunity to TDMA noise. The chip fabricated in $0.18\mu \mathrm{m}$ achieves output ripples of ≤1.9mV and a peak efficiency of 96.4%. It maintains output fluctuations within 2.1mV during transitions between buck and boost modes, ensuring flicker-free displays.},
  keywords={Time division multiple access;Fluctuations;Noise;Capacitors;Very large scale integration;Organic light emitting diodes;Logic gates},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631321},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631460,
  author={Lu, Haoran and Ge, Yandong and Jiang, Xun and Sun, Jiacheng and Peng, Wanyue and Guo, Rui and Li, Ming and Lin, Yibo and Wang, Runsheng and Wu, Heng and Huang, Ru},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Experimental Demonstration of Self-Aligned Flip FET (FFET): A Breakthrough Stacked Transistor Technology with 2.5T Design, Dual-Side Active and Interconnects}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, for the first time, the Flip FET (FFET), a novel stacked transistor technology with self-aligned active and interconnects on both sides of wafer, is proposed and experimentally demonstrated. Two layers of transistors are formed on the same active and back-to-back stacked, featuring a much more manufacturing-friendly process flow with lower aspect ratio (AR) than CFET. Standard cell (STC) libraries with minimum 2.5 track height (2.5T) design are established, proving further scaling possibility and better routability over CFET. Benefited from the dual-side process, FFET also has better design flexibility with no restriction on N/P polarity for each transistor layer, enabling a bipolar SRAM with further 12% area reduction over CFET SRAM and at least 35.9% over FinFET SRAM, respectively. Meanwhile, based on fins, FFET outperforms CFET with 21.5% higher frequency at iso-power and 45.0% lower power at iso-frequency. Furthermore, for nanosheet-based ones, FFET shows extra benefits over CFET with larger nanosheet width (WNS), with 14.5% higher frequency at iso-power at the same footprint. New concepts of dual-side interconnects are introduced and the P&R result of a RISCV321 core further validates the superiority of FFET with more than 31.3% area reduction compared with CFET.},
  keywords={Field effect transistors;Random access memory;Integrated circuit interconnections;Very large scale integration;Logic gates;Benchmark testing;FinFETs},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631460},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631363,
