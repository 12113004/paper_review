@INPROCEEDINGS{10631401,
  author={Wu, Wen-Chia and Hung, Terry Y.T. and Sathaiya, D. Mahaveer and Chen, Edward and Hsu, Chen-Feng and Yun, Walker and Hu, Hsiang-Chi and Liu, Bo-Heng and Lee, T.Y. and Kei, Chi-Chung and Chang, Wen-Hao and Cai, Jin and Jeff, W. and Wu, Chung-Cheng and Wong, H.-S. Philip and Chien, Chao-Hsin and Cheng, Chao-Ching and Radu, Iuliana P.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={On the Extreme Scaling of Transistors with Monolayer MOS2 Channel}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={2D transition metal dichalcogenides (TMDs) show promise for transistor scaling, but their on-scale performance had not been proven yet. This work demonstrates contact length (Lc) scaling while holding a low contact resistance (RC) down to 11 nm. Channel length $(\mathrm{L}_{\text{CH}})$ scaling shows ION can increase down to at least 12 nm with low Rc. The very scaled $(\mathrm{L}_{\text{CH }}=19$ nm and $\mathrm{L}_{\mathrm{C}}=12$ nm) Mos2 transistor with Sb-based metal contact has current density of ~1130 μA/μm at $\mathrm{V}_{\text{DS}}$= 1 V, and a low $\mathrm{R}_{C}$ of ~ 190 Ω.μm. These scaled transistors, processed within a back-end-of-line (BEOL) thermal budget, do not exhibit subthreshold swing (S.S.) degradation or observable drain-induced barrier lowering (DIBL) down to $\mathrm{L}_{\text{CH}}=12\text{nm}$.},
  keywords={Degradation;Metals;Very large scale integration;Ions;Transistors;Sulfur;Transition metal dichalcogenides},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631401},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631447,
  author={Oh, Sungjin and Song, Hyunsoo and Ruiz, Jose R. L. and Chen, Wangbo and Park, Sung-Yun and Flynn, Michael P. and Yoon, Euisik},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 79.2dB-SNDR Slope-Adaptive Dynamic Zoom-and-Track Incremental $\Delta\Sigma$ Neural Recording Frontend with Resolution-Preservative 192mV/ms Transient Tracking}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present an incremental $\Delta\Sigma$ frontend that can resolve $\mu \mathrm{V}$- level neural signals superimposed with large $(> 100\text{m V})$ and fast $(> 100\text{mV}/\text{ms})$ interferences without quality degradation. Unlike conventional approaches that stretch conversion range to accept the large input by sacrificing resolution, the proposed work tracks the large transient with constant high-resolution but variable tracking speed adaptive to its input slope. Thus, this frontend acquires neural information without quality loss even when exposed to large and fast artifacts that overwhelm small neural signals. With the proposed high-resolution tracking scheme, this work achieves the highest SNDR (79.2dB) and FoMSNDR (165.7dB) among the state-of-the-art frontends using the conventional transient tracking techniques.},
  keywords={Degradation;Very large scale integration;Recording;Transient analysis;Signal resolution},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631447},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631498,
  author={Konno, Shota and Ellis, Zachary J. and Golder, Anupam and Ryu, Sigang and Dinu, Daniel and Varna, Avinash and Mathew, Sanu and Raychowdhury, Arijit},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 65nm Delta-Sigma ADC Based VDD-Variation-Tolerant Power-Side-Channel-Attack Monitor with Detection Capability Down to 0.25Ω}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, a Delta-Sigma ADC based Power Side Channel Attack Monitor is proposed to accurately detect insertion of less than $1\ \Omega$. A differential conversion method utilizing Dual Integrate CAP provides signal processing to compensate for drift due to VDD variations, achieving a minimum detectable resistance of $0.25\Omega$ including VDD variations. The ultra-low power consumption of 50uW during operation makes it suitable for IoT-secure devices.},
  keywords={Resistance;Low power electronics;Side-channel attacks;Very large scale integration;Signal processing;Monitoring},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631498},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631524,
  author={Huang, Xiaohua and Yang, Xiaolin and Lodi, Andrea and Van Hoof, Chris and Gielen, Georges and Lopez, Carolina Mora},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3072-Channel Neural Readout IC with Multiplexed Two-Step Incremental-SAR Conversion and Bulk-DAC-Based EDO Compensation in 22nm FDSOI}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We introduce a compact neural readout IC (ROIC) for high-resolution, large-scale $\mu \text{ECoG}$ arrays able to capture wideband brain-surface action potentials (APs). It efficiently records from 3072 electrodes via 96 time-multiplexed super-channels. The super-channels feature two-step incremental-SAR (I-SAR) conversion and area-power-efficient bulk-DACs (BDACs) to handle multiplexed inputs and mitigate comparator and electrode DC offsets (EDOs). Fabricated in 22nm FDSOI, this prototype achieves the smallest effective per-channel area to date (0.0004mm2) and consumes $0.44\mu \mathrm{W}$, while maintaining a low full-band (1Hz-7.5kHz) input-referred noise (IRN) of $6.38\mu \mathrm{V}_{\text{rms}}$. The ability to record multiplexed signals has been successfully demonstrated in saline.},
  keywords={Multiplexing;Electrodes;Action potentials;Noise;Silicon-on-insulator;Prototypes;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631524},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631333,
  author={Cheng, Boyang and Liu, Jianbo and Davis, Steven and Enciso, Zephan M. and Pei, Likai and Chang, Muya and Cao, Ningyuan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 65nm Neuromorphic Bio-Signal Encoder with Compute-in-Entropy Architecture 7.13nJ Privacy-Preserving Encoding and 2.38Mb/mm2 Item Memory Density}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a neuromorphic bio-signal encoder for privacy-critical smart health applications featuring a novel compute-in-entropy architecture for hardware-efficient, physically-unclonable hyperdimensional encoding. The test chip achieved privacy-preserving bio-signal encoding with 7.13 nl efficeincy, 2.38 Mb $/\text{mm}^{2}$ item memory density, and in-situ decision-making and learning capabilities.},
  keywords={Neuromorphics;Smart healthcare;Memory management;Decision making;Encoding;biomedical;machine learning;hyper-dimensional computing;compute-in-entropy;in-memory computing},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631333},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631318,
  author={Zhang, Dong and Feng, Yang and Zheng, Zijie and Sun, Chen and Kong, Qiwen and Liu, Gan and Zhou, Zuopu and Liang, Gengchiau and Ni, Kai and Wu, Jixuan and Chen, Jiezhi and Gong, Xiao},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Unveiling Cryogenic Performance (4 to 300 K) Towards Ultra-Thin Ferroelectric HZO: Novel Kinetic Barrier Engineering and Underlying Mechanism}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We perform comprehensive and in-depth investigation into the cryogenic characteristics of ferroelectric (FE) HZO thin films with varying thicknesses (3/5/7/10 nm) across a broad temperature range (4~300 K), assisted by the first-principles calculations as well as extensive material and electrical characterizations. We discover: (1) 3 and 5 nm HZO films exhibit distinct temperature dependence in remnant polarization $(P_{\mathrm{r}})$ and coercive field $(E_{\mathrm{c}})$ as compared with 7 and 10 nm ones owning to different phase transition mechanisms. (2) The concentration and location of $\mathrm{V}_{\mathrm{o}}{}^{2+}$ emerge as pivotal factors influencing the trap-assisted-tunneling process, and thereby the temperature-dependent behaviors of $P_{r}$ and $E_{\mathrm{c}}$. (3) $\mathrm{V}_{\mathrm{o}}{}^{2+}$ possesses a lower migration energy barrier as compared with $\mathrm{V}_{\mathrm{o}}$, and oxygen vacancy concentration can be engineered through $\mathrm{O}_{3}$ pulse duration during ALD deposition of HZO. Building upon these insights, we propose and experimentally demonstrated, for the first time, an innovative cryogenic barrier engineering approach for $P_{r}$ enhancement, particularly valuable for ultra-thin HZO films.},
  keywords={Temperature distribution;Temperature dependence;Films;Capacitors;Cryogenics;Very large scale integration;Probability},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631318},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631467,
  author={Lin, S.-H. and Simicic, M. and Pantano, N. and Chen, S.-H. and Van Der Plas, G. and Beyne, E. and Wambacq, P.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Toward 0 V ESD Protection in 2.5D/3D Advanced Bonding Technology}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a methodology to help prevent overdesign of Electrostatic Discharge (ESD) protection circuits for internal I/O in 2.5D/3D bonding technologies. We explore how the voltage suppression effect mitigates voltage-driven gate oxide breakdown during stacking and emphasize the role of series resistance in reducing peak discharge current. Our findings indicate that highly variable non-contact discharges are not a concern in advanced bonding technologies, shifting the focus to more predictable contact discharges. Also, we provide guidelines to design efficient ESD protection circuits for internal IO in 2.5D/3D stacked system.},
  keywords={Electrostatic discharge protection;Resistance;Breakdown voltage;Electric breakdown;Prevention and mitigation;Stacking;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631467},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631319,
  author={Gottwald, M. G. and Hu, G. and Trouilloud, P. L. and Rehm, L. and Safranski, C. and Kim, G. and Brown, S. L. and Bruley, J. and D'Emic, C.P. and Gunawan, O. and Jung, H. and Lavoie, C. and Lee, J. and Liang, J. and Robbins, M. and Sun, J. Z. and Hashemi, P. and Worledge, D. C.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of High Retention Energy Barriers and 2 ns Switching, Using Magnetic Ordered-Alloy-Based STT MRAM Devices}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Magnetic ordered alloys with low moment and strong bulk perpendicular magnetic anisotropy (PMA) were successfully developed and integrated on CMOS substrates as a free layer material. Superior device properties including high $\mathrm{H}_{\mathrm{c}}( > 8\ \text{kOe})$, high $\mathrm{E}_{\mathrm{b}}\ ( > 80\ \mathrm{k}_{\mathrm{B}}\mathrm{T})$ and sub-5 ns switching were achieved simultaneously, overcoming the fundamental tradeoff between high $\mathrm{E}_{\mathrm{b}}$ and high-speed switching in conventional CoFeB-based devices using interface anisotropy. We further demonstrated improved switching performance at pulse widths down to 2 ns and improved magnetic field sensitivity in these ordered alloy-based devices, compared to the best published results to date. Previous work using bulk magnetocrystalline anisotropy was limited to high magnetization L10 alloys with $\mathrm{M}_{\mathrm{s}}\sim 850$ emu/cm3 [6] compared to the ~ 200 emu/cm3 used here.},
  keywords={Magnetic films;Magnetic resonance imaging;Metals;Magnetic devices;Switches;X-ray diffraction;Very large scale integration;STT-MRAM;high retention;write speed},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631319},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631552,
  author={Kong, Xiangjian and Xu, Kai and Staszewski, Robert Bogdan and Jian, Mingchao and Guo, Chunbing},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 9-GHz Subsampling-Chopper PLL with Charge-Share Cancelling and Achieving 57.8-fs-rms Jitter with 15dB In-Band Noise Improvement}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A 9-GHz sub-sampling (SS) PLL employs a new chopping charge-pump (CP) with controlled pre-charging or pre-discharging to cancel the charge sharing during the chopper's phase swapping, thus eliminating its 1/f noise. Fabricated in 65-nm CMOS, the prototype achieves 57.8-fs rms jitter with −111.9-dBc/Hz in-band noise at 1kHz offset.},
  keywords={Charge pumps;Prototypes;Very large scale integration;Jitter;1/f noise;Phase locked loops},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631552},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631499,
  author={Han, Jinpyo and Lee, Houk and Cho, Junhee and Lee, Heesung and Kim, Seong-Jin and Chun, Jung-Hoon and Choi, Jaehyuk},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Digital Dynamic Vision Sensor with SPAD Pixels and Multi-Event Generation for Motion/Vibration-Adaptive Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper introduces a digital dynamic vision sensor (DVS) with single-photon avalanche diode (SPAD). The sensor operates in a fully digital manner, eliminating circuit noise and non-uniformity. To provide a motion-adaptive optimum frame rate and minimize vibration-event noise (VEN) caused by sensor vibrations, the sensor generates multiple events via quantized delta (QD) signal. Thanks to the QD, the sensor detects the relative speed of moving objects, adjust the frame rate accordingly, and filter out VEN, thereby allowing only essential events from the objects. Furthermore, the sensor incorporates event-driven threshold control (EDTC) logic to ensure the optimal number of events. The EDTC and VEN filter offers data reduction of 72.8% and 64.5%, respectively.},
  keywords={Vibrations;Dynamics;Noise;Vision sensors;Very large scale integration;Data transfer;Logic;dynamic vision sensor;single photon avalanche diode;various delta scheme;rolling data transfer},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631499},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631369,
  author={Jiang, Qi and Jana, Koustav and Toprasertpong, Kasidit and Liu, Shuhan and Wong, H.-S. Philip},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Positive Bias Stress Measurement Guideline and Band Analysis for Evaluating Instability of Oxide Semiconductor Transistors}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Instability of oxide semiconductor field effect transistors (OSFET) under positive bias stress (PBS) is one of the major hinderances to broad adoption by the semiconductor industry. We present a holistic understanding of the OSFET behavior under PBS, by comparing OSFETs with different channel doping (NCH), hence different initial threshold voltages (VTH). Our analysis reveals that the band profile of OSFETs under a given voltage is strongly dependent on their channel doping, resulting in different stress responses even for the same material properties. This raises the important question of finding the right metric to evaluate the stability of OSFETs. This work makes significant strides in establishing a PBS test guideline to ensure a fair benchmark method of OSFETs with vastly different NCH, and understanding of the associated trade-off between PBS stability and Vth.},
  keywords={Measurement;Doping;Very large scale integration;Stability analysis;Threshold voltage;Circuit stability;Stress},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631369},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631349,
  author={Demuynck, S. and Gonzalez, V. Vega and de Carvalho Cavalcante, C. Toledo and Lima, L.P.B. and Stiers, K. and Sheng, C. and Vandooren, A. and Hosseini, M. and Zhou, X. and Mertens, H. and Chiarella, T. and Bömmels, J. and Loo, R. and Rosseel, E. and Porret, C. and Shimura, Y. and Akula, A. and Mannaert, G. and Choudhury, S. and Brissonneau, V. and Dupuy, E. and Sarkar, T. and Vergel, N. Franchina and Peter, A. and Jourdan, N. and Soulie, J.P. and Vandersmissen, K. and Sebaai, F. and Gowda, P. Puttarame and Lai, K. and Mingardi, A. and Sarkar, S. Sumar and Dhave, K. and Chan, B. T. and Marquez, A. Sepulveda and Langer, R. and Koo, I. Gyo and Sanchez, E. Altamirano and Devriendt, K. and Delgadillo, P. Rincon and Lazzarino, F. and Mitard, J. and Geypen, J. and Grieten, E. and Batuk, D. and Chen, Y-F. and Verbeek, F. and Holsteyns, F. and Subramanian, S. and Horiguchi, N. and Biesemans, S.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Monolithic Complementary Field Effect Transistors (CFET) Demonstrated using Middle Dielectric Isolation and Stacked Contacts}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work reports on the first demonstration of monolithic CFET CMOS co-integrating Middle Dielectric Isolation (MDI), Inner Spacers (ISP) and Stacked frontside patterned Contacts. The flow results in functional CMOS devices on a common gate architecture. The MDI formation is done before source drain (SD) recess for optimal bottom junction (BJ) formation. The paper discusses the challenges of using stacked contacts to form the top device junction (TJ). Finite accuracy of bottom device contact (BC) registration from frontside results in a limited process latitude to access the top device channel for TJ formation while keeping the integrity of MDI and ISP. Top device survival rate increases from 11% to 79% by eliminating the frontside BC. We show feasibility of moving BC to the wafer backside with registration accuracy below 3nm.},
  keywords={Accuracy;Field effect transistors;Very large scale integration;Logic gates;Dielectrics;Junctions},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631349},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631497,
  author={Lin, Zehao and Niu, Chang and Jang, Hyeongjun and Kim, Taehyun and Zhang, Yizhi and Wang, Haiyan and Jeong, Changwook and Ye, Peide D.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Enhancement of In2O3 Field-Effect Mobility Up To 152 cm2.V−1·s−1Using HZO-Based Higher-k Linear Dielectric}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, we report high-performance atomic-layer-deposited (ALD) In2O3 thin-film transistor (TFT) using HfxZr1-xO2 (HZO) as a linear higher-k dielectric. By properly inserting a thin Al2O3 layer between two HZO layers with asymmetric thickness and post-deposition annealing (PDA) of the HZO-Al2O3-HZO (HZAHZO) stack capped with In2O3, the k value of the linear dielectric is boosted to 30. This results in an equivalent oxide thickness (EOT) of 1.9 nm with physical thickness of 15.5 nm and meanwhile In2O3 field-effect mobility ($\mu_{text{FE}}$) is boosted to 152 cm2.V−1.s−1, simultaneously. Such enhancements enable high-performance TFTs with record saturation current (Isat) exceeding $2\ \text{mA}/\mu\mathrm{m}$ with a channel length (Lch) of $1\ \mu\mathrm{m}$, and maximum current (Imax) reaches $7\ \text{mA}/\mu\mathrm{m}$ with Lch of 30 nm. Higher-k dielectrics also enhance the electrostatic control of the channel with negligible hysteresis, on/off ratio over 1011, and drain-induced barrier lowering (DIBL) less than 40 mV/V at Lch of 35 nm. This work demonstrates a promising and straightforward methodology to enhance the mobility of oxide semiconductor (OS) channel by using linear higher-k dielectrics.},
  keywords={Performance evaluation;Annealing;Atomic layer deposition;Very large scale integration;Dielectrics;Thin film transistors;Electrostatics},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631497},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631335,
  author={Rangel, Roberto and Sun, Xiaonong and Barman, Ayandev and Gulve, Rahul and Bajic, Savo and Wang, Jingmin and Wang, Harry and Lindel, David B. and Kutulakos, Kiriakos N. and Genov, Roman},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={23,000-Exposures/s 360fps-Readout Software-Defined Image Sensor with Motion-Adaptive Spatially Varying Imaging Speed}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The software-defined VGA image sensor adapts to fast changes in the scene, both locally and globally, by taking advantage of programmable-size/speed super-pixels and scalable-rate SAR ADCs, respectively. Each super-pixel includes up to 8×8 pixels exposed in a rapid sequence within one frame period, yielding a 64x maximum boost of the exposure rate over the output rate, without the corresponding increase in the ADC power. At 360fps readout, this corresponds to over 23,000 exposures/s while using only 24.5mW, and comes at the cost of moderately lower local resolution, only in the regions with the fast changes in the scene. The 54fJ-FoM SAR ADC allows for scaling down to the 30fps ‘slow’ mode, yielding an additional factor of 12x savings in the output data and camera digital power, and 30% savings in the ADC power.},
  keywords={Image sensors;Image resolution;Costs;Very large scale integration;Cameras},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631335},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631470,
  author={Yoshida, Naomi and Fisher, Ilanit and Ren, He and Lin, Chi-Chou and Shen, Chenfei and Lin, Yongjing and Xu, Yi and Chen, Michael S-.C. and Naik, Mehul},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Replacement Metal Gate Process Extendible Beyond 2-nm Node with Superior Gate Conductivity}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper describes a selective metal cap on replacement-metal-gate (RMG) for gate scaling with high conductivity. Gate length is reaching to 12 nm, as CMOS scaling continues. RMG requires multiple metal gate layers and occupy gate trench with high-resistivity work function layers. The lack of low-resistivity W fill causes gate conductance degradation and negatively impacts CMOS performance. Thin highly conductive metal cap on top of RMG is an effective way to maintain high gate conductivity with extremely scaled gate trench. The technology is extendible to 2 nm node GAA-FET and beyond.},
  keywords={Performance evaluation;Degradation;Technological innovation;Tungsten;Logic gates;Conductivity;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631470},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631462,
  author={Choi, Dong-Myung and Dong, Yikui and Nicholson, Roan and Liu, Frank and Jia, Wenyan and Levin, Vadim and He, Mike and Pradhan, Sameer and Du, Jieqiong and De Vita, Michael and Tran, Amanda and Navid, Reza and Iyer, Sitaraman and Song, Rui},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 4.6pJ/b 64Gb/s Transceiver Enabling PCIe 6.0 and CXL 3.0 in Intel 3 CMOS Technology}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A voltage mode transmitter with 4-tap FIR filter and analog-mixed signal receiver employing 16-tap DFE are presented to enable PCI Express (PCIe) 6.0 and Compute Express Link (CXL) 3.0. The transceiver is implemented in Intel 3 CMOS technology and delivers full spec. compliance with 4.6pJ/b power efficiency.},
  keywords={Transmitters;Finite impulse response filters;Voltage;Receivers;Very large scale integration;CMOS technology;Transceivers;PCIe;CXL;DFE;PAM4;NRZ},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631462},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631472,
  author={Liu, Ziyi and Dul, Yiwei and Liang, Renrong and Zhang, Zhigang and Pan, Liyang and Tang, Jianshi and Liang, Renrong and Gao, Bin and Hu, Qi and Xu, Jun and Qian, He and Wu, Huaqiang and Zhang, Yuegang},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Dual-Gate Vertical Channel IGZO Transistor for BEOL Stackable 3D Parallel Integration for Memory and Computing Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, we demonstrate a stackable vertical single/dual-gate(SG/DG) C-shaped-channel field-effect transistor (VCCFET) based on atomic layer deposition (ALD) In-Ga-Zn-O thin film with an Ion/loff ratio over I. $4\times 10^{11}$ and an on current of 21 $\mu \mathrm{A}/\mu \mathrm{m}$. And we firstly fabricate vertical dual-gate IGZO transistors, featuring Gate-AlI-Around Lateral Gate (LG) and Channel-AlI-Around Vertical Gate(VG). The dual gates can be biased simultaneously to enhance gate control capability, or bias independently to random access and linearly adjust threshold voltage (Vt). This makes the developed transistor broadly applicable of memory and computing. Also, this device has future prospect for BEOL (≤300°C) 3D parallel integration, where different layers of transistors can be formed concurrently with independent source/drain contacts. And the one-step channel formation approach, akin to 3DNAND, reduces lithography costs and eliminates device performance degradation induced by sequential integration.},
  keywords={Three-dimensional displays;Costs;Lithography;Logic gates;Tin;Very large scale integration;Hafnium oxide;ALD;IGZO;dual-gate;vertical channel;monolithic 3D integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631472},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631461,
  author={Sayed, A. and Vasilevski, M. and Abdelmomen, M. T. and Turk, S. and Ghoniem, A. and Perez, C. and Voillequin, C. and Stratigopoulos, H. and Louërat, M.-M. and Wantiez, E. and Aboushady, H.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 10.8GS/s, 84MHz-BW RF Bandpass ΣΔ ADC with a 89dB-SFDR and a 62dB-SNDR for LTE/5G Receivers}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The LTE/5G multi-standard RF BP $\Sigma\Delta$ ADC reported in this paper achieves an SFDR of 89dB and an SNDR of 62dB on a 84MHz-BW centered at $\mathrm{F}_{0}=2.7\text{GHz}$. The ADC, sampled at $\text{Fs}=10.8\text{GHz}$, has an RF Noise Figure of 29dB, and an Input Intercept Point of +8dBm. When OFDM modulated signals are applied to the ADC, the measured EVM is 1.25% for a 10MHz/64-QAM/LTE, 1.6% for a 20MHz/64-QAM/LTE, and 2.0% for a 40MHz/64-QAM/5G signal.},
  keywords={Radio frequency;Noise figure;OFDM;Receivers;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631461},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631377,
  author={Honkote, Vinayak and Kuttappa, Ragh and Sundaram, Jainaveen and Yada, Satish and Kalimuthu, Chinnusamy and Patil, Juhi and Lee, Richard and Paulino, Cristan and Aseron, Paolo and Nguyen, Trang and Rao, Amreesh and Kurian, Dileep and Xu, Mingming and Song, Yan and Karnik, Tanay and Srinivasan, Anuradha and De, Vivek},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 3.2GHz-15GHz Low Jitter Resonant Clock Featuring Rotary Traveling Wave Oscillators in Intel 4 CMOS for 3D Heterogeneous Multi-Die Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a resonant clocking technique featuring rotary traveling wave oscillators (RTWOs) and a rotary oscillatory array (ROA) in Intel 4 CMOS for high-frequency, low-jitter, low-power and low-skew clock generation and distribution in 3D heterogeneous multi-die systems. The active base die incorporates an array of four coupled RTWOs capable of dynamic frequency tuning. Three independent resonant rotary rings are implemented to demonstrate the range of native resonant frequencies with very low jitter. The circuits operate across a wide frequency (3.2GHz-15GHz) and voltage (0.55V-1.2V) range with very low measured period jitter (107fs-705fs) and minimal duty-cycle distortion $(50\pm 0.8\%)$ suitable for multi-die high-performance GPUs.},
  keywords={Voltage measurement;Three-dimensional displays;Resonant frequency;Jitter;Very large scale integration;CMOS technology;Frequency measurement},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631377},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631327,
  author={Krishnamurthy, Sashank and Mondal, Susnata and Qiu, Junyi and Kennedy, Joe and Bose, Soumya and Acikalin, Tolga and Yamada, Shuhei and Jaussi, James and Mansuri, Mozhgan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 4×50Gb/s NRZ 1.5pJ/b Co-Packaged and Fiber-Terminated 4-Channel Optical RX}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a 4-channel co-packaged optical RX that integrates a photo diode array, fiber termination and a transimpedance amplifier front end (TIA-FE) IC on the same package as an RX data-path IC. To achieve high sensitivity, the TIA-FE employs bandwidth extension and in-band group delay compensation techniques that are co-optimized with a 1/4-rate 2-tap feed-forward equalizer (FFE) in the RX data-path. A StrongArm latch that improves noise variance by 3.5x for iso-power is introduced. Modulated by its VCSEL-based optical TX counterpart, the optical RX demonstrates 4×50Gb/s NRZ at 1.5pJ/b with BER<10−12 and a sensitivity of -6dBm.},
  keywords={Integrated optics;Optical fiber amplifiers;Optical fiber sensors;Sensitivity;Surface emitting lasers;Very large scale integration;Optical fiber communication;Optical RX;TIA;FFE;I/O link;vertical-cavity surface-emitting laser (VCSEL);co-packaged optics},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631327},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631558,
  author={Kumar, Sayan and Sawakewang, Patchara and Siriburanon, Teerachot and Staszewski, Robert Bogdan},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 25.4-27.5 GHz Ping-Pong Charge-Sharing Locking PLL Achieving 42 fs Jitter with Implicit Reference Frequency Doubling}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We propose a ping-pong charge-sharing locking (PP-CSL) PLL which injects charge into the oscillator tank employing complemen-tary charge-sharing capacitors ($C$ shared) during both positive and negative reference clock (fREF) transitions, resulting in an implicit 2x multiplication. The proposed frequency-tracking loop (FTL) and duty-cycle calibrations (DCC) are achieved simultaneously by moni-toring the charge residue on $C$ shared. Implemented in 28 nm CMOS, the ~27 GHz PLL achieves 42 fs of rms jitter while consuming only 14mW with fREF of 250 MHz, leading to FoMjitter-N of -276.6 dB.},
  keywords={Frequency locked loops;Capacitors;Very large scale integration;Jitter;Calibration;Phase locked loops;Oscillators},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631558},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631397,
  author={Lee, Hyungdeok and Kim, Guhyun and Yun, Dayeon and Kim, Ilkon and Kwon, Yongkee and Lim, Euicheol},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Cost-Effective LLM Accelerator Using Processing in Memory Technology}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Large language model (LLM)-based services continue to improve their performance requires the system with both large memory capacity and high memory bandwidth. For the GPT-3 [1] [5] 175 billion model to operate at a minimum, it requires 800GB of storage. In addition, from frequent memory access and limited data reuse also affects memory bandwidth. More powerful memory performance requirements, however, comes with significant costs increase. The expenses associated with operating the necessary equipment and services to handle these capacity and bandwidth requirements are considerable. SK hynix aims to solve this issue by introducing a processing in memory (PIM) device and PIM based accelerator called AiM [2] and AiMX, respectively. By exploiting true bank-level parallelism, AiM and AiMX are expected to enhance the performance of LLM-based services as a core component of disaggregated system and multi-head attention acceleration. Additionally, AiM also has a potential in on-device AI, in direction of both performance and energy consumption with low batch size and reducing off-chip data movement.},
  keywords={Performance evaluation;Energy consumption;Costs;Large language models;Memory management;Bandwidth;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631397},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631414,
  author={Mao, Ruixin and Tang, Lin and Xia, Zihan and Zhang, Zhaomin and Shen, Aoyu and Long, Yu and Guo, Jinhong and He, Yunpeng and Zhang, Lai and Wang, Shujuan and Zhou, Liang and Chang, Liang and Liu, Shanshan and Zhou, Jun},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={FSNAP: An Ultra-Energy-Efficient Few-Spikes-Neuron Based Reconfigurable SNN Processor Enabling Unified On-Chip Learning and Accuracy-Driven Adaptive Time-Window Tuning}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents an ultra-energy-efficient few-spikes-neuron (FSN) based reconfigurable spiking neural network (SNN) processor enabling unified on-chip learning and accuracy-driven adaptive time-window tuning. Fabricated in 55nm CMOS process, the proposed design outperforms state-of-the-art designs in accuracy, energy efficiency (up to ×84) and speedup (up to ×740) for same or similar application tasks.},
  keywords={Adaptive systems;Accuracy;Spiking neural networks;Very large scale integration;CMOS process;Energy efficiency;System-on-chip},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631414},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631551,
  author={Liu, Menggan and Li, Zhi and Lu, Wendong and Chen, Kaifei and Niu, Jiebin and Liao, Fuxi and Wu, Zijing and Lu, Congyan and Li, Wei zeng and Geng, Di and Lu, Nianduan and Dou, Chunmeng and Yang, Guanhua and Li, Ling and Liu, Ming},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of Monolithic Three-Dimensional Integration of Ultra-High Density Hybrid IGZO/Si SRAM and IGZO 2T0C DRAM Achieving Record-Low Latency (<10ns), Record-Low Energy (<10fJ) of Data Transfer and Ultra-Long Data Retention (>5000s)}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work firstly demonstrates a monolithic 3D architecture with ultra-high density IGZO/Si SRAM and IGZO 2T0C DRAM (M3D-SD) integrated in 3-tiers. By incorporating ultra-low leakage IGZO transistor in tier 2 as pass gate and BEOL integration on Si-CMOS cross-coupled inverters (Tier 1), a hybrid IGZO/Si SRAM is demonstrated with ultra-high density of 4T footprint and 51% reduced static power. In addition, IGZO 2T0C DRAM is integrated in tier 3, which achieves SRAM-DRAM data transfer with record-low latency (<10ns) and energy (2.26fJ). The M3D-SD (with a minimum VDD of 0.35V) can successfully store the data to IGZO 2T0C DRAM and restore to the hybrid IGZO/Si SRAM after 5000s power off. This work provides a novel M3D platform to boost the memory hierarchy performance.},
  keywords={Three-dimensional displays;Random access memory;Very large scale integration;Logic gates;Data transfer;Hybrid power systems;Inverters},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631551},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631429,
  author={Liao, A. and Jerry, M. and Karda, K. and Hollander, M. and Sharma, P. and Ge, R. and Zhao, T. and Hajjam, G.K. El and Mariani, M. and Calabrese, M. and Raimondi, D. and Rigano, A. and Rossi, T. and Florent, K. and Tapias, N. and Jacob, C. and Calderoni, A. and Chhajed, S. and Zahurak, J. and Ramaswamy, N.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={4F2 Stackable Polysilicon Channel Access Device for Ultra-Dense NVDRAM}, 
  year={2024},
  volume={},
  number={},
  pages={1-3},
  abstract={We report on the methodology and optimization used to enable a stackable 4F2 polysilicon thin film transistor (TFT) for ultra-dense 32 Gb NVDRAM. Several key innovations are implemented to meet the strict thermal budget constraints required for a dual-layer technology. Confined heating from pulsed laser annealing is used to crystallize polysilicon and activate source/drain dopants. Material optimization is used to engineer both a gate oxide deposited at low temperatures capable of 10 years equivalent reliability and a Ru wordline (WL) robust to agglomeration and voiding failures. Device performance, robust to top layer processing, is matched across both layers by adjusting process conditions as informed by a TCAD model that accounts for heat transfer and crystallization dynamics.},
  keywords={Performance evaluation;Technological innovation;Annealing;Materials reliability;Very large scale integration;Logic gates;Reliability engineering;Thin film transistor;Polysilicon;Laser anneal;NVDRAM},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631429},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631389,
  author={Liu, Gan and Kong, Qiwen and Zhou, Zuopu and Ying, X. and Sun, Chen and Han, Kaizhen and Kang, Yuye and Zhang, Dong and Wang, Xiaolin and Feng, Yang and Shi, Wei and Nguyen, Bich-Yen and Kai, N. and Liang, Gengchiau and Gong, Xiao},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Unveiling the Impact of AC PBTI on Hydrogen Formation in Oxide Semiconductor Transistors}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={For the first time, we elucidate the impact of both alternating current (AC) and direct current (DC) positive bias temperature instability (PBTI) on hydrogen (H) formation of oxide semiconductor FETs (OSFET). Our investigation employs a systematic and holistic analysis on the highly stable co-sputtered Indium-Gallium-Zinc-Tin-oxide (IGZTO) FETs. Key discoveries include: (1) There are distinctive variations between AC and DC PBTI results at high temperatures $(T)$. (2) In AC PBTI, both frequency $(f)$ and duty factor (DF) play a crucial role in mitigating the H formation effect. (3) DF exhibits a more influential impact than $f$ (4) AC PBTI, particularly at 25% DF and 1 MHz, can alleviate up to 99.2% of the threshold voltage change $(\Delta V_{\text{th}})$ induced by H formation from DC PBTI. These findings contribute significant insights into the H formation mechanism, providing a more relevant and accurate understanding of PBTI reliability across diverse real-world applications. The results also offer valuable guidance for device optimization and circuit design in the pursuit of enhanced performance and reliability.},
  keywords={Performance evaluation;Systematics;Temperature;Hydrogen;Field effect transistors;Very large scale integration;Reliability engineering},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631389},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631547,
  author={Bhargava, Pavan and Jeong, Daniel and Jan, Eric and Van Orden, Derek and Kita, Derek and Gevorgyan, Hayk and Buchbinder, Sidney and Khilo, Anatoly and Bae, Woorham and Kim, Sung-Jin and Fini, John and Chan, Norman and Sun, Chen},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 256Gbps Microring-Based WDM Transceiver with Error-Free Wide Temperature Operation for Co-Packaged Optical I/O Chiplets}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We present a 256Gbps WDM transceiver macro for use in co-packaged AI scale-out interconnects. The macro adopts a $8\lambda\times 32\text{Gbps}$ configuration to achieve 256Gbps per fiber. The transceiver macro operates error-free across a dynamic temperature ramp of 50-110°C, has >4dB optical link margin with $4\text{dBm}/\lambda$ input laser power, and consumes 3.45pJ/b ($\text{TX}+\text{RX}$). All transmit, receive, thermal control, and optical components are monolithically integrated in a 45nm SOI process. An optical I/O chiplet with 8 WDM transceiver macros achieves <10−15 BER without FEC across 90 hours of operation in a 4Tbps duplex link configuration.},
  keywords={Optical fibers;Chiplets;Power lasers;Process control;Very large scale integration;Wavelength division multiplexing;Transceivers;optical I/O;transceivers;transmitter;receiver;VLSI;wireline;monolithic;silicon photonics;WDM},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631547},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631513,
  author={Hafez, W. and Abanulo, D. and Abdelkader, M. and An, S. and Auth, C. and Bahr, D. and Balakrishnan, V. and Bambery, R. and Beck, M. and Bhargava, M. and Bhowmick, S. and Biggs-houck, J. and Birdsall, J. and Caselli, D. and Chang, H.-Y. and Chang, Y. and Chaudhuri, R. and Chauhan, S. and Chen, C. and Chikarmane, V. and Chikkadi, K. and Chu, T. and Connor, C. and De Alba, R. and Deng, Y. and Destefano, C. and Diana, D. and Dong, Y. and Elfick, P. and Elko-hansen, T. and Fallahazad, B. and Fang, Y. and Gala, D. and Garg, D. and Geppert, C. and Govindaraju, S. and Grimm, W. and Grunes, H. and Guler, L. and Guo, Z. and Gupta, A. and Hattendorf, M. and Havelia, S. and Hazra, J. and Islam, A. and Jain, A. and Jaloviar, S. and Jamil, M. and Jang, M. and Kabir, M. and Kameswaran, J. and Karl, E. and Kelgeri, S. and Kennedy, A. and Kilroy, C. and Kim, J. and Kim, Y. and Krishnan, D. and Lee, G. and Lee, H.-P. and Li, Q. and Lin, H. and Luk, A. and Luo, Y. and Macfarlane, P. and Mamun, A. and Marla, K. and Mayeri, D. and Mckenna, E. and Miah, A. and Mistry, K. and Mleczko, M. and Moon, S. and Nardi, D. and Natarajan, S. and Nathawat, J. and Nolph, C. and Nugroho, C. and Nyhus, P. and Oni, A. and Packan, P. and Pak, D. and Paliwal, A. and Pandey, R. and Paredes, I. and Park, K. and Paulson, L. and Pierre, A. and Plekhanov, P. and Prasad, C. and Ramaswamy, R. and Riley, J. and Rode, J. and Russell, R. and Ryu, S. and Saavedra, H. and Salisbury, T. and Sandford, J. and Shah, F. and Shang, K. and Shekhar, P. and Shu, A. and Skoug, E. and Sohn, J. and Song, J. and Sprinkle, M. and Su, J. and Tan, A. and Troeger, T. and Tsao, R. and Vaidya, A. and Wallace, C. and Wang, X. and Wang, H. and Ward, C. and Wickramaratne, S. and Wills, M. and Wu, T. and Xia-hua, Z. and Xu, S. and Yashar, P. and Yaung, J. and Yu, Y. and Zilm, M. and Sell, B.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={An Intel 3 Advanced FinFET Platform Technology for High Performance Computing and SOC Product Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={An advanced Intel 3 FinFET technology is presented that has been optimized to provide 10% logic scaling, a full node of performance improvement and improved reliability compared to Intel 4. Through transistor enhancements, interconnect optimization, and design co-optimizations, up to 18% performance gain at iso-power is achieved over Intel 4. Intel 3 additionally enables a 210nm high-density standard cell, 1.2V-native I/O transistors, deep N-well isolation, and long-channel analog devices to provide full-featured technology design capabilities.},
  keywords={Performance evaluation;Integrated circuit interconnections;Very large scale integration;Performance gain;FinFETs;Transistors;Reliability},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631513},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631347,
  author={Kim, Ye-Dam and Chung, Jae-Hyun and Lozada, Kent Edrian and Park, Chang-Un and Park, Kun-Woo and Song, Kwan-Hoon and Moon, Young-Hun and Seo, Min-Jae and Ryu, Seung-Tak},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 100kHz-BW 99dB-DR Continuous-Time Tracking-Zoom Incremental ADC with Residue-Gain Switching and Digital NC-FF}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper proposes a continuous-time (CT) tracking-zoom (TZ) incremental ADC (I - ADC) that reuses a quantizer for both the coarse SAR and fine DSM stages. The TZ I-ADC addresses the input bandwidth (BW) limitation issue with simple DAC code update. A residue-gain (RG) switching technique is proposed to mitigate the inconsistent signal transfer function (STF) in the fine CT incremental DSM (I-DSM). A digital noise-coupling-feedforward (DNC-FF) architecture is proposed to reduce the out-of-band gain (OBG). Fabricated in a 180nm CMOS process, the prototype consumes 2.52mW under a 1.8V supply, achieving 99-dB DR. 93.8-dB SNDR. and 102.5-dB SFDR.},
  keywords={Codes;Transfer functions;Prototypes;Switches;Bandwidth;Very large scale integration;CMOS process},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631347},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631493,
  author={Hikake, Kaito and Huang, Xingyu and Kim, Sung-Hun and Sakai, Kota and Li, Zhuo and Mizutani, Tomoko and Saraya, Takuya and Hiramoto, Toshiro and Takahashi, Takanori and Uenuma, Mutsunori and Uraoka, Yukiharu and Kobayashi, Masaharu},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Scaling Potential of Nanosheet Oxide Semiconductor FETs for Monolithic 3D Integration–ALD Material Engineering, High-Field Transport, Statistical Variability}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We have investigated the scaling potential of nanosheet oxide semiconductor FETs (NS OS FETs) for monolithic 3D integration in terms of ALD material engineering, high-field transport, and statistical variability, for the first time. We have developed and systematically compared InGaO, InZnO and InGaZnO FETs by ALD. We have fabricated sub-100nm gate length NS OS FETs and demonstrated unsaturated carrier velocity behavior. We have obtained statistical variability data of NS OS FETs, which is comparable against Si CMOS. This work provides an evidence of scalability of NS OS FETs for monolithic 3D integration.},
  keywords={Three-dimensional displays;Scalability;Field effect transistors;Very large scale integration;Logic gates;Silicon;Three-dimensional integrated circuits},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631493},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631432,
  author={Gao, Zhaomeng and Xin, Tianjiao and Kai, D. and Zhao, Qiwendong and Wang, Yiwei and Liu, Cheng and Yilin, X. and Wang, Rui and Shi, Guangjie and Zheng, Yunzhe and Zheng, Yonghui and Cheng, Yan and Lyu, Hangbing},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Polar Axis Orientation Control of Hafnium-Based Ferroelectric Capacitors with in-Situ AC Electric Bias During Rapid Thermal Annealing}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Hafnium-based ferroelectric (FE) thin films, prepared via atomic layer deposition (ALD), suffered from random oriented polar axis (PA), posing challenges and complexities for device scaling and variation. To effectively control the PA orientation and enhance polarization, we employed in-situ AC electric bias (E) during rapid thermal annealing (RTA) treatment (i.e. RTA+E). The main findings are: (1) Direct experimental evidence of variable orthogonal (0-) PA has been obtained for the first time, originating from tetragonal (T-) to O- transition in RTA cooling; (2) Applying E during cooling significantly enhances polarization in hafnium-based FE capacitors up to ~121.6% increase; (3) The RTA+E method effectively controls the O-PA orientation towards the out-of-plane E direction. These findings solidly demonstrate that the PA orientation of O-grain can be controlled in fluorite-type FE thin films.},
  keywords={Annealing;Cooling;Films;Capacitors;Position control;Transforms;Very large scale integration;hafnium-based oxide;ferroelectric capacitor;polarization;orientation control},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631432},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631533,
  author={Lin, Z. and Zhang, Z. and Niu, C. and Dou, H. and Xu, K. and Islam, M. and Lin, J.-Y. and Sung, C. and Hong, M. and Ha, D. and Wang, H. and Alam, M.A. and Ye, P. D.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Highly Robust All-Oxide Transistors with Ultrathin In2O3 as Channel and Thick In2O3 as Metal Gate Towards Vertical Logic and Memory}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, we report for the first time atomic-layer-deposited (ALD) all-oxide transistors toward 3-D vertical integration, with thick ALD In2O3 as gate electrodes, and In2O3 itself as contact. The all-oxide thin-film transistors (TFTs) show an on/off ratio over 106, high uniformity, and very robust reliability with a threshold voltage shift ($\Delta \mathrm{V}_{\text{TH}}$) of 5 mV and 50 mV in positive and negative bias stress (PBS and NBS) tests. The vertically all-oxide TFTs demonstrate good control from side wall with on/off ratio over 105 and maximum current ($\mathrm{I}_{\max}$) over $160\ \mu\mathrm{A}/\mu\mathrm{m}$. And vertically all-oxide ferroelectric field-effect transistors (Fe-FETs) exhibit a memory window (MW) of 1.85 V, with an endurance and retention extended to 1012 cycles and 10 years. This illustrates the vertically all-oxide device based on ALD oxide semiconductor (OS) is a good candidate toward future high-density integrated circuits.},
  keywords={Electrodes;Metallization;Logic gates;Very large scale integration;NIST;Threshold voltage;Thin film transistors},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631533},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631325,
  author={Cho, Dongseok and Park, Byungchoul and Choi, Hyun-Seung and Lee, Myung-Jae and Chae, Youngcheol},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 30fps $\mathbf{64}\times \mathbf{64}$ CMOS Flash LiDAR Sensor with Push-Pull Analog Counter Achieving 0.1% Depth Uncertainty at 70m Detection Range}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a CMOS flash LiDAR sensor based on a time-gated single-photon counting method. The proposed $64\times 64$ sensor is implemented in a 110nm BSI process and achieves a small pixel pitch of $32\mu \mathrm{m}$ with a fill factor of 33%. It consumes 29.1mW, while operating at 30fps. It achieves a high PDP of 14.3% at 850nm and a depth uncertainty of 7cm at a depth range of 70m, corresponding to the worst-case depth uncertainty of 0.1%. These results are achieved by the use of a compact SPAD front-end, a push-pull analog counter, and an optimized PDP. The gain mismatch errors in the analog counter are mitigated by the use of a push-pull gain averaging scheme.},
  keywords={Uncertainty;Laser radar;Fill factor (solar cell);Very large scale integration;CMOS technology;Single-photon avalanche diodes},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631325},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631527,
  author={Gu, J and Ma, J and Guo, J and Guo, F and Liang, D and Li, Y and Shen, C and Gao, P and Zhang, X and Ding, J and Sorna, M and Wang, H and Cui, C and Troupe, J and Metty, P and Chang, Ken},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 32Gb/s 0.36pJ/bit 3nm Chiplet IO Using 2.5D CoWoS Package with Real-Time and Per-Lane CDR and Bathtub Monitoring}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents a high density single-ended NRZ Chiplet IO in 3nm CMOS technology over 2.5D CoWoS interposer of up to 2mm trace length, with a total of 216 data lanes running simultaneously at 32Gb/s/wire. The 2mm channel insertion loss and crosstalk at Nyquist frequency are −2.4dB and −18.1dB respectively. The RX features a real-time per-lane CDR and bathtub monitor, enabling optimal sampling point adaptation as well as tracking of phase drift over voltage and temperature. With all lanes toggling, the PHY achieves 3.84T/mm beach front density while consuming 0.36pJ/bit. The worst lane measures 0.342UI opening at BER of le-12 and interpolated 0.331UI opening at BER of le-15 when running at 32Gb/s. 25Gb/s results are also presented as a low power option.},
  keywords={Temperature measurement;Temperature sensors;Semiconductor device measurement;Power measurement;Chiplets;Very large scale integration;Real-time systems;Chiplet;Die-to-Die;2.5D package;single-ended;NRZ;CoWoS;interposer;clock forwarding;CDR},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631527},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631352,
  author={Feng, Yang and Zhang, Dong and Sun, Chen and Zheng, Zijie and Chen, Yue and Kong, Qiwen and Liu, Gan and Kang, Yuye and Han, Kaizhen and Zhou, Zuopu and Liang, Gengchiau and Ni, Kai and Wu, Jixuan and Chen, Jiezhi and Gong, Xiao},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={First Demonstration of BEOL-Compatible 3D Vertical FeNOR}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, we present and experimentally demonstrate the world's first back-end-of-line (BEOL) compatible vertical ferroelectric NOR (FeNOR) memory. The key highlights of this work are outlined below: (1) Side-fin structure has been meticulously designed and realized to enhance the ferroelectric switching and to suppress the cell-to-cell interference. (2) Outstanding Ion/+Ioff ratio (> 106) and memory window (~4 V) has been achieved, surpassing the performance of other reported 3D FeFETs. (3) Leveraging the advantages of ferroelectric switching, low programming voltage, rapid programming speed, and good endurance have been achieved. The realization of our 3D FeNOR presents a compelling alternative for applications requiring low power consumption and high-speed operation.},
  keywords={Electric potential;Three-dimensional displays;Power demand;Switches;Voltage;Interference;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631352},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631312,
  author={Aabrar, Khandker Akif and Park, Hyeonwoo and Kirtania, Sharadindu G. and Sarkar, Eknath and Al Mamun, Md Abdullah and Deng, Sunbin and Zhang, Chengyang and Rayner, Gilbert B. and Cho, Kyeongjae and Datta, Suman},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={On the Reliability of High-Performance Dual Gate (DG) W-Doped In2O3 FET}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We demonstrate a high performance back-end-of-line (BEOL) compatible tungsten (W)-doped In2O3 channel (IWO) dual gate (DG) field-effect transistor (FET) with ultra low-leakage current $<10^{-15}\ \ \mathrm{A}/\mu \mathrm{m}$ and high $\mathrm{I}_{\text{ON}}/\mathrm{I}_{\text{OFF}}$ ratio of $5.8\times 10^{11}$ at 2.5V overdrive $(\mathrm{V}_{\text{ov}})$. In addition, the IWO DG FET demonstrates a record low negative bias temperature instability (NBTI) of 7.2mV, record low hot carrier degradation (HCD) of 63mV and a low positive bias temperature instability (PBTI) of 85mV at 1V $\mathrm{V}_{\text{ov}}$ which makes IWO DG FET a potential candidate for realizing high density embedded-DRAM for last-level cache (LLC). Furthermore, we develop a comprehensive modeling framework for assesing the reliability of amorphous oxide semiconductor (AOS) channel FETs which can provide insights into the threshold voltage $(\mathrm{V}_{\mathrm{T}})$ instability mechanisms and help design appropriate mitigation strategies.},
  keywords={Negative bias temperature instability;Electron traps;Thermal variables control;Prevention and mitigation;Impurities;Field effect transistors;Ionization},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631312},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631500,
  author={Gupta, Animesh and Vohra, Japesh and Konandur, Viveka and Alioto, Massimo},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={122.7 TOPS/W Stdcell-Based DNN Accelerator Based on Transition Density Data Representation, Clock-Less MAC Operation, Pseudo-Sparsity Exploitation in 40 nm}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A DNN whose activation magnitude is represented by digital transition density is introduced for low energy, under the proposed Dyadic Digital Transition Modulation (DDTM). MAC operations are simplified into transition counting, enabling 1) activation pseudo-sparsity for lower energy, 2) clock-less neuron operation via simple up-down asynchronous counters. >100 TOPS/W in 40 nm stdcell design is on par with recent in-memory DNNs.},
  keywords={Neurons;Modulation;Very large scale integration;DNN;DDTM;machine learning;energy efficiency},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631500},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631426,
  author={Gupta, Animesh and Vohra, Japesh and Alioto, Massimo},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={CogniVision: End-to-End SoC for Always-on Smart Vision with mW Power in 40nm}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={A full vision system on chip with hierarchical execution from sensor to AI and communications is presented. Always-on system power is aggressively reduced to the mW level through activity reduction, gating any subsequent vision pipeline stage starting from the lowest semantic level of the scene. The system comprises an imager with dual-architecture in/near-sensor saliency detection, on-the-fly novelty detection, DNN with on-chip scheduler for weight memory reduction, WiFi transmitter, wake-up receiver for cloud-pushed DNN model update and software programmable orchestration via RISC-V. Average 2.1-mW power at 30 fps is achieved with a SqueezeNet V1.0 model running entirely on chip.},
  keywords={Transmitters;Semantics;Pipelines;Receivers;Very large scale integration;Software;System-on-chip;vision;system;smart imager;DNN accelerator},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631426},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631372,
  author={Kitaike, Hiroaki and Inada, Masaharu and Terauchi, Mitsuru and Tagawa, Hironori and Nagai, Ryosuke and Xu, Shufan and Zhang, Ruilin and Liu, Kunyang and Niitsu, Kiichi},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 0.9-2.6pW 0.1-0.25V 22nm 2-bit Supply-to-Digital Converter Using Always-Activated Supply-Controlled Oscillator and Supply-Dependent-Activation Buffers for Bio-Fuel-Cell-Powered-and-Sensed Time-Stamped Bio-Recording}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper presents a low-power supply-to-digital converter for bio-recording system where bio fuel cell provides both power and sensing data. It is achieved by supply-controlled oscillator, supply-dependent activation buffers (SDAB), and encoders. A 22-nm prototype chip exhibits its feasibility with a power of 0.9-2.6 pW under 0.1-0.25 V. Keywords: IoT, supply-dependent-activation buffer, CGM},
  keywords={Prototypes;Fuel cells;Very large scale integration;Sensors;Oscillators},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631372},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631345,
  author={Kaul, Ankit and Manley, Madison and Read, James and Luo, Yandong and Peng, Xiaochen and Yu, Shimeng and Bakir, Muhannad},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Co-Optimization for Robust Power Delivery Design in 3D-Heterogeneous Integration of Compute In-Memory Accelerators}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={In this work, we quantify the impact of power supply noise (PSN) in 3D-HI architectures on the errors in ADC and RRAM array outputs and optimize the 3D PDN and ADC designs to maximize inference accuracy in compute-in-memory (CIM) hardware. We propose a device-HI -application-level evaluation methodology to evaluate the impact of PDN design parameters on CIM inference accuracy. For our assumed 3D CIM hardware, an areal distribution of through-silicon vias (TSVs) and u-bumps, and a fine-tuned PSN-aware successive approximation register-ADC (SAR-ADC) achieves a 90% inference accuracy compared to 47% with a baseline 3D design at iso-power and iso-area. These insights can be useful for multi -die design convergence for edge intelligent CIM chips.},
  keywords={Three-dimensional displays;Accuracy;Power supplies;Very large scale integration;Packaging;In-memory computing;Hardware},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631345},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631453,
  author={Somada, Ichiro and Hirai, Akihito and Nakatani, Keigo and Taira, Akinori and Ishioka, Kazuaki and Nishimura, Takuma and Yamanaka, Koji},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Terahertz Sensing with CMOS-RFIC - Feasibility Verification for Short-Range Imaging using 300GHz MIMO Radar -}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={For solving various social issues, sensing technology has gained significant interest. Terahertz waves, which combine the high resolution of light and transparency of radio waves, enable visualization of obstacles behind internal structures. So, it offers potential for new solutions. This paper introduces the overview of a short-distance sensing system based on the full digital MIMO radar concept, the design and fundamental evaluation results of 300GHz terahertz CMOS devices, as well as the achievements of imaging using 300GHz terahertz wave based on actual measurements. Since the terahertz band can obtain an ultra-wideband spectrum, several milli-meter resolution imaging can be performed in azimuth, elevation, and depth direction. We show the feasibility of the security gate application with the measured high-resolution tomographic images.},
  keywords={Performance evaluation;Terahertz wave imaging;Visualization;MIMO radar;Radar imaging;Very large scale integration;Tomography;sensing;terahertz;MIMO radar;tomographic imaging;SOI-CMOS;RFIC},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631453},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631508,
  author={Lin, Chien-Hung and Hsu, Jeng-Yun and Yu, Cheng-Ying and Hsu, Chia-Wei and Tsai, Yi-Min and Wu, Kuo-Sheng and Huang, Chung-Lun and Hsieh, Meng-Han and Lin, Tsung-Yao},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Quad-Core AI Processing Unit for Generative AI in 4nm 5G Smartphone SoC}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents the quad-core AI processing unit (APU) for efficient execution of generative artificial intelligence (GenAI) applications on smartphones. GenAI applications featured with billions of computations and memory accesses are out of tune with smartphone platforms. The APU applies mixed-precision and hybrid-precision operations, inter-core direct data link, zero-overhead layer fusion, and data broadcasting to reduce 50% of DRAM footprint and 90% of DRAM BW. The 4nm 5G smartphone powered by the APU takes less than 1 second to generate an image with optimized stable diffusion (SD) and outputs more than 20 tokens per second with 7B speculative large language model (LLM).},
  keywords={Generative AI;5G mobile communication;Large language models;Random access memory;Very large scale integration;Broadcasting;Smart phones},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631508},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631545,
  author={Smith, Alan and Loh, Gabriel H. and Wuu, John and Naffziger, Samuel and Huang, Tyrone and McIntyre, Hugh and Mangaser, Ramon and Jung, Wonjun and Swaminathan, Raja},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={AMD Instinct™ MI300X Accelerator: Packaging and Architecture Co-Optimization}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={The AMD Instinct™ MI300X accelerator utilizes multiple advanced packaging technologies for a heterogeneous integration solution for emerging AI/ML and HPC workloads. These include microbump 3D memory stacks, 2.5D silicon interposers, and 3D hybrid bonding. The combination of these advanced packaging technologies enabled architectural innovations and generational performance uplifts that cannot be achieved with traditional technologies and Moore's Law scaling A modular 3D chiplet design also enables reuse of the MI300X components to enable the MI300A APU.},
  keywords={Semiconductor device modeling;Technological innovation;Leadership;Three-dimensional displays;Program processors;Moore's Law;Chiplets},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631545},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631471,
  author={Choi, K.S. and Kim, S.H. and Seo, J.W. and Kang, H.S. and Chu, S.W. and Bae, S.W. and Kwon, J.H. and Kim, G.S. and Park, Y.T. and Kwak, J.H. and Song, D.I. and Park, S.M. and Kim, Y.T. and Jang, K.C. and Cho, J.S. and Lee, H.S. and Lee, B.H. and Park, J.W. and Lee, J.H. and Kwon, H. H. and You, D.S. and Hyun, C.S. and Lee, J.J. and Lee, S.C. and Kim, I.D. and Myung, J.H. and Won, H.S. and Chun, J.H. and Kim, K.H. and Kang, J.H. and Kim, S.B. and Lee, K.H. and Chung, S.O. and Kim, S.S. and Jin, I.S. and Lee, B.K. and Kim, C.W. and Park, J. and Cha, S.Y.},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A Three Dimensional DRAM (3D DRAM) Technology for the Next Decades}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Three dimensional structured DRAM technology has drawn huge attention recently for its potential to fulfill high speed operation and low power consumption. In this paper, 3D DRAM with vertical bit line (BL) architecture is introduced as a promising solution to overcome scaling limitation for future DRAM technology. Full chip integration with 5-layered cell stacked on peri -core wafer is successfully demonstrated for the first time, offering superior on -current performance and gate controllability. A novel process integration scheme using Si/SiGe sacrificial multilayers and hybrid wafer bonding technique is presented with excellent full chip operation of 3D DRAM.},
  keywords={Wafer bonding;Three-dimensional displays;Power demand;Microprocessors;Random access memory;Computer architecture;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631471},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631537,
  author={Zhang, Yi and Tang, Minzhe and Pang, Jian and Li, Zheng and Xu, Dongfan and Xu, Dingxin and Zhang, Yuncheng and Kunihiro, Kazuaki and Sakai, Hiroyuki and Shirane, Atsushi and Okada, Kenichi},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 28GHz 4-Stream Time-Division MIMO Phased-Array Receiver Utilizing Nyquist-Rate Fast Beam Switching for 5G and Beyond}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work proposes an area-efficient 28-GHz time-division MIMO beamformer without additional hardware cost. RF signal paths can be reused for different MIMO streams by a time-division beam-switching operation, which is realized by oversampled fast-switching phase shifter and clock-based synchronization. A prototype fabricated in 65nm CMOS achieves 64-QAM $4\times 4$ MIMO reception in OTA measurement using four 5G NR spatial data streams with 400MHz channel bandwidth.},
  keywords={5G mobile communication;RF signals;Phase shifters;Prototypes;Receivers;Very large scale integration;Spatial databases},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631537},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631475,
  author={Matsugatani, Kazuoki},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Mobility Evolution: Electrification and Automation}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={The automotive industry faces two challenges: environmental impact reduction and safety enhancement. Particularly, efforts to achieve zero $\text{CO}_{2}$ emissions and zero traffic fatalities are urgent issues for the coming decade. Electrification, the transition from internal combustion engines to electric motors, profoundly alters vehicle mechanics. Automation, transferring driving control from humans to computers, integrates software and information technologies into the vehicle system. In both electrification and automation, semiconductor devices' evolution is key. For electrification, the power device managing current from the battery to the motor is crucial for inverter operation. In addition, analog sensing devices that measure voltage and current to and from the battery provide essential data regarding the battery's state of charge and health. As for automation, various sensors - including camera, radar, LiDAR and sonar - that monitor outside and inside of the vehicle are required. Furthermore, high-performance computers and wireless communication devices are required to process sensor data, establish a connection between the vehicle and an external network, and control the vehicle on behalf of the human driver. This digest paper introduces and explains the functions of these semiconductor devices.},
  keywords={Computers;Automation;Voltage measurement;Laser radar;Semiconductor devices;Electrification;Very large scale integration},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631475},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631357,
  author={Tsukano, Hidehiro},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Photonics-Electronics Convergence Technology to Accelerate IOWN}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper describes the direction of photonics-electronics convergence technology for the Innovative Optical Wireless Network (hereinafter called IOWN) concept by NTT in 2019. IOWN is an initiative to create a sustainable society that cannot be achieved with current network infrastructure. By taking advantage of optical technology for across-the-board network communications and computing, NTT is aiming to provide a new ICT platform that features high-capacity, high-quality, low-latency, and low-power consumption. The primary requirements for device technology are ultra-fine semiconductor manufacturing processes, ultra-high density assembly, and photonics-electronics convergence. Thus, NTT is promoting research and development in accordance with the roadmap to incorporate optical communications technology into the details of computing components step by step. This challenge could lead to the ultimate computing capacity that extends Moore's law, and we believe it can resolve the ever-increasing power consumption problem of information processing and contribute to the realization of carbon neutrality.},
  keywords={Integrated optics;Semiconductor device modeling;Power demand;Wireless networks;Optical fiber networks;Very large scale integration;Semiconductor device manufacture;Innovative Optical Wireless Network;photonics-electronics convergence technology;carbon neutrality},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631357},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631378,
  author={Bahai, Ahmad},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Making Sense at the Edge}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={Advancements in semiconductor technology have facilitated the widespread deployment of intelligent sensors across diverse fields and applications. The convergence of breakthroughs in MEMS-based sensing technologies, efficient connectivity solutions, and ultra-low power microcontrollers with embedded machine learning capabilities has enabled a new era of edge intelligence sensing systems, offering novel applications and avenues. The proliferation of these edge sensors generates vast amounts of data, presenting fertile ground for innovative inference leveraging machine learning algorithms. However, the stringent power constraints necessitate careful system optimization and creative partitioning of processing between local and cloud platforms. Nature provides compelling examples of ultra-low power sensors with ingenious system partitioning and signal processing techniques, resulting in highly power-efficient systems. Drawing inspiration from biological systems and leveraging advancements in nanofabrication techniques, further enhancements can be achieved across various sensing modalities while adhering to tight power budgets. Bioinspired system partitioning, advancements in multi-physics array signal processing, low-power circuit design, modern embedded sensing technologies for data analytics, and intelligent power management strategies are pivotal in realizing the ambitious goal of edge intelligence akin to a tiny brain. This paper delves into the challenges and opportunities inherent in ultra-low power sensing at the edge, alongside the crucial role of circuit design in enabling such advancements.},
  keywords={Machine learning algorithms;Service robots;Power system management;Low power electronics;Machine learning;Very large scale integration;Robot sensing systems;bioinspired sensing;array processing;low power design;data analytics;MEMS},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631378},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10631488,
  author={Rofougaran, Maryam and Rofougaran, Reza},
  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={Wireless Connectivity in a Future Hyperconnected World}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Wireless networks has become the fabric of our hyperconnected world, enabling high-speed and low-latency data transmission. Through the convergence of terrestrial cellular networks, satellite communication, and local wireless area networks, this infrastructure will further enhance seamless connectivity for billions of devices and cater to essential needs such as emergency response, remote work, automation, and operational efficiency. The integration of sensing technologies enriches wireless networks with contextual awareness and environmental intelligence, empowering AI -driven algorithms to optimize performance and overcome obstacles. Semiconductor breakthroughs play a pivotal role in realizing intelligent wireless connectivity, with advanced chipsets featuring embedded AI accelerators and energy-efficient designs. This paper examines key advances in wireless technology and presents emerging technologies that will shape its evolution.},
  keywords={Performance evaluation;Wireless sensor networks;Shape;Wireless networks;Very large scale integration;Remote working;Fabrics;intelligent wireless networks;artificial intelligence (AI);chipset;reliability;high-speed},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631488},
  ISSN={2158-9682},
  month={June},}
