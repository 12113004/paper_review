  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={We have experimentally demonstrated effects of BSPDN on performance-power of standard cell featuring Gate-all-around (GAA) FETs scaled down for SoC technology beyond 2nm node for the first time. 1st generation (Gen) BSPDN provides high immunity of cell-level leakage with ultra-scaled cell height and we achieve 6% speed gain by optimizing metal routing. As a result, 1st Gen BSPDN could make it possible to achieve 7.5% performance or 5% power gain compared to FSPDN with logic and SRAM test chip verification.},
  keywords={Gallium arsenide;Field effect transistors;Random access memory;Metals;Very large scale integration;Logic gates;Routing},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631539},
  ISSN={2158-9682},
