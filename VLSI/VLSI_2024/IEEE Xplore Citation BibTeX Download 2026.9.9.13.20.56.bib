  booktitle={2024 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 79.3fsrms Jitter Fractional-N Digital PLL Based on a DTC Chopping Technique}, 
  year={2024},
  volume={},
  number={},
  pages={1-2},
  abstract={This work presents a fractional- N digital PLL leveraging a digital-to-time converter (DTC) chopping technique to improve spectral purity and jitter. By randomly moving the DTC between the reference and divider paths of the PLL, the fractional spurs induced by DTC non-linearity and the DTC flicker noise are suppressed. The synthesizer, fabricated in 28nm CMOS, achieves 79.3fsrms jitter and -63.6dBc fractional spur at 9.275GHz near-integer channels.},
  keywords={Synthesizers;Jitter;Very large scale integration;1/f noise;Phase locked loops;DPLL;DTC;chopping;fractional-N;low-spur;low-jitter},
  doi={10.1109/VLSITechnologyandCir46783.2024.10631343},
